@@ -26,0 +27 @@
+#include <sys/sysmacros.h>
@@ -48,0 +50,37 @@
+#define TEST_PIPE_ENV "DOSBOX_MANYMOUSE_TEST_PIPE"
+#define TEST_PIPE_NAME "CommanderBloodTestMouse"
+#define TEST_TRACE_ENV "DOSBOX_MANYMOUSE_TEST_TRACE"
+
+/*
+ * Test automation can feed native input_event records through a private FIFO.
+ * Unlike uinput, this cannot be discovered or consumed by the host desktop.
+ */
+static int open_test_pipe(void)
+{
+    const char *path = getenv(TEST_PIPE_ENV);
+    struct stat statbuf;
+    MouseStruct *mouse;
+    int fd;
+
+    if ((path == NULL) || (*path == '\0'))
+        return 0;
+    if (available_mice >= MAX_MICE)
+        return -1;
+
+    fd = open(path, O_RDWR | O_NONBLOCK);
+    if (fd == -1)
+        return -1;
+    if ((fstat(fd, &statbuf) == -1) || !S_ISFIFO(statbuf.st_mode))
+    {
+        close(fd);
+        return -1;
+    }
+
+    mouse = &mice[available_mice++];
+    mouse->fd = fd;
+    mouse->min_x = mouse->min_y = 0;
+    mouse->max_x = mouse->max_y = 0;
+    snprintf(mouse->name, sizeof (mouse->name), "%s", TEST_PIPE_NAME);
+    return 1;
+}
+
