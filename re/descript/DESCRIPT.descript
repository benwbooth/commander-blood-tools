sequence "microkid" {
    music "balise.voc"
    subtitle frame=20 "Hi there people. I'm Izwan and you're watching the IZWAL channel..."
    subtitle frame=50 "Welcome to the show:"
    subtitle frame=80 "A brand new game is just out"
    subtitle frame=100 "Testing testing ! Stanley, can you hear me ?..."
    subtitle frame=120 "Loud and clear. I'm talking live from the planet Vista..."
    subtitle frame=170 "Here are some pictures of a classic, boring game"
    subtitle frame=200 "the pictures aren't much to look at..."
    subtitle frame=250 "Uh oh... Things are heating up..."
    subtitle frame=300 "Kill and destroy. Not too original..."
    subtitle frame=350 "Here's something new and pretty fantastic"
    subtitle frame=400 "This is one great game, people... Take a look at the title."
    subtitle frame=450 "These graphics are like nothing you've ever seen..."
    subtitle frame=480 "The Izwals of Vista have all the luck..."
    subtitle frame=800 "Back to you Izwan..."
    video "oollee01.hnm"
    video "bbar.hnm"
    video "oollee10.hnm"
}

