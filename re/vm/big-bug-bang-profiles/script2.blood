            require bits(Emasculator.flags,0x0004)
            require !bits(Izwalito.flags,0x0004)
            require !bits(Kero_Zen.flags,0x0004)
            require atomique.holder != aboard
            require vaisseau.holder != aboard
            require globals.C10 == 0
        } then {
            say Honk presentation=8 chatter : "commander|, si vous arrivez à soutirer une pile atomique aux croolis verts|..."
            say Honk presentation=8 chatter : "on pourra la filer à migrator pour qu'il nous bricole un vaisseau|..."
            say Honk presentation=8 chatter if_not_shown skip_next=1 : "un vaisseau atomique evidemment|..."
            globals.C10 = 1
        }
    }
    proc objet enabled {
        during bridge
        require Daddy_Gluxx.current_location != aboard
        require presentation == Honk
    } then {
        when {
            require globals.DGECR == 1
            require globals.B82 < 2
        } then {
            end presentation Honk
            objet.enabled = false
        }
        when {
            require globals.C1 == 0
        } then {
            say Honk presentation=8 chatter : "Commander|, Il y a plein d'objets qui trainent dans la cale de l'Arche|, je fouille|..."
            say Honk presentation=8 chatter : "Oh la la|... Il y a des vieilleries|, des poubelles|..."
            say Honk presentation=8 chatter : "Plein de choses qui devraient nous servir|..."
            say Honk presentation=8 chatter : "Je vous les mets dans la cryobox|..."
            say Honk presentation=8 if_not_shown skip_next=1 : "..."
            globals.C1 = 1
        }
        when {
            require Honk.encounter_count == 4
        } then {
            say Honk presentation=8 chatter : "Quel bazar ici|..."
            say Honk presentation=8 chatter : "Un jour il faudra nettoyer la cale|, Commander|, c'est une infection|..."
        }
        when {
            random_guard 0x0001
        } then {
            say Honk presentation=8 chatter : "Je fouille|..."
        }
        when {
            require globals.A16 > 5
        } then {
            say Honk presentation=8 chatter : "Excusez-moi|... Commander|... J'ai à faire|..."
            when {
                require globals.DGECR == 0
            } then {
                end presentation Honk
            }
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            globals.A16 = 0
            end presentation Honk
        }
        when {
            require ecriture.holder != aboard
        } then {
            say Honk presentation=8 chatter : "Un manuel d'Ecriture et de grammaire"
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            ecriture.holder = aboard
            globals.A16 += 1
        }
        when {
            require globals.A68 > 0
            require couronne.holder != aboard
        } then {
            say Honk presentation=8 chatter : "J'ai trouve une vieille Couronne de Chef"
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            couronne.holder = aboard
            globals.A16 += 1
        }
        when {
            require vaisseau.holder != aboard
        } then {
            say Honk presentation=8 chatter : "Un VAISSEAU|... C'est pas possible|!|!|! Je reve|..."
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            vaisseau.holder = aboard
            globals.A16 += 1
        }
        when {
            require technologie.holder != aboard
        } then {
            say Honk presentation=8 chatter : "Un document sur des inventions technologiques"
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            technologie.holder = aboard
            globals.A16 += 1
        }
        when {
            require guitare.holder != aboard
            require globals.A63 < 2
        } then {
            say Honk presentation=8 chatter : "Une guitare desaccordee|..."
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            guitare.holder = aboard
            globals.A16 += 1
        }
        when {
            require energie.holder != aboard
        } then {
            say Honk presentation=8 chatter : "De l'energie|..."
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            energie.holder = aboard
            globals.A16 += 1
        }
        when {
            require parfum.holder != aboard
            random_guard 0x0001
        } then {
            say Honk presentation=8 chatter : "Du parfum|... Hum|, ca pue|..."
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            parfum.holder = aboard
            globals.A16 += 1
        }
        when {
            require cadeaux.holder != aboard
            random_guard 0x0006
        } then {
            say Honk presentation=8 chatter : "Des cadeaux|... C'est Noel|..."
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            cadeaux.holder = aboard
            globals.A16 += 1
        }
        when {
            require globals.A4 == 0
            random_guard 0x0001
        } then {
            say Honk presentation=8 chatter : "UN CREDIT|, J'AI TROUVE UN CREDIT|, Commander."
            say Honk presentation=8 if_not_shown skip_next=3 : "..."
            globals.A4 += 1
            credit.holder = aboard
            globals.A16 += 1
        }
        when {
            require Scruter_Jo.current_location != aboard
        } then {
            say Honk presentation=8 chatter : "La carcasse de ce vieux Scruter Jo qui marche encore|... Ca alors|..."
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            Scruter_Jo.current_location = aboard
            globals.A16 += 1
        }
        when {
            require atomique.holder != aboard
            require bits(Super_Tromp.flags,0x0004)
        } then {
            say Honk presentation=8 chatter : "de l'atomique|! flambant neuf|!..."
            say Honk presentation=8 if_not_shown skip_next=2 : "..."
            atomique.holder = aboard
            globals.A16 += 1
        }
    }
    proc lent enabled {
        require optique.holder == aboard
        require globals.A15 == 1
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "Commander|, cette lentille que nous avons dans la cryobox|..."
        say Honk presentation=8 chatter : "Gràce à elle nous sommes en mesure de voir l'autre bout de l'univers|..."
        say Honk presentation=8 chatter : "Scruter Jo m'a dit que nous devions donner la lentille à|..."
        say Honk presentation=8 chatter : "J'ai oublie à qui|... c'est à quelqu'un|..."
        say Honk presentation=8 if_not_shown skip_next=3 : "..."
        sequence_slots[2] = "35ondoyante"
        globals.A15 = 2
        end presentation Honk
    }
    proc objexp enabled {
        during bridge
        require globals.A3 == 0
        require bits(Daddy_Gluxx.flags,0x0004)
        require !bits(Super_Zen.flags,0x0004)
        require !bits(Otto_Von_Gluk.flags,0x0004)
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "n'oubliez pas commander|, pas plus de 15 objets à la fois dans la cryobox|..."
        say Honk presentation=8 chatter resume_at=honsecur : "Voulez-vous que je vous explique à quoi peuvent servir ces objets|, Commander?" choices "oui" "non"
        when {
            require choice == "oui"
        } then {
            when {
                require couronne.holder == aboard
            } then {
                say Honk presentation=8 chatter : "La couronne donne un instinct guerrier à celui qui la porte|..."
            }
            when {
                require tableau.holder == aboard
            } then {
                say Honk presentation=8 chatter : "Le Tableau du Grand Yolk fait evoluer l'intelligence des races"
                say Honk presentation=8 chatter : "Car il perpetue la Grande Sagesse du Maitre|..."
                say Honk presentation=8 chatter : "Le Grand Yolk est notre maitre à tous|, Commander|..."
                dictionary blank after "maitre"
            }
            when {
                require image.holder == aboard
            } then {
                say Honk presentation=8 chatter : "La photo d'une Wave|, qu'on appelle aussi une Ondoyante est etrange"
                say Honk presentation=8 chatter : "Elle prend l'aspect de la seduction pour celui qui la regarde|, chacun de nous verra une creature differente|..."
                say Honk presentation=8 chatter : "Les femelles n'aiment pas que leur male possede de telles photos|..."
                say Honk presentation=8 chatter : "Aussi|, la photo de l'Ondoyante fait chuter la reproduction|..."
            }
            when {
                require momie.holder == aboard
            } then {
                say Honk presentation=8 chatter : "La momie des Kam|... reste un mystère|..."
            }
            when {
                require bionium.holder == aboard
            } then {
                say Honk presentation=8 chatter : "Le Bionium, c'est la vie, c'est la séve de l'Univer, a la fois monnaie, cadeau, poison|..."
                say Honk presentation=8 chatter : "Permet d'accélérer l'evolution d'une race"
            }
            when {
                require atomique.holder == aboard
            } then {
                say Honk presentation=8 chatter : "L'Atomique est a consommer avec irradiation|..."
                say Honk presentation=8 chatter : "Mais un formidable accelerateur d'évolution"
            }
            when {
                require technologie.holder == aboard
            } then {
                say Honk presentation=8 chatter : "La Technologie donne du coeur à l'ouvrage|..."
            }
            when {
                require credit.holder == aboard
            } then {
                say Honk presentation=8 chatter : "Crédit ou Cybermonnaie, sert à acheter des objets ou des étres|..."
            }
            when {
                require parfum.holder == aboard
            } then {
                say Honk presentation=8 chatter : "Le Parfum|... Ils adorent|!!!"
            }
            when {
                require guitare.holder == aboard
            } then {
                say Honk presentation=8 chatter : "La Guitare symbolise la musique, les arts, la culture|..."
            }
            when {
                require energie.holder == aboard
            } then {
                say Honk presentation=8 chatter : "L'Energie|... comme son nom l'indique.... OUAAAOU!!!"
            }
            when {
                require bague.holder == aboard
            } then {
                say Honk presentation=8 chatter : "La Bague|... Encore une histoire de gonzesse|..."
            }
            when {
                require ecriture.holder == aboard
            } then {
                say Honk presentation=8 chatter : "L'Ecriture et la premiére des choses à apprendre|..."
            }
            when {
                require vaisseau.holder == aboard
            } then {
                say Honk presentation=8 chatter : "Le Vaisseau... Bon pour la migration..."
            }
            when {
                require trait_C3_A9.holder == aboard
            } then {
                say Honk presentation=8 chatter : "Le Traite calme les esprits..."
            }
            when {
                require cadeaux.holder == aboard
            } then {
                say Honk presentation=8 chatter : "Les Cadeaux font toujours plaisir... OUI! OUI!"
            }
            say Honk presentation=8 chatter : "Voila|..."
            say Honk presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
        when {
            require choice == "non"
        } then {
            say Honk presentation=8 chatter : "C'est comme vous voulez|, Commander|... Je sais qu'un jour vous me direz oui|..."
            say Honk presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
    }
    proc honsecur enabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=8 if_not_shown skip_next=2 : "Krouik|..."
        end presentation Honk
        run profile SCRIPT2
    }
    proc mensecur enabled {
        during bridge
        require presentation == menu
    } then {
        when {
            require globals.A4 == 0
        } then {
            text_tokens menu presentation=8 : "CREDITS" "..." "..." "..." "..." state_number(0x1EF2) "CREDIT"
            say menu presentation=8 : "Vous etes fauche|..."
            when {
                require menu.encounter_count > 5
            } then {
                say menu presentation=8 : "Il y a une c|..... dans le potage|, Commander|..."
