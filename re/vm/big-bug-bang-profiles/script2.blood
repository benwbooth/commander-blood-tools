    proc testobj enabled {
        require globals.A3 == 0
    } then {
        when {
            require couronne.holder != aboard
            require tableau.holder != aboard
            require image.holder != aboard
            require momie.holder != aboard
            require technologie.holder != aboard
            require guitare.holder != aboard
            require parfum.holder != aboard
            require decodeur.holder != aboard
