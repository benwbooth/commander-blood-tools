    proc intern enabled {
        during bridge
        require presentation == internet
    } then {
        when {
            random_guard 0x0001
            require globals.B82 == 2
            require globals.vbio < 10
        } then {
            say internet presentation=8 : "Voulez-vous plein de bionium|?..."
            say internet presentation=8 chatter resume_at=intern_dialogue_resume_1 : "..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                bionium.holder = aboard
                globals.vbio += 5
                choice = none
            }
            when {
                require choice == "non"
            } then {
                choice = none
            }
        }
        intern_dialogue_resume_1:
        when {
            require internet.encounter_count == 1
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "Vous ne préferez pas la télé|, Commander|?..."
            say internet presentation=8 if_not_shown skip_next=3 : "..."
            end presentation internet
            decodeur.holder = aboard
            sequence_slots[4] = "21pubdecod"
        }
        when {
            require internet.encounter_count == 3
        } then {
            say internet presentation=8 : "ftt|.. netcom|. com|. blood|. 3427654 K|... WAIT|..."
            say internet presentation=8 : "...|...|... Serveur saturé|, renouvelez votre appel ultérieurement|..."
            say internet presentation=8 : "Saturated Network|, try your call later|..."
            say internet presentation=8 chatter : "Aie|, Commander|, le reseau est sature|, c'est l'heure de pointe|..."
            say internet presentation=8 if_not_shown skip_next=1 : "..."
            end presentation internet
        }
        when {
            require globals.B82 < 2
            require globals.C7 == 0
            require bits(Otto_Von_Gluk.flags,0x0004)
            require bits(Kero_Zen.flags,0x0004)
            require bits(Izwalito.flags,0x0004)
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "Ici Bernie|... Bernie Von Nanard|..."
            say internet presentation=8 chatter : "bernie|! vous venez nous berniquer|?..."
            say internet presentation=8 : "Pas pour tout l'or du monde|!..."
            say internet presentation=8 : "Mais pour un crédit ou deux|, par contre|..."
            say internet presentation=8 : "Non|... Je plaisante|..."
            say internet presentation=8 : "Chuis venu te proposer un deal, le crack|! T'es un vrai cerveau, et j'aime ca|!..."
            say internet presentation=8 : "Alors voilà le tableau|!... Plutot que perdre ton temps comme un minable à résoudre des énigmes de crétin|..."
            say internet presentation=8 : "... Des histoires de vaisseau et d'évolution et patati et patata|..."
            say internet presentation=8 : "... Est-ce que tu préférerais pas tricher|?..."
            say internet presentation=8 chatter resume_at=trinard1 : "tricher|?..." choices "bien_sùr" "jamais"
            when {
                require choice == "jamais"
            } then {
                say internet presentation=8 : "Mais ci|... T'es qu'un tocard, mais on va faire de grandes choses ensemble|!..."
                say internet presentation=8 chatter : "on commence quand|?..."
                say internet presentation=8 if_not_shown skip_next=2 : "..."
                globals.C7 = 1
                choice = none
            }
            when {
                require choice == "bien_sùr"
            } then {
                say internet presentation=8 : "On va faire des grandes choses ensemble|!..."
                say internet presentation=8 chatter : "on commence quand|?..."
                say internet presentation=8 if_not_shown skip_next=2 : "..."
                globals.C7 = 1
                choice = none
            }
        }
    }
    proc trinard1 enabled {
        during bridge
        require presentation == internet
    } then {
        when {
            require globals.C7 == 1
        } then {
            say internet presentation=8 : "Tout de suite|... Mais avant faut que je sache|..."
            say internet presentation=8 : "Est-ce que tu serais prét à mentir méme à ta mére|?..."
            say internet presentation=8 chatter resume_at=trinard1_dialogue_resume_1 : "meme à votre mere, commander|?..." choices "meme" "plutot_crever"
            when {
                require choice == "meme"
            } then {
                say internet presentation=8 : "Bravo petit|! T'es vraiment sans scrupules|! Tu iras trés trés loin|!..."
                say internet presentation=8 chatter : "facile, avec un vaisseau comme l'arche|!..."
                say internet presentation=8 if_not_shown skip_next=2 : "..."
                globals.C7 = 2
                choice = none
            }
            when {
                require choice == "plutot_crever"
            } then {
                say internet presentation=8 : "T'as raison mon vieux|! Plutot crever|!..."
                say internet presentation=8 chatter : "on est moral ou on l'est pas|!..."
                say internet presentation=8 : "Parfaitement petit|! On est moral ou on n'est pas|..."
                say internet presentation=8 if_not_shown skip_next=3 : "..."
                end presentation internet
                globals.A13 = 1
                choice = none
            }
        }
        trinard1_dialogue_resume_1:
        when {
            require globals.C7 == 2
        } then {
            say internet presentation=8 : "Bon|... Encore une petite question d'examen de moralité|..."
            say internet presentation=8 : "Est-ce que tu mentirais MEME A YOLK|?..."
            say internet presentation=8 chatter resume_at=corrup : "meme a yolk|?..." choices "no_problemo" "ah_non_jamais"
            when {
                require choice == "no_problemo"
            } then {
                say internet presentation=8 : "T'es pas fou non|? Y a quand méme des limites|!..."
                say internet presentation=8 : "krouik|..."
                say internet presentation=8 chatter : "commander|... on est brouille|..."
                say internet presentation=8 : "krouik|..."
                say internet presentation=8 : "Ici la Ligue Intergalactique de Vertu|..."
                say internet presentation=8 chatter : "aie aie|..."
                say internet presentation=8 : "On a tout entendu|! On répétera tout à Yolk|!..."
                say internet presentation=8 chatter : "on etait sur écoute|! on est grille, commander|..."
                say internet presentation=8 chatter : "mais bon|... la morale est sauve|, elle|..."
                say internet presentation=8 : "krouik|..."
                say internet presentation=8 if_not_shown skip_next=3 : "..."
                end presentation internet
                globals.A13 = 1
                choice = none
            }
            when {
                require choice == "ah_non_jamais"
            } then {
                say internet presentation=8 : "T'as bien raison petit|, y a des limites|..."
                say internet presentation=8 chatter : "c'est ca la morale|... on respecte yolk|..."
                say internet presentation=8 : "Non c'est pas ça|... Mais de toutes façons ça servirait à rien d'essayer de le gruger|..."
                say internet presentation=8 : "Il sait tout, il voit tout, il est partout|... Qu'est-ce qu'on peut faire|?..."
                say internet presentation=8 chatter : "..."
                say internet presentation=8 : "Rien|! Parfaitement|!..."
                say internet presentation=8 if_not_shown skip_next=2 : "..."
                globals.C7 = 3
                choice = none
            }
        }
    }
    proc corrup enabled {
        during bridge
        require presentation == internet
    } then {
        when {
            require globals.C7 == 3
        } then {
            say internet presentation=8 : "Bon ben on est quand méme là pour tricher|..."
            say internet presentation=8 : "File-moi un crédit|, je vais corrompre la Ligue des Scénaristes|..."
            when {
                require globals.A4 == 0
            } then {
                say internet presentation=8 chatter : "commander|... on n'a rien sur nous|..."
                say internet presentation=8 : "Va tirer du fric chez les GLUXX|, je reste connecté sur le Net|..."
                say internet presentation=8 if_not_shown skip_next=1 : "..."
                end presentation internet
            }
            say internet presentation=8 chatter resume_at=corrup_dialogue_resume_1 : "commander|, vous acceptez de lui envoyer un credit|?..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say internet presentation=8 chatter if_not_shown skip_next=1 : "INTERNETELEPORTATION CREDIT CORRUPTION"
                transfer credit from aboard to internet
                say internet presentation=8 : "Bon|... Je vais corrompre et je reviens|... A tout d'suite|!..."
                say internet presentation=8 if_not_shown skip_next=3 : "..."
                globals.A4 -= 1
                globals.C7 = 4
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say internet presentation=8 : "Faudrait savoir ce que tu veux|..."
                say internet presentation=8 : "Tiens tu m'énerves|, tocard|! Retourne dans ton univers|!..."
                say internet presentation=8 if_not_shown skip_next=3 : "..."
                end presentation internet
                globals.A13 = 1
                choice = none
            }
            corrup_dialogue_resume_1:
            say internet presentation=8 if_not_shown skip_next=1 : "..."
            end presentation internet
        }
        when {
            require globals.C7 == 4
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 if_not_shown skip_next=1 : "Ici Bernie|... C'est bon|, je te connecte|... Te plante pas|, y a un mot de passe|..."
            globals.C7 = 5
        }
        when {
            require globals.B82 < 2
            require globals.C7 == 5
        } then {
