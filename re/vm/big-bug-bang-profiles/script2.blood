            end presentation Honk
            globals.C8 = 2
            sequence_slots[6] = "9scrutbox"
            choice = none
        }
        when {
            require choice == "non"
        } then {
            say Honk presentation=8 chatter : "bien joue commander|, on ne sait jamais avec ce chien intergalactique|..."
            say Honk presentation=8 chatter : "bien joue commander|, on ne sait jamais|..."
            say Honk presentation=8 chatter : "bien joue commander|, on ne|... gargl|... sait jamais|..."
            say Honk presentation=8 chatter : "commander|! petit piteux m'a bugge|! il s'est loge dans la tele|!..."
            say Honk presentation=8 chatter if_not_shown skip_next=4 : "..."
            end presentation Honk
            globals.C8 = 2
            sequence_slots[6] = "9scrutbox"
            choice = none
        }
    }
