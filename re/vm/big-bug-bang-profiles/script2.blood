            say Honk presentation=8 chatter : "qu'est-ce que ca veut dire|?..."
            say Honk presentation=8 chatter : "ouie,odorat,gout,vision|..."
        }
    }
    proc rebelp enabled {
        during bridge
        require globals.C8 == 1
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "commander|, je capte une onde subversive|..."
        say Honk presentation=8 chatter : "comme une resistance anti-scruters|..."
