    proc waw enabled {
        during bridge
        require globals.B81 == 0
        require globals.A72 == 1
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "commander|... c'est la paix dans l'univers|... vous avez eu raison de couronner le zen|..."
        say Honk presentation=8 chatter : "l'evolution globale a fait un bond|! nous approchons du terme de notre mission|..."
        say Honk presentation=8 chatter : "bravo commander|! bien joue|! c'est monsieur bob qui va etre content|..."
        say Honk presentation=8 : "krouik|... BOB|... krouik|..."
        say Honk presentation=8 chatter : "monsieur bob|! commander|! monsieur bob revit|! il se materialise dans la cryobox|!|..."
        say Honk presentation=8 chatter : "vite|! ah là là|! c'est excitant|!|..."
        say Honk presentation=8 if_not_shown skip_next=3 : "..."
        globals.B81 = 1
        Bob_Morlock.active = true
        Bob_Morlock.current_location = aboard
    }
    proc preond enabled {
        require globals.A64 == 0
        during contact
        require Bob_Morlock.current_location == aboard
        require globals.B81 == 1
        require presentation == Bob_Morlock
    } then {
        say Bob_Morlock presentation=9 : "Mmmm|..."
        say Bob_Morlock presentation=8 chatter : "monsieur bob|! quel bonheur de vous revoir vivant!|... nous avons mené notre mission à bien|!..."
        say Bob_Morlock presentation=10 : "Mmmm|..."
        say Bob_Morlock presentation=8 chatter : "ah ah|! vous avez gagné, commander|!|..."
        say Bob_Morlock presentation=11 : "Non|! Pas encore|! Je me suis incarné pour un court instant|..."
        say Bob_Morlock presentation=12 : "Gràce à l'énergie dégagée par l'autolyse des ZEN|..."
        dictionary blank after "Gràce"
        say Bob_Morlock presentation=8 chatter : "quoi|? les zen ont disparu|!|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "Ils ont rejoint le cosmos|..."
        request sequence "star2.hnm"
        say Bob_Morlock presentation=13 : "Je ne peux pas rester longtemps|... Continuez votre travail d'évolution|..."
        say Bob_Morlock presentation=8 chatter : "c'est tout|, monsieur bob|?|..."
        say Bob_Morlock presentation=14 : "Non|... Je suis venu vous apporter le futur|... J'ai déchiré le temps comme un mouchoir|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "... pour vous apporter le futur|..."
        request sequence "galaxi.hnm"
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "... et faire venir l'avenir|..."
        request sequence "legion01.hnm"
        say Bob_Morlock presentation=15 : "En espérant que tout va bien se passer|..."
        say Bob_Morlock presentation=12 : "... passer|..."
        say Bob_Morlock presentation=8 chatter : "monsieur bob|! non! ne partez pas|!..."
        say Bob_Morlock presentation=8 chatter : "ne me laissez pas seul avec ce fou de commander|!|..."
        say Bob_Morlock presentation=13 : "Débrouille-toi|... Adieu|..."
        say Bob_Morlock presentation=8 chatter : "non! j'ai peur|!|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=6 : "..."
        end presentation Bob_Morlock
        Super_Zen.current_location = Trashlando
        Kero_Zen.current_location = Trashlando
        Ben_Zen.current_location = Trashlando
        Bob_Morlock.current_location = Trashlando
        globals.B81 = 2
    }
