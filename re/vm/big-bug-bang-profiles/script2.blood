            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "Sois bien sage|!|..."
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 chatter : "Ca a coupe|, commander|, elle vous embrasse|..."
            say internet presentation=8 : "..."
        }
        when {
            require bits(Super_Zen.flags,0x0004)
            require couronne.holder == aboard
            random_guard 0x0005
        } then {
            say internet presentation=8 : "krouik KROUIK|!|!|!|..."
            say internet presentation=8 chatter : "oulà|! message ultraprioritaire|, commander|!|..."
            say internet presentation=8 : "VA FAIRE TES DEVOIRS|!|!|!"
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 chatter : "c'etait la frequence de votre mere|, je crois|..."
            say internet presentation=8 : "..."
        }
        when {
            require globals.C9 == 0
            require bits(Emasculator.flags,0x0004)
            require globals.A73 == 2
            require bits(Tequila.flags,0x0004)
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "A toutes les races concernées|... Je répéte|..."
            say internet presentation=8 : "A toutes les races concernées|..."
            say internet presentation=8 : "Le Commander est un escroc|... Un mauvais scénariste|..."
            say internet presentation=8 : "Méfiez-vous de lui|..."
            say internet presentation=8 chatter : "commander|! c'est scandaleux|! qui peut envoyer des messages pareils|?|..."
            say internet presentation=8 chatter resume_at=inter13_dialogue_resume_1 : "voulez-vous que je tente de l'identifier|?" choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say internet presentation=8 chatter : "...|...|...|...|...|...|...|...|...|...|...|...|... searching"
                say internet presentation=8 chatter : "...|...|...|...|...|...|...|...|...|...|...|...|... searching"
                say internet presentation=8 chatter : "...|...|... found|! XXX access control connect|..."
                say internet presentation=8 chatter : "commander|... j'ai trouve quelque chose|..."
                say internet presentation=8 : "Ici Cassandre|..."
                say internet presentation=8 chatter : "qui|?|..."
                say internet presentation=8 : "Cassandre|... L'Univers est en danger|... Attention aux femelles|..."
                say internet presentation=8 : "krouik|..."
                say internet presentation=8 chatter : "je l'ai perdu|, commander|... Attention aux femelles|! n'importe quoi|!|..."
                say internet presentation=8 if_not_shown skip_next=3 : "..."
                globals.C9 = 1
                end presentation internet
                choice = none
            }
            when {
                require choice == "non"
            } then {
                choice = none
            }
            inter13_dialogue_resume_1:
            say internet presentation=8 chatter : "vous ne me faites pas confiance ou quoi|?|..."
            say internet presentation=8 : "..."
        }
    }
    proc inter14 enabled {
        during bridge
        require presentation == internet
    } then {
        when {
            require globals.C9 == 1
            require globals.A74 == 0
            require globals.A73 == 2
            require couronne.holder != aboard
            require bits(Tequila.flags,0x0004)
            require globals.vbio > 0
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "A toutes les races concernées|..."
            say internet presentation=8 chatter : "attention commander|!|..."
            say internet presentation=8 : "Echange information extratemporelle contre bionium internetéléporte|..."
            dictionary blank after "internetéléporte"
            say internet presentation=8 chatter resume_at=inter14_dialogue_resume_1 : "un indice|, commander|... vous acceptez de l'acheter contre du bionium|?" choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say internet presentation=8 chatter : "honk à indicateur|... transaction OK|..."
                say internet presentation=8 : "Envoyez bionium|..."
                say internet presentation=8 chatter : "INTERNETELEPORTATION BIONIUM|..."
                say internet presentation=8 chatter : "envoyez indice|..."
                say internet presentation=8 : "La couronne voyage dans le temps|..."
                say internet presentation=8 chatter : "quoi|? c'est ca l'indice|?|..."
                say internet presentation=8 : "La couronne voyage dans le temps|..."
                say internet presentation=8 if_not_shown skip_next=3 : "..."
                globals.C9 = 2
                globals.vbio -= 1
                choice = none
            }
            when {
                require choice == "non"
            } then {
                choice = none
            }
            inter14_dialogue_resume_1:
            say internet presentation=8 : "krouik|..."
        }
        when {
            require couronne.holder != aboard
            require globals.A74 == 1
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "A toutes les races concernées|..."
            say internet presentation=8 : "Information ultrasecréte contre bionium|..."
            say internet presentation=8 chatter : "combien de doses|?..."
            say internet presentation=8 : "euh|... 1500|..."
            say internet presentation=8 chatter : "quoi|!? ca va pas|?!..."
            say internet presentation=8 : "Non|, je déconne|... C'est offert par Monsieur Bob|..."
            say internet presentation=8 chatter : "alors|, cette info|?|..."
            say internet presentation=8 : "Pour obtenir le pouvoir|, il faudra perdre l'odorat|, l'ouie|, le gout|, la vue et ne pas se tromper|..."
            say internet presentation=8 chatter : "quoi|?|..."
            say internet presentation=8 : "Si tu veux la couronne|... Il faudra perdre quatre de tes cinq sens|..."
            say internet presentation=8 chatter : "perdre|?|..."
            say internet presentation=8 : "Donner|..."
            say internet presentation=8 chatter : "donner|? à qui|?|..."
            say internet presentation=8 : "Oh tu verras bien|!|..."
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 chatter : "Ca a coupe|..."
            say internet presentation=8 if_not_shown skip_next=1 : "..."
            globals.A74 = 2
        }
        when {
            require bits(Daddy_Gluxx.flags,0x0004)
            require globals.DGECR == 1
            require state_b1[internet.population] > 100
            require vaisseau.holder != aboard
            require !bits(Papy_Gluxx.flags,0x0004)
            require !bits(Mamy_Gluxx.flags,0x0004)
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "Ici Ulikan|..."
            say internet presentation=8 chatter : "qui ca|?|..."
            say internet presentation=8 : "Ton patron|, idiot|!|..."
            say internet presentation=8 chatter : "oh patron|! comment ca va|?|..."
            say internet presentation=8 : "Mal|... Y parait que tu fais pas ton boulot|... Tu n'as rien à faire chez CRYO|!..."
            say internet presentation=8 chatter : "mais patron|!|..."
            say internet presentation=8 : "Des scénaristes comme toi|, y en a à la pelle|! Alors dépéche-toi de faire migrer les GLUXX avant que je me fàche|!..."
            say internet presentation=8 chatter : "mais patron|, on n'a pas de vaisseau|!|..."
            say internet presentation=8 : "Y a pas de mais|! T'as qu'à en trouver un|!|..."
            say internet presentation=8 : "Allez va|! J'ai pitié de toi|! Je t'en envoie un|!"
            say internet presentation=8 chatter if_not_shown skip_next=1 : "INTERNETELEPORTATION VAISSEAU SUR CRYOBOX|..."
            vaisseau.holder = aboard
            say internet presentation=8 chatter : "merci patron|!|..."
            say internet presentation=8 : "Laisse tomber|... Ce sera retenu sur ta paie|..."
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "..."
        }
        when {
            require globals.A86 == 1
            require bits(Trump.flags,0x0004)
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "Message de Trump à toutes races concernées|!|..."
            say internet presentation=8 : "Attention on vous trompe|! Foi de Trump|!|..."
            say internet presentation=8 : "N'achetez pas d'infos sur Internet|... Surtout contre du bionium|..."
            say internet presentation=8 : "Celui qui les vend est un drogue et un alcoolique|..."
            say internet presentation=8 chatter : "vous savez qui c'est|?|..."
            say internet presentation=8 : "Oui|... Quelqu'un qui vend des secrets à tout le monde pour se fournir du bionium et de la|..."
            say internet presentation=8 chatter : "de la|?|..."
            say internet presentation=8 : "De l'alcool|... C'est une vraie balance|..."
            say internet presentation=8 chatter : "commander|! voilà notre espion|!|..."
            say internet presentation=8 : "Il faut le détruire|! Il nuit à votre scénario|..."
            say internet presentation=8 chatter : "Trump|! Dites-nous qui c'est|!|..."
            say internet presentation=8 : "Je ne peux pas|... Je ne suis pas une balance|, moi|!|..."
            say internet presentation=8 chatter : "allez|!|..."
            say internet presentation=8 : "Venez me voir chez moi|... Le Net a des oreilles|..."
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 chatter : "allons-y|, commander|..."
            say internet presentation=8 if_not_shown skip_next=2 : "..."
            globals.A86 = 2
            end presentation internet
        }
        when {
            require globals.A86 > 1
            require globals.A87 == 0
        } then {
            say internet presentation=8 : "krouik|... Ici Tequila|!|..."
            say internet presentation=8 : "Commander|... J'ai une information terrible sur le cyber espion|..."
            say internet presentation=8 chatter : "vous savez qui c'est|?|..."
            say internet presentation=8 : "Oui|... Je sais|..."
            say internet presentation=8 chatter : "vous nous le dites|?|..."
            say internet presentation=8 : "D'accord|... Eh bien c'est moi|!|..."
            say internet presentation=8 chatter : "quoi|? vous|!|... C'est pas vrai|!|?|..."
            say internet presentation=8 : "Non|, c'est pas vrai|, mais ca pourrait|..."
            say internet presentation=8 : "Tréve de plaisanterie|, je sais qui c'est|... Venez me voir et je vous le dirai|..."
            say internet presentation=8 chatter : "on arrive|..."
            say internet presentation=8 if_not_shown skip_next=2 : "..."
            globals.A87 = 1
            end presentation internet
        }
        when {
            require globals.A61 == 6
            require globals.A4 == 0
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "Ici BOB|..."
            say internet presentation=8 chatter : "p|... patron|! enfin vous revoilà|! comment est-ce possible|?|..."
            say internet presentation=8 : "Idiot c'est pas possible|! C'est pas BOB|, c'est Ulikan|! Je te fais une blague|!..."
            say internet presentation=8 chatter : "ah c'est vous patron|! on a plein d'ennuis|..."
            say internet presentation=8 : "Je sais|, c'est pour ça que je suis là|... Tiens, je t'envoie de l'argent pour arroser les grevistes|!..."
            say internet presentation=8 chatter : "mais si on les arrose|, ils vont pousser|!|..."
            say internet presentation=8 : "Idiot|! On va les pousser à reprendre le travail|!|..."
            say internet presentation=8 chatter if_not_shown skip_next=2 : "INTERNETELEPORTATION BUDGET SPECIAL GREVE|..."
            globals.A4 += 3
            credit.holder = aboard
            say internet presentation=8 : "Allez|! Au boulot|!"
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 if_not_shown skip_next=1 : "..."
            end presentation internet
        }
        when {
            require globals.B88 > 0
            random_guard 0x0003
        } then {
            say internet presentation=8 : "krouik|..."
            say internet presentation=8 : "Message scrut|... Message scrut|..."
            say internet presentation=8 : "MESSAGE SCRUTER|..."
            say internet presentation=8 : "Au prochain scrutin|..."
            say internet presentation=8 : "VOTEZ SCRUTER|..."
            say internet presentation=8 : "AVEC SCRUTER|, UN UNIVERS Où IL FAIT BON SCRUTER|!|..."
            say internet presentation=8 : "Ceci etait un message scrut offert par le Front Intergalactique Satellitaire|..."
            say internet presentation=8 : "krouik|..."
        }
        when {
            require globals.B88 == 1
        } then {
            say internet presentation=8 : "Rejoignez les scruters|, le Parti de l'Ordre|..."
            say internet presentation=8 : "SCRUTERS|, DES ROBOTS AUX MAINS PROPRES ET PLEINES D'HUILE|..."
            say internet presentation=8 : "Le parti de l'Ordre|, c'est|..."
            say internet presentation=8 : "Ce sont|..."
            say internet presentation=8 : "C'est|... L'ordre|, c'est|... Comment dire|?|..."
            say internet presentation=8 : "L'ORDRE|? CE SONT LES SCRUTERS QUI EN PARLENT LE MIEUX|..."
            say internet presentation=8 : "krouik|..."
        }
        when {
            require globals.B88 == 2
            require globals.C8 == 0
        } then {
            say internet presentation=8 : "Votre vie manque d'ordre|?|..."
            say internet presentation=8 : "Rejoignez la légion étrange des SCRUTERS|..."
            say internet presentation=8 : "Un cerveau tout neuf et bien lavé vous sera offert|..."
            say internet presentation=8 : "AVEC VOTRE NOUVELLE CARCASSE DE SCRUTER|!|..."
            say internet presentation=8 : "Engagez-vous|! L'Univers a besoin de toi|!|..."
            say internet presentation=8 : "Si tu crois aux valeurs|..."
            say internet presentation=8 : "Si tu n'aimes pas les voleurs|..."
            say internet presentation=8 : "Si tu te sens plein d'ardeur|..."
            say internet presentation=8 : "Si tu n'aimes pas toutes les odeurs|..."
            say internet presentation=8 : "ENGAGE-TOI CHEZ LES SCRUTERS|!|..."
            say internet presentation=8 : "LA LEGION A BESOIN DE TOI|!|..."
            say internet presentation=8 if_not_shown skip_next=7 : "KROUIK|..."
            end presentation internet
            globals.C8 = 1
            sequence_slots[1] = "14legscrut"
            sequence_slots[2] = "14legscrut"
            sequence_slots[3] = "14legscrut"
            sequence_slots[4] = "14legscrut"
            sequence_slots[5] = "14legscrut"
        }
        say internet presentation=8 if_not_shown skip_next=1 : "..."
        end presentation internet
    }
    proc honcrul enabled {
        during bridge
        require globals.A4 == 0
        require globals.A61 == 6
        require presentation == Honk
    } then {
        when {
            require globals.A4 == 0
