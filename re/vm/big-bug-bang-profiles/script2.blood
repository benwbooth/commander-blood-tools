            }
        }
        when {
            require globals.vbio > 0
        } then {
            text_tokens menu presentation=8 : "Vous" "avez" state_number(0x20AA) "container" "de" "BIONIUM" "pur" "..."
        }
        say menu presentation=8 resume_at=mensecur_dialogue_resume_1 : "Autre chose|, Commander?" choices "oui" "non"
        when {
            require choice == "oui"
        } then {
            choice = none
        }
        when {
            require choice == "non"
        } then {
            say menu presentation=8 : "A vos ordres|!"
            say menu presentation=8 : "Krouik|..."
            say menu presentation=8 if_not_shown skip_next=2 : "..."
            end presentation menu
            choice = none
        }
        mensecur_dialogue_resume_1:
        when {
            require globals.A99 == 0
        } then {
            say menu presentation=8 : "PROGRAMME METAGLUK VERSION 1043265"
            say menu presentation=8 : "Code de commande cyberpsy A 33"
            say menu presentation=8 : "Temperature: 33 degres."
            say menu presentation=8 : "Processeur OLGA P6: on"
            say menu presentation=8 resume_at=mensecur_dialogue_resume_2 : "Ici OLGA|, ex-Bioredactrice de Bord|. Tapez votre commande|." choices "bionium" "uranium" "géranium" "délirium"
            when {
                require choice != "géranium"
            } then {
                say menu presentation=8 : "Metagluk multiplexe|..."
                say menu presentation=8 : "A3 égale 34|..."
                dictionary blank after "égale"
                say menu presentation=8 : "Vibromasseur: on"
                say menu presentation=8 : "bzzzzzzzzzz|... bzzzzzzzzzzzz|... Hi|! Hi|! Hi|! Hi|!"
                say menu presentation=8 if_not_shown skip_next=2 : "..."
                end presentation menu
