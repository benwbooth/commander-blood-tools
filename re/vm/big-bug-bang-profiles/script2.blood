    proc scrujo enabled {
        during contact
        require presentation == Scruter_Jo
    } then {
        say Scruter_Jo presentation=28 : "Commander vous pouvez aller chercher du BIONIUM dans le CYBERSPACE de SCRUTER JO|..."
        when {
            require globals.A12 == 0
        } then {
            say Scruter_Jo presentation=9 : "Je vais vous expliquer comment collecter du BIONIUM dans mon cerveau|..."
            say Scruter_Jo presentation=11 : "Vous allez trouver des BIOXX|. Les Bioxx sont des trains d'énergie qui flottent dans l'espace|..."
            say Scruter_Jo presentation=10 : "Vous allez attraper des BIOXX avec votre main virtuelle|."
            dictionary blank after "virtuelle"
            say Scruter_Jo presentation=8 chatter : "Ca semble facile|, Commander|!|!"
            say Scruter_Jo presentation=11 : "Si vous touchez un BIOXX|, vous le CAPTUREZ au bout de votre doigt|..."
            say Scruter_Jo presentation=8 chatter : "L'attraper au bout du doigt|!|!|! Fastoche|, Commander|..."
            say Scruter_Jo presentation=12 : "Vous devez apporter le BIOXX aux MANTAS cybernétiques"
            say Scruter_Jo presentation=14 : "Vous devez placer le BIOXX sur le ventre des MANTAS|..."
            say Scruter_Jo presentation=8 chatter : "PLACER LE BIOXX SUR LE VENTRE DES MANTAS..."
            say Scruter_Jo presentation=8 chatter : "J'ai hàte de voir ca|... Commander|..."
            say Scruter_Jo presentation=15 : "Les Mantas changent le BIOXX en BIONIUM|..."
            say Scruter_Jo presentation=14 : "Plus vous donnerez de BIOXX aux MANTAS|, plus vous récupérerez de BIONIUM|..."
            say Scruter_Jo presentation=8 chatter : "OUI|!|!|! DU BIONIUM|... Je veux gouter à ca|..."
            say Scruter_Jo presentation=13 : "Pour sortir du CYBERSPACE|, vous toucherez la BOITE BLEUE|..."
            say Scruter_Jo presentation=15 : "Bien compris|?"
            say Scruter_Jo presentation=8 chatter : "On a parfaitement compris|, Monsieur SCRUTER JO|... Pas vrai|, Commander|?"
        }
        say Scruter_Jo presentation=29 : "Allez-y|, Commander|..."
        say Scruter_Jo presentation=30 : "Ahh|! Quelle sensation|..."
        when {
            require globals.vbio > 0
        } then {
            say Scruter_Jo presentation=11 : "Bon travail|... Bravo|..."
            text_tokens Scruter_Jo presentation=12 : "Vous" "avez" state_number(0x20AA) "BIONIUM" "..."
            say Scruter_Jo presentation=8 chatter : "OUAIS|!|!|! Commander|, vous etes un champion|..."
            say Scruter_Jo presentation=8 chatter : "Ce BIONIUM est extraordinaire|. Mon horloge interne a triple sa vitesse|..."
            say Scruter_Jo presentation=8 chatter if_not_shown skip_next=1 : "Je me sens bien|, Commander|..."
            globals.A12 = 1
        }
        when {
            require globals.vbio == 0
        } then {
            say Scruter_Jo presentation=13 : "Pas bon|, ami|... T'as pas reussi|..."
            say Scruter_Jo presentation=8 chatter : "Commander|, vous n'avez pas compris la technique|..."
            say Scruter_Jo presentation=8 chatter : "Sans BIONIUM|, je doute que nous puissions reussir cette mission|..."
            say Scruter_Jo presentation=13 : "Ha|! Ha|! Ha|! Ha|!|..."
            say Scruter_Jo presentation=8 chatter : "Oh toi|, ca suffit|!|!|!"
        }
        say Scruter_Jo presentation=16 if_not_shown skip_next=1 : "Adieu|, Commander|. Je retourne dans mon CYBERSPACE|..."
        end presentation Scruter_Jo
    }
