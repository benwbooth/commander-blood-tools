            end presentation Trump
        }
        say Trump presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Trump
    }
    proc _2fintro as "2fintro" enabled {
        during contact
        require globals.A68 == 2
        require Tramp.current_location == aboard
        require presentation == Tramp
    } then {
        say Tramp presentation=10 : "Mets-moi une trampe|!..."
        say Tramp presentation=12 : "Je réve|!..."
        say Tramp presentation=11 : "Non mais t'as vu|?..."
        say Tramp presentation=8 if_not_shown skip_next=3 : "..."
        globals.A13 += 3
        end presentation Tramp
        sequence_slots[3] = "34contromp"
    }
    proc nconpre enabled {
        during bridge
        require presentation == Tramp
        require globals.A64 == 2
    } then {
        say Tramp presentation=8 : "He|! Commander|!..."
        say Tramp presentation=8 : "C'est Tramp|! Il fait beau chez vous|?..."
        say Tramp presentation=8 chatter : "ouais bof|!..."
        say Tramp presentation=8 : "Parce qu'ici il pleut comme murfalo qui pisse|!..."
        say Tramp presentation=8 : "Je suis trempé|!..."
        say Tramp presentation=8 : "Enfin je vais sécher sur l'Arche|!..."
        say Tramp presentation=8 chatter : "comment ca|?..."
        say Tramp presentation=8 : "Oui|! On arrive tous pour le concert|!..."
        say Tramp presentation=8 : "krouik|..."
        when {
            random_guard 0x0001
        } then {
            Trump.current_location = aboard
            Tramp.current_location = aboard
            Super_Tromp.current_location = aboard
            Rotator.current_location = aboard
            Outrageor.current_location = aboard
            Eviscerator.current_location = aboard
            Tequila.current_location = aboard
            Emasculator.current_location = aboard
            Blue_Wave.current_location = Trashlando
            Mig_Burner.current_location = Trashlando
        }
        when {
            random_guard 0x0001
        } then {
            Marakas.current_location = aboard
            Izwalito.current_location = aboard
            Daddy_Gluxx.current_location = aboard
            Mamy_Gluxx.current_location = aboard
            Papy_Gluxx.current_location = aboard
            Otto_Von_Smile.current_location = aboard
            Otto_Von_Gluk.current_location = aboard
            Cyberquizz.current_location = Trashlando
            Migrator.current_location = Trashlando
            Mega_Paul.current_location = Trashlando
        }
        say Tramp presentation=8 chatter : "ca promet|, commander|!..."
        say Tramp presentation=8 if_not_shown skip_next=3 : "..."
        end presentation Tramp
        globals.A64 = 3
        sequence_slots[1] = "34contromp"
    }
    proc tra01 enabled {
        during travel
        require presentation == Tramp
    } then {
        when {
            require globals.A68 == 1
            require guitare.holder != aboard
            require globals.A63 == 0
        } then {
            say Tramp presentation=9 : "Moi c'est Tramp|... Et je fais gréve|... Tu veux une trampe|?..."
            say Tramp presentation=8 chatter : "merci, merci, non|..."
            say Tramp presentation=10 : "Et une super trampe|? Tu veux pas une super trampe|?... Je fais pas la gréve des baffes|..."
            say Tramp presentation=8 chatter : "sans facons, non merci|..."
            say Tramp presentation=11 : "Alors Honk|... On fait pas gréve|?..."
            say Tramp presentation=8 chatter : "J'ai été programmé par monsieur bob pour effectuer un service minimum|..."
            say Tramp presentation=12 : "Mon pauvre vieux|... Dur d'étre une machine|..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Tramp
        }
        when {
            require globals.A63 == 8
        } then {
            say Tramp presentation=9 : "Ca plane pour moi|!..."
            dictionary blank after "plane"
            say Tramp presentation=13 : "Mon réve|, c'est de jouer dans|..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "Un concert de Tina Burner|!..."
            request sequence "lpm4sc1.hnm"
        }
        say Tramp presentation=9 : "Moi Tramp, moi TROMP..."
        text_tokens Tramp presentation=11 : "Y" "a" state_number(0x021C) "tromps" "ici..."
        when {
            require Tramp.encounter_count == 1
        } then {
            say Tramp presentation=9 : "Wa|! Ca plane pour moi|!..."
            say Tramp presentation=11 : "Dites donc|... J'en crois pas mes narines|!..."
            say Tramp presentation=16 : "Woua|! Commander|! Approchez voir|!..."
            say Tramp presentation=10 : "Montrez un peu vos crounouilles|!..."
            say Tramp presentation=8 chatter : "commander|, montrez lui|!..."
            say Tramp presentation=14 : "Wa la vache dis donc|! T'as vu ça|!..."
            say Tramp presentation=12 : "Snif snif|! Elles sentent comme nous|!..."
            say Tramp presentation=9 : "Commander|! Vous étes un TROMP de premiére|!..."
            say Tramp presentation=13 : "Vous avez vu|, les copains|?..."
            say Tramp presentation=13 : "Le Commander est des notres|!..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "Il est des no-otres|! Il a des crounouilles comme les au-autres|!..."
            request sequence "chantro3.hnm"
            say Tramp presentation=8 if_not_shown skip_next=1 : "..."
            globals.A86 = 1
        }
        when {
            require Tramp.encounter_count == 2
        } then {
            say Tramp presentation=16 : "Commander c'est un scandale|!..."
            say Tramp presentation=9 : "Vous ne trouvez pas|..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "Qu'on se moque de vous|?..."
            request sequence "match02.hnm"
            say Tramp presentation=13 : "Hein qu'on se moque de lui|?..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "Ah ca c'est sùr|! Ah ca c'est sùr|!..."
            request sequence "chantro2.hnm"
            say Tramp presentation=9 : "On vous montre toujours les mémes images|!..."
            say Tramp presentation=16 : "C'est un scandale|!..."
            say Tramp presentation=16 : "Toujours les mémes images mises à toutes les sauces|!..."
            say Tramp presentation=15 : "Un exemple au hasard|!..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "Le hachoir à murfalo génétique qui broie du noir|!..."
            request sequence "venthig.hnm"
            say Tramp presentation=14 : "J'en perds mon bandeau|!..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "Ou encore celle-là|!..."
            request sequence "p_cles.hnm"
            say Tramp presentation=8 if_not_shown skip_next=1 : "Et eux|!..."
            request sequence "ettamorf.hnm"
            say Tramp presentation=16 : "Moi j'en ai marre|! Toujours pareil|!..."
        }
        when {
            require Tramp.encounter_count == 3
        } then {
            say Tramp presentation=9 : "Eh|! Vous voulez savoir pourquoi j'ai un bandeau|?..."
            say Tramp presentation=8 chatter resume_at=tra01_dialogue_resume_1 : "..." choices "savoir" "ignorer"
            when {
                require choice == "savoir"
            } then {
                say Tramp presentation=9 : "Eh ben c'est parce que|..."
                say Tramp presentation=14 : "Quand je le léve|, je vois mieux|!..."
                say Tramp presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice == "ignorer"
            } then {
                choice = none
            }
        }
        tra01_dialogue_resume_1:
        when {
            require Tramp.encounter_count == 4
        } then {
            say Tramp presentation=11 : "Vous savez comment j'ai perdu un oeil|?..."
            say Tramp presentation=13 : "En faisant de la gymnastique|!..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "Je me suis mis le doigt dans l'oeil|..."
            request sequence "brs02.hnm"
            say Tramp presentation=16 : "Ca m'a fait super mal|!..."
        }
        when {
            require state_b6[Tramp.evolution] > 400
        } then {
            say Tramp presentation=9 : "Nous on invente des formules magiques|, artisanat local..."
            say Tramp presentation=15 : "On t'en vend une contre un crédit..."
            when {
                require globals.A4 == 0
            } then {
                say Tramp presentation=8 chatter : "Nous n'avons plus de crédits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Tramp presentation=8 chatter resume_at=gest02 : "Vous acceptez de leur acheter une formule magique, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Tramp presentation=8 chatter if_not_shown skip_next=1 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Tramp
                    say Tramp presentation=14 : "FORMULE MAGIQUE:"
                    say Tramp presentation=15 : "HATA HATA HOGLO HULU..."
                    say Tramp presentation=16 : "HAMTOT ZAGLO HOLO HULU..."
                    say Tramp presentation=17 : "HATA HATA HOGLO HULU..."
                    say Tramp presentation=14 : "HERR TOT ZAGLO HOLO HULU..."
                    say Tramp presentation=8 if_not_shown skip_next=2 : "Et voilà..."
                    globals.A4 -= 1
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc gest02 enabled {
        during travel
        require presentation == Tramp
    } then {
