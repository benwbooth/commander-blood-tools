            say Tramp presentation=8 if_not_shown skip_next=1 : "ALLEZ CROOLIS|!..."
            request sequence "match02.hnm"
            say Tramp presentation=8 chatter : "ALLEZ LES TROMPS!!!..."
            say Tramp presentation=8 if_not_shown skip_next=1 : "HONK|! Tu dois rester neutre|!..."
            request sequence "bobb.hnm"
            say Tramp presentation=8 chatter if_not_shown skip_next=4 : "oh pardon monsieur bob|!..."
            state_b6[Tramp.evolution] += 100
            state_b1[Tramp.population] -= 100
            globals.B28 -= 1
            bits(decodeur.flags,0x0040) = false
        }
        when {
            require bits(nourriture.flags,0x0040)
        } then {
            say Tramp presentation=15 : "De la nourriture... Je prends la cuisse du murfalo! Et on ne discute pas..."
            say Tramp presentation=8 chatter if_not_shown skip_next=3 : "HOLA!!! Doucement... Vous avez vu COMMANDER il ne plaisante pas avec la bouffe... HEU! la nourriture je veux dire..."
            state_b5[Tramp.energy] += 300
            Tramp.aggressiveness += 50
            bits(nourriture.flags,0x0040) = false
        }
        when {
            require bits(medicament.flags,0x0040)
        } then {
            say Tramp presentation=16 if_not_shown skip_next=3 : "Des médicaments..."
            state_b6[Tramp.evolution] += 50
            state_b1[Tramp.population] += 250
            bits(medicament.flags,0x0040) = false
        }
        when {
            require bits(armes.flags,0x0040)
        } then {
            say Tramp presentation=14 : "DES ARMES... En garde COMMANDER!!! Vous avez eu peur hein! Je plaisante..."
            say Tramp presentation=8 chatter if_not_shown skip_next=4 : "COMMANDER, je peux revenir... J'aime pas le voir avec des trucs pointus..."
            Tramp.aggressiveness += 350
            state_b6[Tramp.evolution] += 30
            globals.B27 = 1
            bits(armes.flags,0x0040) = false
        }
        when {
            require bits(optique.flags,0x0040)
        } then {
            say Tramp presentation=15 if_not_shown skip_next=3 : "Une Optique... merci! C'est de quel coté que je regarde..."
            state_b6[Tramp.evolution] += 40
            bits(optique.flags,0x0040) = false
            globals.B26 += 1
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Tramp presentation=16 if_not_shown skip_next=2 : "De l'énergie...OUAOUUU!!! La Force est en moi..."
            state_b5[Tramp.energy] = 1000
            bits(energie.flags,0x0040) = false
        }
        when {
            require bits(bague.flags,0x0040)
        } then {
            say Tramp presentation=9 if_not_shown skip_next=4 : "Une bague...Belle pierre... Ca va chercher dans les combien?"
            state_b6[Tramp.evolution] += 50
            state_b1[Tramp.population] += 200
            globals.B28 += 1
            bits(bague.flags,0x0040) = false
        }
        when {
            require bits(emetteur.flags,0x0040)
        } then {
            say Tramp presentation=9 if_not_shown skip_next=2 : "Un émetteur..."
            state_b6[Tramp.evolution] += 5
            bits(emetteur.flags,0x0040) = false
        }
        when {
            require bits(culture.flags,0x0040)
        } then {
            say Tramp presentation=9 if_not_shown skip_next=3 : "De la Culture..."
            state_b6[Tramp.evolution] += 100
            state_b5[Tramp.energy] += 50
            bits(culture.flags,0x0040) = false
        }
        when {
            require bits(ecriture.flags,0x0040)
        } then {
            say Tramp presentation=8 chatter if_not_shown skip_next=2 : "Ecriture|..."
            state_b6[Tramp.evolution] += 100
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Tramp presentation=9 if_not_shown skip_next=3 : "Un VAISSEAU..."
            state_b6[Tramp.evolution] += 50
            globals.B26 += 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Tramp presentation=8 chatter if_not_shown skip_next=5 : "Enfin la Paix|..."
            state_b6[Tramp.evolution] += 10
            globals.B27 = 0
            Tramp.aggressiveness = 0
            state_b1[Tramp.population] += 200
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Tramp presentation=9 if_not_shown skip_next=3 : "Des cadeaux..."
            state_b6[Tramp.evolution] += 10
            state_b5[Tramp.energy] += 50
            bits(cadeaux.flags,0x0040) = false
        }
        say Tramp presentation=8 chatter : "Quel objet désirez-vous lui donner, Commander?"
        say Tramp presentation=8 chatter resume_at=gest02_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Tramp presentation=8 : "..."
        gest02_dialogue_resume_1:
        say Tramp presentation=8 chatter : "A BIENTOT, COMMANDER..."
        say Tramp presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Tramp
    }
    proc _3fintro as "3fintro" enabled {
        during contact
        require globals.A68 == 2
        require Super_Tromp.current_location == aboard
        require presentation == Super_Tromp
    } then {
        say Super_Tromp presentation=10 : "Regarde bien|!..."
        say Super_Tromp presentation=12 : "Derriére ces lunettes|, c'est moi|..."
        say Super_Tromp presentation=13 : "C'est moi Michel Polnareff|!..."
        say Super_Tromp presentation=14 : "Dans un instant|..."
        say Super_Tromp presentation=11 : "Tu vas me voir jouer du piano|!..."
        say Super_Tromp presentation=15 : "Mais surtout|... Regarde bien|..."
        say Super_Tromp presentation=16 : "Dans une seconde|..."
        say Super_Tromp presentation=17 : "Je vais enlever mes lunettes|!..."
        say Super_Tromp presentation=8 if_not_shown skip_next=3 : "..."
        globals.A13 += 3
        end presentation Super_Tromp
        sequence_slots[3] = "34contromp"
    }
    proc supt01 enabled {
        during travel
        require presentation == Super_Tromp
    } then {
        when {
            require Super_Tromp.encounter_count == 1
        } then {
            vaisseau.holder = aboard
        }
        when {
            require globals.B87 == 0
        } then {
            say Super_Tromp presentation=9 : "sa...sa...sa..."
            say Super_Tromp presentation=9 : "sa... sa... sa..."
            say Super_Tromp presentation=8 chatter : "salut|?..."
            say Super_Tromp presentation=10 : "Salaud de scénariste|!..."
            say Super_Tromp presentation=8 chatter : "quoi|? pourquoi|?..."
            say Super_Tromp presentation=11 : "je... je... je..."
            say Super_Tromp presentation=8 chatter : "je ne sais pas|?..."
            say Super_Tromp presentation=12 : "Jeune imbécile|!..."
            say Super_Tromp presentation=13 : "aco... aco... aco..."
            say Super_Tromp presentation=8 chatter : "a comme c'est gentil d'étre venu|?..."
            say Super_Tromp presentation=14 : "A cause de vous je b... je b..."
            say Super_Tromp presentation=8 chatter resume_at=supt01_dialogue_resume_1 : "commander, d'aprés vous que va-t il dire|?...JE" choices "bégaie" "boude" "biaise" "baba_cool" "bourre"
            when {
                require choice == "bégaie"
            } then {
                say Super_Tromp presentation=8 chatter : "je bégaie|?..."
                say Super_Tromp presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice != "bégaie"
            } then {
                choice = none
            }
            supt01_dialogue_resume_1:
            say Super_Tromp presentation=15 : "Non|!...Je bug comme un fou|!..."
            say Super_Tromp presentation=8 chatter : "vous buggez|?..."
            say Super_Tromp presentation=16 : "J'arréte pas...édé|... édé..."
            say Super_Tromp presentation=8 chatter : "Et des fois c'est génant|?..."
            say Super_Tromp presentation=17 : "Aidez-moi ou je vous re... je vous re..."
            say Super_Tromp presentation=8 chatter : "je vous reverrai jamais|?..."
            say Super_Tromp presentation=10 : "Non|! Je vous refile tous mes bugs|!..."
            say Super_Tromp presentation=8 chatter : "comment faire|?..."
            say Super_Tromp presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Super_Tromp
            globals.B87 = 1
        }
        say Super_Tromp presentation=9 : "Moi Super Tromp, moi CHEF TROMP..."
        text_tokens Super_Tromp presentation=11 : "Nous" state_number(0x0266) "tromps" "ici..."
        when {
            require globals.B87 == 1
            require medicament.holder == aboard
            require ecriture.holder == aboard
            require technologie.holder == aboard
        } then {
            say Super_Tromp presentation=8 chatter : "on vous apporte de quoi faire votre débugage|!..."
            say Super_Tromp presentation=9 : "A... A... A..."
            say Super_Tromp presentation=8 chatter : "Ah enfin|?..."
            say Super_Tromp presentation=10 : "Non|! Allez-y|!..."
        }
        when {
            require globals.B87 == 1
            require medicament.holder == Super_Tromp
            require technologie.holder == Super_Tromp
            require ecriture.holder == Super_Tromp
        } then {
            say Super_Tromp presentation=8 chatter : "voilà|! on a fini votre débugage|..."
            say Super_Tromp presentation=9 : "A... A... Ah bon|?..."
            say Super_Tromp presentation=8 chatter : "oh non|! ca a raté, commander|!..."
            say Super_Tromp presentation=10 : "M... M... M..."
            say Super_Tromp presentation=8 chatter : "y en a marre|..."
            say Super_Tromp presentation=11 : "Mais non, c'était une blague|! Je vais bien, merci|!..."
            say Super_Tromp presentation=8 chatter : "ouf|!..."
            say Super_Tromp presentation=8 chatter : "laissons-le se reposer de son comabug|..."
            say Super_Tromp presentation=15 : "Encore merci|! A bientot|!..."
            say Super_Tromp presentation=16 : "Ah|... au fait|... j'avais un message télé pour vous|..."
            say Super_Tromp presentation=12 : "De la part de monsieur BOB|!..."
            say Super_Tromp presentation=8 if_not_shown skip_next=3 : "..."
            sequence_slots[2] = "38atomev"
            end presentation Super_Tromp
            globals.B87 = 2
        }
        when {
            require globals.B87 == 1
            require ecriture.holder != aboard
            require technologie.holder != aboard
            require medicament.holder != aboard
        } then {
            say Super_Tromp presentation=9 : "ba..."
            say Super_Tromp presentation=10 : "be..."
            say Super_Tromp presentation=11 : "bi..."
            say Super_Tromp presentation=12 : "bo..."
            say Super_Tromp presentation=13 : "BUG|!..."
            say Super_Tromp presentation=8 chatter : "on n'a pas tout ce qu'il faut pour le débuger, commander|!..."
            say Super_Tromp presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Super_Tromp
        }
    }
    proc formbug enabled {
        during travel
        require presentation == Super_Tromp
    } then {
        when {
            require globals.A68 == 1
            require globals.B87 > 1
        } then {
            say Super_Tromp presentation=13 : "Nous connaissons formule magique contre gréves..."
            say Super_Tromp presentation=15 : "Nous vendons à toi formule magique contre crédit..."
            when {
                require globals.A4 == 0
            } then {
                say Super_Tromp presentation=8 chatter : "Nous n'avons plus de crédits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Super_Tromp presentation=8 chatter resume_at=gest03 : "Vous acceptez de leur acheter une formule magique, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Super_Tromp presentation=8 chatter if_not_shown skip_next=1 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Super_Tromp
                    say Super_Tromp presentation=14 : "FORMULE MAGIQUE:"
                    say Super_Tromp presentation=8 chatter : "retenez bien|, commander|..."
                    say Super_Tromp presentation=15 : "HATA HATA HOGLO HULU..."
                    say Super_Tromp presentation=16 : "HAMTOT ZAGLO HOLO HULU..."
                    say Super_Tromp presentation=17 : "HATA HATA HOGLO HULU..."
                    say Super_Tromp presentation=14 : "HERR TOT ZAGLO HOLO HULU..."
                    say Super_Tromp presentation=8 if_not_shown skip_next=2 : "Et voilà..."
                    globals.A4 -= 1
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc gest03 enabled {
        during travel
        require presentation == Super_Tromp
    } then {
        when {
            require bits(atomique.flags,0x0040)
        } then {
            when {
                require state_b6[Super_Tromp.evolution] < 100
            } then {
                globals.A13 = 1
            }
            when {
                require state_b6[Super_Tromp.evolution] < 500
                require state_b6[Super_Tromp.evolution] > 100
            } then {
                say Super_Tromp presentation=10 if_not_shown skip_next=5 : "Oh! des atomiques... intéressant... merci Commander..."
                state_b1[Super_Tromp.population] /= 2
                state_b6[Super_Tromp.evolution] += 100
                Super_Tromp.aggressiveness += 50
                globals.B28 -= 1
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Super_Tromp.evolution] > 500
            } then {
                say Super_Tromp presentation=10 if_not_shown skip_next=3 : "De l'énergie nucléaire... merci!!!"
                state_b6[Super_Tromp.evolution] += 20
                state_b5[Super_Tromp.energy] += 200
                bits(atomique.flags,0x0040) = false
            }
        }
        when {
            require bits(image.flags,0x0040)
