    proc _1fintro as "1fintro" enabled {
        during contact
        require globals.A68 == 2
        require Trump.current_location == aboard
        require presentation == Trump
    } then {
        say Trump presentation=10 : "T'as vu ca|? Tain pu|!..."
        say Trump presentation=11 : "Non mais t'as vu|?..."
        say Trump presentation=8 if_not_shown skip_next=3 : "..."
        globals.A13 += 3
        end presentation Trump
        sequence_slots[3] = "34contromp"
    }
    proc prepcon enabled {
        during bridge
        require globals.A64 == 1
        require presentation == Trump
    } then {
        say Trump presentation=8 : "Hello hello|!..."
        say Trump presentation=8 : "Alors comment ca tromp|? Ici Trump|!..."
        say Trump presentation=8 chatter : "Oh|... Couci couca|..."
        say Trump presentation=8 : "Parce que moi ca tromp a pleines narines|!..."
        say Trump presentation=8 : "Avec les copains on a monté un groupe pour Tina|!..."
        say Trump presentation=8 chatter : "On va pouvoir faire un concert|!..."
        say Trump presentation=8 : "Ouais|! Un grand BLOOD AID|!..."
        say Trump presentation=8 chatter : "a quel endroit on pourrait le faire|?..."
        say Trump presentation=8 : "Sur l'arche|!..."
        say Trump presentation=8 : "J'ai déjà prévenu tout le monde|!..."
        say Trump presentation=8 chatter : "tout l'univers|!..."
        say Trump presentation=8 : "sur l'Arche|!..."
        say Trump presentation=8 if_not_shown skip_next=2 : "..."
        end presentation Trump
        globals.A64 = 2
    }
    proc aptru enabled {
        during bridge
        require globals.A86 == 1
        require presentation == Trump
    } then {
        say Trump presentation=8 : "krouik|..."
        say Trump presentation=8 chatter : "Trump|?..."
        say Trump presentation=8 : "Oui|... krouik|... c'est moi|..."
        say Trump presentation=8 chatter : "qu'est-ce qui se passe|?..."
        say Trump presentation=8 : "Je|... je|..."
        say Trump presentation=8 chatter : "vous|?... vous?..."
        say Trump presentation=8 : "Oui, c'est moi|..."
        say Trump presentation=8 chatter : "quoi|?..."
        say Trump presentation=8 : "Je ne peux pas vous parler au téléphone|... pas prudent|..."
        say Trump presentation=8 chatter : "mais il est parfaitement protégé, ce téléphone|..."
        say Trump presentation=8 : "que tu crois|!..."
        say Trump presentation=8 : "rendez-vous sur le Net|... plus discret|..."
        say Trump presentation=8 : "krouik|..."
        say Trump presentation=8 chatter : "commander, ca a coupé|..."
        say Trump presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Trump
    }
    proc tru01 enabled {
        during travel
        require presentation == Trump
    } then {
        when {
            require globals.A68 == 1
            require globals.A63 < 2
            require guitare.holder != aboard
        } then {
            say Trump presentation=9 : "Tu te trompes sur les TROMPS, Commander|..."
            say Trump presentation=8 chatter : "en quoi|?..."
            say Trump presentation=10 : "Si tu crois que leur gréve sera bréve|..."
            say Trump presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Trump
        }
        when {
            require globals.A68 == 1
            require guitare.holder == aboard
            require globals.A63 == 8
        } then {
            say Trump presentation=9 : "Vous cherchez des musiciens|?..."
            say Trump presentation=8 chatter : "plein|..."
            say Trump presentation=10 : "Vous faites bien|... Je suis moi-méme grand rythmicien|..."
            say Trump presentation=8 chatter : "je croyais que vous étiez dans la peinture|..."
            say Trump presentation=11 : "Art pour art|... La peinture moi j'en ai marre|... J'aime encore mieux la guitare|..."
        }
        say Trump presentation=9 : "Moi Trump, moi TROMP..."
        text_tokens Trump presentation=11 : "Nous" "étre" state_number(0x01D2) "tromps" "ici..."
        when {
            require Trump.encounter_count == 1
        } then {
            say Trump presentation=9 : "Salut Commander|..."
            say Trump presentation=10 : "Tu aimes la science|, je crois|..."
            say Trump presentation=8 chatter : "moui|... couci couca|..."
            say Trump presentation=11 : "Tu veux connaitre l'origine des TROMPS|?..."
            say Trump presentation=8 chatter resume_at=tru01_dialogue_resume_1 : "un peu d'histoire|, commander|?..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say Trump presentation=12 : "C'est une belle histoire|..."
                say Trump presentation=13 : "Un vrai miracle de la nature|..."
                say Trump presentation=14 : "Ce petit film te fera comprendre bien des choses|..."
                say Trump presentation=8 if_not_shown skip_next=3 : "..."
                end presentation Trump
                sequence_slots[5] = "17vtromp"
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Trump presentation=13 : "Dommage|... C'était un beau secret de la nature|..."
                say Trump presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
        }
        tru01_dialogue_resume_1:
        when {
            require Trump.encounter_count == 2
        } then {
            say Trump presentation=9 : "Pour faire migrer notre race|..."
            say Trump presentation=10 : "Il faut connaitre l'histoire de notre apparition|..."
            say Trump presentation=11 : "Nous donner un vaisseau|, évidemment|..."
            say Trump presentation=8 chatter : "un vaisseau sanguin|!..."
            say Trump presentation=12 : "Oui|... mais qui pourrait vous donner un vaisseau|..."
            say Trump presentation=8 if_not_shown skip_next=1 : "Sans gain|?..."
            transfer credit from Trump to aboard
            say Trump presentation=8 chatter : "quel humour|, commander|..."
            say Trump presentation=14 : "Il faut aussi me donner de quoi grossir 15 000 fois|..."
            say Trump presentation=15 : "le deuxiéme chef TROMP qui est encore plus petit que moi|..."
            say Trump presentation=16 : "Vous voyez ce que je veux dire|?..."
            say Trump presentation=8 chatter resume_at=tru01_dialogue_resume_2 : "vous voyez|, commander|?..." choices "voir" "pas_voir"
            when {
                require choice == "voir"
            } then {
                say Trump presentation=9 : "C'est cool|... J'espére que tu vois bien|..."
                say Trump presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice != "voir"
            } then {
                say Trump presentation=10 : "Bon|... ben je te réexplique|, alors|..."
                say Trump presentation=11 : "Regarde BIEN ce petit documentaire sur|..."
                say Trump presentation=8 if_not_shown skip_next=1 : "La vie sexuelle des CROOLIS|..."
                request sequence "match04.hnm"
                say Trump presentation=8 if_not_shown skip_next=1 : "qui tirent en l'air|..."
                request sequence "match10.hnm"
                say Trump presentation=8 if_not_shown skip_next=3 : "..."
                end presentation Trump
                sequence_slots[3] = "17vtromp"
                choice = none
            }
        }
        tru01_dialogue_resume_2:
        when {
            require globals.A86 == 2
            require globals.A88 >= 0
        } then {
            say Trump presentation=8 chatter : "alors c'est qui, la balance|?..."
            say Trump presentation=9 : "Oh je peux pas le dire|! Mais si vous me dites un nom, je vous dirai oui ou non|..."
            say Trump presentation=8 chatter : "c'est toi|?..."
            say Trump presentation=10 : "Non|! Non|! Pas comme ça|! Tu me dis la premiére lettre, et puis la deuxiéme, etc|..."
            say Trump presentation=8 chatter resume_at=tru01_dialogue_resume_3 : "Bon|... La premiére lettre est un|..." choices "s" "u" "p" "e" "r" "t" "r" "o" "m" "p"
            when {
                require choice != "t"
            } then {
                say Trump presentation=8 if_not_shown skip_next=2 : "..."
                globals.A88 += 1
                choice = none
            }
            when {
                require choice == "t"
            } then {
                say Trump presentation=8 if_not_shown skip_next=2 : "..."
                globals.A89 += 1
                choice = none
            }
        }
        tru01_dialogue_resume_3:
        when {
            require globals.A86 == 2
        } then {
            say Trump presentation=8 chatter resume_at=tru01_dialogue_resume_4 : "deuxiéme lettre|..." choices "e" "m" "a" "s" "c" "u" "l" "a" "t" "o" "r"
            when {
                require choice != "e"
            } then {
                say Trump presentation=8 if_not_shown skip_next=2 : "..."
                globals.A88 += 1
                choice = none
            }
            when {
                require choice == "e"
            } then {
                say Trump presentation=8 if_not_shown skip_next=2 : "..."
                globals.A89 += 1
                choice = none
            }
        }
        tru01_dialogue_resume_4:
        when {
            require globals.A86 == 2
        } then {
            say Trump presentation=8 chatter resume_at=tru01_dialogue_resume_5 : "troisiéme lettre|..." choices "p" "o" "u" "r" "q" "u" "o" "i" "m" "o" "i"
            dictionary blank after "i"
            when {
                require choice != "q"
            } then {
                say Trump presentation=8 if_not_shown skip_next=2 : "..."
                globals.A88 += 1
                choice = none
            }
            when {
                require choice == "q"
            } then {
                say Trump presentation=8 if_not_shown skip_next=2 : "..."
                globals.A89 += 1
                choice = none
            }
        }
        tru01_dialogue_resume_5:
        when {
            require globals.A86 == 2
            require globals.A88 > 0
        } then {
            say Trump presentation=13 : "Je peux dés à présent vous dire que c'est pas ça|!..."
            say Trump presentation=8 chatter : "on peut réessayer|? on a une autre idée|!..."
            say Trump presentation=14 : "Ah non|! Ca serait trop facile|! D'abord il faut me donner un bionium|..."
            say Trump presentation=8 chatter : "rapace|!..."
            say Trump presentation=15 : "Oiseau de mauvais augure|!..."
        }
        when {
            require globals.A86 == 2
            require globals.A89 == 3
        } then {
            say Trump presentation=11 : "Vous pensez à Tequila, peut-étre|?..."
            say Trump presentation=8 chatter : "Oui, c'est ça|..."
            say Trump presentation=17 : "Eh bien bravo|! C'est elle|... Vous avez deviné|... Les femelles sont parfois perverses|..."
            say Trump presentation=8 chatter : "on sait|... nous on a olga|!..."
            say Trump presentation=8 if_not_shown skip_next=1 : "Oui c'est moi|!..."
            request sequence "ppitin02.hnm"
            say Trump presentation=8 if_not_shown skip_next=2 : "..."
            globals.A86 = 3
            end presentation Trump
        }
        when {
            require globals.A86 == 3
            require tableau.holder != aboard
            require state_b6[Trump.evolution] > 100
        } then {
            say Trump presentation=10 : "Nous peignons joli tableau du Grand YOLK, artisanat local..."
            say Trump presentation=15 : "A vendre à toi joli tableau au cadre en corne de murfalo, contre credit..."
            when {
                require globals.A4 == 0
            } then {
                say Trump presentation=8 chatter : "Nous n'avons plus de credits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Trump presentation=8 chatter resume_at=gest01 : "Vous acceptez de leur acheter un tableau, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Trump presentation=8 chatter if_not_shown skip_next=1 : "On lui envoie un credit, Commander"
                    transfer credit from aboard to Trump
                    say Trump presentation=8 chatter if_not_shown skip_next=1 : "TELEPORTATION TABLEAU DANS CRYOBOX"
                    transfer tableau from Trump to aboard
                    say Trump presentation=8 if_not_shown skip_next=4 : "..."
                    end presentation Trump
                    sequence_slots[3] = "23tableau"
                    globals.A4 -= 1
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc gest01 enabled {
        during travel
        require presentation == Trump
    } then {
        when {
            require bits(atomique.flags,0x0040)
        } then {
            when {
                require state_b6[Trump.evolution] < 100
            } then {
                globals.A13 = 1
            }
            when {
                require state_b6[Trump.evolution] < 500
                require state_b6[Trump.evolution] > 100
            } then {
                say Trump presentation=9 if_not_shown skip_next=5 : "Oh des atomiques... intéressant... Merci Commander..."
                state_b1[Trump.population] /= 2
                state_b6[Trump.evolution] += 100
                Trump.aggressiveness += 50
                globals.B28 -= 1
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Trump.evolution] > 500
            } then {
                say Trump presentation=10 if_not_shown skip_next=3 : "De l'énergie nucléaire... Merci!!!"
                state_b6[Trump.evolution] += 200
                state_b5[Trump.energy] = 1000
                bits(atomique.flags,0x0040) = false
            }
        }
        when {
            require bits(image.flags,0x0040)
        } then {
            say Trump presentation=11 : "Une Image...Par le grand YOLK|!!! Ce n'est pas de l'Art, mais un vulgaire faux..."
            say Trump presentation=15 : "Je n'aime pas du tout ça..."
            say Trump presentation=8 chatter if_not_shown skip_next=3 : "AH! les artistes... commander, Il se prend pour le plus grand de la Galaxie..."
            Trump.aggressiveness += 300
            state_b5[Trump.energy] += 200
            bits(image.flags,0x0040) = false
        }
        when {
            require bits(couronne.flags,0x0040)
        } then {
            say Trump presentation=12 if_not_shown skip_next=4 : "Une Couronne avec un beau plumet...PAS MAL! PAS MAL! Je vais enfin etre reconnu..."
            state_b5[Trump.energy] += 200
            Trump.aggressiveness += 300
            globals.B27 = 1
            bits(couronne.flags,0x0040) = false
        }
        when {
            require bits(tableau.flags,0x0040)
        } then {
            say Trump presentation=13 : "Un Tableau...Quelle drole d'idée! Je les vends moi MOOSSIEUU!!! Je suis un grand Artiste moi..."
            say Trump presentation=8 chatter if_not_shown skip_next=2 : "OULLAAA!!! COMMANDER...Quel mégalomane ce TRUMP..."
            state_b6[Trump.evolution] += 50
            bits(tableau.flags,0x0040) = false
        }
        when {
            require bits(momie.flags,0x0040)
        } then {
            say Trump presentation=14 if_not_shown skip_next=2 : "Une momie...Pas fou non! Je suis déjà un Artiste maudit, n'en rajoute pas commander..."
            globals.B28 -= 1
            bits(momie.flags,0x0040) = false
        }
        when {
            require globals.A88 == 0
            require bits(bionium.flags,0x0040)
        } then {
            say Trump presentation=15 : "Du Bionium... Pas DEGUEU!!! OULAA! j'ai de l'inspiration pour peindre..."
            say Trump presentation=8 chatter if_not_shown skip_next=5 : "BIZARRE! BIZARRE! COMMANDER... Le bionium l'inspire..."
            state_b1[Trump.population] += 500
            state_b6[Trump.evolution] += 30
            state_b5[Trump.energy] += 500
            globals.vbio -= 1
            bits(bionium.flags,0x0040) = false
        }
        when {
            require globals.A88 > 0
            require bits(bionium.flags,0x0040)
        } then {
