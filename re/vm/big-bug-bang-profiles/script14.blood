                say Trump presentation=8 chatter : "on va voir tous ses défauts|..."
                say Trump presentation=12 : "Ca va faire apparaitre mon infiniment petit camarade TRAMP|..."
                say Trump presentation=8 chatter if_not_shown skip_next=4 : "on s'enfonce dans le microscopique|, commander|..."
                state_b6[Trump.evolution] += 100
                globals.B26 += 1
                state_b1[Trump.population] += 250
                bits(optique.flags,0x0040) = false
            }
            when {
                require bits(Tramp.flags,0x0004)
            } then {
                say Trump presentation=13 if_not_shown skip_next=3 : "Une optique... HOOHAAA!!! La vue est superbe..."
                dictionary blank after "HOOHAAA!!!"
                state_b6[Trump.evolution] += 50
                bits(optique.flags,0x0040) = false
                globals.B26 += 1
            }
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Trump presentation=9 if_not_shown skip_next=2 : "De l'énergie... SUPER|!|! Excuse-moi COMMANDER, j'ai deux ou trois montagnes à déplacer..."
            state_b5[Trump.energy] = 1000
            bits(energie.flags,0x0040) = false
        }
        when {
