    proc finmar1 enabled {
        during contact
        require Marakas.current_location == aboard
        require globals.A68 == 2
        require presentation == Marakas
    } then {
        say Marakas presentation=10 : "Ouaou|!..."
        say Marakas presentation=8 if_not_shown skip_next=2 : "..."
        end presentation Marakas
        globals.A13 += 3
    }
    proc crlibma enabled {
        during contact
        require globals.A64 == 0
        require Marakas.current_location == aboard
        require presentation == Marakas
    } then {
        say Marakas presentation=8 chatter : "alors marakas|?... comment ca va|?... vous avez la trompe un peu bleue|!..."
        say Marakas presentation=12 : "Ah|! J'en avais assez|!..."
        say Marakas presentation=20 : "Assez|!..."
        say Marakas presentation=21 : "Assez|!..."
        say Marakas presentation=8 chatter : "mais ca va mieux maintenant|?..."
        say Marakas presentation=15 : "Ah ah ah|! Vous n'avez pas idée|!..."
        say Marakas presentation=26 : "J'ai trop travaillé du chapeau|!..."
        say Marakas presentation=8 chatter : "il faut le renvoyer dans le cyberspace|, commander|..."
        say Marakas presentation=8 chatter : "mais attention|, il ne faut pas l'envoyer sur une planéte déjà occupée|..."
        say Marakas presentation=12 : "Sinon ca serait le chaos|..."
        say Marakas presentation=13 : "Et vous-méme seriez bloqué dans le CHAOS|...|!!! ATTENTION|... ATTENTION|!!!"
        say Marakas presentation=8 chatter : "comme il dit|, commander|..."
        say Marakas presentation=8 chatter resume_at=marrac01 : "sur quelle planéte voulez-vous le téléporter|, commander|?..." choices "attendre" "Rondo" "Corpo" "Malus" "Vistar" "Tumul" "Magnus"
        when {
            require choice == "attendre"
        } then {
            say Marakas presentation=8 chatter : "bonne idée|, commander|..."
            say Marakas presentation=8 chatter : "vous pourrez ainsi vérifier quelle planéte est libre|..."
            say Marakas presentation=12 : "Ouais|! Parce que je voudrais pas partager|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "avec n'importe qui|..."
            request sequence "match04.hnm"
            say Marakas presentation=8 chatter : "mais votre décision nécessite un gel temporel|..."
            say Marakas presentation=8 chatter : "j'effectue un arrét sur la séquence Marakas cryobox|..."
            say Marakas presentation=8 chatter : "vous la revivrez jusqu'à la téléportation de marakas|..."
            say Marakas presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Marakas
            choice = none
        }
        when {
            require choice == "Rondo"
        } then {
            say Marakas presentation=8 chatter : "TELEPORTATION MARAKAS SUR RONDO|..."
            say Marakas presentation=8 if_not_shown skip_next=7 : "..."
            Rondo.known = true
            Rondo.active = true
            Rondoland.active = true
            Marakas.current_location = Rondoland
            bits(Marakas.flags,0x0004) = true
            end presentation Marakas
            choice = none
        }
        when {
            require choice == "Corpo"
        } then {
            say Marakas presentation=8 chatter : "TELEPORTATION MARAKAS SUR CORPO|..."
            say Marakas presentation=8 if_not_shown skip_next=7 : "..."
            Corpo.active = true
            Corpoland.active = true
            Corpo.known = true
            Marakas.current_location = Corpoland
            bits(Marakas.flags,0x0004) = true
            end presentation Marakas
            choice = none
        }
        when {
            require choice == "Malus"
        } then {
            say Marakas presentation=8 chatter : "TELEPORTATION MARAKAS SUR MALUS|..."
            say Marakas presentation=8 if_not_shown skip_next=7 : "..."
            end presentation Marakas
            Malus.active = true
            Malus.known = true
            Malusland.active = true
            Marakas.current_location = Malusland
            bits(Marakas.flags,0x0004) = true
            choice = none
        }
        when {
            require choice == "Vistar"
        } then {
            say Marakas presentation=8 chatter : "teleportation marakas sur vistar|..."
            say Marakas presentation=8 if_not_shown skip_next=7 : "..."
            end presentation Marakas
            Vistar.active = true
            Vistarland.active = true
            Vistar.known = true
            Marakas.current_location = Vistarland
            bits(Marakas.flags,0x0004) = true
            choice = none
        }
        when {
            require choice == "Tumul"
        } then {
            say Marakas presentation=8 chatter : "teleportation marakas sur tumul|..."
            say Marakas presentation=8 if_not_shown skip_next=7 : "..."
            Tumul.active = true
            Tumul.known = true
            Tumland.active = true
            Marakas.current_location = Tumland
            bits(Marakas.flags,0x0004) = true
            end presentation Marakas
            choice = none
        }
        when {
            require choice == "Magnus"
        } then {
            say Marakas presentation=8 chatter : "teleportation marakas sur magnus|..."
            say Marakas presentation=8 if_not_shown skip_next=7 : "..."
            end presentation Marakas
            Magnus.active = true
            Magnus.known = true
            Magnusland.active = true
            Marakas.current_location = Magnusland
            bits(Marakas.flags,0x0004) = true
            choice = none
        }
    }
    proc marrac01 enabled {
        during travel
        require presentation == Marakas
    } then {
        when {
            require Marakas.encounter_count == 1
        } then {
            say Marakas presentation=9 : "Ah Commander|! Enfin vous voilà|!..."
            say Marakas presentation=10 : "Vous étes vraiment celui qu'il nous faut|..."
            say Marakas presentation=8 chatter : "pourquoi|? Qu'est-ce qui se passe|?..."
            say Marakas presentation=22 : "Aie aie aie|! Si vous saviez|!..."
            say Marakas presentation=8 chatter : "oui|... quoi|?..."
            say Marakas presentation=12 : "J'en ai assez|..."
            say Marakas presentation=20 : "Assez|..."
            say Marakas presentation=21 : "Assez|..."
            say Marakas presentation=26 : "Vous voyez ma casquette|?..."
            say Marakas presentation=8 chatter : "eh bien quoi|?..."
            say Marakas presentation=17 : "On m'a obligé à porter ce costume ridicule de chef|..."
            dictionary blank after "costume"
            say Marakas presentation=18 : "Pour conduire la nation IZWAL|!..."
            say Marakas presentation=23 : "Ah là là|! J'aurais préféré qu'on me file plein de pognon|..."
            say Marakas presentation=14 : "Hin hin hin|... Des crédits, des crédits|... J'm'en serais fichu plein la trompe|!..."
            say Marakas presentation=27 : "Au lieu de ça, regardez|... je fouille dans mes poches|..."
            say Marakas presentation=28 : "Et ben y a que dalle dedans|! Elles sont vides|!..."
            say Marakas presentation=8 chatter : "c'est grave|?..."
            say Marakas presentation=11 : "Je peux méme pas m'acheter un livre de Platon|!..."
            say Marakas presentation=8 chatter : "quelle tragédie|!..."
            say Marakas presentation=10 : "Vous, ça va comme ça|!..."
        }
        when {
            require globals.A68 == 1
        } then {
            say Marakas presentation=9 : "Encore vous, Commander|!..."
            say Marakas presentation=10 : "Vous, l'envoyé de Monsieur BOB|!..."
            say Marakas presentation=11 : "Vous étes bien de droite, hein, c'est ca|?..."
            say Marakas presentation=21 : "Parce que si vous vous étes de droite|..."
            say Marakas presentation=20 : "Eh ben nous on est de gauche|..."
            say Marakas presentation=12 : "Et nous on en a assez de vous|..."
            say Marakas presentation=13 : "C'est tout ce que vous méritez|..."
            say Marakas presentation=14 : "Est-ce que je me trompe|?..."
            say Marakas presentation=15 : "Ah ah ah|! Elle est bonne, ma blague|... Je vous la refais"
            say Marakas presentation=14 : "Est-ce que je me trompe|?..."
            say Marakas presentation=24 : "Mais sérieusement|... Attention à vous, Commander|..."
            say Marakas presentation=25 : "Parce que c'est plus possible de vivre comme ca|!..."
            say Marakas presentation=26 : "Ca va pas dans votre téte ou quoi|?..."
            say Marakas presentation=17 : "Je paie mes impots comme tout l'Univers|..."
            say Marakas presentation=23 : "Alors il passe où mon pognon|?..."
            say Marakas presentation=24 : "En tout cas, si vous m'augmentez pas, je vous préviens|..."
            say Marakas presentation=22 : "Ca va pas aller du tout|!..."
            say Marakas presentation=27 : "En attendant, moi je fais gréve|... Hop|! J'arréte le boulot|..."
            say Marakas presentation=8 chatter : "oulàlà commander|! il est drolement remonté contre vous|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Marakas
        }
        when {
            require globals.A81 == 6
        } then {
            say Marakas presentation=17 : "Waou|! Commander|! Encore merci pour votre coup de génie|!..."
            say Marakas presentation=15 : "Ah ah ah|! Ca|! Vous manquez pas d'idées, vous, hein|?..."
            say Marakas presentation=10 : "Méme que c'est pour ça qu'on vous a pris comme scénariste|!..."
            say Marakas presentation=19 : "Allez|! Dans mes bras, vieux frére|! Me serre pas trop fort, je sens encore les chaines|..."
            say Marakas presentation=14 : "Qu'est-ce que je pourrais bien vous offrir pour vous remercier|?..."
            say Marakas presentation=8 chatter : "Hé Hé|..."
            say Marakas presentation=25 : "Oh puis tiens|! Je vais rien vous offrir|! Comme ça, vous aurez vraiment fait ca pour la gloire|!..."
            say Marakas presentation=8 chatter resume_at=marrac01_dialogue_resume_1 : "pas sympa, ça|! commander, forcez-le à vous offrir quelque chose|..." choices "forcer" "pas_forcer"
            when {
                require choice == "forcer"
            } then {
                say Marakas presentation=26 : "Eh oh|! Ca va pas la téte|! Je donne si je veux|!..."
                say Marakas presentation=8 chatter : "mais vous voulez|..."
                say Marakas presentation=13 : "C'est vrai|... Voilà pour toi|... Cadeau|..."
                say Marakas presentation=8 chatter : "ben qu'est-ce que c'est|? On n'a rien vu|!..."
                say Marakas presentation=28 : "Normal|... C'est toute ma gratitude|..."
                say Marakas presentation=8 chatter : "c'est malin|..."
                say Marakas presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice != "_forcer"
            } then {
                choice = none
            }
            marrac01_dialogue_resume_1:
            say Marakas presentation=15 : "Et encore merci|! ah ah ah|!..."
            say Marakas presentation=8 if_not_shown skip_next=2 : "..."
            globals.A81 = 7
            end presentation Marakas
        }
        when {
            require Marakas.encounter_count > 1
        } then {
            say Marakas presentation=9 : "Mon nom est Marakas, grand chef de tribu IZWALS|..."
            text_tokens Marakas presentation=11 : "Nous" "sommes" state_number(0x0628) "izwals" "dans" "tribu" "..."
        }
        when {
            require Marakas.encounter_count == 1
        } then {
            say Marakas presentation=9 : "Il faut nous aider|, Commander|!..."
            say Marakas presentation=23 : "On a besoin d'argent|..."
        }
        when {
            require Marakas.encounter_count == 2
        } then {
            say Marakas presentation=20 : "Voilà|, Commander|..."
            say Marakas presentation=10 : "Toi|, tu vas nous donner|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "De quoi acheter des livres|!..."
            transfer credit from Marakas to aboard
            say Marakas presentation=14 : "Platon|! J'adore Platon|!..."
            say Marakas presentation=25 : "Mais le probléme avec Platon|..."
            say Marakas presentation=22 : "C'est qu'il a écrit beaucoup beaucoup|!..."
            say Marakas presentation=23 : "Et ca coùte bezef crédits|! Bezef bezef|!..."
            say Marakas presentation=17 : "Pour un crédit|, on te donnera|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "nourritures extraterrestres|..."
            transfer nourriture from Marakas to aboard
            say Marakas presentation=15 : "Ah ah ah|! Et nous avec crédit|, on trouvera|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "nourritures spirituelles|..."
            transfer ecriture from Marakas to aboard
            say Marakas presentation=8 if_not_shown skip_next=1 : "Waou|! Commander|! Ca va pas la téte|?..."
            request sequence "ppit03.hnm"
            say Marakas presentation=8 if_not_shown skip_next=1 : "Vous allez quand méme pas|..."
            request sequence "ppit05.hnm"
            say Marakas presentation=8 if_not_shown skip_next=1 : "gaspiller un crédit|..."
            transfer credit from aboard to Marakas
            say Marakas presentation=8 if_not_shown skip_next=1 : "Pour acheter du steak de l'espace|..."
            transfer nourriture from aboard to Marakas
            say Marakas presentation=8 if_not_shown skip_next=1 : "A un platonicien à trompe|!..."
            transfer ecriture from aboard to Marakas
            say Marakas presentation=16 : "Il me fait peur|, Commander|!..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "Na na na né reu|!..."
            request sequence "ppit07.hnm"
            say Marakas presentation=8 if_not_shown skip_next=1 : "Couché Petit Piteux|!..."
            request sequence "bobb.hnm"
            say Marakas presentation=22 : "Aie aie aie|... J'ai eu peur|..."
        }
        when {
            require Marakas.encounter_count == 3
        } then {
            say Marakas presentation=17 : "Commander|! Je suis content de vous revoir|!..."
            say Marakas presentation=22 : "J'ai fait un affreux cauchemar|..."
            say Marakas presentation=16 : "J'ai révé|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "D'un alien qui venait de ROSWELL|!..."
            request sequence "momi10.hnm"
            say Marakas presentation=16 : "J'avais peur|..."
            say Marakas presentation=12 : "Et regardez|!..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "D'affreux CROOLIS se moquaient de moi|!..."
            request sequence "match04.hnm"
            say Marakas presentation=26 : "Ca va pas bien dans ma téte|!..."
            say Marakas presentation=9 : "Il faut vite que j'aille|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "en parler|..."
            request sequence "p_cles.hnm"
            say Marakas presentation=8 if_not_shown skip_next=1 : "A mon psychanalyste|..."
            request sequence "kort.hnm"
            say Marakas presentation=23 : "Mais ça coute tellement cher|!..."
            say Marakas presentation=27 : "Je vais plutot|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "Relire Platon|..."
            request sequence "diplom1j.hnm"
        }
        when {
            require Marakas.encounter_count == 4
        } then {
            say Marakas presentation=16 : "Encore fait un cauchemar|..."
            say Marakas presentation=8 if_not_shown skip_next=1 : "Encore vu l'affreux de ROSWELL|!..."
            request sequence "momi10.hnm"
            say Marakas presentation=20 : "Et cette fois|..."
