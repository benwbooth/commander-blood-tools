    }
    proc tequi01 enabled {
        during travel
        require presentation == Tequila
    } then {
        when {
            require Tequila.encounter_count == 1
        } then {
            say Tequila presentation=9 : "Moi c'est TEQUILA, mon chéri, mére de tribu IZWALS..."
            say Tequila presentation=12 : "Tu sais qu't'es pas mal pour un humain..."
            say Tequila presentation=8 chatter : "Commander, vous avez une touche..."
            say Tequila presentation=11 : "Oui, c'est ça, touche-moi la trompe, grand fou..."
            say Tequila presentation=8 chatter : "Allez-y, Commander, faites comme si j'étais pas là..."
            say Tequila presentation=13 : "Qu'est-ce qui y a|? J'te plais pas|?"
            say Tequila presentation=11 : "Va voir les autres si tu veux, elles sont pas mieux..."
            text_tokens Tequila presentation=10 : "Y" "en" "a" "encore" state_number(0x06BC) "izwals" "comme" "moi" "dans" "la" "trobu..."
            say Tequila presentation=14 : "Hips! Excuse-moi, dans ma tribu je veux dire, j'ai trop bu..."
        }
        when {
            require Tequila.encounter_count > 1
        } then {
            say Tequila presentation=9 : "Salut beau gosse|..."
            text_tokens Tequila presentation=10 : "On" "est" state_number(0x06BC) "izwals" "maintenant" "dans" "ma" "tribu," "hic" "!"
        }
        when {
            require Tequila.encounter_count == 2
        } then {
            say Tequila presentation=15 : "Tu as remarqué|, mon chéri|?|..."
            say Tequila presentation=16 : "C'est n'importe quoi|, cet univers|!|..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "Wiou wiou|! Wawaou|! Coucou|!|..."
            request sequence "ppit03.hnm"
            say Tequila presentation=17 : "Rien qu'une tripotée de débiles|, hic|!..."
            say Tequila presentation=18 : "Jamais contents|! Toujours à se plaindre|!..."
            say Tequila presentation=8 chatter : "elle débloque|, commander|..."
            say Tequila presentation=19 : "Qu'est-ce que tu dis|, marin d'eau douce|?..."
            say Tequila presentation=8 chatter : "...|...|...|..."
            say Tequila presentation=18 : "Je préfére ca|!..."
            say Tequila presentation=17 : "Rien qu'une tripotée d'imbéciles|..."
            say Tequila presentation=16 : "On se demande comment ils embauchent|, à CRYO|!..."
            say Tequila presentation=20 : "Du temps de Monsieur BOB|, c'était une autre histoire|!..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "Merci Tequila|..."
            request sequence "bobb.hnm"
            say Tequila presentation=21 : "De rien|, de rien|..."
            say Tequila presentation=22 : "Au moins|, de son temps|, on chiadait les scénarios|..."
            say Tequila presentation=11 : "Maintenant c'est n'importe quoi|, hips|!..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "Mais Tequila|! Vous étes iiiiivre|!..."
            request sequence "ppitin02.hnm"
            say Tequila presentation=12 : "Oh toi la p...asse|, Ta gueule|!..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "Hiiiii|! Mon dieu quelle vulgarité|!..."
            request sequence "ppitin03.hnm"
            say Tequila presentation=13 : "Vous avez vu|?..."
            say Tequila presentation=14 : "Les dialogues sont nuls à chier|..."
            say Tequila presentation=15 : "Ils sont méme pas censurés|! Putain|!..."
            say Tequila presentation=16 : "Bordel|! C'est plein de gros mots|!..."
            say Tequila presentation=17 : "Et ils sont pas terminés|!..."
        }
        when {
            require Tequila.encounter_count == 3
        } then {
            say Tequila presentation=14 : "Alors|, chéri|... Tu t'obstines|?..."
            say Tequila presentation=15 : "Tu crois que tu vas gagner|, peut-étre|?..."
            say Tequila presentation=16 : "Et méme si tu gagnais|, qu'est-ce que ca changerait|?..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "Tu danserais comme un idiot|!..."
            request sequence "tvgre100.hnm"
            say Tequila presentation=17 : "Et voilà tout|!..."
            say Tequila presentation=8 chatter : "elle délire|, commander|..."
        }
        when {
            require globals.A87 == 1
        } then {
            say Tequila presentation=8 chatter : "alors|... c'est qui cette balance, cet espion|?..."
            say Tequila presentation=9 : "Voilà toute l'histoire|..."
            say Tequila presentation=10 : "J'étais en train de mettre en bouteille ma Tequila|..."
            say Tequila presentation=11 : "Je travaillais bien tranquillement|..."
            say Tequila presentation=12 : "Quand soudain|!..."
            say Tequila presentation=8 chatter : "soudain|?..."
            say Tequila presentation=13 : "Soudain je me suis apercue que je n'étais pas seule|..."
            say Tequila presentation=14 : "J'ai fait semblant de ne rien voir|..."
            say Tequila presentation=8 chatter : "et alors|?..."
            say Tequila presentation=14 : "J'ai fait semblant de ne rien voir|..."
            say Tequila presentation=8 chatter : "et aprés|?..."
            say Tequila presentation=14 : "J'ai fait semblant de ne rien voir|..."
            say Tequila presentation=8 chatter : "Commander elle débloque|..."
            say Tequila presentation=15 if_not_shown skip_next=1 : "Du bionium|! Par pitié|! Du bionium|!..."
            globals.A87 = 2
        }
        when {
            require globals.A87 == 2
            require globals.vbio == 0
        } then {
            say Tequila presentation=8 chatter : "nous n'avons plus de bionium, commander|! il faut aller en chercher|!..."
            say Tequila presentation=15 : "Bio|... nium|..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Tequila
        }
        when {
            require globals.A87 == 3
        } then {
            say Tequila presentation=8 chatter : "alors|?..."
            say Tequila presentation=16 : "Alors l'autre personne était en train de vendre des informations sur Internet|..."
            say Tequila presentation=8 chatter : "c'est celui que nous cherchons|..."
            say Tequila presentation=17 : "J'ai tout vu, je sais qui c'est|..."
            say Tequila presentation=8 chatter : "qui c'est|?..."
            say Tequila presentation=15 : "C'est le double de|..."
            say Tequila presentation=8 chatter : "de|?..."
            say Tequila presentation=15 : "C'est le double de|..."
            say Tequila presentation=8 chatter : "elle s'est encore bloquée|..."
            say Tequila presentation=15 if_not_shown skip_next=1 : "C'est le double de bionium qu'il me faut|..."
            globals.A87 = 4
        }
        when {
            require globals.A87 == 4
            require globals.vbio < 2
        } then {
            say Tequila presentation=8 chatter : "commander|... recherche bionium désespérément|..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Tequila
        }
        when {
            require globals.A87 == 4
            require globals.vbio > 1
            require globals.vbio < 10
        } then {
            say Tequila presentation=15 : "Aggg|... Biog|... Bioni|... omg|..."
            say Tequila presentation=8 chatter if_not_shown skip_next=1 : "commander je l'ausculte|..."
            request sequence "brouil.hnm"
            say Tequila presentation=8 chatter : "doses de bionium ne suffiront pas|..."
            say Tequila presentation=15 : "Rrraggg|... Gnnn|... Biogn|... mg|..."
            dictionary blank after "Gnnn"
            say Tequila presentation=8 chatter : "si on ne lui injecte pas 10 doses d'un coup, elle va mourir|..."
            say Tequila presentation=8 if_not_shown skip_next=1 : "LA MORT|..."
            request sequence "maledict.hnm"
            say Tequila presentation=8 chatter : "c'est affreux, commander|... elle n'aura pas la force de nous dire qui est l'espion|..."
            say Tequila presentation=8 chatter : "doses de bionium ou elle meurt|..."
            say Tequila presentation=8 if_not_shown skip_next=2 : "..."
            globals.A87 = 5
            end presentation Tequila
        }
        when {
            require globals.A87 == 4
            require globals.vbio > 9
        } then {
            say Tequila presentation=8 if_not_shown skip_next=1 : "..."
            globals.A87 = 5
        }
        when {
            require globals.A87 == 5
            require globals.vbio > 9
        } then {
            say Tequila presentation=15 : "Argu|... Gnome|...."
            say Tequila presentation=8 chatter : "commander, nous avons 10 doses de bionium|... Nous pouvons les lui injecter|..."
            dictionary blank after "pouvons"
            say Tequila presentation=8 chatter : "Ca la fera parler, c'est sùr|... elle nous dira le nom de l'espion|..."
            say Tequila presentation=8 chatter : "mais|..."
            say Tequila presentation=8 chatter if_not_shown skip_next=1 : "Nous recevons un message télépathique prioritaire ultrabiozénique|..."
            request sequence "brouil.hnm"
            say Tequila presentation=8 chatter if_not_shown skip_next=1 : "c'est super zen, commander|!..."
            request sequence "crazys20.hnm"
            say Tequila presentation=8 chatter : "il m'annonce|..."
            say Tequila presentation=8 chatter : "que si nous donnons 10 doses de bionium d'un coup à tequila|..."
            say Tequila presentation=8 chatter : "elle aura la force de parler|... mais elle mourra aussitot|..."
            say Tequila presentation=8 chatter resume_at=tequi01_dialogue_resume_1 : "que faites-vous du bionium, commander|?..." choices "donner" "pas_donner"
            when {
                require choice == "donner"
            } then {
                say Tequila presentation=8 chatter if_not_shown skip_next=2 : "INJECTION 10 DOSES DE BIONIUM A TEQUILA|..."
                transfer bionium from aboard to Tequila
                globals.A87 = 6
                say Tequila presentation=16 : "Arg|... C'était|... C'était|... Cé|... Té|..."
                say Tequila presentation=8 chatter : "qui|?..."
                say Tequila presentation=17 : "La|..."
                say Tequila presentation=15 : "La|..."
                say Tequila presentation=16 : "C'était pas|..."
                say Tequila presentation=8 chatter : "quoi|?..."
                say Tequila presentation=17 : "... la peine de vous donner tout ce mal|... Arg|..."
                say Tequila presentation=8 chatter : "commander|! elle est|..."
                say Tequila presentation=8 chatter if_not_shown skip_next=1 : "morte|!"
                request sequence "maledict.hnm"
                say Tequila presentation=8 chatter : "commander|! elle a rien dit|!..."
                say Tequila presentation=8 chatter : "partons, ca sent trop le bionium ici|..."
                say Tequila presentation=8 if_not_shown skip_next=3 : "..."
                Tequila.current_location = aboard
                end presentation Tequila
                choice = none
            }
            when {
                require choice != "_donner"
            } then {
                say Tequila presentation=8 chatter : "c'est sage|... pas tout d'un coup|..."
                say Tequila presentation=8 chatter : "en deux fois, ca devrait aller|..."
                say Tequila presentation=8 chatter if_not_shown skip_next=2 : "INJECTION 5 DOSES DE BIONIUM A TEQUILA|..."
                transfer bionium from aboard to Tequila
                globals.vbio -= 5
                say Tequila presentation=12 : "Aouw|... waouw|..."
                say Tequila presentation=8 chatter : "on attend un peu|... voilà|..."
                say Tequila presentation=8 chatter if_not_shown skip_next=2 : "INJECTION 5 DOSES DE BIONIUM A TEQUILA|..."
                transfer bionium from aboard to Tequila
                globals.vbio -= 5
                say Tequila presentation=17 : "Wawawawa|! P'tain j'ai une de ces|..."
                say Tequila presentation=8 if_not_shown skip_next=1 : "Péches, moi|! wawaw|!..."
                request sequence "explroug.hnm"
                say Tequila presentation=8 chatter : "elle péte la forme la mourante|!..."
                say Tequila presentation=8 chatter : "elle va pouvoir nous dire le nom de la balance|..."
                say Tequila presentation=17 : "Awawaw|! Yeah|! Cool|! pas d'prob|!..."
                say Tequila presentation=8 if_not_shown skip_next=1 : "Pas d'probléme|!..."
                request sequence "star2.hnm"
                say Tequila presentation=17 : "No problémo|! J'vous tuyaute|!..."
                say Tequila presentation=8 chatter : "elle a l'air un peu speed, quand méme|..."
                say Tequila presentation=17 : "Yayawaw|! Eh ben c'est moi l'espionne|! It's mi|! mais vui mon bon monsieur|! moi moi moi|!..."
                say Tequila presentation=8 chatter : "aie|! elle délire|! la dose était un peu trop forte|!"
                say Tequila presentation=8 chatter : "laissez tomber, commander, il n'y a plus rien à en tirer, le bionium lui a brùlé la cervelle|..."
                dictionary blank after "laissez"
                say Tequila presentation=17 : "Adios muchachos|! good babaille|!..."
                say Tequila presentation=8 if_not_shown skip_next=4 : "..."
                Tequila.current_location = aboard
                globals.A87 = 7
                end presentation Tequila
                choice = none
            }
        }
        tequi01_dialogue_resume_1:
        when {
            require Tequila.aggressiveness < 700
            require globals.A86 == 0
        } then {
            say Tequila presentation=9 : "Nous fabriquer boisson alimentaire 100 pour 100 jus de MURFALO|..."
            say Tequila presentation=15 : "Nous vendre à toi contre crédit|..."
            when {
                require globals.A4 == 0
            } then {
                say Tequila presentation=8 chatter : "Nous n'avons plus de crédits, Commander|..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Tequila presentation=8 chatter resume_at=gest03 : "Vous acceptez de leur acheter des vivres, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Tequila presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Tequila
                    globals.A4 -= 1
                    say Tequila presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION NOURRITURE DANS CRYOBOX"
                    transfer nourriture from Tequila to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc gest03 enabled {
        during travel
        require presentation == Tequila
    } then {
        when {
            require bits(atomique.flags,0x0040)
        } then {
            when {
                require state_b6[Tequila.evolution] < 100
            } then {
                globals.A13 = 1
            }
            when {
                require state_b6[Tequila.evolution] < 500
                require state_b6[Tequila.evolution] > 100
            } then {
                say Tequila presentation=10 if_not_shown skip_next=4 : "Oh des atomiques|... Intéressant|... Moi pouvoir cueillir de beaux champignons! Merci COMMANDER|..."
                state_b1[Tequila.population] /= 2
                Tequila.aggressiveness += 100
                globals.B31 = 0
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Tequila.evolution] > 500
            } then {
                say Tequila presentation=10 if_not_shown skip_next=3 : "De l'énergie nucléaire|... Merci|!!! c'est mon mari qui va étre content|..."
                state_b6[Tequila.evolution] += 200
                state_b5[Tequila.energy] += 500
                bits(atomique.flags,0x0040) = false
            }
        }
        when {
            require bits(image.flags,0x0040)
        } then {
            say Tequila presentation=12 : "Toi me prendre pour une de ces filles de la Galaxie|!!! Moi te SCRABOUYUTURER..."
            say Tequila presentation=8 chatter if_not_shown skip_next=4 : "COMMANDER|... COMMANDER|!!! Le torchon qu'elle a sur la téte brule|... FUYONS..."
            state_b1[Tequila.population] /= 2
            Tequila.aggressiveness += 200
            globals.B31 = 0
            bits(image.flags,0x0040) = false
        }
        when {
            require bits(couronne.flags,0x0040)
        } then {
            say Tequila presentation=13 if_not_shown skip_next=4 : "HO|!!! Toi faire de moi une reine|... Moi te trouver bon prince|..."
            state_b5[Tequila.energy] += 500
            Tequila.aggressiveness = 600
            globals.B30 += 1
            bits(couronne.flags,0x0040) = false
        }
        when {
            require bits(tableau.flags,0x0040)
        } then {
            say Tequila presentation=14 : "Moi pas trouvé le sens pour l'accrocher!|..."
            say Tequila presentation=14 if_not_shown skip_next=3 : "Toi melange les pinceaux dans ma téte|..."
            state_b6[Tequila.evolution] += 30
            state_b1[Tequila.population] -= 100
            bits(tableau.flags,0x0040) = false
        }
        when {
            require bits(momie.flags,0x0040)
        } then {
            say Tequila presentation=15 : "Quelle HORREUR|!!!|..."
            say Tequila presentation=8 chatter if_not_shown skip_next=2 : "COMMANDER! Vous lui avez fait peur|..."
            globals.B31 -= 1
            bits(momie.flags,0x0040) = false
        }
        when {
            require bits(bionium.flags,0x0040)
        } then {
            when {
                require globals.A87 == 2
            } then {
                say Tequila presentation=10 : "AAaAaAaaa|... Ca va mieux|..."
                say Tequila presentation=8 chatter : "vous vous étes débloquée|?..."
                say Tequila presentation=11 : "A ce propos, commander chéri, va falloir te décoincer|..."
                say Tequila presentation=8 chatter : "du calme, du calme|... alors la balance|?..."
                say Tequila presentation=9 if_not_shown skip_next=2 : "Ah oui|... j'oubliais|..."
                globals.A87 = 3
                state_b6[Tequila.evolution] += 50
            }
            say Tequila presentation=16 if_not_shown skip_next=5 : "Du Bionium|... HUM|! Trés bon|... Moi me sentir en pleine forme|..."
            state_b1[Tequila.population] += 200
            state_b5[Tequila.energy] += 400
            state_b6[Tequila.evolution] += 40
            globals.vbio -= 1
            bits(bionium.flags,0x0040) = false
        }
        when {
            require bits(technologie.flags,0x0040)
        } then {
            say Tequila presentation=17 : "De la technologie|... Des PRODUITS BRUNS|!!! Repars vite, ou moi fàchée toute rouge..."
            say Tequila presentation=8 chatter if_not_shown skip_next=4 : "COMMANDER, L'idée n'était pas bonne|... Elle va vous en vouloir c'est sur|..."
            state_b6[Tequila.evolution] += 40
            Tequila.aggressiveness += 300
            globals.B29 += 1
            bits(technologie.flags,0x0040) = false
        }
        when {
            require bits(guitare.flags,0x0040)
        } then {
            say Tequila presentation=18 : "Une guitare|... Merveilleux|! Izwalito va jouer de belles ballades|... MERCI|!"
            say Tequila presentation=8 chatter if_not_shown skip_next=5 : "COMMANDER|... Elle va déchanter|, Izwalito reve de devenir une STAR du ROCK AND ROLL..."
            globals.B31 += 1
            state_b1[Tequila.population] += 450
            state_b6[Tequila.evolution] += 30
            globals.B30 = 0
            bits(guitare.flags,0x0040) = false
        }
        when {
            require bits(credit.flags,0x0040)
        } then {
            say Tequila presentation=8 chatter if_not_shown skip_next=2 : "COMMANDER, vous étes complétement givré|..."
            globals.A4 -= 1
            bits(credit.flags,0x0040) = false
        }
        when {
            require bits(parfum.flags,0x0040)
        } then {
            say Tequila presentation=19 : "Du parfum|... Moi avoir chaud partout. Moi étre comme soir de pleine lune HUMM|..."
            say Tequila presentation=8 chatter : "Et bien COMMANDER|... Vous l'avez mise|..."
            say Tequila presentation=8 chatter if_not_shown skip_next=5 : "dans un drole d'état|..."
            state_b6[Tequila.evolution] += 10
            state_b1[Tequila.population] += 400
            state_b5[Tequila.energy] += 400
            globals.B31 += 1
            bits(parfum.flags,0x0040) = false
        }
        when {
            require bits(decodeur.flags,0x0040)
        } then {
            say Tequila presentation=20 if_not_shown skip_next=5 : "Un décodeur pour la télé|... YOUPiii|!!! Moi pouvoir regarder alerte à TRASHLANDO..."
            state_b6[Tequila.evolution] += 40
            state_b1[Tequila.population] -= 100
            state_b5[Tequila.energy] += 200
            globals.B31 -= 1
            bits(decodeur.flags,0x0040) = false
        }
        when {
            require bits(nourriture.flags,0x0040)
        } then {
            say Tequila presentation=21 : "De la nourriture|... HUMM MIAM MIAM|!!! Moi faire attention à ma ligne. HI! HI!..."
            say Tequila presentation=8 chatter if_not_shown skip_next=2 : "Oui c'est vrai COMMANDER, elle a une trés belle ligne|..."
            state_b5[Tequila.energy] += 400
            bits(nourriture.flags,0x0040) = false
        }
        when {
            require bits(medicament.flags,0x0040)
        } then {
            say Tequila presentation=22 : "Des médicaments|... Toi étre bon COMMANDER, toi soulagé mon foie, mon intestin, ma vesicule, ma|..."
            say Tequila presentation=8 chatter if_not_shown skip_next=3 : "COMMANDER! Ne restons pas là! Elle est peut étre contagieuse|..."
            state_b6[Tequila.evolution] += 30
            state_b1[Tequila.population] += 450
            bits(medicament.flags,0x0040) = false
        }
        when {
            require bits(armes.flags,0x0040)
        } then {
            say Tequila presentation=23 if_not_shown skip_next=4 : "DES ARMES|... BOF|! Moi avoir de trés bons couteaux de cuisine. Mais laisse toujours, ca peut servir..."
            Tequila.aggressiveness += 450
            state_b6[Tequila.evolution] += 30
            globals.B30 += 1
            bits(armes.flags,0x0040) = false
        }
        when {
            require bits(optique.flags,0x0040)
        } then {
            say Tequila presentation=12 if_not_shown skip_next=3 : "Une optique|. Trés bien|! Moi pouvoir surveiller Izwalito d'un peu plus prés..."
            state_b6[Tequila.evolution] += 50
            globals.B29 += 1
            bits(optique.flags,0x0040) = false
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Tequila presentation=9 if_not_shown skip_next=2 : "De l'énergie|... Moi pouvoir faire grand nettoyage de printemps MERCI|!"
            state_b5[Tequila.energy] = 1000
            bits(energie.flags,0x0040) = false
        }
        when {
            require bits(bague.flags,0x0040)
        } then {
            say Tequila presentation=11 : "Une bague... OH|! C'est pour moi COMMANDER|? MERCI|!"
            say Tequila presentation=8 chatter if_not_shown skip_next=4 : "Et voilà le travail, vous faites encore une heureuse|... sacré COMMANDER|..."
            state_b6[Tequila.evolution] += 30
            state_b1[Tequila.population] += 400
            globals.B31 += 1
            bits(bague.flags,0x0040) = false
        }
        when {
            require bits(emetteur.flags,0x0040)
        } then {
            say Tequila presentation=17 if_not_shown skip_next=2 : "Un émetteur|... Pourquoi pas|!"
            state_b6[Tequila.evolution] += 30
            bits(emetteur.flags,0x0040) = false
        }
        when {
            require bits(culture.flags,0x0040)
        } then {
            say Tequila presentation=15 : "De la Culture|... OU|!!! Moi avoir trés mal à la téte|... Moi étudier plus tard..."
            say Tequila presentation=8 chatter if_not_shown skip_next=3 : "COMMANDER, ET nous qui voulions élever son esprit|..."
            state_b6[Tequila.evolution] += 50
            state_b5[Tequila.energy] += 100
            bits(culture.flags,0x0040) = false
        }
        when {
            require bits(ecriture.flags,0x0040)
        } then {
            say Tequila presentation=10 : "L'écriture... Toi vouloir faire de moi un grand écrivain MERCI|..."
            say Tequila presentation=8 chatter if_not_shown skip_next=2 : "COMMANDER, elle réve|... Faut pas exagérer|..."
            state_b6[Tequila.evolution] += 80
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Tequila presentation=14 : "Un VAISSEAU|... OH|! Moi pouvoir choisir la couleur|?"
            say Tequila presentation=8 chatter if_not_shown skip_next=3 : "COMMANDER, on lui donne un vaisseau et elle ne regarde que la couleur|..."
            state_b6[Tequila.evolution] += 50
            globals.B29 = 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Tequila presentation=11 if_not_shown skip_next=5 : "Un traité|... MERCI|! Moi plus vouloir voir petit Izwal partir à la guerre..."
            state_b6[Tequila.evolution] += 50
            globals.B30 = 0
            Tequila.aggressiveness = 0
            state_b1[Tequila.population] += 400
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Tequila presentation=18 if_not_shown skip_next=3 : "Des cadeaux|... MERCI|! Toi étre le plus beau, le plus gentil|..."
            state_b6[Tequila.evolution] += 30
            state_b5[Tequila.energy] += 400
            bits(cadeaux.flags,0x0040) = false
        }
        say Tequila presentation=8 chatter : "Quel objet désirez-vous lui donner, Commander?"
        say Tequila presentation=8 chatter resume_at=gest03_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Tequila presentation=8 : "..."
        gest03_dialogue_resume_1:
        say Tequila presentation=8 chatter : "A BIENTOT, COMMANDER..."
        say Tequila presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Tequila
        halt
    }
}
