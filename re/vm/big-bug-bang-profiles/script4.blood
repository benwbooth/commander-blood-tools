            say Izwalito presentation=8 chatter if_not_shown skip_next=2 : "De l'écriture|... Merci|..."
            state_b6[Izwalito.evolution] += 50
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Izwalito presentation=18 if_not_shown skip_next=3 : "Un VAISSEAU... Waoh|!!! Direction assistée|... Siéges en cuir|... ABS|..."
            state_b6[Izwalito.evolution] += 50
            globals.B29 = 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Izwalito presentation=8 chatter if_not_shown skip_next=5 : "Un traité, voyons voir, c'est pour arréter la guerre|..."
            state_b6[Izwalito.evolution] += 50
            globals.B30 = 0
            Izwalito.aggressiveness = 100
            state_b1[Izwalito.population] += 400
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Izwalito presentation=9 if_not_shown skip_next=3 : "Des cadeaux|... MERCI|... MERCI|..."
            state_b6[Izwalito.evolution] += 10
            state_b5[Izwalito.energy] += 500
            bits(cadeaux.flags,0x0040) = false
        }
        say Izwalito presentation=8 chatter : "Quel objet désirez-vous lui donner, Commander?"
        say Izwalito presentation=8 chatter resume_at=gest02_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Izwalito presentation=8 : "..."
        gest02_dialogue_resume_1:
        say Izwalito presentation=8 chatter : "A BIENTOT, COMMANDER|... REVIENS QUAND TU VEUX|..."
        say Izwalito presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Izwalito
    }
    proc finteq2 enabled {
