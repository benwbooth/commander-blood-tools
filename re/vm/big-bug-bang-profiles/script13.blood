                say Otto_Von_Gluk presentation=8 chatter : "un peu violents..."
                say Otto_Von_Gluk presentation=9 : "Eh là, doucement|! Tu le veux ton vaisseau ou pas|?"
                say Otto_Von_Gluk presentation=8 chatter : "vous allez pas nous faire du chantage|!"
                say Otto_Von_Gluk presentation=10 : "Je vais me géner|!"
                say Otto_Von_Gluk presentation=8 chatter : "vautour|!"
                say Otto_Von_Gluk presentation=16 : "PIGEON|!"
                say Otto_Von_Gluk presentation=8 chatter : "pourri du bulbe|!"
                say Otto_Von_Gluk presentation=10 : "Pourri de bugs|!"
                say Otto_Von_Gluk presentation=8 chatter : "mesquin, ca, mesquin|!"
                say Otto_Von_Gluk presentation=11 : "Je sais, c'est pas facile tous les jours..."
                say Otto_Von_Gluk presentation=8 chatter : "Pauvre vieux, ca doit étre affreux d'étre un salaud..."
                say Otto_Von_Gluk presentation=12 : "Ouais... C'est l'horreur..."
                say Otto_Von_Gluk presentation=8 chatter : "les problémes de mauvaise conscience, tout ca..."
                say Otto_Von_Gluk presentation=12 : "Ouais, l'horreur..."
                say Otto_Von_Gluk presentation=8 chatter : "je compatis de tout mon disque dur..."
                say Otto_Von_Gluk presentation=13 : "T'es sympa, vieux. Allez, je vous le laisse, le vaisseau..."
                say Otto_Von_Gluk presentation=8 chatter : "merci camarade..."
                say Otto_Von_Gluk presentation=14 : "De rien, c'est naturel..."
                say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=3 : "TELEPORTATION VAISSEAU SUR ARCHE..."
                transfer vaisseau from Otto_Von_Gluk to aboard
                globals.A4 = 0
                globals.A34 = 2
            }
        }
    }
