            say Otto_Von_Gluk presentation=8 chatter : "filez-lui un crédit, commander..."
            say Otto_Von_Gluk presentation=8 chatter resume_at=ototo_dialogue_resume_4 : "Est-ce que vous acceptez de lui filer un crédit, commander|?" choices "accepter" "refuser"
