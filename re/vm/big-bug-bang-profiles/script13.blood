    proc finsmi1 enabled {
        during contact
        require Otto_Von_Smile.current_location == aboard
        require globals.A68 == 2
        require presentation == Otto_Von_Smile
    } then {
        say Otto_Von_Smile presentation=10 : "Sympa le concert|..."
        say Otto_Von_Smile presentation=11 : "Toi faire efforts pour harmonie sociouniverselle|..."
        say Otto_Von_Smile presentation=12 : "Ca bien|... Mais inutile|... Bientot BIG BANG|!..."
        say Otto_Von_Smile presentation=8 if_not_shown skip_next=2 : "..."
        globals.A13 += 3
        end presentation Otto_Von_Smile
    }
    proc gresmi enabled {
        during bridge
        require globals.A61 == 1
        require presentation == Otto_Von_Smile
    } then {
        say Otto_Von_Smile presentation=8 : "krouik|..."
        say Otto_Von_Smile presentation=8 : "Ici Von Smile|... J'appelle au nom de tous les habitants de cet Univers|..."
        say Otto_Von_Smile presentation=8 chatter : "rien que ca|?..."
        say Otto_Von_Smile presentation=8 : "Je dis tout haut ce que tout le monde pense tout bas|..."
        say Otto_Von_Smile presentation=8 chatter : "ben allez-y, on vous écoute|..."
        say Otto_Von_Smile presentation=8 : "La situation est intolérable|! Le plan BOB est scandaleux|!..."
        say Otto_Von_Smile presentation=8 chatter : "le|... plan bob|?..."
        say Otto_Von_Smile presentation=8 : "Oui|! Vous devez vous servir de nous pour le faire réapparaitre, cet exploiteur|!..."
        say Otto_Von_Smile presentation=8 chatter : "exploiteur|! vous y allez fort|!..."
        say Otto_Von_Smile presentation=8 : "Parfaitement|! Nous habitants de cet univers sommes exploités par vous et par BOB|!..."
        say Otto_Von_Smile presentation=8 : "Et on n'en restera pas là|!..."
        say Otto_Von_Smile presentation=8 : "krouik|..."
        say Otto_Von_Smile presentation=8 chatter : "il a raccroché|!..."
        say Otto_Von_Smile presentation=8 if_not_shown skip_next=2 : "..."
        globals.A61 = 2
        end presentation Otto_Von_Smile
    }
    proc ovs01 enabled {
        during travel
        require presentation == Otto_Von_Smile
    } then {
        when {
            require globals.A68 == 1
        } then {
            say Otto_Von_Smile presentation=9 : "Toi dégager envoyé de BOB|!..."
            say Otto_Von_Smile presentation=8 chatter : "oulàlà|..."
            say Otto_Von_Smile presentation=10 : "Moi pas négocier ta téte|... direct coupe-coupe|..."
            say Otto_Von_Smile presentation=8 chatter : "retirons-nous, commander|..."
            say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Otto_Von_Smile
        }
        when {
            require Otto_Von_Smile.encounter_count == 1
        } then {
            say Otto_Von_Smile presentation=11 : "Qu'est-ce que vous foutez ici? Vous étes chez Otto Von Smile"
            say Otto_Von_Smile presentation=8 chatter resume_at=ovs01_dialogue_resume_1 : "vous voulez lui parler|, commander|?..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say Otto_Von_Smile presentation=8 chatter : "On pourrait lui parler?"
                say Otto_Von_Smile presentation=12 : "Imbécile intergalactique! Tu es en train de lui parler!"
                say Otto_Von_Smile presentation=13 : "Mais Otto Von Smile est un SLIMER. Otto Von Smile ne parle pas à moins intelligent que lui..."
                dictionary blank after "lui..."
                say Otto_Von_Smile presentation=8 chatter : "Ni à plus modeste, j'imagine|..."
                say Otto_Von_Smile presentation=8 chatter : "pourtant c'est nous qui vous avons fait muter|..."
                say Otto_Von_Smile presentation=13 : "Quelle petite chose ridicule... Ca marche encore à piles, je parie, arf, arf..."
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "A piles peut-étre, mais à piles nucléaires..."
                choice = none
            }
            when {
                require choice == "non"
            } then {
                choice = none
            }
            ovs01_dialogue_resume_1:
            say Otto_Von_Smile presentation=14 : "Snif|! Snif|! Mais ça pue... Vous puez le curryxx... Vous mangez trop épicé..."
            say Otto_Von_Smile presentation=8 chatter : "Waoh! Il a pas l'air commode, Commander..."
            say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Otto_Von_Smile
        }
        when {
            require Otto_Von_Smile.encounter_count == 2
        } then {
            say Otto_Von_Smile presentation=12 if_not_shown skip_next=1 : "Alors, de retour|? On est allé se laver les dents, Puanteur|?"
            medicament.holder = aboard
            say Otto_Von_Smile presentation=8 chatter resume_at=ovs01_dialogue_resume_2 : "vous vous étes lavé les dents|, commander|?..." choices "lavé" "pue_toujours"
            when {
                require choice == "lavé"
            } then {
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=2 : "Avec du Papygluxxyl bi-enfluré|?..."
                transfer medicament from Otto_Von_Smile to aboard
                choice = none
            }
            when {
                require choice != "lavé"
            } then {
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=2 : "Essaie le Croolygencyl|, Puanteur|!..."
                transfer medicament from Otto_Von_Smile to aboard
                choice = none
            }
            ovs01_dialogue_resume_2:
            say Otto_Von_Smile presentation=8 chatter : "il est d'un vexant|!..."
            say Otto_Von_Smile presentation=13 : "Au fait|... J'ai appris de source sùre que tu es ami avec les GLUXX..."
            say Otto_Von_Smile presentation=14 : "Autant te dire que JE N'AIME PAS CA|!..."
            say Otto_Von_Smile presentation=15 : "TOI COMPRENDRE|? MOI PAS AIMER, CAMARADE..."
            say Otto_Von_Smile presentation=8 chatter : "Oulala, lui parler comme ca quand lui pas content... Moi les boules, commander..."
            say Otto_Von_Smile presentation=14 : "Moi sentir colére monter... Moi avoir mains moites..."
            say Otto_Von_Smile presentation=8 chatter : "Aie... Ca va chauffer... Dégageons... Attendons qu'il se calme"
            say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=2 : "..."
            end presentation Otto_Von_Smile
            sequence_slots[4] = "41cryobug"
        }
        when {
            require Otto_Von_Smile.encounter_count == 3
        } then {
            say Otto_Von_Smile presentation=15 : "OUI QUI ETRE LA?"
            say Otto_Von_Smile presentation=8 chatter : "Aie... Il a pas l'air calmé..."
            say Otto_Von_Smile presentation=16 : "Ah ça sent des pieds... C'est toi, Commander..."
            say Otto_Von_Smile presentation=8 chatter : "Oui, c'est nous... Vous nous réconnaissez|?"
            say Otto_Von_Smile presentation=14 : "Toi vouloir faire humour avec moi|?"
            say Otto_Von_Smile presentation=8 chatter resume_at=ovs01_dialogue_resume_3 : "vous vouloir faire humour avec lui|, commander|?..." choices "humour" "pas_humour"
            when {
                require choice == "humour"
            } then {
                say Otto_Von_Smile presentation=8 chatter : "alors voilà|... C'est l'histoire|..."
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "du légionnaire|..."
                request sequence "marcomb.hnm"
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "et de la chévre|..."
                request sequence "flitutr.hnm"
                say Otto_Von_Smile presentation=16 if_not_shown skip_next=1 : "Toi pas rigolo|, toi retourner à l'école du rire|..."
                choice = none
            }
            when {
                require choice != "humour"
            } then {
                say Otto_Von_Smile presentation=16 if_not_shown skip_next=1 : "Pourquoi|? Moi pas d'humour peut-étre|?..."
                choice = none
            }
            ovs01_dialogue_resume_3:
            say Otto_Von_Smile presentation=8 chatter : "Aie... Encore fait une gaffe... Mais on reviendra|..."
            say Otto_Von_Smile presentation=8 chatter : "juste aprés|..."
            say Otto_Von_Smile presentation=8 chatter : "ça|!..."
            say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=2 : "..."
            end presentation Otto_Von_Smile
            sequence_slots[5] = "15parfum"
        }
        when {
            require Otto_Von_Smile.encounter_count == 4
        } then {
            say Otto_Von_Smile presentation=15 : "AH AH AH|! HI HI|! HO HO|!..."
            say Otto_Von_Smile presentation=8 chatter : "Commander, je réve|! il rigole|!..."
            say Otto_Von_Smile presentation=16 : "Ah Ah|! J'ai appris de source sùre que vous étiez le nouveau scénariste|!..."
            say Otto_Von_Smile presentation=15 : "Vous|? Le scénariste de Commander Blood|?... AH AH AH|! Quelle rigolade|!"
            say Otto_Von_Smile presentation=8 chatter : "Il se fout de votre gueule, commander|!..."
            say Otto_Von_Smile presentation=14 : "J'ai jamais vu un jeu aussi nul|! Plein de bugs|!"
            say Otto_Von_Smile presentation=8 if_not_shown skip_next=2 : "Et rien que de l'humour à deux balles..."
            transfer credit from Otto_Von_Smile to aboard
            globals.A4 += 2
            say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "Deux balles|! Pas plus|!"
            transfer credit from Otto_Von_Smile to aboard
            say Otto_Von_Smile presentation=8 chatter : "commander, il nous a filé deux crédits|!"
            say Otto_Von_Smile presentation=11 : "Allez vous acheter un vrai scénariste avec ca, ah ah|!..."
            say Otto_Von_Smile presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Otto_Von_Smile
            sequence_slots[3] = "27exploplane"
        }
        when {
            require Otto_Von_Smile.encounter_count == 5
        } then {
            say Otto_Von_Smile presentation=10 : "Alors, vous l'avez acheté ce scénariste|?..."
            say Otto_Von_Smile presentation=8 chatter resume_at=ovs01_dialogue_resume_4 : "..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say Otto_Von_Smile presentation=12 if_not_shown skip_next=1 : "MENSONGE|! C'est encore vous, Puanteur|! Moi détester mensonge|!..."
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Otto_Von_Smile presentation=13 if_not_shown skip_next=1 : "Et alors|? Qu'est-ce que vous attendez|?..."
                choice = none
            }
            ovs01_dialogue_resume_4:
            say Otto_Von_Smile presentation=14 : "Votre jeu n'a aucun intérét|! 3 sur 20 maximum|! Pas d'histoire|! Aucune interactivité|!..."
            say Otto_Von_Smile presentation=15 : "On passe son temps à lire des dialogues et puis c'est tout|!..."
            say Otto_Von_Smile presentation=8 chatter resume_at=_5next : "Commander, vous étes d'accord avec lui|?..." choices "d_accord" "pas_d_accord"
            when {
                require choice == "d_accord"
            } then {
                say Otto_Von_Smile presentation=8 chatter : "vous étes maso, commander|! il a raison, vous étes nul|!..."
                say Otto_Von_Smile presentation=10 if_not_shown skip_next=1 : "Evidemment que j'ai raison... Qu'est-ce qui lui prend à Monsieur Bob d'engager des minables pareils|?!..."
                choice = none
            }
            when {
                require choice != "_d_accord"
            } then {
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "Pourtant il a un peu raison, le slimer, vous trainez, commander|..."
                choice = none
            }
        }
    }
    proc _5next as "5next" enabled {
        during travel
        require presentation == Otto_Von_Smile
    } then {
        when {
            require Otto_Von_Smile.encounter_count == 5
        } then {
            say Otto_Von_Smile presentation=11 : "Quand je pense que j'aurais pu jouer dans DOOM|!..."
            say Otto_Von_Smile presentation=13 : "Là au moins y a de l'action|... Boum BOOM|! Des explosions partout..."
            say Otto_Von_Smile presentation=8 chatter resume_at=_5next_dialogue_resume_1 : "préférez-vous jouer à DOOM, commander|?" choices "doom" "non"
            when {
                require choice == "doom"
            } then {
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "T'as raison|! Ce jeu|, il est nul à ch..."
                request sequence "ppit03.hnm"
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "chut|!..."
                request sequence "bobb.hnm"
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "Ouais|! On veut de la violence|!..."
                request sequence "match02.hnm"
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "De la viande froide|!..."
                transfer nourriture from Otto_Von_Smile to aboard
                say Otto_Von_Smile presentation=8 chatter : "Trés bien|, tu veux jouer à doom|?..."
                say Otto_Von_Smile presentation=8 chatter : "eh ben t'as qu'à y aller|!..."
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "Ouais|! Super|!..."
                request sequence "match02.hnm"
                say Otto_Von_Smile presentation=8 chatter : "je fais péter le jeu à l'atomique|!..."
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=3 : "..."
                end presentation Otto_Von_Smile
                globals.A13 = 1
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "encore heureux|!..."
                choice = none
            }
        }
        _5next_dialogue_resume_1:
        when {
            require Otto_Von_Smile.encounter_count == 5
        } then {
            say Otto_Von_Smile presentation=8 chatter : "Y a quand méme des trucs bien dans doom|... Les explosions, par exemple|!..."
            say Otto_Von_Smile presentation=8 chatter resume_at=_5next_dialogue_resume_2 : "Commander, voulez-vous voir des explosions|?..." choices "boom" "non_merci"
            when {
                require choice == "boom"
            } then {
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "On fait péter les explosions|!... BOOM|!"
                request sequence "explo3.hnm"
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "Encore une|!..."
                request sequence "explo3.hnm"
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "Et une autre|!..."
                request sequence "explo3.hnm"
                say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice == "non_merci"
            } then {
                say Otto_Von_Smile presentation=8 chatter : "Juste une pour me faire plaisir|..."
                say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=1 : "Et hop|!..."
                request sequence "explo3.hnm"
