            say Otto_Von_Potato presentation=15 if_not_shown skip_next=2 : "De la nourriture..."
            state_b5[Otto_Von_Potato.energy] += 150
            bits(nourriture.flags,0x0040) = false
        }
        when {
            require bits(medicament.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 if_not_shown skip_next=3 : "Des médicaments..."
            state_b6[Otto_Von_Potato.evolution] += 10
            state_b1[Otto_Von_Potato.population] += 150
            bits(medicament.flags,0x0040) = false
        }
        when {
            require bits(armes.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=14 if_not_shown skip_next=4 : "DES ARMES|!!! MERCI COMMANDER... TU ME GATES..."
            Otto_Von_Potato.aggressiveness += 250
            state_b6[Otto_Von_Potato.evolution] += 50
            globals.B54 = 1
            bits(armes.flags,0x0040) = false
        }
        when {
            require bits(optique.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=15 : "Des lentilles optiques... Tu plaisantes, c'est nous qui les fabriquons..."
            say Otto_Von_Potato presentation=8 chatter if_not_shown skip_next=2 : "Ah oui, il a raison, Commander..."
            optique.holder = aboard
            bits(optique.flags,0x0040) = false
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 if_not_shown skip_next=2 : "De l'énergie, intéressant..."
            state_b5[Otto_Von_Potato.energy] += 800
            bits(energie.flags,0x0040) = false
        }
        when {
            require bits(bague.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 if_not_shown skip_next=5 : "Une bague..."
            state_b6[Otto_Von_Potato.evolution] += 10
            state_b1[Otto_Von_Potato.population] += 200
            globals.B55 += 1
            Otto_Von_Potato.aggressiveness -= 200
            bits(bague.flags,0x0040) = false
        }
        when {
            require bits(emetteur.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 if_not_shown skip_next=2 : "Un émetteur"
            state_b6[Otto_Von_Potato.evolution] += 5
            bits(emetteur.flags,0x0040) = false
        }
        when {
            require bits(culture.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 if_not_shown skip_next=3 : "De la Culture... C'est quoi ça..."
            state_b6[Otto_Von_Potato.evolution] += 20
            state_b5[Otto_Von_Potato.energy] += 10
            bits(culture.flags,0x0040) = false
        }
        when {
            require bits(ecriture.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=13 : "L'écriture... Mais je sais déja écrire Commander, tiens regarde:"
            say Otto_Von_Potato presentation=14 : "CHAIR KOMANDEUR, JEUX TAICRI POUR THEU DONNAI DEMAI NOUVELE..."
            say Otto_Von_Potato presentation=8 chatter if_not_shown skip_next=2 : "OK, Monsieur Otto... C'est SUPER..."
            state_b6[Otto_Von_Potato.evolution] += 60
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 if_not_shown skip_next=2 : "Un VAISSEAU... C'est le gros lot..."
            state_b6[Otto_Von_Potato.evolution] += 10
            globals.B66 = 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 : "Un traite de paix... Intèressant..."
            say Otto_Von_Potato presentation=8 chatter if_not_shown skip_next=3 : "Voila qui va le calmer, Commander..."
            Otto_Von_Potato.aggressiveness = 0
            state_b1[Otto_Von_Potato.population] += 500
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Otto_Von_Potato presentation=9 if_not_shown skip_next=3 : "Des cadeaux... Je T'AIME... COMMANDER..."
            state_b6[Otto_Von_Potato.evolution] += 10
            state_b5[Otto_Von_Potato.energy] += 10
            bits(cadeaux.flags,0x0040) = false
        }
        say Otto_Von_Potato presentation=8 chatter : "Quel objet désirez-vous donner à Otto, Commander?"
        say Otto_Von_Potato presentation=8 chatter resume_at=gestovp_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Otto_Von_Potato presentation=8 : "..."
        gestovp_dialogue_resume_1:
        when {
            require globals.B65 == 1
            require globals.B66 == 1
        } then {
            globals.B53 = 1
        }
        say Otto_Von_Potato presentation=11 : "A BIENTOT, COMMANDER... REVIENS ME VOIR AVEC BEAUCOUP DE CHOSES..."
        say Otto_Von_Potato presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Otto_Von_Potato
        halt
    }
}
