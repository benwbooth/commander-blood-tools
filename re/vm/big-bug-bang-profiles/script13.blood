                globals.A4 -= 1
                say Otto_Von_Gluk presentation=11 : "On ne m'achéte pas, moi|! Trous puants|!"
                say Otto_Von_Gluk presentation=8 chatter : "Aie commander, on l'a vexé..."
                say Otto_Von_Gluk presentation=8 chatter : "ma grosse puce me dit qu'on ne lui a pas donné assez... Il est gourmand, Von Gluk..."
                say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=3 : "Allez, faut étre royal... On lui donne tout notre fric|!"
                globals.A27 = 1
                globals.A58 = 2
                choice = none
