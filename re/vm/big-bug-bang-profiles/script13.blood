            say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=1 : "..."
            end presentation Otto_Von_Gluk
        }
        when {
            require globals.A29 == 1
            require globals.A34 == 0
            require globals.vbio > 9
        } then {
            say Otto_Von_Gluk presentation=8 chatter : "bon ben voilà monsieur von gluk, on a vos géraniums..."
            say Otto_Von_Gluk presentation=12 : "Ils sentent bizarre vos géraniums..."
            say Otto_Von_Gluk presentation=8 chatter : "Ca c'est parce qu'on les a volés aux Gluxx..."
            say Otto_Von_Gluk presentation=16 : "Quoi|?! Ils viennent aussi des GLUXX|?"
            say Otto_Von_Gluk presentation=8 chatter : "aie... encore une gaffe..."
            say Otto_Von_Gluk presentation=13 : "AH AH AH|!"
            say Otto_Von_Gluk presentation=8 chatter : "Il rigole|!"
            say Otto_Von_Gluk presentation=14 : "J'en reviens pas|! vous les avez piqués aux GLUXX|! Quelle bonne blague|!"
            say Otto_Von_Gluk presentation=8 chatter : "ca a l'air de lui plaire, finalement..."
            say Otto_Von_Gluk presentation=8 chatter resume_at=ototo_dialogue_resume_6 : "Bon alors, on lui donne son bionium, commander|?" choices "donner"
            when {
                require choice == "donner"
            } then {
                say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=2 : "..."
                globals.A29 = 2
                choice = none
            }
        }
        ototo_dialogue_resume_6:
        when {
            require globals.A29 == 2
            require globals.A34 == 0
        } then {
            say Otto_Von_Gluk presentation=8 chatter : "on balance les géraniums|!..."
            say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=2 : "..."
            transfer bionium from aboard to Otto_Von_Gluk
            globals.vbio -= 10
            say Otto_Von_Gluk presentation=14 : "SNIF SNIF..."
            say Otto_Von_Gluk presentation=8 chatter : "aie, il reconnait pas l'odeur..."
            say Otto_Von_Gluk presentation=15 : "Mmmmm... SNIF SCHNOUF|!... Ta mére|..."
            say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "A poil sur cd rom..."
            request sequence "flitutr.hnm"
            say Otto_Von_Gluk presentation=8 chatter : "ca lui plait quand méme, on dirait..."
            say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "AAAAAA... CHNOUF|!!!"
            request sequence "explbleu.hnm"
            say Otto_Von_Gluk presentation=8 chatter : "cd rhume|?..."
            say Otto_Von_Gluk presentation=11 : "AAAaaa... Ils sont bons vos géraniums..."
