        require presentation == Otto_Von_Gluk
    } then {
        say Otto_Von_Gluk presentation=8 : "krouik|..."
        say Otto_Von_Gluk presentation=8 chatter : "allo oui j'écoute|?..."
        say Otto_Von_Gluk presentation=8 : "Allo ici Von Gluk|..."
        say Otto_Von_Gluk presentation=8 chatter : "tiens, tiens|... les slimers adorent le téléphone|..."
        say Otto_Von_Gluk presentation=8 : "Oui ben voilà|! Moi penser pareil que le patron|!..."
        say Otto_Von_Gluk presentation=8 : "...krouik|... aie|! Pas sur la téte, patron|! krouik|!..."
        say Otto_Von_Gluk presentation=8 : "....krkrkrrk|... aie|! Mais non j'ai pas dit votre nom, patron|! Aie|!|..."
        say Otto_Von_Gluk presentation=8 chatter : "qu'est-ce qui se passe, von gluk|? vous vous battez|?..."
        say Otto_Von_Gluk presentation=8 : "krkrkrouik|... non, pardon|... C'était pour dire que je pensais que|..."
        dictionary blank after "C'était"
        say Otto_Von_Gluk presentation=8 chatter : "que|?..."
        say Otto_Von_Gluk presentation=8 : "... krkrr|... ah oui|! Qu'on était exploité|! C'est plus possible|! Et je dis tout haut ce que tout l'univers pense tout bas|!..."
        say Otto_Von_Gluk presentation=8 chatter : "et y a personne qui vous souffle en ce moment|?..."
        say Otto_Von_Gluk presentation=8 : "Hein|?... Quoi|?... parlez plus fort, patron, j'entends pas|... Aie|! Non|! Pas la téte|!..."
        say Otto_Von_Gluk presentation=8 : "krkrkr|... Euh|... Non|! Personne|... euh|... bon je rappellerai|!..."
        say Otto_Von_Gluk presentation=8 chatter : "voilà, c'est ca, quand vous serez plus au point|..."
        say Otto_Von_Gluk presentation=8 : "krouik|..."
        say Otto_Von_Gluk presentation=8 if_not_shown skip_next=2 : "..."
        globals.A61 = 3
        end presentation Otto_Von_Gluk
    }
    proc fingluk1 enabled {
        during contact
        require Otto_Von_Gluk.current_location == aboard
        require globals.A68 == 2
        require presentation == Otto_Von_Gluk
    } then {
