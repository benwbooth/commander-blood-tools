    proc ovp01 enabled {
        require presentation == Otto_Von_Potato
    } then {
        say Otto_Von_Potato presentation=9 : "Moi Otto Von Potato, moi SLIMER..."
        text_tokens Otto_Von_Potato presentation=11 : "Nous" "étre" state_number(0x0DAC) "slimers" "ici..."
        when {
            require Otto_Von_Potato.aggressiveness < 1000
            require optique.holder != aboard
        } then {
            say Otto_Von_Potato presentation=13 : "Nous fabriquer lentilles optiques pour voir planétes..."
            say Otto_Von_Potato presentation=15 : "Nous vendre à toi lentilles contre crédit..."
            when {
                require globals.A4 == 0
            } then {
                say Otto_Von_Potato presentation=8 chatter : "Nous n'avons plus de crédits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Otto_Von_Potato presentation=8 chatter resume_at=gestovp : "Vous acceptez de leurs acheter leur lentilles, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Otto_Von_Potato presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Otto_Von_Potato
                    globals.A4 -= 1
                    say Otto_Von_Potato presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION LENTILLE OPTIQUE DANS CRYOBOX"
                    transfer optique from Otto_Von_Potato to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
