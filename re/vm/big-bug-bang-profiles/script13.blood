            say Otto_Von_Smile presentation=9 : "Un Traité de|... De quoi|? De Paix|?... Hum|... Je vais le lire..."
            say Otto_Von_Smile presentation=8 chatter if_not_shown skip_next=5 : "Voila qui va calmer son agressivité pour un moment, Commander..."
            state_b6[Otto_Von_Smile.evolution] += 50
            globals.B54 = 0
            Otto_Von_Smile.aggressiveness = 0
            state_b1[Otto_Von_Smile.population] += 200
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Otto_Von_Smile presentation=13 if_not_shown skip_next=3 : "Des cadeaux... Je T'AIME... COMMANDER..."
            state_b6[Otto_Von_Smile.evolution] += 10
            state_b5[Otto_Von_Smile.energy] += 100
            bits(cadeaux.flags,0x0040) = false
        }
        say Otto_Von_Smile presentation=8 chatter : "Quel objet désirez-vous donner à Otto, Commander?"
        say Otto_Von_Smile presentation=8 chatter resume_at=gestovs_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Otto_Von_Smile presentation=8 : "..."
        gestovs_dialogue_resume_1:
        when {
            require globals.B65 == 1
        } then {
            globals.B53 = 1
        }
        say Otto_Von_Smile presentation=14 : "A BIENTOT, COMMANDER... REVIENS ME VOIR AVEC BEAUCOUP DE CHOSES..."
        say Otto_Von_Smile presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Otto_Von_Smile
    }
    proc biodec enabled {
        during bridge
        require globals.A27 == 3
        require presentation == Otto_Von_Gluk
    } then {
        say Otto_Von_Gluk presentation=8 : "J'arrive pas à décrocher|..."
