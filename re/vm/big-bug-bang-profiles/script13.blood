                say Otto_Von_Gluk presentation=10 : "La quoi|?"
                say Otto_Von_Gluk presentation=8 chatter : "excusez-moi, je parlais la bouche pleine, c'est trop bon ce jus de SINOX"
                say Otto_Von_Gluk presentation=8 chatter : "je veux dire, tu cherches la castagne|?..."
                say Otto_Von_Gluk presentation=12 : "Cause toujours, minus..."
                say Otto_Von_Gluk presentation=8 chatter : "Qu'est-ce t'as à me parler comme ca|? T'aimes plus la vie ou quoi|?"
                say Otto_Von_Gluk presentation=13 : "Ta mére à poil sur CD-ROM|!..."
                say Otto_Von_Gluk presentation=8 chatter : "la tienne... La tienne..."
                say Otto_Von_Gluk presentation=8 chatter : "commander, je sais pas quoi dire, aidez-moi..."
                say Otto_Von_Gluk presentation=8 chatter : "Allez-y, balancez-lui une insulte|!" choices "Dites-lui"
                say Otto_Von_Gluk presentation=8 chatter : "Je suis sùr qu'il entendra à travers l'écran|!..."
                say Otto_Von_Gluk presentation=8 chatter : "...|...|...|...|...|...|...|...|...|...|...|..."
                say Otto_Von_Gluk presentation=8 chatter : "... votre insulte|..."
                say Otto_Von_Gluk presentation=8 chatter : "est transmise|..."
                say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=1 : "par l'écran, commander|..."
                request sequence "scandoig.hnm"
                say Otto_Von_Gluk presentation=14 : "Arf Arf|! Elle est nulle ton insulte|!"
                say Otto_Von_Gluk presentation=8 chatter : "t'injuries mon commander, là|!"
                say Otto_Von_Gluk presentation=15 : "Ton insulte elle suce des endives, arf arf|!"
                say Otto_Von_Gluk presentation=8 chatter : "commander, il insulte votre insulte|!"
                say Otto_Von_Gluk presentation=15 : "ARF ARF|! Des endives|!..."
                say Otto_Von_Gluk presentation=8 chatter : "tu veux qu'on t'atomise la gueule ou quoi|?"
                say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "Ligue intergalactique de vertu|!..."
                request sequence "ppitin02.hnm"
                say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "Amende de un crédit pour incorrection verbale|!..."
                request sequence "diplom1v.hnm"
                say Otto_Von_Gluk presentation=16 : "Atomique ta mére, commander|!"
                say Otto_Von_Gluk presentation=8 chatter : "ma parole, tu vas la bouffer notre bombe|!"
                say Otto_Von_Gluk presentation=11 : "je préférerais du bionium, mais comme tu voudras, tas de rouille|!"
                say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=3 : "allez-y commander, atomisez-lui sa tronche d'endive..."
                globals.A30 = 1
                globals.A28 = 2
                choice = none
            }
        }
        ototo_dialogue_resume_5:
        when {
            require globals.vbio < 10
            require globals.A29 == 1
            require globals.A34 == 0
        } then {
