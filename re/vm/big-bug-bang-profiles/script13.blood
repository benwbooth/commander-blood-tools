        say Otto_Von_Gluk presentation=8 if_not_shown skip_next=2 : "..."
        globals.A13 += 3
        end presentation Otto_Von_Gluk
    }
    proc ovgl01 enabled {
        during travel
        require presentation == Otto_Von_Gluk
    } then {
        when {
            require globals.A68 == 1
        } then {
            say Otto_Von_Gluk presentation=9 : "Gluk|... Pas Gluk|..."
            say Otto_Von_Gluk presentation=8 chatter : "pas gréve|?..."
            say Otto_Von_Gluk presentation=10 : "Ah si! ah si|!... Gréve|..."
            say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Otto_Von_Gluk
        }
        when {
            require Otto_Von_Gluk.encounter_count == 1
        } then {
            say Otto_Von_Gluk presentation=11 : "Moi Général Otto Von Gluk, Commandant en chef du bataillon slimer de la troisiéme galaxie..."
            say Otto_Von_Gluk presentation=8 chatter : "Bonjour Monsieur|..."
            say Otto_Von_Gluk presentation=8 chatter : "Commander, tout de méme, c'est trés étonnant... Les SLIMERS ont migré..."
            say Otto_Von_Gluk presentation=8 chatter : "sans qu'on leur donne de vaisseau|!..."
        }
        say Otto_Von_Gluk presentation=10 : "MOI GENERAL OTTO VON GLUK te souhaite la bienvenue, Commander..."
        text_tokens Otto_Von_Gluk presentation=11 : "Nous" "sommes" state_number(0x0D62) "slimers" "ici..."
        when {
            require globals.A58 == 1
            require armes.holder != aboard
        } then {
            say Otto_Von_Gluk presentation=10 : "J'ai dit je veux des armes|... Vous n'en avez pas|... Inutile de revenir sans|..."
            say Otto_Von_Gluk presentation=8 chatter : "bon|..."
            say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Otto_Von_Gluk
        }
    }
    proc ototo enabled {
        during travel
        require presentation == Otto_Von_Gluk
    } then {
        when {
            require globals.A58 == 0
            require globals.A34 == 0
            require vaisseau.holder != aboard
            require armes.holder != aboard
        } then {
            say Otto_Von_Gluk presentation=10 : "Nous fabriquons de beaux vaisseaux pour voyager dans l'espace..."
            say Otto_Von_Gluk presentation=8 chatter : "Corne du diable|! Ils en fabriquent|! Comment font-ils|?..."
            say Otto_Von_Gluk presentation=14 : "C'est gràce à la technologie que vous nous avez donnée, Commander..."
            say Otto_Von_Gluk presentation=8 chatter : "Tout s'explique..."
            say Otto_Von_Gluk presentation=15 : "Nous pouvons te vendre un vaisseau contre 3 crédits..."
            say Otto_Von_Gluk presentation=8 chatter : "Waoh! Pas cher|!!! Ca tombe bien, commander, on en a besoin..."
            say Otto_Von_Gluk presentation=8 chatter : "pour faire migrer les autres espéces..."
            say Otto_Von_Gluk presentation=16 : "QUOI|? IL Y A D'AUTRES ESPECES|?"
            say Otto_Von_Gluk presentation=8 chatter : "Aie... J'ai encore trop parlé..."
            say Otto_Von_Gluk presentation=13 resume_at=ototo_dialogue_resume_1 : "Il y en a beaucoup, des espéces|?..." choices "oui" "non"
            when {
                require choice != "non"
            } then {
                say Otto_Von_Gluk presentation=12 : "Pas question de vous fournir un vaisseau pour que vous les fassiez migrer de partout|!... Univers rempli d'aliens|... BEURK|!..."
                dictionary blank after "BEURK"
                say Otto_Von_Gluk presentation=8 chatter : "mais s'ils sont dans l'univers, ils ne sont pas chez vous|!..."
                say Otto_Von_Gluk presentation=11 if_not_shown skip_next=1 : "Moui|... C'est vrai|..."
                choice = none
            }
            when {
                require choice != "oui"
            } then {
                say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=1 : "Non, rassurez-vous, pour l'instant une ou deux maximum..."
                choice = none
            }
            ototo_dialogue_resume_1:
            say Otto_Von_Gluk presentation=8 chatter : "Alors, vous nous le vendez, ce vaisseau|?..."
            say Otto_Von_Gluk presentation=12 : "Pourquoi pas..."
            say Otto_Von_Gluk presentation=8 chatter : "Comment ca, pourquoi pas|? C'est toujours 3 crédits|?..."
            say Otto_Von_Gluk presentation=11 : "Ah non..."
            say Otto_Von_Gluk presentation=8 chatter : "Aie Aie aie..."
            say Otto_Von_Gluk presentation=16 : "Je veux des armes..."
            say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "Des qui font SPLATCH|!"
            request sequence "explo3.hnm"
            say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=1 : "Vous voulez dire qui font FLOUF|!"
            request sequence "explan01.hnm"
            say Otto_Von_Gluk presentation=8 if_not_shown skip_next=1 : "NON NON|! Des qui font SPLATCH|!"
            request sequence "explo3.hnm"
            say Otto_Von_Gluk presentation=16 : "De l'argent ET des armes|!"
            say Otto_Von_Gluk presentation=8 chatter : "Où c'est qu'on va trouver ca, nous|?"
            say Otto_Von_Gluk presentation=10 : "Alors là, débrouillez-vous... Pas mon probléme|!"
            say Otto_Von_Gluk presentation=8 chatter if_not_shown skip_next=2 : "Va falloir fouiller l'univers, Commander..."
            end presentation Otto_Von_Gluk
            globals.A58 = 1
