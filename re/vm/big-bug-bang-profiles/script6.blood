            say Emasculator presentation=10 : "Hein, vous m'avez traité de quoi?"
            say Emasculator presentation=8 chatter : "Mais quel crétin!"
            say Emasculator presentation=11 : "C'est bien ca, vous m'avez traité de crétin!"
            say Emasculator presentation=8 chatter if_not_shown skip_next=5 : "On lui offre la paix et il nous cherche des noises! Incurable!..."
