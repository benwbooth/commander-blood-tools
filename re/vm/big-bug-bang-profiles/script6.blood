        emasc01_dialogue_resume_7:
        when {
            require !bits(Trump.flags,0x0004)
            require atomique.holder != aboard
        } then {
            say Emasculator presentation=12 : "Tu veux du tomique|, Commander|?... 10 crédits|..."
            when {
                require globals.A4 < 10
            } then {
                say Emasculator presentation=8 chatter : "Nous n'avons pas dix crédits, Commander, c'est la misére..."
            }
            when {
                require globals.A4 > 9
            } then {
                say Emasculator presentation=8 chatter resume_at=emasc01_dialogue_resume_8 : "Vous acceptez de leur acheter de l'atomique, Commander?" choices "accepter" "refuser"
                dictionary blank after "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Emasculator presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie dix crédits, Commander"
                    transfer credit from aboard to Emasculator
                    globals.A4 -= 10
                    say Emasculator presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION ATOMIQUE DANS CRYOBOX"
                    transfer atomique from Emasculator to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
