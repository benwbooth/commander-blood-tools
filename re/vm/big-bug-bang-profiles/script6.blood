    proc chir enabled {
        require globals.B95 == 2
        during bridge
        require presentation == Emasculator
    } then {
        say Emasculator presentation=8 : "Ici l'Elysex|..."
        say Emasculator presentation=8 chatter : "mais je vous reconnais|... Vous étes Emasculator|..."
        say Emasculator presentation=8 : "Chut|... C'est mon pseudo dans le jeu|... Mais en vrai c'est Chigraxx|..."
        say Emasculator presentation=8 chatter : "Jaxx|!..."
        say Emasculator presentation=8 : "Ecoutez|... Ta gueule|!..."
        say Emasculator presentation=8 chatter : "c'est bien lui, pas de doute|..."
        say Emasculator presentation=8 : "Je suis dans ce jeu incognito|... Si mon premier ministre savait que je m'amuse sur internet|..."
        say Emasculator presentation=8 chatter : "pas sérieux, ca|..."
        say Emasculator presentation=8 : "Je sais, mais sinon je m'emmerde|..."
        say Emasculator presentation=8 chatter : "Président|!... Voyons|..."
        say Emasculator presentation=8 : "J'aimerais parler avec quelqu'un de normal|..."
        say Emasculator presentation=8 chatter : "les gens de l'enaxx vous gonflent|?..."
        say Emasculator presentation=8 : "Ils me les brisent, ces technokraxx|..."
        say Emasculator presentation=8 chatter resume_at=chir_dialogue_resume_1 : "commander, voulez-vous dialoguer avec Chigraxx|?..." choices "dialoguer" "négocier"
        when {
            require choice == "dialoguer"
        } then {
            say Emasculator presentation=8 if_not_shown skip_next=1 : "Ah|! enfin|! Putain, ça fait trente ans que j'attends ca|!..."
            choice = none
        }
        when {
            require choice == "négocier"
        } then {
            say Emasculator presentation=8 : "Ah non|! Pas question|! Ca fait depuis que je suis élu que je fais rien que négocier|!..."
            say Emasculator presentation=8 : "J'en ai marre|! Un peu d'humanité, bordel|! Je suis un crooli comme les autres|..."
            say Emasculator presentation=8 chatter : "Ah Ah|! Un crooli|! Vous avez l'air en colére|!..."
            say Emasculator presentation=8 : "C'est bien simple, je suis vert|..."
            say Emasculator presentation=8 chatter : "Un CROOLI VERT|!"
            say Emasculator presentation=8 : "Je veux dialoguer|..."
            say Emasculator presentation=8 chatter : "Bon|..."
            say Emasculator presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
        chir_dialogue_resume_1:
        say Emasculator presentation=8 chatter : "Commander, le Président veut dialoguer|..."
        say Emasculator presentation=8 resume_at=chir_dialogue_resume_2 : "Qu'est-ce que vous avez envie de lui dire|?" choices "rien" "croonard" "engluxxé" "bonjour"
        when {
            require choice == "bonjour"
        } then {
            say Emasculator presentation=8 : "Bonjour toi-méme petit cron|!..."
            say Emasculator presentation=8 chatter if_not_shown skip_next=1 : "vous n'étiez pas obligé d'étre poli avec lui, commander|..."
            dictionary blank after "n'étiez"
            choice = none
        }
        when {
            require choice != "bonjour"
        } then {
            say Emasculator presentation=8 chatter : "Félicitations, commander|! Ca lui apprendra à vouloir dialoguer avec vous|..."
            say Emasculator presentation=8 : "Eh oh|! sur un autre ton|! Méme sur Internet on se fout de ma gueule alors|?..."
            say Emasculator presentation=8 chatter : "c'est pas une vie|..."
            say Emasculator presentation=8 : "Non... D'ailleurs je retourne bosser, tiens|... Mais vous ne perdez rien pour attendre, crounouilles molles|..."
            say Emasculator presentation=8 : "Je répéterai tout à Monsieur Bob|! Il va vous sucrer les indemnités débugage|!..."
            say Emasculator presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
        chir_dialogue_resume_2:
        say Emasculator presentation=8 chatter : "c'est terrible, on ne peut pas dialoguer avec certaines personnes|..."
        say Emasculator presentation=8 : "Finalement, je préfére encore négocier|..."
        say Emasculator presentation=8 chatter : "a bientot alors|!..."
        say Emasculator presentation=8 : "quelle insolence|! machine|! tu parles au président du nucléaire|!..."
        say Emasculator presentation=8 chatter : "essaie pour voir|!..."
        say Emasculator presentation=8 : "Tu l'auras voulu, avorton|... je fais tout péter|!..."
        dictionary blank after "Tu"
        say Emasculator presentation=8 chatter : "non|! pas ca|! la guerre atomique c'est affreux|!..."
        say Emasculator presentation=8 : "Peut-étre|... Mais la paix nucléaire, ça me fait chier|... J'm'ennuie à crever|..."
        say Emasculator presentation=8 chatter : "à crever les autres, ouais|..."
        say Emasculator presentation=8 if_not_shown skip_next=3 : "..."
        end presentation Emasculator
        sequence_slots[4] = "37traitz"
        globals.B95 = 3
    }
    proc chi02 enabled {
        require globals.A65 == 1
        during bridge
        require presentation == Emasculator
    } then {
        say Emasculator presentation=8 : "krouik|..."
        say Emasculator presentation=8 : "Ici Chigraxx|!..."
        say Emasculator presentation=8 chatter : "Jaxx|! Comment ca vax|?..."
        say Emasculator presentation=8 : "Alors t'es content de toi, ver de Terre|!..."
        say Emasculator presentation=8 chatter : "mais|..."
        say Emasculator presentation=8 : "T'as foutu tout l'Univers en gréve|!... T'as fait ça rien que pour m'embéter|!..."
        say Emasculator presentation=8 : "Maintenant tout le monde me reproche de claquer du fric à essayer mes atomiques|!..."
        say Emasculator presentation=8 chatter : "ben ca coute cher|!..."
        say Emasculator presentation=8 : "Ben oui|! Evidemment|! C'est pour ça que c'est bon|!..."
        say Emasculator presentation=8 chatter : "vous appelez juste pour dire ça|?"
        say Emasculator presentation=8 : "Non|! j'appelle parce que je suis humilié|!..."
        say Emasculator presentation=8 chatter resume_at=chi02_dialogue_resume_1 : "commander, voulez-vous lui demander pourquoi|?..." choices "oui" "non"
        when {
            require choice == "oui"
        } then {
            say Emasculator presentation=8 chatter : "et pourquoi|?..."
            say Emasculator presentation=8 : "Ben|... Vous savez que je suis ici incognito|..."
            say Emasculator presentation=8 chatter : "oui|... on vous appelle emasculator|..."
            say Emasculator presentation=8 : "Oui|... Je me demande pourquoi, d'ailleurs|... Eh ben figurez-vous que pour rester incognito|..."
            say Emasculator presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
        when {
            require choice == "non"
        } then {
            say Emasculator presentation=8 : "Pour rester incognito, sous l'identité d'Emasculator|..."
            say Emasculator presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
        chi02_dialogue_resume_1:
        say Emasculator presentation=8 : "J'AI DU ME METTRE EN GREVE|! MOI|! CHIGRAXX|! EN GREVE|!..."
        say Emasculator presentation=8 chatter : "Ca vous apprendra à jouer au lieu de travailler|!..."
        say Emasculator presentation=8 : "krouik|..."
        say Emasculator presentation=8 chatter : "ca la lui coupe, commander|!..."
        say Emasculator presentation=8 if_not_shown skip_next=2 : "..."
        globals.A65 = 2
        end presentation Emasculator
    }
    proc inschi enabled {
        require globals.A94 == 0
        require globals.C11 == 9
        during bridge
        require presentation == Emasculator
    } then {
        say Emasculator presentation=8 : "KROUIK|!..."
        say Emasculator presentation=8 chatter : "oulà|! c'est un gros krouik, commander|!..."
        say Emasculator presentation=8 : "P'tain|! Ici Chigraxx, alias Emasculator|..."
        say Emasculator presentation=8 : "Alors petits bouseux|! Engluxxés|! T'as essayé de me biaiser|..."
        say Emasculator presentation=8 : "Avec ton commando crooli rouge ridicule|!..."
        say Emasculator presentation=8 : "Si tu reveux la guerre tu vas la ravoir|!..."
        say Emasculator presentation=8 : "Pour au moins sept ans|!..."
        say Emasculator presentation=8 : "KROUIK|!..."
        say Emasculator presentation=8 chatter : "aie aie aie|! ca promet, commander|!..."
        say Emasculator presentation=8 if_not_shown skip_next=3 : "..."
        globals.A94 = 1
        end presentation Emasculator
        sequence_slots[2] = "18gcrool"
    }
    proc emasc01 enabled {
        require presentation == Emasculator
    } then {
        when {
            require globals.A68 == 2
        } then {
            say Emasculator presentation=8 chatter : "alors|... Emasculator|... vous n'étes pas sur l'arche pour le grand concert|?..."
            say Emasculator presentation=10 : "Beuark|! Féte de la musique invention débile|!..."
            say Emasculator presentation=11 : "Big Bang beaucoup mieux|! Tout péter|! Braoum|!..."
            say Emasculator presentation=8 if_not_shown skip_next=2 : "..."
            globals.A13 += 3
            end presentation Emasculator
        }
        when {
            require globals.A68 == 1
            require globals.A100 < 5
        } then {
            say Emasculator presentation=9 : "EN GREVE..."
            say Emasculator presentation=10 : "..."
            say Emasculator presentation=11 : "..."
            say Emasculator presentation=12 : "..."
            say Emasculator presentation=13 : "..."
            say Emasculator presentation=14 : "..."
            say Emasculator presentation=15 : "..."
            say Emasculator presentation=16 : "..."
            say Emasculator presentation=17 : "..."
            say Emasculator presentation=18 : "P'TAIN|! MOI EN GREVE|!..."
            say Emasculator presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Emasculator
        }
        when {
            require Emasculator.encounter_count == 1
        } then {
            say Emasculator presentation=9 : "Vot' nom! Plus vite que ca!"
            dictionary blank after "Plus"
            say Emasculator presentation=8 chatter : "Oulàlà! A pas l'air commode celui-là, Commander!"
            say Emasculator presentation=10 : "Qu'est-ce qu'elle baragouine vot' bécane?"
            say Emasculator presentation=8 chatter : "Commander! Vous entendez comment qu'il me cause cet empaffé|???"
            say Emasculator presentation=11 : "Ecoute petit, si tu calmes pas ton engin..."
            say Emasculator presentation=12 : "Je vous fais péter la téte à tous les deux!"
            say Emasculator presentation=13 : "Compris?.."
            say Emasculator presentation=8 chatter : "Commander... J'ai peur..."
            say Emasculator presentation=12 : "Alors|... Tu me donne ton matricule|?..."
            say Emasculator presentation=8 chatter resume_at=emasc01_dialogue_resume_1 : "on lui dit votre nom|, commander|?..." choices "nom" "non"
            when {
                require choice == "nom"
            } then {
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Emasculator presentation=13 : "Si à 3 vous répondez pas, je vous explose|!..."
                say Emasculator presentation=8 chatter if_not_shown skip_next=1 : "commander|! je lui dis|!..."
                choice = none
            }
            emasc01_dialogue_resume_1:
            say Emasculator presentation=8 chatter : "Euh... Co... Co......"
            say Emasculator presentation=8 chatter if_not_shown skip_next=1 : "..."
            request sequence "logo_bl.hnm"
            say Emasculator presentation=15 : "Oh pardon Co... Co... Commander! Chavais pas!"
            say Emasculator presentation=16 : "Moi c'est Emasculator, Général des Croolis verts!"
            say Emasculator presentation=17 : "A vos ordres, Commander!"
            say Emasculator presentation=8 chatter : "Alors là... Il fait plus le malin, Commander!"
        }
        text_tokens Emasculator presentation=18 : "Commander," "nous" "sommes" state_number(0x00F4) "croolis-green" "dans" "ma" "Compagnie..."
        say Emasculator presentation=17 : "Tous à mes ordres, moi, Emasculator|..."
        when {
            require Emasculator.encounter_count == 1
        } then {
            say Emasculator presentation=9 : "Dites voir|, Commander|..."
            say Emasculator presentation=10 : "Otez-moi d'un doute|..."
            say Emasculator presentation=11 : "Vous seriez pas une gonzesse|, par hasard|?..."
            say Emasculator presentation=12 : "Hein|? Z'étes pas une femelle|, Commander|?..."
            say Emasculator presentation=8 chatter resume_at=emasc01_dialogue_resume_2 : "Vous étes quoi|, commander|?..." choices "màle" "femelle" "gonzesse" "vraie_gonzesse"
            when {
                require choice == "màle"
            } then {
                say Emasculator presentation=13 : "Ouf|! Eu peur|! Parait que des espionnes grouillent|..."
                say Emasculator presentation=8 chatter if_not_shown skip_next=1 : "peut-étre|, mais c'est pas le commander|..."
                choice = none
            }
            when {
                require choice != "màle"
            } then {
                say Emasculator presentation=14 : "QUUUUOAAA|?!! Co|... Co|... COMMENT|?..."
                say Emasculator presentation=8 chatter : "comment|... deur|?..."
                say Emasculator presentation=15 : "Commander|! Méme vous alors|?..."
                say Emasculator presentation=8 chatter : "Pas commander|... Commandeuse|!..."
                say Emasculator presentation=16 : "Ptain|! On est envahi alors|!?..."
                say Emasculator presentation=8 chatter : "commander|, c'est vous la femelle dont il faut se méfier|?..."
                say Emasculator presentation=17 : "Avant les jeux vidéo|, c'était peinard|, on était qu'entre mecs|..."
                say Emasculator presentation=8 chatter : "eh ouais|, c'est fini tout ca|..."
                say Emasculator presentation=8 chatter : "bon|... on reprend|?..."
                say Emasculator presentation=12 if_not_shown skip_next=1 : "Allez|... On y va|... Organisons la résistance des màles|..."
                dictionary blank after "Organisons"
                choice = none
            }
        }
        emasc01_dialogue_resume_2:
        when {
            require Emasculator.encounter_count == 1
            require atomique.holder != aboard
        } then {
            say Emasculator presentation=9 : "Si vous voulez, Commander, de vous à moi..."
            say Emasculator presentation=8 chatter : "Il a des choses à nous dire, la boule de nerfs?"
            say Emasculator presentation=11 : "Nous Croolis fabriquons une petite invention trés sympa..."
            say Emasculator presentation=8 chatter : "Va-s-y, Bouboule, crache le morceau!"
            say Emasculator presentation=13 : "Une toute petite invention... Pratique..."
            say Emasculator presentation=12 : "Comme le pignon double pour vélo..."
            say Emasculator presentation=8 chatter : "T'accouches, gros lard?"
            say Emasculator presentation=15 : "Nous fabriquons des atomiques..."
            say Emasculator presentation=8 chatter : "QUOI?!?!?"
            say Emasculator presentation=17 : "Des atomiques... A vendre... A vous, Commander..."
            say Emasculator presentation=8 chatter : "Combien le prix?"
            say Emasculator presentation=16 : "Pas cher pour vous, une misére, atomique trés dangereux pour trois..."
            say Emasculator presentation=8 chatter : "Trois crédits?"
            say Emasculator presentation=14 : "Non, trois fois rien..."
            say Emasculator presentation=8 chatter : "Combien, bon sang?"
            say Emasculator presentation=12 : "Dix crédits... Une misére..."
        }
        when {
            require Emasculator.encounter_count == 2
        } then {
            say Emasculator presentation=9 : "Ouais|!... Ouais|!..."
            say Emasculator presentation=12 : "Ah ah|! C'est moi le meilleur|! Ah|! Ah|!..."
            say Emasculator presentation=18 : "Oui c'est moi|! Ah ah ah|!..."
            say Emasculator presentation=16 : "Regardez Commander|! Ma danse de reproduction|!..."
