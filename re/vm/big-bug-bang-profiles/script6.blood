        } then {
            say Rotator presentation=9 : "Ah merci, ça va mieux"
            say Rotator presentation=10 : "Je croyais que j'allais rester con comme un Crooli toute ma vie..."
            say Rotator presentation=8 chatter : "Incroyable! Vous l'avez guéri de sa tare!"
            say Rotator presentation=11 : "Ca m'a bien nettoyé les boyaux d'la téte, vot'truc!"
            say Rotator presentation=8 chatter : "On croirait entendre son pére le Général"
            say Rotator presentation=14 : "Aga... A papa le Général... A mon papa..."
            say Rotator presentation=8 chatter if_not_shown skip_next=3 : "Pas fait effet trés longtemps, le médoc. Enfin, c'est mieux que rien."
            state_b6[Rotator.evolution] += 50
            state_b1[Rotator.population] += 200
            bits(medicament.flags,0x0040) = false
        }
        when {
            require bits(armes.flags,0x0040)
        } then {
            say Rotator presentation=14 : "Aqueu Gachette..."
            say Rotator presentation=8 chatter if_not_shown skip_next=4 : "Ah quel gachis!"
            Rotator.aggressiveness += 250
            state_b6[Rotator.evolution] += 50
            globals.B36 = 1
            bits(armes.flags,0x0040) = false
        }
        when {
            require bits(optique.flags,0x0040)
        } then {
            say Rotator presentation=13 : "Moi pas myope"
            say Rotator presentation=8 chatter if_not_shown skip_next=3 : "Lui pas cerveau non plus|, Commander..."
            state_b6[Rotator.evolution] += 50
            globals.B35 += 1
            bits(optique.flags,0x0040) = false
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Rotator presentation=9 if_not_shown skip_next=2 : "Ca faire bien par où ça passe..."
            state_b5[Rotator.energy] = 1000
            bits(energie.flags,0x0040) = false
        }
        when {
            require bits(bague.flags,0x0040)
        } then {
            say Rotator presentation=9 : "Moi pas besoin bac, études servir à rien"
            say Rotator presentation=8 chatter if_not_shown skip_next=5 : "Il a raison, Commander. Pour lui, étre trop tard"
            state_b6[Rotator.evolution] += 50
            state_b1[Rotator.population] += 200
            globals.B37 += 1
            Rotator.aggressiveness -= 200
            bits(bague.flags,0x0040) = false
        }
        when {
            require bits(emetteur.flags,0x0040)
        } then {
            say Rotator presentation=9 if_not_shown skip_next=2 : "Un emetteur"
            state_b6[Rotator.evolution] += 5
            bits(emetteur.flags,0x0040) = false
        }
        when {
            require bits(culture.flags,0x0040)
        } then {
            say Rotator presentation=9 : "Pan! Pan!"
            say Rotator presentation=8 chatter : "Attention, Commander!"
            say Rotator presentation=8 chatter if_not_shown skip_next=3 : "Quand il entend le mot culture, il sort son revolver!"
            state_b6[Rotator.evolution] += 100
            state_b5[Rotator.energy] += 100
            bits(culture.flags,0x0040) = false
            when {
                require globals.A100 == 6
                require globals.A93 == 0
            } then {
                say Rotator presentation=8 if_not_shown skip_next=2 : "..."
                globals.A93 = 1
                end presentation Rotator
            }
        }
        when {
            require bits(ecriture.flags,0x0040)
        } then {
            say Rotator presentation=15 : "Ah pourquoi faire?"
            say Rotator presentation=8 chatter if_not_shown skip_next=2 : "Ah pour écrire au fan club de Stallone, par exemple..."
            state_b6[Rotator.evolution] += 60
            bits(ecriture.flags,0x0040) = false
            when {
                require globals.A100 == 6
                require globals.A93 == 0
            } then {
                say Rotator presentation=8 if_not_shown skip_next=2 : "..."
                globals.A93 = 1
                end presentation Rotator
            }
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Rotator presentation=9 : "Non merci... trop compiqué..."
            say Rotator presentation=8 chatter : "Compliqué!"
            say Rotator presentation=10 : "Ne vous moquez pas de moi, je ne dispose pas de votre richesse de vocabulaire..."
            say Rotator presentation=8 chatter : "Mais à la fin, il sait causer ou pas?"
            say Rotator presentation=11 if_not_shown skip_next=3 : "Toi pas t'énerver, moi illettré"
            state_b6[Rotator.evolution] += 60
            globals.B35 += 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Rotator presentation=8 chatter if_not_shown skip_next=5 : "Laissez tomber! Il pourra pas le lire..."
            state_b6[Rotator.evolution] += 80
            globals.B36 = 0
            Rotator.aggressiveness = 0
            state_b1[Rotator.population] += 500
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Rotator presentation=9 : "KA... DO... KA... DO..."
            say Rotator presentation=8 chatter if_not_shown skip_next=3 : "Ouais, ben ta téte à toi, pas cadeau, ca, hein"
            state_b6[Rotator.evolution] += 10
            state_b5[Rotator.energy] += 100
            bits(cadeaux.flags,0x0040) = false
        }
        say Rotator presentation=8 chatter : "Quel objet désirez-vous lui donner, Commander?"
        say Rotator presentation=8 chatter resume_at=gest02_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Rotator presentation=8 : "..."
        gest02_dialogue_resume_1:
        say Rotator presentation=8 chatter : "A BIENTOT, COMMANDER..."
        say Rotator presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Rotator
        halt
    }
}
