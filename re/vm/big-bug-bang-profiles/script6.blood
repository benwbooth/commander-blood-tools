    proc gest01 enabled {
        during travel
        require presentation == Emasculator
    } then {
        when {
            require bits(atomique.flags,0x0040)
        } then {
            say Emasculator presentation=11 if_not_shown skip_next=3 : "Ha! Ha! Ha! Trés drole, Commander..."
            globals.B96 += 1
            atomique.holder = aboard
            bits(atomique.flags,0x0040) = false
        }
        when {
            require bits(image.flags,0x0040)
        } then {
            say Emasculator presentation=10 : "Sauf vot'respect, Commander, c't'une horreur!"
            say Emasculator presentation=8 chatter if_not_shown skip_next=4 : "Il a pas aimé, je crois. Il a du voir sa tronche..."
            state_b1[Emasculator.population] -= 100
            Emasculator.aggressiveness += 100
            globals.B37 = 0
            bits(image.flags,0x0040) = false
        }
        when {
            require bits(couronne.flags,0x0040)
        } then {
            say Emasculator presentation=9 : "Merci Commander! Enfin 'vais pouvoir tout péter!..."
            dictionary blank after "'vais"
            say Emasculator presentation=8 chatter if_not_shown skip_next=6 : "A∩e A∩e A∩e... Tirons-nous vite d'ici!"
            state_b5[Emasculator.energy] += 200
            Emasculator.aggressiveness += 200
            state_b6[Emasculator.evolution] += 50
            globals.B36 = 1
            globals.B35 = 1
            bits(couronne.flags,0x0040) = false
        }
        when {
            require bits(tableau.flags,0x0040)
        } then {
            say Emasculator presentation=13 : "Ouarf! Ouarf! De l'art! Chuis pas Van Gogh, Commander!"
            say Emasculator presentation=8 chatter if_not_shown skip_next=2 : "Lui c'est plutot l'art brut, hein?"
            Emasculator.aggressiveness += 100
            state_b6[Emasculator.evolution] += 50
            bits(tableau.flags,0x0040) = false
        }
        when {
            require bits(momie.flags,0x0040)
        } then {
            say Emasculator presentation=12 : "C'est toute ma jeunesse, ça..."
            say Emasculator presentation=13 : "Ca m'rappelle quand on giclait du Gluxx au napalm!"
            say Emasculator presentation=8 chatter if_not_shown skip_next=2 : "O souvenirs... Il a l'air d'apprécier... Par contre, sa femelle..."
            globals.B37 = 0
            bits(momie.flags,0x0040) = false
        }
        when {
            require bits(bionium.flags,0x0040)
        } then {
            say Emasculator presentation=14 : "Du Bionium... Sauf vot'respect, ça c'est Biiip..., Commander!"
            say Emasculator presentation=8 chatter if_not_shown skip_next=5 : "L'excitez pas trop quand méme, il va faire exploser la natalité!"
            dictionary blank after "exploser"
            state_b1[Emasculator.population] += 150
            state_b6[Emasculator.evolution] += 50
            state_b5[Emasculator.energy] += 200
            globals.vbio -= 1
            bits(bionium.flags,0x0040) = false
        }
        when {
            require bits(technologie.flags,0x0040)
        } then {
            when {
                require globals.A100 > 4
            } then {
                say Emasculator presentation=8 if_not_shown skip_next=1 : "Argh|!... De la mort|..."
                request sequence "maledict.hnm"
                say Emasculator presentation=8 chatter : "Science sans conscience|... ça lui ruine l'àme, commander|!..."
                say Emasculator presentation=8 if_not_shown skip_next=2 : "..."
                globals.A93 = 1
                end presentation Emasculator
            }
            say Emasculator presentation=9 : "De la Tokologie... Mon réve de gosse... Sacré nom de..."
            say Emasculator presentation=8 chatter : "Pas de blasphéme, grosse brute!"
            say Emasculator presentation=11 if_not_shown skip_next=4 : "Ah! Tokologie! Des bidules qui tuent, des trucs en fer, des secrets de la mort!"
            state_b6[Emasculator.evolution] += 100
            state_b5[Emasculator.energy] += 100
            globals.B35 = 1
            bits(technologie.flags,0x0040) = false
        }
        when {
            require bits(guitare.flags,0x0040)
        } then {
            say Emasculator presentation=13 : "Quoi? J'ai une téte de rocker, c'est ça?"
            say Emasculator presentation=8 chatter : "Vous l'insultez, Commander..."
            say Emasculator presentation=12 : "J'vous respecte, hein, mon Commander..."
            say Emasculator presentation=13 : "... Mais sauf vot'respect, moi les rockers je les brise!"
            say Emasculator presentation=8 chatter : "C'est vrai qu'il nous les brise..."
            say Emasculator presentation=8 chatter if_not_shown skip_next=6 : "Les guitares..."
            globals.B37 += 1
            state_b1[Emasculator.population] += 250
            Emasculator.aggressiveness -= 200
            state_b6[Emasculator.evolution] += 50
            globals.B36 = 0
            bits(guitare.flags,0x0040) = false
        }
        when {
            require bits(credit.flags,0x0040)
        } then {
            say Emasculator presentation=9 : "Du pognon! On va te gonfler le budget Défense, vous allez voir ca!"
            say Emasculator presentation=8 chatter if_not_shown skip_next=2 : "Dites donc, Commander, vous étes complétement givré..."
            state_b5[Emasculator.energy] += 50
            bits(credit.flags,0x0040) = false
        }
        when {
            require bits(parfum.flags,0x0040)
        } then {
            say Emasculator presentation=8 chatter : "C'est vrai que les militaires ça pue..."
            say Emasculator presentation=10 : "De quoi? De quoi? Qu'est-ce qu'elle cause, la ferraille?"
            say Emasculator presentation=8 chatter : "Rien, rien."
            say Emasculator presentation=11 : "Bon. Merci pour le parfum, Commander..."
            say Emasculator presentation=12 : "Croocroo Chamel, trés bien au fond des godillots..."
            say Emasculator presentation=8 chatter if_not_shown skip_next=5 : "J'vous dis qu'ça pue les militaires..."
            state_b6[Emasculator.evolution] += 50
            state_b1[Emasculator.population] += 250
            globals.B37 += 1
            Emasculator.aggressiveness -= 100
            bits(parfum.flags,0x0040) = false
        }
        when {
            require bits(decodeur.flags,0x0040)
        } then {
            say Emasculator presentation=8 chatter : "Il va pouvoir regarder Rambo sur Télé Nostalgie..."
            say Emasculator presentation=9 : "Z'auriez pas un Gnotoscope avec?"
            say Emasculator presentation=10 if_not_shown skip_next=4 : "Pour me r'passer au ralenti tout'les'splosions! BOOOOOOUM!"
            state_b6[Emasculator.evolution] += 100
            state_b1[Emasculator.population] /= 2
            globals.B37 -= 1
            bits(decodeur.flags,0x0040) = false
        }
        when {
            require bits(nourriture.flags,0x0040)
        } then {
            say Emasculator presentation=15 : "Des rations de combat! Miam miam, y a méme du rata de migrax..."
            say Emasculator presentation=12 if_not_shown skip_next=2 : "J'vais m'faire péter le bide... BOOOOOUM!"
            state_b5[Emasculator.energy] += 400
            bits(nourriture.flags,0x0040) = false
        }
        when {
            require bits(medicament.flags,0x0040)
        } then {
            say Emasculator presentation=9 : "Des médocs... Important, ça, en campagne."
            say Emasculator presentation=8 chatter if_not_shown skip_next=3 : "Il pense vraiment qu'à la guerre ce taré."
            state_b6[Emasculator.evolution] += 50
            state_b1[Emasculator.population] += 250
            bits(medicament.flags,0x0040) = false
        }
        when {
            require bits(armes.flags,0x0040)
        } then {
            say Emasculator presentation=14 : "DES ARMES..."
            say Emasculator presentation=8 chatter : "Commander! Il va jouir! Ecartez-vous!"
            say Emasculator presentation=10 : "DES ARMES!... Ca tombe au poil, on en manquait justement"
            say Emasculator presentation=8 chatter if_not_shown skip_next=4 : "Tu parles!"
            Emasculator.aggressiveness += 250
            state_b6[Emasculator.evolution] += 50
            globals.B36 = 1
            bits(armes.flags,0x0040) = false
        }
        when {
