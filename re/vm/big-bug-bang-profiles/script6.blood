                say Emasculator presentation=8 chatter : "Ca le tue, commander|!..."
                say Emasculator presentation=8 if_not_shown skip_next=2 : "..."
                end presentation Emasculator
                globals.A93 = 1
            }
            say Emasculator presentation=16 : "De la criture! Pouah! C'est bon pour les bonnes femmes, ca!"
            say Emasculator presentation=8 chatter : "Mais non, George Sand, tu vas voir, c'est un vrai truc de mec."
            say Emasculator presentation=15 : "On peut criturer des insultes?"
