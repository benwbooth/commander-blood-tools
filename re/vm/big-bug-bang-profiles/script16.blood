        } then {
            say Inter_Paul presentation=8 chatter if_not_shown skip_next=2 : "..."
            state_b6[Inter_Paul.evolution] += 50
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Inter_Paul presentation=9 if_not_shown skip_next=3 : "Un VAISSEAU..."
            state_b6[Inter_Paul.evolution] += 10
            globals.B59 += 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Inter_Paul presentation=8 chatter if_not_shown skip_next=4 : "..."
            globals.B60 = 0
            Inter_Paul.aggressiveness = 0
            state_b1[Inter_Paul.population] += 200
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Inter_Paul presentation=9 if_not_shown skip_next=3 : "Des cadeaux..."
            state_b6[Inter_Paul.evolution] += 10
            state_b5[Inter_Paul.energy] += 10
            bits(cadeaux.flags,0x0040) = false
        }
        say Inter_Paul presentation=8 chatter : "Quel objet désirez-vous lui donner, Commander?"
        say Inter_Paul presentation=8 chatter resume_at=gest03_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Inter_Paul presentation=8 : "..."
        gest03_dialogue_resume_1:
        say Inter_Paul presentation=8 chatter : "A BIENTOT, COMMANDER..."
        say Inter_Paul presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Inter_Paul
        halt
    }
}
