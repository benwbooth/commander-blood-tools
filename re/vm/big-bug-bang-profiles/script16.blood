    proc sp01 enabled {
        require presentation == Sebasto_Paul
    } then {
        say Sebasto_Paul presentation=9 : "Moi Sebasto Paul, moi Tubular Brain..."
        text_tokens Sebasto_Paul presentation=11 : "Nous" "étre" state_number(0x054A) "Tubular" "Brain" "ici..."
        when {
            require state_b6[Sebasto_Paul.evolution] > 100
            require culture.holder != aboard
        } then {
            say Sebasto_Paul presentation=12 : "Ah esprit culture..."
            say Sebasto_Paul presentation=15 : "Nous vendre à toi culture contre crédit..."
            when {
                require globals.A4 == 0
            } then {
                say Sebasto_Paul presentation=8 chatter : "Nous n'avons plus de credits, Commander..."
                dictionary blank after "credits,"
            }
            when {
                require globals.A4 > 0
            } then {
                say Sebasto_Paul presentation=8 chatter resume_at=gest02 : "Vous acceptez de leur acheter de la culture, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Sebasto_Paul presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un credit, Commander"
                    transfer credit from aboard to Sebasto_Paul
                    globals.A4 -= 1
                    say Sebasto_Paul presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION CULTURE DANS CRYOBOX"
                    transfer ecriture from Sebasto_Paul to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
