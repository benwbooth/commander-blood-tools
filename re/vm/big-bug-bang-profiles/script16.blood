    proc teltub enabled {
        require globals.A93 == 1
        during bridge
        require presentation == Mega_Paul
    } then {
        say Mega_Paul presentation=8 : "krouik|..."
        say Mega_Paul presentation=8 : "Ici Mega Paul|... TUBULAR BRAIN|..."
        say Mega_Paul presentation=8 : "Votre voyant prés de chez vous|..."
        say Mega_Paul presentation=8 chatter : "Ca a marché|? on les a eus les croolis verts|?..."
        say Mega_Paul presentation=8 : "Hum|... Justement|... Léger petit probléme|..."
        say Mega_Paul presentation=8 chatter : "quoi|? quoi|?..."
        say Mega_Paul presentation=8 : "Votre tentative ne les a pas tués|... Par contre ils ont muté|..."
        say Mega_Paul presentation=8 chatter : "muté|?..."
        say Mega_Paul presentation=8 : "Ils sont devenus rouges|..."
        say Mega_Paul presentation=8 : "krouik|..."
        say Mega_Paul presentation=8 chatter : "bizarre, commander|..."
        say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
        globals.C11 = 1
        end presentation Mega_Paul
    }
    proc mp01 enabled {
        during travel
        require presentation == Mega_Paul
    } then {
        when {
            require globals.A100 == 2
        } then {
            say Mega_Paul presentation=8 : "pas étre..."
            say Mega_Paul presentation=8 chatter if_not_shown skip_next=1 : "..."
            globals.A100 = 1
        }
        when {
            require globals.A100 == 1
        } then {
            say Mega_Paul presentation=9 : "Processus code question ontologique|... Attention|..."
            say Mega_Paul presentation=8 if_not_shown skip_next=1 : "ETRE|..."
            transfer energie from Mega_Paul to aboard
            say Mega_Paul presentation=8 if_not_shown skip_next=1 : "OU NE PAS ETRE|..."
            request sequence "momi10.hnm"
            say Mega_Paul presentation=10 : "Telle est la question|..."
            say Mega_Paul presentation=8 chatter resume_at=mp01_dialogue_resume_1 : "..." choices "étre" "ou" "ne_pas_étre"
            when {
                require choice == "étre"
            } then {
                say Mega_Paul presentation=8 if_not_shown skip_next=3 : "..."
                globals.A100 = 2
                end presentation Mega_Paul
                choice = none
            }
            when {
                require choice == "ou"
            } then {
                say Mega_Paul presentation=12 : "Bien répondu|! La vie est dans l'alternative|..."
                say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
                globals.A100 = 3
                choice = none
            }
            when {
                require choice == "ne_pas_étre"
            } then {
                say Mega_Paul presentation=13 : "C'est un choix de vie comme un autre|..."
                say Mega_Paul presentation=8 if_not_shown skip_next=1 : "Mais c'est surtout un choix de mort|..."
                request sequence "maledict.hnm"
                say Mega_Paul presentation=8 if_not_shown skip_next=3 : "..."
                globals.A13 = 1
                end presentation Mega_Paul
                choice = none
            }
        }
        mp01_dialogue_resume_1:
        when {
            require globals.A100 == 3
        } then {
            say Mega_Paul presentation=9 : "BLABLABLA..."
            say Mega_Paul presentation=11 : "BLABLABLA..."
            say Mega_Paul presentation=13 : "BLABLA BLI..."
            say Mega_Paul presentation=15 : "BLABLA BLIBLI..."
            say Mega_Paul presentation=17 : "BLA BLA BLA BLA BLA..."
            say Mega_Paul presentation=18 : "..."
            say Mega_Paul presentation=19 : "..."
            say Mega_Paul presentation=24 : "N'oubliez pas..."
            say Mega_Paul presentation=25 if_not_shown skip_next=1 : "LE SILENCE EST L'ETUI DE LA VERITE..."
            globals.A100 = 4
        }
        when {
            require globals.A100 == 4
        } then {
            say Mega_Paul presentation=20 : "Voyons si vous avez suivi|..."
            say Mega_Paul presentation=21 : "Qui a dit|: le silence est l'étui de la vérité|?..."
            say Mega_Paul presentation=8 chatter resume_at=mp01_dialogue_resume_2 : "..." choices "Trump" "Tequila" "Daddy_Gluxx" "Izwalito" "Mamy_Gluxx" "Yolk" "Kero_Zen" "autre"
            when {
                require choice != "autre"
            } then {
                say Mega_Paul presentation=24 : "Erreur|! Mémoire et attention sont les deux mamelles du cerveau|..."
                say Mega_Paul presentation=8 chatter : "aie|!..."
                say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
                end presentation Mega_Paul
                choice = none
            }
            when {
                require choice == "autre"
            } then {
                say Mega_Paul presentation=21 : "Qui d'autre|?..."
                say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
                globals.A100 = 4
                choice = none
            }
        }
        mp01_dialogue_resume_2:
        when {
            require globals.A100 == 4
        } then {
            say Mega_Paul presentation=8 chatter resume_at=mp01_dialogue_resume_3 : "..." choices "Super_Tromp" "Marakas" "René_Char" "Super_Zen" "autre"
            dictionary blank after "Super_Tromp"
            when {
                require choice == "Super_Tromp"
            } then {
                say Mega_Paul presentation=21 : "Erreur|, Commander|! Vous vous étes super trompé|!..."
                say Mega_Paul presentation=19 : "Revenez quand vous saurez|!..."
                say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
                end presentation Mega_Paul
                choice = none
            }
            when {
                require choice == "Marakas"
            } then {
                say Mega_Paul presentation=21 : "Eh non|! Marakas lit Platon|! Pas la poésie|!..."
                say Mega_Paul presentation=20 : "Revenez quand vous vous souviendrez|..."
                say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
                end presentation Mega_Paul
                choice = none
            }
            when {
                require choice == "René_Char"
            } then {
                say Mega_Paul presentation=22 : "Bravo|! Quelle culture|! Incroyable|! Le hasard, peut-étre|?..."
                say Mega_Paul presentation=8 chatter : "mais non|! le commander est trés fort|!..."
                say Mega_Paul presentation=21 if_not_shown skip_next=2 : "Vous étes prof de lettres, Commander|?..."
                globals.A100 = 5
                choice = none
            }
            when {
                require choice == "Super_Zen"
            } then {
                say Mega_Paul presentation=22 : "Brillant|! Commander, vous avez les qualités d'un grand scénariste|!..."
                say Mega_Paul presentation=8 chatter if_not_shown skip_next=2 : "bravo commander|!..."
                globals.A100 = 5
                choice = none
            }
            when {
                require choice == "autre"
            } then {
                say Mega_Paul presentation=21 : "Ah bon|! Alors revenez quand vous saurez qui c'est|..."
                say Mega_Paul presentation=8 chatter : "au travail, commander|..."
                say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
                end presentation Mega_Paul
                choice = none
            }
        }
        mp01_dialogue_resume_3:
        when {
            require globals.A100 == 5
        } then {
            say Mega_Paul presentation=17 : "Vous avez bonne mémoire|... Vous voyez le passé|..."
            say Mega_Paul presentation=18 : "La voyance n'a pas de secrets pour moi|..."
            say Mega_Paul presentation=19 : "Super Zen mon maitre, paix à son àme|... m'a enseigné les secrets|..."
            say Mega_Paul presentation=8 if_not_shown skip_next=1 : "...DE LA VOYANCE|... FUTUR, PASSE, PRESENT|..."
            request sequence "kort.hnm"
            say Mega_Paul presentation=20 : "Vous pouvez me consulter quand bon vous semblera|..."
            say Mega_Paul presentation=21 : "... pour assurer l'avenir de votre scénario|..."
            say Mega_Paul presentation=8 chatter : "vous avez rien contre les gréves|?..."
            say Mega_Paul presentation=22 : "Bien sùr que si|... La ruse|..."
            say Mega_Paul presentation=8 chatter : "pas la force|?..."
            say Mega_Paul presentation=23 : "Aussi|... s'il le faut|..."
            say Mega_Paul presentation=24 : "Il faut détruire la race qui empéche la paix sociale|..."
            say Mega_Paul presentation=8 if_not_shown skip_next=1 : "J'ai nommé LES CROOLIS VERTS|!..."
            request sequence "match07.hnm"
            say Mega_Paul presentation=25 : "Mais la force est inutile contre eux..."
            say Mega_Paul presentation=8 chatter : "alors on va ruser|..."
            say Mega_Paul presentation=17 : "Oui|... Il y a un objet qui les détruira à coup sùr|..."
            say Mega_Paul presentation=8 chatter : "lequel|? lequel|?..."
            say Mega_Paul presentation=18 : "Trois doses de bionium sont nécessaires pour le voir|..."
        }
        when {
            require globals.A100 == 5
            require globals.vbio > 2
        } then {
            say Mega_Paul presentation=8 chatter : "on a le bionium, votre sérénité|..."
            say Mega_Paul presentation=22 : "Disposez de moi, Commander|..."
            say Mega_Paul presentation=8 chatter resume_at=tub2 : "On lui donne le bionium, commander|?..." choices "oui"
            when {
                require choice == "oui"
            } then {
                say Mega_Paul presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION BIONIUM VOYANCE|!..."
                transfer bionium from aboard to Mega_Paul
                globals.vbio -= 3
                say Mega_Paul presentation=21 : "Galgalagologoulou|... GLOU|!..."
                say Mega_Paul presentation=8 if_not_shown skip_next=1 : "VOYANCE ET PREVOYANCE|..."
                request sequence "kort.hnm"
                say Mega_Paul presentation=22 : "Le voyant dit|: Science sans conscience n'est que ruine des CROOLIS VERTS|..."
                say Mega_Paul presentation=8 chatter : "quoi|? c'est ça votre voyance|?..."
                say Mega_Paul presentation=17 : "Ca veut dire ce que ça veut dire|... Ils ne supportent pas la connaissance|..."
                say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
                globals.A100 = 6
                end presentation Mega_Paul
            }
            when {
                require globals.A100 == 5
                require globals.vbio < 3
            } then {
                end presentation Mega_Paul
            }
        }
    }
    proc tub2 enabled {
        during travel
        require presentation == Mega_Paul
    } then {
        when {
            require globals.B88 == 0
            require globals.A94 > 0
        } then {
            say Mega_Paul presentation=15 : "Navré cher Commander pour ce petit contretemps|..."
            say Mega_Paul presentation=8 chatter : "tu parles|! tu peux étre navré|!..."
            say Mega_Paul presentation=17 : "Entre voyance et prévoyance reste une petite nuance|..."
            say Mega_Paul presentation=8 chatter : "petite comme une guerre|... maintenant on a chigraxx qui est furaxx|!..."
            say Mega_Paul presentation=18 : "Reste une solution|... radicale|..."
            say Mega_Paul presentation=8 chatter : "quoi|? encore une extermination|?..."
            say Mega_Paul presentation=19 : "Pas vraiment|... Mais pour un retour à l'ordre|... Rien de mieux que|..."
            say Mega_Paul presentation=8 if_not_shown skip_next=1 : "LES SCRUTERS|!..."
            request sequence "legion01.hnm"
            say Mega_Paul presentation=8 if_not_shown skip_next=1 : "NA NA NA NA NA REU|!..."
            request sequence "pscrt01.hnm"
            say Mega_Paul presentation=21 : "Yerk|! Une interférence|!..."
            say Mega_Paul presentation=22 : "Je vous cybersynthétise les scruters, Commander|..."
            say Mega_Paul presentation=8 if_not_shown skip_next=1 : "ABRACANADADRA YEU NACANADADRA SCREU|!..."
            request sequence "kort.hnm"
            say Mega_Paul presentation=23 : "Voilà|!..."
            say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Mega_Paul
            globals.B88 = 1
        }
        say Mega_Paul presentation=9 : "Moi Mega Paul, moi Tubular Brain..."
        text_tokens Mega_Paul presentation=11 : "Nous" state_number(0x0500) "Tubular" "Brain" "ici..."
        when {
            require state_b6[Mega_Paul.evolution] > 100
            require ecriture.holder != aboard
        } then {
            say Mega_Paul presentation=12 : "Ah esprit|... écriture..."
            say Mega_Paul presentation=15 : "Nous t'offrons l'écriture... pour un crédit..."
            when {
                require globals.A4 == 0
            } then {
                say Mega_Paul presentation=8 chatter : "Nous n'avons plus de crédits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Mega_Paul presentation=8 chatter resume_at=gest01 : "Vous acceptez de leur acheter de l'écriture, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Mega_Paul presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Mega_Paul
                    globals.A4 -= 1
                    say Mega_Paul presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION ECRITURE DANS CRYOBOX"
                    transfer ecriture from Mega_Paul to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc gest01 enabled {
        during travel
        require presentation == Mega_Paul
    } then {
        when {
            require bits(atomique.flags,0x0040)
        } then {
            when {
                require state_b6[Mega_Paul.evolution] < 100
            } then {
                globals.A13 = 1
            }
            when {
                require state_b6[Mega_Paul.evolution] < 500
                require state_b6[Mega_Paul.evolution] > 100
            } then {
                say Mega_Paul presentation=10 if_not_shown skip_next=4 : "Oh! des atomiques... intéressant... Merci Commander..."
                state_b1[Mega_Paul.population] /= 2
                Mega_Paul.aggressiveness += 50
                globals.B61 -= 1
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Mega_Paul.evolution] > 500
            } then {
                say Mega_Paul presentation=10 if_not_shown skip_next=3 : "De l'énergie nucléaire... Merci!!!"
                state_b6[Mega_Paul.evolution] += 20
                state_b5[Mega_Paul.energy] += 100
                bits(atomique.flags,0x0040) = false
            }
        }
        when {
            require bits(image.flags,0x0040)
        } then {
            say Mega_Paul presentation=8 chatter if_not_shown skip_next=3 : "..."
            state_b1[Mega_Paul.population] /= 4
            state_b5[Mega_Paul.energy] += 10
            bits(image.flags,0x0040) = false
        }
        when {
            require bits(couronne.flags,0x0040)
        } then {
            say Mega_Paul presentation=9 if_not_shown skip_next=4 : "..."
            state_b5[Mega_Paul.energy] += 20
            Mega_Paul.aggressiveness += 200
            globals.B60 = 1
            bits(couronne.flags,0x0040) = false
        }
        when {
            require bits(tableau.flags,0x0040)
        } then {
            say Mega_Paul presentation=8 chatter if_not_shown skip_next=2 : "..."
            state_b6[Mega_Paul.evolution] += 5
            bits(tableau.flags,0x0040) = false
        }
        when {
            require bits(momie.flags,0x0040)
        } then {
            say Mega_Paul presentation=8 if_not_shown skip_next=2 : "..."
            globals.B61 -= 1
            bits(momie.flags,0x0040) = false
        }
        when {
            require bits(bionium.flags,0x0040)
        } then {
            say Mega_Paul presentation=9 if_not_shown skip_next=4 : "Du Bionium..."
            state_b1[Mega_Paul.population] += 100
