    proc _1fincro as "1fincro" enabled {
        during contact
        require globals.A68 == 2
        require Eviscerator.current_location == aboard
        require presentation == Eviscerator
    } then {
        say Eviscerator presentation=10 : "Ouais|!..."
        say Eviscerator presentation=11 : "Le roi|!..."
        say Eviscerator presentation=12 : "Je suis le roi de la batterie|!..."
        say Eviscerator presentation=13 : "Des abattoirs aussi|!..."
        say Eviscerator presentation=14 : "Arf arf|!..."
        say Eviscerator presentation=15 : "Tu te rends compte|, Commander|?..."
        say Eviscerator presentation=16 : "Moi a la batterie pour Tina|!..."
        say Eviscerator presentation=8 if_not_shown skip_next=3 : "..."
        globals.A13 += 3
        end presentation Eviscerator
        sequence_slots[4] = "12concrool"
    }
    proc braque enabled {
        during bridge
        require globals.C11 == 1
        require presentation == Eviscerator
    } then {
        say Eviscerator presentation=8 : "krouik|..."
        say Eviscerator presentation=8 : "Au secours|! Commander|! Au secours|!..."
        say Eviscerator presentation=8 : "Ici Eviscerator|!... Au secours|!..."
        say Eviscerator presentation=8 chatter : "eviscerator a un probléme, commander|..."
        say Eviscerator presentation=8 : "Au sec|... ourg|..."
        say Eviscerator presentation=8 if_not_shown skip_next=2 : "..."
        globals.C11 = 2
        end presentation Eviscerator
    }
    proc bigki enabled {
        during bridge
        require globals.C11 == 8
        require presentation == Eviscerator
    } then {
        say Eviscerator presentation=8 : "krouik..."
        say Eviscerator presentation=8 : "Commander|! Ici Eviscerator, Crooli rouge|..."
        say Eviscerator presentation=8 chatter : "rouge|? on n'a pas la couleur sur le téléphone|..."
        say Eviscerator presentation=8 : "Eh ben chuis rouge|! Chuis tout rouge du sang des croolis verts|!..."
        say Eviscerator presentation=8 chatter : "leur sang n'est pas vert|?..."
        say Eviscerator presentation=8 : "Bon sang|! Alors c'est moi qui saigne, Commander|!..."
        say Eviscerator presentation=8 : "En tout cas, mission réussie|! Je les ai détruits|!..."
        say Eviscerator presentation=8 : "Ils vous embéteront plus|!..."
        say Eviscerator presentation=8 chatter : "merci mon brave|!..."
        say Eviscerator presentation=8 : "De rien|! Je rentre me laver|!..."
        dictionary blank after "laver"
        say Eviscerator presentation=8 : "krouik|..."
        say Eviscerator presentation=8 chatter : "une bonne chose de faite, commander|!..."
        say Eviscerator presentation=8 if_not_shown skip_next=2 : "..."
        globals.C11 = 9
        end presentation Eviscerator
    }
    proc jail enabled {
        during contact
        require globals.A64 == 0
        require presentation == Eviscerator
    } then {
        when {
            require globals.C11 == 4
        } then {
            say Eviscerator presentation=9 : "Chuis innocent|!..."
            say Eviscerator presentation=8 chatter : "bon sang, commander|! je me suis planté|! j'ai raté la téléportation en prison|!..."
            say Eviscerator presentation=10 : "Tant mieux|! Chuis innocent|! Donnez-moi une deuxiéme chance|!..."
            say Eviscerator presentation=8 chatter : "on pourrait le garder enfermé dans la cryobox|..."
            dictionary blank after "cryobox"
            say Eviscerator presentation=8 chatter resume_at=jail_dialogue_resume_1 : "ou préférez-vous le renvoyer sur une planéte|?" choices "garder" "renvoyer"
            when {
                require choice == "renvoyer"
            } then {
                say Eviscerator presentation=8 chatter if_not_shown skip_next=4 : "teleportation eviscerator hors d'ici|!..."
                bits(Eviscerator.flags,0x0004) = true
                Eviscerator.current_location = Island
                Outrageor.current_location = Waveland
                bits(Outrageor.flags,0x0004) = true
                say Eviscerator presentation=8 if_not_shown skip_next=3 : "..."
                globals.C11 = 5
                end presentation Eviscerator
                choice = none
            }
            when {
                require choice == "garder"
            } then {
                say Eviscerator presentation=8 if_not_shown skip_next=2 : "..."
                globals.C11 = 6
                choice = none
            }
            jail_dialogue_resume_1:
            say Eviscerator presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Eviscerator
        }
        when {
            require globals.C11 == 6
        } then {
            say Eviscerator presentation=10 : "Innocent j'vous dis|!..."
            say Eviscerator presentation=8 chatter : "mais oui, mais oui|..."
            dictionary blank after "oui"
            say Eviscerator presentation=8 chatter resume_at=jail_dialogue_resume_2 : "vous voulez le liberer|, commander|?..." choices "sur_parole" "non_non"
            when {
                require choice == "sur_parole"
            } then {
                say Eviscerator presentation=8 chatter if_not_shown skip_next=1 : "on te libere sur parole|!..."
                request sequence "p_cles.hnm"
                say Eviscerator presentation=8 if_not_shown skip_next=1 : "Ouais|!..."
                request sequence "match04.hnm"
                say Eviscerator presentation=18 : "On va féter ca avec les copains|!..."
                say Eviscerator presentation=8 if_not_shown skip_next=6 : "..."
                Eviscerator.current_location = Island
                bits(Eviscerator.flags,0x0004) = true
                Outrageor.current_location = Waveland
                bits(Outrageor.flags,0x0004) = true
                globals.C11 = 5
                choice = none
            }
            when {
                require choice == "non_non"
            } then {
                say Eviscerator presentation=13 : "Non non|?..."
                say Eviscerator presentation=8 if_not_shown skip_next=1 : "Tu as perdu-perdu|! ah-ah|!...|...|...|...|... DU TEMPS|!!!"
                request sequence "crazys20.hnm"
                say Eviscerator presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
        }
        jail_dialogue_resume_2:
        say Eviscerator presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Eviscerator
    }
    proc evisc01 enabled {
        during travel
        require presentation == Eviscerator
    } then {
        when {
            require globals.C11 == 2
        } then {
            say Eviscerator presentation=8 chatter : "salut|! c'est quoi le probléme|?..."
            say Eviscerator presentation=13 : "C'est toi le probléme|!... Aboule ton fric, c'est un hold-up|!..."
            say Eviscerator presentation=8 chatter : "quoi|!? un guet-apens|!..."
            say Eviscerator presentation=14 : "Allez|! Tout le monde à terre ou je bute le premier qui bouge|!..."
            say Eviscerator presentation=15 : "Comme tout le monde en a marre de ton scénario, je me suis dit|..."
            say Eviscerator presentation=16 : "Que personne verrait d'inconvénient à ce que je te plume|!..."
            say Eviscerator presentation=17 : "Ou méme que je te descende|! Ah ah ah|!..."
            say Eviscerator presentation=8 chatter : "commander, un imprévu|!..."
            say Eviscerator presentation=9 : "Allez|! vide-moi ta cryobox ou je te vide ta caboche|!..."
            say Eviscerator presentation=8 chatter resume_at=evisc01_dialogue_resume_1 : "commander, vous voulez obéir ou lutter|?..." choices "obéir" "lutter"
            when {
                require choice == "obéir"
            } then {
                say Eviscerator presentation=8 chatter if_not_shown skip_next=2 : "ok|... voilà pour vous, toute notre cryobox|..."
                globals.A4 = 0
                globals.vbio = 0
                say Eviscerator presentation=8 if_not_shown skip_next=1 : "Ouais|! Cryobox|!..."
                request sequence "match04.hnm"
                say Eviscerator presentation=14 : "Ouarf ouarf|! Merci trouillard|!... Tire-toi|!..."
                say Eviscerator presentation=8 if_not_shown skip_next=4 : "..."
                globals.C11 = 3
                globals.A13 = 2
                end presentation Eviscerator
                choice = none
            }
            when {
                require choice == "lutter"
            } then {
                say Eviscerator presentation=8 chatter : "écoute, croolard|! si tu approches ton gros lard, on te téléporte chez les ZEN|!..."
                say Eviscerator presentation=10 : "Ah non! pitié|! pas la philo|!..."
                say Eviscerator presentation=8 if_not_shown skip_next=1 : "pas la philo|!..."
                request sequence "explroug.hnm"
                say Eviscerator presentation=8 chatter : "commander, ça a marché|! on lui a fait péter les neurones|!..."
                say Eviscerator presentation=8 chatter : "En plus, son arme n'était pas chargée|!..."
                say Eviscerator presentation=8 chatter if_not_shown skip_next=1 : "t'es en état d'arrestation, racketor|!..."
                request sequence "diplom1v.hnm"
                say Eviscerator presentation=8 chatter : "je le téléporte en prison|!..."
                say Eviscerator presentation=8 chatter if_not_shown skip_next=1 : "TELEPORTATION EVISCERATOR CYBER PRISON|..."
                request sequence "venthig.hnm"
                say Eviscerator presentation=8 if_not_shown skip_next=4 : "..."
                globals.C11 = 4
                Eviscerator.current_location = aboard
                end presentation Eviscerator
                choice = none
            }
        }
        evisc01_dialogue_resume_1:
        when {
            require globals.C11 == 5
        } then {
            say Eviscerator presentation=14 : "Je veux te remercier de m'avoir libéré, Commander|!..."
            say Eviscerator presentation=8 chatter : "ok|! alors pointe ton arme ailleurs|!..."
            say Eviscerator presentation=15 : "Justement, j'allais vous proposer de me pointer chez les croolis verts|!..."
            dictionary blank after "pointer"
            say Eviscerator presentation=8 if_not_shown skip_next=1 : "...leur péter la téte|!..."
            request sequence "explroug.hnm"
            say Eviscerator presentation=16 : "Si vous me laissez faire|..."
            say Eviscerator presentation=8 if_not_shown skip_next=1 : "Je vous promets que ce sera une vraie boucherie|!..."
            request sequence "moskit20.hnm"
            say Eviscerator presentation=8 chatter resume_at=evisc01_dialogue_resume_2 : "on l'envoie nettoyer Chigraxx and co, commander|?..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say Eviscerator presentation=8 chatter : "Teleportation eviscerator commando de l'espace|!..."
                say Eviscerator presentation=8 if_not_shown skip_next=3 : "..."
                globals.C11 = 7
                end presentation Eviscerator
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Eviscerator presentation=8 chatter : "non merci, mon brave|... nous allons faire le ménage nous-mémes|..."
                say Eviscerator presentation=15 : "Je suis sur, mon brave|... Que tu vas revenir me voir pour la boucherie|..."
                say Eviscerator presentation=8 if_not_shown skip_next=3 : "..."
                globals.C11 = 1
                end presentation Eviscerator
                choice = none
            }
        }
        evisc01_dialogue_resume_2:
        when {
            require globals.A68 == 1
        } then {
            say Eviscerator presentation=9 : "...GREVE|..."
            say Eviscerator presentation=10 : "..."
            say Eviscerator presentation=11 : "...GREVE|..."
            say Eviscerator presentation=12 : "..."
            say Eviscerator presentation=13 : "...GREVE|..."
            say Eviscerator presentation=14 : "..."
            say Eviscerator presentation=15 : "...GREVE|..."
            say Eviscerator presentation=16 : "..."
            say Eviscerator presentation=17 : "...GREVE|..."
            say Eviscerator presentation=18 : "..."
            say Eviscerator presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Eviscerator
        }
        say Eviscerator presentation=9 : "Moi Eviscerator, moi grand chef de tribu|..."
        text_tokens Eviscerator presentation=11 : "Nous" "étre" state_number(0x00AA) "croolis" "rouges" "dans" "tribu..."
        when {
            require state_b6[Eviscerator.evolution] > 100
            require atomique.holder != aboard
        } then {
            say Eviscerator presentation=9 : "Nous fabriquer atomiques... En grand secret..."
            say Eviscerator presentation=15 : "Nous vendre à toi nucléaire atomique radioactif dangereux, contre 10 credits..."
            when {
                require globals.A4 < 10
            } then {
                say Eviscerator presentation=8 chatter : "Nous n'avons pas 10 credits, Commander..."
            }
            when {
                require globals.A4 > 10
            } then {
                say Eviscerator presentation=8 chatter resume_at=gest01 : "Vous acceptez de leur acheter des armes, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Eviscerator presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie dix credits, Commander"
                    transfer credit from aboard to Eviscerator
                    globals.A4 -= 10
                    say Eviscerator presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION ATOMIQUE DANS CRYOBOX"
                    transfer atomique from Eviscerator to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc gest01 enabled {
        during travel
        require presentation == Eviscerator
    } then {
        when {
            require bits(atomique.flags,0x0040)
        } then {
            say Eviscerator presentation=14 if_not_shown skip_next=1 : "Ha! Ha! Ha! Toi drole..."
            bits(atomique.flags,0x0040) = false
        }
        when {
            require bits(image.flags,0x0040)
        } then {
            say Eviscerator presentation=8 chatter if_not_shown skip_next=4 : "..."
            state_b1[Eviscerator.population] /= 4
            Eviscerator.aggressiveness += 10
            globals.B34 = 0
            bits(image.flags,0x0040) = false
        }
        when {
            require bits(couronne.flags,0x0040)
        } then {
            say Eviscerator presentation=9 if_not_shown skip_next=5 : "..."
            state_b5[Eviscerator.energy] += 200
            Eviscerator.aggressiveness += 200
            globals.B33 = 1
            globals.B32 = 1
            bits(couronne.flags,0x0040) = false
        }
        when {
            require bits(tableau.flags,0x0040)
        } then {
            say Eviscerator presentation=8 chatter if_not_shown skip_next=2 : "..."
            Eviscerator.aggressiveness += 100
            bits(tableau.flags,0x0040) = false
        }
        when {
            require bits(momie.flags,0x0040)
        } then {
            say Eviscerator presentation=8 if_not_shown skip_next=2 : "..."
            globals.B34 = 0
            bits(momie.flags,0x0040) = false
        }
        when {
            require bits(bionium.flags,0x0040)
        } then {
            say Eviscerator presentation=9 if_not_shown skip_next=4 : "Du Bionium..."
            state_b1[Eviscerator.population] += 150
            state_b6[Eviscerator.evolution] += 100
            globals.vbio -= 1
            bits(bionium.flags,0x0040) = false
        }
        when {
            require bits(technologie.flags,0x0040)
        } then {
            say Eviscerator presentation=9 if_not_shown skip_next=4 : "De la technologie..."
            state_b6[Eviscerator.evolution] += 10
            state_b5[Eviscerator.energy] += 10
            globals.B32 = 1
            bits(technologie.flags,0x0040) = false
        }
        when {
