    }
    proc _2fincro as "2fincro" enabled {
        during contact
        require globals.A68 == 2
        require Outrageor.current_location == aboard
        require presentation == Outrageor
    } then {
        say Outrageor presentation=10 : "Yo|!..."
        say Outrageor presentation=11 : "Yo yo|!..."
        say Outrageor presentation=12 : "Yo yo yo|!..."
        say Outrageor presentation=13 : "Moi rythme|!..."
        say Outrageor presentation=14 : "Arf arf|!..."
        say Outrageor presentation=15 : "Tu te rends compte|, Commander|?..."
        say Outrageor presentation=16 : "Moi rythme dans la peau|!..."
        say Outrageor presentation=8 if_not_shown skip_next=3 : "..."
        end presentation Outrageor
        globals.A13 += 3
        sequence_slots[4] = "12concrool"
    }
    proc outra01 enabled {
        during travel
        require presentation == Outrageor
    } then {
        when {
            require globals.A68 == 1
        } then {
            say Outrageor presentation=9 : "...GREVE|!!!"
            say Outrageor presentation=10 : "..."
            say Outrageor presentation=11 : "...GREVE"
            say Outrageor presentation=12 : "..."
            say Outrageor presentation=13 : "...GREVE"
            say Outrageor presentation=14 : "..."
            say Outrageor presentation=15 : "...GREVE"
            say Outrageor presentation=16 : "..."
            say Outrageor presentation=17 : "...!!!"
            say Outrageor presentation=18 if_not_shown skip_next=1 : "..."
            say Outrageor presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Outrageor
        }
        say Outrageor presentation=9 : "Moi Outrageor..."
        when {
            require globals.A74 == 6
        } then {
            text_tokens Outrageor presentation=11 : "Nous" "étre" state_number(0x013E) "croolis_red" "dans" "tribu..."
        }
        when {
            require Outrageor.encounter_count == 1
        } then {
            say Outrageor presentation=10 : "Alors c'est toi étre le fameux|..."
            say Outrageor presentation=8 if_not_shown skip_next=1 : "..."
            request sequence "logo_bl.hnm"
            say Outrageor presentation=8 chatter : "eh oui|, c'est lui|!..."
            say Outrageor presentation=11 : "Toi avoir traversé le temps pour venir me voir|!..."
            say Outrageor presentation=12 : "Toi avoir peur de rien|!..."
            say Outrageor presentation=13 : "Alors|, quoi toi vouloir|?..."
            say Outrageor presentation=8 if_not_shown skip_next=1 : "Hein|? Quoi toi vouloir|?..."
            request sequence "match04.hnm"
            say Outrageor presentation=14 : "Toi voir|? Ca mes copains|!..."
            say Outrageor presentation=15 : "Eux sympa|! Te dire bonjour|!..."
            say Outrageor presentation=8 if_not_shown skip_next=1 : "Bonjour Commander BLOOD|!..."
            request sequence "match04.hnm"
            say Outrageor presentation=16 : "Bon|... Toi me donner tes sens|..."
        }
        when {
            require globals.A74 == 3
            require globals.A79 == 4
            require couronne.holder != aboard
        } then {
            say Outrageor presentation=16 : "Moi tous les sens|..."
            say Outrageor presentation=10 : "Moi couronne..."
            say Outrageor presentation=8 chatter : "Toi roi des quoi|?..."
            say Outrageor presentation=12 : "Moi roi des croons|..."
            say Outrageor presentation=8 chatter : "Toi crooner|?..."
            say Outrageor presentation=13 : "Moi couronneur|..."
            say Outrageor presentation=15 : "Moi vendre à toi couronne contre un crédit symbolique..."
            when {
                require globals.A4 == 0
            } then {
                say Outrageor presentation=8 chatter : "Nous n'avons pas de crédits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Outrageor presentation=8 chatter resume_at=outra01_dialogue_resume_1 : "Vous acceptez de lui acheter une couronne, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Outrageor presentation=8 chatter if_not_shown skip_next=3 : "On lui envoie un credit, Commander"
                    transfer credit from aboard to Outrageor
                    globals.A4 -= 1
                    globals.A74 = 5
                    say Outrageor presentation=8 chatter if_not_shown skip_next=1 : "TELEPORTATION COURONNE DANS CRYOBOX"
                    transfer couronne from Outrageor to aboard
                    say Outrageor presentation=8 chatter : "attention fermeture porte du temps imminente|..."
                    say Outrageor presentation=8 chatter : "...3..."
                    say Outrageor presentation=8 chatter : "...2..."
                    say Outrageor presentation=8 chatter : "...1..."
                    say Outrageor presentation=8 if_not_shown skip_next=2 : "..."
                    end presentation Outrageor
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
            outra01_dialogue_resume_1:
            when {
                require globals.A74 == 6
                require couronne.holder != aboard
                require globals.A4 > 0
            } then {
                say Outrageor presentation=10 : "Nous couronnes spéciales|... pouvoirs spéciaux|..."
                say Outrageor presentation=8 chatter : "combien|?..."
                say Outrageor presentation=11 : "Modéle de série|... pas cher|... bon rapport qualité-prix|..."
                say Outrageor presentation=8 chatter resume_at=gest02 : "voulez-vous acheter une couronne de série, commander|?..." choices "oui" "non"
                when {
                    require choice == "oui"
                } then {
                    say Outrageor presentation=8 chatter if_not_shown skip_next=2 : "on paye|..."
                    transfer credit from aboard to Outrageor
                    globals.A4 -= 1
                    say Outrageor presentation=8 chatter if_not_shown skip_next=1 : "teleportation couronne dans cryobox|..."
                    transfer couronne from Outrageor to aboard
                    say Outrageor presentation=8 if_not_shown skip_next=1 : "..."
                    choice = none
                }
                when {
                    require choice == "non"
                } then {
                    choice = none
                }
            }
        }
    }
    proc gest02 enabled {
