    proc benz01 enabled {
        during travel
        require presentation == Ben_Zen
    } then {
        when {
            require globals.A68 == 1
        } then {
            say Ben_Zen presentation=10 : "GREVE|..."
            say Ben_Zen presentation=8 chatter : "ouais c'est ca|..."
            say Ben_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Ben_Zen
        }
        when {
            require globals.A54 < 1
        } then {
            say Ben_Zen presentation=9 : "Pas vision clonique|... Kero sans relais zen|..."
            say Ben_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Ben_Zen
        }
        say Ben_Zen presentation=9 : "Moi Ben Zen, moi ZEN... Hoooooom..."
        text_tokens Ben_Zen presentation=11 : "Nous" "étre" state_number(0x0A34) "zen" "ici..."
        when {
            require globals.A54 == 1
        } then {
            say Ben_Zen presentation=12 : "Toi bien regarder, commander, moi grave probléme...Attention..."
            say Ben_Zen presentation=17 : "Hooom|!"
            say Ben_Zen presentation=13 : "Toi vu|? Moi malade... Attention..."
            say Ben_Zen presentation=17 : "Hooom|!"
            say Ben_Zen presentation=14 : "Moi toujours tomber à la renverse, pas équilibre... Attention..."
            say Ben_Zen presentation=17 : "Hooom|!"
            say Ben_Zen presentation=15 : "Moi souffrir colonne|! Aie aie aie..."
            say Ben_Zen presentation=17 : "Hooom|!"
            say Ben_Zen presentation=18 : "Par pitié, commander, aide-moi, c'est insupportable..."
            say Ben_Zen presentation=17 : "Hooom|!"
            say Ben_Zen presentation=8 chatter : "quelle curieuse maladie|! comment vous avez attrapé ca, monsieur Ben Zen|?"
            say Ben_Zen presentation=19 : "Ben|... Au concert des Crooling Stones... JiHen Migrix toujours se rouler par terre..."
            say Ben_Zen presentation=8 chatter : "alors vous avez voulu faire pareil..."
            say Ben_Zen presentation=17 : "Et depuis moi pas arréter tomber, Hooom|!"
            say Ben_Zen presentation=8 chatter : "aie|! on va vous aider|!"
            say Ben_Zen presentation=8 chatter : "il faut le soigner, commander, ou il va se casser le dos|!"
            say Ben_Zen presentation=8 if_not_shown skip_next=2 : "..."
            globals.A54 = 2
            end presentation Ben_Zen
        }
        when {
            require globals.A54 == 2
            require globals.A38 == 0
            require medicament.holder == aboard
            require Ben_Zen.encounter_count > 1
        } then {
            say Ben_Zen presentation=8 chatter : "commander|, on a un médicament dans la cryobox|..."
            say Ben_Zen presentation=8 chatter : "ca y est monsieur ben zen|! on a votre médicament|..."
            say Ben_Zen presentation=17 : "Hooom ben dépéchez-vous, j'en peux plus|!..."
            say Ben_Zen presentation=8 chatter resume_at=benz01_dialogue_resume_1 : "allez-y commander, donnez-lui|..." choices "donner" "pas_donner"
            when {
                require choice == "donner"
            } then {
                say Ben_Zen presentation=8 chatter if_not_shown skip_next=3 : "TRAITEMENT BEN ZEN|!..."
                globals.A38 = 1
                transfer medicament from aboard to Ben_Zen
                choice = none
            }
            when {
                require choice != "_donner"
            } then {
                choice = none
            }
        }
        benz01_dialogue_resume_1:
        when {
            require globals.A38 == 1
            require globals.A54 == 2
        } then {
            say Ben_Zen presentation=19 : "OUAOUH|! Quelle péche|! ça va mieux|!..."
            say Ben_Zen presentation=8 chatter : "Ca fait plaisir de vous voir debout|!..."
            say Ben_Zen presentation=11 : "Ben et moi donc|! Je me sens un autre ZEN|!"
            say Ben_Zen presentation=12 : "J'avais ben l'impression d'étre Croolis Zeltsine|!..."
            when {
                require bits(Tequila.flags,0x0004)
            } then {
                say Ben_Zen presentation=8 chatter : "c'est tequila qui va étre jalouse|!..."
            }
            say Ben_Zen presentation=13 : "J'aimerais ben vous remercier de m'avoir soulagé|..."
            say Ben_Zen presentation=14 : "Nous fabriquons de ben belles guitares, le méme modéle que celle de JiHen Migrix|!..."
            say Ben_Zen presentation=15 : "Double manche|! Corne de murfalo benzenurisée|!..."
            say Ben_Zen presentation=8 chatter : "magnifique|! merci beaucoup de votre cadeau|!..."
            say Ben_Zen presentation=17 : "Argh|!..."
            say Ben_Zen presentation=8 chatter : "bon sang|! il fait une rechute|!..."
            say Ben_Zen presentation=16 : "Ben pas du tout|... je suis tombé de surprise|!..."
            say Ben_Zen presentation=8 chatter : "pourquoi|? je suis trop poli|?..."
            say Ben_Zen presentation=12 : "Ben ça non|! Mais la guitare|..."
            say Ben_Zen presentation=8 chatter : "le cadeau|?..."
            say Ben_Zen presentation=11 : "Ben justement|... ce n'était pas un cadeau|... je vous la proposais pour un crédit, pas cher|..."
            say Ben_Zen presentation=8 chatter resume_at=benz01_dialogue_resume_2 : "il veut nous la vendre|! commander, vous étes|..." choices "choqué" "surpris" "vert" "ok"
            when {
                require choice != "ok"
            } then {
                globals.A54 = 3
                choice = none
            }
            when {
                require choice == "ok"
            } then {
                choice = none
            }
        }
        benz01_dialogue_resume_2:
        when {
            require globals.A38 == 1
            require globals.A54 == 3
        } then {
            say Ben_Zen presentation=8 chatter : "vous pourriez nous l'offrir|! on vous a sauvé|!..."
            say Ben_Zen presentation=15 : "Ben|... Tout travail mérite salaire, honorable machine|..."
            say Ben_Zen presentation=8 chatter : "c'est gonflé|!..."
            say Ben_Zen presentation=14 : "Ben c'est la loi de l'offre et de la demande|..."
            say Ben_Zen presentation=8 chatter : "vous étes bien le fils de votre temps, ben zen|..."
            say Ben_Zen presentation=16 : "Chacun veut et croit étre meilleur que ce temps-ci qui est le sien|..."
            say Ben_Zen presentation=10 : "Mais le meilleur sera celui qui exprimera le mieux ce temps-ci qui est le sien|..."
            say Ben_Zen presentation=8 chatter : "la philo ca méne à tout|..."
            say Ben_Zen presentation=11 : "Ben|... A tout ou rien|... ça revient au méme|..."
            say Ben_Zen presentation=8 chatter : "eh ben|! pour un zen, vous ne perdez pas le nord|!..."
            say Ben_Zen presentation=9 if_not_shown skip_next=1 : "Ben reprenons|..."
            globals.A54 = 4
        }
        when {
            require globals.A54 == 2
            require globals.A38 == 0
            require medicament.holder != aboard
            require Ben_Zen.encounter_count > 1
        } then {
            say Ben_Zen presentation=17 : "Hooom|! Hooom secours|!"
            say Ben_Zen presentation=8 chatter : "Il faut l'aider, commander|!"
            say Ben_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Ben_Zen
        }
        when {
            require globals.A38 == 1
            require guitare.holder != aboard
        } then {
            say Ben_Zen presentation=9 : "Nous fabriquons guitare, artisanat local... Hoooom..."
            say Ben_Zen presentation=15 : "Nous te vendons jolie guitare en corne de murfalo, contre credit..."
            dictionary blank after "corne"
            when {
                require globals.A4 == 0
            } then {
                say Ben_Zen presentation=8 chatter : "Nous n'avons plus de crédits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Ben_Zen presentation=8 chatter resume_at=benz01_dialogue_resume_3 : "Vous acceptez de leur acheter une guitare, Commander?" choices "ACCEPTER" "REFUSER"
                when {
                    require choice == "ACCEPTER"
                } then {
                    say Ben_Zen presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Ben_Zen
                    globals.A4 -= 1
                    say Ben_Zen presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION GUITARE DANS CRYOBOX"
                    transfer guitare from Ben_Zen to aboard
                    choice = none
                }
                when {
                    require choice == "REFUSER"
                } then {
                    choice = none
                }
            }
        }
        benz01_dialogue_resume_3:
        when {
            require Ben_Zen.encounter_count == 4
        } then {
            say Ben_Zen presentation=8 chatter : "au fait, ben zen, pourquoi vous vous appelez ben zen|?..."
            say Ben_Zen presentation=11 : "Ben|... C'est parce que moi tout le temps dire ben|... quand moi parler|..."
            say Ben_Zen presentation=8 chatter : "ah|? et pourquoi un coup vous parlez bien, et un coup vous pas parler bien|?..."
            say Ben_Zen presentation=12 : "Ben|... justement|... j'en sais rien|... ça me tue|!..."
            say Ben_Zen presentation=8 chatter : "pauvre vieux|..."
            say Ben_Zen presentation=9 : "Ben ouais|..."
        }
        when {
            require Ben_Zen.encounter_count == 9
        } then {
            say Ben_Zen presentation=9 : "La musique adoucir les moeurs|..."
            say Ben_Zen presentation=8 chatter : "ouais ouais, c'est ça|..."
        }
    }
