            say Kero_Zen presentation=10 if_not_shown skip_next=4 : "Clonage troisiéme chef ZEN en cours|... migration des àmes imminente|..."
            globals.A54 = 1
            state_b6[Kero_Zen.evolution] += 20
            globals.B72 = 1
            bits(optique.flags,0x0040) = false
        }
        when {
            require globals.A54 == 0
            require Kero_Zen.encounter_count > 2
            require optique.holder != aboard
        } then {
            say Kero_Zen presentation=10 : "Hooom Commander|..."
            say Kero_Zen presentation=11 : "Toi pas voir encore moyen clonage|..."
            say Kero_Zen presentation=8 chatter : "nous pas voir encore, mais nous chercher|..."
            say Kero_Zen presentation=12 : "Ouvrez grand les yeux|... clonage comme image miroir|..."
            say Kero_Zen presentation=8 chatter : "un peu de réflexion, commander|..."
            say Kero_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Kero_Zen
        }
        when {
            require globals.A54 == 0
            require optique.holder == aboard
        } then {
            say Kero_Zen presentation=10 : "Moi voir vous avoir machine à clonage sur cryobox|..."
            say Kero_Zen presentation=11 : "Vous donner à moi vision clonique|..."
        }
        say Kero_Zen presentation=9 : "Moi Kero Zen, moi ZEN... Hoooooom..."
        text_tokens Kero_Zen presentation=11 : "Nous" "étre" state_number(0x09EA) "zen" "ici..."
        when {
            require globals.A38 > 0
            require state_b6[Kero_Zen.evolution] > 0
        } then {
            say Kero_Zen presentation=9 : "Nous fabriquer médecine, industrie locale... Hoooom..."
            say Kero_Zen presentation=15 : "Nous vendre à toi médicaments, contre crédit..."
            when {
                require globals.A4 == 0
            } then {
                say Kero_Zen presentation=8 chatter : "Nous n'avons plus de crédits, Commander..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Kero_Zen presentation=8 chatter resume_at=gestsp2 : "Vous acceptez de leur acheter leur médecine, Commander?" choices "OUI" "NON"
                when {
                    require choice == "OUI"
                } then {
                    say Kero_Zen presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Kero_Zen
                    globals.A4 -= 1
                    say Kero_Zen presentation=8 chatter if_not_shown skip_next=2 : "MEDICINE'S TELEPORTATION INTO CRYOBOX"
                    transfer medicament from Kero_Zen to aboard
                    choice = none
                }
                when {
                    require choice == "NON"
                } then {
                    say Kero_Zen presentation=8 if_not_shown skip_next=1 : "..."
                    choice = none
                }
            }
        }
    }
    proc gestsp2 enabled {
