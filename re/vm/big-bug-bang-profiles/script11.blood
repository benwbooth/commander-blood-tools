        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=2 : "hommm nourriture..."
            state_b5[Ben_Zen.energy] += 500
            bits(nourriture.flags,0x0040) = false
        }
        when {
            require bits(medicament.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=3 : "Hommmm médecine"
            state_b6[Ben_Zen.evolution] += 50
            state_b1[Ben_Zen.population] += 200
            bits(medicament.flags,0x0040) = false
        }
        when {
            require bits(armes.flags,0x0040)
        } then {
            say Ben_Zen presentation=14 if_not_shown skip_next=4 : "Hommmm armes..."
            Ben_Zen.aggressiveness += 400
            state_b6[Ben_Zen.evolution] += 10
            globals.B24 = 1
            bits(armes.flags,0x0040) = false
        }
        when {
            require bits(optique.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=3 : "Hommm lentille optique..."
            state_b6[Ben_Zen.evolution] += 20
            globals.B72 = 1
            bits(optique.flags,0x0040) = false
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=2 : "Hoooom énergie"
            state_b5[Ben_Zen.energy] += 500
            bits(energie.flags,0x0040) = false
        }
        when {
            require bits(culture.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=2 : "hommmmm culture..."
            state_b6[Ben_Zen.evolution] += 60
            bits(culture.flags,0x0040) = true
        }
        when {
            require bits(ecriture.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=2 : "Hooom écriture..."
            state_b6[Ben_Zen.evolution] += 60
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=4 : "Hoooom vaisseaux"
            state_b6[Ben_Zen.evolution] += 40
            globals.B23 += 1
            globals.B71 = 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=4 : "Hooom traité..."
            state_b6[Ben_Zen.evolution] += 30
            Ben_Zen.aggressiveness = 0
            globals.B24 = 0
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Ben_Zen presentation=9 if_not_shown skip_next=2 : "Hooooom cadeaux..."
            state_b6[Ben_Zen.evolution] += 10
            bits(cadeaux.flags,0x0040) = false
        }
        say Ben_Zen presentation=8 chatter : "Quel objet désirez-vous lui donner, Commander?"
        say Ben_Zen presentation=8 chatter resume_at=gestsp3_dialogue_resume_1 : "DONNER:" choices inventory_choices
        say Ben_Zen presentation=8 : "..."
        gestsp3_dialogue_resume_1:
        say Ben_Zen presentation=8 chatter : "A bientot, Commander..."
        say Ben_Zen presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Ben_Zen
        halt
    }
}
