    proc zenmar enabled {
        during bridge
        require globals.A60 == 3
        require presentation == Super_Zen
    } then {
        say Super_Zen presentation=8 : "Appel urgent|... Ici Super Zen|..."
        say Super_Zen presentation=8 chatter : "on vous écoute|..."
        say Super_Zen presentation=8 : "Hooom|... renseignement sur situation Marakas|..."
        say Super_Zen presentation=8 chatter : "quoi|!? vous savez quelque chose|?..."
        say Super_Zen presentation=8 : "Je sais tout|... Mais transmission coordonnées impossible par téléphone|..."
        say Super_Zen presentation=8 chatter : "par Internet|?..."
        say Super_Zen presentation=8 : "Impossible|... Face à face, cerveau dans cerveau|... Venez me voir|..."
        say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
        globals.A60 = 4
        end presentation Super_Zen
    }
    proc peren enabled {
        during bridge
        require globals.A55 == 1
        require presentation == Super_Zen
    } then {
        say Super_Zen presentation=8 : "Ici Pére noél|... alias Cyberquizz|..."
        say Super_Zen presentation=8 chatter : "pas terrible votre déguisement, pére noél|!..."
        say Super_Zen presentation=8 : "Quoi|? C'est un manteau que j'ai trouvé dans le cyberspace|..."
        say Super_Zen presentation=8 chatter : "mon dieu|! c'est le manteau de ce pauvre super zen|..."
        say Super_Zen presentation=8 : "Bon|... vous voulez toujours jouer avec moi|?..."
        say Super_Zen presentation=8 chatter : "si vous promettez de vous changer|!..."
        say Super_Zen presentation=8 : "Promis|! Je me changerai pendant le voyage|..."
        say Super_Zen presentation=8 chatter : "TELEPORTATION PERE NOEL CYBERQUIZZ SUR CRYOBOX|..."
        say Super_Zen presentation=8 : "Waouh|! Ca décoiffe|! C'est autre chose que le traineau|!..."
        say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
        Cyberquizz.current_location = aboard
        end presentation Super_Zen
    }
    proc zncry enabled {
        during contact
        require globals.A64 == 0
        require presentation == Super_Zen
    } then {
        when {
            require Super_Zen.encounter_count == 1
        } then {
            say Super_Zen presentation=9 : "MFFF... MFFF..."
            say Super_Zen presentation=10 : "ATA... ATA... Mfff..."
            say Super_Zen presentation=8 chatter : "UN SUPER ZEN|!!! Qu'est-ce qu'il fout là|???"
            dictionary blank after "là"
            say Super_Zen presentation=11 : "Mfff... Mfffutur..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Cauchemar... Roswell|..."
            request sequence "momi10.hnm"
            say Super_Zen presentation=8 chatter : "CA ALORS, c'est un sacré nom de Yolk de Super Zen, pas de doute|!!!"
            say Super_Zen presentation=12 : "Mfff... Mfff... TO TO... SUPER ZEN|!"
            say Super_Zen presentation=8 chatter : "Laissons-le se réveiller, Commander..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Super_Zen
        }
        say Super_Zen presentation=14 : "HOOOOOOMMMMM|..."
        say Super_Zen presentation=14 : "Moi Super Zen, moi ZEN|... moi BLURP..."
        say Super_Zen presentation=8 chatter : "Comment ca lui BLURP? Lui ZEN ou BLURP|?"
        say Super_Zen presentation=12 : "Ze moi Ze grois gueu ze vais romir..."
        say Super_Zen presentation=8 chatter : "Oulàlà, Commander, il a pas l'air d'aller bien, il lui faut du grand air..."
        say Super_Zen presentation=8 chatter : "J'ai repéré une planéte qui pourrait lui convenir..."
        say Super_Zen presentation=8 chatter : "de toutes facons, si on se débarrasse pas de lui..."
        say Super_Zen presentation=19 : "J'AI MAL AU COEUR|! LAISSEZ-MOI SORTIR|!"
        say Super_Zen presentation=8 chatter : "Il va en mettre partout|!"
        say Super_Zen presentation=8 chatter resume_at=supz01 : "Voulez-vous que je le téléporte, Commander?" choices "OUI" "NON"
        when {
            require choice == "OUI"
        } then {
            Crazystone.active = true
            Crazystone.known = true
            Crazyland.active = true
            Crazyland.known = true
            bits(Super_Zen.flags,0x0004) = true
            say Super_Zen presentation=8 chatter : "TELEPORTATION SUPER ZEN SUR CRAZYSTONE..."
            say Super_Zen presentation=8 if_not_shown skip_next=5 : "..."
            Super_Zen.current_location = Crazyland
            Ben_Zen.current_location = Crazyland
            Kero_Zen.current_location = Crazyland
            end presentation Super_Zen
            choice = none
        }
        when {
            require choice == "NON"
        } then {
            say Super_Zen presentation=8 chatter : "Comme vous voulez... Commander... Mais bon, il risque de s'enrhumer dans la cryobox..."
            say Super_Zen presentation=8 chatter : "Vous savez, on n'est pas là pour faire mourir des races, mais pour les faire évoluer..."
            say Super_Zen presentation=8 chatter : "Ceci dit, c'est comme vous voulez..."
            dictionary blank after "Ceci"
            say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Super_Zen
            choice = none
        }
    }
    proc supz01 enabled {
        during travel
        require presentation == Super_Zen
    } then {
        when {
            require Super_Zen.encounter_count == 3
        } then {
            say Super_Zen presentation=9 : "Hooom Commander|!..."
            say Super_Zen presentation=10 : "Voulez-vous jouer au ni oui ni non avec moi|?..."
            say Super_Zen presentation=8 chatter resume_at=supz01_dialogue_resume_1 : "..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say Super_Zen presentation=12 : "Moi aussi j'aurais bien aimé|..."
                say Super_Zen presentation=13 if_not_shown skip_next=1 : "Mais d'abord je dois vérifier quelque chose|..."
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Super_Zen presentation=14 : "Tant pis|!... La prochaine fois peut-étre|..."
                say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
                end presentation Super_Zen
                choice = none
            }
        }
        supz01_dialogue_resume_1:
        when {
            require Super_Zen.encounter_count == 3
        } then {
            say Super_Zen presentation=15 : "Vous voyez ce que je veux dire|?..."
            say Super_Zen presentation=8 chatter resume_at=supz01_dialogue_resume_2 : "vous voyez|, commander|?..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say Super_Zen presentation=19 if_not_shown skip_next=1 : "Perdu|! Ah ah ah|! Tu as dit OUI|!..."
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Super_Zen presentation=19 if_not_shown skip_next=1 : "Perdu|! Tu as dit NON|! Ah ah ah|!..."
                choice = none
            }
        }
        supz01_dialogue_resume_2:
        when {
            require Super_Zen.encounter_count == 4
        } then {
            say Super_Zen presentation=10 : "Hooom Commander|..."
            say Super_Zen presentation=9 : "Veux-tu jouer au ni oui ni non|?..."
            say Super_Zen presentation=8 chatter resume_at=supz01_dialogue_resume_3 : "..." choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                choice = none
            }
            when {
                require choice == "non"
            } then {
                choice = none
            }
            supz01_dialogue_resume_3:
            say Super_Zen presentation=19 : "Perdu|! Ah ah ah|! Ni oui ni non|!..."
            say Super_Zen presentation=8 chatter : "c'est malin|..."
        }
        when {
            require Super_Zen.encounter_count > 4
            require Super_Zen.encounter_count < 9
        } then {
            say Super_Zen presentation=9 : "Vous voulez jouer au ni zen ni gluxx avec moi|, Commander|?..."
            say Super_Zen presentation=8 chatter resume_at=supz01_dialogue_resume_4 : "..." choices "oui" "non" "zen" "gluxx"
            when {
                require choice == "oui"
            } then {
                say Super_Zen presentation=19 : "Ouais|! Super|!..."
                say Super_Zen presentation=16 : "Mais|... Euh|..."
                say Super_Zen presentation=12 : "Je crois que j'ai encore|..."
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "...oublié les régles|!..."
                request sequence "star2.hnm"
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Super_Zen presentation=19 : "BRAVO|! Gagné|! Vous n'avez dit ni ZEN ni GLUXX|!..."
                say Super_Zen presentation=8 chatter : "Ah|! perdu super zen|! vous avez dit zen et gluxx|..."
                say Super_Zen presentation=17 : "Damnation|!..."
                say Super_Zen presentation=9 : "Mais toi aussi|, HONK|!..."
                say Super_Zen presentation=8 chatter : "quoi|?..."
                say Super_Zen presentation=13 : "Tu as dit ZEN et GLUXX|!..."
                say Super_Zen presentation=8 chatter : "encore perdu super zen|! vous venez de le redire|!..."
                say Super_Zen presentation=17 : "Ah|! GLUXX alors|!..."
                say Super_Zen presentation=8 chatter : "encore|!..."
                say Super_Zen presentation=17 : "Ah non d'un ZEN|!..."
                say Super_Zen presentation=8 chatter : "encore|!..."
                say Super_Zen presentation=13 if_not_shown skip_next=1 : "Les ordinateurs sont trop forts pour moi à ce jeu|!..."
                choice = none
            }
            when {
                require choice == "zen"
            } then {
                say Super_Zen presentation=19 : "Perdu|! Ah ah ah|! Vous avez dit ZEN|!..."
                say Super_Zen presentation=8 chatter : "vous aussi|!..."
                say Super_Zen presentation=17 if_not_shown skip_next=1 : "Damnation|!..."
                choice = none
            }
            when {
                require choice == "gluxx"
            } then {
                say Super_Zen presentation=19 : "Ah ah|! Perdu|! Vous avez dit GLUXX|!..."
                say Super_Zen presentation=8 chatter : "Ah|! GLUXX de gluxx|!..."
                say Super_Zen presentation=19 : "Encore perdu|!..."
                say Super_Zen presentation=8 chatter if_not_shown skip_next=1 : "il est trop fort|..."
                choice = none
            }
        }
        supz01_dialogue_resume_4:
        when {
            require Super_Zen.encounter_count == 9
        } then {
            say Super_Zen presentation=14 : "Voulez-vous jouer au oui ou non|?..."
            say Super_Zen presentation=8 chatter resume_at=supz01_dialogue_resume_5 : "vous voulez jouer au oui ou non|, commander|?..." choices "oui" "non" "ni_oui" "ni_non"
            when {
                require choice == "oui"
            } then {
                say Super_Zen presentation=19 if_not_shown skip_next=1 : "Ouais|! Gagné|! Tu as dit oui|..."
                choice = none
            }
            when {
                require choice == "non"
            } then {
                say Super_Zen presentation=19 if_not_shown skip_next=1 : "Bravo|! Tu as dit non|!..."
                choice = none
            }
            when {
                require choice == "ni_oui"
            } then {
                say Super_Zen presentation=19 if_not_shown skip_next=1 : "Perdu|! Tu as dit ni oui|..."
                choice = none
            }
            when {
                require choice == "ni_non"
            } then {
                say Super_Zen presentation=19 : "Perdu|! Tu as dit ni non|..."
                say Super_Zen presentation=8 chatter : "ni oui non plus|..."
                say Super_Zen presentation=19 if_not_shown skip_next=1 : "Deux fois perdu|! Tu as dit ni oui|!..."
                choice = none
            }
        }
        supz01_dialogue_resume_5:
        when {
            require globals.A68 == 1
        } then {
            say Super_Zen presentation=9 : "Hooom|... gréve|..."
            say Super_Zen presentation=8 chatter : "c'est ca|! méme lui|... gréve|!..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Super_Zen
        }
        when {
            require globals.A53 == 1
        } then {
            say Super_Zen presentation=9 : "Commander|?... Hooom..."
            say Super_Zen presentation=8 chatter : "Oui, c'est lui|..."
            say Super_Zen presentation=14 : "Vous progressez, je vois|..."
            say Super_Zen presentation=11 : "Mais attention|... prenez garde au chaos..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "... le chaos|..."
            request sequence "momi10.hnm"
            say Super_Zen presentation=12 : "Prenez garde..."
            say Super_Zen presentation=8 chatter : "Commander, j'ai les circuits qui trembloodent..."
            say Super_Zen presentation=13 : "Oubliez tout le reste..."
            say Super_Zen presentation=10 : "Concentrez-vous sur mon vizen|... zage..."
            say Super_Zen presentation=8 chatter : "Sur son quoi|?"
            say Super_Zen presentation=19 : "...sur mon visage, bon sang de blood|!..."
            say Super_Zen presentation=20 : "... télépathie..."
            say Super_Zen presentation=12 : "...Reprenons..."
            say Super_Zen presentation=10 : "Concentrez-vous sur mon visage..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Le futur..."
            request sequence "galaxi.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Pourquoi ceci..."
            request sequence "legion01.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "... plutot que cela|?..."
            request sequence "caiscrut.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "...pourquoi|?..."
            request sequence "mag_scr.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Pourqu...AAAH|!"
            request sequence "explo3.hnm"
            say Super_Zen presentation=17 : "AAAH|!..."
            say Super_Zen presentation=15 : "Tu n'es pas encore prét pour la télépathie, Commander..."
            say Super_Zen presentation=16 : "Il te manque..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "quelque chose... d'important..."
            request sequence "brouil.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=3 : "..."
            Marakas.current_location = Trashlando
            globals.A53 = 2
            end presentation Super_Zen
        }
        when {
            require globals.A60 == 5
            require technologie.holder == aboard
            require globals.A53 == 2
        } then {
            say Super_Zen presentation=9 : "Hooom Commander... j'attendais ta revenue..."
            say Super_Zen presentation=11 : "J'espére que tu t'es équipé|..."
            say Super_Zen presentation=20 : "... pour la télépathie|..."
            say Super_Zen presentation=10 : "Je vérifie|... regarde-moi|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Je vois dans ton cerveau|... des idées lumineuses|... je vois|..."
            request sequence "tourbi.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "... que tu es prét|..."
            request sequence "brouil.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Je vais pouvoir t'aider à voir le futur, aidé de mon assistant TUBULAR|..."
            request sequence "kort.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Mais|... AAAH|! ton cerveau explose..."
            request sequence "explroug.hnm"
            say Super_Zen presentation=17 : "AAAh|!..."
            say Super_Zen presentation=14 : "Pour alimenter ton cerveau, il faut aussi du bionium, commander|... de l'énergie|... beaucoup d'énergie|..."
            when {
                require globals.vbio < 5
            } then {
                say Super_Zen presentation=8 chatter : "Bon|... compris|... attention scruter jo, nous voilà|!"
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
                end presentation Super_Zen
            }
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
            globals.A53 = 3
        }
        when {
            require globals.A53 == 2
            require technologie.holder != aboard
            require globals.A60 < 5
        } then {
            say Super_Zen presentation=9 : "Inutile|... Vanité des vanités|..."
            say Super_Zen presentation=12 : "Pourquoi revenir me voir sans étre prét|..."
            say Super_Zen presentation=19 : "Pour télépathie|?..."
            say Super_Zen presentation=10 : "Retourne voir|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Izwalito|..."
            request sequence "aready20.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Super_Zen
        }
        when {
            require globals.A60 == 5
            require globals.A53 == 3
            require globals.vbio > 4
        } then {
            say Super_Zen presentation=15 : "Je vois que tu es habile!..."
            say Super_Zen presentation=10 : "Tréve de bavardage, regarde-moi dans les yeux|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "... dans les yeux|..."
            request sequence "ppitbb01.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "AAAH|!..."
            request sequence "explo3.hnm"
            say Super_Zen presentation=17 : "AAArgh|!..."
            say Super_Zen presentation=13 : "Ce ne sont pas tes yeux|... ton esprit est piraté par quelque chose|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "NA NA NA NA Né REUH|!..."
            request sequence "ppit07.hnm"
            say Super_Zen presentation=8 chatter : "Encore lui|! y en a marre|! coucouche panier, pipiteux|!"
            dictionary blank after "coucouche"
            say Super_Zen presentation=12 : "Mais peu importe|... je trouverai un autre moyen de t'envoyer mes images|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "par un canal de plus|..."
            request sequence "decodeur.hnm"
            say Super_Zen presentation=8 if_not_shown skip_next=4 : "..."
            globals.vbio -= 5
            globals.A53 = 4
            end presentation Super_Zen
            sequence_slots[1] = "11izwalexplo"
        }
        when {
            require globals.A53 == 3
            require globals.vbio < 5
        } then {
            say Super_Zen presentation=10 : "Il faut davantage de bionium|, Commander|..."
            say Super_Zen presentation=8 chatter : "encore plus|?..."
            say Super_Zen presentation=20 : "Télépathie chére en énergie|, Commander|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Super_Zen
        }
    }
    proc marabid enabled {
        during travel
        require Marakas.current_location == Trashlando
        require presentation == Super_Zen
    } then {
        when {
            require globals.A80 == 0
            require globals.A60 > 5
        } then {
            say Super_Zen presentation=10 : "Hooom|... Commander|... Enigme platonicienne|..."
            say Super_Zen presentation=11 : "Vous croyez que vous étes assez|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Intelligent|..."
            request sequence "brouil.hnm"
            say Super_Zen presentation=12 : "Pour trouver|?..."
            say Super_Zen presentation=8 chatter resume_at=marlib2 : "vous croyez étre quoi|, commander|?..." choices "intelligent" "primate" "crétin" "gros_lourd"
            when {
                require choice == "intelligent"
            } then {
                say Super_Zen presentation=13 : "Félicitations|, Commander|... Vous allez trouver tout seul|..."
                say Super_Zen presentation=8 chatter : "allez-y|, montrez-lui comme vous étes pas béte|, commander|..."
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice != "intelligent"
            } then {
                say Super_Zen presentation=14 : "C'est méritoire de le reconnaitre|, Commander|..."
                say Super_Zen presentation=9 : "Je vous rappelle donc qu'il me faut|..."
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "Astronomie|..."
                transfer optique from Super_Zen to aboard
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "Harmonie|..."
                transfer guitare from Super_Zen to aboard
                say Super_Zen presentation=10 : "Et réflexion|..."
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
        }
    }
    proc marlib2 enabled {
        during travel
        require Marakas.current_location == Trashlando
        require presentation == Super_Zen
    } then {
        when {
            require globals.A80 < 3
            require globals.A80 > 0
        } then {
            say Super_Zen presentation=14 : "Commander|... C'est bien|... Tu réfléchis|..."
            say Super_Zen presentation=15 : "Mais il faut encore me donner quelque chose|..."
        }
        when {
            require globals.A81 == 0
            require globals.A80 > 2
            require globals.A53 > 3
        } then {
            say Super_Zen presentation=9 : "Tu es un excellent détective|... Tu vas peut-étre pouvoir libérer Marakas de la caverne|..."
            say Super_Zen presentation=8 chatter : "bon sang de yolk|! c'est super zen qui séquestre marakas|!..."
            say Super_Zen presentation=12 : "Il n'en est rien, mon ami|... Marakas est prisonnier de son propre esprit|..."
            say Super_Zen presentation=11 : "La caverne est son propre esprit|..."
            say Super_Zen presentation=10 : "Te voici confronté à l'énigme fondamentale|..."
            say Super_Zen presentation=18 : "Hooom|..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Le moment de la réflexion est venu|..."
            transfer image from Super_Zen to aboard
            say Super_Zen presentation=14 : "Si la caverne est remplie d'images|..."
            say Super_Zen presentation=13 : "Si ces images ne sont que les ombres des choses|..."
            say Super_Zen presentation=15 : "Qu'est-ce qui permettra de voir les choses elles-mémes et non pas leur ombre|?..."
            say Super_Zen presentation=10 : "Si la caverne est ton esprit|..."
            say Super_Zen presentation=19 : "Comment sortir de la caverne|?!!..."
            say Super_Zen presentation=8 chatter : "oh j'en sais rien|..."
            say Super_Zen presentation=16 : "Je vais te proposer des listes de lettres|... Tu choisiras dans l'ordre la premiére lettre de ta réponse, la deuxiéme|, etc|..."
            say Super_Zen presentation=8 chatter : "c'est compliqué|!..."
            say Super_Zen presentation=15 : "Non|... La réponse tient en un seul mot|..."
            say Super_Zen presentation=8 chatter resume_at=marlib2_dialogue_resume_1 : "bon|... la premiére lettre|..." choices "i" "o" "n"
            when {
                require choice == "i"
            } then {
                say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
                globals.A81 += 1
                choice = none
            }
            when {
                require choice != "i"
            } then {
                choice = none
            }
        }
        marlib2_dialogue_resume_1:
        when {
            require globals.A80 > 2
            require globals.A53 > 3
            require globals.A81 > 0
        } then {
            say Super_Zen presentation=8 chatter resume_at=marlib2_dialogue_resume_2 : "la deuxiéme lettre|..." choices "c" "h" "a" "r" "m" "i" "d" "e"
            when {
                require choice == "d"
            } then {
                say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
                globals.A81 += 1
                choice = none
            }
            when {
                require choice != "d"
            } then {
                choice = none
            }
        }
        marlib2_dialogue_resume_2:
        when {
            require globals.A80 > 2
            require globals.A53 > 3
            require globals.A81 > 0
        } then {
            say Super_Zen presentation=8 chatter resume_at=marlib2_dialogue_resume_3 : "La troisiéme lettre|..." choices "r" "é" "p" "u" "b" "l" "i" "q" "u" "e"
            when {
                require choice == "é"
            } then {
                say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
                globals.A81 += 1
                choice = none
            }
            when {
                require choice != "é"
            } then {
                choice = none
            }
        }
        marlib2_dialogue_resume_3:
        when {
            require globals.A80 > 2
            require globals.A81 > 0
            require globals.A53 > 3
        } then {
            say Super_Zen presentation=8 chatter resume_at=marlib2_dialogue_resume_4 : "La quatriéme lettre|..." choices "a" "l" "c" "i" "b" "i" "a" "d" "e"
            when {
                require choice == "e"
            } then {
                say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
                globals.A81 += 1
                choice = none
            }
            when {
                require choice != "e"
            } then {
                choice = none
            }
        }
        marlib2_dialogue_resume_4:
        when {
            require globals.A81 == 4
        } then {
            say Super_Zen presentation=8 chatter resume_at=marlib2_dialogue_resume_5 : "Cinquiéme et derniére lettre|..." choices "s" "o" "c" "r" "a" "t" "e"
            dictionary blank after "Cinquiéme"
            when {
                require choice == "s"
            } then {
                say Super_Zen presentation=8 if_not_shown skip_next=3 : "..."
                globals.A81 = 5
                end presentation Super_Zen
                choice = none
            }
            when {
                require choice != "s"
            } then {
                choice = none
            }
        }
        marlib2_dialogue_resume_5:
        when {
            require globals.A80 > 2
            require globals.A53 > 3
            require globals.A81 < 5
        } then {
            say Super_Zen presentation=17 : "AAAaaah|! échec|!..."
            say Super_Zen presentation=9 : "Tu dois encore réfléchir, Commander|... Les idées ne viennent pas toutes seules|..."
            say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
            globals.A81 = 0
            end presentation Super_Zen
        }
    }
    proc supzen3 enabled {
        during travel
        require presentation == Super_Zen
    } then {
        when {
            require Super_Zen.encounter_count < 5
        } then {
            say Super_Zen presentation=9 : "Vous me reconnaissez|? Z'est Moi, Super Zen, le plus super des ZEN... Hoooooom..."
            say Super_Zen presentation=8 chatter : "Hoooooom..."
            text_tokens Super_Zen presentation=11 : "Nous" "sommes" state_number(0x09A0) "zen" "ici..." "Superzénial," "non" "?"
        }
    }
    proc _1supzen as "1supzen" enabled {
        during travel
        require presentation == Super_Zen
    } then {
        when {
            require globals.A21 == 0
            require bits(couronne.flags,0x0040)
            require globals.A74 == 5
            require bague.holder != aboard
        } then {
            say Super_Zen presentation=9 : "La Couronne... Je ne veux pas de ce pouvoir, Commander..."
            say Super_Zen presentation=8 chatter : "Quelle sagesse... C'est bien le seul|! C'est vraiment lui le meilleur!"
            say Super_Zen presentation=10 : "Le pouvoir corrompt méme les meilleurs, honorable mécanisme..."
            say Super_Zen presentation=8 chatter : "OUI, c'est pour ca qu'on vous la donne..."
            say Super_Zen presentation=8 if_not_shown skip_next=2 : "..."
            globals.A74 = 6
            choice = none
        }
        when {
            require globals.A74 == 6
        } then {
            say Super_Zen presentation=8 chatter if_not_shown skip_next=1 : "teleportation couronne super zen|..."
            transfer couronne from aboard to Super_Zen
            say Super_Zen presentation=13 : "J'obéis|, Commander|... Mais ce n'est pas de gaieté de coeur|..."
            say Super_Zen presentation=8 chatter : "Quand méme, il pourrait dire merci..."
            say Super_Zen presentation=13 : "Cher Commander, vénéré Médiateur du Grand Yolk, l'heure est venue, enfin..."
            dictionary blank after "Yolk,"
            say Super_Zen presentation=8 chatter : "de dire merci?..."
            say Super_Zen presentation=11 : "L'heure est venue... Hoooooom..."
            say Super_Zen presentation=8 chatter : "Dites donc, Commander, il a l'air vraiment super zen, Super Zen"
            say Super_Zen presentation=11 : "Le moment tant attendu... Hoooooooooooom..."
            say Super_Zen presentation=8 chatter : "Oui c'est ca, Hooooooooom... Et puis Faaaaaam..."
            say Super_Zen presentation=10 : "Hoooooooooom..."
            say Super_Zen presentation=8 chatter : "Il médite..."
            say Super_Zen presentation=10 : "Hoooooooooom..."
            say Super_Zen presentation=8 chatter : "Bon, il m'énerve! On va jamais finir..."
            say Super_Zen presentation=9 : "L'heure est venue..."
            say Super_Zen presentation=8 chatter : "Ouais ben en tout cas elle tourne!"
            say Super_Zen presentation=9 : "de vous offrir la bague qui jadis se trouvait|..."
            say Super_Zen presentation=10 : "dans l'oeuf d'Origine..."
            say Super_Zen presentation=8 chatter : "Quoi, quoi|?..."
            say Super_Zen presentation=9 : "Dans l'oeuf pondu par le vaisseau d'Origine|..."
            say Super_Zen presentation=13 : "et qui seule vous permettra d'atteindre le But Ultime..."
            say Super_Zen presentation=8 chatter : "attends|! attends|! c'est quoi cette histoire|?..."
            say Super_Zen presentation=10 : "Jadis l'Armada Ultime|..."
            say Super_Zen presentation=13 : "escorta le vaisseau d'Origine jusqu'à la ponte de l'Oeuf..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Dans l'Oeuf était la bague|..."
            transfer bague from Super_Zen to aboard
            say Super_Zen presentation=8 chatter : "ah d'accord|!..."
            say Super_Zen presentation=8 if_not_shown skip_next=1 : "Cette bague|..."
            transfer bague from aboard to Super_Zen
            say Super_Zen presentation=12 : "Seigneur Commander, j'ai l'honneur et la gràce de la mettre à votre disposition|..."
            say Super_Zen presentation=11 if_not_shown skip_next=1 : "Vous en ferez LE bon usage, je le sais... Acceptez-vous mon offrande|?"
            globals.A21 = 1
        }
    }
    proc supzen2 enabled {
        during travel
        require presentation == Super_Zen
    } then {
        when {
            require globals.A21 == 1
        } then {
            say Super_Zen presentation=8 chatter resume_at=gestspz : "Qu'est-ce qu'on fait, Commander? C'est trés louche son histoire..." choices "accepter" "refuser"
            when {
                require choice == "accepter"
            } then {
                say Super_Zen presentation=10 : "Bravo Commander, on ne m'avait pas menti..."
                say Super_Zen presentation=11 : "Vous étes bien l'élu..."
                say Super_Zen presentation=8 chatter : "Bravo commander... et sans campagne électorale|!..."
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "Voici la bague|..."
                transfer bague from Super_Zen to aboard
                say Super_Zen presentation=12 : "YOLK est Grand|!"
                say Super_Zen presentation=8 chatter : "Et moi petit..."
                say Super_Zen presentation=13 : "Ca fait une bonne moyenne..."
                say Super_Zen presentation=8 chatter if_not_shown skip_next=1 : "Qu'est-ce qu'on rigole avec Super Zen|!"
                request sequence "p_cles.hnm"
                say Super_Zen presentation=14 : "Mais tréve de plaisanterie|! Commander, prends garde à cette bague..."
                say Super_Zen presentation=8 chatter : "encore un cadeau empoisonné|! je le savais|!"
                say Super_Zen presentation=15 : "Eh oui, ce n'est pas facile tous les jours d'étre l'élu..."
                say Super_Zen presentation=8 chatter : "A qui le dites-vous|!"
                say Super_Zen presentation=16 : "Mais à toi, pauvre idiot|!"
                say Super_Zen presentation=8 chatter : "Commander je vais me taire, je crois que je l'énerve..."
                say Super_Zen presentation=10 : "Le silence est l'étui de la vérité..."
                say Super_Zen presentation=8 chatter : "C'est ben vrai ca|!"
                say Super_Zen presentation=18 : "COUCHE|!!!"
                say Super_Zen presentation=19 : "Reprenons... Ecoutez bien, Commander, le sort du Grand Yolk repose..."
                say Super_Zen presentation=20 : "SUR VOS EPAULES|!"
                say Super_Zen presentation=8 chatter : "Nom de..."
                say Super_Zen presentation=19 : "YOLK|!"
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "Yolk en son infinie sagesse et puissance veut s'incarner en ce monde..."
                request sequence "explroug.hnm"
                say Super_Zen presentation=10 : "Vous, Commander, serez son messager et son prophéte..."
                say Super_Zen presentation=11 : "Vous annoncerez sa venue, et le ferez revenir..."
                dictionary blank after "revenir..."
                say Super_Zen presentation=12 : "Pour ce faire, vous devrez concilier les contraires..."
                say Super_Zen presentation=13 : "Marier le Yink et le Yank..."
                say Super_Zen presentation=14 : "Unir la Vie et la Mort..."
                say Super_Zen presentation=15 : "L'Energie et la Bandelette..."
                say Super_Zen presentation=8 chatter : "La quoi|?..."
                say Super_Zen presentation=15 : "La Bandelette... Je vais quand méme pas expliquer, c'est une énigme..."
                say Super_Zen presentation=8 chatter : "c'est vrai, ce serait idiot..."
                say Super_Zen presentation=16 : "Bon... Ben voilà... Ma mission est terminée... Je vais me dézentégrer..."
                say Super_Zen presentation=8 chatter : "Oh non|! Pas sous nos yeux|!"
                say Super_Zen presentation=14 : "Et encore merci pour la couronne, mais sincérement je ne sais qu'en faire..."
                say Super_Zen presentation=8 chatter : "sacré philosophe ce Super Zen|!"
                say Super_Zen presentation=9 : "Aussi je vous la rends... Faites-en aussi bon usage..."
                say Super_Zen presentation=8 chatter if_not_shown skip_next=2 : "Commander, il nous rend la couronne..."
                transfer couronne from Super_Zen to aboard
                globals.A72 = 1
                say Super_Zen presentation=13 : "A présent, vénéré Commander, permettez-moi de prendre congé|..."
                say Super_Zen presentation=10 : "Approchez-vous une derniére fois|... écoutez-moi bien|..."
                say Super_Zen presentation=17 : "Ne vous laissez jamais abattre par les critiques|..."
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "... Et rendez gràce à Yolk|..."
                request sequence "tabloyol.hnm"
                say Super_Zen presentation=9 : "Car vous étes un nom de Yolk de suprabon scénariste|!..."
                say Super_Zen presentation=19 : "ET NE LAISSEZ JAMAIS PERSONNE DIRE LE CONTRAIRE|!"
                say Super_Zen presentation=18 : "Encore bravo, Commander|... Je m'incline|..."
                say Super_Zen presentation=13 : "Adieu|... Arg... Dieu|... Ayolk|... Yooolk|... Yooo|..."
                say Super_Zen presentation=8 if_not_shown skip_next=1 : "YOOOooom|..."
                request sequence "star2.hnm"
                say Super_Zen presentation=8 if_not_shown skip_next=4 : "..."
                globals.A23 = 1
                end presentation Super_Zen
                sequence_slots[2] = "19chapeau"
                choice = none
            }
            when {
                require choice == "refuser"
            } then {
                say Super_Zen presentation=8 chatter : "Bien joué, Commander, on ne sait jamais avec ces Zénozophes!"
                say Super_Zen presentation=10 if_not_shown skip_next=1 : "Libre à vous, Seigneur Commander, peut-étre l'heure n'était-elle pas venue..."
                choice = none
            }
        }
    }
    proc gestspz enabled {
        during travel
        require presentation == Super_Zen
    } then {
        when {
            require bits(atomique.flags,0x0040)
        } then {
            say Super_Zen presentation=15 : "Hooom nuclear... Psy-power... Yo! Yo! Yo!"
            say Super_Zen presentation=8 chatter : "Commander... L'atomique lui fait un drole d'effet..."
            say Super_Zen presentation=14 : "Hata Hata irradié... Humba!!! Humba!!!"
            say Super_Zen presentation=8 chatter : "Ca alors, Commander, il entame une danse de la reproduction, ce sont les radiations qui le mettent en transe..."
            say Super_Zen presentation=15 : "Chih rhak... Chih rhak... Qui rak..."
            say Super_Zen presentation=16 : "TO TO TO TO TO..."
            say Super_Zen presentation=8 chatter : "Ca y est Commander, IL NOUS L'A DIT!!!"
            say Super_Zen presentation=8 chatter : "Il nous l'a diiit, il nous l'a diiit..."
            say Super_Zen presentation=8 chatter : "Son code génétique c'est TO, Commander, 5 TO..."
            say Super_Zen presentation=8 chatter : "Retenez bien ce code: 5 TO..."
            say Super_Zen presentation=9 if_not_shown skip_next=3 : "Hooooom..."
            state_b1[Super_Zen.population] += 200
            state_b6[Super_Zen.evolution] += 100
            bits(atomique.flags,0x0040) = false
        }
        when {
            require bits(image.flags,0x0040)
        } then {
            when {
                require globals.A60 > 5
                require globals.A80 < 3
                require globals.A81 == 0
            } then {
                say Super_Zen presentation=9 if_not_shown skip_next=5 : "Hoooom image... Réflexion permet de sortir de la caverne..."
                globals.A80 += 1
                state_b1[Super_Zen.population] /= 2
                state_b5[Super_Zen.energy] += 100
                globals.B25 = 0
                bits(image.flags,0x0040) = false
            }
            when {
                require globals.A81 > 0
            } then {
                say Super_Zen presentation=9 if_not_shown skip_next=4 : "Hooom image|... Des idées me viennent|..."
                state_b1[Super_Zen.population] /= 2
                state_b5[Super_Zen.energy] += 100
                globals.B25 = 0
                bits(image.flags,0x0040) = false
            }
            when {
                require globals.A60 < 6
            } then {
                say Super_Zen presentation=9 : "Pas encore|... trop tot|..."
                say Super_Zen presentation=8 chatter if_not_shown skip_next=2 : "intéressant ca|, commander|..."
                image.holder = aboard
                bits(image.flags,0x0040) = false
            }
        }
        when {
            require bits(tableau.flags,0x0040)
        } then {
            say Super_Zen presentation=9 if_not_shown skip_next=2 : "Hoooom tableau..."
            state_b6[Super_Zen.evolution] += 20
            bits(tableau.flags,0x0040) = false
        }
        when {
            require bits(momie.flags,0x0040)
        } then {
            say Super_Zen presentation=9 if_not_shown skip_next=3 : "Hoooommm momie... Hare Hare..."
            state_b5[Super_Zen.energy] += 50
            globals.B25 = 0
            bits(momie.flags,0x0040) = false
        }
        when {
            require bionium.holder != Super_Zen
            require !bits(Marakas.flags,0x0004)
        } then {
            say Super_Zen presentation=8 chatter : "Commander, ma petite puce me dit que Super Zen a quelque chose à nous révéler..."
            say Super_Zen presentation=12 : "Il est vrai que Grand Yolk m'a confié de quoi vous aider dans votre entreprise..."
            dictionary blank after "aider"
            say Super_Zen presentation=8 chatter : "Vous l'entendez|? Il veut qu'on lui donne quelque chose..."
            say Super_Zen presentation=13 : "Oh! Rien de bien difficile à trouver... Daddy Gluxx a déjà du vous en parler..."
            say Super_Zen presentation=8 chatter : "la double porte|?..."
            say Super_Zen presentation=10 : "Hooom..."
        }
        when {
            require !bits(Marakas.flags,0x0004)
            require bits(bionium.flags,0x0040)
        } then {
            say Super_Zen presentation=11 : "Hoooooooooom BIONIUM... Turbo Zen..."
            say Super_Zen presentation=12 : "AAAAAAhhh!!!"
            say Super_Zen presentation=8 chatter : "Commander il se passe quelque chose..."
            say Super_Zen presentation=19 : "TO TO|..."
