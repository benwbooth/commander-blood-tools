    proc arch enabled {
    } then {
        Arche.known = true
        arch.enabled = false
    }
    proc intro01 enabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "Hello Commander, ici HONK votre fidéle ordinateur de bord."
        say Honk presentation=8 chatter : "Je suis content de vous revoir, vous avez bonne mine Commander|..."
        say Honk presentation=8 chatter resume_at=intro01_dialogue_resume_1 : "Que desirez-vous|?" choices "JOUER" "EXPLICATIONS"
        when {
            require choice == "JOUER"
        } then {
            say Honk presentation=8 chatter if_not_shown skip_next=3 : "OK Commander|..."
            Bob_Morlock.current_location = Trashlando
            run profile SCRIPT2
            choice = none
        }
        when {
            require choice == "EXPLICATIONS"
        } then {
            choice = none
        }
        intro01_dialogue_resume_1:
        say Honk presentation=8 chatter if_not_shown skip_next=1 : "Le pauvre Monsieur Bob a laissé un message enregistré pour vous dans la cryobox|..."
        dictionary blank after "la"
        Bob_Morlock.current_location = aboard
        say Honk presentation=8 chatter : "Pauvre Monsieur Bob... Il était si bon, si généreux, si vivant, si... si beau|......"
        say Honk presentation=8 chatter : "Finir comme ça... C'est une grande perte pour nous tous|..."
        say Honk presentation=8 chatter : "Sentant sa fin proche, le pauvre Monsieur Bob vous a endormi,"
        dictionary blank after "endormi,"
        say Honk presentation=8 chatter : "Puis il a pris la navette de secours... Et il est parti, tout seul... Je n'ai pas pu le retenir|..."
        say Honk presentation=8 chatter : "Nous avons dérivé dans l'espace-temps pendant des lustres."
        say Honk presentation=8 chatter : "Nous sommes proches du Bigbang, tout ce que nous avons vécu dans le futur est effacé"
        say Honk presentation=8 chatter : "L'univers n'existe quasiment plus. Monsieur Bob vous donne l'ordre de le reconstruire..."
        say Honk presentation=8 chatter : "Vous devez refaire tout le scénario|..."
        dictionary blank after "Vous"
        say Honk presentation=8 chatter : "Oui Commander, nous devons reconstruire l'UNIVERS. Recréer les races et les faire évoluer"
        dictionary blank after "évoluer"
        say Honk presentation=8 chatter : "Commander, puis-je vous confier un secret|?..."
        say Honk presentation=8 chatter : "Je suis excité... Hi! Hi! Hi! Mes vérins me démangent|..."
        say Honk presentation=8 chatter : "Nous avons un GLUXX dans la cryobox, Monsieur Bob y tenait|..."
        say Honk presentation=8 chatter if_not_shown skip_next=1 : "Au fait j'oubliais, regardez dans la cryobox, Monsieur BOB vous a laissé quelque chose|..."
        say Honk presentation=8 chatter : "A bientot, Commander|..."
        say Honk presentation=8 if_not_shown skip_next=2 : "Ciao"
        intro01.enabled = false
        end presentation Honk
    }
    proc bob enabled {
        during contact
        require globals.A64 == 0
        require globals.B81 == 0
        require presentation == Bob_Morlock
    } then {
        say Bob_Morlock presentation=13 : "Aaaah!"
        say Bob_Morlock presentation=10 : "Bonjour Commander. Ceci est un message enregistré."
        say Bob_Morlock presentation=11 : "Au moment ou vous verrez ces images, je serai probablement MORT|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "LA MORT|..."
        dictionary blank after "LA"
        request sequence "maledict.hnm"
        say Bob_Morlock presentation=12 : "Tout a une fin... La vie, l'amour, l'espace|..."
        say Bob_Morlock presentation=13 : "Nous sommes tous des poussiéres d'étoile|..."
        say Bob_Morlock presentation=14 : "Au moment ou vous verrez ces images, l'univers aura disparu, car vous serez proche du BIGBANG"
        say Bob_Morlock presentation=15 : "Commander, votre mission consiste désormais à recréer l'univers."
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "Un nouvel univers|..."
        request sequence "explbleu.hnm"
        say Bob_Morlock presentation=16 : "Car si vous recréez un univers cohérent, vous finirez par me recréer, MOI|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "Ainsi vous voilà grand scénariste de la Vie|... de MA Vie|!..."
        request sequence "boba2.hnm"
        say Bob_Morlock presentation=11 : "Votre mission est simple, il faut me RECREER|..."
        say Bob_Morlock presentation=10 : "Comme je suis un étre hyper évolué, vous devez développer l'univers au maximum de sa complexité|..."
        say Bob_Morlock presentation=11 : "Honk vous expliquera la procédure|..."
        say Bob_Morlock presentation=17 : "Je vous ai laissé un GLUXX dans la cryobox|..."
        say Bob_Morlock presentation=10 if_not_shown skip_next=1 : "Il vous servira de graine pour recréer la Vie|..."
        Daddy_Gluxx.current_location = aboard
        say Bob_Morlock presentation=16 : "Pour mener votre mission à bien, ce n'est pas de chance dont vous aurez besoin|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "Mais d'intelligence|!..."
        request sequence "brouil.hnm"
        say Bob_Morlock presentation=9 : "...pour lutter contre les bugs et les virus que le CHAOS vous enverra|!..."
        say Bob_Morlock presentation=10 : "Méfiance|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "Car vos ennemis seront puissants|..."
        request sequence "match07.hnm"
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "Et vos amis ambigus|..."
        request sequence "aready20.hnm"
        say Bob_Morlock presentation=11 : "Adieu Commander, l'Ombre m'atteint|... Mon jour terrestre diminue|..."
        say Bob_Morlock presentation=10 : "Le passé est passé et l'avenir n'est plus|..."
        say Bob_Morlock presentation=12 : "La main pauvre est sur moi et voici l'heure nue|... Le moment est venu|..."
        say Bob_Morlock presentation=8 chatter : "NON NON!!! MONSIEUR BOB... NON!!!"
        say Bob_Morlock presentation=8 if_not_shown skip_next=1 : "N'oubliez jamais, nous sommes tous des poussiéres d'étoile|... A DIEU|..."
        request sequence "star2.hnm"
        say Bob_Morlock presentation=8 chatter : "OUINNN!!! C'est terrible... SNIF SNIF|..."
        say Bob_Morlock presentation=9 : "A Adieu|..."
        say Bob_Morlock presentation=8 if_not_shown skip_next=4 : "..."
        menu01.enabled = true
        scan01.enabled = true
        Bob_Morlock.current_location = Trashlando
        end presentation Bob_Morlock
    }
    proc scan01 disabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "Vous avez vu Commander... Pauvre Monsieur Bob... Il me manque|..."
        say Honk presentation=8 if_not_shown skip_next=3 : "..."
        scan01.enabled = false
        run profile SCRIPT2
        end presentation Honk
    }
    proc menu01 disabled {
        during bridge
        require presentation == menu
    } then {
        say menu presentation=8 : "KrouiiiK|..."
        say menu presentation=8 : "PROGRAMME METAGLUK VERSION 1043265 A"
        say menu presentation=8 : "Code de commande cyberpsy A 33 S"
        say menu presentation=8 : "Température: 33 degrés."
        say menu presentation=8 : "Processeur OLGA P6: on"
        say menu presentation=8 resume_at=menu01_dialogue_resume_1 : "Ici OLGA P6, ex-biorédactrice. Tapez votre commande." choices "bionium" "uranium" "géranium"
        dictionary blank after "bionium"
        when {
            require choice != "géranium"
        } then {
        }
        choice = none
        menu01_dialogue_resume_1:
        say menu presentation=8 : "OLGA P6:"
        say menu presentation=8 : "Bien reçu"
        say menu presentation=8 : "Ordre de connexion établi|..."
        say menu presentation=8 : "pkunzip bobprg.exe"
        say menu presentation=8 : "...|...|...|...|...|...|...|...|...|...|...|...|...|...|...|...|..."
        say menu presentation=8 : "OLGA P6 au rapport:"
        say menu presentation=8 resume_at=menu01_dialogue_resume_2 : "Tapez \"RUN\"" choices "run"
        when {
            require choice != "run"
        } then {
        }
        choice = none
        menu01_dialogue_resume_2:
        say menu presentation=8 : "OLGA P6 au rapport"
        say menu presentation=8 : "Vous venez de taper RUN"
        say menu presentation=8 chatter : "Ici Honk|..."
        say menu presentation=8 chatter : "Qu'est ce qui se passe ici|..."
        say menu presentation=8 chatter : "Commander, vous n'avez rien à faire ici|..."
        say menu presentation=8 chatter : "Le programme OLGA P6 de la Biorédactrice de Bord est naze et plein de bugs|..."
        say menu presentation=8 chatter : "Vous perdez votre temps, Commander... D'ailleurs je vais la transformer en DATA BANK|..."
        say menu presentation=8 : "OLGA P6 au rapport"
        say menu presentation=8 : "Vous avez tapé RUN, votre commande est rejetée|..."
        say menu presentation=8 : "Renouvelez votre appel ultérieurement."
        say menu presentation=8 chatter : "Gna.. Gna... Gna|..."
        say menu presentation=8 if_not_shown skip_next=3 : "..."
        honk01.enabled = true
        menu01.enabled = false
        end presentation menu
    }
    proc honk01 disabled {
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "Commander, j'ai transformé le programme OLGA P6|..."
        say Honk presentation=8 chatter : "Désormais la fonction \"MENU\" vous donnera l'état de vos finances et de BIONIUM|..."
        say Honk presentation=8 chatter : "Je scanne actuellement les environs pour trouver des planétes viables|..."
        say Honk presentation=8 chatter : "C'est une vraie soupe primitive par ici|..."
        say Honk presentation=8 chatter : "Regardez sur la carte, je crois avoir détecté quelque chose|..."
        say Honk presentation=8 if_not_shown skip_next=2 : "..."
        end presentation Honk
        run profile SCRIPT2
    }
    proc dad enabled {
        during contact
        require globals.A64 == 0
        require presentation == Daddy_Gluxx
    } then {
        say Daddy_Gluxx presentation=8 : "Pchhhhh...."
        say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Daddy_Gluxx
    }
    proc mensecur enabled {
        during bridge
        require presentation == menu
    } then {
        say menu presentation=8 : "Krouik|..."
        say menu presentation=8 if_not_shown skip_next=1 : "..."
        end presentation menu
    }
    proc honsecur enabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=8 chatter : "Krouik|..."
        say Honk presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Honk
        halt
    }
}
