    proc papy01 enabled {
        during travel
        require presentation == Papy_Gluxx
    } then {
        when {
            require globals.A61 == 6
            require globals.A4 == 0
        } then {
            say Papy_Gluxx presentation=10 : "PAPY TE FAIT LA GREVE|!|..."
            say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Papy_Gluxx
        }
        when {
            require globals.A61 == 6
            require globals.A4 > 0
        } then {
            say Papy_Gluxx presentation=8 chatter : "hello papy, on vient renégocier ton contrat|..."
            say Papy_Gluxx presentation=10 : "Je suis muté sur ALIENS|?|..."
            say Papy_Gluxx presentation=8 chatter : "Non|... on t'augmente|..."
            say Papy_Gluxx presentation=8 chatter resume_at=papy01_dialogue_resume_1 : "commander, vous étes d'accord pour lui filer un crédit|?..." choices "ok" "jamais"
            when {
                require choice == "ok"
            } then {
                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "AUGMENTATION PAPY GLUXX|..."
                transfer credit from aboard to Papy_Gluxx
                globals.A4 -= 1
                say Papy_Gluxx presentation=11 : "Merci|! Quelle générosité|!|..."
                say Papy_Gluxx presentation=12 : "Et surtout quelle spontanéité|!|..."
                say Papy_Gluxx presentation=13 : "En gros, vous essayez de m'acheter|!|..."
                say Papy_Gluxx presentation=8 chatter : "aie aie aie|! c'est la gaffe|!|..."
                say Papy_Gluxx presentation=14 : "Là mon vieux, vous y avez droit|!|..."
                say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "GREVE GENERALE|!"
                request sequence "cliptoot.hnm"
                say Papy_Gluxx presentation=8 if_not_shown skip_next=5 : "..."
                globals.A61 = 7
                globals.A68 = 1
                globals.A65 = 1
                end presentation Papy_Gluxx
                choice = none
            }
            when {
                require choice == "jamais"
            } then {
                say Papy_Gluxx presentation=10 : "Affameur|! Bourreau d'enfants GLUXX|! Tu l'auras voulu|!|..."
                say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "GREVE GENERALE|!|..."
                request sequence "cliptoot.hnm"
                say Papy_Gluxx presentation=8 if_not_shown skip_next=4 : "..."
                globals.A61 = 7
                globals.A68 = 1
                end presentation Papy_Gluxx
                choice = none
            }
        }
        papy01_dialogue_resume_1:
        when {
            require globals.A68 == 1
        } then {
            say Papy_Gluxx presentation=9 : "Papy Grève|..."
            say Papy_Gluxx presentation=8 chatter : "des revendications|?|..."
            say Papy_Gluxx presentation=10 : "Ben non|... Juste Papy Grève|..."
            say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Papy_Gluxx
        }
        when {
            require Papy_Gluxx.encounter_count == 1
        } then {
            say Papy_Gluxx presentation=9 : "Moi PAPY GLUXX|... Moi nouveau chef de colonie|..."
            say Papy_Gluxx presentation=17 : "Salut Commander|... Nous venons d'immigrer sur cette planète|..."
        }
        text_tokens Papy_Gluxx presentation=11 : "Nous" state_number(0x0CCE) "Gluxx" "sur" "cette" "planète..."
        when {
            require globals.A54 == 1
        } then {
            say Papy_Gluxx presentation=8 chatter : "bonjour professeur|... on est bien embété|..."
            say Papy_Gluxx presentation=12 : "Qu'est-ce qui se passe|?|... Tirez la langue pour voir|..."
            dictionary blank after "Qu'est-ce"
            say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Beuarkkkk|..."
            request sequence "p_cles.hnm"
            say Papy_Gluxx presentation=13 : "Oulà|! Elle est chargée|!|..."
            say Papy_Gluxx presentation=8 chatter : "c'est pas nous le probléme|... c'est ben zen|..."
        }
        when {
            require medicament.holder != aboard
        } then {
            say Papy_Gluxx presentation=18 : "Nous fabriquons formidable médecine pour guérir|..."
            when {
                require globals.A54 == 1
            } then {
                say Papy_Gluxx presentation=8 chatter : "ben ça tombe bien|, alors|..."
            }
            when {
                require Papy_Gluxx.encounter_count == 2
            } then {
                say Papy_Gluxx presentation=8 chatter : "alors|, gluxxenberg|..."
                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "ça avance|..."
                request sequence "marcomb.hnm"
                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "la recherche contre le concert|?..."
                request sequence "lpm5sc1.hnm"
                say Papy_Gluxx presentation=9 : "Mais quel concert|?..."
                say Papy_Gluxx presentation=8 chatter : "laisse tomber|!..."
            }
            when {
                require Papy_Gluxx.encounter_count == 3
            } then {
                say Papy_Gluxx presentation=8 chatter : "est-ce que ça soigne|..."
                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "le mal de téte|?..."
                request sequence "brouil.hnm"
                say Papy_Gluxx presentation=13 : "Evidemment|... Ca soigne tout|!..."
                say Papy_Gluxx presentation=8 chatter : "non parce que|... voilà je me sens pas très bien|..."
                say Papy_Gluxx presentation=14 : "Faites voir votre langue|..."
                say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "Na Na Na Na Né Reu|!|..."
                request sequence "ppit07.hnm"
                say Papy_Gluxx presentation=12 : "Elle est un peu chargée|!|..."
            }
            when {
                require Papy_Gluxx.encounter_count == 4
            } then {
                say Papy_Gluxx presentation=8 chatter : "l'écran fait mal aux yeux du commander|, docteur|..."
                say Papy_Gluxx presentation=10 : "Je vais vous faire un examen|..."
                say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "Du fond de l'oeil|..."
                request sequence "ppitbb01.hnm"
                say Papy_Gluxx presentation=8 chatter : "encore l'autre pirate|!|..."
            }
            when {
                require Papy_Gluxx.encounter_count == 5
            } then {
                say Papy_Gluxx presentation=8 chatter : "mal aux yeux|, docteur|..."
                say Papy_Gluxx presentation=8 chatter : "vous croyez que c'est|..."
                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "le concert|..."
                request sequence "lpm4sc1.hnm"
                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "de l'oeil|?|..."
                request sequence "boba2.hnm"
                say Papy_Gluxx presentation=14 : "Ah|! J'ai vu l'oeil de monsieur BOB|!|..."
            }
            when {
                require Papy_Gluxx.encounter_count == 1
            } then {
                say Papy_Gluxx presentation=8 chatter : "mais|... c'est le célèbre professeur gluxxenberg|!|..."
                say Papy_Gluxx presentation=9 : "Lui-méme|... Enchanté|..."
                say Papy_Gluxx presentation=15 : "Nous vous vendons médicaments contre crédit|..."
                say Papy_Gluxx presentation=8 chatter : "c'est pour quoi cet argent|?|..."
                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "c'est pour la recherche contre le concert|?|..."
                request sequence "lpm4sc1.hnm"
                say Papy_Gluxx presentation=9 : "Quoi|?..."
                say Papy_Gluxx presentation=8 chatter : "laisse tomber|..."
            }
            when {
                require globals.A4 == 0
            } then {
                say Papy_Gluxx presentation=8 chatter : "Aie|!!! Nous n'avons plus de crédits, Commander|..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Papy_Gluxx presentation=8 chatter resume_at=papy01_dialogue_resume_2 : "Vous acceptez de leur acheter des médicaments, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Papy_Gluxx
                    globals.A4 -= 1
                    say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION MEDICAMENTS DANS CRYOBOX"
                    transfer medicament from Papy_Gluxx to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
            papy01_dialogue_resume_2:
            when {
                random_guard 0x0002
            } then {
                say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "Tenez|! Un petit Gluxxronzan pour la route|!|..."
                transfer energie from Papy_Gluxx to aboard
            }
        }
    }
    proc donn3 enabled {
        during travel
        require presentation == Papy_Gluxx
    } then {
