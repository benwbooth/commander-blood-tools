    proc rendpret enabled {
        during travel
        require presentation == Daddy_Gluxx
    } then {
        when {
            require globals.A17 == 4
        } then {
            say Daddy_Gluxx presentation=15 : "Nous avons une dette envers vous Commander|..."
            say Daddy_Gluxx presentation=16 : "Vous avez prété de l'argent aux Gluxx|..."
            say Daddy_Gluxx presentation=14 if_not_shown skip_next=1 : "Voici un crédit d'intérét|..."
            transfer credit from Daddy_Gluxx to aboard
            say Daddy_Gluxx presentation=8 chatter : "Commander, Commander, ils nous filent du fric sans qu'on leur demande|..."
            say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "Ca nous fera de l'argent de poche|..."
            globals.A4 += 1
            globals.A17 = 5
        }
        when {
            require globals.A17 == 3
        } then {
            say Daddy_Gluxx presentation=15 : "Nous avons une énorme dette envers vous, Commander|..."
            say Daddy_Gluxx presentation=16 : "Tout cet argent que vous nous avez prété|..."
            say Daddy_Gluxx presentation=8 chatter : "Ils vont nous retaper du fric, vous allez voir|..."
            say Daddy_Gluxx presentation=14 if_not_shown skip_next=1 : "Pas du tout|... Voici 5 crédits, plus 5 d'intérét|... encore merci|..."
            transfer credit from Daddy_Gluxx to aboard
            say Daddy_Gluxx presentation=8 chatter : "QUOI|!!! COMMANDER|!!! C'EST LA FORTUNE|!!!"
            say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "Sacrés Gluxx|... J'ai toujours dit qu'ils avaient une bonne téte|..."
            dictionary blank after "bonne"
            globals.A4 += 10
            globals.A17 = 6
        }
        when {
            require globals.A4 < 5
            require globals.A17 == 5
        } then {
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            globals.A17 = 4
        }
        when {
            require globals.A4 < 10
            require globals.A17 == 6
        } then {
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            globals.A17 = 3
        }
    }
    proc pret enabled {
        during travel
        require presentation == Daddy_Gluxx
    } then {
        when {
            require globals.A17 == 0
        } then {
            say Daddy_Gluxx presentation=11 : "Nous avoir besoin de crédit pour lancer économie sur planète|..."
            say Daddy_Gluxx presentation=8 chatter : "Economie|... déjà|?|!|?|... Il évolue à fond, le grand mou à grosses loches|..."
            say Daddy_Gluxx presentation=8 chatter : "Tu parles, qu'il évolue|... C'est surtout qu'il veut nous taper du fric|!|..."
            say Daddy_Gluxx presentation=13 : "Toi préter crédit à tribu Gluxx|..."
            say Daddy_Gluxx presentation=8 chatter : "On fait pas crédit au jarret bouilli|..."
            say Daddy_Gluxx presentation=14 : "Allez, quoi! Toi préter, toi riche, un jour roue tourner, moi riche et moi te rendre..."
            when {
                require globals.A4 == 0
            } then {
                say Daddy_Gluxx presentation=8 chatter : "Ben justement, nous problème, Monsieur Gluxx|... On est fauché, pas vrai Commander???"
            }
            when {
                require globals.A4 > 0
            } then {
                say Daddy_Gluxx presentation=8 chatter resume_at=pret_dialogue_resume_1 : "Commander, qu'est-ce qu'on fait, on lui préte, ce crédit?" choices "préter" "refuser"
                when {
                    require choice == "préter"
                } then {
                    say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Je vous trouve bien bon, Commander|... On lui envoie un crédit|... Rien qu'un..."
                    transfer credit from aboard to Daddy_Gluxx
                    say Daddy_Gluxx presentation=14 : "Oh merci, Commander, nous n'oublierons jamais|... Tu es bon, Tu es généreux, Tu..."
                    say Daddy_Gluxx presentation=8 chatter : "Tu tu tu|... Ok|! Ca va, ça va, Monsieur Gluxx, n'en rajoutez pas|..."
                    say Daddy_Gluxx presentation=8 if_not_shown skip_next=3 : "..."
                    globals.A4 -= 1
                    globals.A17 = 1
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    say Daddy_Gluxx presentation=8 chatter : "Vous étes vraiment rat, Commander. Vous le paierez, vous verrez|!|..."
                    say Daddy_Gluxx presentation=8 chatter : "D'ailleurs, tiens, je leur donne tout ce qu'on a, pour vous apprendre la générosité|!"
                    say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=3 : "OK! Je plaisante|... J'ai tout donné sauf un crédit, Commander|..."
                    globals.A4 = 1
                    globals.A17 = 2
                    choice = none
                }
            }
        }
        pret_dialogue_resume_1:
        when {
            require globals.A17 < 3
            require globals.A4 > 0
        } then {
            say Daddy_Gluxx presentation=11 : "Il nous faudrait encore un crédit, s'il vous plait, Commander|..."
            say Daddy_Gluxx presentation=8 chatter : "Ils commencent à exagérer, ces faces de glauques|! On veut bien étre généreux..."
            say Daddy_Gluxx presentation=8 chatter : "Mais y a des limites|... On n'est pas riche comme Yolk|!"
            say Daddy_Gluxx presentation=9 : "Toute ma tribu se joint à moi pour vous supplier|..."
            say Daddy_Gluxx presentation=15 : "... de nous faire ce prét, nécessaire pour notre équilibre|..."
            say Daddy_Gluxx presentation=12 : "... budgétaire|..."
            say Daddy_Gluxx presentation=8 chatter resume_at=pret_dialogue_resume_2 : "Il nous pipeaute, Commander, qu'est-ce qu'on fait|?" choices "préter" "refuser"
            when {
                require choice == "préter"
            } then {
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "TELEPORTATION CREDIT DADDY COOL|..."
                transfer credit from aboard to Daddy_Gluxx
                say Daddy_Gluxx presentation=10 : "Merci beaucoup, Commander, Yolk vous le rendra!"
                say Daddy_Gluxx presentation=8 chatter : "Tu parles|... On est ruiné, Commander|... Zéro crédit|..."
                say Daddy_Gluxx presentation=8 if_not_shown skip_next=4 : "..."
                globals.A4 = 0
                globals.A17 = 3
                end presentation Daddy_Gluxx
                choice = none
            }
            when {
                require choice == "refuser"
            } then {
                say Daddy_Gluxx presentation=8 chatter : "Vous avez bien raison, Commander, il nous reste plus grand chose|..."
                say Daddy_Gluxx presentation=8 if_not_shown skip_next=3 : "..."
                globals.A17 = 4
                end presentation Daddy_Gluxx
                choice = none
            }
        }
        pret_dialogue_resume_2:
        say Daddy_Gluxx presentation=10 : "Merci de votre visite, Commander, vous serez toujours le bienvenu|..."
        say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Daddy_Gluxx
    }
    proc pygre enabled {
        during bridge
        require globals.A61 == 5
        require presentation == Papy_Gluxx
    } then {
