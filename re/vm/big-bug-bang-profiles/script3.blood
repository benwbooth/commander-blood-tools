    proc glut enabled {
        during bridge
        require Daddy_Gluxx.current_location == aboard
        require presentation == Daddy_Gluxx
    } then {
        say Daddy_Gluxx presentation=8 chatter : "bravo|! joli doigté|!"
        say Daddy_Gluxx presentation=8 : "Aglo|! AGLO|!"
        say Daddy_Gluxx presentation=8 : "Algo!!! ALglO!!!... Beug|... Cryobeug|...KROUIK..."
        say Daddy_Gluxx presentation=8 chatter : "Ca coupe, commander|!..."
        say Daddy_Gluxx presentation=8 : "Krouik|... Reconnect|... Message prioritaire|..."
        say Daddy_Gluxx presentation=8 chatter : "la police du cyberspace|!..."
        say Daddy_Gluxx presentation=8 chatter : "ce n'est pas possible|! elle n'existe pas encore|!..."
        say Daddy_Gluxx presentation=8 : "Message extra-temporel prioritaire|... krouik|..."
        say Daddy_Gluxx presentation=8 chatter : "commander|! ce message vient du futur|!..."
        say Daddy_Gluxx presentation=8 : "Ce message vient du passé|..."
        say Daddy_Gluxx presentation=8 chatter : "... vient du passé|!..."
        say Daddy_Gluxx presentation=8 : "krouik|... ce message vient du futur|..."
        say Daddy_Gluxx presentation=8 : "Attention|! Voici le portrait-robot de l'assassin de Monsieur Bob|..."
        say Daddy_Gluxx presentation=8 : "Physique mou|... Caractère parfois extrémement violent|..."
        say Daddy_Gluxx presentation=8 : "Unique survivant de la Guerre Ultime|... Germe de chaos|..."
        say Daddy_Gluxx presentation=8 : "Prime de 100 000 000 de crédits si abattu|..."
        say Daddy_Gluxx presentation=8 chatter : "millions|! waow|! vous pourriez pas nous donner un acompte|?..."
        say Daddy_Gluxx presentation=8 if_not_shown skip_next=2 : "Voici deux crédits pour vos frais d'armement|..."
        credit.holder = aboard
        globals.A4 += 2
        say Daddy_Gluxx presentation=8 : "Méfiez-vous de lui, vicieux, très dangereux|... ARGH|!|... krouik|..."
        say Daddy_Gluxx presentation=8 chatter : "Commander ça a coupé..."
        say Daddy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
        globals.A44 = 1
        end presentation Daddy_Gluxx
    }
    proc gredad enabled {
        during bridge
        require globals.A61 == 3
        require presentation == Daddy_Gluxx
    } then {
        say Daddy_Gluxx presentation=8 : "krouik|..."
        say Daddy_Gluxx presentation=8 chatter : "allo|? maman c'est toi|?..."
        say Daddy_Gluxx presentation=8 : "Non|! C'est Daddy Gluxx|!..."
        dictionary blank after "Daddy"
        say Daddy_Gluxx presentation=8 chatter : "comment ça va mon vieux|?... ça évolue bien|?..."
        say Daddy_Gluxx presentation=8 : "On s'développe, on s'développe|..."
        say Daddy_Gluxx presentation=8 chatter : "bon|... tout va bien|, alors|..."
        say Daddy_Gluxx presentation=8 : "Ben|... Pas exactement|..."
        say Daddy_Gluxx presentation=8 chatter : "quoi|? vous voulez un crédit|?..."
        say Daddy_Gluxx presentation=8 : "C'est pas l'argent|... C'est le travail|... Ca peut plus durer, Commander|!..."
        say Daddy_Gluxx presentation=8 : "On est surexploité|! Moi j'ai déjà travaillé sur COMMANDER BLOOD, le jeu d'avant|..."
        say Daddy_Gluxx presentation=8 : "Je pensais avoir bien mérité mes vacances|..."
        say Daddy_Gluxx presentation=8 : "Mais non|! Je rempile|! Je dormais bien tranquille|! On me réveille et on me dit|..."
        say Daddy_Gluxx presentation=8 : "TU SERAS LA SEMENCE D'UN NOUVEL UNIVERS, PETIT|!..."
        dictionary blank after "D'UN"
        say Daddy_Gluxx presentation=8 : "Moi, je voulais juste me reposer un peu|..."
        say Daddy_Gluxx presentation=8 chatter : "commander, on n'aurait jamais dù lui donner l'écriture|..."
        say Daddy_Gluxx presentation=8 chatter resume_at=dadfin1 : "vous voulez que je le coupe|?" choices "oui" "non"
        when {
            require choice == "oui"
        } then {
            say Daddy_Gluxx presentation=8 : "krouik|..."
            say Daddy_Gluxx presentation=8 chatter : "voilà|... bon débarras|..."
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=3 : "..."
            globals.A61 = 4
            end presentation Daddy_Gluxx
            choice = none
        }
        when {
            require choice == "non"
        } then {
            say Daddy_Gluxx presentation=8 : "En plus, vous étes rien qu'un scénariste bidon|! Tu parles d'un nouveau jeu bien léché|!"
            say Daddy_Gluxx presentation=8 : "C'est tous les mémes personnages que dans COMMANDER BLOOD|!..."
            say Daddy_Gluxx presentation=8 : "SUREXPLOITES QU'ON EST|!... RIEN QUE DE LA RECUPERATION|!..."
            say Daddy_Gluxx presentation=8 chatter : "bon, ça suffit|! je le coupe|!..."
            say Daddy_Gluxx presentation=8 : "krouik|..."
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=3 : "..."
            globals.A61 = 4
            end presentation Daddy_Gluxx
            choice = none
        }
    }
    proc dadfin1 enabled {
        during contact
        require globals.A68 == 2
        require Daddy_Gluxx.current_location == aboard
        require presentation == Daddy_Gluxx
    } then {
        say Daddy_Gluxx presentation=10 : "J'me sens tout mou|..."
        say Daddy_Gluxx presentation=11 : "Mou|..."
        say Daddy_Gluxx presentation=12 : "Si mou|!..."
        say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "Il faut l'é-li-mi-ner|!..."
        request sequence "match02.hnm"
        say Daddy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
        globals.A13 += 3
        end presentation Daddy_Gluxx
    }
    proc gengl enabled {
        during contact
        require globals.A64 == 0
        require globals.DGECR == 0
        require presentation == Daddy_Gluxx
    } then {
        when {
            random_guard 0x0001
        } then {
            say Daddy_Gluxx presentation=9 : "Ageu rha... Mmmeuh"
            say Daddy_Gluxx presentation=8 chatter : "Il dit qu'il est dans le paté, il a le cervelet qui cogne..."
            say Daddy_Gluxx presentation=8 chatter : "sa téte me rappelle quelque chose, commander|... prudence|..."
            say Daddy_Gluxx presentation=8 chatter resume_at=gengl_dialogue_resume_1 : "souhaitez-vous tenter de lui parler avant de le téléporter|?" choices "oui" "non"
            when {
                require choice == "oui"
            } then {
                say Daddy_Gluxx presentation=10 : "Agueu Beug... Boum Boum|... Beug|..."
                say Daddy_Gluxx presentation=8 chatter : "Quoi|? il dit qu'il y a un bug|... je ne comprends pas très bien..."
                say Daddy_Gluxx presentation=8 chatter : "une histoire de guerre et de bug|... je vérifie|..."
                say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "NA NA Nè REU|!..."
                request sequence "ppit07.hnm"
                say Daddy_Gluxx presentation=8 chatter : "bon sang|! une blague de petit pit|! il vous a raconté qu'il y avait une guerre..."
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "désolé pour le bug, commander... il m'a piraté, je suis dépité..."
                choice = none
            }
            when {
                require choice == "non"
            } then {
                choice = none
            }
        }
        gengl_dialogue_resume_1:
        when {
            random_guard 0x0001
        } then {
            say Daddy_Gluxx presentation=8 chatter : "Bon, Commander. Reprenons depuis le début|..."
            say Daddy_Gluxx presentation=8 chatter : "Alors nous, on y croit aux extra-terrestres|..."
            say Daddy_Gluxx presentation=8 chatter resume_at=gengl_dialogue_resume_2 : "hein, c'est bien ça Commander?..." choices "bien-ça" "pas-ça"
            dictionary blank after "bien-ça"
            when {
                require choice == "bien_ça"
            } then {
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Pour de bon, Commander? On croit vraiment aux extramachins, là?"
                choice = none
            }
            when {
                require choice != "_ça"
            } then {
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "et ça alors|, c'est quoi|?..."
                choice = none
            }
        }
        gengl_dialogue_resume_2:
        when {
            random_guard 0x0001
        } then {
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "nanananana|... Chui nun straterrechtreu... nanananan... nun chtramachin euh|... chuignun chtrabidu leuh|... naninana... gnyen fou parchtou|... gna -!déborde gneu gn chnais plu qhgq quiq|... chtramidfj|...gnaça déborde,pauvcon,b,nbugbu..."
            request sequence "flitutr.hnm"
            say Daddy_Gluxx presentation=8 chatter : "Bon sang|! il m'a bousillé l'écran, le sale iti|!"
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=1 : "NA NA NA NA Nè REUH|!"
            request sequence "ppit07.hnm"
            say Daddy_Gluxx presentation=8 chatter : "encore un bug signé petit piteux|... pirate de mes skeuds|!"
            say Daddy_Gluxx presentation=8 chatter : "Bon, très bien, ça commence bien|..."
            say Daddy_Gluxx presentation=8 chatter resume_at=gengl_dialogue_resume_3 : "vous étes énervé|, commander|?..." choices "énervé" "cool"
            when {
                require choice != "cool"
            } then {
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "ne nous énervons pas|... faisons comme si de rien n'était..."
                choice = none
            }
            when {
                require choice != "énervé"
            } then {
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "c'est cool|, alors on continue|..."
                choice = none
            }
        }
        gengl_dialogue_resume_3:
        when {
            random_guard 0x0001
        } then {
            say Daddy_Gluxx presentation=8 chatter : "Monsieur Gluxx..."
            say Daddy_Gluxx presentation=8 chatter : "HE! MONSIEUR GLUXX! DUCHMOL! TU M'ENTENDS?"
            say Daddy_Gluxx presentation=8 chatter : "Eh! téte de jarret bouilli|!..."
            say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Vous réalisez que vous étes la semence d'un nouvel univers, Monsieur Gluxx?"
            request sequence "expla001.hnm"
            say Daddy_Gluxx presentation=9 : "Ké|?|... KWA|?|..."
            say Daddy_Gluxx presentation=8 chatter resume_at=gengl_dialogue_resume_4 : "je lui répéte|, commander|?|..." choices "répéter" "ça_suffit"
            when {
                require choice != "ça_suffit"
            } then {
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "j'ai dit|: un nouvel univers|..."
                request sequence "explbleu.hnm"
                say Daddy_Gluxx presentation=10 : "HIN|?|... KWA|?|..."
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "il comprend vraiment que dalle|..."
                choice = none
            }
            when {
                require choice != "répéter"
            } then {
                choice = none
            }
        }
        gengl_dialogue_resume_4:
        when {
            random_guard 0x0001
        } then {
            say Daddy_Gluxx presentation=8 chatter : "Hé! Commander, il a pas inventé la poudre, hein|... Ha! Ha! Ha!"
            say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Quoique|... Il a l'air tellement mou|... il a du en sniffer pas mal|..."
            request sequence "star2.hnm"
            say Daddy_Gluxx presentation=10 : "Blurp|... Gasp|..."
            dictionary blank after "Gasp"
            say Daddy_Gluxx presentation=8 chatter resume_at=bigengl : "vous voulez savoir ce qu'il dit|?|..." choices "savoir" "m_en_fous"
            when {
                require choice != "m_en_fous"
            } then {
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Il dit qu'il va déposer une gerbe|... Beuark!"
                request sequence "p_cles.hnm"
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "En vrai, il dit qu'il veut aller sur une planète|... Quoi? Il est pas heureux dans notre frigo?"
                choice = none
            }
            when {
                require choice != "savoir"
            } then {
                choice = none
            }
        }
    }
    proc bigengl enabled {
        during contact
        require globals.A64 == 0
        require globals.DGECR == 0
        require presentation == Daddy_Gluxx
    } then {
        say Daddy_Gluxx presentation=8 chatter : "bon, ça tue les yeux, cet écran|... finissons-en|..."
        say Daddy_Gluxx presentation=8 chatter : "avant de devenir épileptique|!|..."
        say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Commander, j'ai repéré quelques planètes viables dans cette purée d'étoiles..."
        request sequence "nebul3a.hnm"
        say Daddy_Gluxx presentation=8 chatter : "bref|... des planètes|..."
        say Daddy_Gluxx presentation=8 chatter resume_at=daddy01 : "VOULEZ-VOUS QUE NOUS TELEPORTIONS DADDY GLUXX SUR:" choices "Tempest" "Vulcan" "Troma" "Lovia" "refuser"
        when {
            require choice == "Tempest"
        } then {
            say Daddy_Gluxx presentation=8 chatter : "TELEPORTATION DADDY GLUXX SUR PLANETE TEMPEST..."
            say Daddy_Gluxx presentation=14 : "Areu..."
            Papy_Gluxx.current_location = Templand
            Daddy_Gluxx.current_location = Templand
            Mamy_Gluxx.current_location = Templand
            bits(Daddy_Gluxx.flags,0x0004) = true
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Daddy_Gluxx
            choice = none
        }
        when {
            require choice == "Vulcan"
        } then {
            say Daddy_Gluxx presentation=8 chatter : "TELEPORTATION DADDY GLUXX SUR PLANETE VULCAN..."
            say Daddy_Gluxx presentation=16 : "Areu..."
            Mamy_Gluxx.current_location = Vulcland
            Papy_Gluxx.current_location = Vulcland
            Daddy_Gluxx.current_location = Vulcland
            bits(Daddy_Gluxx.flags,0x0004) = true
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Daddy_Gluxx
            choice = none
        }
        when {
            require choice == "Troma"
        } then {
            say Daddy_Gluxx presentation=8 chatter : "TELEPORTATION DADDY GLUXX SUR PLANETE TROMA..."
            say Daddy_Gluxx presentation=14 : "Gha..."
            Mamy_Gluxx.current_location = Tromaland
            Papy_Gluxx.current_location = Tromaland
            Daddy_Gluxx.current_location = Tromaland
            bits(Daddy_Gluxx.flags,0x0004) = true
            say Daddy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
            end presentation Daddy_Gluxx
            choice = none
        }
        when {
            require choice == "Lovia"
        } then {
            say Daddy_Gluxx presentation=8 chatter : "TELEPORTATION DADDY GLUXX SUR PLANETE LOVIA..."
            say Daddy_Gluxx presentation=17 : "Ggg..."
            Mamy_Gluxx.current_location = Loviland
            Papy_Gluxx.current_location = Loviland
            Daddy_Gluxx.current_location = Loviland
