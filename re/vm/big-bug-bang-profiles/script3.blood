        say Papy_Gluxx presentation=8 chatter : "des revendications|!|..."
        say Papy_Gluxx presentation=8 : "Sinon on fait gréve|!|..."
        say Papy_Gluxx presentation=8 chatter resume_at=pygre_dialogue_resume_1 : "commander, acceptez-vous de les satisfaire|?..." choices "oui" "non"
        when {
            require choice == "oui"
        } then {
            say Papy_Gluxx presentation=8 : "Merci, Commander|! C'est sympa, mais on va quand méme faire gréve|..."
            say Papy_Gluxx presentation=8 chatter : "mais|..."
            say Papy_Gluxx presentation=8 : "Pas de mais|!|... On est crevé, ça nous fera des vacances|!|..."
            say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
        when {
            require choice == "non"
        } then {
            say Papy_Gluxx presentation=8 : "Exploiteur|! Attrape-Gluxx|! Bug|!|..."
            say Papy_Gluxx presentation=8 chatter : "un peu d'élégance, mon brave|!|..."
            say Papy_Gluxx presentation=8 : "Elégance|! Tu peux te la mettre dans le gluxx ton élégance|!|..."
            say Papy_Gluxx presentation=8 chatter : "oh|!|..."
            say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            choice = none
        }
        pygre_dialogue_resume_1:
        say Papy_Gluxx presentation=8 : "BON BEN C'EST LA GREVE|!|..."
        say Papy_Gluxx presentation=8 chatter : "quoi|?|..."
        say Papy_Gluxx presentation=8 : "Ne me demandez pas, je suis en gréve|..."
        say Papy_Gluxx presentation=8 : "krouik|..."
        say Papy_Gluxx presentation=8 chatter : "commander, il reste une seule solution pour éviter le pire|..."
        say Papy_Gluxx presentation=8 chatter : "il faut leur proposer de l'argent|..."
        say Papy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
        end presentation Papy_Gluxx
        globals.A61 = 6
    }
