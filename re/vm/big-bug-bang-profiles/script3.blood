            say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=5 : "Ne la regardez pas trop|... Vous allez vous abimer les yeux|... Commander, ça va pas plaire a sa femelle..."
            state_b1[Papy_Gluxx.population] /= 4
            globals.B96 += 1
            state_b5[Papy_Gluxx.energy] += 100
            globals.B22 = 0
            bits(image.flags,0x0040) = false
        }
