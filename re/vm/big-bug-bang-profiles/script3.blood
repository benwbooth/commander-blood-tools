        } then {
            say Papy_Gluxx presentation=9 if_not_shown skip_next=3 : "Des optiques, on va pouvoir étudier le ciel|..."
            state_b6[Papy_Gluxx.evolution] += 40
            globals.B22 += 1
            bits(optique.flags,0x0040) = false
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=15 if_not_shown skip_next=2 : "De l'énergie à l'état pur|..."
            state_b5[Papy_Gluxx.energy] = 1000
            bits(energie.flags,0x0040) = false
        }
        when {
            require bits(bague.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=14 if_not_shown skip_next=4 : "Une bague, je vais l'offrir à ma femelle|..."
            state_b6[Papy_Gluxx.evolution] += 10
            state_b1[Papy_Gluxx.population] += 250
            globals.B22 += 1
            bits(bague.flags,0x0040) = false
        }
        when {
            require bits(emetteur.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=11 if_not_shown skip_next=2 : "Un emetteur, je vais pouvoir espionner|..."
            state_b6[Papy_Gluxx.evolution] += 10
            bits(emetteur.flags,0x0040) = false
        }
        when {
            require bits(culture.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=17 if_not_shown skip_next=2 : "De la culture|..."
            state_b6[Papy_Gluxx.evolution] += 100
            bits(culture.flags,0x0040) = false
        }
        when {
            require bits(ecriture.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=11 if_not_shown skip_next=1 : "L'écriture, quel progrés, mais nous savons déja écrire, Commander|..."
            state_b6[Papy_Gluxx.evolution] = 100
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=14 if_not_shown skip_next=3 : "QUOI|!!! UN VAISSEAU SPATIAL|..."
            state_b6[Papy_Gluxx.evolution] += 30
            globals.B20 += 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=18 if_not_shown skip_next=4 : "Un traité|... Ca c'est bon pour faire la paix|..."
            state_b6[Papy_Gluxx.evolution] += 40
            Papy_Gluxx.aggressiveness /= 2
            globals.B21 = 0
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Papy_Gluxx presentation=9 if_not_shown skip_next=3 : "Ohhh|! des cadeaux|... Merci|! Merci|!"
            state_b6[Papy_Gluxx.evolution] += 10
            globals.B21 = 0
            bits(cadeaux.flags,0x0040) = false
        }
        say Papy_Gluxx presentation=8 chatter : "Quel objet désirez-vous donner à Papy, Commander?"
        say Papy_Gluxx presentation=8 chatter resume_at=pret2 : "DONNER:" choices inventory_choices
        say Papy_Gluxx presentation=8 chatter : "..."
    }
    proc pret2 enabled {
        during travel
        require presentation == Papy_Gluxx
    } then {
        when {
            require globals.A17 == 0
            require state_b6[Papy_Gluxx.evolution] > 100
        } then {
            say Papy_Gluxx presentation=13 : "Toi préter crédit a tribu gluxx..."
            when {
                require globals.A4 == 0
            } then {
                say Papy_Gluxx presentation=8 chatter : "Nous n'avons pas de crédits, Monsieur Gluxx|..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Papy_Gluxx presentation=8 chatter resume_at=pret2_dialogue_resume_1 : "Commander, on lui préte un crédit?" choices "préter" "refuser"
                when {
                    require choice == "préter"
                } then {
                    say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander|..."
                    transfer credit from aboard to Papy_Gluxx
                    globals.A4 -= 1
                    say Papy_Gluxx presentation=14 if_not_shown skip_next=5 : "Oh merci, Commander, on s'en souviendra|..."
                    globals.A6 = 1
                    globals.A17 = 1
                    globals.A10 = 1
                    end presentation Papy_Gluxx
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Comme vous voulez|..."
                    choice = none
                }
            }
        }
        pret2_dialogue_resume_1:
        when {
            require globals.A17 == 1
            require globals.A6 == 1
            require state_b6[Papy_Gluxx.evolution] > 500
        } then {
            say Papy_Gluxx presentation=15 : "Nous avons une dette envers toi Commander|..."
            say Papy_Gluxx presentation=16 : "Tu as prété des CREDITS aux Gluxx|..."
            say Papy_Gluxx presentation=14 : "Voici un crédit d'intérét|..."
            say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "Commander, Commander, ils nous filent un crédit sans qu'on leur demande|..."
            globals.A4 += 1
            transfer credit from Papy_Gluxx to aboard
        }
        say Papy_Gluxx presentation=9 : "Merci de ta visite, Commander, reviens quand tu veux|..."
        say Papy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Papy_Gluxx
    }
    proc magre enabled {
        during bridge
        require globals.A61 == 4
        require presentation == Mamy_Gluxx
    } then {
        say Mamy_Gluxx presentation=8 : "krouik|..."
        say Mamy_Gluxx presentation=8 : "Ici Mamy Gluxx|... Alors comme ça on raccroche au nez de mon petit|?|..."
        say Mamy_Gluxx presentation=8 chatter : "c'est|..."
        say Mamy_Gluxx presentation=8 : "Pas d'excuse|!|..."
        say Mamy_Gluxx presentation=8 : "Vous avez traité mon petit comme un Migrax|! Aprés tout ce qu'il a fait pour vous|!|..."
        say Mamy_Gluxx presentation=8 chatter : "mais|!|..."
        say Mamy_Gluxx presentation=8 : "Pas de mais|! Il s'est tué au travail pour réaliser le plan BOB|!|..."
        say Mamy_Gluxx presentation=8 : "Il a appris à parler|! à migrer|! à téléphoner|!|... Tout ça pour votre sale BOB|!|..."
        say Mamy_Gluxx presentation=8 chatter : "calmez-vous, Mamy|! Vous allez vous rendre malade|!|..."
        say Mamy_Gluxx presentation=8 : "Esclavagiste|! Mon petiot a raison|! Votre jeu, c'est tout du déjà-vu|!|..."
        say Mamy_Gluxx presentation=8 : "Vieille technologie|! Humour zéro|! A peine interactif|!|..."
        say Mamy_Gluxx presentation=8 : "SCENARIO MINABLE|!|..."
        say Mamy_Gluxx presentation=8 chatter : "Olàlà|! a pas contente|!|..."
        say Mamy_Gluxx presentation=8 : "NON|! PAS CONTENTE|! krouik|!|..."
        dictionary blank after "NON"
        say Mamy_Gluxx presentation=8 chatter : "raccroché|!|..."
        say Mamy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
        globals.A61 = 5
        end presentation Mamy_Gluxx
    }
    proc crymam1 enabled {
        during contact
        require globals.A64 == 0
        require Mamy_Gluxx.current_location == aboard
        require presentation == Mamy_Gluxx
    } then {
        say Mamy_Gluxx presentation=9 : "Aaaah|... Chériiii|..."
        say Mamy_Gluxx presentation=9 : "Mon coeur|..."
        say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "EXPLOOOOOOOOSE|!..."
        request sequence "explroug.hnm"
        say Mamy_Gluxx presentation=8 chatter : "commander|! elle va mourir de plaisir|..."
        say Mamy_Gluxx presentation=8 chatter : "si elle reste à bord de l'arche|..."
        say Mamy_Gluxx presentation=8 chatter : "elle est trop vieille pour ça|... Ca va la tuer|!..."
        say Mamy_Gluxx presentation=10 : "Oh oui|, Commander|, tue-moi|... Fais-moi|..."
        say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Sauter|!..."
        transfer armes from Mamy_Gluxx to aboard
        say Mamy_Gluxx presentation=8 chatter : "il faut absolument la renvoyer chez elle|..."
        say Mamy_Gluxx presentation=8 chatter : "sinon vous aurez des nouvelles de monsieur bob|..."
        say Mamy_Gluxx presentation=8 chatter resume_at=mamfin1 : "vous la renvoyez dans le cyberspace|, commander|?" choices "renvoyer" "garder_ici"
        when {
            require choice == "renvoyer"
        } then {
            say Mamy_Gluxx presentation=8 chatter : "je l'envoie sur une planète que je viens de détecter|, commander|..."
            say Mamy_Gluxx presentation=14 : "Oh non|! Pas ça|!|..."
            say Mamy_Gluxx presentation=8 chatter : "TELEPORTATION MAMY SUR CYBORG|!|..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=8 : "..."
            end presentation Mamy_Gluxx
            Cyborg.active = true
            Cyborland.active = true
            Cyborg.known = true
            Cyborland.known = true
            Mamy_Gluxx.current_location = Cyborland
            bits(Mamy_Gluxx.flags,0x0004) = true
            choice = none
        }
        when {
            require choice == "garder_ici"
        } then {
            say Mamy_Gluxx presentation=8 chatter : "comme vous voudrez|, commander|..."
            say Mamy_Gluxx presentation=8 chatter : "mais ne dites pas que je ne vous aurai pas prévenu|!|..."
            say Mamy_Gluxx presentation=9 : "Mon amour|! Merci|! Nous vieillirons ensemble|!|..."
            say Mamy_Gluxx presentation=8 chatter : "ouais c'est ça|! surtout toi|, vieille peau|!|..."
            say Mamy_Gluxx presentation=8 chatter : "vous avez vu|, commander|?|... elle a cinq gants de toilette|..."
            say Mamy_Gluxx presentation=15 : "Nous mourrons ensemble mon amour|!|..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Ensemble|!|..."
            request sequence "maledict.hnm"
            say Mamy_Gluxx presentation=8 chatter : "Adieu commander|!..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "J'entends d'ici la colére de monsieur bob|!|..."
            request sequence "maledict.hnm"
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Alors petit|... Tu ne savais pas|..."
            request sequence "bobb.hnm"
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Tu ne savais pas que les relations entre|..."
            request sequence "bobb.hnm"
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Le scénariste et ses personnages doivent rester|..."
            request sequence "bobb.hnm"
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Purement platoniques|?|..."
            request sequence "crazys20.hnm"
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=3 : "..."
            end presentation Mamy_Gluxx
            globals.A13 = 2
            choice = none
        }
    }
    proc mamfin1 enabled {
        during contact
        require globals.A68 == 2
        require Mamy_Gluxx.current_location == aboard
        require presentation == Mamy_Gluxx
    } then {
        say Mamy_Gluxx presentation=10 : "Mama mia|!..."
        say Mamy_Gluxx presentation=11 : "Je suis trop vieille pour ces concerts|!..."
        say Mamy_Gluxx presentation=12 : "A la limite|, si c'était pour voir|..."
        say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Le Big BANG|!..."
        request sequence "star2.hnm"
        say Mamy_Gluxx presentation=8 if_not_shown skip_next=2 : "..."
        globals.A13 += 3
        end presentation Mamy_Gluxx
    }
    proc Mamy01 enabled {
        during travel
        require presentation == Mamy_Gluxx
    } then {
        when {
            require globals.A61 == 6
            require globals.A4 == 0
        } then {
            say Mamy_Gluxx presentation=12 : "MAMY FAIT LA GREVE|!..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Mamy_Gluxx
        }
        when {
            require globals.A61 == 6
            require globals.A4 > 0
        } then {
            say Mamy_Gluxx presentation=8 chatter : "bonsoir mamy|..."
            say Mamy_Gluxx presentation=15 : "Vous venez me présenter des excuses|?|..."
            say Mamy_Gluxx presentation=8 chatter : "oui mamy|... et vous offrir une augmentation|..."
            say Mamy_Gluxx presentation=14 : "Une|... augmentation d'espérance de vie|?|..."
            say Mamy_Gluxx presentation=8 chatter : "ah|... non|... pour ça, faut voir notre supérieur|..."
            say Mamy_Gluxx presentation=13 : "Amenez-le moi tout de suite|..."
            say Mamy_Gluxx presentation=8 chatter : "c'est que|... justement|... monsieur bob n'est plus|..."
            say Mamy_Gluxx presentation=12 : "... n'est plus quoi|?|..."
            say Mamy_Gluxx presentation=8 chatter : "n'est plus|..."
            say Mamy_Gluxx presentation=12 : "... plus quoi|? Finissez-en|!|..."
            say Mamy_Gluxx presentation=8 chatter : "ben c'est fini|! il n'est plus|!|..."
            say Mamy_Gluxx presentation=11 : "Excusez-moi, je ne savais pas|..."
            say Mamy_Gluxx presentation=8 chatter : "nous parlions d'une augmentation de salaire|..."
            say Mamy_Gluxx presentation=10 : "Oh|! Voyez ça avec les autres, moi ça ne m'intéresse pas|!|..."
            say Mamy_Gluxx presentation=8 chatter resume_at=Mamy01_dialogue_resume_1 : "commander, on insiste ou pas|?..." choices "non" "insister"
            when {
                require choice == "non"
            } then {
                say Mamy_Gluxx presentation=8 chatter : "bon|... bye bye|!|..."
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=4 : "..."
                globals.A68 = 1
                globals.A61 = 8
                end presentation Mamy_Gluxx
                choice = none
            }
            when {
                require choice == "insister"
            } then {
                say Mamy_Gluxx presentation=8 chatter : "permettez-moi d'insister|..."
                say Mamy_Gluxx presentation=9 : "C'est exaspérant|! Vous étes d'un lourdaud|! L'argent n'est rien pour moi|..."
                say Mamy_Gluxx presentation=10 : "Vous étes allé trop loin, Commander|... Tant pis pour vous|..."
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "GREVE GENERALE|!|..."
                request sequence "cliptoot.hnm"
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=5 : "..."
                end presentation Mamy_Gluxx
                globals.A65 = 1
                globals.A61 = 7
                globals.A68 = 1
                choice = none
            }
        }
        Mamy01_dialogue_resume_1:
        when {
            require globals.A68 == 1
        } then {
            say Mamy_Gluxx presentation=10 : "Mamy Grève|..."
            say Mamy_Gluxx presentation=8 chatter : "méme vous, mamy|?|..."
            say Mamy_Gluxx presentation=11 : "Oh ça me fait des vacances|! Monsieur BOB, je sais méme pas qui c'est|..."
            say Mamy_Gluxx presentation=8 chatter : "reposez-vous bien|, mamy|..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
            end presentation Mamy_Gluxx
        }
        when {
            require Mamy_Gluxx.encounter_count == 1
        } then {
            say Mamy_Gluxx presentation=9 : "Ici MAMY GLUXX|... Moi mére de tribu|..."
            say Mamy_Gluxx presentation=8 chatter : "mais|... commander|! c'est madame cinq|!|..."
            say Mamy_Gluxx presentation=17 : "Nous venons d'immigrer sur cette planéte|..."
        }
        when {
            require Mamy_Gluxx.encounter_count == 2
        } then {
            say Mamy_Gluxx presentation=10 : "Alors Commander|... On se proméne|?|..."
            say Mamy_Gluxx presentation=8 chatter resume_at=Mamy01_dialogue_resume_2 : "vous vous promenez|, commander|?..." choices "promenade" "pas_promenade"
            when {
                require choice == "promenade"
            } then {
                say Mamy_Gluxx presentation=11 if_not_shown skip_next=1 : "C'est bien|... Continuez|..."
                choice = none
            }
            when {
                require choice != "promenade"
            } then {
                say Mamy_Gluxx presentation=12 : "Commander chéri|! Tu es venu me voir exprès|!|..."
                say Mamy_Gluxx presentation=8 chatter : "commander|, vous avez un ticket|!|..."
                say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION TICKET DANS CRYOBOX|..."
                transfer ecriture from Mamy_Gluxx to aboard
                choice = none
            }
        }
        Mamy01_dialogue_resume_2:
        when {
            require Mamy_Gluxx.encounter_count == 3
        } then {
            say Mamy_Gluxx presentation=11 : "Commander|... J'ai une super recette|..."
            say Mamy_Gluxx presentation=12 : "Alors voilà|... Pour bien réussir le jarret bouilli|..."
            say Mamy_Gluxx presentation=13 : "Il faut quatre murfalos|..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Bon|... Et puis surtout|... BIEN FRAIS|!|... Elevés en plein air|!|..."
            request sequence "ettamorf.hnm"
            say Mamy_Gluxx presentation=14 : "Et encore mieux|..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Qu'on tue soi-méme|..."
            request sequence "explo3.hnm"
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Pas comme ces saloperies en conserve|!|..."
            request sequence "legion01.hnm"
            say Mamy_Gluxx presentation=13 : "Euh|... Je voulais dire|..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Pas comme ces saloperies en conserve|!|..."
            transfer nourriture from Mamy_Gluxx to aboard
            say Mamy_Gluxx presentation=9 : "Eh oh|! Ca t'intéresse ma recette ou pas|?|..."
            say Mamy_Gluxx presentation=8 chatter resume_at=Mamy01_dialogue_resume_3 : "vous aimez la cuisine|, commander|?..." choices "jarret" "pas_jarret"
            when {
                require choice == "jarret"
            } then {
                say Mamy_Gluxx presentation=9 : "Bon|... Donc|..."
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "aprés avoir tué les murfalos|..."
                transfer nourriture from aboard to Mamy_Gluxx
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Il faut les passer à la moulinette tout menu menu|..."
                request sequence "venthig.hnm"
                say Mamy_Gluxx presentation=14 : "Puis faire cuire dans le jus de sinox|..."
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Pendant la durée indiquée par votre robot boucher habituel|..."
                request sequence "rgbtr9.hnm"
                say Mamy_Gluxx presentation=13 : "Et aprés|... Eh ben aprés|..."
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Y a plus qu'à déguster|! Miam miam|!|..."
                request sequence "p_cles.hnm"
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
            when {
                require choice != "jarret"
            } then {
                say Mamy_Gluxx presentation=14 : "Tu sais pas ce que tu perds|, Commander|..."
                say Mamy_Gluxx presentation=8 chatter : "dommage|, commander|..."
                say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Ca sentait drolement bon|..."
                request sequence "parf1_2.hnm"
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
                choice = none
            }
        }
        Mamy01_dialogue_resume_3:
        when {
            require Mamy_Gluxx.encounter_count == 4
        } then {
            say Mamy_Gluxx presentation=9 : "Dis donc|, chéri|..."
            say Mamy_Gluxx presentation=10 : "Je réve ou tu viens me voir de plus en plus souvent|?|..."
            say Mamy_Gluxx presentation=11 : "Tu en pinces pour moi|, Commander|?|..."
            say Mamy_Gluxx presentation=8 chatter resume_at=Mamy01_dialogue_resume_4 : "vous en pincez pour elle|, commander|?..." choices "pincer" "pas_pincer"
            when {
                require choice == "pincer"
            } then {
                say Mamy_Gluxx presentation=12 : "Chéri|! Commander chéri|! Emmène-moi avec toi sur l'ARCHE!|..."
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "Fais-moi voir des étoiles|!|..."
                request sequence "star2.hnm"
                say Mamy_Gluxx presentation=8 chatter : "TELEPORTATION MAMY DANS CRYOBOX|..."
                say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=3 : "..."
                end presentation Mamy_Gluxx
                Mamy_Gluxx.current_location = aboard
                choice = none
            }
            when {
                require choice != "_pincer"
            } then {
                say Mamy_Gluxx presentation=12 : "Dommage Commander|... Nous aurions pu faire bien des choses ensemble|..."
                say Mamy_Gluxx presentation=8 chatter : "Dommage commander|... C'aurait pu étre|..."
                say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "vraiment space|..."
                request sequence "star2.hnm"
                choice = none
            }
        }
        Mamy01_dialogue_resume_4:
        text_tokens Mamy_Gluxx presentation=11 : "Nous" "étre" state_number(0x0C84) "Gluxx" "sur" "cette" "planéte" "..."
        when {
            require bits(Mamy_Gluxx.flags,0x0008)
        } then {
            say Mamy_Gluxx presentation=12 : "Moi étre en guerre, Commander, toi aider nous|..."
        }
        when {
            require parfum.holder != aboard
        } then {
            say Mamy_Gluxx presentation=13 : "Moi fabriquer parfum avec musc de murfalo|... Toi acheter parfum|..."
            say Mamy_Gluxx presentation=15 : "Pour un petit crédit|..."
            when {
                random_guard 0x0003
            } then {
                say Mamy_Gluxx presentation=8 chatter : "Pouah!!! Commander, quelle horreur|..."
            }
            when {
                require globals.A4 == 0
            } then {
                say Mamy_Gluxx presentation=8 chatter : "Nous n'avons plus de credits, Commander|..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Mamy_Gluxx presentation=8 chatter resume_at=donn4 : "Vous acceptez de lui acheter son parfum, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander"
                    transfer credit from aboard to Mamy_Gluxx
                    globals.A4 -= 1
                    say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "TELEPORTATION PARFUM DANS CRYOBOX|..."
                    transfer parfum from Mamy_Gluxx to aboard
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc donn4 enabled {
        during travel
        require presentation == Mamy_Gluxx
    } then {
        when {
            require bits(bionium.flags,0x0040)
            require !bits(Super_Zen.flags,0x0004)
            require Super_Zen.current_location != aboard
        } then {
            say Mamy_Gluxx presentation=14 : "Du Bionium|... Ahhhh|... Ohhhh|..."
            say Mamy_Gluxx presentation=14 : "Bionium|... Ahhh|..."
            say Mamy_Gluxx presentation=8 chatter : "Commander il se passe quelque chose|... Le BIONIUM lui fait de l'effet|..."
            say Mamy_Gluxx presentation=15 : "Rhaaaa|... OOOO|... 010011 01|..."
            say Mamy_Gluxx presentation=8 chatter : "Ca alors|... 0000 010011|... C'est du code génétique|..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Commander|! Le BIONIUM l'a mise dans un état d'hyperconscience multiplexée... elle nous donne un code génétique..."
            request sequence "venthig.hnm"
            say Mamy_Gluxx presentation=8 chatter : "C'est extraordinaire|..."
            say Mamy_Gluxx presentation=17 : "GA GA 0111010011|..."
            say Mamy_Gluxx presentation=8 chatter : "OUI allez-y Madame Gluxx|..."
            dictionary blank after "Madame"
            say Mamy_Gluxx presentation=11 : "GA GA GA GA|..."
            say Mamy_Gluxx presentation=8 chatter : "Ca y est on l'a: GA GA GA GA|... Quatre fois GA, c'est fastoche|..."
            say Mamy_Gluxx presentation=8 chatter : "comme olga|, complétement gaga|!|..."
            say Mamy_Gluxx presentation=8 chatter : "QUATRE GA|... Merci Madame Gluxx|... QUATRE GA, retenez bien ça, Commander..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "GA... Ca va mieux..."
            globals.vbio -= 1
            bits(bionium.flags,0x0040) = false
        }
        when {
            require bits(bionium.flags,0x0040)
            require bits(Super_Zen.flags,0x0004)
        } then {
            say Mamy_Gluxx presentation=16 : "Heuarque|!!! Heuarque|!!!"
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Commander, le BIONIUM, ça la fait tousser maintenant|..."
            bits(bionium.flags,0x0040) = false
        }
        when {
            require bits(atomique.flags,0x0040)
        } then {
            when {
                require state_b6[Mamy_Gluxx.evolution] < 100
            } then {
                say Mamy_Gluxx presentation=13 : "Toi donner étrange objet, étranger|... Atomique étre bon à manger|..."
                say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "Commander, c'est pas possible, elle va le bouffer|..."
                globals.A13 = 1
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Mamy_Gluxx.evolution] < 500
                require state_b6[Mamy_Gluxx.evolution] > 100
            } then {
                say Mamy_Gluxx presentation=10 if_not_shown skip_next=6 : "Des atomiques|... Oh|! Dangereux|..."
                state_b1[Mamy_Gluxx.population] /= 2
                state_b6[Mamy_Gluxx.evolution] += 200
                globals.B96 += 1
                Mamy_Gluxx.aggressiveness += 200
                globals.B22 -= 1
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Mamy_Gluxx.evolution] > 500
            } then {
                say Mamy_Gluxx presentation=11 if_not_shown skip_next=4 : "Des atomiques, quelle énergie extraordinaire|... Merci|!!!"
                state_b6[Mamy_Gluxx.evolution] += 200
                globals.B96 += 1
                state_b5[Mamy_Gluxx.energy] += 400
                bits(atomique.flags,0x0040) = false
            }
        }
        when {
            require bits(image.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=9 : "Pfff... Elle moche|... Catastrophe méme pas naturelle|..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=6 : "Aie Commander, elle va pas aimer..."
            state_b1[Mamy_Gluxx.population] /= 4
            state_b6[Mamy_Gluxx.evolution] += 200
            globals.B96 += 1
            Mamy_Gluxx.aggressiveness += 200
            globals.B22 = 0
            bits(image.flags,0x0040) = false
        }
        when {
            require bits(couronne.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=11 : "Une couronne, je vais étre Reine|..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=4 : "Commander, cette couronne va lui donner envie de commander|..."
            Mamy_Gluxx.aggressiveness += 200
            state_b5[Mamy_Gluxx.energy] += 200
            globals.B21 = 1
            bits(couronne.flags,0x0040) = false
        }
        when {
            require bits(tableau.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=12 : "Une peinture du Grand Yolk, mais c'est moi qui les peint|..."
            say Mamy_Gluxx presentation=8 chatter : "Mais oui, Commander, on est idiot|..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Quel gamin, ce Commander|..."
            bits(tableau.flags,0x0040) = false
        }
        when {
            require bits(momie.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=13 : "Une momie|... Je vais la mettre dans ma chambre|..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=4 : "C'est ça, Madame Gluxx|... Commander ça va effrayer son male|..."
            state_b5[Mamy_Gluxx.energy] += 100
            state_b1[Mamy_Gluxx.population] /= 200
            globals.B22 -= 1
            bits(momie.flags,0x0040) = false
        }
        when {
            require bits(technologie.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=15 if_not_shown skip_next=3 : "De la technologie, c'est passionnant|..."
            state_b6[Mamy_Gluxx.evolution] += 50
            globals.B20 += 1
            bits(technologie.flags,0x0040) = false
        }
        when {
            require bits(guitare.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=16 if_not_shown skip_next=6 : "Oh une guitare|... Mon mari va aimer ca|..."
            state_b6[Mamy_Gluxx.evolution] += 10
            state_b1[Mamy_Gluxx.population] += 300
            Mamy_Gluxx.aggressiveness -= 150
            globals.B22 += 1
            globals.B21 = 0
            bits(guitare.flags,0x0040) = false
        }
        when {
            require bits(credit.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=17 : "De l'argent|... Tu me donnes un crédit contre rien|!!!"
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=3 : "Commander vous étes complétement débile|..."
            globals.A17 = 1
            globals.A4 -= 1
            bits(credit.flags,0x0040) = false
        }
        when {
            require bits(parfum.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=18 : "Du parfum, merci beau Commander, mais j'en ai des tas|..."
            dictionary blank after "beau"
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "Elle en veut pas|... Commander|..."
            parfum.holder = aboard
            bits(parfum.flags,0x0040) = false
        }
        when {
            require bits(decodeur.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=10 : "Un décodeur, on va pouvoir regarder la télé|..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=4 : "Commander vous risquez de faire baisser la natalité|..."
            state_b6[Mamy_Gluxx.evolution] += 50
            state_b1[Mamy_Gluxx.population] -= 150
            globals.B22 = 1
            bits(decodeur.flags,0x0040) = false
        }
        when {
            require bits(nourriture.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=11 if_not_shown skip_next=2 : "De la nourriture, merci étranger|..."
            state_b5[Mamy_Gluxx.energy] += 500
            bits(nourriture.flags,0x0040) = false
        }
        when {
            require bits(medicament.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=9 if_not_shown skip_next=4 : "Des médicaments contre le ramollissement|..."
            state_b6[Mamy_Gluxx.evolution] += 10
            state_b1[Mamy_Gluxx.population] += 200
            globals.B22 += 1
            bits(medicament.flags,0x0040) = false
        }
        when {
            require bits(armes.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=12 if_not_shown skip_next=3 : "Des armes|... Merci, Commander"
            globals.B21 = 1
            Mamy_Gluxx.aggressiveness += 100
            bits(armes.flags,0x0040) = false
        }
        when {
            require bits(optique.flags,0x0040)
        } then {
            when {
                require !bits(Otto_Von_Smile.flags,0x0004)
            } then {
                say Mamy_Gluxx presentation=11 : "Eh oh|! Qu'est-ce que tu veux que je fasse de ça moi|?|..."
                say Mamy_Gluxx presentation=12 : "C'est vrai qu'on dirait qu'elle a cinq nibards|, ta lentille|!|..."
                say Mamy_Gluxx presentation=13 : "Mais bon c'est pas une raison pour essayer de me faire muter|!|..."
                say Mamy_Gluxx presentation=8 if_not_shown skip_next=4 : "..."
                end presentation Mamy_Gluxx
                Mamy_Gluxx.aggressiveness += 150
                optique.holder = aboard
                bits(optique.flags,0x0040) = false
            }
            when {
                require bits(Otto_Von_Smile.flags,0x0004)
            } then {
                say Mamy_Gluxx presentation=13 if_not_shown skip_next=4 : "Des optiques, on va pouvoir étudier le ciel|..."
                state_b6[Mamy_Gluxx.evolution] += 20
                globals.B21 = 1
                globals.B20 += 1
                bits(optique.flags,0x0040) = false
            }
        }
        when {
            require bits(energie.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=9 if_not_shown skip_next=2 : "De l'énergie à l'état pur|..."
            state_b5[Mamy_Gluxx.energy] = 1000
            bits(energie.flags,0x0040) = false
        }
        when {
            require bits(bague.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=10 if_not_shown skip_next=5 : "Une bague, je vais l'offrir à mon mari Hi|! Hi|! Hi|!|..."
            state_b6[Mamy_Gluxx.evolution] += 10
            state_b1[Mamy_Gluxx.population] += 300
            Mamy_Gluxx.aggressiveness -= 200
            globals.B22 += 1
            bits(bague.flags,0x0040) = false
        }
        when {
            require bits(emetteur.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=11 if_not_shown skip_next=2 : "Un émetteur, je vais pouvoir espionner|..."
            state_b6[Mamy_Gluxx.evolution] += 10
            bits(emetteur.flags,0x0040) = false
        }
        when {
            require bits(culture.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=12 if_not_shown skip_next=3 : "De la culture|..."
            state_b6[Mamy_Gluxx.evolution] += 100
            state_b5[Mamy_Gluxx.energy] += 100
            bits(culture.flags,0x0040) = false
        }
        when {
            require bits(ecriture.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=13 if_not_shown skip_next=2 : "L'écriture, quel progrés, mais nous savons déjà écrire, Commander|..."
            state_b6[Mamy_Gluxx.evolution] += 50
            bits(ecriture.flags,0x0040) = false
        }
        when {
            require bits(vaisseau.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=14 : "QUOI|!!! UN VAISSEAU SPATIAL|... MAIS ON EN A DEJA UN|!|..."
            say Mamy_Gluxx presentation=8 chatter : "réfléchissez un peu|, commander|, vous arrivez à me faire honte|..."
            say Mamy_Gluxx presentation=8 chatter : "devant des jarrets bouillis sous-évolués|!|..."
            say Mamy_Gluxx presentation=8 if_not_shown skip_next=4 : "..."
            vaisseau.holder = aboard
            state_b6[Mamy_Gluxx.evolution] += 30
            globals.B20 += 1
            bits(vaisseau.flags,0x0040) = false
        }
        when {
            require bits(trait_C3_A9.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=15 if_not_shown skip_next=5 : "Un traité|... Ca c'est bon pour faire la paix|..."
            state_b6[Mamy_Gluxx.evolution] += 30
            globals.B21 = 0
            Mamy_Gluxx.aggressiveness = 0
            state_b1[Mamy_Gluxx.population] += 200
            bits(trait_C3_A9.flags,0x0040) = false
        }
        when {
            require bits(cadeaux.flags,0x0040)
        } then {
            say Mamy_Gluxx presentation=16 if_not_shown skip_next=4 : "Ohhh des cadeaux|... Merci|! Merci|!"
            state_b6[Mamy_Gluxx.evolution] += 10
            state_b1[Mamy_Gluxx.population] += 150
            globals.B22 += 1
            bits(cadeaux.flags,0x0040) = false
        }
        say Mamy_Gluxx presentation=8 chatter : "Quel objet désirez-vous donner à Mamy, Commander?"
        say Mamy_Gluxx presentation=8 chatter resume_at=pret3 : "DONNER:" choices inventory_choices
        say Mamy_Gluxx presentation=8 chatter : ""
    }
    proc pret3 enabled {
        during travel
        require presentation == Mamy_Gluxx
    } then {
        when {
            require globals.A17 == 0
            require state_b6[Mamy_Gluxx.evolution] > 100
        } then {
            say Mamy_Gluxx presentation=13 : "Toi préter crédit à tribu Gluxx|..."
            when {
                require globals.A4 == 0
            } then {
                say Mamy_Gluxx presentation=8 chatter : "Nous n'avons pas de crédits, Madame Gluxx|..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Mamy_Gluxx presentation=8 chatter resume_at=pret3_dialogue_resume_1 : "Commander, on lui préte un crédit?" choices "préter" "refuser"
                when {
                    require choice == "préter"
                } then {
                    say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "On lui envoie un crédit, Commander|..."
                    transfer credit from aboard to Mamy_Gluxx
                    globals.A4 -= 1
                    say Mamy_Gluxx presentation=14 if_not_shown skip_next=5 : "Oh merci, Commander, on s'en souviendra|..."
                    globals.A6 = 1
                    globals.A17 = 1
                    globals.A10 = 1
                    end presentation Mamy_Gluxx
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Comme vous voulez|..."
                    choice = none
                }
            }
        }
        pret3_dialogue_resume_1:
        when {
            require globals.A6 == 1
            require globals.A17 == 1
            require state_b6[Mamy_Gluxx.evolution] > 100
        } then {
            say Mamy_Gluxx presentation=15 : "Nous avons une dette envers toi Commander|..."
            say Mamy_Gluxx presentation=16 : "Tu as prété des CREDITS aux Gluxx|..."
            say Mamy_Gluxx presentation=14 : "Voici un crédit d'intérét|..."
            say Mamy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "Commander, Commander, Ils nous filent un crédit sans qu'on leur demande|..."
            globals.A4 += 1
            transfer credit from Mamy_Gluxx to aboard
        }
        say Mamy_Gluxx presentation=9 : "Merci de ta visite, Commander, reviens quand tu veux|..."
        say Mamy_Gluxx presentation=8 if_not_shown skip_next=1 : "..."
        end presentation Mamy_Gluxx
        halt
    }
}
