            say Daddy_Gluxx presentation=15 : "Rhaaaa|... OOOO|... 010011 01|..."
            say Daddy_Gluxx presentation=8 chatter : "Ca alors|... 0000 010011|... C'est du code génétique|..."
            say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "Commander! Le BIONIUM l'a mis dans un état d'hyperconscience multiplexée|..."
            request sequence "venthig.hnm"
            say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "C'est extraordinaire|... on est dans son cerveau|... quelle nébuleuse|..."
            request sequence "nebul3a.hnm"
