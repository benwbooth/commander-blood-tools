                transfer bionium from aboard to Daddy_Gluxx
                globals.vbio -= 2
                say Daddy_Gluxx presentation=13 : "Gloups|... BOOM|! Voilà vos explosifs|..."
                say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "TELEPORTATION EXPLOSIFS SUR ARCHE|..."
                transfer armes from Daddy_Gluxx to aboard
                say Daddy_Gluxx presentation=8 chatter : "allons vite libérer Bug Deluxe qui est coincé|..."
                say Daddy_Gluxx presentation=8 if_not_shown skip_next=3 : "..."
                globals.A59 = 3
                end presentation Daddy_Gluxx
                choice = none
            }
            when {
                require choice == "non"
            } then {
                choice = none
            }
        }
        areu_dialogue_resume_7:
        when {
            require globals.A58 > 1
            require globals.A59 > 2
            require armes.holder != aboard
        } then {
            say Daddy_Gluxx presentation=15 : "Nous te vendons des armes contre un crédit|... Moi faire armes mais pas crédit|... Hi Hi|!..."
            when {
                require globals.A4 == 0
            } then {
                say Daddy_Gluxx presentation=8 chatter : "Corne du diable|! Nous n'avons pas de crédits, Commander|..."
            }
            when {
                require globals.A4 > 0
            } then {
                say Daddy_Gluxx presentation=8 chatter resume_at=donn2 : "Vous acceptez de leur acheter des armes, Commander?" choices "accepter" "refuser"
                when {
                    require choice == "accepter"
                } then {
                    say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "On lui envoie un credit, Commander"
                    transfer credit from aboard to Daddy_Gluxx
                    say Daddy_Gluxx presentation=8 chatter if_not_shown skip_next=1 : "TELEPORTATION ARMES DANS CRYOBOX"
                    transfer armes from Daddy_Gluxx to aboard
                    say Daddy_Gluxx presentation=16 : "Merci|... A bientot Commander|..."
                    say Daddy_Gluxx presentation=8 if_not_shown skip_next=3 : "..."
                    globals.A4 -= 1
                    end presentation Daddy_Gluxx
                    choice = none
                }
                when {
                    require choice == "refuser"
                } then {
                    choice = none
                }
            }
        }
    }
    proc donn2 enabled {
        during travel
        require presentation == Daddy_Gluxx
