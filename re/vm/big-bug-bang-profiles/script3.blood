                say Papy_Gluxx presentation=8 chatter if_not_shown skip_next=2 : "Commander, c'est pas possible, il va le bouffer|..."
                globals.A13 = 1
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Papy_Gluxx.evolution] < 500
                require state_b6[Papy_Gluxx.evolution] > 100
            } then {
                say Papy_Gluxx presentation=10 if_not_shown skip_next=5 : "Des atomiques|... Oh|! Dangereux|..."
                state_b1[Papy_Gluxx.population] /= 2
                state_b6[Papy_Gluxx.evolution] += 200
                globals.B96 += 1
                Papy_Gluxx.aggressiveness += 200
                globals.B22 -= 1
                bits(atomique.flags,0x0040) = false
            }
            when {
                require state_b6[Papy_Gluxx.evolution] > 500
            } then {
