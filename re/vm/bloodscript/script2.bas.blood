0000066E: TEXT 0872 FF 60 80 - - 0980 184F 0098 0BB0 3757 00B3 2B66 03EE 40A3 0098 40A8 0447 0584 007F 0EE9 37AC 0062 FFFF 4051 ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "I'm sorry , but since that business in 2001 , disconnecting me is no longer possible ..."
0000069C: TEXT 0872 FF 60 80 - - 0622 0984 01DF 40B6 009A 036E 40BC 0463 0E77 00EF 40C9 0463 40CE 40D3 0082 0062 283E 0082 283E 0082 283E 0082 FFFF 3F56 ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Why not ? Well, I can reinitialize your computer and wipe your hard disk ! ... Ha ! Ha ! Ha !"
000006D4: TEXT 0872 FF 61 80 - - 40D8 0100 0098 008E 0062 FFFF 3F56 ; TEXT line=0x0872 voice=0xFF flags=0x61,0x80 "Chill out , Commander ..."
000006EA: TEXT 0872 FF 60 80 - - 01D0 156B 011A 00A2 00CF 00D2 3698 0098 008E 01DF FFFF 405C ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "How does it feel to be eternal , Commander ?"
0000070A: TEXT 0872 FF 60 80 - - 2DB8 0082 014D 3B6F 020F 40DE 40E6 0519 40EC 0062 36E8 01CC 00A2 40F2 0238 01DF FFFF 405C ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Okay ! You won . Endless lives from today ... Do you feel happier now ?"
