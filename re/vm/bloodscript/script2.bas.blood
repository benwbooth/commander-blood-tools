00000F12: TEXT 0872 FF 61 80 - - 459A 0098 007F 45A3 FFFF 0201 ; TEXT line=0x0872 voice=0xFF flags=0x61,0x80 "Tomorrow , no doubt..."
00000F26: TEXT 0872 FF 61 80 - - 0A2A 02BC 45AC 0961 0098 008E 0062 FFFF 089A ; TEXT line=0x0872 voice=0xFF flags=0x61,0x80 "That's a tough one , Commander ..."
