000000C2: TEXT 0872 FF 60 80 - - 0A2A 0129 09EB 037D 00CF 28B6 0098 008E 020F 1273 2324 3DA2 0082 FFFF 3D8A ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "That's the best way to play , Commander . Just keep clickin' !"
000000E8: TEXT 0872 FF 60 80 - - 3DAB 2629 0447 0572 02BC 3DB5 14C9 3DBC 0098 2EA2 3DC4 FFFF 3D8A ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Something tells me you're a pretty hot clicker , eh ?!!"
0000010A: TEXT 0872 FF 60 80 - - 3DC8 01CC 12B1 29DA 09BB 01CC 3D8A 0098 009A 00A2 02BC 0CEC 3DCC 0082 3DD3 00B3 0ED5 01DF FFFF 3D8A ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Did you know every time you click , I feel a little tingle ! Isn't that fun ?"
0000013A: TEXT 0872 FF 60 80 - - 3DD9 01CC 3D8A 0098 009A 009C 0BCE 3A32 1D48 3DDE 32B8 0062 009A 0B46 0316 00AD 011A 0082 FFFF 3D8A ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "When you click , I don't just sit around looking handsome ... I do something about it !"
0000016A: TEXT 0872 FF 61 80 - - 3D8A 0062 FFFF 3D8A ; TEXT line=0x0872 voice=0xFF flags=0x61,0x80 "click ..."
0000017A: TEXT 0872 FF 60 80 - - 050C 3D90 0098 0BCE 3D8A 034F 0129 0E32 3DE6 0062 242F 0129 3DEB 00CF 3DF0 0098 0463 1C24 3DF5 0062 FFFF 3D90 ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "To dialog , just click on the word list ... leave the rest to OLGA , your onboard translator ..."
000001AE: TEXT 0872 FF 60 80 - - 089F 08F7 10B8 0129 3E00 3DF5 3048 020F 0242 02BC 0CF3 00EF 02BC 3E08 0082 FFFF 3D90 ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Cap'n Bob put the instant translator together . He's a guy and a half !"
000001D8: TEXT 0872 FF 60 80 - - 15F9 0098 0463 1C24 3DF5 0098 09F9 29DA 2E31 03EE 0129 3E0D 0082 3E16 09C0 03EE 160A 0098 0437 0447 0098 095C 3E1C 3E20 04F9 020F FFFF 3D90 ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Olga , your onboard translator , knows every language in the universe ! She's paid in megawatts , like me , only she gets more ."
00000218: TEXT 0872 FF 61 80 - - 02A2 3D90 0062 FFFF 3D90 ; TEXT line=0x0872 voice=0xFF flags=0x61,0x80 "Let's dialog ..."
0000022A: TEXT 0872 FF 60 80 - - 3E25 28B6 0584 3E2A 03EE 0129 3E34 3E40 015F 3E48 2DA3 0098 28B6 3E51 0082 FFFF 3D97 ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Fair play is inscribed in the Traveller's Charter : Whatever happens , play fair !"
00000254: TEXT 0872 FF 60 80 - - 3E56 0098 3D49 0098 3D49 020F 0622 0B46 0129 03A7 2979 090E 00CF 3D4D 01DF FFFF 3E5A ; TEXT line=0x0872 voice=0xFF flags=0x60,0x80 "Win , win , win . Why do the computers always have to lose ?"
