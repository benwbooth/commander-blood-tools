selector_00B3:
selector_node "play" selector_02AD
menu "talk" "click" "dialog" "fair_play"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "That's the best way to play, Commander|. Just keep clickin'!" choices "click"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Something tells me you're a pretty hot clicker, eh?!!" choices "click"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Did you know every time you click, I feel a little tingle! Isn't that fun?" choices "click"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "When you click, I don't just sit around looking handsome... I do something about it!" choices "click"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "click..." choices "click"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To dialog, just click on the word list... leave the rest to OLGA, your onboard translator..." choices "dialog"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob put the instant translator together. He's a guy and a half!" choices "dialog"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga|, your onboard translator, knows every language in the universe! She's paid in megawatts, like me|, only she gets more." choices "dialog"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Let's dialog..." choices "dialog"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Fair play is inscribed in the Traveller's Charter: Whatever happens, play fair!" choices "fair_play"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Win, win, win. Why do the computers always have to lose?" choices "faiplay"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "OK, Commander|... You seem like a fair play guy. I'll tell Cap'n Bob|..." choices "fair_play"
yield_b
selector_02AD:
selector_node "win" selector_0429
menu "talk" "willpower" "strength" "bravery" "pride"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Willpower makes a winner, Commander|. Cap'n Bob knows you've got it|..." choices "willpower"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Okay, so you click on Willpower. Now that's not going to get us very far, Commander|..." choices "willpower"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Be kind to your mouse! You don't want to crush her little buttons, now do you?" choices "strength"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Ah, Bravery! I admire your fearlessness, Commander|. You take such risks with your index finger!" choices "bravery"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Onboard computer HONK reporting: It looks like you just clicked on Bravery." choices "bravery"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "How about sitting up a little straighter?" choices "pride"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm impressed, Commander. You know how to make computers respect you!" choices "pride"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I detect a speck of contempt in the B cortex of your brain's right hemisphere. I'll just give you a little shot of adrenal..." choices "pride"
yield_b
selector_0429:
selector_node "lose" selector_0613
menu "talk" "fear" "weakness" "complain" "anger" "break" "cry"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "There's several ways to lose, Commander|. Which do you choose?" choices "lose"
say 0x0872 voice=0xFF flags=0x62 display=0x80 loop=none control=none : "Commander, I'm here with you. It's me... HONK, your onboard bioconsciousness." choices "fear"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm going to sing you a little song, Commander|. Relax." choices "fear"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Night is fa-aa-aa-lling... The moon is re-e-ed..." choices "fear"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The wolf is ho-ow-owling under your be-e-e-ed. Easy, Commander|. Honk is with you|..." choices "fear"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Big strong Commanders are never scared!" choices "fear"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You need a drink... Come on, Commander|... Please don't blubber... It's so embarrassing!" choices "weakness"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Just reset your computer and start over. there's a whole new life waiting! And I'll always be here|..." choices "weakness"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You know what? I'll help you!... There's a surprise for you on the map. Take a look..." choices "weakness"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "That won't do any good, Commander..." choices "complain"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm going to wake up Cap'n Bob..." choices "anger"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Ouch..." choices "break"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Everything'll be just fine afterwards, Commander..." choices "cry"
yield_b
selector_0613:
selector_node "help" selector_092D
menu "talk" "switch_off" "break" "endless_lives" "contest" "tips" "presents" "messages"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Need some expert guidance, Commander|?" choices "help"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To disconnect, you can always pull the plug out of the power point..." choices "switch_off"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm sorry, but since that business in 2001, disconnecting me is no longer possible..." choices "switch_off"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Why not? Well, I can reinitialize your computer and wipe your hard disk!|... Ha|! Ha|! Ha|!" choices "break"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Chill out, Commander|..." choices "break"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "How does it feel to be eternal, Commander|?" choices "endless_lives"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Okay! You won. Endless lives from today... Do you feel happier now?" choices "endless_lives"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Is this so important to you?" choices "break"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Okay...|...|... KRUIKK!" choices "break"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Here are the questions, contestant. You'll note there are prizes to be won! Click on \"CONTEST\"" choices "contest"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "First question: Who is Cap'n Bob?|...|... Click on \"CONTEST\"" choices "contest"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Too late... next question: What prize can be won in this contest? Click on \"CONTEST\"" choices "contest"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "YES! HOW 'BOUT THAT!!! But I'm afraid the first one was wrong. Don't ever click on \"CONTEST\" again." choices "contest"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Sorry, but tips are only available only the neural channel..." choices "tips"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To win an amazing prize, Click on \"CONTEST\"" choices "presents"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "If you're getting uninvited PIRATE messages over the neural channel, contact the CYBERSQUAD, extension 453765" choices "messages"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cybernetic messages over the neural channel are strictly against the law..." choices "messages"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "All users of the neural channel will be prosecuted." choices "messages"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The authors of this game decline all responsibility for neural channel communications occasioned by play of said game..." choices "messages"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You just clicked on the word \"message\". Way to go!!!" choices "message"
yield_b
selector_092D:
