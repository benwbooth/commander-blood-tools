selector_0C23:
selector_node "therapy" selector_0F87
menu "talk" "ego" "super_ego" "under_ego" "end_of_month" "libido" "who" "where" "when" "what" "how" "why"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "A free psychotherapy session... That's a once in a lifetime offer, Commander|." choices "therapy"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Relax... Loosen up those muscles... Choose the first thing that enters your head:" choices "therapy"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Think about me, Commander, and you'll feel better... let your thoughts stray to Olga the translator..." choices "end_of_month"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The end of one month is so often close to the start of another, Commander|..." choices "end_of_month"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Good... Relax... Click on anything... NOW!" choices "end_of_month"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Ha|! Ha|! That was your double talking... You're not the only one, Commander|. Go see Super ZEN. He can help you with that..." choices "super_ego"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You think you're quite a person, but deep down, there's a little child, right?|..." choices "super_ego"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "There's a rebel in you, Commander|..." choices "super_ego"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Careful... You'll never get the stains ou... You just ask Cap'n Bob|..." choices "under_ego"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You've attained a state close to PRANA. Congratulations..." choices "ego"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Yes|, you!! I'm impressed, Commander|..." choices "ego"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm sensing strange pulsions in the B cortex of your right hemisphere..." choices "libido"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Commander, chastity is a stepping stone to wisdom. So stay calm... Let Cap'n Bob be an example..." choices "libido"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Space travel can be long and lonely. Why not watch some TV?" choices "libido"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Ahh|! The ondoyants..." choices "libido"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Now that's a serious matter... Maybe the answer is to be found at the end of this adventure..." choices "who"
say 0x0872 voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The cyberloneliness of cheap memory makes you dizzy, Commander|..." choices "who"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Over there..." choices "where"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Tomorrow, no doubt..." choices "when"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "That's a tough one, Commander|..." choices "what"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Ahh|! How? The answer is within you, Commander|." choices "how"
say 0x0872 voice=0xFF flags=0x61 display=0x80 loop=none control=none : "It's obvious: BECAUSE!!! And don't ask \"Because what?\"" choices "why"
yield_b
