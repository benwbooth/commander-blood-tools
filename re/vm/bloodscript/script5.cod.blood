proc scrujo {
    conditional_block 0x01 bigb1
    branch_flag_274f
    actor 0x078C 0x0028 0
    guard_pop
    say 0x0752 voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander|, you go search BIONIUM in SCRUTER JO's cyberspace..."
    guard_push block_43A6
    shared_state 0xC0 0x1366 0xF5 0xC1 0x0000
    guard_pop
    say 0x0752 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain how you pick up BIONIUM.."
    say 0x0752 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures|..."
    say 0x0752 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX with hand once."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me|, Commander!!"
    say 0x0752 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX twice, you CAPTURE BIOXX on tip of your finger..."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You catch it on the tip of your finger!!! How about that..."
    say 0x0752 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to Cybernetic MANTAS"
    say 0x0752 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You put BIOXX in belly of Manta..."
    say 0x0752 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stick to MANTAS..."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That's something I wanna see..."
    say 0x0752 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
    say 0x0752 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Lead me to those BIOXXes!!! BIONIUM|... Yummy..."
    say 0x0752 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
    say 0x0752 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We get the picture, Mister SCRUTER JO... Right, Commander|?"
    block_43A6:
    say 0x0752 voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say 0x0752 voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh... Me feel better..."
    guard_push block_4456
    shared_state 0xC0 0x1368 0xF2 0xC1 0x0000
    guard_pop
    say 0x0752 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work... You did be successful..."
    say 0x0752 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM|..."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES|!!! Commander|, did I ever tell you what a cool dude you are?"
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "The BIONIUM will make me smarter and I'll be able to help you better..."
    shared_state 0xC0 0x1366 0xF5 0xC1 0x0001
    block_4456:
    guard_push block_44F1
    shared_state 0xC0 0x1368 0xF5 0xC1 0x0000
    guard_pop
    say 0x0752 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You didn't understand the idea, huh, Commander|..."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I have to have BIONIUM, Commander|. It makes me smarter..."
    say 0x0752 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha|! Ha|! You need much bionium BIONIUM|... Ha|! Ha|!|..."
    say 0x0752 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That's enough out of you!!!"
    block_44F1:
