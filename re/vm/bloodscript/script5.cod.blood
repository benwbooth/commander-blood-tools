proc revel {
    conditional_block 0x01 honk1
    branch_flag_274f
    actor 0x0084 0x0028 0
    shared_state 0xC0 0x1386 0xF5 0xC1 0x0000
    guard_pop
    say 0x004A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Would you care to know an unbearable truth, Commander|?"
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch yourself off for ten seconds!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But, Cap'n Bob|! I..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "SWITCH OFF I SAID!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir....."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaahhhhh!!!"
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME...."
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MORE THAN MY SON..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We are the same person... I am the first being to create itself..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And, thanks to space-time contorsion, to watch itself relive: YOU ARE BOB, COMMANDER|..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am what you'll be in a few hundred thousand years..."
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, you can switch yourself back on..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! -&I AM supposed to be aware of everything that goes on round here, being the onboard computer... Don't tell me you switched off Olga???"
    say 0x004A voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Can it and do some work!!"
    poke_byte 0x4C53 0x00
    record_clear 0x0084
}

