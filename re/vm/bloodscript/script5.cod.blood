proc kult {
    conditional_block 0x01 ondo1
    branch_gameflag
    record_wildcard 0xAF 0x103A 0x0E5A 0
    actor 0x06FC 0x0028 0
    guard_pop
    say 0x06C2 voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Turn around|... Move on... There are too many pilgrims|... The planet's inaccessible|..."
    load_string "1kkult20.hnm"
    say 0x06C2 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "The planet KULT is inaccessible. There are too many pilgrims..."
    guard_push block_02FC
    shared_state 0xBF 0x06F8 0xF1 0xC1 0x0003
    guard_pop
    say 0x06C2 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander... Commander|... It's the planet TUMUL with a new name.."
    load_string "1kkult20.hnm"
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "That's right, Commander... When we saved BETAKAM IV, king of the Patagos, we altered history..."
    load_string "hboc.hnm"
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Pilgrims now flock to hear the VOICE that saved BETAKAM and his people from the catastrophe..."
    load_string "hboc.hnm"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "How about that... What a story..."
    say 0x06C2 voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Turn around|... Keep moving... There are too many pilgrims... The planet is inaccessible..."
    record_clear 0x06FC
    block_02FC:
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x06FC
}

proc ondo1 {
    conditional_block 0x01 big1
    branch_flag_274f
    actor 0x03E4 0x0028 0
    guard_pop
    say 0x03AA voice=0x11 flags=0x00 display=0x80 loop=none control=none : "..."
    say 0x03AA voice=0x12 flags=0x00 display=0x80 loop=none control=none : "..."
    say 0x03AA voice=0x00 flags=0x00 display=0x80 loop=none control=none : "I am yours to command, Commander|..."
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... My knees are weak|..."
    say 0x03AA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You want a little kiss?"
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy hen gizzards, Commander|... I'm starting to overheat..."
    say 0x03AA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You can talk to me Commander|... Tell me about yourself..."
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Where did she learn to swim like that|?|... You think she'd agree to give me lessons, Commander|?"
    guard_push block_051E
    shared_state 0xBF 0x07D0 0xF2 0xC1 0x0000
    shared_state 0xC0 0x136A 0xF5 0xC1 0x0001
    guard_pop
    say 0x03AA voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Oh! Commander|, Honk told me you needed a ring..."
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I swear I didn't say a thing|..."
    say 0x03AA voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Ha|! Ha|! Who's a little fibber?|... You ogle me as soon as the Commander's back is turned..."
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... She's making this up..."
    say 0x03AA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Really, Mister Honk??? I'm a little disappointed in you|..."
    load_string "rgbtr9.hnm"
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No no, Mister Bronko... Don't believe a word she says..."
    say 0x03AA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha|! Ha|! Ha|! Ha..."
    say 0x03AA voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Commander|... I have a ring... I want you to have it... It's yours..."
    record_wildcard 0xAF 0x12F0 0xFFFF 0
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... She gave us the ring..."
    block_051E:
    say 0x03AA voice=0x14 flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x03E4
}

proc big1 {
    conditional_block 0x01 boba0
    branch_gameflag
    record_wildcard 0xAF 0x103A 0x0FB8 0
    actor 0x00CC 0x0028 0
    guard_pop
    say 0x0092 voice=0x00 flags=0x00 display=0x80 loop=none control=none : "You here, Consumer Comrade?"
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander!!! It's Bug Deluxe, the sales assistant from VENUSIA... How about that..."
    say 0x0092 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Are you here for the wedding?|..."
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Wedding? What wedding???"
    say 0x0092 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You mean to say you haven't heard|?"
    say 0x0092 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "MIGRATOR and TINA BURNER are getting married..."
    say 0x0092 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "They're giving a big show here at the BIG BAND CLUB..."
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "At the what??? Was that BIG BAND or BIG BANG???"
    say 0x0092 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Right here at the BIG BAND CLUB! WITH A \"D\" AT THE END..."
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This isn't right, Commander|... This is the BIG BAND, not the BIG BANG|..."
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob isn't going to like this|..."
    say 0x0092 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "What's going on here??? What the blazes are we doing in a NIGHT CLUB???"
    load_string "boba2.hnm"
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "There's been a mix up, Cap'n Bob sir..."
    say 0x0092 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "ALL OF YOU, INTO THE CRYOBOX RIGHT AWAY..."
    load_string "bobb.hnm"
    shared_state 0xC0 0x136C 0xF5 0xC1 0x0001
    say 0x0092 voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "NOW..."
    load_string "bobb.hnm"
    record_wildcard 0xAF 0x00AA 0x0F2C 0
    record_wildcard 0xAF 0x07B2 0x0FB8 0
    record_clear 0x00CC
}

proc boba0 {
    conditional_block 0x01 boba1
    branch_flag_274f
    actor 0x0084 0x0028 0
    shared_state 0xC0 0x136C 0xF5 0xC1 0x0001
    guard_pop
    say 0x004A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "What's the story??? What's this BIG BANG business???..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Did we get to the BIG BANG, yes or no??? I'm listening, Commander|..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Uh, there's been a mix up, sir..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I think OLGA the onboard interpreter mixed up BIG BANG and BIG BAND|..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "WHAT DO YOU MEAN SHE MIXED UP BIG BANG AND BIG BAND|... TELL ME THIS IS JUST A BAD DREAM!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Afraid not, sir... She mixed up BANG and BAND..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's the only explanation..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIO-TRANSLATOR OLGA REPORTING:"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "MISTER HONK IS A DIRTY LIAR!!! I didn't mix anything up..."
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OLGA... CHILL OUT... We can clear the question up real easy|... We'll just run a test..."
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "OLGA, say \"BIG BANG\" out loud three times..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "OLGA REPORTING:"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIG BANG|... BIG BANG|... BIG BANG|..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Okay|... Now say \"BIG BAND\" with a \"D\"..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "OLGA REPORTING:"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIG BANG|... BIG BANG|... BIG BANG|..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Satisfied?"
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Olga... I said BIG BAND, not BIG BANG|... You mixed them up... GOSH DARN IT!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What did I tell you? Don't say I didn't... She fouled up..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "She can't tell \"D\" from \"G\"..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Honk! Misbegotten junkheap... It's all your fault!!! Check her multiplexers..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Right away, Cap'n Bob sir... I'm on it..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ah!!! Commander|... Remind me to tell you how much I hate machines..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Got it! Cap'n Bob... I found the glitch... It's a MOSQUITO stuck to the letter \"D\" in the multiplexer..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I hate mosquitos..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "MESSAGE FROM OLGA:"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "IF THIS PLACE WAS CLEANED UP MORE OFTEN THIS KIND OF THING WOULDN'T HAPPEN..."
    say 0x004A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "She's right|... This Ark is a pigsty!!! This mess makes me sick!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Dont' look at me! Mister BEAUREGARD's on cleaning duty this week!!!"
    say 0x004A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "What!!! Don't drag me into this! That does it! I've had it with this stupid ship..."
    load_string "hboc.hnm"
    say 0x004A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "I want to go home..."
    load_string "hboc.hnm"
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "That's enough|, Mister Beauregard... Return to your cryobox|..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I told you so... I told you|..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Commander, drop Mister BEAUREGARD off on the planet Tumul..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "AND GET BACK TO WORK!!!"
    say 0x004A voice=0xFF flags=0x28 display=0xA0 loop=none control=none : "Yes sir, Cap'n Bob sir..."
    shared_state 0xC0 0x136A 0xF5 0xC1 0x0001
    poke_byte 0x071A 0x00
    record_clear 0x0084
}

proc boba1 {
    conditional_block 0x01 big2
    branch_flag_274f
    actor 0x0084 0x0028 0
    guard_pop
    guard_push block_0CA7
    shared_bit_state 0xAE 0x0FBA 0x0002 1
    guard_pop
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Aaaah..."
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "When will we get to the Big Bang? It's URGENT, Commander|..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "WE MUST FIND the Big Bang|... THAT'S YOUR MISSION, REMEMBER?"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir. All efforts are directed toward achieving the mission objective..."
    say 0x004A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "SILENCE HONK!!!"
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I'm mad as mad can be, Commander!!! You're flitting around like some gosh darn butterfly..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You're using my time and money to go after ondoyants!!!"
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "That's what I call IN-TO-LE-RA-BLE!!!"
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I hope I've made my feelings clear..."
    say 0x004A voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Now leave me..."
    record_clear 0x0084
    block_0CA7:
    guard_push big2
    shared_bit_state 0xAE 0x0FBA 0x0002 0
    guard_pop
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Lets go to the Bigbang..."
    say 0x004A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x0084
}

proc big2 {
    conditional_block 0x01 bar1
    branch_gameflag
    record_wildcard 0xAF 0x103A 0x0FB8 0
    actor 0x07D4 0x0028 0
    guard_pop
    say 0x079A voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Ohhh... It's you|, Commander|..."
    say 0x079A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh no... Her again..."
    say 0x079A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "AH! How delightful to see you again, sweeties... I so much wanted to invite you along..."
    say 0x079A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "But I didn't know where to send the invitations..."
    say 0x079A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I'm getting married, you see... Hee|! Hee|! Hee|! To darling MIGRATOR... Hee|! Hee|! Hee|!"
    say 0x079A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy homeostatics... Poor guy|..."
    say 0x079A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "We're giving a concert here at the BIG BAND CLUB|... It's such a fashionable place, you know... Why, the whole galaxy'll be here!"
    say 0x079A voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Our concert's going to be broadcast by all the TV stations in the universe!!"
    say 0x079A voice=0x09 flags=0x00 display=0x80 loop=none control=none : "I'm so famous, Commander|... Hee|! Hee|! Hee|!"
    say 0x079A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I can't help wishing we'd gone somewhere else... This place has an end of the world feel..."
    say 0x079A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Darling Migra's at the bar, drinking a frozen Migrita..."
    say 0x079A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "MIGRA OH MIGRA SWEETIE... GUESS WHO'S COME..."
    say 0x079A voice=0x01 flags=0x08 display=0xB0 loop=none control=none : "Go join him for a stiff one, Commander|..."
    poke_byte 0x0CD0 0x00
    record_wildcard 0xAF 0x0452 0x0FDC 0
    record_wildcard 0xAF 0x07B2 0x0F2C 0
    record_state 0xC1 0x1346 0x0FDC 0
}

proc bar1 {
    conditional_block 0x01 big3
    branch_gameflag
    record_wildcard 0xAF 0x103A 0x0FB8 0
    actor 0x0474 0x0028 0
    guard_pop
    say 0x043A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You here, Commander! My good friend|... Did Burny tell you the news?"
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "We're getting married... Ah!!! She's so sexy, and smart..."
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... Howzabout a strategic withdrawal here?|... Commander|?"
    say 0x043A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "And it's all thanks to you|... I'd like you to be my best man!"
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh NO|..."
    say 0x043A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You'll give her the wedding band..."
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "THE WEDDING BAND|... How about a ring for her nose..."
    say 0x043A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Hurry up, Commander|... We can't have the ceremony without a ring..."
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy handouts... Where do we find a wedding band at this time of day or night?"
    say 0x043A voice=0x02 flags=0x08 display=0xC0 loop=none control=none : "See you soon|, Commander|..."
    poke_byte 0x0EBB 0x00
    record_wildcard 0xAF 0x0452 0x0F2C 0
    record_wildcard 0xAF 0x07B2 0x0FF4 0
    record_wildcard 0xAF 0x025A 0x0FB8 0
    record_clear 0x0474
}

proc big3 {
    conditional_block 0x01 bar2
    branch_gameflag
    record_wildcard 0xAF 0x103A 0x0FB8 0
    actor 0x027C 0x0028 0
    guard_pop
    say 0x0242 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Commander! Yoko happy to see you again..."
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... It's young Yoko|..."
    say 0x0242 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Migrator and Tina wait for wedding ring..."
    guard_push block_10E3
    record_wildcard 0xAF 0x12F0 0x0028 0
    guard_pop
    say 0x0242 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You have ring?"
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No problem, Mister Yoko|... We have the wedding band right here..."
    say 0x0242 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "YES|!!! Me happy..."
    say 0x0242 voice=0x07 flags=0x08 display=0xA0 loop=none control=none : "You go bar, Tina be impatient..."
    poke_byte 0x1019 0x00
    record_wildcard 0xAF 0x00F2 0x0FDC 0
    record_state 0xC1 0x1346 0x0FDC 0
    block_10E3:
