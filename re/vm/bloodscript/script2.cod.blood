    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I immediately detected the planet Corpo. You won't forget to mention that fact to Cap'n Bob|, will you, Commander|?|..."
    block_144A:
    guard_push block_147D
    require state[0x127C] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We first met Izwalito on the planet Corpo. He was one hungry little guy|..."
    block_147D:
