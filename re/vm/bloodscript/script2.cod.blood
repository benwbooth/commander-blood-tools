proc rhom3b {
    activation enabled until timy
    branch_presentation
    actor 0x06B4 0x0028 0
    guard_pop
    say 0x067A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x067A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Bee bee rla rla bop bop bop beeep... Turlu ta ta ta tweeeeet..."
    say 0x067A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "KRUIKK!"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK SPEAKING:"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I decoded the second word. It says MESSAGE...|..."
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Now, that gives us... CODED MESSAGE:\"EXXOS\"... That proves I was right, Commander|! The message is coded!"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I don't mind believing in coincidences, Commander|, but that one's a biggie, right?"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You'll remember to tell ol' Buzzard Man Bob I cracked the code, won't you, Commander|?"
    say 0x067A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    state[0x12D0] = 0x0003
    encounter_count[0x06B0] = 0x0000
    rhom3b.enabled = false
    record_clear 0x06B4
}

