proc men6 {
    activation disabled until bbbob
    guard_pop
    men1.enabled = true
    men2.enabled = true
    men3.enabled = true
    men4.enabled = true
    men5.enabled = true
    men6.enabled = false
}

proc bbbob {
    activation enabled until honk1
    branch_presentation
    actor 0x08AC 0x0028 0
    guard_pop
    guard_push block_0B37
    require state[0x126E] == 0x0000
    guard_pop
    say 0x0872 voice=0xFF flags=0x22 display=0x80 loop=none control=none : "Commander|, Cap'n Bob's a secretive buzzard... He is hiding something..."
    block_0B37:
    guard_push honk1
    require state[0x126E] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, I hope you're gonna tell me what ol' Turkey face said when he unplugged me..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's a secret... Right Commander|..."
}

proc honk1 {
    activation enabled until help2
    branch_presentation
    actor 0x08AC 0x0028 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x90 loop=none control=none : ""
    state[0x1270] = 0x0000
    state_array_set 0x0F 0x0064
    guard_push block_0BC7
    require encounter_count[0x0080] == 0x0000
    guard_pop
    say 0x0872 voice=0xFF flags=0x22 display=0x80 loop=none control=none : "Commander|, remember ol' Bob snoring in the Cryobox|..."
    block_0BC7:
    guard_push help2
    require record[0x0722] == aboard
    guard_pop
    guard_push block_0C3D
    require state[0x126C] == 0x0000
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, we have no BIONIUM... COMMANDER... Please"
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need that energy|..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You have to go into Scruter Jo's CYBERSPACE|..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Wake up Scruter_Jo, Commander|. He's sleeping in the Cryobox..."
    block_0C3D:
    guard_push block_0CA4
    require state[0x126C] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've only got one dose of BIONIUM left, Commander"
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You should think about a trip to SCRUTER JO's CYBERSPACE..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'm not feeling too sure of myself... Commander... I really need that energy..."
    block_0CA4:
    guard_push block_0CE9
    require state[0x126C] == 0x0002
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got two doses of BIONIUM left, Commander"
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's about time you paid a visit to SCRUTER JO's CYBERSPACE|..."
    block_0CE9:
    guard_push block_0D0E
    require state[0x126C] == 0x0003
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got three doses of BIONIUM left, Commander"
    block_0D0E:
    guard_push block_0D33
    require state[0x126C] == 0x0004
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got four doses of BIONIUM left, Commander"
    block_0D33:
    guard_push block_0D58
    require state[0x126C] == 0x0005
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got five doses of BIONIUM left, Commander"
    block_0D58:
    guard_push block_0D7D
    require state[0x126C] == 0x0006
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got six doses of BIONIUM left, Commander"
    block_0D7D:
    guard_push block_0DA2
    require state[0x126C] == 0x0007
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got seven doses of BIONIUM left, Commander"
    block_0DA2:
    guard_push help2
    require state[0x126C] == 0x0008
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got eight doses of BIONIUM left, Commander"
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You're the best of the best, Commander..."
}

proc help2 {
    activation enabled until help3
    branch_presentation
    actor 0x08AC 0x0028 0
    require state[0x126C] > 0x0002
    require !bits(0x0B2C,0x0002)
    require encounter_count[0x0590] > 0x0000
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander|, I'm sure Izwalito knows other planetary coordinates..."
    state[0x126C] -= 0x0003
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Service with a smile! That's the story of my life, Commander|..."
    help2.enabled = false
}

proc help3 {
    activation enabled until help4
    branch_presentation
    actor 0x08AC 0x0028 0
    require state[0x126C] > 0x0002
    require encounter_count[0x0230] > 0x0001
    require !bits(0x0EB0,0x0002)
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander, Yoko likes Slimers|... Ask him for information|..."
    state[0x126C] -= 0x0003
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Service with a smile! That's the story of my life, Commander|..."
    help3.enabled = false
}

proc help4 {
    activation enabled until help6
    branch_presentation
    actor 0x08AC 0x0028 0
    require state[0x126C] > 0x0002
    require bits(0x0EB0,0x0002)
    require !bits(0x097C,0x0002)
    require encounter_count[0x0470] > 0x0000
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander, Daddy Gluxx talked about SLIM GELATI... Ask him for more information..."
    state[0x126C] -= 0x0003
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Service with a smile! That's the story of my life, Commander|..."
    help4.enabled = false
}

proc help6 {
    activation enabled until help7
    branch_presentation
    actor 0x08AC 0x0028 0
    require state[0x126C] > 0x0002
    require record[0x0332] == aboard
    require encounter_count[0x0860] == 0x0000
    require record[0x0842] == 0x0F08
    require bits(0x09E8,0x0002)
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander, get back to the planet Moskito..."
    state[0x126C] -= 0x0003
