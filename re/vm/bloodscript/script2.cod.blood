    actor 0x0474 0x0028 0
    guard_pop
    say 0x043A voice=0x01 flags=0x08 display=0x80 loop=none control=none : "Ho! A visitor from far away in the space-time continuum..."
    state[0x1270] = 0x0000
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "See, my children, how fascinating he is of aspect..."
    say 0x043A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ooohh, such extraordinary beauty..."
    say 0x043A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Magnificence of Nature..."
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! I'm Daddy GLUXX this is my family, noble stranger..."
    say 0x043A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "We're SLIMERS. This jelly village is where we live..."
    say 0x043A voice=0x00 flags=0x00 display=0x80 loop=none control=none : "We have some cousins... old SLIM GELATI and his wife, they're trying to recapture their youth..."
    say 0x043A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Slim Gelati and his wife. They're retired now. They long for eternal youth!"
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! The old always dream of being young. Ha! Ha! Ha!"
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "But youth costs a fortune, you know... Poor old Slim... He sold everything he owned..."
    say 0x043A voice=0x04 flags=0x08 display=0x80 loop=none control=none : "What do you seek, stranger?"
    topic[0x0480] = "talk"
    say 0x043A voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Bye bye, stranger. Come back again|..." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push block_882A
    require state[0x12E2] == 0x0001
    guard_pop
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I know of a terrible place... Nobody speaks of it|..."
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "It's the clinic on the planet Erazor. Mysterious things happen there, you know..."
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Do not venture near that place... ERAZORUS AS666 constellation...."
    say 0x043A voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Commander|... Commander|... Unless I'm mistaken, that sounded like planetary coordinates!"
    bits(0x097C,0x0002) = true
    state[0x12AC] = 0x0001
    block_882A:
    guard_push glu2
    require state[0x1270] == 0x0001
    guard_pop
    say 0x043A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Bye bye"
    state[0x12AA] = 0x0001
    state[0x130A] = 0x0001
    record_clear 0x0474
}

