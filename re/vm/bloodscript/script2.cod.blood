    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I was obliged to switch Morning Oil off, to check out his memory..."
    block_19FF:
    guard_push block_1A36
    require state[0x129E] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I speedily discovered in Morning Oil's memory that the story about the Croolis war treasure was true..."
    block_1A36:
    guard_push block_1A7B
    require state[0x12A0] == 0x0001
    guard_pop
