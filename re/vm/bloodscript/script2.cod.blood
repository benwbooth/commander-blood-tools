    require state[0x128E] == 0x0000
    actor 0x0354 0x0028 0
    guard_pop
    say 0x031A voice=0xFF flags=0x02 display=0x80 loop=none control=none : "Nice ship you got, Commander|..."
    say 0x031A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me do cooking. Me make tasty meals for Cap'n Bob|..."
    say 0x031A voice=0xFF flags=0x2A display=0x80 loop=none control=none : "Leave him, Commander. He's cooking..."
