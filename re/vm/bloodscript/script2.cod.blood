    block_14F5:
    guard_push block_1554
    require state[0x1282] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You made an error of judgment, Commander|, when you purchased a lump of murffalo on Venusia"
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That wasn't what Izwalito had requested, was it? He experienced feelings of impatience..."
    block_1554:
    guard_push block_158B
    require state[0x1284] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We got a call from BOSSANOVA, Izwalito's love partner. She was unhappy about the situation..."
    block_158B:
    guard_push block_15E0
