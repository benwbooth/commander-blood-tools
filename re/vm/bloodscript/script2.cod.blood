proc what {
    activation enabled until miss
    branch_presentation
    actor 0x08AC 0x0028 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "..."
    say 0x0872 voice=0xFF flags=0x30 display=0x80 loop=block_121E control=none : "What do you want Commander|?" choices "talk" "remember" "bye_bye"
    guard_push block_11E2
    concept_guard "remember" 0
    guard_pop
    miss.enabled = true
    clear_alternate_concept
    block_11E2:
    guard_push block_11EF
    concept_guard "talk" 0
    guard_pop
    topic[0x08B8] = "explanations"
    clear_alternate_concept
    block_11EF:
    guard_push block_121E
    concept_guard "bye_bye" 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Service with a smile! That's the story of my life, Commander|..."
    clear_alternate_concept
    record_clear 0x08AC
    block_121E:
    guard_push block_12A5
    require state[0x1276] > 0x0005
    guard_pop
    say 0x0872 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "CHEAT MODE..."
    topic[0x08B8] = "rien"
    say 0x0872 voice=0xFF flags=0x30 display=0x80 loop=block_12A5 control=none : "Choose your script, Commander" choices "3" "4" "5"
    guard_push block_126F
    concept_guard "3" 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Script 3 selected..."
    run_profile 0x03
    clear_alternate_concept
    record_clear 0x08AC
    block_126F:
    guard_push block_128A
    concept_guard "4" 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Script 4 selected..."
    run_profile 0x04
    clear_alternate_concept
    record_clear 0x08AC
    block_128A:
    guard_push block_12A5
    concept_guard "5" 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Script 5 selected..."
    run_profile 0x05
    clear_alternate_concept
    record_clear 0x08AC
    block_12A5:
    guard_push block_12BF
    concept_guard "bye_bye" 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Bye bye, Commander..."
    record_clear 0x08AC
    block_12BF:
    guard_push block_12FE
    state_array_test 0x0F
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Pardon me,Commander, but I have work to do... I have to quadrify the multiplexers... See you!"
    state_array_set 0x0F 0xFFFF
    record_clear 0x08AC
    block_12FE:
    guard_push miss
    require encounter_count[0x0590] > 0x0002
    require record[0x1048] != aboard
    require record[0x1018] != 0x0028
    require state[0x1278] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander, I just forged a CRED! Take a look in the Cryobox|..."
    record_triple 0x0594 0x1004 0x0028 0
}

proc miss {
    activation disabled until boba1
    actor 0x08AC 0x0028 0
    require bits(0x0D36,0x0002)
    guard_pop
