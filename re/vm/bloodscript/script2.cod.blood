    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Then we bought three tons of murffalo from Bronko on the planet Moskito|..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "And we brought it back to Izwalito who gave it to his grateful people..."
    block_15E0:
    guard_push block_1611
    require state[0x1288] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You may recall we received a mysterious message from far away in the galaxy..."
    block_1611:
    guard_push block_1648
    require state[0x1288] == 0x0002
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I easily decoded the first word of the coded message from far away. The word was coded"
