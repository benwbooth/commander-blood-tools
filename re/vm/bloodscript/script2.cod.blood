    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'll tell him to repaint the ARK's hull. The old girl's getting rusty..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You can talk with Morning Oil clicking on the ARK position..."
