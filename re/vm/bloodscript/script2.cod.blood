proc oto4 {
    activation enabled until oto5
    branch_gameflag
    require record[0x0F4E] == 0x097A
    actor 0x0624 0x0028 0
    require state[0x130C] == 0x0002
    require state[0x1274] == 0x0000
    guard_pop
    say 0x05EA voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Well hello, dear client. Do take a seat and admire our 3 star clinic!"
    say 0x05EA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "As you no doubt know, I am none other than Doctor OTTO VON SMILE... Ha! Ha! Ha!"
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "And you are interested in optical lenses... Yes|, I can see that quite clearly!"
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "The little expedition is winging its way back even now..."
    say 0x05EA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You were quite mistaken, dear friend. The planet you mentioned is Slimerless!"
    say 0x05EA voice=0x05 flags=0x10 display=0x80 loop=block_91D0 control=none : "So, am I to have the name of the planet?" choices "Corpo" "Ekatomb" "Kult" "Troma" "Cyberock" "Moskito" "Tumul"
    guard_push block_91C7
    concept_guard "Ekatomb" 0
    guard_pop
    state[0x130E] = 0x0001
    clear_alternate_concept
    block_91C7:
    guard_push block_91D0
    concept_guard "Ekatomb" 1
    guard_pop
    clear_alternate_concept
    block_91D0:
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I'll just send some more of my drones to verify what you claim..."
    say 0x05EA voice=0x00 flags=0x00 display=0x80 loop=none control=none : "If you've told me the truth, then you shall have your little lens..."
    say 0x05EA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Bye bye for the present, dear dear client..."
    say 0x05EA voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    oto5.enabled = true
    record_clear 0x0624
}

proc oto5 {
    activation disabled until oto6
    require state[0x130E] == 0x0001
    guard_pop
    state[0x1274] = 0x0001
}

proc oto6 {
    activation enabled until prep
    branch_gameflag
    require record[0x0F4E] == 0x097A
    actor 0x0624 0x0028 0
    require record[0x11B0] != 0x05EA
    guard_pop
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Hello, dear client. Please don't sit..."
    say 0x05EA voice=0x05 flags=0x00 display=0x80 loop=none control=none : "The astonishing Doctor OTTO VON SMILE is very busy indeed... Ha! Ha! Ha!"
    say 0x05EA voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I simply cannot help you for the moment..."
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Do come back another time|..."
    say 0x05EA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Thank you once more for your delightful visit, dear DEAR client..."
    say 0x05EA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear 0x0624
}

proc prep {
    activation enabled until pub1
    require encounter_count[0x02C0] == 0x0001
    guard_pop
    state_array_set 0x07 0x0014
    bit_flag 0x00B0 0x02 0
    prep.enabled = false
}

proc pub1 {
    activation enabled until pub2
    state_array_test 0x07
    guard_pop
    bits(0x0094,0x0002) = true
    record_link 0x00CC 0x0028 0
    state_array_set 0x07 0xFFFF
    pub2.enabled = true
    pub1.enabled = false
}

proc pub2 {
    activation disabled until monop1
    branch_presentation
    actor 0x00CC 0x0028 0
    guard_pop
    say 0x0092 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "COMMERCIAL... COMMERCIAL... COMMERCIAL..."
    character_slot 0x03 "venus"
    say 0x0092 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "FOR ALL SPENDING MOMENTS, COME TO VENUSIA"
    say 0x0092 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "FABULOUS BARGAINS... BRING PLENTY OF CREDS..."
    say 0x0092 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MORE FOR YOUR CREDS AT VENU-USIA-AA... Watch tv channel three..."
    say 0x0092 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "VENUSIA 325467 DEGREES, 23 GALAXY B BABY1..."
    say 0x0092 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "CRUIK..........."
    say 0x0092 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    bits(0x0922,0x0002) = true
    record_clear 0x00CC
}

proc monop1 {
    activation enabled until monop2
    require record[0x0F4E] == 0x0920
    actor 0x00CC 0x0028 0
    guard_pop
    say 0x0092 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Hi there, Comsumer Comrade. Welcome to VENUSIA SUPRAMARKET"
    say 0x0092 voice=0x04 flags=0x10 display=0x80 loop=monop2 control=none : "Wanna buy a SUPRA product at VENUSIA?" choices "yes" "no"
    guard_push block_943D
    concept_guard "yes" 0
    guard_pop
    monop2.enabled = true
    clear_alternate_concept
    block_943D:
    guard_push monop2
    concept_guard "no" 0
    guard_pop
    say 0x0092 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "NO! HA HA!! Forgot our CREDs, did we?"
    say 0x0092 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Have a happy day, comrade."
    say 0x0092 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    clear_alternate_concept
    record_clear 0x00CC
}

proc monop2 {
    activation disabled until finscr1
    require record[0x0F4E] == 0x0920
    branch_gameflag
    actor 0x00CC 0x0028 0
    guard_pop
    say 0x0092 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You got the CREDs? At VENUSIA|, it's CREDs CREDs CREDs, Consumer Comrade..."
    guard_push block_950B
    require state[0x1272] == state[0x12CA]
    require state[0x1310] == state[0x12CA]
    require record[0x1018] != 0x0028
    guard_pop
    say 0x0092 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "No CREDs, huh?... That's not an attitude we care for at VENUSIA!"
    say 0x0092 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    monop2.enabled = false
    record_clear 0x00CC
    block_950B:
    guard_push block_95DE
    require state[0x1272] == 0x0001
    require record[0x1018] != 0x0028
    guard_pop
    say 0x0092 voice=0x05 flags=0x08 display=0x80 loop=none control=none : "It's your luck-lucky day, consumer comrade. You just won a free CRED!!!"
    load_string "pubven1.hnm"
    say 0x0092 voice=0xFF flags=0x30 display=0x80 loop=block_95DE control=none : "TELEPORT CRED TO ARK" choices "teleport"
    guard_push block_95DE
    concept_guard "teleport" 1
    guard_pop
    say 0x0092 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "CRED TELEPORTED TO ARK"
    record_triple 0x00CC 0x1004 0x0028 0
    say 0x0092 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Ahhh|! Lady luck loves a consumer, comrade... Happy spending!"
    say 0x0092 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And remember... \"MORE FOR YOUR CREDS AT VENU-USIA-AAA!\""
    say 0x0092 voice=0x05 flags=0x08 display=0xA0 loop=none control=none : "Bye bye comrade consumer..."
    state[0x1272] = state[0x12CA]
    clear_alternate_concept
    record_clear 0x00CC
    block_95DE:
    guard_push block_9610
    require record[0x1018] == 0x0028
    guard_pop
    say 0x0092 voice=0x02 flags=0x08 display=0x90 loop=none control=none : "What would you like to splurge your creds on, Supra Comrade?"
    state_array_set 0x07 0x01F4
    topic[0x00D8] = "department"
    block_9610:
    say 0x0092 voice=0xFF flags=0x48 display=0x80 loop=none control=none : "TELEPORT CRED ON VENUSIA|..." choices "buy"
    load_string "pion.hnm"
    guard_push finscr1
    require state[0x1310] == 0x0001
    guard_pop
    say 0x0092 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Thank you for enjoying VENUSIA the SUPRAMARKET. VENUSIA hopes to see you again soon..."
    say 0x0092 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x1310] = state[0x12CA]
    monop2.enabled = false
    record_clear 0x00CC
}

proc finscr1 {
    activation enabled until scrapp
    require bits(0x0AF0,0x0002) using alternate_encoding
    require state[0x12FC] == 0x0006
    require record[0x11B0] == 0x0512
    require record[0x0722] == aboard
    require record[0x0332] == aboard
    guard_pop
    bits(0x06C4,0x0002) = true
    record_link 0x06FC 0x0028 0
    scrapp.enabled = true
}

proc scrapp {
    activation disabled until block_9881
    branch_presentation
    actor 0x06FC 0x0028 0
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT customs and excise ship... Calling unknown vessel..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Pull over for a routine check... We have orders to routinely check your ship specifically..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Scanning X-ray Charles... BZZZZZZZZZZZZZZZZZZZZZZ..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We are currently scanning your vessel..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Bzzzzzzzzzzzzzzzzzz"
    guard_push block_975F
    require record[0x1018] == aboard
    guard_pop
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "ILLEGAL MONEY DETECTED..."
    record_triple 0x0030 0x1004 0x06C2 0
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Confiscated..."
    block_975F:
    guard_push block_9791
    require record[0x11C8] == aboard
    guard_pop
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "BIONIUM container detected... Ultra-illegal item..."
    record_triple 0x0030 0x11B4 0x06C2 0
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Confiscated..."
    block_9791:
    guard_push block_97CE
    require record[0x1048] == aboard
    guard_pop
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Pirate decoder... You're a cheater..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Confiscated..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "It does'nt work... No confiscated..."
    block_97CE:
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Your documentation isn't in order... Everything is confiscated|..."
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, Commander|, this could be bad in survival terms... What's Cap'n Bob gonna say?"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Be happy... You're alive... Ha! Ha! Ha!|..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Kruiiik!!!"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy snake-oil..."
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "They left us right in the middle of this star soup... How about that..."
    say 0x06C2 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
    run_profile 0x03
    record_clear 0x06FC
    block_9881:
    halt
}
