    say 0x01FA voice=0x09 flags=0x00 display=0x80 loop=none control=none : "Them be GLUXX family... Them be very nice..."
    say 0x01FA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|!!! Commander|!!! Another planetary coordinate, you're my hero, Commander|..."
    say 0x01FA voice=0x0A flags=0x08 display=0xA0 loop=none control=none : "Planet Ekatomb be in EKATOMBUS 435DRTX constellation..."
