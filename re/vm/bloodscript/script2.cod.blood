proc boba1 {
    activation enabled until boba2
    branch_flag_274f
    actor 0x0084 0x0028 0
    require state[0x12B4] == 0x0000
    guard_pop
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "HONK|! You worthless heap of wires... Are you working?"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir, Cap'n Bob sir!|... Just getting the multiplexers toned up|..."
    say 0x004A voice=0x03 flags=0x08 display=0x80 loop=none control=none : "What do you want to know, Commander|?"
    state_array_set 0x01 0x0032
    guard_push block_1D14
    state_array_test 0x01
    guard_pop
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I feel like a dog I micro-waved by mistake one day... I have to cryonize..."
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ahhhh!!!"
    say 0x004A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x12B4] = 0x0002
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
    block_1D14:
    say 0x004A voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I feel weak, Commander|... Let me sleep..." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push boba2
    require state[0x1270] == 0x0001
    guard_pop
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ah, sleep..."
    say 0x004A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    state[0x1270] = 0x0000
    state[0x12B4] = 0x0002
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
}

proc boba2 {
    activation enabled until boba3
    branch_flag_274f
    actor 0x0084 0x0028 0
    require state[0x12B4] == 0x0002
    guard_pop
    say 0x004A voice=0x04 flags=0x08 display=0x80 loop=none control=none : "My bones feel like they've been through a shredder... HONK! Miserable machine! Give me a shot of ASPIROX!!!"
    state[0x1270] = 0x0000
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir, Cap'n Bob. I'm locating the seringe even as I utter these words..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Be careful... Find a spot with some flesh on it. The last time, you stuck the needle straight into a bone!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes! Yes! Cap'n Bob|, I'll be careful, I'll shoot another buttock, I'll choose the third one..."
    say 0x004A voice=0x03 flags=0x08 display=0x80 loop=none control=none : "I'm listening|, Commander|..."
    state_array_set 0x01 0x003C
    guard_push block_1F0A
    state_array_test 0x01
    guard_pop
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "AAARGH!!! HONK YOU STABBED ME IN THE BONE AGAIN... I told you not to do that..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sorry about that, Cap'n Bob. The needle slipped..."
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I feel like the frog who stood up to the truck, Commander|! I have to cryonize..."
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ahhhh!!!"
    say 0x004A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x12B4] = 0x0003
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
    block_1F0A:
    say 0x004A voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I feel awful, Commander|... You're tiring me out... Let me sleep..." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push boba3
    require state[0x1270] == 0x0001
    guard_pop
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sleep..."
    say 0x004A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    state[0x1270] = 0x0000
    state[0x12B4] = 0x0003
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
}

proc boba3 {
    activation enabled until boba4
    branch_flag_274f
    actor 0x0084 0x0028 0
    require state[0x12B4] == 0x0003
    guard_pop
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I'm thirsty... HONK! You reject fridge component! Give me a glass of recycled water!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir, Cap'n Bob! Just locating a clean glass, beaker, mug, cup or other drinking vessel..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Be careful... I said recycled water, not liquid coolant like the last time!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Trust me|, Cap'n Bob! I've learned My lesson. Yes sir! I'm going to taste it to make sure..."
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Don't do that|, you moronic box of longwinded incompetence! You'll short-circuit!"
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "I'm listening, Commander|..."
    state_array_set 0x01 0x0078
    guard_push block_20B9
    state_array_test 0x01
    guard_pop
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I'm too hot... I need to cryonize..."
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "AAAAAAhhhh!!!"
    say 0x004A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x12B4] = 0x0004
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
    block_20B9:
    say 0x004A voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I feel weak as that kitten I accidentally converted to anti-matter, Commander|... Let me get some sleep..." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push boba4
    require state[0x1270] == 0x0001
    guard_pop
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ah, sleep..."
    say 0x004A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    state[0x1270] = 0x0000
    state[0x12B4] = 0x0004
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
}

proc boba4 {
    activation enabled until augmen
    branch_flag_274f
    actor 0x0084 0x0028 0
    require state[0x12B4] == 0x0004
    guard_pop
    guard_push block_221B
    require encounter_count[0x0080] == 0x0006
    guard_pop
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I'm hungry... HONK! You no-good collection of second-hand wiring! Where's the menu!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Coming right up|, Cap'n Bob! Your dinner is heating up in the engine room..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Be careful this time|... Hot food does not have to be curled up, black and smoking!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Not smoking... You got it|, Cap'n Bob|, sir... Would you care to browse through the MENU?"
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WHAT?? GLOK AGAIN!!! I'd like to see you curled up and smoking|..."
    block_221B:
    say 0x004A voice=0x06 flags=0x08 display=0x80 loop=none control=none : "What do you want to know Commander|..."
    state_array_set 0x01 0x005A
    guard_push block_226C
    state_array_test 0x01
    guard_pop
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I need to cryonize..."
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "AAAAAAAAAAAAhhhh!!!"
    say 0x004A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
    block_226C:
    say 0x004A voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I feel weak as that lamb I inadvertently dropped in my shark-pool one day, Commander|... Let me sleep..." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push augmen
    require state[0x1270] == 0x0001
    guard_pop
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ah, sleep..."
    say 0x004A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x1270] = 0x0000
    state_array_set 0x01 0xFFFF
    record_clear 0x0084
}

proc augmen {
    activation enabled until revel
    branch_flag_274f
    actor 0x0084 0x0028 0
    require state[0x12B6] == 0x0001
    require state[0x12B8] == 0x0000
    guard_pop
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "While you're awake, Cap'n Bob|, sir... I have a request to make..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Olga and me would like a raise. A few megawatts..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "WHAT... SPEAK LOUDER... I'M GETTING DEAFER AND DEAFER..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WE WANT MORE MEGAWATTS!!!"
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I feel like that canary I mistook for an oven-ready turkey, Commander|. Haaa!!! My heart...."
    say 0x004A voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Heart!!... He means his power generator... Those guys... Just mention a couple of lousy megawatts!"
    state[0x12B8] = 0x0001
    augmen.enabled = false
}

proc revel {
    activation enabled until caft
    branch_flag_274f
    actor 0x0084 0x0028 0
    require state[0x12BA] == 0x0001
    require state[0x12BC] == 0x0000
    guard_pop
    say 0x004A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You want to know an unbearable truth, Commander|?"
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch off for ten seconds!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But, Cap'n Bob!!..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "YOU HEARD ME... SWITCH YOURSELF OFF!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir|, Cap'n Bob. If you say so..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaaaaaaaaaa!!!"
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME..."
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME PERSON AT TWO DIFFERENT AGES..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MUCH MORE THAN MY SON..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We are the same person... I am the first being to have created itself"
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And who, thanks to space-time distortion, can watch itself re-live: YOU ARE BOB, COMMANDER..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am what you will become hundreds of thousands of years from now..."
    say 0x004A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, you can switch on now..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! You guys should know I have a right to stay informed. That's what being ONBOARD COMPUTER is all about, right?"
    say 0x004A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Was Olga switched off too???"
    state[0x126E] = 0x0001
    say 0x004A voice=0x05 flags=0x08 display=0xA0 loop=none control=none : "Stop snivelling and get to work, you jumped up little fuse box..."
    state[0x12BC] = 0x0001
    state[0x12BA] = 0x0000
    revel.enabled = false
}

proc caft {
    activation enabled until time
    branch_flag_274f
    require state[0x12BE] == 0x0001
    actor 0x0084 0x0028 0
    guard_pop
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob, I have to tell you the Commander has behaved very badly..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He stole money from a defenceless Izwal of planet Corpo and then he spent it|..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'm sorry to say it's true..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Miserable machine!!! WHO DO YOU THINK YOU ARE? He did whatever the situation demanded..."
    say 0x004A voice=0x04 flags=0x10 display=0x80 loop=time control=none : "True, Commander|?" choices "yes" "no"
    guard_push block_26CA
    concept_guard "yes" 0
    guard_pop
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Well... If I remember, there wasn't a lot of choices..."
    say 0x004A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Exactly..."
    clear_alternate_concept
    block_26CA:
    guard_push time
    concept_guard "no" 0
    guard_pop
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You see, you pathetic excuse for a machine: YOU'RE A LIAR!!! I knew it all along..."
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But Cap'n Bob|... I swear it's true..."
    say 0x004A voice=0x02 flags=0x08 display=0x90 loop=none control=none : "SILENCE!!!"
    state[0x12BE] = 0x0000
    clear_alternate_concept
}

proc time {
    activation enabled until radioscr
    guard_pop
    state_array_set 0x03 0x000A
    state_array_set 0x04 0x00C8
    bit_flag 0x06E0 0x02 0
    time.enabled = false
}

proc radioscr {
    activation enabled until sort
    state_array_test 0x03
    guard_pop
    record_link 0x06FC 0x0028 0
    sort.enabled = true
    radioscr.enabled = false
}

proc sort {
    activation disabled until radio1
    branch_presentation
    actor 0x06FC 0x0028 0
    guard_pop
    block_2763:
    say 0x06C2 voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0001
    say 0x06C2 voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0002
    say 0x06C2 voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0003
    say 0x06C2 voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0004
    say 0x06C2 voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0005
    guard_push block_27BC
    require state[0x12C0] == 0x0000
    guard_pop
    jump block_2763
    block_27BC:
    guard_push radio1
    require state[0x12C0] > 0x0000
    guard_pop
    sort.enabled = false
    radio1.enabled = true
}

proc radio1 {
    activation disabled until dring
    branch_presentation
    actor 0x06FC 0x0028 0
    guard_pop
    guard_push block_2904
    require state[0x12C0] == 0x0001
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Calling garbage scow:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT robot \"HYDRAULIC JACK OF TITANIUM ALLOY\", squadron commander..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You are in a forbidden zone... THIS IS A WARNING..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOU ARE SCHEDULED FOR VAPORIZATION IN TWO MINUTES, TEN SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MAKE THAT NINE SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "EIGHT SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "SEVEN..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Get that garbage wagon out of here! Scram! Otherwise my hi-powered laser weapons will spell death!!!..."
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "REPORT FROM THE ARK'S ONBOARD COMPUTER FACILITY, HONK|:"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, He means it|... the whole zone's filled with guys like him: RED ALERT"
    jump block_2D40
    block_2904:
    guard_push block_2A14
    require state[0x12C0] == 0x0002
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "LISTEN UP"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT robot \"NONSTICK HEART\", area sub-director, calling garbage can..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS A WARNING... YOU ARE IN A FORBIDDEN ZONE"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PREPARE FOR PAINFUL OBLITERIZATION IN TEN SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "NINE SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "TWELVE SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "UH, SORRY ABOUT THAT..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "EIGHT..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "LEAVE NOW OR MEET ROSEBUD? MY LASER-PULPER"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Honk reports in at this time:"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I advise we comply fast, Commander. He's liable to skip four and three..."
    jump block_2D40
    block_2A14:
    guard_push block_2AF4
    require state[0x12C0] == 0x0003
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "ATTENTION..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS SCRUT TROOPER \"TUNG STEN\", TO UNKNOWN SHIP-TYPE THING..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I HAVE THE FOLLOWING WARNING: THIS SECTOR IS FORBIDDEN TO Y-O-U!!!"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WE WILL MANGLE YOUR BODY ORGANS, MELT DOWN YOUR MELTABLE PARTS, AND ALSO VITRIFY YOU IF YOU DON'T GO AWAY"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THREE SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "TWO SECONDS..."
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Honk reports, in the nick of time:"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Red Alert!"
    jump block_2D40
    block_2AF4:
    guard_push block_2C2C
    require state[0x12C0] == 0x0004
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "OKAY WHOEVER YOU ARE"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is low-ranking SCRUT robot \"STAINLESS STEEL CASING\", CALLING FLYING JUNK HEAP..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MOVE OUT OF THIS FORBIDDEN SECTOR... AND MAKE IT SNAPPY, BUDDY BOY!!!"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Otherwise you get STOMPED ON..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOU HAVE TEN SECONDS BEFORE ANNIHILATION SETS IN..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "NINE SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "TWELVE SECONDS..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "OKAY OKAY, WISE GUY!"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOU DO THE COUNTING..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "CRUIIIIK!"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Report from Honk, onboard computing entity:"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's true he's no shining beacon of brainpower, Commander|. And yet I feel moved by his obvious sincerity..."
    jump block_2D40
    block_2C2C:
    guard_push block_2D40
    require state[0x12C0] == 0x0005
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "LISTEN UP"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS SCRUT ROBOT \"TENSILE SHEET METAL\", AREA CHIEF, TO UNKNOWN VESSEL..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS A PL7K stroke 38B WARNING: YOU HAVE TWO MINUTES TO EVACUATE THE SECTOR"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "FAILURE TO COMPLY WITH ABOVE PL7K stroke 38B WARNING WILL RESULT IN A 1010..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOURS SINCERELY,"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "SIGNED: SCRUTER \"TENSILE SHEET METAL\", AREA CHIEF WITH ADDED LASER POWER"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Heeeere's Honky!|..."
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That stuff about 1010? That's their way of saying meet your maker. There's a big bunch of them SCRUT ships around here|..."
    jump block_2D40
    block_2D40:
    say 0x06C2 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Whaddaya say we just do like the robot says before the laser pulpers kick in..."
    bits(0x06C4,0x0002) = false
    say 0x06C2 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "CLICK ON THE RED BUTTON ON THE MAP, SELECT A PLANET AND PUSH THE CONTROL STICK..."
    state[0x12C2] = 0x0001
    say 0x06C2 voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "stop"
    radio1.enabled = false
    radioscr.enabled = false
    state_array_set 0x08 0x000A
    radio1.enabled = false
    record_clear 0x06FC
}

proc dring {
    activation enabled until encor
    require encounter_count[0x0590] < 0x0002
    require encounter_count[0x0740] < 0x0002
    state_array_test 0x08
    guard_pop
    record_link 0x06FC 0x0028 0
    state[0x12C4] = 0x0001
    dring.enabled = false
}

proc encor {
    activation enabled until destroy
    require state[0x12C4] == 0x0001
    branch_presentation
    actor 0x06FC 0x0028 0
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT agent K, district director. Message to unknown vessel..."
    guard_push block_2E6E
    require record[0x0F4E] != 0x0D34
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You deaf or something?"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Get out of here|... SWEAR... INSULT..."
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "FINAL WARNING"
    state[0x12C6] = 0x0001
    block_2E6E:
    guard_push block_2F44
    require record[0x0F4E] == 0x0D34
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Next time, you'll really get it|..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You won't have time to be sorry..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha! Ha!|...|...|...|...|...|...|... Hurk! Hurk! Haurk!"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "REPORT FROM HONK:"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|! Commander|! We really fooled those dummies... Ha! Ha! Ha! Ha!"
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Hm! Sorry about that..."
    guard_push block_2F44
    require state[0x12C8] == 0x0000
    guard_pop
    say 0x06C2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Click on the planet Corpo. The Orxx will be automatically ejected..."
    block_2F44:
    say 0x06C2 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    bits(0x06C4,0x0002) = false using alternate_encoding
    say 0x06C2 voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "stop"
    encor.enabled = false
    state[0x12C4] = state[0x12CA]
    destroy.enabled = true
    radiof.enabled = true
    record_clear 0x06FC
}

proc destroy {
    activation disabled until last
    require state[0x12C6] == 0x0001
    state_array_test 0x04
    guard_pop
    radio1.enabled = false
    record_link 0x06FC 0x0028 0
    last.enabled = true
    destroy.enabled = false
}

proc last {
    activation disabled until init
    branch_presentation
    actor 0x06FC 0x0028 0
    guard_pop
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "SWEAR... INSULT... SWEAR... ROARS... INSULT..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You're lucky we've been called to another sector... INSULT..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WE'LL MEET AGAIN... YOU'LL SEE..."
    say 0x06C2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "HEAK! HUURK!!! FILTHY INSULT..."
    say 0x06C2 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "STOP"
    record_clear 0x06FC
    last.enabled = false
}

proc init {
    activation enabled until radiof
    require state[0x12C2] == 0x0001
    guard_pop
    bits(0x0D36,0x0002) = true using alternate_encoding
    state[0x12CC] = state[0x12CE]
    bits(0x0DA2,0x0002) = true using alternate_encoding
    init.enabled = false
}

proc radiof {
    activation disabled until rhom1
    require record[0x0F4E] == 0x0D34
    guard_pop
    radioscr.enabled = false
    radio1.enabled = false
    destroy.enabled = false
    bits(0x06C4,0x0002) = false using alternate_encoding
    radiof.enabled = false
}

proc rhom1 {
    activation enabled until rhom1b
    branch_presentation
    require state[0x12D0] == 0x0000
    require record[0x0F4E] == 0x0C02
    guard_pop
    record_link 0x06B4 0x0028 0
    rhom1b.enabled = true
    rhom1.enabled = false
}

proc rhom1b {
    activation disabled until rhom2
    branch_presentation
    actor 0x06B4 0x0028 0
    guard_pop
    say 0x067A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    topic[0x06C0] = "rien"
    say 0x067A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Beep beep bop bop bop beeep Tiiiii TATATA scraaak..."
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTING IN:"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, that weird message you just heard came from a distant point in the galaxy. It's coded..."
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Excuse me while I figure out what vital information it contains..."
    say 0x067A voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "stop"
    rhom2.enabled = true
    encounter_count[0x06B0] = 0x0000
    state[0x12D0] = 0x0001
    rhom1b.enabled = false
    record_clear 0x06B4
}

