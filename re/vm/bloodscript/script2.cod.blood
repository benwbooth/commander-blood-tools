    say 0x05EA voice=0xFF flags=0x28 display=0x90 loop=none control=none : "LENS TELEPORTED TO CRYOBOX."
    record_triple 0x0624 0x119C 0x0028 0
    clear_alternate_concept
    block_9071:
    say 0x05EA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "thank you and goodbye, dear DEAR client..."
    say 0x05EA voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
