    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We came across Morning Oil on planet Magnus. Boy, was he in a lousy condition..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I instantaneously noticed how flat his batteries were... That's something you'll mention to Cap'n Bob|, won't you, Commander|?|..."
    block_1961:
    guard_push block_19CE
    require state[0x129A] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We bought some batteries for poor old Morning Oil at VENUSIA supramarket..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We put the new batteries in Morning Oil, and he started working again|..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "So we teleported him aboard to study him..."
    block_19CE:
