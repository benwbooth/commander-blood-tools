proc oto1 {
    activation enabled until oto2
    branch_gameflag
    require record[0x0F4E] == 0x097A
    actor 0x0624 0x0028 0
    require state[0x130C] == 0x0000
    guard_pop
    say 0x05EA voice=0x03 flags=0x08 display=0x80 loop=none control=none : "Welcome, dear dear client. Take a seat. Our 3 star clinic is happy to have you|..."
    state[0x12AE] = 0x0001
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am the well-known Doctor OTTO VON SMILE. Why not be happy, since I can make life last for ever... Ha! Ha! Ha!"
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, this guy doesn't feel right to me... Stay alert..."
    say 0x05EA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You seek youth through the ageless power of plants? A new and vibrant body organ perhaps? A little plastic surgery? Here, all is possible!"
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yuk!!! Let's get out of here, Commander..."
    say 0x05EA voice=0x05 flags=0x10 display=0x80 loop=oto2 control=none : "What miracles may I perform for you, dear dear client?" choices "grow_young" "transplant" "surgery"
    guard_push block_8BA6
    concept_guard "grow_young" 0
    guard_pop
    say 0x05EA voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Youth! How exquisitely unoriginal... And so wildly expensive! Tell me|, do you have 200,000 creds?"
    say 0x05EA voice=0x07 flags=0x00 display=0x80 loop=none control=none : "No? You are POOR? How ghastly for you|. ONLY THE RICH MAY TASTE ETERNITY!!"
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What a geek, Commander... Maybe we should wake Cap'n Bob and tell him about eternity..."
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Another time perhaps, dear client and, dare I hope, friend! Ha! Ha! Ha!..."
    say 0x05EA voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    clear_alternate_concept
    record_clear 0x0624
    block_8BA6:
    guard_push block_8CB6
    concept_guard "transplant" 0
    guard_pop
    say 0x05EA voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! A new and vibrant retina? Well|, I have a simply gigantic selection to choose from..."
    say 0x05EA voice=0x06 flags=0x00 display=0x80 loop=none control=none : "For those who desire to see far or near or very near indeed! Ha! Ha! These are lenses of the very highest quality..."
    say 0x05EA voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Each sells for the paltry sum of 2000 creds|... A snip at the price..."
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, that's exactly what Mister MAXXON needs for his telescope..."
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "But you do not have 2000 creds, do you? I find the poor so tasteless!"
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Another time perhaps, dear client..."
    say 0x05EA voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    clear_alternate_concept
    state[0x130C] = 0x0001
    record_clear 0x0624
    block_8CB6:
    guard_push oto2
    concept_guard "surgery" 0
    guard_pop
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! A little operation! Just like everybody else... It's divinely expensive, naturally... Do you have 100,000 creds?"
    say 0x05EA voice=0x05 flags=0x00 display=0x80 loop=none control=none : "No, you don't have such a sum... Well run along and get it|..."
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What a slimeball, Commander..."
    say 0x05EA voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Another time perhaps, dear client and, dare I hope, friend! Ha! Ha! Ha!|..."
    say 0x05EA voice=0xFF flags=0x08 display=0xE0 loop=none control=none : "stop"
    clear_alternate_concept
    record_clear 0x0624
}

proc oto2 {
    activation enabled until oto3
    branch_gameflag
    require record[0x0F4E] == 0x097A
    actor 0x0624 0x0028 0
    require state[0x130C] == 0x0001
    guard_pop
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Well hello, dear client. Do take a seat and admire our 3 star clinic!"
    say 0x05EA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I am as you probably know the admired and respected Doctor OTTO VON SMILE... Ha! Ha! Ha!"
    say 0x05EA voice=0x05 flags=0x00 display=0x80 loop=none control=none : "So you are interested in optical lenses|... I see! So to speak..."
    say 0x05EA voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Allow me to propose a deal... I would like to count SLIMERS among my dear clientele. You wouldn't happen to know of any Slimer planets?|..."
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Why don't you tell me the name of a Slimer planet and I'll give you a lovely little lens. Just one lens... You'll have to pay for the other... Ha! Ha! ha!"
    say 0x05EA voice=0x04 flags=0x10 display=0x80 loop=block_8EC0 control=none : "I'm waiting..." choices "Corpo" "Ekatomb" "Kult" "Troma" "Cyberock" "Moskito" "Tumul"
    guard_push block_8EB7
    concept_guard "Ekatomb" 0
    guard_pop
    state[0x1274] = 0x0001
    clear_alternate_concept
    block_8EB7:
    guard_push block_8EC0
    concept_guard "Ekatomb" 1
    guard_pop
    clear_alternate_concept
    block_8EC0:
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I'll just send some of my drones to verify what you claim..."
    say 0x05EA voice=0x07 flags=0x00 display=0x80 loop=none control=none : "If you've told me the truth, why, then you shall have your little lens..."
    say 0x05EA voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Bye bye for the present, dear dear client..."
    say 0x05EA voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    state[0x130C] = 0x0002
    record_clear 0x0624
}

