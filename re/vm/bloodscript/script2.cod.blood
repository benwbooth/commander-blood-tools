proc corqua {
    activation enabled until pleur
    branch_gameflag
    require record[0x0F4E] == 0x0D34
    require state[0x12E6] == 0x0003
    require state[0x12C8] == 0x0002
    actor 0x0594 0x0028 0
    guard_pop
    say 0x055A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You again|..."
    say 0x055A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You not buy frozen murffalo meat from planet MOSKITO?"
    say 0x055A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We starve. You help us... You give back CRED!!!"
    guard_push block_4EE5
    require record[0x1018] != 0x0028
    guard_pop
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Cap'n Bob won't like it when he finds out you stole that little guy's CRED|..."
    say 0x055A voice=0xFF flags=0x2A display=0x80 loop=none control=none : "Where to find CREDs..."
    state[0x1272] = 0x0001
    block_4EE5:
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "CRY CRY|... Me not want see you again|..."
    say 0x055A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear 0x0594
}

proc pleur {
    activation enabled until pleur1
