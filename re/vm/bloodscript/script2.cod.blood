    require record[0x1018] != 0x055A
    require record[0x1060] != 0x055A
    require state[0x12E6] == 0x0003
    require record[0x0F4E] == 0x0920
    guard_pop
    record_link 0x0594 0x0028 0
    bits(0x055C,0x0002) = true
    pleur1.enabled = true
    pleur.enabled = false
}

proc pleur1 {
    activation disabled until Corpo3
    branch_presentation
    guard_pop
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "RADIO MESSAGE:"
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Hello... I BE BOSSANOVA, wife of Izwalito..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "ME NOT HAPPY. IZWALITO DID GIVE YOU SAVINGS... YOU GIVE BACK CRED!!!"
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Izwal people of Corpo die of hunger... CRY|... CRY|..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You bring murffalo, or you in trouble with BOSSANOVA..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "IZWALITO CRY MUCH..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "CRUIKKK!!!"
    say 0x055A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    state[0x1284] = 0x0001
    pleur1.enabled = false
    bits(0x055C,0x0002) = false
    record_clear 0x0594
}

proc Corpo3 {
    activation enabled until cor4bis
    branch_gameflag
    require record[0x0F4E] == 0x0D34
    require state[0x12C8] == 0x0003
    actor 0x0594 0x0028 0
    guard_pop
    guard_push block_50FE
    require record[0x1060] == 0x0028
    guard_pop
    say 0x055A voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Friend, you have murffalo meat? We starve..."
    say 0x055A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "YOU HAVE MURFFALO!!!!!!"
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You've made one little rat very happy, Commander|. Why not teleport him the meat..."
    say 0x055A voice=0xFF flags=0x10 display=0x80 loop=block_50FE control=none : "TELEPORT MURFFALO TO IZWALITO" choices "teleport" "refuse"
    guard_push block_50BB
    concept_guard "teleport" 0
    guard_pop
    say 0x055A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "MURFFALO TELEPORTED TO IZWALITO"
    record_triple 0x0030 0x104C 0x055A 0
    clear_alternate_concept
    block_50BB:
    guard_push block_50FE
    concept_guard "refuse" 0
    guard_pop
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, you're not being reasonable..."
    say 0x055A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Me unhappy... Me angry..."
    say 0x055A voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Bye bye|..."
    clear_alternate_concept
    record_clear 0x0594
    block_50FE:
    guard_push block_528E
    require record[0x1060] == 0x055A
    guard_pop
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Oh, me happy now. Izwal people say thanks. Me give you big major gifts..."
    say 0x055A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You can see TV with DECODER. Me give you DECODER for IZWAL CHANNEL..."
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "A decoder, Commander|! Now we can have some fun for a change..."
    say 0x055A voice=0x03 flags=0x08 display=0x90 loop=none control=none : "Thanks to DECODER, you can see TV, friend..."
    character_slot 0x01 "ppit"
    character_slot 0x05 "present"
    say 0x055A voice=0xFF flags=0x10 display=0x80 loop=block_51DF control=none : "TELEPORT DECODER TO ARK" choices "teleport"
    guard_push block_51DF
    concept_guard "teleport" 0
    guard_pop
    say 0x055A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "DECODER TELEPORTED TO ARK"
    record_triple 0x0594 0x1034 0x0028 0
    clear_alternate_concept
    block_51DF:
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You love decoder, friend|..."
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "To reward you, me give you one CRED|, friend|..."
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "A cred. Ratboy's handing over a free cred!|... I knew it|... These guys are all millionaires..."
    say 0x055A voice=0xFF flags=0x10 display=0x80 loop=block_528E control=none : "TELEPORT CRED TO ARK" choices "teleport"
    guard_push block_528E
    concept_guard "teleport" 0
    guard_pop
    say 0x055A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "CRED TELEPORTED TO ARK"
    record_triple 0x0594 0x1004 0x0028 0
    clear_alternate_concept
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You love cred, friend|..."
    block_528E:
    say 0x055A voice=0x02 flags=0x48 display=0x80 loop=none control=none : "You come back when want, friend|..." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push cor4bis
    require state[0x1270] == 0x0001
    guard_pop
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me go quick give murffalo to starving Izwals..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend|..."
    say 0x055A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    state[0x1286] = 0x0001
    state[0x1270] = 0x0000
    state[0x12C8] = 0x0004
    record_clear 0x0594
}

proc cor4bis {
    activation enabled until Corpo4
    branch_gameflag
    require record[0x1060] == 0x055A
    require !bits(0x0B2C,0x0002)
    require record[0x0F4E] == 0x0D34
    actor 0x0594 0x0028 0
    guard_pop
    say 0x055A voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Friend from sky and stars back on Corpo..."
    state[0x12E2] = 0x0000
    say 0x055A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me happy, friend|..."
    say 0x055A voice=0x04 flags=0x08 display=0x80 loop=none control=none : "You want what?|..."
    topic[0x05A0] = "talk"
    guard_push block_5418
    require state[0x12E2] == 0x0001
    guard_pop
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You be very curious, friend|..."
    say 0x055A voice=0x03 flags=0x10 display=0x80 loop=block_5418 control=none : "You can keep secret?" choices "yes" "no"
    guard_push block_53D2
    concept_guard "yes" 0
    guard_pop
    say 0x055A voice=0x02 flags=0x08 display=0xA0 loop=none control=none : "Me say you big secret..."
    topic[0x05A0] = "know"
    state[0x12E2] = 0x0000
    clear_alternate_concept
    block_53D2:
    guard_push block_5418
    concept_guard "no" 0
    guard_pop
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|!!! How can you be so lacking in perspicacity? You were supposed to say YES..."
    say 0x055A voice=0x04 flags=0x08 display=0x80 loop=none control=none : "You like make joke..."
    clear_alternate_concept
    block_5418:
    guard_push block_549E
    require !bits(0x0B2C,0x0002)
    require encounter_count[0x0590] > 0x0005
    guard_pop
    say 0x055A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You go see rich Izwals on planet Rondo, friend|... You say them hello from me..."
    say 0x055A voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Rondo be in Rondalus system, coordinates x345 y432..."
    bits(0x0B2C,0x0002) = true
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander he just gave us a new planetary position would you believe, Commander|..."
    block_549E:
    say 0x055A voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Bye bye, come back... You talk good. Me like talk...." choices "bye_bye"
    record_clear 0x0594
}

proc Corpo4 {
    activation enabled until hom1
    branch_gameflag
    require record[0x1060] == 0x055A
    require state[0x12D2] == 0x0000
    require !bits(0x0D54,0x0002)
    require bits(0x0B2C,0x0002)
    require record[0x0F4E] == 0x0D34
    actor 0x0594 0x0028 0
    guard_pop
    say 0x055A voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Izwalito happy see you, friend from sky and stars..."
    Corpo3.enabled = false
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "We receive big visit from His Sacredness HOM... Hom be in next village..."
    say 0x055A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Village be Hita..."
    say 0x055A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "His Sacredness wants to see you, friend|..."
    say 0x055A voice=0x02 flags=0x10 display=0x80 loop=hom1 control=none : "You agree go Hita?" choices "YES" "NO"
    guard_push block_55CA
    concept_guard "YES" 0
    guard_pop
    say 0x055A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You go north through desert to Hita|..."
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "See you soon, friend|..."
    say 0x055A voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "..."
    hom1.enabled = true
    Corpo4.enabled = false
    state[0x12C8] = 0x0005
    record_state 0xC1 0x124E 0x0D52 0
    clear_alternate_concept
    block_55CA:
    guard_push hom1
    concept_guard "NO" 0
    guard_pop
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Maybe you should've agreed, Commander|..."
    say 0x055A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend. Me must go..."
    say 0x055A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    clear_alternate_concept
    record_clear 0x0594
}

proc hom1 {
    activation disabled until M0sk0
    branch_gameflag
    require record[0x01CA] == 0x0D52
    require state[0x12D2] == 0x0000
    actor 0x01EC 0x0028 0
    guard_pop
    Corpo4.enabled = false
    say 0x01B2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Welcome stranger. You be big traveller..."
    say 0x01B2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WOWEE!! Commander, this guy's even uglier than ol' Buzzard Face Bob|... I gotta have a snapshot... Ha|! Ha|! Ha|!"
    say 0x01B2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me HOM. Me big tube brain. Me live on distant planet|..."
    say 0x01B2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me invite you to my planet|, stranger..."
    say 0x01B2 voice=0x09 flags=0x00 display=0x80 loop=none control=none : "You did help Izwals. Very good... You must join MEMBERS GUILD"
    say 0x01B2 voice=0x0A flags=0x00 display=0x80 loop=none control=none : "You go my planet|. I go back in few days..."
    say 0x01B2 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "My planet be KORTEX..."
    say 0x01B2 voice=0x09 flags=0x08 display=0x80 loop=none control=none : "Planet KORTEX be on ZXDT4534 in constellation of KORTESIUS... YOU GO, FRIEND..."
    bits(0x0AF0,0x0002) = true using alternate_encoding
    say 0x01B2 voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "Bye bye, good stranger..."
    state[0x128C] = 0x0001
    state[0x12D2] = 0x0001
    record[0x01CA] = 0x0ECC
    record_clear 0x01EC
}

proc M0sk0 {
    activation enabled until Mosk1
    branch_gameflag
    require record[0x0F4E] == 0x0EEA
    require encounter_count[0x0350] == 0x0001
    require state[0x12EA] == 0x0000
    actor 0x0354 0x0028 0
    guard_pop
    say 0x031A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "MURFFALO FACTORY"
    load_string "moskit20.hnm"
    say 0x031A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me not have time to talk|, stranger. Me have much work. You come back later..."
    say 0x031A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Me have fifty tons of murffalos to chop up|... You come back later..."
    say 0x031A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Me not play... Me work|... You understand..."
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This guy's no fun, Commander... Let's forget him..."
    say 0x031A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Bye bye|... Bronko very busy, much lot work|... You come back..."
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I could be misreading this it, but I don't think he wants to talk, Commander..."
    guard_push block_58B4
    require bits(0x0922,0x0002)
    require record[0x1018] == 0x0028
    guard_pop
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Maybe we should go spend our fortune at the VENUSIA supramarket, Commander. There's bound to be great stuff to buy..."
    block_58B4:
    guard_push block_58F1
    require !bits(0x0922,0x0002)
    require record[0x1018] == 0x0028
    guard_pop
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Let's keep the CRED, Commander. There's bound to be zillions of great things to do with a CRED|..."
    block_58F1:
    say 0x031A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Bye bye... Bronko real busy. Much work|... You come back later..."
    say 0x031A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Bye bye"
    record_clear 0x0354
}

proc Mosk1 {
    activation enabled until Mosk2
    branch_gameflag
    require record[0x0F4E] == 0x0EEA
    require state[0x12C8] == 0x0002
    require state[0x12EA] == 0x0000
    actor 0x0354 0x0028 0
    require encounter_count[0x0350] > 0x0001
    guard_pop
    say 0x031A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "MURFFALO FACTORY"
    load_string "moskit20.hnm"
    guard_push block_5989
    require encounter_count[0x0350] == 0x0002
    guard_pop
    say 0x031A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Me BRONKO... Me great Butcher Chief on Moskito planet."
    block_5989:
    say 0x031A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me greet you, stranger. You come get murffalo for Corpo..."
    say 0x031A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Izwals of Corpo say me you come get murffalo"
    say 0x031A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You have CRED? No credit here|..."
    guard_push block_5AB0
    require record[0x1018] == 0x0028
    guard_pop
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTS:"
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Refuse!!! Commander|. Don't tell me we're gonna give this geek a cred to feed rat types..."
    say 0x031A voice=0xFF flags=0x30 display=0x80 loop=block_5A9E control=none : "TELEPORT CRED TO BRONKO" choices "teleport" "refuse"
    guard_push block_5A59
    concept_guard "teleport" 0
    guard_pop
    say 0x031A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "CRED TELEPORTED TO BRONKO"
    record_triple 0x0030 0x1004 0x031A 0
    clear_alternate_concept
    block_5A59:
    guard_push block_5A9E
    concept_guard "refuse" 0
    guard_pop
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Good work, Commander|..."
    say 0x031A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You waste my time|... Me not have time..."
    say 0x031A voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Bye bye|..."
    clear_alternate_concept
    record_clear 0x0354
    block_5A9E:
    say 0x031A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Thank you, stranger..."
    block_5AB0:
    say 0x031A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "What lousy life... Work always..."
    say 0x031A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "One day, them send me to planet Magnus with other worn-out robots... Lousy life..."
    guard_push block_5B53
    require record[0x1018] == 0x031A
    require record[0x1060] == 0x031A
    guard_pop
    say 0x031A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me give you three tons frozen murffalo meat, not more..."
    say 0x031A voice=0xFF flags=0x30 display=0x80 loop=block_5B53 control=none : "TELEPORT MURFFALO TO ARK" choices "teleport"
    guard_push block_5B53
    concept_guard "teleport" 0
    guard_pop
    say 0x031A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "MURFFALO TELEPORTING TO ARK"
    record_triple 0x0354 0x104C 0x0028 0
    clear_alternate_concept
    block_5B53:
    guard_push block_5C05
    require record[0x1018] == 0x031A
    require record[0x1060] == 0x0028
    guard_pop
    say 0x031A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You be loaded... See you soon, stranger. Come back when want..."
    say 0x031A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Bronko like clients with CRED|... Ha! Ha! Ha!"
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Say, Commander|, do you notice that smell? It's that murffalo meat... What a stink!"
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Those ratboys must tie a knot in their trunks every time they eat..."
    say 0x031A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend|..."
    block_5C05:
    guard_push block_5C68
    require record[0x1018] != 0x0028
    require record[0x1018] != 0x031A
    guard_pop
    say 0x031A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You not have creds? No creds, no murffalo meat... Bye bye, stranger.."
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I suggest we find a CRED someplace, Commander|..."
    say 0x031A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear 0x0354
    block_5C68:
    say 0x031A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x12C8] = 0x0003
    state[0x12EA] = 0x0001
    record_clear 0x0354
}

proc Mosk2 {
    activation enabled until Brorad
    branch_gameflag
    require record[0x0F4E] == 0x0EEA
    require state[0x12EA] == 0x0001
    actor 0x0354 0x0028 0
    guard_pop
    say 0x031A voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Ahhh! A visitor..."
    state[0x1270] = 0x0000
    guard_push block_5D0D
    require encounter_count[0x0350] == 0x0003
    guard_pop
    say 0x031A voice=0x02 flags=0x08 display=0x80 loop=none control=none : "You again, stranger! What you want? You come see your friend Bronko..."
    topic[0x0360] = "weapons"
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Let's not waste too much time, Commander|. The guy's an airhead..."
    block_5D0D:
    guard_push block_5D7F
    require encounter_count[0x0350] == 0x0004
    guard_pop
    say 0x031A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You again... SCRUT not eliminated you? Thousands SCRUT officers on your trail..."
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's losing it... A bad case of SCRUT fixation..."
    say 0x031A voice=0x04 flags=0x08 display=0x90 loop=none control=none : "You contact me by radio, if you need Bronko..."
    bits(0x031C,0x0002) = true
    Brorad.enabled = true
    block_5D7F:
    guard_push block_5EE9
    require encounter_count[0x0350] > 0x0004
    guard_pop
    say 0x031A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Me be alone here... Me hungry of adventure"
    say 0x031A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Me think much. Me think be useful for you|. You take me with you|.."
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You know how to cook?"
    say 0x031A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me know make tasty meals..."
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, maybe that's not such a bad idea. He could handle the cooking..."
    say 0x031A voice=0x06 flags=0x08 display=0x90 loop=none control=none : "You can teleport me in your ship..."
    bits(0x031C,0x0002) = false
    bits(0x031C,0x0020) = true using alternate_encoding
    say 0x031A voice=0xFF flags=0x10 display=0x80 loop=block_5EE9 control=none : "TELEPORT BRONKO TO ARK?" choices "teleport" "refuse"
    guard_push block_5E7A
