    require state[0x1288] == 0x0003
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I quickly decoded the entire message from far away. It said CODED MESSAGE... You will tell Cap'n Bob|, won't you, Commander|?|..."
    block_1691:
    guard_push block_16F8
    require state[0x128A] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We got a pirate message from another player who hooked up to your computer, remember?|..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That other player was impressively talented... He must have used a neural net to link up with us..."
    block_16F8:
    guard_push block_1765
    require state[0x128C] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Izwalito arranged for us to meet Hom, a buddy of his, in the village of HITA..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Hom is a fun person, but strictly no longer at this address mindwise. The poor guy's brain is tubular..."
    block_1765:
    guard_push block_1792
    require state[0x128E] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We teleported Bronko into the cryobox and he gives the planet Ekatomb..."
    block_1792:
    guard_push block_17E9
    require state[0x1290] == 0x0001
    guard_pop
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ha! Ha! I chuckled when I recall that poor Croolis who replaced Bronko as murffalo sales-being on Moskito|..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's called EMASCULATOR, EVISCERATOR's sworn enemy. What a character..."
    block_17E9:
