}

proc Magbis {
    activation enabled until viol1
    branch_gameflag
    require record[0x0F4E] == 0x0C02
    require state[0x12F4] == 0x0001
    require record[0x11E0] != 0x0028
    require record[0x11E0] != 0x028A
    actor 0x02C4 0x0028 0
    guard_pop
    say 0x028A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "RLA RLA LDIR PUSH A,X POP POP HJJKLMDFD KLML HL HFFGFDGHFGJ J KL GJKHL JKLL JG"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK: We ought to get some batteries|, Commander|. This is an interesting robot..."
    say 0x028A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear 0x02C4
}

proc viol1 {
    activation enabled until cach
    branch_gameflag
    require state[0x12F6] == 0x0001
    actor 0x02C4 0x0028 0
    guard_pop
    say 0x028A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "What's that he's saying? Honk! Behave yourself!!!"
    say 0x028A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I'm not deaf... Watch your neurons. Next time, I'll short-circuit you|..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "See, Commander|! It's what I thought... He's getting violent..."
    say 0x028A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me violent?? He's the one who's making trouble. I'm perfectly calm..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "OUCH!!! Commander|, he just gave me an electric shock! Ow! Hey, cut that out, will ya!|..."
    say 0x028A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Serves you right! That's what happens when you mess with me..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, why don't I switch him off, huh? Commander|... OUCH! He did it again|..."
    say 0x028A voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Okay okay. I'll leave you alone..."
    viol1.enabled = false
    state[0x12F6] = 0x0000
}

proc cach {
    activation enabled until Cryomorn2
    branch_gameflag
    require state[0x12F8] == 0x0001
    actor 0x02C4 0x0028 0
    guard_pop
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What's that he's saying? I don't have clearance for that information!!!!!!!!!"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That's outrageous!! We better wake up Cap'n Bob right now..."
    say 0x028A voice=0x03 flags=0x10 display=0x80 loop=Cryomorn2 control=none : "Switch him off, Commander|..." choices "disconnect" "refuse"
    guard_push block_6A49
    concept_guard "disconnect" 0
    guard_pop
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No!!! Commander|..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "AAAAAAAAAAAAAAAAAAA..."
    say 0x028A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Good work, Commander|. You made a wise decision... Hee! Hee! Hee!"
    say 0x028A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "But I don't know anything about that hiding-place, Commander|. I just wanted to annoy Honk|!!!"
    say 0x028A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Let's switch him back on... He's gonna be real mad... Hee! Hee! Hee!"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "So what did he tell you?|... A pack of lies, believe me... SWEAR, INSULT"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Mister Honk ought to mind his language. Signed Olga."
    say 0x028A voice=0xFF flags=0x28 display=0xA0 loop=none control=none : "Olga! Why don't you shut up!!! I'm a very angry onboard computing facility, Commander|..."
    state[0x12F8] = 0x0000
    cach.enabled = false
    clear_alternate_concept
    block_6A49:
    guard_push Cryomorn2
    concept_guard "refuse" 0
    guard_pop
    say 0x028A voice=0x02 flags=0x08 display=0xA0 loop=none control=none : "Too bad. I won't tell you anything at all!!"
    state[0x12F8] = 0x0000
    cach.enabled = false
    clear_alternate_concept
}

proc Cryomorn2 {
    activation enabled until letar
    branch_flag_274f
    require record[0x02A2] == aboard
    require state[0x12F2] == 0x0002
    require record[0x11E0] == 0x028A
    guard_pop
    say 0x028A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ahhh... Morning Oil, veteran of the Great Croolis War, reporting for duty. I greet you and say thank you also..."
    say 0x028A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You gave me back my life... Ah! I feel quite lubrified, I must say! Recharged batteries too, eh?"
    say 0x028A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "My gratitude knows no bounds, noble ones. And I just love your ship. Not a model I'm familiar with..."
    say 0x028A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ahh, if only you'd seen the SPIDER4000 I piloted... Such invigorating combat... BABOOOM... VRRRRRRR CHAKA CHAKA CHAKA..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIOCONSCIOUSNESS HONK REPORTS:"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, this is one deranged robot we got here. I hate him..."
    say 0x028A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We fired at everything that moved, naturally... Luckily, we managed to hide the treasure before the end..."
    say 0x028A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "And my revered master, the splendid Croolis EVISCERATOR was alas made prisoner..."
    say 0x028A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "He knows where the Croolis war treasure is hidden..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTS:"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I think I'll just open him up and check that story..."
    say 0x028A voice=0xFF flags=0x30 display=0x80 loop=block_6D1B control=none : "He's bluffing, Commander... I suppose you want me to switch him off now?" choices "yes" "no"
    guard_push block_6CD5
    concept_guard "no" 0
    guard_pop
    say 0x028A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "NO, YOU'RE OUT OF YOUR MIND... I DON'T WANT THIS TO HAPPEN... MOTHER, HELP!"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK MAKES HIS REPORT:"
    say 0x028A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander|, I think I'll switch him off anyway... His program needs to be checked..."
    clear_alternate_concept
    block_6CD5:
    guard_push block_6D1B
    concept_guard "yes" 0
    guard_pop
    say 0x028A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "NO, YOU'RE OUT OF YOUR MIND... I DON'T WANT THIS TO HAPPEN... MOTHER, HELP!"
    say 0x028A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "HONK:Switch-off procedure activated...."
    clear_alternate_concept
    block_6D1B:
    say 0x028A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "AAAAAAAAAAAAAAA..."
    say 0x028A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x129C] = 0x0001
    state[0x12F2] = 0x0004
    record_clear 0x02C4
}

proc letar {
    activation enabled until morntv
    require state[0x12F2] == 0x0004
    branch_flag_274f
    actor 0x02C4 0x0028 0
    guard_pop
    say 0x028A voice=0x02 flags=0x08 display=0x90 loop=none control=none : "Aaaaaah..."
    state_array_set 0x06 0x000A
    topic[0x02D0] = "letar"
    guard_push morntv
    state_array_test 0x06
    guard_pop
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I love it when they snore like that... Leave him to me|, Commander|. I'll do a GARBAGE RECOVERY on his memory..."
    say 0x028A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x12F2] = 0x0005
    state_array_set 0x06 0xFFFF
    record_clear 0x02C4
}

proc morntv {
    activation enabled until Cryomorn4
    require state[0x12F2] == 0x0005
    actor 0x02C4 0x0028 0
    branch_flag_274f
    guard_pop
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "THE HONK REPORT:"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You're gonna love this, Commander. I put the robot's principal memories together..."
    say 0x028A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "You can watch them on TV channel two..."
    character_slot 0x02 "match"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That droid has seen some weird stuff, Commander|. That hidden treasure story could be true. We'll have to find that planet|."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Give me a little time|... I have to change a couple of blown fuses..."
