proc max1 {
    activation enabled until max2
    branch_gameflag
    require record[0x11B0] != 0x0512
    require record[0x11B0] != 0x0028
    actor 0x054C 0x0028 0
    require state[0x1304] == 0x0000
    guard_pop
    guard_push block_8179
    require encounter_count[0x0548] == 0x0001
    guard_pop
    say 0x0512 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Welcome stranger. Me not know you|. You come from far..."
    say 0x0512 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me Izwal Maxxon. Me be big astronomer. Me build big telescope for see stars."
    say 0x0512 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me like study sky|, stars, galaxies... But me have big problem, friend|..."
    say 0x0512 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Telescope not have good lens. Me seek lens for telescope..."
    say 0x0512 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "With nice lens, me can see stars, galaxies, black holes... Me big hobby, friend|..."
    say 0x0512 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You know?"
    block_8179:
    guard_push block_819A
    require encounter_count[0x0548] > 0x0001
    guard_pop
    say 0x0512 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You're back... Friend... Welcome..."
    block_819A:
    say 0x0512 voice=0x09 flags=0x00 display=0x80 loop=none control=none : "If you get lens, me do big favor for you|..."
    say 0x0512 voice=0x08 flags=0x00 display=0x80 loop=none control=none : "If you hear of LENS, you tell me|, Commander|..."
    say 0x0512 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander|, that telescope of his could help us find some black holes... Smart thinking, huh?"
    say 0x0512 voice=0x08 flags=0x08 display=0x80 loop=none control=none : "See you soon, friend|... You go now... Me have much work|..."
    bits(0x0B62,0x0002) = true using alternate_encoding
    say 0x0512 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "..."
    state[0x1270] = 0x0000
    state[0x12A8] = 0x0001
    record_clear 0x054C
}

