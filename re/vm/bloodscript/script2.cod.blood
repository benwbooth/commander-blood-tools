    concept_guard "refuse" 0
    guard_pop
    say 0x031A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "CRY CRY SWEAR... Me unlucky... Me all alone... CRY CRY..."
    say 0x031A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... Get that guy... What a cry baby... Ha! Ha! Ha!"
    say 0x031A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me sad... Me all alone..."
    say 0x031A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
    clear_alternate_concept
