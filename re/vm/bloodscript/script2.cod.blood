}

proc max2bis {
    activation enabled until max2ter
    branch_gameflag
    actor 0x054C 0x0028 0
    require record[0x11B0] == 0x0512
    require state[0x1306] == 0x0001
    guard_pop
    say 0x0512 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "THIS NOT RIGHT LENS, FRIEND!!!"
    say 0x0512 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS BE STRANGE JELLY LENS..."
    say 0x0512 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No, no, no, Mister Maxxon! Nobody uses glass lenses anymore!"
    say 0x0512 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you just try it|..."
    say 0x0512 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy snake oil, Commander|. Don't they have any progress around here?|... I mean, these Izwals are nice folks,"
    say 0x0512 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "but don't count on them for inventing the wheel..."
    say 0x0512 voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Me try lens. You come back later. Me thank you anyway for effort..."
    say 0x0512 voice=0x09 flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend. See soon..."
    state[0x1272] = 0x0001
    say 0x0512 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Bye bye"
    state[0x12B2] = 0x0001
    state[0x1306] = 0x0002
    record_clear 0x054C
}

