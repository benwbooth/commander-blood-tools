proc rhom2b {
    activation disabled until rhom3
    branch_presentation
    actor 0x06B4 0x0028 0
    guard_pop
    say 0x067A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say 0x067A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Beep beep bop bop bop beeep... Tut Tut Ts Ts Tsk Craaak..."
    say 0x067A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "KRUIKK!"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTS:"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I decoded the first word. It says CODED. Funny, wouldn't you say?"
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "CODED... Well how about that!"
    say 0x067A voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "stop"
    rhom3.enabled = true
    encounter_count[0x06B0] = 0x0000
    state[0x12D0] = 0x0002
