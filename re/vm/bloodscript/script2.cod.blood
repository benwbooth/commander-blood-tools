proc emasc0 {
    activation enabled until Magnus1
    branch_gameflag
    actor 0x0864 0x0028 0
    require record[0x0F4E] == 0x0EEA
    require state[0x12EE] == 0x0000
    guard_pop
    say 0x082A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "What you want, stranger? You want murffalo meat, me new seller..."
    say 0x082A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You have CRED to pay?"
    say 0x082A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "No cred, no murffalo meat..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "So that's Bronko's replacement in the meat-selling business..."
    say 0x082A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You have CRED? No credit here|..."
    guard_push block_6244
    require record[0x1018] == 0x0028
    guard_pop
    say 0x082A voice=0xFF flags=0x30 display=0x80 loop=block_6244 control=none : "TELEPORT CRED TO EMASCULATOR" choices "teleport" "refuse"
    guard_push block_61FF
    concept_guard "teleport" 0
    guard_pop
    say 0x082A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "CRED TELEPORTED TO EMASCULATOR"
    record_triple 0x0030 0x1004 0x031A 0
    state[0x1272] = 0x0001
    say 0x082A voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Thank you, stranger Ha! Ha! Ha!..."
    clear_alternate_concept
    block_61FF:
    guard_push block_6244
    concept_guard "refuse" 0
    guard_pop
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Good work, Commander|..."
    say 0x082A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You waste my time|... Me not have time..."
    say 0x082A voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Bye bye|..."
    clear_alternate_concept
    record_clear 0x0864
    block_6244:
    guard_push block_6255
    require record[0x11C8] != 0x0028
    guard_pop
    state[0x12F0] = 0x0001
    block_6255:
    guard_push block_633B
    require state[0x12F0] == 0x0001
    guard_pop
    say 0x082A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You be adventurer... Me know much things..."
    say 0x082A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me say you this... ME MUCH NEED BIONIUM|..."
    say 0x082A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You bring BIONIUM|, me pay much..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander|, a client!"
    say 0x082A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me give you free container..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What!!! A whole container... Opportunity knocks, Commander|..."
    say 0x082A voice=0xFF flags=0x10 display=0x80 loop=block_633B control=none : "TELEPORT BIONIUM CONTAINER TO ARK" choices "teleport"
    guard_push block_633B
    concept_guard "teleport" 0
    guard_pop
    say 0x082A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "CONTAINER TELEPORTED TO ARK"
    record_triple 0x0864 0x11B4 0x0028 0
    state[0x1290] = 0x0001
    state[0x12F0] = 0x0000
    clear_alternate_concept
    block_633B:
    guard_push block_63F2
    require state[0x126C] > 0x0000
    require record[0x11C8] == 0x0028
    require encounter_count[0x0860] > 0x0001
    guard_pop
    say 0x082A voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Give me your BIONIUM stanger..."
    say 0x082A voice=0xFF flags=0x10 display=0x80 loop=block_63F2 control=none : "TELEPORT BIONIUM TO EMASCULATOR" choices "teleport" "refuse"
    guard_push block_63D6
    concept_guard "teleport" 0
    guard_pop
    say 0x082A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "BIONIUM TELEPORTED TO EMASCULATOR"
    state[0x126C] = 0x0001
    load_string "star2.hnm"
    say 0x082A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "GOOD GOOD... Me much work now... You waste my time|..."
    say 0x082A voice=0x04 flags=0x08 display=0x90 loop=none control=none : "Bye bye..."
    clear_alternate_concept
    record_clear 0x0864
    block_63D6:
    guard_push block_63F2
    concept_guard "refuse" 0
    guard_pop
    say 0x082A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Ok Commander|, you're the boss..."
    clear_alternate_concept
    block_63F2:
    say 0x082A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me much work|... You not waste my time|..."
    say 0x082A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Bye bye stranger"
    record_clear 0x0864
}

proc Magnus1 {
    activation enabled until ad1
    branch_gameflag
    require record[0x0F4E] == 0x0C02
    require state[0x12F2] == 0x0000
    actor 0x02C4 0x0028 0
    guard_pop
    say 0x028A voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Some player shoots again|... Rem RLA LDIR... POP AX... Mov bx,19... deltree."
    topic[0x02D0] = "broken_down"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "COMPUTING ENTITY HONK REPORTS AT THIS TIME|:"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, that's a droid... A robot from the last war..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's broken down. Keep him talking, while I run a few tests..."
    say 0x028A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Rem dir Fatal Error..."
    say 0x028A voice=0xFF flags=0x48 display=0x80 loop=none control=none : "Hello there... Ahhhh..." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push ad1
    require state[0x1270] == 0x0001
    guard_pop
    ad1.enabled = true
    state[0x1270] = state[0x12CA]
    Magnus1.enabled = false
}

proc ad1 {
    activation disabled until Magnus2
    branch_gameflag
    require state[0x12F2] == 0x0000
    guard_pop
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK HERE:"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, I'd kinda like to unscrew a few things and take a look inside the droid..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "His batteries seem flat to me..."
    say 0x028A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "cruik cruiik........... BZZZ..."
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Better get some batteries fast, Commander!"
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We could use this robot..."
    say 0x028A voice=0xFF flags=0x48 display=0x80 loop=none control=none : "Hello there...........krrak.." choices "bye_bye"
    state[0x1270] = 0x0001
    guard_push Magnus2
    require state[0x1270] == 0x0001
    guard_pop
    state[0x12F2] = 0x0001
    state[0x12F4] = 0x0001
    state[0x1298] = 0x0001
    state[0x1270] = state[0x12CA]
    ad1.enabled = false
    record_clear 0x02C4
}

proc Magnus2 {
    activation enabled until Magbis
    branch_gameflag
    require record[0x0F4E] == 0x0C02
    require state[0x12F2] == 0x0001
    actor 0x02C4 0x0028 0
    guard_pop
    guard_push block_6653
    require record[0x11E0] == 0x0028
    guard_pop
    say 0x028A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "khjhkjsd krrak."
    say 0x028A voice=0xFF flags=0x30 display=0x80 loop=block_6653 control=none : "HURRY, Commander|... Teleport him the batteries..." choices "teleport"
    guard_push block_6653
    concept_guard "teleport" 0
    guard_pop
    say 0x028A voice=0xFF flags=0x28 display=0x90 loop=none control=none : "TELEPORTING BATTERIES TO MORNING OIL ROBOT"
    record_triple 0x0030 0x11CC 0x028A 0
    clear_alternate_concept
    block_6653:
    guard_push Magbis
    require record[0x11E0] == 0x028A
    guard_pop
    bits(0x028C,0x0020) = true using alternate_encoding
    say 0x028A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Looks like it's working, Commander|. His brain's emitting alpha waves..."
    say 0x028A voice=0xFF flags=0x30 display=0x80 loop=block_66D4 control=none : "We better get him on board the Ark, Commander|. I'll need to open him up|..." choices "teleport"
    guard_push block_66D4
    concept_guard "teleport" 0
    guard_pop
    say 0x028A voice=0xFF flags=0x28 display=0x90 loop=none control=none : "TELEPORT MORNING OIL TO CRYOBOX"
    record_state 0xC2 0x0030 0x028A 0
    clear_alternate_concept
    block_66D4:
    guard_push Magbis
    require record[0x02A2] == aboard
    guard_pop
    state[0x12F2] = 0x0002
    state[0x12F4] = state[0x12CA]
    state[0x129A] = 0x0001
