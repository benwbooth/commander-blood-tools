proc Corpo1 {
    activation enabled until ad
    branch_gameflag
    require state[0x12C8] == 0x0000
    require record[0x0F4E] == 0x0D34
    actor 0x0594 0x0028 0
    guard_pop
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Olga reporting for \"instant translation\" duty:"
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Oooooh! You stranger... You come from sky... FEAR... FEAR..."
    say 0x055A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "YOU NOT KILL ME... ME NICE. Me be IZWALITO..."
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I don't think we can trust that creature, Commander|. Better watch it carefully..."
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's a species of common space rat..."
    say 0x055A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Izwalito be very hungry... Izwalito want eat..."
    say 0x055A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's just what I figured, Commander|. He wants our food..."
    say 0x055A voice=0x02 flags=0x10 display=0x80 loop=block_3F53 control=none : "You say your name to Izwalito, stranger?" choices "hyper_man" "predatorus" "commander_blood" "Mousy" "jules_verne" "Exterminator" "tarzoom"
    guard_push block_3E91
    concept_guard "commander_blood" 0
    guard_pop
    say 0x055A voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Me greet you Commander."
    state[0x12D4] = 0x0001
