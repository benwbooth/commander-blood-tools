// format: bloodscript-v5
// image: COD

proc pter {
    activation enabled until scrub
    branch_gameflag
    actor 0x0744 0x0028 0
    require record[0x0F4E] == 0x0DA0
    guard_pop
    say 0x070A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "ME SCRUTER JO: SCANNING STRANGER...XRAY....STOP"
    say 0x070A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "ZONE ULTRAFORBIDDEN YOU NOT STAY HERE... YOU GO AWAY..."
    say 0x070A voice=0x01 flags=0x08 display=0x80 loop=none control=none : "FIRST WARNING..."
    character_slot 0x04 "scrut"
    guard_push block_00AC
    require encounter_count[0x0740] > 0x0001
    guard_pop
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh no! Him again|... Commander|, I don't feel happy about that SCRUT robot..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We'll need to be smart, cunning, intelligent and clever..."
    block_00AC:
    guard_push block_00D7
    require encounter_count[0x0740] == 0x0002
    guard_pop
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Watch out, Commander|... Second try... Don't blow it|..."
    block_00D7:
    guard_push block_0104
    require encounter_count[0x0740] == 0x0003
    guard_pop
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I think I found the code, Commander... It's the number 9..."
    block_0104:
    say 0x070A voice=0x01 flags=0x10 display=0x80 loop=block_0227 control=none : "You give identity code:" choices "robyx" "code" "ulikan" "69" "exxos" "electret" "666" "9"
    guard_push block_01BE
    concept_guard "exxos" 0
    guard_pop
    say 0x070A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Yes! Code be EXXOS. You be very Important Being..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Nice work, Commmander, I've got to hand it to you|... How did you figure it out?"
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ol' Turkey Face Bob'll be proud of you when I tell him..."
    say 0x070A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You did give code|. You are the MASTER..."
    clear_alternate_concept
    block_01BE:
    guard_push block_0227
    concept_guard "exxos" 1
    guard_pop
    say 0x070A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You unauthorized. Me exterminate you now..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Uh oh Commander|. He's gonna zap the Orxx..."
    say 0x070A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Bye bye, unauthorized strangers..."
    say 0x070A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "BAAANG!!!"
    load_string "explo3.hnm"
    record_clear 0x0744
    clear_alternate_concept
    block_0227:
    say 0x070A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "GIVE ME YOUR ORDERS, MASTER. I am yours..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, We found the code for programming him..."
    say 0x070A voice=0xFF flags=0x30 display=0x80 loop=scrub control=none : "Let's teleport him|, Commander|. I ought to take a good look at him..." choices "teleport" "refuse"
    guard_push block_02B3
    concept_guard "teleport" 0
    guard_pop
    say 0x070A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORT SCRUTER JO TO CRYOBOX"
    record[0x0722] = aboard
    record_clear 0x0744
    clear_alternate_concept
    block_02B3:
    guard_push scrub
    concept_guard "refuse" 0
    guard_pop
    say 0x070A voice=0xFF flags=0x28 display=0x90 loop=none control=none : "You're the commander, Commander|..."
    clear_alternate_concept
    record_clear 0x0744
}

proc scrub {
    activation enabled until scrujo
    branch_flag_274f
    actor 0x0744 0x0028 0
    guard_pop
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I've reprogrammed him|, Commander|... And I've discovered something weird..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "These SCRUT robots use a psychic structure based on CYBERSPACE|..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I've rigged a system so you can enter it|, Commander... That way you can get some BIONIUM..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "The energy source computers are wild about..."
    say 0x070A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Ask SCRUTER JO a few questions, Commander|. You'll understand..."
    scrub.enabled = false
}

proc scrujo {
    activation enabled until menbr
    branch_flag_274f
    actor 0x0744 0x0028 0
    guard_pop
    say 0x070A voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
    guard_push block_0549
    require state[0x126A] == 0x0000
    guard_pop
    say 0x070A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain to you how get BIONIUM..."
    say 0x070A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures..."
    say 0x070A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX with hand."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me|, Commander|!!"
    say 0x070A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX, you CAPTURE BIOXX on tip of your finger..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Catch him on the tip of your finger!!! Sounds easy as pie, Commander|..."
    say 0x070A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to cybernetic MANTAS"
    say 0x070A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You place BIOXX in belly of Manta..."
    say 0x070A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stay stuck to MANTAS..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'd love to see that..."
    say 0x070A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
    say 0x070A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes!!! BIONIUM|... I can taste it already..."
    say 0x070A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
    say 0x070A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We understand perfectly, Mister SCRUTER JO... Right, Commander?"
    block_0549:
    say 0x070A voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say 0x070A voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh! Me feel better..."
    guard_push block_0613
    require state[0x126C] > 0x0000
    guard_pop
    say 0x070A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work|... You did succeed..."
    say 0x070A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES|!!! Commander|, remind me to tell you you're a champ..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This BIONIUM is extraordinary. My clock frequency's through the roof..."
    say 0x070A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "I feel even smarter... I can feel I'll be a great help to you, Commander|..."
    state[0x126A] = 0x0001
    block_0613:
    guard_push block_069C
    require state[0x126C] == 0x0000
    guard_pop
    say 0x070A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, you didn't understand the technique..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need BIONIUM, Commander|. It makes me smarter..."
    say 0x070A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! You need much much BIONIUM. Ha! Ha!..."
    say 0x070A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you shut up|, wiseguy!!!"
    block_069C:
    say 0x070A voice=0x07 flags=0x08 display=0x80 loop=none control=none : "Bye bye, Commander|. Me return to CYBERSPACE..."
    record_clear 0x0744
}

proc menbr {
    activation enabled until men1
    branch_presentation
    actor 0x08F4 0x0028 0
    require record[0x0332] == aboard
    guard_pop
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"IMPROVED MENU\""
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today CHEF BRONKO has laid on for you:"
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Tasty MURFFALO soup Bronko-style."
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO kidneys Bronko-style."
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO hamburger with Bar-B-Q recycled-oil dip."
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Smooth MURFFALO-chip ice cream."
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say 0x08BA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Chef Bronko says... Burping's bad manners!|..."
    say 0x08BA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear 0x08F4
}

