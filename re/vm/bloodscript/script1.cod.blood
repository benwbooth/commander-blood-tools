proc men5 {
    activation enabled until men6
    branch_presentation
    actor 0x08AC 0x0028 0
    require record[0x0332] != aboard
    guard_pop
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"IMPROVED MENU\""
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Soup of PLASMA HONK-style."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER hearts in green blood coagulate."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "URTIKAN roots, deep fried in recycled oil."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Candied GLOK tongue."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... You eat what you are!..."
    say 0x0872 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    men5.enabled = false
    men6.enabled = true
    record_clear 0x08AC
}

proc men6 {
    activation disabled until tima
    guard_pop
    men1.enabled = true
    men2.enabled = true
    men3.enabled = true
    men4.enabled = true
    men5.enabled = true
    men6.enabled = false
}

proc tima {
    activation enabled until ho
    guard_pop
    state_array_set 0x16 0x0005
    tima.enabled = false
}

proc ho {
    activation enabled until ho1
    state_array_test 0x16
    guard_pop
    record_link 0x0594 0x0028 0
    ho.enabled = false
}

proc ho1 {
    activation enabled until hon
    branch_presentation
    actor 0x0594 0x0028 0
    guard_pop
    say 0x055A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "You found the right button. So far so good..."
    topic[0x05A0] = "rien"
    say 0x055A voice=0xFF flags=0x10 display=0x80 loop=block_04CE control=none : "Click quick, Cap'n Bob is waiting..." choices "explanations" "game"
    guard_push block_04C6
    concept_guard "game" 0
    guard_pop
    say 0x055A voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "GAME"
    run_profile 0x02
    clear_alternate_concept
    record_clear 0x0594
    block_04C6:
    guard_push block_04CE
    concept_guard "explanations" 0
    guard_pop
    clear_alternate_concept
    block_04CE:
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You can modify the text speed by clicking on \"OPTION\""
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You can wake Cap'n Bob by clicking on \"CRYOBOX\""
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Or load a \"Saved Game\" by clicking on \"OPTION\""
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The OPTION \"LAST\" is the \"AUTOMATIC PERMANENT SAVE\". If you forget to save, click on \"LAST\"..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We would like to draw your ATTENTION to certain RISKS..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "If you experience UNUSUAL SENSATIONS, DIZZINESS or FACIAL DISTORTION..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Stay CALM..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "It may only be a CRISIS, a SPELL, a CURSE or, at worst, a SCRAMBLED BRAIN..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "In which case, write to: SUPER ZEN, end of corridor, CRAZYSTONE planet, BABY1 UNIVERSE..."
    say 0x055A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Click quick on \"HONK\". He has important information for YOU..."
    say 0x055A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x0594
}

proc hon {
    activation enabled until BOB1
    branch_presentation
    actor 0x0864 0x0028 0
    guard_pop
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Welcome aboard the ARK, Commander. I'm HONK, your trusted computer..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'm here to help you a lot..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "If the phone rings, just hit the \"RED BUTTON\" in front of you..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob, our revered leader, is cryonized in the CRYOBOX..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Of course you can wake Cap'n Bob and question him... But like not too often, okay?..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob knows everything... That's why he's the boss..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Our ship is currently surrounded by things called stars..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Remember, deep space is no place for night clubs!..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "If you have questions, I have all the answers..."
    say 0x082A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Click quick on \"CRYOBOX\" Cap'n Bob is waiting..."
    say 0x082A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "End of report..."
    record_clear 0x0864
}

proc BOB1 {
    activation enabled until scr2
    branch_flag_274f
    actor 0x0084 0x0028 0
    guard_pop
    say 0x004A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Good day COMMANDER. My name is BOB, BOB MORLOCK..."
    say 0x004A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "If the phone rings, press the \"RED BUTTON\" on the radio to answer..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "My ears are fragile, Commander..."
    say 0x004A voice=0x02 flags=0x10 display=0x80 loop=block_083D control=none : "Do you want me to explain your mission to you, Commander?" choices "yes" "no"
    guard_push block_0834
    concept_guard "no" 0
    guard_pop
    say 0x004A voice=0x06 flags=0x08 display=0x80 loop=none control=none : "I'm going to explain it all the same... It's important..."
    clear_alternate_concept
    block_0834:
    guard_push block_083D
    concept_guard "no" 1
    guard_pop
    clear_alternate_concept
    block_083D:
    say 0x004A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "I'm more than 800,000 years old... I feel ancient, Commander..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Too ancient to go looking for adventure. That's where you come in: I DON'T WANT TO DIE STUPID. I WANT TO SEE THE BIG BANG..."
    say 0x004A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "This ship, specially built for you, is called the ARK. It's a true marvel of technology."
    say 0x004A voice=0x03 flags=0x08 display=0xA0 loop=none control=none : "Just hit the \"SPACE\" bar if you've had enough..."
    load_string "aarche10.hnm"
    say 0x004A voice=0xFF flags=0x08 display=0x80 loop=none control=none : ""
    load_string "aarche20.hnm"
    say 0x004A voice=0xFF flags=0x08 display=0x80 loop=none control=none : ""
    load_string "aarche30.hnm"
    say 0x004A voice=0xFF flags=0x08 display=0x80 loop=none control=none : ""
    load_string "aarche40.hnm"
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I want to understand the world and WHERE I COME FROM... WHY I EXIST..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You and me are going to travel through SPACE and TIME, through BLACK HOLES..."
    say 0x004A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "And quite a few BLACK HOLES later, we'll get to the BIG BANG..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "The tough part will be finding those BLACK HOLES, Commander..."
    say 0x004A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "That's because BLACK HOLES are UNDETECTABLE in the universe. We'll need to make contact with ALIEN BEINGS..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You can expect to see bloodchilling WARS and astonishing PHENOMENA..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "My age dictates I sleep through most of it in the CRYOBOX. WAKE ME ONLY IN AN EMERGENCY. My time is very precious..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I have provided you with an ONBOARD COMPUTER called HONK..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "YOU THERE, HONK?"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK: Yes sir, Cap'n Bob. Present, willing and able..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Why, you hunk 'o junk... YOU WERE ASLEEP!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK: No, Cap'n Bob. I was calculating our trajectory to the black hole! I swear it on my old mother's head!"
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Your mother!! I've a good mind to short-circuit every wire in your lazy carcass! Keep an eye on him, Commander..."
    say 0x004A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "GET TO WORK, HONK!!!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK: Sure thing, Cap'n Bob... I'm crunching numbers as I speak..."
    say 0x004A voice=0x09 flags=0x00 display=0x80 loop=none control=none : "I can't see a thing... Feel so weak..."
    say 0x004A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "IF YOU NEED ME, WAKE ME UP..."
    say 0x004A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "See you later, Commander. Or do I mean earlier? I'm cryonizing... Aaaahhhh!"
    say 0x004A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "The old turkey's out for the count..."
    say 0x004A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    run_profile 0x02
    record_clear 0x0084
}

proc scr2 {
    activation enabled until block_0C0B
    require encounter_count[0x0860] == 0x0001
    require encounter_count[0x0080] == 0x0001
    guard_pop
    run_profile 0x02
    block_0C0B:
    halt
}
