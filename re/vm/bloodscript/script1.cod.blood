proc men4 {
    activation enabled until men5
    branch_presentation
    actor 0x08AC 0x0028 0
    require record[0x0332] != aboard
    guard_pop
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "HONK-style PLASMA soup."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER brain, stewed in its own juice."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "URTIKAN trunk, stuffed with MURFFALO liver."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK dee-lite."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Plenty more in the kitchen!..."
    say 0x0872 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    men4.enabled = false
    record_clear 0x08AC
