// format: bloodscript-v5
// image: COD

proc menbr {
    activation enabled until men1
    branch_presentation
    actor 0x08AC 0x0028 0
    require record[0x0332] == aboard
    guard_pop
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"IMPROVED MENU\""
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today CHEF BRONKO has laid on for you:"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Tasty MURFFALO soup Bronko-style."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO kidneys Bronko-style."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO hamburger with Bar-B-Q recycled-oil dip."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Smooth MURFFALO-chip ice cream."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Chef Bronko says... Burping's bad manners!..."
    say 0x0872 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear 0x08AC
}

proc men1 {
    activation enabled until men2
    branch_presentation
    actor 0x08AC 0x0028 0
    require record[0x0332] != aboard
    guard_pop
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PLASMA soup HONK-style."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER belly in slobber sauce."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Jellied URTIKAN with MURFFALO bone marrow."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK eye pie."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Don't eat with your mouth full!..."
    say 0x0872 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "Stop"
    men1.enabled = false
    record_clear 0x08AC
}

