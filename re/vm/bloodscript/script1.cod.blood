00000932: OP A8 61 61 72 63 68 65 34 30 2E 68 6E 6D 00 00 ; OP_A8 61 61 72 63 68 65 34 30 2E 68 6E 6D 00 00
00000941: TEXT 004A 05 00 80 - - 062E 0692 0398 0785 0248 0790 0577 0796 062E 079C 07A2 00D6 07A7 062E 07AB 00D6 ; TEXT line=0x004A voice=0x05 flags=0x00,0x80 "I want to understand the world and WHERE I COME FROM ... WHY I EXIST ..."
00000969: TEXT 004A 02 00 80 - - 02A6 0577 0697 02AF 06AE 0398 07B1 07B8 07C0 0577 07C6 07B8 07CC 07D2 00D6 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "You and me are going to travel through SPACE and TIME, through BLACK HOLES ..."
0000098F: TEXT 004A 01 00 80 - - 07D8 07DC 0355 07E2 07CC 07D2 07E6 020E 07EC 07F2 0398 0248 072A 072E 00D6 ; TEXT line=0x004A voice=0x01 flags=0x00,0x80 "And quite a few BLACK HOLES later , we'll get to the BIG BANG ..."
000009B5: TEXT 004A 02 00 80 - - 0166 07F6 07FC 0801 0430 0806 080E 07CC 07D2 020E 04E9 00D6 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "The tough part will be finding those BLACK HOLES , Commander ..."
000009D5: TEXT 004A 01 00 80 - - 05B3 0814 07CC 07D2 02AF 081C 012C 0248 0829 0065 0832 0838 0398 083D 0842 0079 084A 0850 00D6 ; TEXT line=0x004A voice=0x01 flags=0x00,0x80 "That's because BLACK HOLES are UNDETECTABLE in the universe . We'll need to make contact with ALIEN BEINGS ..."
00000A03: TEXT 004A 04 00 80 - - 02A6 0313 0857 0398 085E 0862 0870 0577 0875 0881 ; TEXT line=0x004A voice=0x04 flags=0x00,0x80 "You can expect to see bloodchilling WARS and astonishing PHENOMENA..."
00000A1F: TEXT 004A 04 00 80 - - 065A 088E 0892 062E 089B 07B8 08A2 0259 06B4 012C 0248 0565 0065 08A7 08AC 08AF 08B4 08B7 08BA 0065 065A 08C4 02F1 08C9 08CE 00D6 ; TEXT line=0x004A voice=0x04 flags=0x00,0x80 "My age dictates I sleep through most of it in the CRYOBOX . WAKE ME ONLY IN AN EMERGENCY . My time is very precious ..."
00000A5B: TEXT 004A 02 00 80 - - 062E 061E 08D7 003E 0079 08E0 08E3 08EB 05ED 04F7 00D6 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "I have provided you with an ONBOARD COMPUTER called HONK ..."
00000A79: TEXT 004A 02 00 80 - - 04D2 08F4 020E 04F7 059F ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "YOU THERE , HONK ?"
00000A8B: TEXT 004A FF 20 80 - - 08FA 0900 0904 02E7 02ED 0065 0909 020E 0911 0577 0919 00D6 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "HONK: Yes sir, Cap'n Bob . Present , willing and able ..."
00000AAB: TEXT 004A 05 00 80 - - 091E 003E 0923 0928 092B 00D6 04D2 0930 0935 093C ; TEXT line=0x004A voice=0x05 flags=0x00,0x80 "Why, you hunk 'o junk ... YOU WERE ASLEEP !!!"
00000AC7: TEXT 004A FF 20 80 - - 08FA 0940 020E 02E7 02ED 0065 062E 0943 0947 0548 0953 0398 0248 095E 0964 00F0 062E 0969 06B4 0037 096F 06D4 0972 097B 00F0 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "HONK: No , Cap'n Bob . I was calculating our trajectory to the black hole ! I swear it on my old mother's head !"
00000B01: TEXT 004A 02 00 80 - - 0980 0985 098C 098F 0355 02D0 0994 0398 0999 09A7 09AD 012C 0179 09B2 09B7 00F0 09BF 08E0 015E 0037 0584 020E 04E9 00D6 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "Your mother !! I've a good mind to short-circuit every wire in your lazy carcass ! Keep an eye on him , Commander ..."
00000B39: TEXT 004A 05 00 80 - - 09C4 0714 09C8 020E 04F7 093C ; TEXT line=0x004A voice=0x05 flags=0x00,0x80 "GET TO WORK , HONK !!!"
00000B4D: TEXT 004A FF 20 80 - - 08FA 09CD 09D2 02E7 02ED 00D6 04F3 09D9 09E3 09EB 062E 09EE 00D6 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "HONK: Sure thing, Cap'n Bob ... I'm crunching numbers as I speak ..."
00000B6F: TEXT 004A 09 00 80 - - 062E 09F4 085E 0355 09FA 00D6 0A00 02CD 0A05 00D6 ; TEXT line=0x004A voice=0x09 flags=0x00,0x80 "I can't see a thing ... Feel so weak ..."
00000B8B: TEXT 004A 02 00 80 - - 0A0A 04D2 0A0D 08AC 020E 08A7 08AC 0A12 00D6 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "IF YOU NEED ME , WAKE ME UP ..."
00000BA5: TEXT 004A 04 00 80 - - 0A15 003E 07E6 020E 04E9 0065 034D 0A19 062E 0A1C 0A21 059F 04F3 0A29 00D6 0A34 00F0 ; TEXT line=0x004A voice=0x04 flags=0x00,0x80 "See you later , Commander . Or do I mean earlier ? I'm cryonizing ... Aaaahhhh !"
00000BCF: TEXT 004A FF 20 80 - - 0166 06D4 0A3D 0A46 003A 0248 0A4A 00D6 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "The old turkey's out for the count ..."
