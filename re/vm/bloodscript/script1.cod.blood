    activation enabled until men4
    branch_presentation
    require record[0x0332] != aboard
    actor 0x08AC 0x0028 0
    guard_pop
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PLASMA soup HONK-style."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER feet in emulsive sauce."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "URTIKAN leaves in MURFFALO sweat."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK flake dessert."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Somebody didn't finish his wrigglers yesterday..."
