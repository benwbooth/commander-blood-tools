proc beau_055C
    conditional_block 0x01 beaureg
    branch_flag_274f
    actor 0x06B4 0x0028 0
    shared_bit_state 0xB0 0x104E 0x0002 1
    shared_state 0xC0 0x150C 0xF5 0xC1 0x0000
    guard_pop
    say 0x067A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ahhhh... Commander|... I feel better now|..."
    say 0x067A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I saw the flames of hell, Commander. Not a pretty sight.."
    say 0x067A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Honk has explained our problem, Commander. Looks like the mummy of BETAKAM IV threw a spell on us..."
    say 0x067A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Commander|... I'd like to find the planet PATAGOS and meet king BETAKAM IV..."
    say 0x067A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "It's amazing, Commander... We have his mummy aboard and yet we can meet him as a living being..."
    say 0x067A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "That's a unique archeological experiment..."
    say 0x067A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "According to the ancient texts from PATAGOS, Tumul translates as Attrox..."
    say 0x067A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "So the thing to do is find the planet Attrox, Commander..."
    say 0x067A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, Mister Beauregard is so amazingly intelligent..."
    say 0x067A voice=0x01 flags=0x08 display=0x80 loop=none control=none : "See you soon, Commander..."
    record_clear 0x06B4
end proc beau_055C

