    say 0x0092 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Halt! Who goes there? I am ROTATOR, second class Croolis ventriloquist..."
    say 0x0092 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Careful, stranger|. Don't try anything... My laser-pulper could do bad things to your body..."
    say 0x0092 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Rotator's laser-pulper is set to maximum pulp position..."
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, this could be tricky... I'm scared..."
    say 0x0092 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "My chief will want to see you|... Your toes will be toasted and your eardrums punctured in several places..."
    say 0x0092 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Your limbs will be reduced to paste texture. Your nose will be removed, your skin peeled off..."
    say 0x0092 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You will be required to eat your teeth... repeatedly..."
    say 0x0092 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Co Co... Commander... Maybe this isn't such a good place to be..."
    say 0x0092 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "The CHIEF is waiting..."
    record_state 0xC1 0x14F0 0x0BA8 0
    poke_byte 0x36CE 0x00
end proc masta1

proc masta2
    conditional_block 0x01 masta6
    branch_gameflag
    actor 0x01A4 0x0028 0
    guard_pop
    say 0x016A voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Enter, Commander|... Surprised that I call you Commander|???"
    say 0x016A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Our radar has been tracking you for some time|..."
    say 0x016A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "We know you visited the Tromps... I've sent a full report to General EVISCERATOR..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This is serious, Commander|. These folks are using this base to prepare for war!"
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "THEY 'RE BUILDING MORNING OILS!!!"
    say 0x016A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "We're going to eliminate you|... WE KNOW YOU POSSESS THE CROOLIS WAR TREASURE..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What? We don't have any such thing!"
    say 0x016A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Excuse me, Commander|... But I'm having trouble getting to sleep|..."
    load_string "hboc.hnm"
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This isn't a good moment, Mister Beauregard|..."
    say 0x016A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "I have something on my conscience... Something I have to confess to you|..."
    load_string "hboc.hnm"
    say 0x016A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "The treasure... Commander|... EVISCERATOR's treasure... You see, I found it, Commander..."
    load_string "hboc.hnm"
    say 0x016A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "It's... IN THE MUMMY..."
    load_string "hboc.hnm"
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh boy That wasn't the smartest thing you ever did, Mister Beauregard..."
    say 0x016A voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Well, I did intend telling you|..."
    load_string "hboc.hnm"
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Looks like we'd better hand over the mummy|, Commander|..."
    say 0x016A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "If you've quite finished your nice little conversation... I'd like your attention..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's pretty persuasive, I find..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No problem We'll teleport you the treasure... It's safe inside a mummy..."
    say 0x016A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "We know it's safe inside a mummy. We're the ones who hid it there!"
    say 0x016A voice=0xFF flags=0x10 display=0x80 loop=block_3AEE control=none : "TELEPORT MUMMY TO CROOLIS OUTRAGEOR" choices "teleport"
    guard_push block_3AEE
    concept_guard "teleport" 0
    guard_pop
    say 0x016A voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING MUMMY TO OUTRAGEOR"
    record_triple 0x0030 0x11FE 0x016A 0
    clear_alternate_concept
    block_3AEE:
    say 0x016A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha! Everything in its place, as I always say..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "LET MISTER MAXXON GO FREE..."
    say 0x016A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "HA! HA! HA! I'll think about it... maybe|... Ha! Ha! Ha!"
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We're dealing with an exceptionally witty Croolis here, Commander|..."
    say 0x016A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Get out of here|... Don't let me see you again!"
    say 0x016A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "Bye bye"
    state_array_set 0x0F 0x003C
    record_wildcard 0xAF 0x0182 0x10A6 0
