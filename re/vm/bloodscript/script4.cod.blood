    say 0x079A voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Bye bye|... Me go phone female Tromp"
    say 0x079A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Trompette live on planet Magnu... Heee! Hee|! Hee! Me like female Tromp..."
    say 0x079A voice=0x01 flags=0x08 display=0x80 loop=none control=none : "Magnu be at coordinates x453 y543..."
    shared_bit_state 0xAE 0x0DA8 0x0002 0
    say 0x079A voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "Bye bye..."
    poke_byte 0x06FE 0x00
    poke_byte 0x08FB 0x01
