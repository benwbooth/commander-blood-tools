    say 0x079A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Heh heh... That guy's funny, Commander... I love his name..."
    say 0x079A voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Fifi like gift"
    say 0x079A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "OOO! eat"
