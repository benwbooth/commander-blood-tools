proc bronk2
    conditional_block 0x01 scrujo
    branch_flag_274f
    actor 0x054C 0x0028 0
    guard_pop
    say 0x0512 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me busy do onboard cooking. Me make tasty meals for Cap'n Bob..."
    say 0x0512 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Let him do his job, Commander|. It's about time we had something edible to eat|..."
    say 0x0512 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me not have time|, Commander|..."
    say 0x0512 voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x054C
end proc bronk2

proc scrujo
    conditional_block 0x01 recept
    branch_flag_274f
    actor 0x08AC 0x0028 0
    guard_pop
    say 0x0872 voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
    guard_push block_0315
    shared_state 0xC0 0x150E 0xF5 0xC1 0x0000
    guard_pop
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain to you how get BIONIUM..."
    say 0x0872 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures|..."
    say 0x0872 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX once with hand."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me, Commander!!"
    say 0x0872 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX twice, you CAPTURE BIOXX on tip of your finger..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Catch him on the tip of your finger!!! Sounds easy as pie, Commander|..."
    say 0x0872 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to cybernetic MANTAS"
    say 0x0872 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You place BIOXX in belly of Manta..."
    say 0x0872 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stay stuck to MANTAS..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'd love to see that..."
    say 0x0872 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
    say 0x0872 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes!!! BIONIUM|... I can taste it already..."
    say 0x0872 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
    say 0x0872 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We understand perfectly, Mister SCRUTER JO... Right, Commander?"
    block_0315:
    say 0x0872 voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say 0x0872 voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh! Me feel better..."
    guard_push block_03DF
    shared_state 0xC0 0x1510 0xF2 0xC1 0x0000
    guard_pop
    say 0x0872 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work... You did succeed..."
    say 0x0872 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!! Commander|, remind me to tell you you're a champ..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This BIONIUM is extraordinary. My clock frequency's through the roof..."
    say 0x0872 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "I feel even smarter... I can feel I'll be a great help to you|, Commander|..."
    shared_state 0xC0 0x150E 0xF5 0xC1 0x0001
    block_03DF:
    guard_push block_0468
    shared_state 0xC0 0x1510 0xF5 0xC1 0x0000
    guard_pop
    say 0x0872 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, you didn't understand the technique..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need BIONIUM, Commander|. It makes me smarter..."
    say 0x0872 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! You need much much BIONIUM. Ha! Ha!..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you shut up, wiseguy!!!"
    block_0468:
    say 0x0872 voice=0x07 flags=0x08 display=0x80 loop=none control=none : "Bye bye|, Commander|. Me return to CYBERSPACE..."
    record_clear 0x08AC
end proc scrujo

