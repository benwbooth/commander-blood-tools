proc augmen
    conditional_block 0x01 revel
    branch_flag_274f
    actor 0x027C 0x0028 0
    shared_state 0xC0 0x1528 0xF5 0xC1 0x0001
    shared_state 0xC0 0x152A 0xF5 0xC1 0x0000
    guard_pop
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "By the way, Cap'n Bob sir, I have a request to make..."
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Olga and me want a raise... Just a few more megawatts..."
    say 0x0242 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "WHAT... YOU'LL HAVE TO SPEAK LOUDER... I'M GETTING A BIT DEAF COMMANDER..."
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WE WANT A RAISE IN MEGAWATTS!!!"
    say 0x0242 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I'm feeling a bit sick, Commander|. Aaah!!! It's my heart...."
    say 0x0242 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Heart my foot... he means his power generator. They're all the same... You just have to say the word raise."
    shared_state 0xC0 0x152A 0xF5 0xC1 0x0001
end proc augmen

proc revel
    conditional_block 0x01 block_5157
    branch_flag_274f
    actor 0x027C 0x0028 0
    shared_state 0xC0 0x152C 0xF5 0xC1 0x0001
    shared_state 0xC0 0x152E 0xF5 0xC1 0x0000
    guard_pop
    say 0x0242 voice=0x07 flags=0x00 display=0x80 loop=none control=none : "I'm going to tell you an unbearable truth, Commander:"
    say 0x0242 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch yourself off for ten seconds!!!"
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But Cap'n Bob... I..."
    say 0x0242 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I SAID SWITCH OFF, GOSH DARN IT!!!"
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir....."
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaaaaaaaaaa!!!"
    say 0x0242 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME...."
    say 0x0242 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES..."
    say 0x0242 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MUCH MORE THAN A SON TO ME..."
    say 0x0242 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We're the same person... I am the first self-creating being!"
    say 0x0242 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Thanks to space-time contortion, I can relive my youth: YOU ARE BOB, COMMANDER..."
    say 0x0242 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am what you'll be in several hundred thousand years..."
    say 0x0242 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, you can switch on..."
    say 0x0242 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! -&Look, I'm supposed to know everything that goes on around here!... Don't tell me you switched off Olga???"
    say 0x0242 voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Cut the whining and get to work..."
    shared_state 0xC0 0x152E 0xF5 0xC1 0x0001
    shared_state 0xC0 0x152C 0xF5 0xC1 0x0000
    block_5157:
    halt
end proc revel
