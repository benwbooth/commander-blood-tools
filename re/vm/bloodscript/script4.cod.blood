    say 0x079A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Haga...."
    say 0x079A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "HATA HATA..."
    say 0x079A voice=0xFF flags=0x00 display=0x80 loop=none control=none : "HOGLO HOGLO..."
    say 0x079A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "You can interrogate him, Commander. He's ready..."
    record_wildcard 0xBC 0x07E0 0x0006 0
    say 0x079A voice=0xFF flags=0x48 display=0x90 loop=none control=none : "Bye bye, Commander..." choices "bye_bye"
