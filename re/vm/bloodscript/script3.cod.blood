proc hom1 {
    activation enabled until hom2
    branch_gameflag
    require record[0x116A] != 0x0028
    require record[0x1088] == 0x0BF0
    require state[0x13FE] == 0x0000
    actor 0x030C 0x0028 0
    guard_pop
    topic[0x0318] = "rien"
    say 0x02D2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Welcome, stranger..."
    say 0x02D2 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You be great traveller..."
    guard_push block_1C00
    require encounter_count[0x0308] == 0x0001
    guard_pop
    say 0x02D2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WOWEE!! Commander, he's even uglier than ol' Turkeyface Bob... Ha|! Ha|! Ha|!"
    say 0x02D2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me HOM. Me big tube brain|. Me delighted receive you|, Commander|..."
    say 0x02D2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me catch your print, friend|... Me read TRUTH in print..."
    say 0x02D2 voice=0x03 flags=0x10 display=0x80 loop=block_1C00 control=none : "You click hard, friend. Me catch your print on mouse button..." choices "click" "refuse"
    guard_push block_1BB1
    concept_guard "click" 0
    guard_pop
    say 0x02D2 voice=0x03 flags=0x08 display=0x80 loop=none control=none : "You not click hard enough..."
    clear_alternate_concept
    block_1BB1:
    guard_push block_1C00
    concept_guard "refuse" 0
    guard_pop
    say 0x02D2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You refuse... Me not like that... Me suspect you..."
    say 0x02D2 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Bye bye|... Me not like you refuse..."
    say 0x02D2 voice=0x02 flags=0x08 display=0x90 loop=none control=none : "..."
    clear_alternate_concept
    record_clear 0x030C
    block_1C00:
    say 0x02D2 voice=0x03 flags=0x10 display=0x80 loop=block_1C61 control=none : "You click very very hard, friend. Me catch print on mouse..." choices "click"
    guard_push block_1C61
    concept_guard "click" 0
    guard_pop
    say 0x02D2 voice=0x03 flags=0x08 display=0x90 loop=none control=none : "Ahh|! Me catch print... Ohh, you nice print..."
    load_string "scandoig.hnm"
    clear_alternate_concept
    block_1C61:
    say 0x02D2 voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Ooooouh! Me see you|, friend|... You have pretty box with picture of Hom inside..."
    load_string "kort.hnm"
    say 0x02D2 voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Me read prints. You have little mouse in hand with long long tail..."
    say 0x02D2 voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Me see keyboard... And oh! CDROM double speed. Nice hard disk... You be lucky, friend|..."
    say 0x02D2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Welcome to my planet, stranger..."
    say 0x02D2 voice=0x09 flags=0x00 display=0x80 loop=none control=none : "You help my Izwal friends from planet Corpo. You be nice... You must join GUILD OF MEMBERS"
    say 0x02D2 voice=0x0A flags=0x00 display=0x80 loop=none control=none : "GUILD OF MEMBERS be big cybernetic organization..."
    say 0x02D2 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "To be in GUILD OF MEMBERS you must be initiated..."
    say 0x02D2 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You know universe. You must take exam..."
    say 0x02D2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You go to planet CYBEROCK where be cyber university..."
    say 0x02D2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You take cyber studies, friend|..."
    say 0x02D2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "And you take cyber exam to be D.O.R.K., Doctor of Rare Knowledge..."
    say 0x02D2 voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Cyberock be in Cyberius system, coordinates X234 Y546..."
    bits(0x0DFC,0x0002) = true using alternate_encoding
    say 0x02D2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "And one more planet to visit! We're going places..."
    say 0x02D2 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Me wait for you with D.O.R.K. Doctor of Rare Knowledge diploma..."
    say 0x02D2 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "Bye bye, friend|..."
    state[0x13FE] = 0x0001
    record_clear 0x030C
}

