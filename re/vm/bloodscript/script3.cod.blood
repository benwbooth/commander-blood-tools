proc augmen {
    activation enabled until revel
    branch_flag_274f
    actor 0x01A4 0x0028 0
    require state[0x1442] == 0x0001
    require state[0x1444] == 0x0000
    guard_pop
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "By the way, Cap'n Bob sir, there's something I wanted to talk to you about..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ginette and I would like a raise... Even a few megawatts would be appreciated..."
    say 0x016A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "WHAT? SPEAK LOUDER... I'M GETTING A LITTLE DEAF COMMANDER..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WE WANT A RAISE!!!"
    say 0x016A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I don't feel at all well, Commander|. Aaah!!! It's my heart...."
    say 0x016A voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Heart... He means his generator... They're all the same, as soon as you mention a couple of lousy megawatts..."
    state[0x1444] = 0x0001
}

proc revel {
    activation enabled until block_8839
    branch_flag_274f
    actor 0x01A4 0x0028 0
    require state[0x1446] == 0x0001
    require state[0x1448] == 0x0000
    guard_pop
    say 0x016A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You want to know an unbearable truth, Commander|?"
    say 0x016A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch yourself off for ten seconds!!!"
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Bu... But Cap'n Bob... I..."
    say 0x016A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "SWITCH OFF I SAID!!!"
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Okay sir....."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaaaaaaaaaa!!!"
    say 0x016A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME...."
    say 0x016A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES..."
    say 0x016A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MUCH MORE THAN A SON TO ME..."
    say 0x016A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We're the same person... I am the first being to create himself"
    say 0x016A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And who can study himself when he was younger, all thanks to space and time. YOU ARE BOB, COMMANDER..."
    say 0x016A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am who you'll become in a few hundred thousand years..."
    say 0x016A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, We've finished..."
    say 0x016A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! I ought to be aware of everything that goes on here. I AM the onboard computer, aren't I?... You didn't switch off Olga I hope"
    say 0x016A voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Can it and get to work!!!..."
    state[0x1448] = 0x0001
    state[0x1446] = 0x0000
    block_8839:
    halt
}
