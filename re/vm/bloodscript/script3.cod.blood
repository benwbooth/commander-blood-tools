    say 0x0362 voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "stop"
    bonjo.enabled = true
    bonjour.enabled = true
    state[0x1402] = 0x0000
    state[0x1404] = 0x0000
    record_clear 0x039C
}

