proc eda {
    activation enabled until ed2
    branch_gameflag
    require record[0x1088] == 0x0C98
    require state[0x1408] == 0x0000
    actor 0x08AC 0x0028 0
    guard_pop
    say 0x0872 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Hey|! Handsome stranger. You come to see Tina?..."
    say 0x0872 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You're in pretty bad shape. Burny'll fix you up.."
    say 0x0872 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You're my idea of a real man... You got something special... I can sniff out real males from lights years away..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Honk reporting at this time:"
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Be on your guard, Commander|. Resist her seductive charms..."
    say 0x0872 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "I'm Tina Burner, but my best friends call me Burny..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, your pulse rate is way too high... I'll just give you a shot of something... Commander|, are you listening?"
    say 0x0872 voice=0x04 flags=0x10 display=0x80 loop=block_3B6F control=none : "Hey! handsome! Still living with mommy and daddy?" choices "yes" "no"
    guard_push block_3B37
    concept_guard "yes" 0
    guard_pop
    say 0x0872 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "AAAARHHH! He still needs his mommy... Ha|! Ha|! Hee|! Hee|!|..."
