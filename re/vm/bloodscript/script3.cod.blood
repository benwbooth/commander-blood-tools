proc bonjo {
    activation enabled until dork_ok
    branch_gameflag
    require state[0x1400] == 0x0000
    actor 0x039C 0x0028 0
    require record[0x1088] == 0x0DFA
    guard_pop
    say 0x0362 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Student Commander Blood, today marks a turning point in your life..."
    say 0x0362 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy sombreros, Commander|. It's ugly!|..."
    say 0x0362 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I shall be your DORK examiner. You can become a Doctor Of Rare Knowledge..."
    say 0x0362 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Dummy! At your age I was already a NERD, a Notarized Expert in Rare Doctorates..."
    say 0x0362 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Don't take any notice, Commander|. Anything that repulsive can't be a real NERD..."
    say 0x0362 voice=0x04 flags=0x08 display=0x90 loop=none control=none : "Here are the questions... Are you ready?"
    bonjour.enabled = false
    bonjo.enabled = false
}

proc dork_ok {
    activation enabled until perdu
    branch_gameflag
    actor 0x039C 0x0028 0
    require state[0x1404] == 0x0005
    guard_pop
    say 0x0362 voice=0x01 flags=0x08 display=0x80 loop=none control=none : "I hereby declare you a DORK!"
    load_string "cadeaux.hnm"
    say 0x0362 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!!! WAY TO GO, COMMANDER. I KNEW YOU HAD IT IN YOU..."
    say 0x0362 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Here is your official DORK diploma..."
    say 0x0362 voice=0xFF flags=0x10 display=0x80 loop=block_2414 control=none : "TELEPORT DIPLOMA TO ARK" choices "teleport"
    guard_push block_2414
    concept_guard "teleport" 0
    guard_pop
    say 0x0362 voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING DORK DIPLOMA TO ARK"
    record_triple 0x039C 0x1156 0x0028 0
    clear_alternate_concept
    block_2414:
    say 0x0362 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You are now ready to pass the S.U.C.K.E.R. exam, to become a Specialised Universal Cosmic Knowledge Expert Recognizer..."
    say 0x0362 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "See you soon|, Commander..."
    say 0x0362 voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x1404] = 0x0000
    state[0x1402] = 0x0000
    record_clear 0x039C
}

proc perdu {
