// format: bloodscript-v5
// image: COD

proc INIT2 {
    activation enabled until scrujo
    guard_pop
    bits(0x1006,0x0002) = true
    bits(0x0E1A,0x0002) = true
    record[0x11CA] = aboard
    bits(0x0A24,0x0002) = true
    bits(0x0D06,0x0002) = true
    bits(0x0C2E,0x0002) = true
    bits(0x0FCA,0x0002) = true
    bits(0x0A7E,0x0002) = true
    bits(0x0BF2,0x0002) = true
    bits(0x0AEA,0x0002) = true
    bits(0x01B4,0x0002) = true
    bits(0x094C,0x0001) = true
    bits(0x0514,0x0001) = true
    record[0x0962] = 0x1022
    record[0x0182] = aboard
    record[0x0452] = aboard
    record[0x03C2] = 0x1096
    record[0x0332] = 0x0FE6
    record[0x040A] = 0x0FE6
    record[0x064A] = 0x0FE6
    record[0x0692] = 0x0FE6
    record[0x02EA] = 0x0BF0
    record[0x0722] = 0x0FE6
    state[0x13EC] = 0x0001
    state[0x13EE] = 0x0003
    character_slot 0x01 "microkid"
    character_slot 0x02 "ppit"
    character_slot 0x03 "hatetv"
    character_slot 0x04 "venus"
    character_slot 0x05 "scrut"
    character_slot 0x06 "match"
    record[0x04E2] = 0x0D04
    INIT2.enabled = false
}

proc scrujo {
    activation enabled until clay1
    branch_flag_274f
    actor 0x081C 0x0028 0
    guard_pop
    say 0x07E2 voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
    guard_push block_0296
    require state[0x13EC] == 0x0000
    guard_pop
    say 0x07E2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain to you how get BIONIUM..."
    say 0x07E2 voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures..."
    say 0x07E2 voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX once with hand."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me, Commander!!"
    say 0x07E2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX twice, you CAPTURE BIOXX on tip of your finger..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Catch him on the tip of your finger!!! Sounds easy as pie, Commander|..."
    say 0x07E2 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to cybernetic MANTAS"
    say 0x07E2 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You place BIOXX in belly of Manta..."
    say 0x07E2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stay stuck to MANTAS..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'd love to see that..."
    say 0x07E2 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
    say 0x07E2 voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes!!! BIONIUM|... I can taste it already..."
    say 0x07E2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
    say 0x07E2 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We understand perfectly, Mister SCRUTER JO... Right, Commander?"
    block_0296:
    say 0x07E2 voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say 0x07E2 voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh! Me feel better..."
    guard_push block_0360
    require state[0x13EE] > 0x0000
    guard_pop
    say 0x07E2 voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work... You did succeed..."
    say 0x07E2 voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!! Commander|, remind me to tell you you're a champ..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This BIONIUM is extraordinary. My clock frequency's through the roof..."
    say 0x07E2 voice=0xFF flags=0x28 display=0x80 loop=none control=none : "I feel even smarter... I can feel I'll be a great help to you|, Commander|..."
    state[0x13EC] = 0x0001
    block_0360:
    guard_push block_03E9
    require state[0x13EE] == 0x0000
    guard_pop
    say 0x07E2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, you didn't understand the technique..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need BIONIUM, Commander|. It makes me smarter..."
    say 0x07E2 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! You need much much BIONIUM. Ha! Ha!..."
    say 0x07E2 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you shut up, wiseguy!!!"
    block_03E9:
    say 0x07E2 voice=0x07 flags=0x08 display=0x80 loop=none control=none : "Bye bye, Commander|. Me return to CYBERSPACE..."
    record_clear 0x081C
}

proc clay1 {
    activation enabled until clay2
    branch_gameflag
    require record[0x1088] == 0x0D04
    require encounter_count[0x0500] == 0x0001
    guard_pop
    say 0x04CA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say 0x04CA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Another broken-down robot, Commander|... This planet's a gold mine..."
    say 0x04CA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Let's teleport it, Commander|. You never know when these things can come in handy..."
    say 0x04CA voice=0xFF flags=0x10 display=0x80 loop=clay2 control=none : "TELEPORT ROBOT TO ARK..." choices "teleport"
    guard_push clay2
    concept_guard "teleport" 0
    guard_pop
    say 0x04CA voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORTING ROBOT TO CRYOBOX"
    record[0x04E2] = aboard
    clear_alternate_concept
    record_clear 0x0504
}

proc clay2 {
    activation enabled until got
    branch_flag_274f
    actor 0x0504 0x0028 0
    guard_pop
    say 0x04CA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, this is one tough repair job..."
    say 0x04CA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear 0x0504
}

proc got {
    activation enabled until corpo1
    require record[0x02A2] != 0x0B1E
    guard_pop
    record[0x0692] = 0x0E36
}

proc corpo1 {
    activation enabled until t10
    branch_gameflag
    require state[0x13F0] == 0x0000
    require record[0x1088] == 0x0E18
    actor 0x06B4 0x0028 0
    guard_pop
    say 0x067A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Izwalito happy to see you back, friend|..."
    say 0x067A voice=0x00 flags=0x00 display=0x80 loop=none control=none : "You know bad news?"
    say 0x067A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Father of Yoko, Maxxon, be kidnapped..."
    say 0x067A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Kidnappers want big ransom, much CREDs..."
    say 0x067A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Me scared, friend. Me very worried. Me hide..."
    say 0x067A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You must help Yoko... friend Commander|..."
    say 0x067A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me think kidnapper be Croolis escaped from Mastachok jail..."
    say 0x067A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me hide... FEAR... FEAR..."
    say 0x067A voice=0x05 flags=0x08 display=0xA0 loop=none control=none : "Bye bye|..."
    record[0x0692] = 0x0FE6
    record_clear 0x06B4
}

proc t10 {
    activation enabled until krapp
    require encounter_count[0x08A8] == 0x0001
    guard_pop
    state_array_set 0x0A 0x00C8
    t10.enabled = false
}

proc krapp {
    activation enabled until krapp1
    state_array_test 0x0A
    guard_pop
    record_link 0x0624 0x0028 0
    krapp.enabled = false
}

proc krapp1 {
    activation enabled until kra
    branch_presentation
    actor 0x0624 0x0028 0
    guard_pop
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is Kran Dobu, Space Knight..."
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Radio message to Ark|... Ha! Ha! I bet my Kraner IV flies faster than your clunker..."
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha! Let's meet up at point X337 Y242..."
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I have a fix on his ship, Commander|..."
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Got the guts to race me?... Ha! Ha! Ha!|... I'm waiting..."
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I suggest we ignore him..."
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Chicken, huh?... Ha! Ha! Ha!"
    say 0x05EA voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Bye bye"
    krapp1.enabled = false
    bits(0x10F8,0x0002) = true using alternate_encoding
    record_clear 0x0624
}

proc kra {
    activation enabled until kra1
    branch_gameflag
    actor 0x0624 0x0028 0
    guard_pop
    say 0x05EA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha!"
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "What a heap of reject junk... You mean that thing actually flies? Ha! Ha! Ha!"
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You're not afraid..."
    say 0x05EA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Okay, no more kidding... Let's race... The first who gets to, uh... Let's see..."
    say 0x05EA voice=0x05 flags=0x00 display=0x80 loop=none control=none : "To planet Troma! Ha! Ha! Ha!"
    say 0x05EA voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You have the coordinates... Planet Troma is in the TROMUS constellation x432, Y654..."
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, he's gonna get trashed... There's no way he can match our suction turbos..."
    say 0x05EA voice=0x00 flags=0x00 display=0x80 loop=none control=none : "If you win, I'll give you my bionic guitar|... If I win, you'll give me something..."
    say 0x05EA voice=0x07 flags=0x00 display=0x80 loop=none control=none : "On your marks, guy..."
    say 0x05EA voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Ready"
    say 0x05EA voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Set"
    say 0x05EA voice=0x07 flags=0x08 display=0x90 loop=none control=none : "GO..."
    pair_record 0xBD 0x110E 0x000A 0x000A
    load_string "krando20.hnm"
    say 0x05EA voice=0x01 flags=0x08 display=0xB0 loop=none control=none : "See you round, comrade..."
    bits(0x10F8,0x0002) = false using alternate_encoding
    bits(0x0F70,0x0002) = true using alternate_encoding
    kra.enabled = false
    record_clear 0x0624
}

proc kra1 {
    activation enabled until kra1bis
    require record[0x1088] == 0x0F6E
    guard_pop
    state_array_set 0x0B 0x0064
    kra1.enabled = false
}

proc kra1bis {
    activation enabled until kra2
    state_array_test 0x0B
    guard_pop
    record_link 0x0624 0x0028 0
    kra2.enabled = true
    kra1bis.enabled = false
}

proc kra2 {
    activation disabled until kra3
    branch_presentation
    actor 0x0624 0x0028 0
    guard_pop
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Ti ti ti, ta ta ta, ti ti ti..."
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Ti ti ti, ta ta ta, ti ti ti..."
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander! It's an SOS, a distress call..."
    say 0x05EA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "S... O... S... THIS IS KRANER... IN TROUBLE... BIG BREAKDOWN..."
    say 0x05EA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "POSITION X765 Y234... BREAKDOWN... S... O... S..."
    bits(0x10F8,0x0002) = true
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, it sounds like a breakdown... We'd better help him..."
    say 0x05EA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "KRUIIIK..."
    load_string "krando20.hnm"
    say 0x05EA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x0624
}

proc kra3 {
    activation enabled until kra4
    branch_gameflag
    actor 0x0624 0x0028 0
    require state[0x13F2] == 0x0000
    guard_pop
    say 0x05EA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ha! Hi guy. I was wondering when you'd show up..."
    say 0x05EA voice=0x02 flags=0x00 display=0x80 loop=none control=none : "My engine's totalled... I must've pushed it too hard... It just went: ARG... PSHHHHHH!"
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Think you can fix it for me?"
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Teleport Morning Oil over to him|, Commander|. He's an ace repairman..."
    say 0x05EA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I'm waiting, guy..."
    say 0x05EA voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
    state[0x13F2] = 0x0001
    record_clear 0x0624
}

proc kra4 {
    activation enabled until morn1
    branch_gameflag
    actor 0x0624 0x0028 0
    guard_pop
    guard_push block_0ACF
    require state[0x13F2] == 0x0001
    require record[0x03C2] == 0x1096
    guard_pop
    say 0x05EA voice=0x01 flags=0x00 display=0x80 loop=none control=none : "I'm still waiting, old buddy. You're not gonna let me down now, huh?..."
    say 0x05EA voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander|, Morning Oil is an expert repairman..."
    record_clear 0x0624
    block_0ACF:
    guard_push block_0B84
    require record[0x03C2] == 0x0FE6
    require state[0x13F2] == 0x0001
    guard_pop
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Thanks, buddy. One heck of a robot you got here... He's taken the whole thing to bits... Ha! Ha! I love watching experts..."
    say 0x05EA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Uh... I hope he knows how to put everything back together... I mean, anyone can take things apart..."
    say 0x05EA voice=0x04 flags=0x08 display=0x80 loop=none control=none : "Hey|! It works! He got my engines working... I am dazed and amazed!!!"
    state[0x13F2] = 0x0002
    block_0B84:
    guard_push block_0C0E
    require record[0x03C2] == 0x0FE6
    require state[0x13F2] == 0x0002
    guard_pop
    say 0x05EA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Thanks guys... You are beautiful..."
    say 0x05EA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Here's my bionic guitar, as promised... You be careful with it..."
    say 0x05EA voice=0xFF flags=0x10 display=0x80 loop=block_0C0E control=none : "TELEPORT GUITAR TO ARK..." choices "teleport"
    guard_push block_0C0E
    concept_guard "teleport" 0
    guard_pop
    say 0x05EA voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORTING GUITAR TO CRYOBOX..."
    record_triple 0x0624 0x137E 0x0028 0
    state[0x13F2] = 0x0003
    clear_alternate_concept
    block_0C0E:
    guard_push block_0C47
    require record[0x03C2] == 0x0FE6
    require state[0x13F2] == 0x0003
    guard_pop
    say 0x05EA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Your robot is back on your ship... He has something for you..."
    record[0x03C2] = aboard
    block_0C47:
    say 0x05EA voice=0x04 flags=0x00 display=0x80 loop=none control=none : "See you round... Buddy..."
    say 0x05EA voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "..."
    bits(0x10F8,0x0002) = false
    pair_record 0xBD 0x110E 0x0064 0x000A
    record_clear 0x0624
}

proc morn1 {
    activation enabled until morn2
    branch_gameflag
    require record[0x03C2] == 0x1096
    require state[0x13F4] == 0x0000
    actor 0x03E4 0x0028 0
    guard_pop
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I reprogrammed him|, Commander|. He's operational..."
    say 0x03AA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Hello, Commander|..."
    say 0x03AA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I await your instructions..."
    guard_push block_0D69
    require state[0x13F2] == 0x0001
    require record[0x1088] == 0x10F6
    guard_pop
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Teleport him over to the KRANER, Commander|. He'll soon fix Mister Kran Dobu's breakdown..."
    say 0x03AA voice=0xFF flags=0x10 display=0x80 loop=block_0D69 control=none : "TELEPORT MORNING OIL TO KRANER..." choices "teleport" "refuse"
    guard_push block_0D42
    concept_guard "teleport" 0
    guard_pop
    say 0x03AA voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORTING MORNING OIL TO KRANER..."
    record[0x03C2] = 0x0FE6
    clear_alternate_concept
    record_clear 0x03E4
    block_0D42:
    guard_push block_0D69
    concept_guard "refuse" 0
    guard_pop
    say 0x03AA voice=0xFF flags=0x28 display=0x90 loop=none control=none : "OK, Commander|. Your wish is my command..."
    clear_alternate_concept
    record_clear 0x03E4
    block_0D69:
    say 0x03AA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x03E4
}

proc morn2 {
    activation enabled until bronk1
    branch_flag_274f
    actor 0x03E4 0x0028 0
    guard_pop
    guard_push block_0E31
    require state[0x13F2] == 0x0003
    require state[0x13F4] == 0x0000
    guard_pop
    say 0x03AA voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Commander|, I have repaired Mister Kran Dobu's vessel..."
    say 0x03AA voice=0x04 flags=0x08 display=0x90 loop=none control=none : "He gave me two trasmitter receiver KEY RINGS. They're in the cryobox|..."
    record[0x025A] = aboard
    record[0x13AA] = aboard
    say 0x03AA voice=0xFF flags=0x20 display=0x80 loop=none control=none : "How about that... Very weird key rings, believe me... What in the name of Pete are they for?..."
    say 0x03AA voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Happy now, Commander|?..."
    state[0x13F4] = 0x0001
    record_clear 0x03E4
    block_0E31:
    say 0x03AA voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I hear and obey, Commander|..."
    say 0x03AA voice=0xFF flags=0x22 display=0x80 loop=none control=none : "Don't you love the way I programmed him... Total docility is his watchword..."
    say 0x03AA voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear 0x03E4
}

proc bronk1 {
    activation enabled until bronk2
    branch_flag_274f
    require record[0x13AA] != 0x043A
    require state[0x13F6] == 0x0000
    require record[0x1088] != 0x0A7C
    actor 0x0474 0x0028 0
    guard_pop
    say 0x043A voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Commander|, I'm getting rusty..."
    guard_push block_0F2D
    require encounter_count[0x0548] == 0x0000
    require encounter_count[0x0470] < 0x0002
    guard_pop
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, Mister Bronko spoke to me of a musician friend of his who lives at the airport on planet Moskito..."
    say 0x043A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "True, Commander|. A very fine musician..."
    say 0x043A voice=0x04 flags=0x08 display=0x80 loop=none control=none : "If you have the time, you should check him out..."
    bits(0x103C,0x0002) = true
    block_0F2D:
    guard_push block_1058
    require encounter_count[0x0470] == 0x0001
    guard_pop
    say 0x043A voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Honk taught me your language. He's so patient... Thanks HONK!"
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "My pleasure, Mister Bronko. You're a talented student..."
    say 0x043A voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You're just saying that, Mister Honk..."
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No, you have great gifts... Truly..."
    say 0x043A voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You're making me blush now... And butchers don't blush easily, you know! Ha! Ha! Ha!"
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ha! Ha! Ha! What a fine wit you have, Mister Bronko! Ha! Ha! Ha!"
    say 0x043A voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This is one fine robot, Commander|..."
    say 0x043A voice=0x06 flags=0x00 display=0x80 loop=none control=none : "As I was saying, Commander|, nothing would please me more than to serve you..."
    say 0x043A voice=0x07 flags=0x00 display=0x80 loop=none control=none : "I could undertake a mission, maybe..."
    block_1058:
    guard_push block_10D2
    require encounter_count[0x0470] > 0x0001
    require encounter_count[0x0590] == 0x0000
    guard_pop
