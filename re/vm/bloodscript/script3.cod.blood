    guard_push block_3B6F
    concept_guard "no" 0
    guard_pop
    say 0x0872 voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Say! You're blushing... Is he a shy little man? Ha|! Ha|! Hee|! Hee|!"
    clear_alternate_concept
    block_3B6F:
    say 0x0872 voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You know I'm a star, right? On the planet Eden, all the males are crazy about me..."
    say 0x0872 voice=0x08 flags=0x00 display=0x80 loop=none control=none : "I sing every night here at the PURPLE HAZE. The universe's hottest nite spot..."
    say 0x0872 voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Why don't you just tell me all about yourself... Honeypoo..."
    say 0x0872 voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, you're gonna have to cool down... Commander!"
    say 0x0872 voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Going so soon? Ohhh! Come back real soon... My little heart just races when you're near..." choices "bye_bye"
    say 0x0872 voice=0x04 flags=0x08 display=0x90 loop=none control=none : "Bye bye..."
