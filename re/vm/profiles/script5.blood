    proc masta5 enabled {
        during travel
        require globals.D1 == 0
        require presentation == Eviscerator
        require arche.current_location == Mastachok
    } then {
        say Eviscerator presentation=crl06.hnm : "Me know you|... You give me mummy|... and CURSE|..."
        say Eviscerator presentation=crl05.hnm : "ME HATE YOU|..."
        say Eviscerator presentation=crl08.hnm if_not_shown skip_next=1 : "WHAT YOU WANT STRANGER|?"
        Eviscerator.topic = "talk"
        when {
            require globals.secret == 1
        } then {
            say Eviscerator presentation=crl07.hnm if_not_shown skip_next=2 : "You like secrets|... Me tell secrets"
            Eviscerator.topic = "secrets"
            globals.secret = 0
        }
        when {
            require globals.secret1 == 1
        } then {
            say Eviscerator presentation=crl11.hnm : "SPLATCH be highly concentrated explosive|. SPLATCH blow up jail|... LAUGH|... FOUL SWEAR"
            say Eviscerator presentation=crl09.hnm : "You bring me SPLATCH|, friend|... And me give you|..."
            say Eviscerator presentation=text_only chatter : "He's gonna offer us the treasure again|, Commander|... Ol' Turkey-face Bob'll love this|..."
            say Eviscerator presentation=crl06.hnm : "You go see friends at \"Galaxian Bar\" on planet MASTAGLUK|... Them help you|..."
            dictionary blank after "Them"
            say Eviscerator presentation=text_only chatter : "No... No|... That's enough, Commander|... This is not a never ending story|..."
            say Eviscerator presentation=crl10.hnm if_not_shown skip_next=3 : "You understand|? Bye bye|... ME WAIT YOU|..."
            globals.secret1 = 0
            globals.D1 = 1
            end presentation Eviscerator
        }
        when {
            require globals.vbio == 0
        } then {
            say Eviscerator presentation=text_only chatter : "Commander|, if I'd had some BIONIUM|, I could have helped you|...."
        }
        when {
            require globals.vbio > 3
        } then {
            say Eviscerator presentation=text_only chatter if_not_shown skip_next=1 : "Commander|, there's no percentage staying here|..."
            globals.vbio -= 3
        }
        say Eviscerator presentation=crl07.hnm if_not_shown skip_next=1 : "Bye bye|. You come back see me|. Me like visits|..." choices "bye_bye"
        end presentation Eviscerator
    }
    global D1 = 0
    global secret = 0
    global secret1 = 0
