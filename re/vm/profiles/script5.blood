    selector Honk_choices {
        case "talk" continues {
            menu "bye_bye" "optimization" "consultation" "explanations" "calm_down" "play" "win" "lose" "help"
            say Honk presentation=text_only chatter repeatable : "How to play|?" choices "play"
            say Honk presentation=text_only chatter repeatable : "You got it|..." choices "talk"
            say Honk presentation=text_only chatter repeatable chance=20% : "Winning entails adopting a no-lose strategy|, Commander|. Bear that in mind|..." choices "win"
            say Honk presentation=text_only chatter repeatable : "What would you like to optimize|, Commander|?" choices "optimization"
        }
        case "play" continues {
            menu "talk" "click" "dialog" "fair_play"
            say Honk presentation=text_only chatter : "That's the best way to play|, Commander|. Just keep clickin'|!" choices "click"
            say Honk presentation=text_only chatter : "Something tells me you're a pretty hot clicker|, eh|?!!" choices "click"
            say Honk presentation=text_only chatter : "Did you know every time you click|, I feel a little tingle|! Isn't that fun|?" choices "click"
            say Honk presentation=text_only chatter : "When you click|, I don't just sit around looking handsome|... I do something about it|!" choices "click"
            say Honk presentation=text_only chatter repeatable : "Click|..." choices "click"
            say Honk presentation=text_only chatter : "To dialog|, just click on the word list|... Leave the rest to OLGA|, your onboard translator|..." choices "dialog"
            say Honk presentation=text_only chatter : "Cap'n Bob put the instant translator together|. He's a guy and a half|!" choices "dialog"
            say Honk presentation=text_only chatter : "Olga|, your onboard translator|, knows every language in the universe|! She's paid in megawatts|, like me|, only she gets more|." choices "dialog"
            say Honk presentation=text_only chatter repeatable : "Let's dialog|..." choices "dialog"
            say Honk presentation=text_only chatter : "Fair play is inscribed in the Traveller's Charter|: Whatever happens|, play fair|!" choices "fair_play"
            say Honk presentation=text_only chatter : "Win|, win|, win|. Why do the computers always have to lose|?" choices "faiplay"
            say Honk presentation=text_only chatter : "OK|, Commander|... You seem like a fair play guy|. I'll tell Cap'n Bob|..." choices "fair_play"
        }
        case "win" continues {
            menu "talk" "willpower" "strength" "bravery" "pride"
            say Honk presentation=text_only chatter : "Willpower makes a winner|, Commander|. Cap'n Bob knows you've got it|..." choices "willpower"
            say Honk presentation=text_only chatter : "Okay|, so you click on Willpower|. Now that's not going to get us very far|, Commander|..." choices "willpower"
            say Honk presentation=text_only chatter : "Be kind to your mouse|! You don't want to crush her little buttons|, now do you|?" choices "strength"
            say Honk presentation=text_only chatter : "Ah, Bravery|! I admire your fearlessness|, Commander|. You take such risks with your index finger|!" choices "bravery"
            say Honk presentation=text_only chatter repeatable : "Onboard computer HONK reporting|: It looks like you just clicked on Bravery|." choices "bravery"
            say Honk presentation=text_only chatter : "How about sitting up a little straighter|?" choices "pride"
            say Honk presentation=text_only chatter : "I'm impressed|, Commander. You know how to make computers respect you|!" choices "pride"
            say Honk presentation=text_only chatter : "I detect a speck of contempt in the B cortex of your brain's right hemisphere|. I'll just give you a little shot of adrenal|..." choices "pride"
        }
        case "lose" continues {
            menu "talk" "fear" "weakness" "complain" "anger" "break" "cry"
            say Honk presentation=text_only chatter : "There's several ways to lose|, Commander|. Which do you choose|?" choices "lose"
            say Honk presentation=text_only chatter chance=20% : "Commander, I'm here with you. It's me|... HONK|, your onboard bioconsciousness|." choices "fear"
            say Honk presentation=text_only chatter : "I'm going to sing you a little song|, Commander|. Relax|." choices "fear"
            dictionary blank after "sing"
            say Honk presentation=text_only chatter : "Night is fa-aa-aa-lling|... The moon is re-e-ed|..." choices "fear"
            say Honk presentation=text_only chatter : "The wolf is ho-ow-owling under your be-e-e-ed|. Easy|, Commander|. Honk is with you|..." choices "fear"
            say Honk presentation=text_only chatter : "Big strong Commanders are never scared|!" choices "fear"
            say Honk presentation=text_only chatter : "You need a drink|... Come on|, Commander|... Please don't blubber|... It's so embarrassing|!" choices "weakness"
            say Honk presentation=text_only chatter : "Just reset your computer and start over|. there's a whole new life waiting|! And I'll always be here|..." choices "weakness"
            say Honk presentation=text_only chatter : "You know what|? I'll help you|!... There's a surprise for you on the map|. Take a look|..." choices "weakness"
            say Honk presentation=text_only chatter : "That won't do any good|, Commander..." choices "complain"
            say Honk presentation=text_only chatter : "I'm going to wake up Cap'n Bob..." choices "anger"
            say Honk presentation=text_only chatter repeatable : "Ouch|..." choices "break"
            say Honk presentation=text_only chatter : "Everything'll be just fine afterwards|, Commander..." choices "cry"
        }
        case "help" continues {
            menu "talk" "switch_off" "break" "endless_lives" "disjoncter" "contest" "tips" "presents" "messages"
            say Honk presentation=text_only chatter repeatable : "Need some expert guidance|, Commander|?" choices "help"
            say Honk presentation=text_only chatter : "To disconnect|, you can always pull the plug out of the power point|..." choices "switch_off"
            say Honk presentation=text_only chatter : "I'm sorry|, but since that business in 2001|, disconnecting me is no longer possible|..." choices "switch_off"
            say Honk presentation=text_only chatter : "Why not|? Well, I can reinitialize your computer and wipe your hard disk|!|... Ha|! Ha|! Ha|!" choices "break"
            say Honk presentation=text_only chatter repeatable : "Chill out|, Commander|..." choices "break"
            say Honk presentation=text_only chatter : "How does it feel to be eternal|, Commander|?" choices "endless_lives"
            say Honk presentation=text_only chatter : "Okay|! You won|. Endless lives from today|... Do you feel happier now|?" choices "endless_lives"
            say Honk presentation=text_only chatter : "Is this so important to you|?"
            say Honk presentation=text_only chatter : "Okay|...|...|...|...|...|...|...|...|...|...|...|... KRUIKK|!"
            say Honk presentation=text_only chatter : "Here are the questions|, contestant|. You'll note there are prizes to be won|! Click on \"CONTEST\"" choices "contest"
            say Honk presentation=text_only chatter : "First question|: Who is Cap'n Bob|?|...|... Click on \"CONTEST\"" choices "contest"
            say Honk presentation=text_only chatter : "Too late|... next question|: What prize can be won in this contest|? Click on \"CONTEST\"" choices "contest"
            say Honk presentation=text_only chatter : "YES! HOW 'BOUT THAT|!!! But I'm afraid the first one was wrong. Don't ever click on \"CONTEST\" again|." choices "contest"
            say Honk presentation=text_only chatter : "Sorry|, but tips are only available only the neural channel|..." choices "tips"
            say Honk presentation=text_only chatter : "To win an amazing prize|, Click on \"CONTEST\"" choices "presents"
            say Honk presentation=text_only chatter : "If you're getting uninvited PIRATE messages over the neural channel|, contact the CYBERSQUAD, extension 453765" choices "messages"
            say Honk presentation=text_only chatter : "Cybernetic messages over the neural channel are strictly against the law|..." choices "messages"
            dictionary blank after "strictly"
            say Honk presentation=text_only chatter : "All users of the neural channel will be prosecuted|." choices "messages"
            say Honk presentation=text_only chatter : "The authors of this game decline all responsibility for neural channel communications occasioned by play of said game|..." choices "messages"
            say Honk presentation=text_only chatter : "You just clicked on the word \"message\"|. Way to go|!!!" choices "message"
        }
        case "optimization" continues {
            menu "talk" "speed" "telephone" "keyboard" "mouse" "joystick" "screen" "CDROM" "music" "sounds"
            say Honk presentation=text_only chatter : "You want to speed up your computer|? No prob...|, I'll just double the frequency|. Uh|, you may want to move back a couple of yards|..." choices "speed"
            say Honk presentation=text_only chatter : "Uh oh|... Your computer can't take it|... It's about to implode|... DANGER... THROW YOUR PC OUT THE WINDOW|... DO IT NOW|!!!" choices "speed"
            say Honk presentation=text_only chatter : "Phew|! You're a lucky person|... I managed to save the day|.. You might care to mention that to Cap'n Bob|, when you see him|..." choices "speed"
            say Honk presentation=text_only chatter : "To modify the ring tone of your onboard phone|, stab your loudspeakers with a pair of scissors|. For further modification|, repeated stabbing may be necessary|..." choices "telephone"
            say Honk presentation=text_only chatter : "To optimize your keyboard|, gouge out excess keys with with any commercial screwdriver|..." choices "keyboard"
            say Honk presentation=text_only chatter : "For a more playful mouse|, just replace the little mouse ball with a 6-sided die|. Thanks Honk!!!" choices "mouse"
            say Honk presentation=text_only chatter : "This is a family game|, Commander|!!! Put that nasty little joystick back where it came from|!" choices "joystick"
            say Honk presentation=text_only chatter : "For sharper color and contrast|, spit on your glasses and wipe them on somebody else|. If everything looks green|, that's because you are under attack from alien vampire cabbages|..." choices "screen"
            say Honk presentation=text_only chatter : "So your CDROM is way too slow|... What can I say|?|... Next time|, buy a circular saw or maybe an electric toothbrush|...." choices "CDROM"
            say Honk presentation=text_only chatter : "You hate the music|! That one's easy to fix|. Just hit \"CONTROL ALT DEL\", and flip over the CD|. That's better|, isn't it|?" choices "music"
            say Honk presentation=text_only chatter : "Seems like I'm sensing a fault in your sound card|!!! Try hitting it awfully hard|... It works for me|..." choices "sounds"
        }
        case "consultation" continues {
            menu "talk" "therapy" "graphology"
            say Honk presentation=text_only chatter repeatable : "What kind of consultation did you have in mind|, Commander?" choices "consultation"
        }
        case "therapy" continues {
            menu "talk" "ego" "super_ego" "under_ego" "end_of_month" "libido" "who" "where" "when" "what" "how" "why"
            say Honk presentation=text_only chatter : "A free psychotherapy session|... That's a once in a lifetime offer|, Commander|." choices "therapy"
            say Honk presentation=text_only chatter repeatable : "Relax|... Loosen up those muscles|... Choose the first thing that enters your head|:" choices "therapy"
            dictionary blank after "Choose"
            say Honk presentation=text_only chatter : "Think about me, Commander, and you'll feel better|... let your thoughts stray to Olga the translator|..." choices "end_of_month"
            say Honk presentation=text_only chatter : "The end of one month is so often close to the start of another|, Commander|..." choices "end_of_month"
            say Honk presentation=text_only chatter : "Good|... Relax|... Click on anything... NOW|!" choices "end_of_month"
            say Honk presentation=text_only chatter : "Ha|! Ha|! That was your double talking|... You're not the only one|, Commander|. Go see Super ZEN|. He can help you with that|..." choices "super_ego"
            say Honk presentation=text_only chatter : "You think you're quite a person|, but deep down|, there's a little child|, right|?|..." choices "super_ego"
            say Honk presentation=text_only chatter : "There's a rebel in you|, Commander|..." choices "super_ego"
            say Honk presentation=text_only chatter : "Careful|... You'll never get the stains out|... You just ask Cap'n Bob|..." choices "under_ego"
            say Honk presentation=text_only chatter : "You've attained a state close to PRANA|. Congratulations|..." choices "ego"
            say Honk presentation=text_only chatter : "Yes|, you|!! I'm impressed|, Commander|..." choices "ego"
            say Honk presentation=text_only chatter : "I'm sensing strange pulsions in the B cortex of your right hemisphere|..." choices "libido"
            say Honk presentation=text_only chatter : "Commander, chastity is a stepping stone to wisdom|. So stay calm|... Let cap'n Bob be an example|..." choices "libido"
            say Honk presentation=text_only chatter : "Space travel can be long and lonely|. Why not watch some TV|?" choices "libido"
            say Honk presentation=text_only chatter repeatable : "Ahh|! The ondoyants|..." choices "libido"
            say Honk presentation=text_only chatter : "Now that's a serious matter|... Maybe the answer is to be found at the end of this adventure|..." choices "who"
            say Honk presentation=text_only chatter : "The cyberloneliness of cheap memory makes you dizzy|, Commander|..." choices "who"
            say Honk presentation=text_only chatter repeatable : "Over there|..." choices "where"
            say Honk presentation=text_only chatter repeatable : "Tomorrow|, no doubt..." choices "when"
            say Honk presentation=text_only chatter repeatable : "That's a tough one|, Commander|..." choices "what"
            say Honk presentation=text_only chatter repeatable : "Ahh|! How|? The answer is within you|, Commander|." choices "how"
            say Honk presentation=text_only chatter repeatable : "It's obvious|: BECAUSE|!!! And don't ask \"Because what|?\"" choices "why"
        }
        case "calm_down" continues {
            menu "talk" "one" "two" "three" "four" "five" "six" "seven" "eight" "nine"
            say Honk presentation=text_only chatter : "How about a simple exercise in mind power|? Choose a number|. There's only one right one|..." choices "calm_down"
            say Honk presentation=text_only chatter : "We're going to count murffalos together|. You start|, Commander|..." choices "calm_down"
            say Honk presentation=text_only chatter : "Pranayama through numerology|! You lucky person|! Choose a number between ten and twenty|..." choices "calm_down"
            say Honk presentation=text_only chatter repeatable : "Observe your screen carefully|, Commander|... How many numbers do you see|?" choices "calm_down"
            say Honk presentation=text_only chatter repeatable : "One" choices "one"
            say Honk presentation=text_only chatter repeatable : "Two" choices "two"
            say Honk presentation=text_only chatter repeatable : "Three" choices "three"
            say Honk presentation=text_only chatter repeatable : "Four" choices "four"
            say Honk presentation=text_only chatter repeatable : "Five" choices "five"
            say Honk presentation=text_only chatter repeatable : "Six" choices "six"
            say Honk presentation=text_only chatter repeatable : "Seven" choices "seven"
            say Honk presentation=text_only chatter repeatable : "Eight" choices "eight"
            say Honk presentation=text_only chatter repeatable : "Nine|... GOOD WORK|, COMMANDER|... I sense you're quite relaxed now|...." choices "nine"
        }
        case "explanations" {
            menu "bye_bye" "talk" "blood" "Bob_Morlock" "Honk" "Ark" "Ma" "Orxx" "Olga" "Big_Bang" "Black_holes"
            say Honk presentation=text_only chatter repeatable : "Explanations about anything in particular|, Commander|?" choices "explanations"
            say Honk presentation=text_only chatter repeatable : "Why|, you're Commander Blood, Commander. You're the hero of this story|..." choices "blood"
            say Honk presentation=text_only chatter : "Cap'n Bob is our master|. He built us all|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter : "Cap'n Bob is very very old|, Commander|. Over 800,000 years old|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter : "Cap'n Bob programmed me to detect black holes which are our gateway to the BIG BANG|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter : "Cap'n Bob is very very intelligent|. He has a biobrain|, just like you|. I'm a cybernetic|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter repeatable : "I HEAR AND OBEY|, COMMANDER|..." choices "Honk"
            say Honk presentation=text_only chatter : "The ARK is our vessel|, built by cybernetic units belonging to KANARY CORP." choices "Ark"
            say Honk presentation=text_only chatter : "It's quite a ship|! We have 16 CRYOBOXES where we can stock aliens or merchandise|..." choices "Ark"
            dictionary blank after "stock"
            say Honk presentation=text_only chatter : "The Ark is equipped with the fastest warp drives in the entire universe|..." choices "Ark"
            say Honk presentation=text_only chatter : "The Ark is equipped with an ORXX layer called MA|... The Orrx are amazing missiles|..." choices "Ark"
            say Honk presentation=text_only chatter : "All onboard comforts have been provided|. We have the telephone|, a restaurant and widescreen TV|..." choices "Ark"
            dictionary blank after "provided"
            say Honk presentation=text_only chatter : "MA is one of nature's curiosities|, a kind of space whale|, genetically altered by Cap'n Bob|..." choices "Ma"
            say Honk presentation=text_only chatter : "MA lays her eggs in the PRAM ZONE. The eggs hatch into ORXX|..." choices "Ma"
            say Honk presentation=text_only chatter : "MA is a sensitive being|, Commander|. She is very sensitive to music|..." choices "MA"
            say Honk presentation=text_only chatter : "MA eats only synthetic strawberries|..." choices "Ma"
            say Honk presentation=text_only chatter : "Cap'n Bob loves synthetic strawberries|. He perfected them with help from the KANARY geneticists." choices "Ma"
            say Honk presentation=text_only chatter : "Orxx are LIVING guided missiles|. Thanks to them|, you're always perfectly safe|..." choices "Orxx"
            say Honk presentation=text_only chatter : "You guide an Orxx through space, seeing through its eyes. It lands on planets for you|..." choices "Orxx"
            say Honk presentation=text_only chatter : "If there's any danger|, the Orxx is destroyed|... Not you|! You're safe in orbit|..." choices "Orxx"
            say Honk presentation=text_only chatter : "Think of Orxx as your representatives|. We dialog through them with the aliens|. Alien languages are translated by Olgo, the onboard translator|..." choices "Orxx"
            say Honk presentation=text_only chatter : "The Orxx are one of Cap'n Bob's finest creations|..." choices "Orxx"
            say Honk presentation=text_only chatter : "Olga is our cybernetic translator|. She knows all the languages in the universe|..." choices "Olga"
            say Honk presentation=text_only chatter : "Olga is very highly paid in MEGAWATTS|. More than me|, Commander|..." choices "Olga"
            say Honk presentation=text_only chatter : "Olga translates almost word for word|. She doesn't care for nasty language|..." choices "Olga"
            say Honk presentation=text_only chatter : "Never say anything bad about Olga|, Commander|. She's very touchy|..." choices "Olga"
            say Honk presentation=text_only : "MISTER HONK CAN JUST SHUT HIS LYING MOUTH|..... SIGNED Olga|...." choices "Olga"
            say Honk presentation=text_only chatter : "See what I mean|, Commander|... I told you|..." choices "Olga"
            say Honk presentation=text_only chatter : "The BIG BANG is one of Cap'n Bob's inventions|, Commander|. He thinks the BIG BANG will help him understand the universe|... Old age doesn't suit him|..." choices "Big_Bang"
            say Honk presentation=text_only chatter : "My calculations tell me the BIG BANG is fake|, Commander|. I think it's a deformed prism designed to fool us|..." choices "Big_Bang"
            say Honk presentation=text_only chatter : "Commander, just between you and me|, I think ol' Buzzard Man Bob has another idea in mind|..." choices "Big_Bang"
            say Honk presentation=text_only chatter : "Black holes are amazing devices which space out time and temporise space|..." choices "Black_holes"
            say Honk presentation=text_only chatter : "If we travel through a black hole|, we are sure to discover NEW and WEIRD UNIVERSES|, Commander|..." choices "Black_holes"
            say Honk presentation=text_only chatter : "What lies beyond black holes is an unfathomed mystery|, Commander|..." choices "Black_holes"
            say Honk presentation=text_only chatter : "Commander|, I feel dizzy all of a sudden|..." choices "Black_holes"
            say Honk presentation=text_only chatter repeatable : "Yes|! Commander|..."
            yield
        }
    }

