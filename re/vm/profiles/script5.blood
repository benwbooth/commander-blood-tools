            say Maxxon presentation=text_only chatter resume_at=max1_dialogue_resume_1 : "Why don't we teleport them|, Commander..." choices "teleport" "refuse"
            when {
                require choice == "teleport"
            } then {
                say Maxxon presentation=text_only if_not_shown skip_next=3 : "TELEPORT YOKO AND MAXXON TO RONDO"
                Maxxon.current_location = observatory
                Yoko.current_location = Rondo
                choice = none
            }
            when {
                require choice == "refuse"
            } then {
                say Maxxon presentation=text_only chatter if_not_shown skip_next=2 : "You're the commander|, Commander..."
                choice = none
                end presentation Maxxon
            }
        }
        max1_dialogue_resume_1:
        when {
            require arche.current_location != Rondo
            require globals.vbio > 3
        } then {
            say Maxxon presentation=text_only chatter if_not_shown skip_next=1 : "We'll need to get closer to RONDO to teleport them|..."
            globals.vbio -= 3
        }
        say Maxxon presentation=maxb_tr.hnm if_not_shown skip_next=1 : "We're waiting|, Commander|..."
        end presentation Maxxon
    }
