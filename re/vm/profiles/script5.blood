            say Eviscerator presentation=crl07.hnm : "Friend|, yuk|. Ha|! Ha|! Ahhhh|... You not laugh|?" choices "friend"
            say Eviscerator presentation=crl06.hnm repeatable : "Friend|! Ha! Ha! Ha|!!!" choices "friend"
            say Eviscerator presentation=crl03.hnm : "Me like art of war|. Nice nice|. Splat all time|..." choices "art"
            say Eviscerator presentation=crl12.hnm : "Art|, art|. You be sissy|... Art|... SWEAR SWEAR" choices "art"
        }
        case "war" continues {
            menu "bye_bye" "talk" "battle" "enemy" "treasure"
            say Eviscerator presentation=crl12.hnm : "Ah|. War nice discipline|... Splat|, kill all|... Me like|..." choices "war"
            say Eviscerator presentation=crl13.hnm : "Ahhh|, big fun|. Explode|, burn|, kill kill|. Ahhhh|..." choices "war"
            say Eviscerator presentation=crl03.hnm : "Much noise|, explosions|, screams|. Music to Croolis ear|..." choices "war"
            say Eviscerator presentation=crl11.hnm : "You talk good|. Me like hear you|... SWEAR|..." choices "war"
            say Eviscerator presentation=crl13.hnm : "Ahhh|, war nice discipline|. Splat much enemy" choices "war"
            say Eviscerator presentation=crl03.hnm : "War nice party|: break|, shoot|, kill, squash" choices "war"
            say Eviscerator presentation=crl12.hnm : "Noise|, explosion, pain, fear, kill all|. Aaah|, me like|... INSULT" choices "war"
            say Eviscerator presentation=crl11.hnm : "Me want splat you|. Laugh laugh swear|. INSULT|..." choices "war"
            say Eviscerator presentation=crl10.hnm : "You excite me|. Mouth water now|. Aaahrgghhhhh|..." choices "war"
            say Eviscerator presentation=crl10.hnm : "Me big warrior|, friend|. Me big Croolis chief|... You help me|..." choices "battle"
            say Eviscerator presentation=crl12.hnm : "Me like squash your head|... LAUGH LAUGH|... INSULT|... SWEAR|..." choices "battle"
            say Eviscerator presentation=crl10.hnm repeatable : "Me destroy and splat enemy|... Me like enemy|, friend|..." choices "enemy"
            say Eviscerator presentation=crl09.hnm : "You talk treasure|... treasure is in the mummy" choices "treasure"
            say Eviscerator presentation=crl06.hnm if_not_shown skip_next=1 : "Mummy alone know treasure exist|..." choices "treasure"
            globals.secret = 1
            say Eviscerator presentation=crl10.hnm repeatable : "Me want escape|. You help me|..." choices "prison"
        }
        case "secrets" {
            menu "bye_bye" "talk" "secret"
            say Eviscerator presentation=crl05.hnm : "Me trust|..." choices "secrets"
            say Eviscerator presentation=crl06.hnm : "Treasure|! You know treasure|???" choices "secret"
            say Eviscerator presentation=crl07.hnm if_not_shown skip_next=1 : "Me tell you where treasure be if you bring me SPLATCH" choices "secret"
            globals.secret1 = 1
            yield
        }
    }

    selector Yoko_choices {
        case "hello" continues {
            menu "bye_bye" "talk" "say_nothing"
