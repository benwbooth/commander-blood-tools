    proc bronk1 enabled {
        during contact
        require globals.F1 == 0
        require presentation == Bronko
    } then {
        say Bronko presentation=rgbtr3.hnm : "Everything's okay|, Commander|..."
        say Bronko presentation=rgbtr4.hnm : "Don't hesitate if you need me|..."
        when {
            require Bigbang.known
        } then {
            say Bronko presentation=rgbtr6.hnm : "Teleport me to the BIG BANG|, Commander|... I want to party|! Gee|, I love weddings|..."
            say Bronko presentation=text_only chatter : "Oh|! You're not going to leave me here alone|, are you|, Mister Bronko|? I'm a sucker for weddings too|..."
            say Bronko presentation=text_only chatter : "I'll feel so loneley if you go|..."
            say Bronko presentation=rgbtr7.hnm : "Well|, I sure don't want to to make you unhappy|, Mister Honk|... That'll make me unhappy|..."
            say Bronko presentation=rgbtr8.hnm : "You're such an understanding being|..."
            say Bronko presentation=text_only chatter : "Oh|! And you|, Mister Bronko, you have so much to offer|... Your cooking is out of this world|..."
            say Bronko presentation=text_only chatter : "IF YOU GO|... I'M COMING WITH YOU|..."
            say Bronko presentation=text_only if_not_shown skip_next=1 : "What's going on now|? HONK|! Your sentimentality makes me sick|!!!"
            request sequence "bobb.hnm"
            say Bronko presentation=text_only chatter : "Boo|! Hoo|! Sniff|... I'm unhappy|... Mister Bronko wants to party at the BIG BANG|..."
            say Bronko presentation=text_only if_not_shown skip_next=1 : "Honk|! Can it|... I think I'm going to switch you off|!!!"
            request sequence "bobb.hnm"
            say Bronko presentation=text_only chatter : "NO|! No|! Please don't do that|, Cap'n Bob|..."
            say Bronko presentation=rgbtr5.hnm : "Okay okay|... I'll stay here|... I don't really like to party anyhow|..."
            say Bronko presentation=text_only chatter : "Oh|, Mister Bronko|... Such a lesson in bigheartedness|... CRY|... WEEP|..."
            say Bronko presentation=text_only if_not_shown skip_next=1 : "Commander|... Your computer's losing it|... Something needs to be done|!!!"
            request sequence "bobb.hnm"
            say Bronko presentation=rgbtr7.hnm if_not_shown skip_next=1 : "Well|, if you'll excuse me|... I've got a murffalo in the oven|..."
            end presentation Bronko
        }
        say Bronko presentation=rgbtr6.hnm chatter : "Oh Mister Bronko|... You're looking well, I must say|!!!."
        say Bronko presentation=rgbtr6.hnm : "See you soon|, Commander|..."
        say Bronko presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Bronko
    }
