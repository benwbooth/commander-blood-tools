            require splatch.holder != Eviscerator
        } then {
            say Eviscerator presentation=crl11.hnm : "INSULT|... UGLY SWEAR|... GNASH|... GNASH|... UGLY LAUGH|..."
            say Eviscerator presentation=crl13.hnm : "ME HATE YOU|... INSULT|...."
            say Eviscerator presentation=crl12.hnm if_not_shown skip_next=1 : "ME NOT SAY BYE BYE|..."
