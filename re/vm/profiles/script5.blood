logic {
    proc init5 enabled {
    } then {
        Moskito.known = true
        airport.known = true
        Corpo.known = true
        Venusia.known = true
        Magnus.known = true
        Rondo.known = true
        Eden.known = true
        Ekatomb.known = true
        Erazor.known = true
        Kortex.known = true
        Mastachok.known = true
        Pterra.known = true
        Kult.known = true
        Vulcan.known = true
        Troma.known = true
        Emasculator.active = true
        Migrator.active = true
        Emasculator.current_location = usine
        Bob_Morlock.current_location = aboard
        Bronko.current_location = aboard
        Anna_Haf.current_location = aboard
        Beauregard.current_location = aboard
        Migrator.current_location = Trashlando
        ondoyant.current_location = aboard
        Hom.current_location = aboard
        globals.Sinox = globals.sur
        Amigo.current_location = bar
        ondoyant.current_location = aboard
        receiver.current_location = aboard
        Yoko.current_location = aboard
        Maxxon.current_location = aboard
        Izwalito.current_location = Corpo
        Otto_Von_Smile.current_location = Trashlando
        globals.compris = 1
        globals.vbio = 3
        sequence_slots[1] = "match"
        sequence_slots[2] = "ppit"
        sequence_slots[3] = "hatetv"
        sequence_slots[4] = "venus"
        sequence_slots[5] = "scrut"
        sequence_slots[6] = "present"
        init5.enabled = false
    }
    global Sinox = 0
    global sur = 0
    global compris = 0
    global vbio = 0
    proc Beau enabled {
        during contact
        require presentation == Beauregard
    } then {
        say Beauregard presentation=bor_b_tr.hnm : "Let me sleep|... Commander..."
        say Beauregard presentation=bor_a_tr.hnm if_not_shown skip_next=1 : "..."
        end presentation Beauregard
    }
    proc cla enabled {
        during contact
        require presentation == Anna_Haf
    } then {
        say Anna_Haf presentation=cltr10_3.hnm : "Let me sleep|... Commander..."
        say Anna_Haf presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Anna_Haf
    }
    proc recept enabled {
        during contact
        require presentation == receiver
    } then {
        say receiver presentation=text_only : "Shhhhhh|... Shhhhh..."
        say receiver presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation receiver
    }
    proc morn disabled {
        during contact
        require presentation == Morning_Oil
    } then {
        say Morning_Oil presentation=morn02.hnm : "Let me sleep|... Commander..."
        say Morning_Oil presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Morning_Oil
    }
    proc mac enabled {
        require arche.current_location == Kult
    } then {
        Scruter_Mac.current_location = Kult
    }
    proc mac2 enabled {
        require arche.current_location == Mastachok
    } then {
        Scruter_Mac.current_location = Mastachok
    }
    proc kult enabled {
        during travel
        require arche.current_location == Kult
        require presentation == Scruter_Mac
    } then {
        say Scruter_Mac presentation=scr01.hnm if_not_shown skip_next=1 : "Turn around|... Move on|... There are too many pilgrims|... The planet's inaccessible|..."
        request sequence "1kkult20.hnm"
        say Scruter_Mac presentation=scr02.hnm : "The planet KULT is inaccessible|. There are too many pilgrims..."
        when {
            require Scruter_Mac.encounter_count < 3
        } then {
            say Scruter_Mac presentation=text_only chatter if_not_shown skip_next=1 : "Commander... Commander|... It's the planet TUMUL with a new name|.."
            request sequence "1kkult20.hnm"
            say Scruter_Mac presentation=text_only if_not_shown skip_next=1 : "That's right|, Commander... When we saved BETAKAM IV, king of the Patagos, we altered history..."
            request sequence "hboc.hnm"
            say Scruter_Mac presentation=text_only if_not_shown skip_next=1 : "Pilgrims now flock to hear the VOICE that saved BETAKAM and his people from the catastrophe..."
            request sequence "hboc.hnm"
            say Scruter_Mac presentation=text_only chatter : "How about that|... What a story|..."
            say Scruter_Mac presentation=scr01.hnm if_not_shown skip_next=1 : "Turn around|... Keep moving... There are too many pilgrims... The planet is inaccessible..."
            end presentation Scruter_Mac
        }
        say Scruter_Mac presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Scruter_Mac
    }
    proc ondo1 enabled {
        during contact
        require presentation == ondoyant
    } then {
        say ondoyant presentation=onda19.hnm : "..."
        say ondoyant presentation=onda20.hnm : "..."
        say ondoyant presentation=onda01.hnm : "I am yours to command|, Commander|..."
        say ondoyant presentation=text_only chatter : "Commander|... My knees are weak|..."
        say ondoyant presentation=onda03.hnm : "You want a little kiss|?"
        say ondoyant presentation=text_only chatter : "Holy hen gizzards|, Commander|... I'm starting to overheat|..."
        say ondoyant presentation=onda04.hnm : "You can talk to me Commander|... Tell me about yourself|..."
        say ondoyant presentation=text_only chatter : "Where did she learn to swim like that|?|... You think she'd agree to give me lessons|, Commander|?"
        when {
            require Tina_Burner.encounter_count > 0
            require globals.bok == 1
        } then {
            say ondoyant presentation=onda07.hnm : "Oh|! Commander|, Honk told me you needed a ring|..."
            say ondoyant presentation=text_only chatter : "Commander|, I swear I didn't say a thing|..."
            say ondoyant presentation=onda08.hnm : "Ha|! Ha|! Who's a little fibber|?|... You ogle me as soon as the Commander's back is turned|..."
            say ondoyant presentation=text_only chatter : "Commander|... She's making this up|..."
            say ondoyant presentation=text_only if_not_shown skip_next=1 : "Really|, Mister Honk|??? I'm a little disappointed in you|..."
            request sequence "rgbtr9.hnm"
            say ondoyant presentation=text_only chatter : "No no|, Mister Bronko|... Don't believe a word she says|..."
            say ondoyant presentation=onda06.hnm : "Ha|! Ha|! Ha|! Ha..."
            say ondoyant presentation=onda08.hnm if_not_shown skip_next=1 : "Commander|... I have a ring|... I want you to have it|... It's yours|..."
            ring.holder = aboard
            say ondoyant presentation=text_only chatter : "Commander|... She gave us the ring|..."
        }
        say ondoyant presentation=onda22.hnm if_not_shown skip_next=1 : "..."
        end presentation ondoyant
    }
    global bok = 0
    proc big1 enabled {
        during travel
        require arche.current_location == Bigbang
        require presentation == Bug_Deluxe
    } then {
        say Bug_Deluxe presentation=sytr_1.hnm : "You here|, Consumer Comrade|?"
        say Bug_Deluxe presentation=text_only chatter : "Commander|!!! It's Bug Deluxe|, the sales assistant from VENUSIA|... How about that|..."
        say Bug_Deluxe presentation=sytr_3.hnm : "Are you here for the wedding|?|..."
        say Bug_Deluxe presentation=text_only chatter : "Wedding|? What wedding|???"
        say Bug_Deluxe presentation=sytr_5.hnm : "You mean to say you haven't heard|?"
        say Bug_Deluxe presentation=sytr_6.hnm : "MIGRATOR and TINA BURNER are getting married|..."
        say Bug_Deluxe presentation=sytr_7.hnm : "They're giving a big show here at the BIG BAND CLUB..."
        say Bug_Deluxe presentation=text_only chatter : "At the what|??? Was that BIG BAND or BIG BANG|???"
        say Bug_Deluxe presentation=sytr_8.hnm : "Right here at the BIG BAND CLUB|! WITH A \"D\" AT THE END|..."
        say Bug_Deluxe presentation=text_only chatter : "This isn't right|, Commander|... This is the BIG BAND|, not the BIG BANG|..."
        say Bug_Deluxe presentation=text_only chatter : "Cap'n Bob isn't going to like this|..."
        say Bug_Deluxe presentation=text_only if_not_shown skip_next=1 : "What's going on here|??? What the blazes are we doing in a NIGHT CLUB|???"
        request sequence "boba2.hnm"
        say Bug_Deluxe presentation=text_only chatter : "There's been a mix up|, Cap'n Bob sir|..."
        say Bug_Deluxe presentation=text_only if_not_shown skip_next=2 : "ALL OF YOU|, INTO THE CRYOBOX RIGHT AWAY|..."
        request sequence "bobb.hnm"
        globals.exp = 1
        say Bug_Deluxe presentation=text_only if_not_shown skip_next=4 : "NOW|..."
        request sequence "bobb.hnm"
        Bug_Deluxe.current_location = Trashlando
        Tina_Burner.current_location = Bigbang
        end presentation Bug_Deluxe
    }
    global exp = 0
    proc boba0 enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.exp == 1
    } then {
        say Bob_Morlock presentation=bobb.hnm : "What's the story|??? What's this BIG BANG business|???..."
        say Bob_Morlock presentation=bobc.hnm : "Did we get to the BIG BANG|, yes or no|??? I'm listening|, Commander|..."
        say Bob_Morlock presentation=text_only chatter : "Uh|, there's been a mix up|, sir|..."
        say Bob_Morlock presentation=text_only chatter : "I think OLGA the onboard interpreter mixed up BIG BANG and BIG BAND|..."
        say Bob_Morlock presentation=bobc.hnm : "WHAT DO YOU MEAN SHE MIXED UP BIG BANG AND BIG BAND|... TELL ME THIS IS JUST A BAD DREAM|!!!"
        dictionary blank after "TELL"
        say Bob_Morlock presentation=text_only chatter : "Afraid not|, sir|... She mixed up BANG and BAND..."
        say Bob_Morlock presentation=text_only chatter : "It's the only explanation|..."
        say Bob_Morlock presentation=text_only chatter : "BIO-TRANSLATOR OLGA REPORTING|:"
        say Bob_Morlock presentation=text_only chatter : "MISTER HONK IS A DIRTY LIAR|!!! I didn't mix anything up|..."
        say Bob_Morlock presentation=bobg.hnm : "OLGA|... CHILL OUT|... We can clear the question up real easy|... We'll just run a test|..."
        dictionary blank after "We'll"
        say Bob_Morlock presentation=bobd.hnm : "OLGA|, say \"BIG BANG\" out loud three times|..."
        say Bob_Morlock presentation=text_only chatter : "OLGA REPORTING|:"
        say Bob_Morlock presentation=text_only chatter : "BIG BANG|... BIG BANG|... BIG BANG|..."
        say Bob_Morlock presentation=bobc.hnm : "Okay|... Now say \"BIG BAND\" with a \"D\"|..."
        say Bob_Morlock presentation=text_only chatter : "OLGA REPORTING|:"
        say Bob_Morlock presentation=text_only chatter : "BIG BANG|... BIG BANG|... BIG BANG|..."
        say Bob_Morlock presentation=text_only chatter : "Satisfied|?"
        say Bob_Morlock presentation=bobd.hnm : "Olga|... I said BIG BAND|, not BIG BANG|... You mixed them up|... GOSH DARN IT|!!!"
        say Bob_Morlock presentation=text_only chatter : "What did I tell you|? Don't say I didn't|... She fouled up|..."
        say Bob_Morlock presentation=text_only chatter : "She can't tell \"D\" from \"G\"|..."
        say Bob_Morlock presentation=bobf.hnm : "Honk|! Misbegotten junkheap|... It's all your fault|!!! Check her multiplexers|..."
        say Bob_Morlock presentation=text_only chatter : "Right away|, Cap'n Bob sir|... I'm on it|..."
        say Bob_Morlock presentation=bobc.hnm : "Ah|!!! Commander|... Remind me to tell you how much I hate machines|..."
        say Bob_Morlock presentation=text_only chatter : "Got it|! Cap'n Bob... I found the glitch|... It's a MOSQUITO stuck to the letter \"D\" in the multiplexer|..."
        say Bob_Morlock presentation=text_only chatter : "I hate mosquitos|..."
        say Bob_Morlock presentation=text_only chatter : "MESSAGE FROM OLGA|:"
        say Bob_Morlock presentation=text_only chatter : "IF THIS PLACE WAS CLEANED UP MORE OFTEN THIS KIND OF THING WOULDN'T HAPPEN|..."
        say Bob_Morlock presentation=bobh.hnm : "She's right|... This Ark is a pigsty|!!! This mess makes me sick|!!!"
        say Bob_Morlock presentation=text_only chatter : "Dont' look at me|! Mister BEAUREGARD's on cleaning duty this week|!!!"
        say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "What|!!! Don't drag me into this|! That does it|! I've had it with this stupid ship|..."
        request sequence "hboc.hnm"
        say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "I want to go home|..."
        request sequence "hboc.hnm"
        say Bob_Morlock presentation=bobd.hnm : "That's enough|, Mister Beauregard|... Return to your cryobox|..."
        say Bob_Morlock presentation=text_only chatter : "I told you so|... I told you|..."
        say Bob_Morlock presentation=bobf.hnm : "Commander, drop Mister BEAUREGARD off on the planet Tumul|..."
        say Bob_Morlock presentation=bobc.hnm : "AND GET BACK TO WORK|!!!"
        say Bob_Morlock presentation=text_only chatter if_not_shown skip_next=3 : "Yes sir|, Cap'n Bob sir|..."
        globals.bok = 1
        boba0.enabled = false
        end presentation Bob_Morlock
    }
    proc boba1 enabled {
        during contact
        require presentation == Bob_Morlock
    } then {
        when {
            require !Bigbang.known
        } then {
            say Bob_Morlock presentation=bobc.hnm : "Aaaah|..."
            say Bob_Morlock presentation=bobd.hnm : "When will we get to the Big Bang|? It's URGENT|, Commander|..."
            say Bob_Morlock presentation=bobe.hnm : "WE MUST FIND the Big Bang|... THAT'S YOUR MISSION|, REMEMBER|?"
            say Bob_Morlock presentation=text_only chatter : "Yes sir|. All efforts are directed toward achieving the mission objective|..."
            say Bob_Morlock presentation=text_only : "SILENCE HONK|!!!"
            say Bob_Morlock presentation=bobf.hnm : "I'm mad as mad can be|, Commander|!!! You're flitting around like some gosh darn butterfly|..."
            say Bob_Morlock presentation=bobe.hnm : "You're using my time and money to go after ondoyants|!!!"
            say Bob_Morlock presentation=bobf.hnm : "That's what I call IN-TO-LE-RA-BLE|!!!"
            say Bob_Morlock presentation=bobg.hnm : "I hope I've made my feelings clear|..."
            say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "Now leave me|..."
            end presentation Bob_Morlock
        }
        when {
            require Bigbang.known
        } then {
            say Bob_Morlock presentation=bobc.hnm : "Lets go to the Bigbang..."
            say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "..."
            end presentation Bob_Morlock
        }
    }
    proc big2 enabled {
        during travel
        require arche.current_location == Bigbang
        require presentation == Tina_Burner
    } then {
        say Tina_Burner presentation=tina_tr.hnm : "Ohhh|... It's you|, Commander|..."
        say Tina_Burner presentation=text_only chatter : "Oh no|... Her again|..."
        say Tina_Burner presentation=tine_tr.hnm : "AH|! How delightful to see you again|, sweeties|... I so much wanted to invite you along|..."
        say Tina_Burner presentation=ting_tr.hnm : "But I didn't know where to send the invitations|..."
        say Tina_Burner presentation=ting_tr.hnm : "I'm getting married|, you see|... Hee|! Hee|! Hee|! To darling MIGRATOR|... Hee|! Hee|! Hee|!"
        say Tina_Burner presentation=text_only chatter : "Holy homeostatics|... Poor guy|..."
        say Tina_Burner presentation=tinh_tr.hnm : "We're giving a concert here at the BIG BAND CLUB|... It's such a fashionable place|, you know|... Why|, the whole galaxy'll be here|!"
        say Tina_Burner presentation=tini_tr.hnm : "Our concert's going to be broadcast by all the TV stations in the universe|!!"
        say Tina_Burner presentation=tinj_tr.hnm : "I'm so famous|, Commander|... Hee|! Hee|! Hee|!"
        say Tina_Burner presentation=text_only chatter : "I can't help wishing we'd gone somewhere else|... This place has an end of the world feel|..."
        say Tina_Burner presentation=tinc_tr.hnm : "Darling Migra's at the bar|, drinking a frozen Migrita|..."
        say Tina_Burner presentation=tinc_tr.hnm : "MIGRA OH MIGRA SWEETIE|... GUESS WHO'S COME|..."
        say Tina_Burner presentation=tinb_tr.hnm if_not_shown skip_next=4 : "Go join him for a stiff one|, Commander|..."
        big2.enabled = false
        Migrator.current_location = bar1
        Tina_Burner.current_location = Trashlando
        navigate to bar1
    }
    proc bar1 enabled {
        during travel
        require arche.current_location == Bigbang
        require presentation == Migrator
    } then {
        say Migrator presentation=migb_tr.hnm : "You here|, Commander|! My good friend|... Did Burny tell you the news|?"
        dictionary blank after "news"
        say Migrator presentation=migc_tr.hnm : "We're getting married|... Ah|!!! She's so sexy|, and smart|..."
        say Migrator presentation=text_only chatter : "Commander|... Howzabout a strategic withdrawal here|?|... Commander|?"
        say Migrator presentation=migf_tr.hnm : "And it's all thanks to you|... I'd like you to be my best man|!"
        say Migrator presentation=text_only chatter : "Oh NO|..."
        say Migrator presentation=migg_tr.hnm : "You'll give her the wedding band|..."
        say Migrator presentation=text_only chatter : "THE WEDDING BAND|... How about a ring for her nose|..."
        say Migrator presentation=migf_tr.hnm : "Hurry up|, Commander|... We can't have the ceremony without a ring|..."
        say Migrator presentation=text_only chatter : "Holy handouts|... Where do we find a wedding band at this time of day or night|?"
        say Migrator presentation=migc_tr.hnm if_not_shown skip_next=5 : "See you soon|, Commander|..."
        bar1.enabled = false
        Migrator.current_location = Trashlando
        Tina_Burner.current_location = bar2
        Yoko.current_location = Bigbang
        end presentation Migrator
    }
    proc big3 enabled {
        during travel
        require arche.current_location == Bigbang
        require presentation == Yoko
    } then {
        say Yoko presentation=yok02.hnm : "Commander|! Yoko happy to see you again|..."
        say Yoko presentation=text_only chatter : "Commander|... It's young Yoko|..."
        say Yoko presentation=yok03.hnm : "Migrator and Tina wait for wedding ring|..."
        when {
            require ring.holder == blood
        } then {
            say Yoko presentation=yok06.hnm : "You have ring|?"
            say Yoko presentation=text_only chatter : "No problem|, Mister Yoko|... We have the wedding band right here|..."
            say Yoko presentation=yok07.hnm : "YES|!!! Me happy|..."
            say Yoko presentation=yok08.hnm if_not_shown skip_next=3 : "You go bar|, Tina be impatient|..."
            big3.enabled = false
            Fifi.current_location = bar1
            navigate to bar1
        }
        say Yoko presentation=text_only chatter : "You agreed to get a ring|, Commander|. You'll have to deliver|..."
        say Yoko presentation=text_only chatter : "Whatever it takes|..."
        say Yoko presentation=yok05.hnm : "You hurry|, Commander|. Everybody wait|..."
        say Yoko presentation=text_only chatter if_not_shown skip_next=1 : "Let's get to it|, Commander|. I want to know how this thing turns out|..."
        end presentation Yoko
    }
    proc bar2 enabled {
        during travel
        require arche.current_location == Bigbang
        require presentation == Fifi
    } then {
        say Fifi presentation=ompb.hnm : "Ga..."
        say Fifi presentation=ompc.hnm : "Ga|... Fifi eat|..."
        say Fifi presentation=text_only chatter : "Fifi|! What are you doing here|?"
