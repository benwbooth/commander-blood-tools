    proc bar3 enabled {
        during travel
        require arche.current_location == Bigbang
        require orxx.current_location == bar2
        require presentation == Tina_Burner
    } then {
        say Tina_Burner presentation=tinb_tr.hnm : "Ah|!! There you are at last|, Commander|... Everyone's waiting for you|..."
        say Tina_Burner presentation=text_only chatter : "Holy handstands|!!!"
        say Tina_Burner presentation=tinc_tr.hnm : "MIGRA's so worried|... You do have the wedding band|, Commander|?"
        say Tina_Burner presentation=text_only chatter : "Yeah|... We have your ring|, Miss Burner|..."
        say Tina_Burner presentation=tine_tr.hnm : "WHAT|!! That cybernetic sex fiend is here|? No|!! I don't want him at my wedding|..."
        say Tina_Burner presentation=tinf_tr.hnm : "He's definitely not invited|!!! I can't get married with him ogling me|!!!"
        say Tina_Burner presentation=text_only chatter : "WHAT|??? The old bag insulted me|... Are you gonna let her get away with that|, Commander|?"
        say Tina_Burner presentation=text_only chatter : "Get lost|, you old sow|!|...|..."
        say Tina_Burner presentation=tini_tr.hnm : "SOW|!! BOO HOO HOO|... MIGRA|... MIGRATOR|... Come|! I need you|... BOO HOO HOO|..."
        say Tina_Burner presentation=text_only chatter : "She's so gross|, Commander|..."
        say Tina_Burner presentation=text_only if_not_shown skip_next=1 : "What's all this racket|? Can't a guy get any sleep around here|?"
        request sequence "bobb.hnm"
        say Tina_Burner presentation=text_only chatter : "She started it|, Cap'n Bob sir|... Ask the Commander|..."
        say Tina_Burner presentation=tinh_tr.hnm : "BOO HOO HOO"
        say Tina_Burner presentation=text_only if_not_shown skip_next=1 : "Just keep the noise down|, okay|?"
        request sequence "bobb.hnm"
        say Tina_Burner presentation=text_only : "YES sir|... Right down|..."
        say Tina_Burner presentation=text_only chatter : "Okay|... Let's go see MIGRATOR|, Commander|..."
        say Tina_Burner presentation=tine_tr.hnm if_not_shown skip_next=1 : "MIGRATOR|... BOO|... MIGRA HOO HOO HOO|..."
        navigate to bar1
    }
    proc bar4 enabled {
        during travel
        require arche.current_location == Bigbang
        require orxx.current_location == bar1
        require presentation == Migrator
