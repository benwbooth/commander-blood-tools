    proc masta1 enabled {
        during travel
        require presentation == Scruter_Mac
    } then {
        say Scruter_Mac presentation=scr19.hnm : "YOU IN FORBIDDEN ZONE|... ME GIVE WARNING|, STRANGER"
        say Scruter_Mac presentation=scr18.hnm : "Me not know you|."
        say Scruter_Mac presentation=text_only chatter : "It must be Scruter Mac's twin brother|, Commander|... Took over his job|..."
        say Scruter_Mac presentation=scr17.hnm : "You say code"
        say Scruter_Mac presentation=scr02.hnm resume_at=masta1_dialogue_resume_1 : "Hurry|, stranger!" choices "croolas" "galabar" "code" "pterra" "exxos"
        dictionary blank after "croolas"
        when {
            require choice == "code"
        } then {
            say Scruter_Mac presentation=scr13.hnm : "You say code|..."
            say Scruter_Mac presentation=scr15.hnm : "You not stupid|... But me smarter than you|..."
            say Scruter_Mac presentation=scr08.hnm if_not_shown skip_next=1 : "You want see prisoner|..."
            choice = none
        }
        when {
            require choice != "code"
        } then {
            say Scruter_Mac presentation=scr10.hnm : "You not say code|... Me not like|... Not like|..."
            say Scruter_Mac presentation=scr08.hnm : "You meet my laser-pulper|..."
            say Scruter_Mac presentation=scr09.hnm if_not_shown skip_next=3 : "BYE BYE FRIEND|..."
