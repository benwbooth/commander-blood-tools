    }
    proc revel enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.revelat == 0
    } then {
        say Bob_Morlock presentation=bobh.hnm : "Would you care to know an unbearable truth|, Commander|?"
        say Bob_Morlock presentation=bobg.hnm : "HONK|! Switch yourself off for ten seconds|!!!"
        say Bob_Morlock presentation=text_only chatter : "But|, Cap'n Bob|! I|..."
        say Bob_Morlock presentation=bobf.hnm : "SWITCH OFF I SAID|!!!"
        say Bob_Morlock presentation=text_only chatter : "Yes sir|....."
        say Bob_Morlock presentation=text_only chatter : "KRUIIIIK|!!! AAAaaaaaaaaaaaaahhhhh|!!!"
        say Bob_Morlock presentation=bobf.hnm : "COMMANDER|, YOU ARE ME|...."
        say Bob_Morlock presentation=bobg.hnm : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES|..."
        say Bob_Morlock presentation=bobe.hnm : "YOU ARE MORE THAN MY SON|..."
        say Bob_Morlock presentation=bobf.hnm : "We are the same person|... I am the first being to create itself|..."
        say Bob_Morlock presentation=bobe.hnm : "And|, thanks to space-time contorsion, to watch itself relive|: YOU ARE BOB|, COMMANDER|..."
        say Bob_Morlock presentation=bobc.hnm : "I am what you'll be in a few hundred thousand years|..."
        say Bob_Morlock presentation=bobg.hnm : "OK Honk|, you can switch yourself back on|..."
        say Bob_Morlock presentation=text_only chatter : "KROIIIIkkk|!!! -&KRUIIIIkkk|!!! -&I AM supposed to be aware of everything that goes on round here|, being the onboard computer|... Don't tell me you switched off Olga|???"
        say Bob_Morlock presentation=bobf.hnm if_not_shown skip_next=2 : "Can it and do some work|!!"
        revel.enabled = false
        end presentation Bob_Morlock
    }
    global revelat = 0
    proc honk1 enabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=text_only chatter : "I exist only to obey|, Commander"
        when {
            require globals.vbio == 0
        } then {
            say Honk presentation=text_only chatter : "Commander|, we don't have any BIONIUM|... COMMANDER|, please|..."
            say Honk presentation=text_only chatter : "I need that energy|..."
            say Honk presentation=text_only chatter : "You must enter Scruter Jo's CYBERSPACE|..."
            say Honk presentation=text_only chatter : "Wake up Scruter Jo|, Commander|. He's sleeping in the Cryobox|..."
        }
        when {
            require globals.vbio == 1
        } then {
            say Honk presentation=text_only chatter : "We've got one dose of BIONIUM left|, Commander"
            say Honk presentation=text_only chatter : "You must enter Scruter Jo's CYBERSPACE|..."
            say Honk presentation=text_only chatter : "I don't feel too sure of myself|, Commander... I really need that energy|..."
        }
        when {
            require globals.vbio == 2
        } then {
            say Honk presentation=text_only chatter : "We've got two doses of BIONIUM left|, Commander"
            say Honk presentation=text_only chatter : "You must enter Scruter Jo's CYBERSPACE|..."
        }
        when {
            require globals.vbio == 3
        } then {
            say Honk presentation=text_only chatter : "We've got three doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 4
        } then {
            say Honk presentation=text_only chatter : "We've got four doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 5
        } then {
            say Honk presentation=text_only chatter : "We've got five doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 6
        } then {
            say Honk presentation=text_only chatter : "We've got six doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 7
        } then {
            say Honk presentation=text_only chatter : "We've got seven doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 8
        } then {
            say Honk presentation=text_only chatter : "We've got eight doses of BIONIUM left|, Commander"
            say Honk presentation=text_only chatter : "You're the best|, Commander|..."
        }
        when {
            require globals.vbio > 2
            require Hom.encounter_count < 2
            require !Bigbang.known
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Commander|, I'm sure that HOM is a vital link in the chain that leads to the Big Bang..."
            globals.vbio -= 3
        }
        when {
            require globals.vbio > 2
            require globals.bok == 0
            require Migrator.encounter_count > 0
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Commander|, Mister Bob want to see you in the Cryobox..."
            globals.vbio -= 3
        }
        when {
            require globals.vbio > 2
            require Yoko.current_location == aboard
            require Yoko.encounter_count == 0
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Commander, don't forget Yoko and Maxxon asleep CRYOBOX..."
            globals.vbio -= 3
        }
        when {
            require globals.vbio > 2
            require Yoko.current_location == aboard
            require Yoko.encounter_count > 0
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Approach the planet RONDO and talk to Yoko or Maxxon in the CRYOBOX in order to teleport them..."
            globals.vbio -= 3
        }
        when {
            require globals.vbio > 2
            require Bug_Deluxe.encounter_count == 0
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Better go see Bug Deluxe on Venusia..."
            globals.vbio -= 3
        }
        when {
            require globals.vbio > 2
            require ring.holder == ondoyant
            require globals.Bigband == globals.est
            require Migrator.encounter_count > 0
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Commander... Maybe the ondoyant has a ring for us|..."
            globals.vbio -= 3
        }
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "More information|?"
        Honk.topic = "talk"
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Bye bye|, Commander|..." choices "bye_bye"
        end presentation Honk
        halt
    }
    global Bigband = 0
    global est = 0
    global adieu = 0
    global mastok = 0
}

conversations {
    yield

    selector Eviscerator_choices {
        case "talk" continues {
            menu "bye_bye" "peace" "war" "prison" "planet" "television" "politics" "reproduction" "science" "race" "consumerism"
            say Eviscerator presentation=crl06.hnm : "What you want|?" choices "talk"
            say Eviscerator presentation=crl03.hnm repeatable : "Me not say bye bye|, INSULT|... SWEAR|..." choices "bye_bye"
            say Eviscerator presentation=crl03.hnm : "Me watch TV|: good night viewers" choices "television"
            say Eviscerator presentation=crl01.hnm : "Vortex of Fortune|, me like|. Light shine|, vortex spin|. Nice|..." choices "television"
            say Eviscerator presentation=crl02.hnm : "Aaah Tina Burner|, me cry cry|. Me like songs to cry|..." choices "television"
            say Eviscerator presentation=crl13.hnm : "Me like muscles" choices "politics"
            say Eviscerator presentation=crl12.hnm : "Riot police nice politics" choices "politics"
            say Eviscerator presentation=crl11.hnm : "War nice politics" choices "politics"
            say Eviscerator presentation=crl09.hnm : "Polly ticks|! funny funny|, ah ha ah yaeurghhh..." choices "politics"
            dictionary blank after "funny"
            say Eviscerator presentation=crl09.hnm : "Ooouuuh|, you not talk reproduction|. Me go red|..."
            say Eviscerator presentation=crl11.hnm : "Reproduction|, hot babes|! ahhhhaha ha ha ha aaaaahh|, laugh laugh laugh swear|..." choices "reproduction"
            say Eviscerator presentation=crl02.hnm : "Me not know science|. Complicated" choices "science"
            say Eviscerator presentation=crl10.hnm : "Science be for sissy brains|. Me stronger than science|. Me squash science" choices "science"
            say Eviscerator presentation=crl13.hnm : "Science|, science|. You obsessed|! Me not like|!" choices "science"
            say Eviscerator presentation=crl03.hnm : "Trump tail smoke much" choices "consumerism"
            say Eviscerator presentation=crl08.hnm : "Me like consume|. Rata ta ta ta ta tata|. That be consume|. LAUGH SWEAR|..." choices "consumerism"
            say Eviscerator presentation=crl13.hnm : "You be consumerism|...." choices "consumerism"
        }
        case "planet" continues {
            menu "talk" "corpo" "magnus" "vista" "erazor" "trashlando" "tumul" "pterra" "Eden"
            say Eviscerator presentation=crl07.hnm : "Me know planets|..." choices "planet"
            say Eviscerator presentation=crl06.hnm : "Me like destroy planets|, booomm! Swear laugh laugh|..." choices "planet"
            say Eviscerator presentation=crl02.hnm : "Corpo big planet|. Much strangers|. Me not like strangers|. Make me mad|..." choices "corpo"
            say Eviscerator presentation=crl07.hnm : "Me splat strangers|... Ra ta ta ta ta... Laugh swear" choices "corpo"
            say Eviscerator presentation=crl07.hnm : "Much creatures on Magnus|. Migrax yuk|!" choices "magnus"
            say Eviscerator presentation=crl12.hnm : "Me hate SCRUT|. Me not like talk about scruter|. Me break things|!" choices "vista"
            say Eviscerator presentation=crl03.hnm : "Erazor everybody|, Ha|! Ha|! Ha|! Ha|! Ha|! Swear|... You laugh|!" choices "erazor"
            say Eviscerator presentation=crl11.hnm : "You have cold|... You want my finger in your nose|? Laugh|... Mean and moronic laughter|..." choices "trashlando"
            say Eviscerator presentation=crl12.hnm : "Tumul|... You say Tumul|?" choices "tumul"
            say Eviscerator presentation=crl09.hnm : "You call me rat|, not nice|. aaahhhggd|.. Swear insult|..." choices "pterra"
            say Eviscerator presentation=crl07.hnm repeatable : "Me have friends on planet Eden|... Swear|..." choices "Eden"
        }
        case "race" continues {
            menu "bye_bye" "talk" "izwal" "croolis" "sinox" "tromp" "migrax" "buggol" "ondoyant"
            say Eviscerator presentation=crl04.hnm : "Izwals small with trunks|, yuk|..." choices "izwal"
            say Eviscerator presentation=crl05.hnm : "Izwal|, me spalt|, me eat|. Yummy" choices "izwal"
            say Eviscerator presentation=crl06.hnm : "Me not want talk|. Izwal not interesting" choices "izwal"
            say Eviscerator presentation=crl12.hnm : "Me like Izwal boiled in liquid nitrogen soup|. Slurp" choices "izwal"
            say Eviscerator presentation=crl10.hnm : "Izwals small|. No money|..." choices "izwal"
            say Eviscerator presentation=crl09.hnm : "Izwals not like money|. Them be stupid|..." choices "izwal"
            say Eviscerator presentation=crl13.hnm : "Izwals too small|. Much bones|..." choices "iwals"
            say Eviscerator presentation=crl05.hnm : "Izwal boiled longtime not bad" choices "izwals"
            say Eviscerator presentation=crl10.hnm : "Me like Izwal stuffed with mercury in liquid nitrogen sauce" choices "izwal"
            say Eviscerator presentation=crl13.hnm : "Me big Croolis" choices "croolis"
            say Eviscerator presentation=crl09.hnm : "Me like me|, kiss kiss kiss" choices "croolis"
            say Eviscerator presentation=crl11.hnm : "Croolis Vareux stink|, yuk|..." choices "croolis"
