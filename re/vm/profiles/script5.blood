    proc scrujo enabled {
        during contact
        require presentation == Scruter_Jo
    } then {
        say Scruter_Jo presentation=scr20.hnm : "Commander|, you go search BIONIUM in SCRUTER JO's cyberspace|..."
        when {
            require globals.compris == 0
        } then {
            say Scruter_Jo presentation=text_only : "Me explain how you pick up BIONIUM|.."
            say Scruter_Jo presentation=text_only : "You find BIOXX|. Bioxx be small energy creatures|..."
            say Scruter_Jo presentation=scr02.hnm : "You touch BIOXX with hand once|."
            say Scruter_Jo presentation=text_only chatter : "Sounds like a piece of cake to me|, Commander|!!"
            say Scruter_Jo presentation=scr03.hnm : "If you touch BIOXX twice|, you CAPTURE BIOXX on tip of your finger|..."
            say Scruter_Jo presentation=text_only chatter : "You catch it on the tip of your finger|!!! How about that|..."
            say Scruter_Jo presentation=scr04.hnm : "Then you can carry BIOXX to Cybernetic MANTAS"
            say Scruter_Jo presentation=scr06.hnm : "You put BIOXX in belly of Manta|..."
            say Scruter_Jo presentation=scr05.hnm : "BIOXX stick to MANTAS|..."
            say Scruter_Jo presentation=text_only chatter : "That's something I wanna see|..."
            say Scruter_Jo presentation=scr07.hnm : "Mantas change BIOXX into BIONIUM..."
            say Scruter_Jo presentation=scr06.hnm : "More BIOXX you give to Mantas|, more BIONIUM you get|..."
            say Scruter_Jo presentation=text_only chatter : "Lead me to those BIOXXes|!!! BIONIUM|... Yummy|..."
            say Scruter_Jo presentation=scr05.hnm : "To come back from CYBERSPACE|, you touch BLUE BOX|...."
            say Scruter_Jo presentation=scr07.hnm : "You understand|?"
            say Scruter_Jo presentation=text_only chatter : "We get the picture|, Mister SCRUTER JO|... Right|, Commander|?"
        }
        say Scruter_Jo presentation=scr21.hnm : "YOU go|, Commander|..."
        say Scruter_Jo presentation=scr22.hnm : "Ahh|... Me feel better|..."
        when {
            require globals.vbio > 0
        } then {
            say Scruter_Jo presentation=scr03.hnm : "Good work|... You did be successful|..."
            say Scruter_Jo presentation=scr04.hnm : "You did get BIONIUM|..."
            say Scruter_Jo presentation=text_only chatter : "YES|!!! Commander|, did I ever tell you what a cool dude you are|?"
            say Scruter_Jo presentation=text_only chatter : "The BIONIUM will make me smarter and I'll be able to help you better|..."
            globals.compris = 1
        }
        when {
            require globals.vbio == 0
        } then {
            say Scruter_Jo presentation=scr05.hnm : "Not good|, friend|... You fail|..."
            say Scruter_Jo presentation=text_only chatter : "You didn't understand the idea|, huh|, Commander|..."
            say Scruter_Jo presentation=text_only chatter : "I have to have BIONIUM|, Commander|. It makes me smarter|..."
            say Scruter_Jo presentation=scr05.hnm : "Ha|! Ha|! You need much bionium BIONIUM|... Ha|! Ha|!|..."
            say Scruter_Jo presentation=text_only chatter : "That's enough out of you|!!!"
        }
        say Scruter_Jo presentation=scr08.hnm if_not_shown skip_next=1 : "Bye bye|, Commander|. Me go back to CYBERSPACE..."
        end presentation Scruter_Jo
    }
    proc bigb1 enabled {
        during travel
        require Tina_Burner.current_location == Trashlando
        require presentation == Migrator
    } then {
        say Migrator presentation=migf_tr.hnm : "Me greet you|, friend|..."
        say Migrator presentation=migc_tr.hnm : "You have ring|???..."
        say Migrator presentation=migd_tr.hnm : "Me soon marry TINA... YOU COME WEDDING|. ME INVITE YOU|. WE MAKE BIG CONCERT|..."
        when {
            require ring.holder == blood
        } then {
            say Migrator presentation=text_only chatter : "Teleport him the ring|, Commander|. That'll make his day|...."
            say Migrator presentation=text_only resume_at=bigb1_dialogue_resume_1 : "RING TELEPORTED TO MIGRATOR" choices "TELEPORT"
            when {
                require choice == "TELEPORT"
            } then {
                say Migrator presentation=text_only if_not_shown skip_next=2 : "RING TELEPORTED TO MOSKITO AIRPORT ZONE|."
                transfer ring from aboard to Migrator
                choice = none
            }
            bigb1_dialogue_resume_1:
            say Migrator presentation=migc_tr.hnm : "WOWWWW|! Ring be nice nice|... Me like|... Me thank you|, friend|...."
            say Migrator presentation=migd_tr.hnm : "Thank you|... Thank you|... YOU COME WEDDING|... WE MAKE BIG CONCERT|..."
            say Migrator presentation=migc_tr.hnm : "BYE BYE FRIEND|.... TINA SEND YOU BIG KISS|..."
            say Migrator presentation=text_only if_not_shown skip_next=2 : "..."
            globals.mariage = 1
            end presentation Migrator
        }
        say Migrator presentation=migc_tr.hnm : "You not have ring|... Me worried friend|..."
        say Migrator presentation=migd_tr.hnm : "You quick go get ring|..."
        say Migrator presentation=migc_tr.hnm : "Me wait you|. Bye bye friend|..."
        say Migrator presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Migrator
    }
    global mariage = 0
    proc veuv enabled {
        during bridge
        require Bug_Deluxe.current_location == Bigbang
    } then {
        queue presentation Scruter_K
        veuv1.enabled = true
        veuv.enabled = false
    }
    proc veuv1 disabled {
        during bridge
    } then {
        say Scruter_K presentation=text_only : "Come in come in|...THIS BE HANNA SCRUTA|. My husband SCRUTER JO be fighter pilot|..."
        say Scruter_K presentation=text_only : "You blow up his fighter in combat|... ME WIDOW NOW|... CRY|... CRY|..."
        say Scruter_K presentation=text_only : "ME NOT CAN PAY RENT|... YOUR FAULT|... INSURANCE NOT GIVE ANYTHING|..."
        say Scruter_K presentation=text_only : "ME WIDOW|... CRY|... CRY|... DESPAIRING WAIL|.... YOU KILL SCRUTER JO|..."
        say Scruter_K presentation=text_only chatter : "Commander|? They're giving out your phone number to widows now|..."
        say Scruter_K presentation=text_only chatter : "It's not right|. They're trying to psych you out|, Commander|... Don't answer|..."
        say Scruter_K presentation=text_only : "YOU MUST PAY|... CRY|... CRY|... YOU DID KILL MY SCRUTER JO|... CRY|... CRY|...."
        say Scruter_K presentation=text_only : "KRUIKKK..."
        say Scruter_K presentation=text_only chatter : "She hung up|... I don't like it|, Commander|..."
        say Scruter_K presentation=text_only if_not_shown skip_next=2 : "stop"
        veuv1.enabled = false
        end presentation Scruter_K
    }
    proc menbr enabled {
        during bridge
        require presentation == menu
        require Bronko.current_location == aboard
    } then {
        say menu presentation=text_only : "\"IMPROVED MENU\""
        say menu presentation=text_only : "Today CHEF BRONKO has laid out for you|:"
        say menu presentation=text_only : "Tasty MUFFALO soup Bronko-style|."
        say menu presentation=text_only : "MURFFALO kidneys Bronko-style|."
        say menu presentation=text_only : "MURFFALO hamburger with Bar-B-Q recycled-oil dip|."
        say menu presentation=text_only : "Smooth MURFFALO-chip ice cream|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "Chef Bronko says|... Burping's bad manners|!|..."
        say menu presentation=text_only if_not_shown skip_next=1 : "stop"
        end presentation menu
    }
