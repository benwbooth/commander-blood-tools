            say Eviscerator presentation=crl01.hnm : "Sinox smart|..." choices "sinox"
            say Eviscerator presentation=crl05.hnm : "Me like smoke Trump tail" choices "tromp"
            say Eviscerator presentation=crl10.hnm : "Trump tail smell good|. Nice for head before battle" choices "tromp"
            say Eviscerator presentation=crl02.hnm : "Migrax good music for cry" choices "migrax"
