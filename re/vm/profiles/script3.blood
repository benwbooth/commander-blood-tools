        } then {
            sequence_slots[1] = "maledict"
            sequence_slots[2] = "maledict"
            sequence_slots[3] = "maledict"
            sequence_slots[4] = "maledict"
            sequence_slots[5] = "maledict"
            sequence_slots[6] = "maledict"
            say Beauregard presentation=text_only if_not_shown skip_next=4 : "TELEPORTING MUMMY TO ARK"
            transfer mummy from Beauregard to aboard
            globals.maledict = 1
            choice = none
            globals.beau = 6
        }
    }
    global maledict = 0
