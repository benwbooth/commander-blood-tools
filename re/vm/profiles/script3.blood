            say Kran_Dobu presentation=text_only chatter : "Uh|... I hope he knows how to put everything back together|... I mean|, anyone can take things apart|..."
            say Kran_Dobu presentation=khran1_2.hnm@2 if_not_shown skip_next=1 : "Hey|! It works|! He got my engines working|... I am dazed and amazed|!!!"
            globals.panne = 2
        }
        when {
            require Morning_Oil.current_location == Trashlando
            require globals.panne == 2
        } then {
            say Kran_Dobu presentation=khran2_2.hnm : "Thanks guys|... You are beautiful|..."
            say Kran_Dobu presentation=khran1_2.hnm@2 : "Here's my bionic guitar|, as promised|... You be careful with it|..."
            say Kran_Dobu presentation=text_only resume_at=kra4_dialogue_resume_1 : "TELEPORT GUITAR TO ARK|..." choices "teleport"
            when {
