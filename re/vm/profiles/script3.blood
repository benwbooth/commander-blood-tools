        globals.beau = 5
        navigate to tumulus
    }
    proc tum7 enabled {
        during travel
        require orxx.current_location == tumulus
        require presentation == Beauregard
        require globals.beau == 5
    } then {
        say Beauregard presentation=bor_e_tr.hnm : "Holy Handstands|... Get a load of that|, Commander|..."
        say Beauregard presentation=borb_atr.hnm : "I love those mummies|... Such beauty|... Such splendor|..."
        say Beauregard presentation=borb_btr.hnm : "Commander, to reward you|, I offer you the mummy of BETAKAM IV|..."
        say Beauregard presentation=borb_ctr.hnm : "You earned it|... As for me|, I shall study this astonishing site|..."
        say Beauregard presentation=text_only resume_at=tum8 : "TELEPORT MUMMY TO ARK" choices "teleport"
