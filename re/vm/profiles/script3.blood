        require orxx.current_location == fresque
        require presentation == Beauregard
        require globals.beau == 2
    } then {
        say Beauregard presentation=bor_b_tr.hnm : "Check out these archeological wonders|!"
        say Beauregard presentation=bor_c_tr.hnm : "A people called the PATAGOS lived here long ago|..."
        say Beauregard presentation=bor_d_tr.hnm : "Until their sun|, GLADIS|, exploded|..."
        say Beauregard presentation=bor_e_tr.hnm : "I'm looking for the tomb of BETAKAM IV|, king of the PATAGOS..."
        say Beauregard presentation=borb_atr.hnm : "Follow me|, Commander..."
        say Beauregard presentation=text_only if_not_shown skip_next=3 : "..."
        Beauregard.current_location = rubble
        navigate to rubble
        globals.beau = 3
    }
    proc tum5 enabled {
        during travel
        require orxx.current_location == rubble
        require presentation == Beauregard
        require globals.beau == 3
        require splatch.holder != blood
    } then {
        say Beauregard presentation=bor_b_tr.hnm : "The tomb of BETAKAM IV lies beneath this rubble|..."
        say Beauregard presentation=bor_c_tr.hnm : "I need dynamite|, or any explosive that can blow away the rubble|..."
        say Beauregard presentation=bor_d_tr.hnm : "Find me some explosive|, Commander|..."
        say Beauregard presentation=bor_e_tr.hnm : "I shall continue working|..."
        say Beauregard presentation=text_only chatter : "What he needs is SPLATCH|, Commander|..."
        say Beauregard presentation=text_only if_not_shown skip_next=2 : "..."
        rubble.known = true
        end presentation Beauregard
    }
    proc tum6 enabled {
        during travel
        require presentation == Beauregard
        require orxx.current_location == rubble
        require globals.beau == 3
    } then {
        say Beauregard presentation=bor_b_tr.hnm : "The tomb of BETAKAM IV lies beneath this rubble|..."
        say Beauregard presentation=bor_c_tr.hnm : "I need dynamite|, or any explosive that can blow away the rubble|..."
        say Beauregard presentation=bor_b_tr.hnm : "You have the explosive|, Commander|?"
        when {
            require splatch.holder == blood
        } then {
            say Beauregard presentation=text_only chatter : "Let's teleport him the SPLATCH|, Commander|..."
            say Beauregard presentation=text_only resume_at=tum6_dialogue_resume_1 : "TELEPORT SPLATCH TO TUMUL" choices "teleport" "refuse"
            when {
                require choice == "teleport"
            } then {
                say Beauregard presentation=text_only if_not_shown skip_next=3 : "TELEPORTING SPLATCH TO TUMUL"
                transfer splatch from aboard to Beauregard
                globals.beau = 4
                choice = none
            }
            when {
                require choice == "refuse"
            } then {
                say Beauregard presentation=text_only chatter if_not_shown skip_next=3 : "Whatever you say|, Commander|. But allow me to say you're a big dummy|..."
                rubble.known = true
                choice = none
                end presentation Beauregard
            }
        }
        tum6_dialogue_resume_1:
        when {
            require splatch.holder != blood
        } then {
            say Beauregard presentation=bor_b_tr.hnm if_not_shown skip_next=2 : "I need this SPLATCH, Commander..."
            rubble.known = true
            end presentation Beauregard
        }
    }
    proc tum6bis enabled {
        during travel
        require orxx.current_location == rubble
        require presentation == Beauregard
        require globals.beau == 4
    } then {
        say Beauregard presentation=bor_e_tr.hnm : "Thanks|, Commander|. You're a standup guy|..."
        say Beauregard presentation=borb_dtr.hnm : "I'm going to make this rubble sorry it was ever born|..."
        say Beauregard presentation=borb_ctr.hnm if_not_shown skip_next=1 : "Stand back|, Commander|..."
