        require presentation == Kran_Dobu
        require globals.panne == 0
    } then {
        say Kran_Dobu presentation=khran1_3.hnm : "Ha! Hi guy|. I was wondering when you'd show up|..."
        say Kran_Dobu presentation=khran2_1.hnm : "My engine's totalled|... I must've pushed it too hard|... It just went|: ARG|... PSHHHHHH|!"
        say Kran_Dobu presentation=khran2_2.hnm : "Think you can fix it for me|?"
        say Kran_Dobu presentation=text_only chatter : "Teleport Morning Oil over to him|, Commander|. He's an ace repairman|..."
        say Kran_Dobu presentation=khran1_2.hnm@2 : "I'm waiting|, guy|..."
        say Kran_Dobu presentation=text_only if_not_shown skip_next=2 : "..."
        globals.panne = 1
        end presentation Kran_Dobu
    }
    global panne = 0
    proc kra4 enabled {
        during travel
        require presentation == Kran_Dobu
    } then {
        when {
            require globals.panne == 1
            require Morning_Oil.current_location == Ark
        } then {
            say Kran_Dobu presentation=khran1_3.hnm : "I'm still waiting|, old buddy|. You're not gonna let me down now|, huh|?|..."
            say Kran_Dobu presentation=text_only chatter if_not_shown skip_next=1 : "Commander|, Morning Oil is an expert repairman|..."
