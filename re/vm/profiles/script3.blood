        during travel
        require arche.current_location == Eden
        require globals.E1 == 0
        require presentation == Tina_Burner
    } then {
        say Tina_Burner presentation=tinb_tr.hnm : "Hey|! Handsome stranger|. You come to see Tina|?|..."
        say Tina_Burner presentation=tinb_tr.hnm : "You're in pretty bad shape|. Burny'll fix you up|.."
        say Tina_Burner presentation=tinc_tr.hnm : "You're my idea of a real man|... You got something special|... I can sniff out real males from lights years away|..."
        say Tina_Burner presentation=text_only chatter : "Honk reporting at this time|:"
        say Tina_Burner presentation=text_only chatter : "Be on your guard|, Commander|. Resist her seductive charms|..."
        say Tina_Burner presentation=tind_tr.hnm : "I'm Tina Burner|, but my best friends call me Burny|..."
        say Tina_Burner presentation=text_only chatter : "Commander|, your pulse rate is way too high|... I'll just give you a shot of something|... Commander|, are you listening|?"
        say Tina_Burner presentation=tine_tr.hnm resume_at=eda_dialogue_resume_1 : "Hey! handsome! Still living with mommy and daddy|?" choices "yes" "no"
        when {
            require choice == "yes"
        } then {
            say Tina_Burner presentation=tinf_tr.hnm : "AAAARHHH|! He still needs his mommy|... Ha|! Ha|! Hee|! Hee|!|..."
            choice = none
        }
        when {
            require choice == "no"
        } then {
            say Tina_Burner presentation=ting_tr.hnm : "Say|! You're blushing|... Is he a shy little man|? Ha|! Ha|! Hee|! Hee|!"
            choice = none
        }
        eda_dialogue_resume_1:
        say Tina_Burner presentation=tinh_tr.hnm : "You know I'm a star|, right|? On the planet Eden|, all the males are crazy about me|..."
        say Tina_Burner presentation=tini_tr.hnm : "I sing every night here at the PURPLE HAZE|. The universe's hottest nite spot|..."
        say Tina_Burner presentation=tine_tr.hnm : "Why don't you just tell me all about yourself|... Honeypoo|..."
        say Tina_Burner presentation=text_only chatter : "Commander|, you're gonna have to cool down|... Commander|!"
        say Tina_Burner presentation=ting_tr.hnm : "Going so soon|? Ohhh! Come back real soon|... My little heart just races when you're near|..." choices "bye_bye"
        say Tina_Burner presentation=tine_tr.hnm if_not_shown skip_next=2 : "Bye bye..."
        globals.E1 = 1
        end presentation Tina_Burner
    }
    global E1 = 0
