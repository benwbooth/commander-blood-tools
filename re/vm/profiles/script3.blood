        say Bug_Deluxe presentation=text_only : "YOU'LL LOVE SPENDING CREDS AT VENUSIAAAAA|..."
        say Bug_Deluxe presentation=text_only : "VENUSIA 325467 DEGREES|, 23 GALAXY B BABY1..."
        say Bug_Deluxe presentation=text_only : "CRUIK..........."
        say Bug_Deluxe presentation=text_only if_not_shown skip_next=1 : "stop"
        end presentation Bug_Deluxe
    }
    proc monop1 enabled {
        require arche.current_location == Venusia
        require presentation == Bug_Deluxe
    } then {
        say Bug_Deluxe presentation=sytr_2.hnm : "Hi there|, Consumer Comrade|. Welcome to VENUSIA SUPRAMARKET|!"
        say Bug_Deluxe presentation=sytr_6.hnm resume_at=monop2 : "wanna buy a SUPRA product from VENUSIA|?" choices "yes" "no"
        when {
            require choice == "yes"
        } then {
            monop2.enabled = true
            choice = none
        }
        when {
            require choice == "no"
        } then {
            say Bug_Deluxe presentation=sytr_8.hnm : "NO|! HA HA|!! left your creds at home or what|?"
            say Bug_Deluxe presentation=sytr_3.hnm : "Bye bye|, comrade|..."
            say Bug_Deluxe presentation=text_only if_not_shown skip_next=2 : "stop"
            choice = none
            end presentation Bug_Deluxe
        }
    }
    proc monop2 disabled {
        require arche.current_location == Venusia
        during travel
        require presentation == Bug_Deluxe
    } then {
        say Bug_Deluxe presentation=sytr_7.hnm : "You got the creds|? Everything costs creds at VENUSIA|, Consumer Comrade|..."
        when {
            require globals.PP1 == globals._2D1
            require globals.ach == globals._2D1
            require cred.holder != blood
        } then {
            say Bug_Deluxe presentation=text_only : "You don't have creds|? We don't care for poor clients|..."
            say Bug_Deluxe presentation=text_only if_not_shown skip_next=2 : "stop"
            monop2.enabled = false
            end presentation Bug_Deluxe
        }
        when {
            require globals.PP1 == 1
        } then {
            say Bug_Deluxe presentation=sytr_7.hnm : "It's your lucky day|, consumer comrade|. We're happy to offer you a FREE CRED|!!"
            say Bug_Deluxe presentation=text_only chatter resume_at=monop2_dialogue_resume_1 : "TELEPORT CRED TO ARK" choices "teleport"
            when {
                require choice == "teleport"
            } then {
                say Bug_Deluxe presentation=text_only chatter if_not_shown skip_next=1 : "TELEPORTING CRED TO ARK"
                request sequence "parf1_2.hnm"
                say Bug_Deluxe presentation=sytr_7.hnm : "Come back soon to VENUSIA|, SPACES'S LEADING SUPRA MARKET|..."
                say Bug_Deluxe presentation=text_only if_not_shown skip_next=4 : "stop"
                globals.PP1 = globals._2D1
                transfer cred from Bug_Deluxe to aboard
                choice = none
                end presentation Bug_Deluxe
            }
        }
        monop2_dialogue_resume_1:
        when {
            require cred.holder == blood
        } then {
            say Bug_Deluxe presentation=sytr_3.hnm if_not_shown skip_next=2 : "What would you care to buy|, supra comrade|?"
            timer[7] = 100
            Bug_Deluxe.topic = "department"
        }
        when {
            require timer[7] == 0
        } then {
            timer[7] = disabled
            ad2.enabled = true
        }
        when {
            require globals.ach == 1
        } then {
            say Bug_Deluxe presentation=text_only : "thank you for visiting VENUSIA the SUPRAMARKET|. Come again soon to VENUSIA|..."
            say Bug_Deluxe presentation=text_only if_not_shown skip_next=3 : "stop"
            globals.ach = globals._2D1
            monop2.enabled = false
            end presentation Bug_Deluxe
        }
    }
