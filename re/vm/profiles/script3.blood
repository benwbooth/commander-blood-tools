    proc ed3 enabled {
        during travel
        require arche.current_location == Eden
        require globals.E1 == 2
        require presentation == Tina_Burner
    } then {
        say Tina_Burner presentation=tinc_tr.hnm : "Aaaahhh! It's my manly warrior|... You came back to me|..."
        when {
            require Migrator.encounter_count > 0
        } then {
            say Tina_Burner presentation=tind_tr.hnm : "Take me with you|, stranger|... This place is dangerous for me|."
            say Tina_Burner presentation=tinf_tr.hnm : "I can't explain it but this place has bad vibes for me|... Take me with you|..."
            say Tina_Burner presentation=text_only chatter : "No|! Don't do it|, Commander|... It wouldn't be good for the Ark|... Commander|! Cap'n Bob's gonna be mad at you|..."
            say Tina_Burner presentation=text_only resume_at=ed3_dialogue_resume_1 : "TELEPORT TINA BURNER TO CRYOBOX:" choices "TELEPORT" "REFUSE"
            when {
