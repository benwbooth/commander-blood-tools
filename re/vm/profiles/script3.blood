    proc yok1 disabled {
        during travel
        require arche.current_location == Rondo
        require presentation == Yoko
        require globals.H1 == 0
    } then {
        Yoko.topic = "rien"
        say Yoko presentation=yok02.hnm : "Ah! You there|, Commander|. Me scared|... CRY CRY"
        say Yoko presentation=yok03.hnm : "Father Maxxon be kidnapped|. Them want big ransom|... CRY|... CRY|..."
        say Yoko presentation=yok04.hnm : "Me not can pay|... CRY|..."
        say Yoko presentation=text_only chatter : "Holy headaches|! Commander, you gotta do something|..."
        when {
            require Yoko.encounter_count == 1
        } then {
            say Yoko presentation=yok04.hnm : "Me think kidnapper be Croolis|..."
            say Yoko presentation=yok05.hnm : "Croolis EVISCERATOR did escape jail on planet Mastachok|... Him be mean|..."
        }
        say Yoko presentation=yok06.hnm : "Me scared|, Commander|..."
        when {
            require Morning_Oil.current_location != aboard
            require receiver.current_location != aboard
        } then {
            say Yoko presentation=yok03.hnm : "Me afraid Commander..."
            say Yoko presentation=yok06.hnm : "You go fast..."
            say Yoko presentation=yok01.hnm if_not_shown skip_next=1 : "Bye bye.."
            end presentation Yoko
        }
        when {
            require Morning_Oil.current_location == aboard
            require receiver.current_location == aboard
        } then {
            say Yoko presentation=text_only chatter : "We can't leave him alone|, Commander|... Morning_Oil could protect him|..."
            say Yoko presentation=text_only chatter : "How about teleporting Morning to the planet Rondo|?"
            say Yoko presentation=text_only resume_at=yok1_dialogue_resume_1 : "TELEPORT MORNING OIL TO PLANET RONDO" choices "teleport" "refuse"
            when {
                require choice == "teleport"
            } then {
                say Yoko presentation=text_only if_not_shown skip_next=2 : "TELEPORTING MORNING OIL TO PLANET RONDO"
                Morning_Oil.current_location = observatory
                choice = none
            }
            when {
                require choice == "refuse"
            } then {
                say Yoko presentation=text_only chatter : "You're running the show|, Commander|..."
                say Yoko presentation=yok06.hnm : "You not leave me alone|, friend Commander... CRY CRY|... Me scared|..."
                say Yoko presentation=text_only if_not_shown skip_next=2 : "..."
                choice = none
                end presentation Yoko
            }
        }
        yok1_dialogue_resume_1:
        when {
            require Morning_Oil.current_location == observatory
        } then {
            say Yoko presentation=yok11.hnm : "Thank you Commander|... You nice|..."
            say Yoko presentation=text_only chatter if_not_shown skip_next=2 : "Commander, let's go check out the observatory|..."
            yok1.enabled = false
            navigate to observatory
        }
    }
