            say Amigo presentation=amid_tr.hnm : "Life ain't easy|, stranger|..." choices "prison"
            say Amigo presentation=amic_tr.hnm : "BA LA GAR LA GA BAR... You can speak KRWITT|! You're an educated guy|, stranger|..." choices "Galabar"
            say Amigo presentation=amid_tr.hnm : "I picked up a few words of KRWITT on GOLGOS|, while I was doing my barman studies|..." choices "Galabar"
            say Amigo presentation=amic_tr.hnm : "My first wife GALA spoke fluent KRWITT|. Her father came from GLUXXTAN" choices "Galabar"
            say Amigo presentation=amicg_tr.hnm : "GALA was very sensual|. She got cut up by a migrax|... Tough|..." choices "Galabar"
            say Amigo presentation=amicg_tr.hnm : "I'm obsessed with meteorut|, stranger...." choices "meteorut"
        }
        case "meteorut" continues {
            menu "bye_bye" "talk" "acidium" "nitrium" "glycérium"
            say Amigo presentation=amid_tr.hnm : "When I start to itch right there|... I know the fever's coming|... I tried Aspirox|, but it didn't help|..." choices "meteorut"
            say Amigo presentation=amibg_tr.hnm : "The only thing that works against meterorut is acidium|, stranger|..." choices "acidium"
            say Amigo presentation=amicg_tr.hnm : "My first wife|, GALA, could cure meteorut without acidium. She used white hot blades|..." choices "acidium"
            say Amigo presentation=amibg_tr.hnm : "Nitrium is dangerous if you mix it with glycerium|..." choices "nitrium"
            say Amigo presentation=amib_tr.hnm : "Glycerium is real dangerous when you mix it with nitrium|..." choices "glycerium"
        }
        case "acidium" continues {
            menu "bye_bye" "talk" "pentium"
            say Amigo presentation=amibg_tr.hnm : "Pentium is a mixture of glycerium|, nitrium and processed Trump liver" choices "pentium"
        }
        case "pentium" {
            menu "bye_bye" "talk" "splatch"
            say Amigo presentation=amic_tr.hnm : "Splatch is a mixture of pentium|, acidium and processed murffalo liver" choices "splatch"
            say Amigo presentation=amibg_tr.hnm : "You want splatch|? Why didn't you say so|?" choices "splatch"
            say Amigo presentation=amib_tr.hnm if_not_shown skip_next=1 : "I happen to have some|..." choices "splatch"
            globals.secret = 1
            yield
        }
    }

    selector Super_Zen_choices {
        case "talk" {
            menu "hello"
            say Super_Zen presentation=zen01.hnm : "hello commander" choices "hello"
            halt
        }
    }
}
