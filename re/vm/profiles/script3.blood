    selector Bronko_choices {
        case "talk" continues {
            menu "bye_bye" "robot" "cred" "murffalos" "weapons"
        }
        case "robot" continues {
            menu "talk" "bye_bye" "robot" "intelligence" "energy" "technology" "retirement"
            say Bronko presentation=rgbtr3.hnm : "Me robot Bronko AX34 BUTCHER model|..." choices "robot"
            say Bronko presentation=rgbtr4.hnm : "Robots be strong|, friend|. Robot Bronko know chop meat|..." choices "robot"
            say Bronko presentation=rgbtr2.hnm repeatable : "Me sophisticated robot|..." choices "robot"
            say Bronko presentation=rgbtr2.hnm : "Me big cybernetic intelligence|. much cheap memory|..." choices "intelligence"
            say Bronko presentation=rgbtr3.hnm : "Me can think|. Me be smart|..." choices "intelligence"
            say Bronko presentation=rgbtr4.hnm : "Me have big CDROM in head|... Ha|! Ha|! Ha|! Ha|!" choices "intelligence"
            say Bronko presentation=rgbtr3.hnm repeatable : "Bronko intelligent|..." choices "intelligence"
            say Bronko presentation=rgbtr5.hnm : "Me have energy|. Me have brand new batteries|, friend|...." choices "energy"
            say Bronko presentation=rgbtr6.hnm : "Me like zinc flakes in cold mercury for breakfast|, friend|. Much energy|..." choices "energy"
            say Bronko presentation=rgbtr2.hnm : "You want batteries|, friend|... Me buy batteries at VENUSIA supramarket" choices "energy"
            say Bronko presentation=rgbtr5.hnm : "Supramarket VENUSIA sell cheap batteries|. You not see TV commercial|?" choices "energy"
            say Bronko presentation=rgbtr2.hnm repeatable : "Bronko advanced technology|, friend|..." choices "technology"
            say Bronko presentation=rgbtr6.hnm : "See you soon|, friend|..." choices "bye_bye"
        }
        case "cred" continues {
            menu "talk" "bye_bye" "cred" "buy"
            say Bronko presentation=rgbtr2.hnm : "Me work much earn CRED|, friend|..." choices "cred"
            say Bronko presentation=rgbtr3.hnm : "Creds be hard to earn|..." choices "cred"
            say Bronko presentation=rgbtr4.hnm repeatable : "You like creds|, friend|..." choices "cred"
            say Bronko presentation=rgbtr5.hnm : "Me want buy big ship|, take big vacation in universe|..." choices "buy"
            say Bronko presentation=rgbtr4.hnm : "Me want buy home on planet Troma, and grow nuts|, bolts|, screws|..." choices "buy"
            say Bronko presentation=rgbtr3.hnm : "Me want raise cybernetic wheelbarrows|, lawnmowers|... Me dream|, friend|..." choices "buy"
            say Bronko presentation=rgbtr5.hnm repeatable : "To can buy|, me must work much|..." choices "buy"
        }
        case "murffalos" continues {
            menu "talk" "bye_bye" "hunt"
            say Bronko presentation=rgbtr2.hnm : "Thirteen murffalos to reproduce... One in middle|, twelve around|..." choices "murffalos"
            say Bronko presentation=rgbtr3.hnm : "Me not like murffalos|... Not nice|. Too soft|... Me like fried lawnmower leg|..." choices "murffalos"
            say Bronko presentation=rgbtr4.hnm repeatable : "Me know how chop murffalos|..." choices "murffalos"
            say Bronko presentation=rgbtr5.hnm : "Me like hunt satellite game with laserpulper|... bang bang satellites|..." choices "hunt"
            say Bronko presentation=rgbtr4.hnm repeatable : "Hunting be nice sport..." choices "hunt"
        }
        case "weapons" continues {
            menu "talk" "bye_bye" "planets" "war"
            say Bronko presentation=rgbtr5.hnm : "Nice weapons cost much creds|, Commander" choices "weapons"
            say Bronko presentation=rgbtr3.hnm repeatable : "Me have weapons at end of arms|..." choices "weapons"
            say Bronko presentation=rgbtr3.hnm repeatable : "You big traveller|. You know planets|, friend|..." choices "planets"
            say Bronko presentation=rgbtr4.hnm : "Croolis war make big mess|... Bad war|, friend|..." choices "war"
        }
        case "retirement" {
            menu "talk" "bye_bye" "Magnus"
            say Bronko presentation=rgbtr2.hnm repeatable if_not_shown skip_next=1 : "Ah|, retirement|... them send me to planet Magnus with other old robots|... CRY CRY|..." choices "retirement"
            Magnus.known = true
            yield
        }
    }

    selector Bob_Morlock_choices {
        case "talk" continues {
            menu "bye_bye" "black_hole" "big_bang" "Bob_Morlock" "kanary" "mission" "corpo" "good_ol_bob"
            say Bob_Morlock presentation=bobc.hnm chance=20% : "What do you want to know|, Commander|?" choices "talk"
            say Bob_Morlock presentation=bobd.hnm if_not_shown skip_next=1 : "Goodbye|, Commander|..." choices "bye_bye"
            globals.adieu = 1
            say Bob_Morlock presentation=bobc.hnm : "After years of research|, I managed to isolate time|, Commander" choices "black_hole"
            say Bob_Morlock presentation=bobb.hnm : "Certain black holes can be used to go back in time|." choices "black_hole"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Honk is programmed to recognize the right black holes" choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "To reach the BIG BANG, you'll need to travel through several black holes|..." choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "Black holes are marvellous natural machines|, Commander|..." choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobd.hnm : "I have spent my life in pursuit of truth|, Commander|..." choices "big_bang"
            say Bob_Morlock presentation=bobc.hnm : "I know that truth lies beyond the BIG BANG|, Commander|!" choices "big_bang"
            say Bob_Morlock presentation=bobb.hnm repeatable : "My memory is not what it was|..." choices "big_bang"
            say Bob_Morlock presentation=bobc.hnm : "Thanks to the KANARY scientists|, I am the oldest being in the UNIVERSE" choices "Bob_Morlock"
            say Bob_Morlock presentation=bobb.hnm : "In my time|, I've been a crooner|, a magician|, an adventurer|. I also created the biggest company in the universe|: KANARY" choices "Bob_Morlock"
            say Bob_Morlock presentation=bobc.hnm : "Women have adored me|. Thousands of generations have admired me|. I am immortal" choices "Bob_Morlock"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Commander|, you will relive my past|. I envy you|..." choices "Bob_Morlock"
            dictionary blank after "relive"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "Ah|... Otto Von Smile|, Eviscerator, Jeph d'Ulikan, old Yolk, Tina Burner|... And the others|..." choices "Bob_Morlock"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm repeatable if_not_shown skip_next=1 : "Ah|! Those were good days|, Commander..." choices "Bob_Morlock"
            offer topic "revelation"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "You want some revelations|, Commander" choices "revelation"
            globals.reve = 1
            say Bob_Morlock presentation=bobc.hnm : "Your mission is to find and travel through the right black holes, taking us back in time to the BIG BANG" choices "mission"
            say Bob_Morlock presentation=bobb.hnm : "You will meet fabulous beings|, many of them dangerous|. You'll need to be careful|, Commander" choices "mission"
            say Bob_Morlock presentation=bobc.hnm : "You will see terrible wars and cross impossible frontiers|..." choices "mission"
            say Bob_Morlock presentation=bobb.hnm : "You will have to win strange beings to your cause|..." choices "mission"
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "You will be in sole commander|, unless you decide to wake me|..." choices "mission"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm : "The planet Corpo is my world of origin|. It is where we come from|..." choices "corpo"
            say Bob_Morlock presentation=bobd.hnm repeatable if_not_shown skip_next=1 : "Corpo is a fabulous planet with inexhaustible resources|." choices "corpo"
            Bob_Morlock.aggressiveness += 2
            say Bob_Morlock presentation=bobc.hnm : "Truth is to be found at the creation of the universe|, just before the BIG BANG|..." choices "truth"
            say Bob_Morlock presentation=bobb.hnm repeatable if_not_shown skip_next=1 : "Ah|... Truth|!" choices "truth"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "I'm getting pictures from the Ark|, Commander. All systems are nominal|..." choices "good_ol_Bob"
            request sequence "aarche10.hnm"
            say Bob_Morlock presentation=bobb.hnm : "You flatter me|, Commander..." choices "good_ol_bob"
            say Bob_Morlock presentation=bobc.hnm chance=20% if_not_shown skip_next=1 : "You're embarrassing me|, Commander..." choices "good_ol_bob"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm repeatable chance=20% : "Heh heh|..." choices "good_ol_bob"
        }
        case "kanary" {
            menu "talk" "bye_bye" "cottage" "clones" "employees" "reports"
            say Bob_Morlock presentation=bobb.hnm : "The Cottage Research department is my secret project" choices "cottage"
            say Bob_Morlock presentation=bobb.hnm : "The domain of vegetation is a marvel of Nature" choices "cottage"
            say Bob_Morlock presentation=bobb.hnm : "The Cottage Research department develops genetic marvels" choices "cottage"
            dictionary blank after "develops"
            say Bob_Morlock presentation=bobd.hnm : "The Kanary lawns mow themselves every weekend|..." choices "cottage"
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "Kanary's artificial orchids provide whiskey that is over a hundred years in age" choices "cottage"
            Bob_Morlock.aggressiveness += 5
            say Bob_Morlock presentation=bobb.hnm : "Kanary has developed technology entirely devoted to synthetic cloning" choices "clones"
            say Bob_Morlock presentation=bobc.hnm : "Kanary's four million employees were all created by and for Kanary" choices "clones"
            say Bob_Morlock presentation=bobb.hnm : "I am the last bionatural being and I CONTROL EVERYTHING|..." choices "clones"
            say Bob_Morlock presentation=bobb.hnm : "My employees wake me up for ten minutes each year to blow out the candles on my birthday cake and sign the company reports" choices "clones"
            say Bob_Morlock presentation=bobb.hnm repeatable if_not_shown skip_next=1 : "I instructed the Kanary scientists to develop the perfect adventurer to take me to the BIG BANG|..." choices "clones"
            Bob_Morlock.aggressiveness += 3
            say Bob_Morlock presentation=bobd.hnm : "All Kanary personnel was made by CLONE CONSORTIUM|. So were you|, Commander" choices "employees"
            say Bob_Morlock presentation=bobe.hnm : "All of you work for me|: YOU Honk|, YOU Commander|, YOU Olga|... ALL OF YOU|..." choices "employees"
            say Bob_Morlock presentation=bobf.hnm repeatable if_not_shown skip_next=1 : "Kanary builds the cheapest and best employees in the universe|..." choices "employees"
            globals.emplo = 1
            say Bob_Morlock presentation=bobb.hnm chance=20% : "Kanary is the biggest company in the known universe" choices "kanary"
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "Kanary invents|, builds, consumes and controls the universe" choices "kanary"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobd.hnm : "Kanary is so efficient that its products have a negative production cost" choices "reports"
            say Bob_Morlock presentation=bobc.hnm : "A cottage costs 100990 Negabucks..." choices "reports"
            say Bob_Morlock presentation=bobf.hnm : "Our profits are so enormous that nobody can say the figure within a normal life span" choices "reports"
            say Bob_Morlock presentation=bobg.hnm repeatable if_not_shown skip_next=1 : "Our only competitor is called CRYO. They control the Second World" choices "reports"
            Bob_Morlock.aggressiveness += 2
            yield
        }
    }

