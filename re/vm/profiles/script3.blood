            when {
                require choice == "REFUSE"
            } then {
                say Tina_Burner presentation=text_only chatter : "Smart thinking|, Commander|!!!"
                say Tina_Burner presentation=tind_tr.hnm : "What|!!! You refuse to take me with you|!!! You dirty son of a Croolas|..."
                say Tina_Burner presentation=tinc_tr.hnm : "Get out of here|!!! CRY CRY"
                say Tina_Burner presentation=ting_tr.hnm : "CRY|... SNIFF|... CRY CRY|... HOT TEARS|..."
                say Tina_Burner presentation=ting_tr.hnm : "SNIFF|... CRY CRY|... HOT TEARS|..."
                say Tina_Burner presentation=text_only chatter : "Maybe we should have said yes|, Commander|... She's taking it badly|..."
                say Tina_Burner presentation=text_only if_not_shown skip_next=2 : "..."
