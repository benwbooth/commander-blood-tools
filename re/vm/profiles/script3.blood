logic {
    proc INIT2 enabled {
    } then {
        Moskito.known = true
        Corpo.known = true
        decoder.holder = aboard
        Venusia.known = true
        Magnus.known = true
        Rondo.known = true
        Ekatomb.known = true
        Erazor.known = true
        Kortex.known = true
        Mastachok.known = true
        Bug_Deluxe.known = true
        Emasculator.active = true
        Migrator.active = true
        Emasculator.current_location = usine
        Bob_Morlock.current_location = aboard
        Bronko.current_location = aboard
        Morning_Oil.current_location = Ark
        Yoko.current_location = Trashlando
        Jerry_Khan.current_location = Trashlando
        Maxxon.current_location = Trashlando
        Izwalito.current_location = Trashlando
        Hom.current_location = Kortex
        Otto_Von_Smile.current_location = Trashlando
        globals.compris = 1
        globals.vbio = 3
        sequence_slots[1] = "microkid"
        sequence_slots[2] = "ppit"
        sequence_slots[3] = "hatetv"
        sequence_slots[4] = "venus"
        sequence_slots[5] = "scrut"
        sequence_slots[6] = "match"
        Anna_Haf.current_location = Magnus
        INIT2.enabled = false
    }
    global compris = 0
    global vbio = 0
    proc scrujo enabled {
        during contact
        require presentation == Scruter_Jo
    } then {
        say Scruter_Jo presentation=scr20.hnm : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
        when {
            require globals.compris == 0
        } then {
            say Scruter_Jo presentation=text_only : "Me explain to you how get BIONIUM..."
            say Scruter_Jo presentation=text_only : "You find BIOXX|. Bioxx be small energy creatures|..."
            say Scruter_Jo presentation=scr02.hnm : "You touch BIOXX once with hand|."
            say Scruter_Jo presentation=text_only chatter : "Sounds like a piece of cake to me|, Commander|!!"
            say Scruter_Jo presentation=scr03.hnm : "If you touch BIOXX twice|, you CAPTURE BIOXX on tip of your finger|..."
            say Scruter_Jo presentation=text_only chatter : "Catch him on the tip of your finger|!!! Sounds easy as pie|, Commander|..."
            dictionary blank after "Catch"
            say Scruter_Jo presentation=scr04.hnm : "Then you can carry BIOXX to cybernetic MANTAS"
            say Scruter_Jo presentation=scr06.hnm : "You place BIOXX in belly of Manta..."
            say Scruter_Jo presentation=scr05.hnm : "BIOXX stay stuck to MANTAS..."
            say Scruter_Jo presentation=text_only chatter : "I'd love to see that|..."
            say Scruter_Jo presentation=scr07.hnm : "Mantas change BIOXX into BIONIUM..."
            say Scruter_Jo presentation=scr06.hnm : "More BIOXX you give to Mantas, more BIONIUM you get|..."
            say Scruter_Jo presentation=text_only chatter : "Yes|!!! BIONIUM|... I can taste it already|..."
            say Scruter_Jo presentation=scr05.hnm : "To come back from CYBERSPACE|, you touch BLUE BOX|...."
            say Scruter_Jo presentation=scr07.hnm : "You understand|?"
            say Scruter_Jo presentation=text_only chatter : "We understand perfectly|, Mister SCRUTER JO... Right|, Commander?"
        }
        say Scruter_Jo presentation=scr21.hnm : "YOU go|, Commander|..."
        say Scruter_Jo presentation=scr22.hnm : "Ahh! Me feel better|..."
        when {
            require globals.vbio > 0
        } then {
            say Scruter_Jo presentation=scr03.hnm : "Good work|... You did succeed|..."
            say Scruter_Jo presentation=scr04.hnm : "You did get BIONIUM..."
            say Scruter_Jo presentation=text_only chatter : "YES|!!! Commander|, remind me to tell you you're a champ|..."
            say Scruter_Jo presentation=text_only chatter : "This BIONIUM is extraordinary|. My clock frequency's through the roof|..."
            say Scruter_Jo presentation=text_only chatter if_not_shown skip_next=1 : "I feel even smarter|... I can feel I'll be a great help to you|, Commander|..."
            globals.compris = 1
        }
        when {
            require globals.vbio == 0
        } then {
            say Scruter_Jo presentation=scr05.hnm : "Not good|, friend|... You fail|..."
            say Scruter_Jo presentation=text_only chatter : "Commander, you didn't understand the technique|..."
            say Scruter_Jo presentation=text_only chatter : "I need BIONIUM, Commander|. It makes me smarter|..."
            say Scruter_Jo presentation=scr05.hnm : "Ha! Ha! You need much much BIONIUM|. Ha! Ha!..."
            say Scruter_Jo presentation=text_only chatter : "Why don't you shut up|, wiseguy|!!!"
        }
        say Scruter_Jo presentation=scr08.hnm if_not_shown skip_next=1 : "Bye bye|, Commander|. Me return to CYBERSPACE..."
        end presentation Scruter_Jo
    }
    proc clay1 enabled {
        during travel
        require arche.current_location == Magnus
        require Anna_Haf.encounter_count == 1
    } then {
        say Anna_Haf presentation=cltr10_3.hnm : "..."
        say Anna_Haf presentation=text_only chatter : "Another broken-down robot|, Commander|... This planet's a gold mine|..."
        say Anna_Haf presentation=text_only chatter : "Let's teleport it|, Commander|. You never know when these things can come in handy|..."
        say Anna_Haf presentation=text_only resume_at=clay2 : "TELEPORT ROBOT TO ARK|..." choices "teleport"
        when {
            require choice == "teleport"
        } then {
            say Anna_Haf presentation=text_only if_not_shown skip_next=3 : "TELEPORTING ROBOT TO CRYOBOX"
            Anna_Haf.current_location = aboard
            choice = none
            end presentation Anna_Haf
        }
    }
    proc clay2 enabled {
        during contact
        require presentation == Anna_Haf
    } then {
        say Anna_Haf presentation=text_only chatter : "Commander|, this is one tough repair job|..."
        say Anna_Haf presentation=text_only if_not_shown skip_next=1 : "stop"
        end presentation Anna_Haf
    }
    proc got enabled {
        require Eviscerator.current_location != prison
    } then {
        Izwalito.current_location = Hito
    }
    proc corpo1 enabled {
        during travel
        require globals.A1 == 0
        require arche.current_location == Corpo
        require presentation == Izwalito
    } then {
        say Izwalito presentation=iswb.hnm : "Izwalito happy to see you back|, friend|..."
        say Izwalito presentation=iswa1.hnm : "You know bad news|?"
        say Izwalito presentation=iswc.hnm : "Father of Yoko|, Maxxon|, be kidnapped|..."
        say Izwalito presentation=iswb.hnm : "Kidnappers want big ransom|, much CREDs|..."
        say Izwalito presentation=iswe.hnm : "Me scared|, friend|. Me very worried|. Me hide|..."
        say Izwalito presentation=iswf.hnm : "You must help Yoko|... friend Commander|..."
        say Izwalito presentation=iswb.hnm : "Me think kidnapper be Croolis escaped from Mastachok jail|..."
        say Izwalito presentation=iswd.hnm : "Me hide|... FEAR|... FEAR|..."
        say Izwalito presentation=iswe.hnm if_not_shown skip_next=3 : "Bye bye|..."
        Izwalito.current_location = Trashlando
        end presentation Izwalito
    }
    global A1 = 0
    proc t10 enabled {
        require Tina_Burner.encounter_count == 1
    } then {
        timer[10] = 200
        t10.enabled = false
    }
    proc krapp enabled {
        require timer[10] == 0
    } then {
        queue presentation Kran_Dobu
        krapp.enabled = false
    }
    proc krapp1 enabled {
        during bridge
        require presentation == Kran_Dobu
    } then {
        say Kran_Dobu presentation=text_only : "This is Kran Dobu|, Space Knight|..."
        say Kran_Dobu presentation=text_only : "Radio message to Ark|... Ha! Ha! I bet my Kraner IV flies faster than your clunker|..."
        dictionary blank after "Radio"
        say Kran_Dobu presentation=text_only : "Ha! Ha! Ha! Let's meet up at point X337 Y242|..."
        say Kran_Dobu presentation=text_only chatter : "I have a fix on his ship|, Commander|..."
        say Kran_Dobu presentation=text_only : "Got the guts to race me|?|... Ha! Ha! Ha!|... I'm waiting|..."
        say Kran_Dobu presentation=text_only chatter : "Commander|, I suggest we ignore him|..."
        say Kran_Dobu presentation=text_only : "Chicken|, huh|?|... Ha! Ha! Ha!"
        say Kran_Dobu presentation=text_only if_not_shown skip_next=3 : "Bye bye"
        krapp1.enabled = false
        mark Kraner as known
        end presentation Kran_Dobu
    }
    proc kra enabled {
        during travel
        require presentation == Kran_Dobu
    } then {
        say Kran_Dobu presentation=khran1_3.hnm : "Ha! Ha! Ha!"
        say Kran_Dobu presentation=khran2_1.hnm : "What a heap of reject junk|... You mean that thing actually flies|? Ha! Ha! Ha!"
        say Kran_Dobu presentation=khran2_2.hnm : "You're not afraid|..."
        say Kran_Dobu presentation=khran1_2.hnm@2 : "Okay|, no more kidding|... Let's race|... The first who gets to|, uh|... Let's see|..."
        say Kran_Dobu presentation=khran2_3.hnm : "To planet Troma|! Ha! Ha! Ha!"
        say Kran_Dobu presentation=khran3_1.hnm : "You have the coordinates|... Planet Troma is in the TROMUS constellation x432|, Y654|..."
        say Kran_Dobu presentation=text_only chatter : "Commander|, he's gonna get trashed|... There's no way he can match our suction turbos|..."
        say Kran_Dobu presentation=khran1_2.hnm : "If you win|, I'll give you my bionic guitar|... If I win|, you'll give me something|..."
        say Kran_Dobu presentation=khran3_2.hnm : "On your marks|, guy|..."
        say Kran_Dobu presentation=khran3_2.hnm : "Ready"
        say Kran_Dobu presentation=khran3_2.hnm : "Set"
        say Kran_Dobu presentation=khran3_2.hnm if_not_shown skip_next=2 : "GO|..."
        Kraner.position = (10, 10)
        request sequence "krando20.hnm"
        say Kran_Dobu presentation=khran1_3.hnm if_not_shown skip_next=4 : "See you round|, comrade|..."
        mark Kraner as unknown
        mark Troma as known
        kra.enabled = false
        end presentation Kran_Dobu
    }
    proc kra1 enabled {
        require arche.current_location == Troma
    } then {
        timer[11] = 100
        kra1.enabled = false
    }
    proc kra1bis enabled {
        require timer[11] == 0
    } then {
        queue presentation Kran_Dobu
        kra2.enabled = true
        kra1bis.enabled = false
    }
    proc kra2 disabled {
        during bridge
        require presentation == Kran_Dobu
    } then {
        say Kran_Dobu presentation=text_only : "Ti ti ti|, ta ta ta|, ti ti ti|..."
        say Kran_Dobu presentation=text_only : "Ti ti ti|, ta ta ta|, ti ti ti|..."
        say Kran_Dobu presentation=text_only chatter : "Commander|, Commander|! It's an SOS|, a distress call|..."
        say Kran_Dobu presentation=text_only : "S|... O|... S|... THIS IS KRANER|... IN TROUBLE|... BIG BREAKDOWN|..."
        dictionary blank after "IN"
        say Kran_Dobu presentation=text_only if_not_shown skip_next=1 : "POSITION X765 Y234|... BREAKDOWN|... S|... O|... S|..."
        Kraner.known = true
        say Kran_Dobu presentation=text_only chatter : "Commander|, it sounds like a breakdown|... We'd better help him|..."
        say Kran_Dobu presentation=text_only if_not_shown skip_next=1 : "KRUIIIK|..."
        request sequence "krando20.hnm"
