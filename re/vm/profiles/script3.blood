    proc hom1 enabled {
        during travel
        require dork.holder != blood
        require arche.current_location == Kortex
        require globals.G1 == 0
        require presentation == Hom
    } then {
        Hom.topic = "rien"
        say Hom presentation=homm_03.hnm : "Welcome|, stranger|..."
        say Hom presentation=homm_04.hnm : "You be great traveller|..."
        when {
            require Hom.encounter_count == 1
        } then {
            say Hom presentation=text_only chatter : "WOWEE|!! Commander, he's even uglier than ol' Turkeyface Bob|... Ha|! Ha|! Ha|!"
            say Hom presentation=homm_03.hnm : "Me HOM|. Me big tube brain|. Me delighted receive you|, Commander|..."
            say Hom presentation=homm_03.hnm : "Me catch your print|, friend|... Me read TRUTH in print|..."
            say Hom presentation=homm_04.hnm resume_at=hom1_dialogue_resume_1 : "You click hard|, friend|. Me catch your print on mouse button|..." choices "click" "refuse"
            when {
                require choice == "click"
            } then {
                say Hom presentation=homm_04.hnm if_not_shown skip_next=1 : "You not click hard enough|..."
                choice = none
            }
            when {
                require choice == "refuse"
            } then {
                say Hom presentation=homm_05.hnm : "You refuse|... Me not like that|... Me suspect you|..."
                say Hom presentation=homm_06.hnm : "Bye bye|... Me not like you refuse|..."
                say Hom presentation=homm_03.hnm if_not_shown skip_next=2 : "..."
                choice = none
                end presentation Hom
            }
        }
        hom1_dialogue_resume_1:
        say Hom presentation=homm_04.hnm resume_at=hom1_dialogue_resume_2 : "You click very very hard|, friend|. Me catch print on mouse|..." choices "click"
        when {
            require choice == "click"
        } then {
            say Hom presentation=homm_04.hnm if_not_shown skip_next=2 : "Ahh|! Me catch print|... Ohh|, you nice print|..."
            request sequence "scandoig.hnm"
            choice = none
        }
        hom1_dialogue_resume_2:
        say Hom presentation=homm_07.hnm if_not_shown skip_next=1 : "Ooooouh! Me see you|, friend|... You have pretty box with picture of Hom inside|..."
        request sequence "kort.hnm"
        say Hom presentation=homm_08.hnm : "Me read prints|. You have little mouse in hand with long long tail|..."
        say Hom presentation=homm_09.hnm : "Me see keyboard|... And oh|! CDROM double speed|. Nice hard disk|... You be lucky|, friend|..."
        say Hom presentation=homm_05.hnm : "Welcome to my planet|, stranger|..."
        say Hom presentation=homm_10.hnm : "You help my Izwal friends from planet Corpo|. You be nice|... You must join GUILD OF MEMBERS"
        say Hom presentation=homm_11.hnm : "GUILD OF MEMBERS be big cybernetic organization|..."
        say Hom presentation=homm_04.hnm : "To be in GUILD OF MEMBERS you must be initiated|..."
        say Hom presentation=homm_06.hnm : "You know universe|. You must take exam|..."
        say Hom presentation=homm_05.hnm : "You go to planet CYBEROCK where be cyber university|..."
        say Hom presentation=homm_05.hnm : "You take cyber studies|, friend|..."
        say Hom presentation=homm_03.hnm : "And you take cyber exam to be D.O.R.K.|, Doctor of Rare Knowledge|..."
        say Hom presentation=homm_06.hnm if_not_shown skip_next=1 : "Cyberock be in Cyberius system|, coordinates X234 Y546|..."
        dictionary blank after "Cyberock"
        mark Cyberock as known
        say Hom presentation=text_only chatter : "And one more planet to visit|! We're going places|..."
        say Hom presentation=homm_07.hnm : "Me wait for you with D.O.R.K. Doctor of Rare Knowledge diploma|..."
        say Hom presentation=text_only if_not_shown skip_next=2 : "Bye bye|, friend|..."
        globals.G1 = 1
        end presentation Hom
    }
