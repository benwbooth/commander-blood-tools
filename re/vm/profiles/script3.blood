    export label "fin4"
    proc boba1 enabled {
        during contact
        require presentation == Bob_Morlock
    } then {
        say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "..."
        timer[1] = 30
        when {
            require timer[1] == 0
        } then {
            say Bob_Morlock presentation=bobg.hnm : "I don't feel at all well|, Commander|..."
            say Bob_Morlock presentation=bobd.hnm : "Ahhhh|!!!"
            say Bob_Morlock presentation=text_only if_not_shown skip_next=2 : "stop"
            timer[1] = disabled
            end presentation Bob_Morlock
        }
        say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "I feel so weak|..." choices "bye_bye"
        globals.adieu = 1
        when {
            require globals.adieu == 1
        } then {
            say Bob_Morlock presentation=text_only chatter : "..."
            say Bob_Morlock presentation=text_only if_not_shown skip_next=3 : "stop"
            globals.adieu = 0
            timer[1] = disabled
            end presentation Bob_Morlock
        }
    }
    global adieu = 0
    proc augmen enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.emplo == 1
        require globals.emp == 0
    } then {
        say Bob_Morlock presentation=text_only chatter : "By the way|, Cap'n Bob sir|, there's something I wanted to talk to you about|..."
        say Bob_Morlock presentation=text_only chatter : "Ginette and I would like a raise|... Even a few megawatts would be appreciated|..."
        say Bob_Morlock presentation=bobf.hnm : "WHAT|? SPEAK LOUDER|... I'M GETTING A LITTLE DEAF COMMANDER|..."
        say Bob_Morlock presentation=text_only chatter : "WE WANT A RAISE|!!!"
        say Bob_Morlock presentation=bobe.hnm : "I don't feel at all well|, Commander|. Aaah|!!! It's my heart|...."
        say Bob_Morlock presentation=text_only chatter if_not_shown skip_next=1 : "Heart|... He means his generator|... They're all the same|, as soon as you mention a couple of lousy megawatts|..."
        globals.emp = 1
    }
    global emplo = 0
    global emp = 0
    proc revel enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.reve == 1
        require globals.revelat == 0
    } then {
        say Bob_Morlock presentation=bobh.hnm : "You want to know an unbearable truth, Commander|?"
        say Bob_Morlock presentation=bobg.hnm : "HONK|! Switch yourself off for ten seconds|!!!"
        say Bob_Morlock presentation=text_only chatter : "Bu|... But Cap'n Bob|... I|..."
        say Bob_Morlock presentation=bobf.hnm : "SWITCH OFF I SAID|!!!"
        say Bob_Morlock presentation=text_only chatter : "Okay sir|....."
        say Bob_Morlock presentation=text_only chatter : "KRUIIIIK|!!! AAAaaaaaaaaaaaaaaaaaaaaa|!!!"
        say Bob_Morlock presentation=bobf.hnm : "COMMANDER, YOU ARE ME|...."
        say Bob_Morlock presentation=bobg.hnm : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES|..."
        say Bob_Morlock presentation=bobe.hnm : "YOU ARE MUCH MORE THAN A SON TO ME|..."
        say Bob_Morlock presentation=bobf.hnm : "We're the same person|... I am the first being to create himself"
        say Bob_Morlock presentation=bobe.hnm : "And who can study himself when he was younger|, all thanks to space and time|. YOU ARE BOB|, COMMANDER|..."
        say Bob_Morlock presentation=bobc.hnm : "I am who you'll become in a few hundred thousand years|..."
        say Bob_Morlock presentation=bobg.hnm : "OK Honk|, We've finished|..."
        say Bob_Morlock presentation=text_only chatter : "KROIIIIkkk|!!! -&KRUIIIIkkk|!!! I ought to be aware of everything that goes on here|. I AM the onboard computer, aren't I|?|... You didn't switch off Olga I hope"
        say Bob_Morlock presentation=bobf.hnm if_not_shown skip_next=2 : "Can it and get to work|!!!|..."
        globals.revelat = 1
        globals.reve = 0
        halt
    }
    global reve = 0
    global revelat = 0
    global viol = 0
    global caches = 0
}

conversations {
    yield

    selector Beauregard_choices {
        case "ill" continues {
            menu "bye_bye" "listen" "insist" "treat"
            say Beauregard presentation=hboc.hnm repeatable : "Aaaah|... Eeeerrr..." choices "listen"
            say Beauregard presentation=hbod.hnm : "Aaaa|! Snakes alive|..." choices "bye_bye"
            say Beauregard presentation=hboe.hnm : "I got baked by Gladis|..." choices "insist"
            say Beauregard presentation=text_only chatter if_not_shown skip_next=1 : "That's criminal|! Commander, we have to find this Gladis and make sure she never bakes anyone again|..." choices "insist"
            offer topic "gladis"
            say Beauregard presentation=hbof.hnm if_not_shown skip_next=1 : "Gladis is the Tumul system's sun|. It blew up|..." choices "gladis"
            offer topic "gladis"
            say Beauregard presentation=hbog.hnm if_not_shown skip_next=1 : "Gladis killed everything|. It's a miracle I'm alive|... Aaarr.." choices "insist"
            offer topic "gladis"
            say Beauregard presentation=hboh.hnm : "My body's burned to a cinder|... I need a new body bad|... Friend|..." choices "treat"
            say Beauregard presentation=hboi.hnm : "My brain's intact|, but the rest got fried|... Up in smoke|... Aaaarrr|..." choices "treat"
            say Beauregard presentation=text_only chatter : "Don't tire him out|, Commander|..." choices "treat"
            say Beauregard presentation=hboi1.hnm repeatable : "Gotta have a new body|..." choices "treat"
            say Beauregard presentation=hboj.hnm repeatable : "Aaaarrr"
        }
        case "talk1" {
            menu "patagos" "betakam" "treasure" "Gladis"
            say Beauregard presentation=bor_b_tr.hnm : "The PATAGOS were an amazing people|, Commander|... They worshiped the sun Gladis..." choices "patagos"
            say Beauregard presentation=bor_c_tr.hnm : "The frescoes you see are hundreds of thousands of years old|..." choices "patagos"
            say Beauregard presentation=bor_d_tr.hnm : "\"PATAGOS\" means \"HOGLOHULU\" in the Patasel cubeniform language of the 15th dynasty|... Fascinating|, no|?" choices "patagos"
            dictionary blank after "\"HOGLOHULU\""
            say Beauregard presentation=bor_e_tr.hnm : "I could do with some rest on Galabar|... A couple of tekno clubs|, and some exotic nightlife|... What am I saying|?" choices "patagos"
            say Beauregard presentation=borb_atr.hnm : "Betakam was a cultivated and much loved king|. His poetry was exquisite|, Commander" choices "betakam"
            say Beauregard presentation=bor_c_tr.hnm if_not_shown skip_next=1 : "Poem by BETAKAM IV King of the PATAGOS of TUMUL: \"HATA\"" choices "betakam"
            globals.poem = 1
            say Beauregard presentation=bor_b_tr.hnm : "Gladis blew up|, as suns do when they get old|. Happily|, we don't explode at death|. Not usually anyway|." choices "Gladis"
            say Beauregard presentation=bor_c_tr.hnm : "I owe you my life|, Commander|. This is a great body|..." choices "Gladis"
            say Beauregard presentation=bor_d_tr.hnm if_not_shown skip_next=1 : "The Transe Dance, those Galabar tekno clubs|... Covered in perfume|... What am I saying|?" choices "Gladis"
            globals.delir = 1
            say Beauregard presentation=bor_b_tr.hnm if_not_shown skip_next=1 : "How Gladis must have shone|..." choices "Gladis"
            globals.regard = 1
            say Beauregard presentation=bor_e_tr.hnm repeatable if_not_shown skip_next=1 : "Yes Commander, this planet is a priceless cultural treasure|..." choices "treasure"
            globals.regard = 1
            yield
        }
    }

    selector Honk_choices {
        case "talk" {
            menu "bye_bye" "help" "message"
            say Honk presentation=text_only chatter repeatable : "You're the boss|, Commander|..." choices "talk"
            say Honk presentation=text_only chatter repeatable : "Commander|..." choices "bye_bye"
            yield
        }
    }

    selector Izwalito_choices {
        case "talk" continues {
            menu "hello" "talk"
            say Izwalito presentation=iswb.hnm repeatable : "Hello friend|..." choices "hello"
            say Izwalito presentation=iswc.hnm : "Talk|, friend|?" choices "talk"
        }
        case "talk" continues {
            menu "bye_bye" "izwal" "food" "planet" "reproduction"
            say Izwalito presentation=iswd.hnm repeatable chance=20% : "What you want|, friend|?" choices "talk"
        }
        case "izwal" continues {
            menu "talk" "bye_bye" "society" "ideal" "happiness"
            say Izwalito presentation=iswb.hnm : "Izwal great pacifist people" choices "izwal"
            say Izwalito presentation=iswc.hnm : "Us live in tribe|, us poor hungry people" choices "society"
            say Izwalito presentation=iswb.hnm : "Us work much|, us be migrators|..." choices "society"
            say Izwalito presentation=iswb.hnm : "Me|, Izwalito|, be nephew of son of chief of tribe|..." choices "society"
            say Izwalito presentation=iswc.hnm repeatable : "You talk much|..." choices "society"
            say Izwalito presentation=iswb.hnm : "Me dream of perfect world with much to eat|..." choices "ideal"
            say Izwalito presentation=iswc.hnm : "Ideal, ideal... You like dream|, friend|..." choices "ideal"
            say Izwalito presentation=iswe.hnm : "Ideal be always far from reality|: poor want be rich|, rich want be poor|..." choices "ideal"
            say Izwalito presentation=text_only chatter : "Ouch|... This is getting kind of heavy|, Commander|. You guys go on without me|. I'm gonna sleep|..." choices "ideal"
            say Izwalito presentation=iswd.hnm if_not_shown skip_next=1 : "Izwals of planet Rondo be very rich|... They have much CREDs" choices "ideal"
            globals.secret = 1
            say Izwalito presentation=iswb.hnm : "Family|, children|, work|, food|, reproduction|, reproduction|..." choices "happiness"
            say Izwalito presentation=iswb.hnm : "Us Izwals of Corpo not know happiness|..." choices "happiness"
            say Izwalito presentation=iswc.hnm : "Izwals of planet Rondo know happiness|..." choices "happiness"
            say Izwalito presentation=iswd.hnm : "Me dream of blue planet with murffalos|, greenery|, birds|... Me dream|, friend|..." choices "happiness"
            say Izwalito presentation=iswc.hnm repeatable : "You talk much|..." choices "happiness"
        }
        case "knowledge" continues {
            menu "talk" "bye_bye" "rondo" "truth"
            say Izwalito presentation=iswc.hnm : "What you want know|, friend|?" choices "knowledge"
            say Izwalito presentation=iswe.hnm : "Rondo|, you want know planet Rondo|, friend|..." choices "rondo"
            say Izwalito presentation=iswf.hnm if_not_shown skip_next=1 : "Planet Rondo be in Rondalus constellation|, coordinates AX4532..." choices "rondo"
            mark Rondo as known
            say Izwalito presentation=iswb.hnm : "Me not lie|..." choices "truth"
            say Izwalito presentation=iswc.hnm : "Ideal be ideal..." choices "truth"
            say Izwalito presentation=iswb.hnm repeatable : "Me tell truth|, Commander" choices "truth"
        }
        case "food" continues {
            menu "talk" "bye_bye" "murffalos" "grass"
            say Izwalito presentation=iswb.hnm : "Us like eat murffalos|, but our planet not have murffalos|. Us did eat all|..." choices "food"
            say Izwalito presentation=iswb.hnm repeatable : "Izwal people be hungry|. You help us|, friend|..." choices "food"
            say Izwalito presentation=iswc.hnm : "Murffalo nice meat|, tender|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm : "Me dream eat roast murffalo|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm : "You not talk|. Me be hungry|, friend|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm repeatable : "Hungry|... Hungry|..." choices "murffalos"
            say Izwalito presentation=iswf.hnm : "Me not like eat grass|. Grass make head turn|. Bad|..." choices "grass"
            say Izwalito presentation=iswb.hnm repeatable : "Grass not grow here|..." choices "grass"
        }
        case "reproduction" continues {
            menu "talk" "bye_bye" "love" "female" "murffalos"
            say Izwalito presentation=iswb.hnm repeatable : "Me like reproduction|..." choices "reproduction"
            say Izwalito presentation=iswf.hnm : "Me have sweetheart|, hee hee hee hee|...." choices "love"
            say Izwalito presentation=iswb.hnm repeatable : "You not talk|, me blush|..." choices "love"
            say Izwalito presentation=iswb.hnm repeatable : "You talk too much female|, friend|..." choices "female"
            say Izwalito presentation=iswf.hnm : "Me be hungry|, friend|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm : "Murffalos be thirteen to reproduce|. One in middle|, and twelve around|... Hee Hee|..." choices "muffalos"
            say Izwalito presentation=iswf.hnm repeatable : "Hungry|... Hungry|..." choices "murffalos"
        }
        case "planet" {
            menu "talk" "bye_bye" "ecology" "stars"
            say Izwalito presentation=iswb.hnm repeatable chance=20% : "Corpo nice Izwal planet|..." choices "planet"
            say Izwalito presentation=iswb.hnm : "Corpo poor planet|, but nice ecology" choices "ecology"
            say Izwalito presentation=iswc.hnm : "Here nothing grow|. No water|. No tree|. No murffalos|..." choices "ecology"
            say Izwalito presentation=iswb.hnm repeatable : "Ecology Heal The Planet \"HTP\"|, friend|... You know \"HLP\"|?" choices "ecology"
            say Izwalito presentation=iswb.hnm : "Stars|. me like look sky|..." choices "stars"
            say Izwalito presentation=iswc.hnm : "Big starry sky|. Me know Magnalus constellation" choices "stars"
            say Izwalito presentation=iswb.hnm if_not_shown skip_next=1 : "Planet magnus be in Magnalus constellation|. Magnus coordinates 1234,543256 degrees... You like stars|?" choices "stars"
            mark Magnus as known
            say Izwalito presentation=iswb.hnm repeatable : "Stars be big science|..." choices "stars"
            yield
        }
    }

    selector Morning_Oil_choices {
        case "talk" continues {
            menu "hello" "say_nothing" "laugh" "bye_bye"
            say Morning_Oil presentation=morn01.hnm : "Hi Commander" choices "hello"
            say Morning_Oil presentation=morn02.hnm : "Such silence|..." choices "say_nothing"
            say Morning_Oil presentation=morn03.hnm : "Ha ha ha ha ha ha..." choices "laugh"
            say Morning_Oil presentation=morn04.hnm : "Bye bye Commander" choices "bye_bye"
        }
        case "history" continues {
            menu "bye_bye" "war" "croolis" "treasure" "battles" "mastachok"
        }
        case "war" continues {
            menu "bye_bye" "match"
            say Morning_Oil presentation=morn06.hnm : "That was a terrible war|... It all started with a boxing match between the Croolis EVISCERATOR and EMASCULATOR|..." choices "war"
            say Morning_Oil presentation=morn03.hnm : "You should've seen it|, Commander|... Boy|, was that some fight|..." choices "war"
            say Morning_Oil presentation=morn04.hnm : "They made BIONIUM bombs|. Those things could blow up entire planets|..." choices "war"
            say Morning_Oil presentation=morn06.hnm : "Never seen mayhem like it|... BBOOOOMMM|!!! POW|! TA TA TA TA TA|... Ha|! Ha|! Ha|!" choices "war"
            say Morning_Oil presentation=morn05.hnm : "The boxing match got out of hand|. It was televised throughout the universe|..." choices "match"
            say Morning_Oil presentation=morn04.hnm : "The war was between the Croolis Eviscerator and Emasculator... What a bloodbath|..." choices "match"
            say Morning_Oil presentation=morn04.hnm : "The match was televised throughout the universe|... I can still see it|..." choices "match"
        }
        case "croolis" continues {
            menu "bye_bye" "history" "terror" "eviscerator" "emasculator"
            say Morning_Oil presentation=morn06.hnm : "The Croolis are unbelievably warlike" choices "croolis"
            say Morning_Oil presentation=morn05.hnm : "My master EVISCERATOR was a talented BIONIUM prospector|..." choices "croolis"
            say Morning_Oil presentation=morn06.hnm : "He found BIONIUN in galactic cyberspace contraction|..." choices "croolis"
            dictionary blank after "BIONIUN"
            say Morning_Oil presentation=morn07.hnm : "Those Croolis are seriously deranged|!!!" choices "croolis"
            say Morning_Oil presentation=morn08.hnm : "We spread terror throughout the galaxy for centuries|..." choices "terror"
            say Morning_Oil presentation=morn06.hnm : "Terror was the Croolis secret weapon|..." choices "terror"
            say Morning_Oil presentation=morn03.hnm : "We robots were programmed to be fearless|..." choices "terror"
            say Morning_Oil presentation=morn04.hnm : "Eviscerator came to a bad end|. When SCRUT stopped the war|, they put him in jail" choices "eviscerator"
            say Morning_Oil presentation=morn05.hnm : "Eviscerator is dangerous|, Commander|... A ruthless killer|..." choices "eviscerator"
            say Morning_Oil presentation=text_only chatter if_not_shown skip_next=1 : "Commander|...I'm worried in case the memory of his ex-master awakens his violent instincts|..." choices "eviscerator"
            globals.viol = 1
            say Morning_Oil presentation=morn06.hnm : "Emasculator's not too smart|... Just mean|..." choices "emasculator"
            say Morning_Oil presentation=morn03.hnm : "That's a Croolis I hate|..." choices "emasculator"
        }
        case "treasure" continues {
            menu "bye_bye" "history" "hiding_place"
            say Morning_Oil presentation=morn03.hnm : "Ah|! The treasure|. You should have seen it|, Commander|... Beyond belief|..." choices "treasure"
            say Morning_Oil presentation=morn04.hnm : "The stones of Galabar, the horns of Rla|, authentic Rhinox tibia vases|..." choices "treasure"
            say Morning_Oil presentation=morn07.hnm : "Ha|! Ha|! Hard to know where he might've hidden it|, Commander|..." choices "hiding_place"
            say Morning_Oil presentation=morn06.hnm : "I can give you some information but it's strictly confidential|..." choices "hiding_place"
            say Morning_Oil presentation=morn07.hnm if_not_shown skip_next=1 : "I don't want Honk to hear|..." choices "hiding_place"
            globals.caches = 1
            say Morning_Oil presentation=morn05.hnm : "Millions died in the battles|. Planets were stripped to the bone|..." choices "battle"
            say Morning_Oil presentation=morn06.hnm : "The Izwals got hit bad|. They weren't ready|, see|..." choices "battle"
            say Morning_Oil presentation=morn07.hnm : "The SCRUT armies won a battle so huge it shook the entire galaxy|.." choices "battle"
            say Morning_Oil presentation=morn06.hnm : "The defeated Croolis were forced back to the planet Trashlando|. That's an awful place|, Commander|..." choices "battle"
        }
        case "mastachok" {
            menu "bye_bye" "history" "information"
            say Morning_Oil presentation=morn06.hnm : "Mastachok is a dead planet now|... Its surface is completely lifeless|..." choices "mastachok"
            say Morning_Oil presentation=morn07.hnm : "The factory was replaced by a prison|... SCRUT guards are permanently posted there|..." choices "mastachok"
            say Morning_Oil presentation=morn03.hnm : "Mastachok is so polluted even the deadliest waste matter hates it|..." choices "mastachok"
            yield
        }
    }

