        } then {
            say Bronko presentation=text_only : "Yes|, hello|... Commander|... Bronko here|... I'm receiving you loud and clear|..."
            say Bronko presentation=text_only if_not_shown skip_next=1 : "There are quite a few Slimer ships coming and going|. Doctor Otto Von Smile appears to have left|..."
            Bronko.topic = "rien"
            when {
                require transmitter.holder == aboard
            } then {
                say Bronko presentation=text_only chatter : "Commander|, how about teleporting one of those spy keyrings to Mister Bronko|? He could hide it in Doctor Otto Von Smile's desk|..."
                say Bronko presentation=text_only chatter : "That way we could listen to whatever he's doing|..."
                say Bronko presentation=text_only : "It's a great idea|, Commander|..."
                say Bronko presentation=text_only chatter : "Oh|, you flatter me|, Mister Bronko|. Any fool would have thought of it|..."
                say Bronko presentation=text_only : "No|, no|. It's an idea of rare perspicacity|..."
                say Bronko presentation=text_only chatter : "How can I say this|, Commander|... Mister Bronko is so... so|... admirable|!|..."
                say Bronko presentation=text_only resume_at=bronk4_dialogue_resume_1 : "TELEPORT TRANSMITTER KEYRING TO BRONKO|..." choices "teleport"
                when {
                    require choice == "teleport"
                } then {
                    say Bronko presentation=text_only if_not_shown skip_next=2 : "TELEPORTING SPY KEYRING TRANSMITTER TO BRONKO|..."
                    transfer transmitter from aboard to Bronko
                    choice = none
                }
            }
            bronk4_dialogue_resume_1:
            say Bronko presentation=text_only : "See you soon|, Commander|..."
            say Bronko presentation=text_only chatter : "Bronko is so brave|, isn't he|?|..."
            say Bronko presentation=text_only if_not_shown skip_next=1 : "..."
            end presentation Bronko
        }
    }
