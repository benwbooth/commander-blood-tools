    proc bronk1 enabled {
        during contact
        require transmitter.holder != Bronko
        require globals.F1 == 0
        require arche.current_location != Erazor
        require presentation == Bronko
    } then {
        say Bronko presentation=rgbtr3.hnm : "Commander|, I'm getting rusty|..."
        when {
            require Migrator.encounter_count == 0
            require Bronko.encounter_count < 2
        } then {
            say Bronko presentation=text_only chatter : "Commander, Mister Bronko spoke to me of a musician friend of his who lives at the airport on planet Moskito..."
            say Bronko presentation=rgbtr4.hnm : "True|, Commander|. A very fine musician|..."
            say Bronko presentation=rgbtr5.hnm if_not_shown skip_next=1 : "If you have the time|, you should check him out|..."
            airport.known = true
        }
        when {
            require Bronko.encounter_count == 1
        } then {
            say Bronko presentation=rgbtr4.hnm : "Honk taught me your language|. He's so patient|... Thanks HONK|!"
            say Bronko presentation=text_only chatter : "My pleasure|, Mister Bronko|. You're a talented student|..."
            say Bronko presentation=rgbtr5.hnm : "You're just saying that|, Mister Honk|..."
            say Bronko presentation=text_only chatter : "No|, you have great gifts|... Truly|..."
            say Bronko presentation=rgbtr6.hnm : "You're making me blush now|... And butchers don't blush easily|, you know|! Ha! Ha! Ha!"
            say Bronko presentation=text_only chatter : "Ha! Ha! Ha! What a fine wit you have|, Mister Bronko|! Ha! Ha! Ha!"
            say Bronko presentation=text_only chatter : "This is one fine robot|, Commander|..."
            say Bronko presentation=rgbtr7.hnm : "As I was saying|, Commander|, nothing would please me more than to serve you|..."
            say Bronko presentation=rgbtr8.hnm : "I could undertake a mission|, maybe|..."
        }
        when {
            require Bronko.encounter_count > 1
            require Daddy_Gluxx.encounter_count == 0
        } then {
            say Bronko presentation=rgbtr1.hnm : "I was pointing out|, Commander|, that I'd enjoy nothing better than to serve you|..."
            say Bronko presentation=rgbtr2.hnm : "I could undertake a mission of observation at that unusual clinic|..."
            say Bronko presentation=text_only : "We ought to go see the Gluxx family on planet EKATOMB..."
        }
        when {
            require Bronko.encounter_count > 2
            require Daddy_Gluxx.encounter_count > 0
            require arche.current_location != Erazor
        } then {
            say Bronko presentation=text_only chatter : "Better approach the planet Erazor and offer Mister Bronko a mission..."
        }
        say Bronko presentation=rgbtr4.hnm : "If you need me|, don't hesitate a second|..."
        say Bronko presentation=rgbtr6.hnm : "See you soon|..."
        say Bronko presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Bronko
    }
    global F1 = 0
    proc bronk2 enabled {
        during contact
        require arche.current_location == Erazor
        require transmitter.holder != Bronko
        require presentation == Bronko
    } then {
        say Bronko presentation=rgbtr4.hnm : "Commander|, I'm getting bored in a big big way|... I need action|..."
        when {
            require Migrator.encounter_count == 0
            require Bronko.encounter_count < 2
        } then {
            say Bronko presentation=text_only chatter : "Commander, Mister Bronko spoke to me of a musician friend of his who lives at the airport on planet Moskito..."
            say Bronko presentation=rgbtr4.hnm : "True|, Commander|. A very fine musician|..."
            say Bronko presentation=rgbtr5.hnm if_not_shown skip_next=1 : "If you have the time|, you should check him out|..."
            airport.known = true
        }
        when {
            require Daddy_Gluxx.encounter_count > 0
        } then {
            say Bronko presentation=text_only chatter : "Commander|, why don't we send Mister Bronko to see what's happening on planet Erazor|..."
            say Bronko presentation=rgbtr3.hnm : "Yes|, Commander|, that's a great idea|. I'm sure there's a connection with the disappearance of the Gluxx kids|..."
            say Bronko presentation=text_only chatter : "Let's teleport him|, Commander|. He'll keep us informed by radio|..."
            say Bronko presentation=text_only resume_at=bronk2_dialogue_resume_1 : "TELEPORT BRONKO TO ERAZOR" choices "YES" "NO"
            when {
                require choice == "YES"
            } then {
                say Bronko presentation=text_only if_not_shown skip_next=4 : "TELEPORTING BRONKO TO ERAZOR"
                globals.brk = 1
                Bronko.current_location = Erazor
                choice = none
                end presentation Bronko
            }
            when {
                require choice == "NO"
            } then {
                say Bronko presentation=text_only if_not_shown skip_next=1 : "As you wish|, Commander|..."
                choice = none
            }
        }
        bronk2_dialogue_resume_1:
        say Bronko presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Bronko
    }
