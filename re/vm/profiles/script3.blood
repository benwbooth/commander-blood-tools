    proc timx enabled {
    } then {
        when {
            require timer[12] == 0
        } then {
            globals.ti += 1
            timer[12] = 1200
        }
    }
    global ti = 0
    proc tim1 enabled {
        require globals.ti == 1
    } then {
        Ulikan.known = true
        queue presentation Ulikan
    }
    proc tim1B enabled {
        during bridge
        require presentation == Ulikan
        require globals.ti == 1
    } then {
        say Ulikan presentation=text_only : ".2"
        say Ulikan presentation=text_only : ".1"
        say Ulikan presentation=text_only : ".0"
        say Ulikan presentation=text_only : "CONNECT|... COMMANDER BLOOD GAME"
        say Ulikan presentation=text_only : "Message: CYBERION JUNIOR HERE|."
        say Ulikan presentation=text_only : "MAKING PROGRESS|?|..."
        say Ulikan presentation=text_only : "YOU FOUND EDEN AND TINA BURNER|?|... YOU HAVE TO TELEPORT HER|..."
        say Ulikan presentation=text_only : "TINA IS SOME COOL BABE|..."
        say Ulikan presentation=text_only : "THIS IS COSTING ME A FORTUNE|... BYE|...|...|...|... SEE YA"
        when {
            require clock.hour < 8
            require clock.hour > 3
        } then {
            say Ulikan presentation=early_morning_signoff : "YOU SURE GET UP EARLY TO PLAY|... I GOTTA GO|... SEE YA|!"
        } else {
            when {
                require clock.hour < 12
                require clock.hour > 8
            } then {
                say Ulikan presentation=morning_signoff : "BEAUTIFUL MORNING|... SEE YA"
            } else {
                when {
                    require clock.hour > 21
                    require clock.hour < 4
                } then {
                    say Ulikan presentation=night_signoff : "NITE NITE|... DON'T STAY UP TOO LATE|. TOMORROW ALWAYS COMES|..."
                } else {
                    when {
                        require clock.hour > 18
                        require clock.hour < 21
                    } then {
                        say Ulikan presentation=evening_signoff : "HAVE FUN|... MY MOM SAYS SUPPER'S READY|..."
                    } else {
                        when {
                            require clock.hour > 14
                            require clock.hour < 18
                        } then {
                            say Ulikan presentation=afternoon_signoff : "THINK I'LL GO NOW|... AFTERNOON'S A GOOD TIME TO CATCH UP ON SOME ZZZZZ'S|..."
                        }
                    }
                }
            }
        }
        fin:
        say Ulikan presentation=text_only if_not_shown skip_next=4 : "stop"
        mark Ulikan as unknown
        tim1.enabled = false
        globals.trak1 = 1
        end presentation Ulikan
    }
    export label "fin"
