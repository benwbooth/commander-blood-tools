    global fion = 0
    proc amig1 enabled {
        require Tina_Burner.current_location != bar
        require Eviscerator.current_location != bar
    } then {
        Amigo.current_location = bar
        amig1.enabled = false
    }
    proc amig2 enabled {
        during travel
        require Amigo.current_location == bar
        require presentation == Amigo
        require arche.current_location == Eden
        require globals.M1 == 0
    } then {
        say Amigo presentation=amic_tr.hnm : "HALT STRANGER|!!!"
        say Amigo presentation=amibg_tr.hnm resume_at=amig3 : "Do you know any of our customers|??? The PURPLE HAZE doesn't accept just anybody|..." choices "Morning_Oil" "Eviscerator" "Izwalito" "Bronko" "Tina_Burner"
        dictionary blank after "customers"
        when {
            require choice == "Morning_Oil"
        } then {
            say Amigo presentation=amicg_tr.hnm if_not_shown skip_next=2 : "I don't know any Morning Oil|, stranger|. You'd better leave if you don't want trouble|...."
            choice = none
            end presentation Amigo
        }
        when {
            require choice == "Tina_Burner"
        } then {
            say Amigo presentation=amic_tr.hnm if_not_shown skip_next=2 : "That old bag Tina Burner|! She's got a nerve sending people here|... Out of my sight|, stranger|..."
            choice = none
            end presentation Amigo
        }
        when {
            require choice == "Izwalito"
        } then {
            say Amigo presentation=amicg_tr.hnm if_not_shown skip_next=2 : "I don't know any Izwalito|, stranger|. You'd better leave if you don't want trouble|........"
            choice = none
            end presentation Amigo
        }
        when {
            require choice == "Bronko"
        } then {
            say Amigo presentation=amicg_tr.hnm if_not_shown skip_next=2 : "I don't know any Bronko|, stranger|. You'd better leave if you don't want trouble|...."
            choice = none
            end presentation Amigo
        }
        when {
            require choice == "Eviscerator"
        } then {
            say Amigo presentation=amicg_tr.hnm if_not_shown skip_next=2 : "EVISCERATOR|!!! Eviscerator sent you|?"
            globals.evi = 1
            choice = none
        }
    }
    global M1 = 0
    global evi = 0
    proc amig3 enabled {
        during travel
        require presentation == Amigo
        require arche.current_location == Eden
        require globals.evi == 1
    } then {
        say Amigo presentation=amic_tr.hnm : "The password|,"
        say Amigo presentation=amibg_tr.hnm resume_at=amig3_dialogue_resume_1 : "You know the PASSWORD|, stranger|?" choices "croolas" "meteorut" "galabar" "Mastachok"
        when {
            require choice == "croolas"
        } then {
            say Amigo presentation=amibg_tr.hnm if_not_shown skip_next=1 : "CROOLAS GETS YOU EVERYTIME|...."
            choice = none
        }
        when {
            require choice == "meteorut"
        } then {
            say Amigo presentation=amibg_tr.hnm if_not_shown skip_next=1 : "THE SCARLET METEORITE RUPTURES YOUR SPLEEN|...."
            choice = none
        }
        when {
            require choice == "galabar"
        } then {
            say Amigo presentation=amibg_tr.hnm if_not_shown skip_next=1 : "GALABAR BARMEN MAKE KILLER COCKTAILS|...."
            choice = none
        }
        when {
            require choice == "Mastachok"
        } then {
            say Amigo presentation=amibg_tr.hnm if_not_shown skip_next=1 : "MASTAR OF MASTACHOK MUNCHES MOUNTAINS OF MEAT|....."
            choice = none
        }
        amig3_dialogue_resume_1:
        say Amigo presentation=amic_tr.hnm if_not_shown skip_next=2 : "What do you want|, stranger|?"
        globals.secret = 0
        Amigo.topic = "talk"
        say Amigo presentation=amic_tr.hnm if_not_shown skip_next=1 : "Bye bye|, stranger|..." choices "bye_bye"
        end presentation Amigo
        when {
            require globals.secret == 1
        } then {
            say Amigo presentation=amid_tr.hnm : "Be careful|, stranger|. That stuff is sensitive|..."
            say Amigo presentation=text_only chatter resume_at=yok0 : "TELEPORT SPLATCH TO ARK|." choices "teleport" "refuse"
            when {
                require choice == "teleport"
            } then {
                say Amigo presentation=text_only if_not_shown skip_next=3 : "SPLATCH TELEPORTED TO ARK|..."
                transfer splatch from Amigo to aboard
                Amigo.current_location = Trashlando
                choice = none
            }
            when {
                require choice == "refuse"
            } then {
                say Amigo presentation=amibg_tr.hnm : "You can refuse if you want|..."
                say Amigo presentation=amid_tr.hnm : "Don't hang around here|... It's dangerous|..."
                say Amigo presentation=text_only if_not_shown skip_next=1 : "..."
                end presentation Amigo
            }
        }
    }
    proc yok0 enabled {
