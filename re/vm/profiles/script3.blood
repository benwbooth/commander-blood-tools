        } then {
            say Tina_Burner presentation=tinb_tr.hnm : "Oh|, a guitar|!|. For little me|?|... Hee|! Hee|! Hee|!"
            say Tina_Burner presentation=tinc_tr.hnm : "You're just adorable|... Hee|! Hee!"
            say Tina_Burner presentation=tinf_tr.hnm : "I just have to go play|..."
            say Tina_Burner presentation=tini_tr.hnm : "Goodbye|, gorgeous one|..."
            say Tina_Burner presentation=text_only if_not_shown skip_next=2 : "..."
