            dictionary blank after "CRED"
            say Bronko presentation=rgbtr3.hnm : "Creds be hard to earn|..." choices "cred"
            say Bronko presentation=rgbtr4.hnm repeatable : "You like creds|, friend|..." choices "cred"
            say Bronko presentation=rgbtr5.hnm : "Me want buy big ship|... Take vacation through universe|..." choices "buy"
            say Bronko presentation=rgbtr4.hnm : "Me want buy home on planet Troma|... Grow nuts|, bolts|, screws|..." choices "buy"
            say Bronko presentation=rgbtr3.hnm : "Me want breed cybernetic wheelbarrows|, lawnmowers|... Me dream|, friend|..." choices "buy"
            say Bronko presentation=rgbtr5.hnm : "To buy|, me must earn creds|..." choices "buy"
        }
        case "murffalos" continues {
            menu "talk" "bye_bye" "hunt"
            say Bronko presentation=rgbtr2.hnm : "Thirteen murffalos to reproduce... One in middle|. twelve around|. That be murffalo reproduction|..." choices "murffalos"
            say Bronko presentation=rgbtr3.hnm : "Me not like murffalo|... Not good|, too tender|... Me like lawnmower leg|..." choices "murffalos"
            say Bronko presentation=rgbtr4.hnm : "Me know chop murffalos|..." choices "murffalos"
            say Bronko presentation=rgbtr5.hnm : "Me like hunt satellite game with laser-pulper|... Bang Bang at satellites|..." choices "hunt"
            say Bronko presentation=rgbtr4.hnm : "Hunting be nice sport|..." choices "hunt"
        }
        case "weapons" continues {
            menu "talk" "bye_bye" "planets" "war"
            say Bronko presentation=rgbtr5.hnm : "To buy good weapons|, must pay much creds|, Commander" choices "weapons"
            say Bronko presentation=rgbtr3.hnm : "Me have weapons at end of arms|..." choices "weapons"
            say Bronko presentation=rgbtr3.hnm : "You be big traveller|. Know planets|, friend|..." choices "planets"
            say Bronko presentation=rgbtr4.hnm : "Croolis war do much damage|... Bad war|, friend|..." choices "war"
        }
        case "retirement" {
            menu "talk" "bye_bye" "Magnus"
            say Bronko presentation=rgbtr2.hnm : "Ah retirement|! Them send me to planet Magnus|, with other old old robots|... CRY CRY|..." choices "retirement"
            yield
        }
    }

    selector Bob_Morlock_choices {
        case "talk" continues {
            menu "bye_bye" "black_hole" "Big_Bang" "Bob_Morlock" "kanary" "mission" "corpo" "good_"
            say Bob_Morlock presentation=bobc.hnm chance=20% : "What do you want to know|, Commander?" choices "talk"
            say Bob_Morlock presentation=bobd.hnm if_not_shown skip_next=1 : "Goodbye|, Commander|..." choices "bye_bye"
            end presentation Bob_Morlock
            say Bob_Morlock presentation=bobc.hnm : "After years of research|, I was able to isolate time|, Commander" choices "black_hole"
            say Bob_Morlock presentation=bobb.hnm : "Certain black holes can be used to travel back in time|." choices "black_hole"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Honk has been programmed to identify appropriate black holes" choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "To reach the BIG BANG, you must travel through a number of black holes|..." choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "Black holes are amazing natural devices|, Commander|..." choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobd.hnm : "I have devoted my life to the pursuit of Truth|, Commander|..." choices "Big_Bang"
            say Bob_Morlock presentation=bobc.hnm : "I know that truth lies beyond the BIG BANG, Commander|!" choices "Big_Bang"
            say Bob_Morlock presentation=bobb.hnm repeatable : "My memory is not what it used to be|..." choices "Big_Bang"
            say Bob_Morlock presentation=bobc.hnm : "Thanks to the scientists of KANARY|, I am the oldest being in the UNIVERSE" choices "Bob_Morlock"
            say Bob_Morlock presentation=bobb.hnm : "In my time|, I've been a crooner|, a magician|, an adventurer|... I created KANARY|, the biggest business empire in the universe|." choices "Bob_Morlock"
            say Bob_Morlock presentation=bobc.hnm : "Women have found me irresistible|. Thousands of generations have admired me. I am immortal|!" choices "Bob_Morlock"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Commander|, you are going to relive my past|. I envy you|..." choices "Bob_Morlock"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "Ah|... Otto Von Smile|, Eviscerator|, Jeph d'Ulikan|, Yolk|, old Tina Burner|, and all the others|..." choices "Bob_Morlock"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm repeatable if_not_shown skip_next=1 : "Ahh! Those were good times|, Commander|..." choices "Bob_Morlock"
            offer topic "revelation"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "You want revelations|, Commander|?" choices "revelation"
            globals.reve = 1
            say Bob_Morlock presentation=bobc.hnm : "Your mission is to find and travel through the right black holes, taking us back through time to the BIG BANG" choices "mission"
            say Bob_Morlock presentation=bobb.hnm : "You'll meet fabulous beings|, some of them very dangerous|. You'll need all your talents, Commander" choices "mission"
            say Bob_Morlock presentation=bobc.hnm : "You'll see terrible wars|, cross impossible frontiers|..." choices "mission"
            say Bob_Morlock presentation=bobb.hnm : "You must rally strange beings to your cause|..." choices "mission"
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "You will be in sole command|, unless you decide to wake me|..." choices "mission"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm : "Corpo is my home planet" choices "It"
            say Bob_Morlock presentation=bobd.hnm repeatable if_not_shown skip_next=1 : "Corpo is a rare and fabulous planet|... Its resources are unlimited|." choices "corpo"
            Bob_Morlock.aggressiveness += 2
            say Bob_Morlock presentation=bobc.hnm : "Truth is to be found at the creation of the universe|, just before the BIG BANG|..." choices "truth"
            say Bob_Morlock presentation=bobb.hnm repeatable if_not_shown skip_next=1 : "Ah! Truth|..." choices "truth"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "I'm getting pictures from the Ark|, Commander. All systems are nominal|..." choices "good_"
            request sequence "arch01.hnm"
            say Bob_Morlock presentation=bobb.hnm : "You flatter me|, Commander|..." choices "good_"
            say Bob_Morlock presentation=bobc.hnm chance=20% if_not_shown skip_next=1 : "You're embarrassing me|, Commander|..." choices "good_"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm repeatable chance=20% : "Heh heh|..." choices "good_"
        }
        case "kanary" {
            menu "talk" "bye_bye" "cottage" "clones" "employees" "reports"
            say Bob_Morlock presentation=bobb.hnm : "The Cottage Research department is my secret project" choices "cottage"
            say Bob_Morlock presentation=bobb.hnm : "The vegetable kingdom is a marvel of nature" choices "cottage"
            say Bob_Morlock presentation=bobb.hnm : "The Cottage Research department develops miracles of nature" choices "cottage"
            say Bob_Morlock presentation=bobd.hnm : "Kanary's lawns mow themselves every weekend|..." choices "cottage"
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "Kanary's artificial orchids produce centuries old whiskey" choices "cottage"
            Bob_Morlock.aggressiveness += 5
            say Bob_Morlock presentation=bobb.hnm : "Kanary has devoted itself to synthetic cloning" choices "clones"
            say Bob_Morlock presentation=bobc.hnm : "Kanary's four million employees were built by and for Kanary" choices "clones"
            say Bob_Morlock presentation=bobb.hnm : "I am the last natural bio-being and I control everything|..." choices "clones"
            say Bob_Morlock presentation=bobb.hnm : "Every year|, my employees wake me for ten minutes on my birthday|... I blow out the candles on my cake and sign the company reports" choices "clones"
            say Bob_Morlock presentation=bobb.hnm repeatable if_not_shown skip_next=1 : "I instructed Kanary's scientists to to create the perfect adventurer to take me to the BIG BANG|..." choices "clones"
            Bob_Morlock.aggressiveness += 3
            say Bob_Morlock presentation=bobd.hnm : "All Kanary employees were built by the CLONE CONSORTIUM|. Including YOU|, Commander" choices "employees"
            say Bob_Morlock presentation=bobe.hnm : "You are all my employees|: YOU Honk|, YOU Commander|, YOU Olga|... ALL OF YOU|..." choices "employees"
            say Bob_Morlock presentation=bobf.hnm repeatable if_not_shown skip_next=1 : "Kanary builds the cheapest and most efficient employees in the universe|..." choices "employees"
            globals.emplo = 1
            say Bob_Morlock presentation=bobb.hnm chance=20% : "Kanary is the biggest company in the known universe" choices "kanary"
            say Bob_Morlock presentation=bobc.hnm repeatable if_not_shown skip_next=1 : "Kanary invents|, builds|, consumes and controls everything in the universe" choices "kanary"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobd.hnm : "Kanary is so well managed that its products are built at negative cost" choices "reports"
            say Bob_Morlock presentation=bobc.hnm : "A complete cottage costs 100,990 Negabucks..." choices "reports"
            dictionary blank after "Negabucks..."
            say Bob_Morlock presentation=bobf.hnm : "Our turnover is so big that nobody can say the figure in a normal life span" choices "reports"
            say Bob_Morlock presentation=bobg.hnm repeatable if_not_shown skip_next=1 : "Our only competitor is CRYO" choices "They"
            Bob_Morlock.aggressiveness += 2
            yield
        }
    }

    selector Hom_choices {
