        say menu presentation=text_only : "URTIKAN trunk|, stuffed with MURFFALO liver|."
        say menu presentation=text_only : "GLOK dee-lite|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "The chef says|... Plenty more in the kitchen|!|..."
        say menu presentation=text_only if_not_shown skip_next=2 : "stop"
        men4.enabled = false
        end presentation menu
    }
    proc men5 enabled {
        during bridge
        require presentation == menu
        require Bronko.current_location != aboard
    } then {
        say menu presentation=text_only : "\"IMPROVED MENU\""
        say menu presentation=text_only : "Today's fare|:"
        say menu presentation=text_only : "Soup of PLASMA HONK-style|."
        say menu presentation=text_only : "WRIGGLER hearts in green blood coagulate|."
        say menu presentation=text_only : "URTIKAN roots|, deep fried in recycled oil|."
        say menu presentation=text_only : "Candied GLOK tongue|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "The chef says|... You eat what you are|!|..."
        say menu presentation=text_only if_not_shown skip_next=3 : "stop"
        men5.enabled = false
        men6.enabled = true
        end presentation menu
    }
    proc men6 disabled {
    } then {
        men1.enabled = true
        men2.enabled = true
        men3.enabled = true
        men4.enabled = true
        men5.enabled = true
        men6.enabled = false
    }
    proc honk1 enabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=text_only chatter : "I exist only to obey|, Commander"
        when {
            require globals.vbio == 0
        } then {
            say Honk presentation=text_only chatter : "Commander|, we don't have any BIONIUM|... COMMANDER|, please|..."
            say Honk presentation=text_only chatter : "I need that energy|..."
            say Honk presentation=text_only chatter : "You must enter Scruter Jo's CYBERSPACE|..."
            dictionary blank after "Scruter"
            say Honk presentation=text_only chatter : "Wake up Scruter Jo|, Commander|. He's sleeping in the Cryobox|..."
        }
        when {
            require globals.vbio == 1
        } then {
            say Honk presentation=text_only chatter : "We've got one dose of BIONIUM left|, Commander"
            say Honk presentation=text_only chatter : "You must enter Scruter Jo's CYBERSPACE|..."
            say Honk presentation=text_only chatter : "I don't feel too sure of myself|, Commander... I really need that energy|..."
        }
        when {
            require globals.vbio == 2
        } then {
            say Honk presentation=text_only chatter : "We've got two doses of BIONIUM left|, Commander"
            say Honk presentation=text_only chatter : "You must enter Scruter Jo's CYBERSPACE|..."
        }
        when {
            require globals.vbio == 3
        } then {
            say Honk presentation=text_only chatter : "We've got three doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 4
        } then {
            say Honk presentation=text_only chatter : "We've got four doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 5
        } then {
            say Honk presentation=text_only chatter : "We've got five doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 6
        } then {
            say Honk presentation=text_only chatter : "We've got six doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 7
        } then {
            say Honk presentation=text_only chatter : "We've got seven doses of BIONIUM left|, Commander"
        }
        when {
            require globals.vbio == 8
        } then {
            say Honk presentation=text_only chatter : "We've got eight doses of BIONIUM left|, Commander"
            say Honk presentation=text_only chatter : "You're the best|, Commander|..."
        }
    }
    proc help1 enabled {
        during bridge
        require presentation == Honk
        require globals.vbio > 2
        require Anna_Haf.current_location == aboard
        require painting.holder != aboard
        require painting.holder != Super_Zen
        require Vista.known
    } then {
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Go near Vista|, and talk to Anna Haf in the cryobox|..."
        globals.vbio -= 3
        say Honk presentation=text_only chatter if_not_shown skip_next=2 : "Service with a smile|! That's the story of my life|, Commander|..."
        help1.enabled = false
        end presentation Honk
    }
    proc help2 enabled {
        during bridge
        require presentation == Honk
        require globals.vbio > 2
        require hat.holder == aboard
    } then {
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "I'm sure Super Zen can help us|..."
        globals.vbio -= 3
        say Honk presentation=text_only chatter if_not_shown skip_next=2 : "Service with a smile|! That's the story of my life|, Commander|..."
        help2.enabled = false
        end presentation Honk
    }
    proc help3 enabled {
        during bridge
        require presentation == Honk
        require globals.vbio > 2
        require !Sat.known
        require Betakam.current_location == aboard
    } then {
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Maziok can help us, Commander|..."
        globals.vbio -= 3
        say Honk presentation=text_only chatter if_not_shown skip_next=2 : "Service with a smile|! That's the story of my life|, Commander|..."
        help3.enabled = false
        end presentation Honk
    }
    proc help4 enabled {
        during bridge
        require presentation == Honk
        require globals.vbio > 2
        require Fifi.encounter_count > 0
        require picture.holder == aboard
    } then {
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Fifi 'll love this ondoyant picture|..."
        globals.vbio -= 3
        say Honk presentation=text_only chatter if_not_shown skip_next=2 : "Service with a smile|! That's the story of my life|, Commander|..."
        help4.enabled = false
        end presentation Honk
    }
    proc help5 enabled {
        during bridge
        require presentation == Honk
        require globals.vbio > 2
        require Fifi.current_location == aboard
    } then {
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Fifi wants to go to planet Malus|..."
        globals.vbio -= 3
        say Honk presentation=text_only chatter if_not_shown skip_next=2 : "Service with a smile|! That's the story of my life|, Commander|..."
        help5.enabled = false
        end presentation Honk
    }
    proc what enabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Bye bye|, Commander|..."
        end presentation Honk
    }
    proc boba1 enabled {
        during contact
        require presentation == Bob_Morlock
    } then {
        say Bob_Morlock presentation=bobc.hnm : "What do you want|, Commander?"
        Bob_Morlock.topic = "talk"
        say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "..."
        timer[1] = 30
        when {
            require timer[1] == 0
        } then {
            say Bob_Morlock presentation=bobg.hnm : "I feel awful|, Commander|..."
            say Bob_Morlock presentation=bobd.hnm : "Ahhhh|!!!"
            say Bob_Morlock presentation=text_only if_not_shown skip_next=2 : "stop"
            timer[1] = disabled
            end presentation Bob_Morlock
        }
        say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "I feel weak|..." choices "bye_bye"
        globals.adieu = 1
        when {
            require globals.adieu == 1
        } then {
            say Bob_Morlock presentation=text_only chatter : "..."
            say Bob_Morlock presentation=text_only if_not_shown skip_next=3 : "stop"
            globals.adieu = 0
            timer[1] = disabled
            end presentation Bob_Morlock
        }
    }
    global adieu = 0
    proc augmen enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.emplo == 1
        require globals.emp == 0
    } then {
        say Bob_Morlock presentation=text_only chatter : "By the way|, Cap'n Bob sir|, I have a request to make|..."
        say Bob_Morlock presentation=text_only chatter : "Olga and me want a raise|... Just a few more megawatts|..."
        say Bob_Morlock presentation=bobf.hnm : "WHAT|... YOU'LL HAVE TO SPEAK LOUDER|... I'M GETTING A BIT DEAF COMMANDER|..."
        say Bob_Morlock presentation=text_only chatter : "WE WANT A RAISE IN MEGAWATTS|!!!"
        say Bob_Morlock presentation=bobe.hnm : "I'm feeling a bit sick|, Commander|. Aaah|!!! It's my heart|...."
        say Bob_Morlock presentation=text_only chatter if_not_shown skip_next=1 : "Heart my foot|... he means his power generator|. They're all the same|... You just have to say the word raise|."
        globals.emp = 1
    }
    global emplo = 0
    global emp = 0
    proc revel enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.reve == 1
        require globals.revelat == 0
    } then {
        say Bob_Morlock presentation=bobh.hnm : "I'm going to tell you an unbearable truth|, Commander|:"
        say Bob_Morlock presentation=bobg.hnm : "HONK! Switch yourself off for ten seconds|!!!"
        say Bob_Morlock presentation=text_only chatter : "But Cap'n Bob|... I|..."
        say Bob_Morlock presentation=bobf.hnm : "I SAID SWITCH OFF|, GOSH DARN IT|!!!"
        say Bob_Morlock presentation=text_only chatter : "Yes sir|....."
        say Bob_Morlock presentation=text_only chatter : "KRUIIIIK|!!! AAAaaaaaaaaaaaaaaaaaaaaa|!!!"
        say Bob_Morlock presentation=bobf.hnm : "COMMANDER, YOU ARE ME|...."
        say Bob_Morlock presentation=bobg.hnm : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES|..."
        say Bob_Morlock presentation=bobe.hnm : "YOU ARE MUCH MORE THAN A SON TO ME|..."
        say Bob_Morlock presentation=bobf.hnm : "We're the same person|... I am the first self-creating being|!"
        say Bob_Morlock presentation=bobe.hnm : "Thanks to space-time contortion|, I can relive my youth|: YOU ARE BOB|, COMMANDER|..."
        say Bob_Morlock presentation=bobc.hnm : "I am what you'll be in several hundred thousand years|..."
        say Bob_Morlock presentation=bobg.hnm : "OK Honk|, you can switch on|..."
        say Bob_Morlock presentation=text_only chatter : "KROIIIIkkk|!!! -&KRUIIIIkkk|!!! -&Look|, I'm supposed to know everything that goes on around here|!|... Don't tell me you switched off Olga|???"
        say Bob_Morlock presentation=bobf.hnm if_not_shown skip_next=2 : "Cut the whining and get to work|..."
        globals.revelat = 1
        globals.reve = 0
        halt
    }
    global reve = 0
    global revelat = 0
    global viol = 0
    global caches = 0
}

conversations {
    yield

    selector Super_Tromp_choices {
        case "talk" {
            menu "bye_bye" "painting" "culture" "yolk"
            say Super_Tromp presentation=strag_tr.hnm : "The GREAT YOLK was a Slimer|... An important thinker|..." choices "yolk"
            say Super_Tromp presentation=stra_tr.hnm : "He died a long time ago and he's buried here on Vista..." choices "yolk"
            say Super_Tromp presentation=strb_tr.hnm : "This palace was specially built to house the remains of the GREAT YOLK|..." choices "yolk"
            say Super_Tromp presentation=strc_tr.hnm if_not_shown skip_next=1 : "The whole universe admires the GREAT YOLK|..." choices "yolk"
            globals.yo = 1
            say Super_Tromp presentation=text_only : "The portrait in this palace was painted with the GREAT YOLK's own yellow blood|..." choices "painting"
            say Super_Tromp presentation=text_only : "The painting is beyond price|... It is magical|..." choices "painting"
            say Super_Tromp presentation=text_only : "It is said that he who possesses it is immortal|..." choices "painting"
            say Super_Tromp presentation=text_only : "The GREAT YOLK said|: \"One plus one equals three|, thanks to the coefficient of reproduction\"|..." choices "culture"
            say Super_Tromp presentation=text_only : "The GREAT YOLK said|:\"Silence feeds on sound and fury\"|." choices "culture"
            say Super_Tromp presentation=text_only : "The GREAT YOLK said|: \"It takes thirteen murffalos to reproduce|, but one day it will take fourteen\"" choices "culture"
            yield
        }
    }

    selector Maziok_choices {
        case "talk" continues {
            menu "bye_bye" "medicine" "curse"
            say Maziok presentation=ompd.hnm : "Me know good medicine and good doctor|... You be very sick|..." choices "medicine"
            say Maziok presentation=ompe.hnm if_not_shown skip_next=1 : "You have nightmares and you not be lucky|..." choices "medicine"
            offer topic "sorceror"
            say Maziok presentation=ompf.hnm if_not_shown skip_next=1 : "You need sorceror medicine|???" choices "medicine"
            offer topic "sorceror"
            say Maziok presentation=ompg.hnm : "Curse come from land of dead|... You did be bad to dead|..." choices "curse"
            say Maziok presentation=ompb.hnm : "Me scared|..." choices "curse"
            say Maziok presentation=ompd.hnm if_not_shown skip_next=1 : "Yes|, yes|... Me know good sorceror|, friend|..." choices "sorceror"
            offer topic "sorceror"
            say Maziok presentation=ompe.hnm if_not_shown skip_next=1 : "Him live alone on desert planet|..." choices "sorceror"
            globals.zen = 1
        }
        case "planet" {
            menu "bye_bye" "vista" "tromp" "ondoyant" "tourism"
            say Maziok presentation=ompe.hnm : "The planet Vista is where I'm from|... It suits me|..." choices "vista"
            say Maziok presentation=ompd.hnm if_not_shown skip_next=1 : "There's a saying which goes|: \"Hasta la Vista\"" choices "vista"
            offer topic "ekato"
            say Maziok presentation=ompd.hnm : "We Trumps are an ancient people|... We like peace|..." choices "tromp"
            say Maziok presentation=ompd.hnm : "We fear nothing as much as the Trump tail hunters|..." choices "tromp"
            say Maziok presentation=ompd.hnm : "They come in big ships, with enormous weapons attached to their arms|. They are vulgar and uncouth|.."
            say Maziok presentation=ompc.hnm if_not_shown skip_next=1 : "To think there are those who would smoke our tails|..." choices "tromp"
            offer topic "ekato"
            say Maziok presentation=ompd.hnm : "There are even fools that believe in ondoyants|..." choices "ondoyant"
            say Maziok presentation=ompc.hnm if_not_shown skip_next=1 : "ondoyants live only in dreams|..." choices "ondoyant"
            offer topic "ekato"
            yield
        }
    }

    selector Fifi_choices {
        case "hello" {
            menu "bye_bye" "planet" "information" "races"
            say Fifi presentation=ompe.hnm : "Uhh|... Me not remember planet|..." choices "planet"
            say Fifi presentation=ompf.hnm : "Information... Me not understand information|... Uhh|!" choices "information"
            dictionary blank after "Information..."
            say Fifi presentation=ompf.hnm : "You be sure you know talk|, friend|?" choices "races"
            say Fifi presentation=ompc.hnm repeatable : "Uhh|... Me sick|..."
            yield
        }
    }

    selector Bratakas_choices {
        case "talk" {
            menu "bye_bye" "Vistar" "planet" "race" "croolis"
            say Bratakas presentation=trmc_tr.hnm : "You want to talk|, friend..." choices "talk"
            say Bratakas presentation=trmc_tr.hnm : "Vistar is the name of my planet|. I am alone here|..." choices "Vistar"
            say Bratakas presentation=trma_tr.hnm if_not_shown skip_next=1 : "I find peace here|... Nobody to bother me|..." choices "Vistar"
            offer topic "leisure"
            say Bratakas presentation=trmb_tr.hnm if_not_shown skip_next=1 : "It's calm here|. No neighbors|, no noise|, no TV|..." choices "Vistar"
            offer topic "leisure"
            say Bratakas presentation=trmc_tr.hnm if_not_shown skip_next=1 : "Ah|, It's true that the winter nights would be nicer with TV|..." choices "leisure"
            offer topic "leisure"
            say Bratakas presentation=trma_tr.hnm if_not_shown skip_next=1 : "To watch TV|, I'd need a good decoder|..." choices "leisure"
            globals.decodeur = 1
            say Bratakas presentation=trma_tr.hnm : "No shortage of planets|, that's for sure|..." choices "planet"
            say Bratakas presentation=trmc_tr.hnm if_not_shown skip_next=1 : "Planets|! You're quite fascinated by them|..." choices "planet"
            globals.planete = 1
            say Bratakas presentation=trmc_tr.hnm : "Only Tromps here.. We seldom get strangers|..." choices "race"
            say Bratakas presentation=trmb_tr.hnm if_not_shown skip_next=1 : "Big ships pass nearby from time to time|..." choices "race"
            offer topic "leisure"
            say Bratakas presentation=trma_tr.hnm : "Aren't you feeling well|?" choices "croolis"
            say Bratakas presentation=trmb_tr.hnm : "I'm sure you're insulting me|...I don't like insults I don't understand|..." choices "croolis"
            say Bratakas presentation=trmc_tr.hnm : "Don't insult me|, stranger|... I don't like it|..." choices "croolis"
            yield
        }
    }

    selector Beauregard_choices {
        case "talk" {
            menu "bye_bye" "listen" "insist" "treat"
            say Beauregard presentation=hboc.hnm repeatable : "Aaaah|... Eeeerrr..." choices "listen"
            say Beauregard presentation=hbod.hnm : "Aaaa|..." choices "bye_bye"
            say Beauregard presentation=hboe.hnm : "I've been struck by the CURSE of BETAKAM IV|..." choices "insist"
            say Beauregard presentation=text_only chatter if_not_shown skip_next=1 : "That sounds like a bad thing to get struck by|, Commander|..." choices "insist"
            offer topic "gladis"
            say Beauregard presentation=hbof.hnm if_not_shown skip_next=1 : "Gladis is the sun of the Tumul system|. It exploded|..." choices "gladis"
            offer topic "gladis"
            say Beauregard presentation=text_only chatter if_not_shown skip_next=1 : "What do you mean|, a sun|?" choices "gladis"
            offer topic "gladis"
            say Beauregard presentation=hbog.hnm : "Gladis killed every living thing|. It's miracle I survived|... Aaarr.." choices "insist"
            say Beauregard presentation=hboh.hnm : "My body is completely fried|... I must have a new body|... Friend|..." choices "treat"
            say Beauregard presentation=hboi.hnm : "My brain is intact but the rest is history|... Ash|... Aaaarrr|..." choices "treat"
            say Beauregard presentation=text_only chatter : "Better not tire him out|, Commander|..." choices "treat"
            say Beauregard presentation=hboi1.hnm repeatable : "I must have a new body|..." choices "treat"
            say Beauregard presentation=hboj.hnm repeatable : "Aaaarrr"
            yield
        }
    }

    selector Honk_choices {
        case "talk" {
            menu "bye_bye" "help" "message"
            say Honk presentation=text_only chatter repeatable : "I hear and obey|, Commander|..." choices "talk"
            say Honk presentation=text_only chatter repeatable : "Hup|! Commander|..." choices "bye_bye"
            yield
        }
    }

    selector Morning_Oil_choices {
        case "talk" continues {
            menu "hello" "say_nothing" "laugh" "bye_bye"
            say Morning_Oil presentation=morn01.hnm : "Hi Commander" choices "hello"
            say Morning_Oil presentation=morn02.hnm : "Such silence|..." choices "say_nothing"
            say Morning_Oil presentation=morn03.hnm : "Ha ha ha ha ha ha..." choices "laugh"
            say Morning_Oil presentation=morn04.hnm : "Bye bye Commander" choices "bye_bye"
        }
        case "history" continues {
            menu "bye_bye" "war" "croolis" "treasure" "battles" "mastachok"
        }
        case "war" continues {
            menu "bye_bye" "match"
            say Morning_Oil presentation=morn06.hnm : "That was a real bad war|... It all started the day of the boxing match between EVISCERATOR and EMASCULATOR..." choices "war"
            say Morning_Oil presentation=morn03.hnm : "You should've seen it|, Commander|... What a fight|..." choices "war"
            say Morning_Oil presentation=morn04.hnm : "They made BIONIUM bombs|... Those things could blow away whole planets|..." choices "war"
            say Morning_Oil presentation=morn06.hnm : "The whole galaxy seemed to be burning|... BBOOOOMMM|!!! BAM|! RA TA TA TA TA|... Ha! Ha! Ha!" choices "war"
            say Morning_Oil presentation=morn05.hnm : "The boxing match ended badly|. They televised it throughout the universe|..." choices "match"
            say Morning_Oil presentation=morn04.hnm : "The war was between the two Croolis chiefs|, Eviscerator and Emasculator... It was a bad one|..." choices "match"
            say Morning_Oil presentation=morn04.hnm : "The match was televised throughout the universe|... Ahh|, I can picture it now|..." choices "match"
        }
        case "croolis" continues {
            menu "bye_bye" "history" "terror" "eviscerator" "emasculator"
            say Morning_Oil presentation=morn06.hnm : "Croolis are exceptional warriors" choices "croolis"
            say Morning_Oil presentation=morn05.hnm : "My master|, EVISCERATOR specialised in BIONIUM prospection|..." choices "croolis"
            say Morning_Oil presentation=morn06.hnm : "he found BIONIUN in the galactic cyberspace contraction|..." choices "croolis"
            say Morning_Oil presentation=morn07.hnm : "Those Croolis are serious dingbats|!!!" choices "croolis"
            say Morning_Oil presentation=morn08.hnm : "The planets lived in terror for countless years|..." choices "terror"
            say Morning_Oil presentation=morn06.hnm : "Terror was the Croolis secret weapon|..." choices "terror"
            say Morning_Oil presentation=morn03.hnm : "We robots were programmed to feel no fear|..." choices "terror"
            say Morning_Oil presentation=morn04.hnm : "Eviscerator finished up badly|. When SCRUT put a stop to the war|, they jailed him" choices "eviscerator"
            say Morning_Oil presentation=morn05.hnm : "Eviscerator is dangerous|, Commander|. He's a ruthless killer|..." choices "eviscerator"
            say Morning_Oil presentation=text_only chatter if_not_shown skip_next=1 : "Commander|... I'm worried that memories of his old master might make him violent|..." choices "eviscerator"
            globals.viol = 1
            say Morning_Oil presentation=morn06.hnm : "Emasculator is completely brainless|... Mean and stupid|..." choices "emasculator"
            say Morning_Oil presentation=morn03.hnm : "That's one Croolis I hate|..." choices "emasculator"
        }
        case "treasure" continues {
            menu "bye_bye" "history" "hiding_place"
            say Morning_Oil presentation=morn03.hnm : "Ah|! The treasure|. You should've seen it|, Commander|... Incredible|..." choices "treasure"
            say Morning_Oil presentation=morn04.hnm : "Stones from Galabar|, horns from Rla|, authentic Rhinox bone vases|..." choices "treasure"
            say Morning_Oil presentation=morn07.hnm : "Ha! Ha! Hard to say where he hid it|, Commander|..." choices "hiding_place"
            say Morning_Oil presentation=morn06.hnm : "I don't mind giving you a few clues|, but it's confidential information|..." choices "hiding_place"
            say Morning_Oil presentation=morn07.hnm if_not_shown skip_next=1 : "I don't want HONK to hear|..." choices "hiding_place"
            globals.caches = 1
            say Morning_Oil presentation=morn05.hnm : "Millions were wiped out in the battles|. Planets were stripped to the bone|..." choices "battle"
            say Morning_Oil presentation=morn06.hnm : "The Izwals suffered heavy losses|. They weren't ready|..." choices "battle"
            say Morning_Oil presentation=morn07.hnm : "The SCRUT armies finally won after a gigantic battle that shook the galaxy to its knees|.." choices "battle"
            say Morning_Oil presentation=morn06.hnm : "The defeated Croolis ended up on Trashlando|. That's a BAD place|, Commander|..." choices "battle"
        }
        case "mastachok" {
            menu "bye_bye" "history" "information"
            say Morning_Oil presentation=morn06.hnm : "Mastachok is a dead planet|... Nothing lives any more on its surface|..." choices "mastachok"
            say Morning_Oil presentation=morn07.hnm : "The factory was replaced by the jail|... With permanent SCRUT guards|..." choices "mastachok"
            dictionary blank after "guards"
            say Morning_Oil presentation=morn03.hnm : "Mastachok is absolutely polluted|... Nothing more than a cinder block|..." choices "mastachok"
            yield
        }
    }

    selector Bronko_choices {
        case "talk" continues {
            menu "bye_bye" "robot" "cred" "murffalos" "weapons"
        }
        case "robot" continues {
            menu "talk" "bye_bye" "robot" "intelligence" "energy" "technology" "retirement"
            say Bronko presentation=rgbtr6.hnm if_not_shown skip_next=1 : "See you soon|, friend|..." choices "bye_bye"
            end presentation Bronko
            say Bronko presentation=rgbtr3.hnm : "Me robot Bronko AX34 BUTCHER model|..." choices "robot"
            say Bronko presentation=rgbtr4.hnm : "Robot be strong friend|. Robot Bronko know how chop meat with chopper|..." choices "robot"
            say Bronko presentation=rgbtr2.hnm : "Me big robot|... Sophisticated|..." choices "robot"
            say Bronko presentation=rgbtr2.hnm : "Me big cybernetic intelligence|. Much cheap memory|..." choices "intelligence"
            say Bronko presentation=rgbtr3.hnm : "Me know think|. Me smart|..." choices "intelligence"
            say Bronko presentation=rgbtr4.hnm : "Me big CDROM in head... Ha! Ha! Ha! Ha!" choices "intelligence"
            say Bronko presentation=rgbtr3.hnm : "Bronko intelligent..." choices "intelligence"
            say Bronko presentation=rgbtr5.hnm : "Me much energy|: Bronko have fresh batteries|, friend|...." choices "energy"
            say Bronko presentation=rgbtr6.hnm : "Me munch high energy zinc flakes with mercury every day|..." choices "energy"
            say Bronko presentation=rgbtr2.hnm : "You look for batteries|, friend|... Me buy batteries at VENUSIA Supramarket" choices "energy"
            say Bronko presentation=rgbtr5.hnm : "VENUSIA Supramarket sell cheap batteries|. You not see commercial on TV|, friend|?" choices "energy"
            say Bronko presentation=rgbtr2.hnm : "Bronko big technology|, friend|..." choices "technology"
        }
        case "cred" continues {
            menu "talk" "bye_bye" "cred" "buy"
