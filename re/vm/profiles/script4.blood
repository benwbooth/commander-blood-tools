            say Hom presentation=text_only chatter : "Commander, I have an idea|..."
            say Hom presentation=text_only chatter : "Why not give him our D.O.R.K. diploma|? The one we so brilliantly earned on Cyberock..."
            say Hom presentation=text_only chatter : "Maybe that'll remind him of something|..."
            say Hom presentation=text_only resume_at=bra2_dialogue_resume_2 : "TELEPORT D.O.R.K. TO HOM" choices "teleport"
