        say Maziok presentation=ompd.hnm resume_at=tromp1_dialogue_resume_1 : "Ga ga|?" choices "ga" "hello" "planet" "laugh" "joke"
        when {
            require choice == "ga"
        } then {
            say Maziok presentation=text_only if_not_shown skip_next=3 : "ga ga ga ga ga|..."
            tromp1.enabled = false
            choice = none
            jump gaga
        }
        when {
            require choice != "ga"
        } then {
            choice = none
        }
        tromp1_dialogue_resume_1:
        say Maziok presentation=omph.hnm : "GA|..."
        say Maziok presentation=text_only chatter : "Commander|, I don't think he has the power of speech|... And get a load of that trunk..."
        say Maziok presentation=text_only chatter : "Looks like a Tromp-haired rat|! Ha! Ha! Ha|!Ha! Ha!"
        say Maziok presentation=ompg.hnm : "What makes you think MAZIOK can't speak|?"
        say Maziok presentation=ompf.hnm : "You have no respect for custom|..."
        say Maziok presentation=ompi.hnm : "When someone says GA|, you have to answer GA|. That's the tradition..."
        say Maziok presentation=ompf.hnm : "For generations I have said GA when soemone has said GA to me|..."
        say Maziok presentation=ompe.hnm : "You young people have no respect for anything|..."
        say Maziok presentation=ompe.hnm : "When I was young|, we always said GA..."
        say Maziok presentation=ompi.hnm : "You're weird|, stranger. You look like you have the evil eye|..."
        say Maziok presentation=ompj.hnm : "Leave me|... I have things to do|..."
        say Maziok presentation=text_only if_not_shown skip_next=2 : "..."
        tromp1.enabled = false
        end presentation Maziok
    }
