        say Betakam presentation=text_only chatter : "We're in the middle of a conversation with king Betakam|..."
        say Betakam presentation=text_only if_not_shown skip_next=1 : "You're here|, Betakam|??? I can hardly believe it|... I spent years studying your civilization|..."
