    proc tromp1 enabled {
        during travel
        require arche.current_location == Magnu
        require presentation == Maziok
    } then {
        say Maziok presentation=ompe.hnm : "Ga|..."
        say Maziok presentation=text_only chatter : "Hey, you know what he reminds me of? A ball of Tromp hair|. Heh heh..."
