        say Betakam presentation=text_only : "Teleport him some technological gadget|, Commander|..."
        say Betakam presentation=text_only chatter : "I know|, Commander... The Mind Scrambler|!"
        say Betakam presentation=text_only if_not_shown skip_next=1 : "Excellent idea|, Mister Honk|!!!"
