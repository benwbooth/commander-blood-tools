    proc bra1 enabled {
        during travel
        require arche.current_location == Vistar
        require Hom.current_location != aboard
        require Bratakas.current_location == Vistar
        require presentation == Bratakas
    } then {
        when {
            require Bratakas.encounter_count == 1
        } then {
            say Bratakas presentation=trma_tr.hnm : "You seem to fear nothing|... Why have you come to my planet|, stranger|?"
            say Bratakas presentation=trmc_tr.hnm : "Have you any idea who you're talking to|? I am none other than Bratakas|, terror of the planet VISTAR|..."
            say Bratakas presentation=trmb_tr.hnm : "My name strikes fear in all Tromps throughout the galaxy|..."
        }
        say Bratakas presentation=trmc_tr.hnm if_not_shown skip_next=1 : "How can I help you|, stranger|?"
        Bratakas.topic = "talk"
        when {
            require globals.planete == 1
        } then {
            say Bratakas presentation=trma_tr.hnm : "I know a few planets. let me see|... My memory's letting me down here|..."
            say Bratakas presentation=trmb_tr.hnm : "The planet|... I can't seem to recall|..."
            say Bratakas presentation=trmc_tr.hnm : "It'll come to me|..."
        }
        when {
            require globals.decodeur == 1
            require decoder.holder != Bratakas
        } then {
            say Bratakas presentation=text_only chatter : "Commander, what say we give him our old decoder|... He won't pick up very much|, but it might make him happy|..."
            Bratakas.topic = "rien"
            say Bratakas presentation=text_only resume_at=bra1_dialogue_resume_1 : "TELEPORT OLD DECODER TO PLANET VISTAR" choices "teleport"
            when {
                require choice == "teleport"
            } then {
                say Bratakas presentation=text_only if_not_shown skip_next=2 : "TELEPORT DECODER TO BRATAKAS"
                transfer decoder from aboard to Bratakas
                choice = none
            }
        }
        bra1_dialogue_resume_1:
        when {
            require decoder.holder == Bratakas
            require picture.holder != blood
        } then {
            say Bratakas presentation=trmb_tr.hnm : "Oh|, what a nice decoder|... That's quite a gift|, stranger|..."
            Bratakas.topic = "rien"
            say Bratakas presentation=trmc_tr.hnm : "I wonder what I can offer you in exchange|... What would you say to a pretty picture|?"
            say Bratakas presentation=trma_tr.hnm : "It represents the female of your dreams|. What I see is a female Trump|..."
            say Bratakas presentation=trmb_tr.hnm : "They're called ondoyants|... Dream creatures|..."
            say Bratakas presentation=trma_tr.hnm : "This is for you|, stranger|..."
            say Bratakas presentation=trmb_tr.hnm : "Don't look at it too often|... And don't show it to anybody|..."
            say Bratakas presentation=text_only resume_at=bra1_dialogue_resume_2 : "TELEPORT PICTURE TO CRYOBOX" choices "teleport"
            when {
                require choice == "teleport"
            } then {
                say Bratakas presentation=text_only if_not_shown skip_next=3 : "TELEPORT PICTURE TO CRYOBOX"
                transfer picture from Bratakas to aboard
                Bratakas.topic = "talk"
                choice = none
            }
        }
        bra1_dialogue_resume_2:
        when {
            require choice == "bye_bye"
            require globals.decodeur == 0
        } then {
            say Bratakas presentation=text_only if_not_shown skip_next=1 : "Bye bye|..."
            end presentation Bratakas
        }
        when {
            require choice == "bye_bye"
            require globals.decodeur == 1
        } then {
            say Bratakas presentation=trmb_tr.hnm : "Bye bye|... Leaving so soon|?"
            say Bratakas presentation=trmc_tr.hnm : "Hold on|... There's someone who'd like to see you before you leave|..."
            say Bratakas presentation=text_only if_not_shown skip_next=1 : "..."
            navigate to cache
        }
    }
    global planete = 0
    global decodeur = 0
