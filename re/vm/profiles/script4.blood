logic {
    proc init enabled {
    } then {
        sequence_slots[2] = "maledict"
        sequence_slots[3] = "maledict"
        sequence_slots[4] = "maledict"
        sequence_slots[5] = "maledict"
        sequence_slots[1] = "maledict"
        sequence_slots[6] = "present"
        Ron.known = true
        Morning_Oil.current_location = Trashlando
        Outrageor.current_location = machine
        Rotator.current_location = Masta
        Maziok.current_location = Magnu
        Otto_Von_Smile.current_location = Erazo
        Super_Zen.current_location = Crazystone
        Hom.current_location = cache
        Yoko.current_location = Trashlando
        Jerry_Khan.current_location = Shark
        Fifi.current_location = Ron
        Scruter_Jo.current_location = aboard
        Bronko.current_location = aboard
        Beauregard.current_location = aboard
        Anna_Haf.current_location = aboard
        scrambler.holder = blood
        mummy.holder = blood
        dork.holder = blood
        receiver.current_location = aboard
        decoder.holder = aboard
        globals.maledict = 1
        globals.compris = 1
        globals.vbio = 3
        init.enabled = false
    }
    global maledict = 0
    global compris = 0
    global vbio = 0
    proc bronk2 enabled {
        during contact
        require presentation == Bronko
    } then {
        say Bronko presentation=text_only : "Me busy do onboard cooking|. Me make tasty meals for Cap'n Bob|..."
        say Bronko presentation=text_only chatter : "Let him do his job|, Commander|. It's about time we had something edible to eat|..."
        say Bronko presentation=text_only : "Me not have time|, Commander|..."
        say Bronko presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Bronko
    }
    proc scrujo enabled {
        during contact
        require presentation == Scruter_Jo
    } then {
        say Scruter_Jo presentation=scr20.hnm : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
        when {
            require globals.compris == 0
        } then {
            say Scruter_Jo presentation=text_only : "Me explain to you how get BIONIUM..."
            say Scruter_Jo presentation=text_only : "You find BIOXX|. Bioxx be small energy creatures|..."
            say Scruter_Jo presentation=scr02.hnm : "You touch BIOXX once with hand|."
            say Scruter_Jo presentation=text_only chatter : "Sounds like a piece of cake to me|, Commander|!!"
            say Scruter_Jo presentation=scr03.hnm : "If you touch BIOXX twice|, you CAPTURE BIOXX on tip of your finger|..."
            say Scruter_Jo presentation=text_only chatter : "Catch him on the tip of your finger|!!! Sounds easy as pie|, Commander|..."
            say Scruter_Jo presentation=scr04.hnm : "Then you can carry BIOXX to cybernetic MANTAS"
            say Scruter_Jo presentation=scr06.hnm : "You place BIOXX in belly of Manta..."
            say Scruter_Jo presentation=scr05.hnm : "BIOXX stay stuck to MANTAS..."
            say Scruter_Jo presentation=text_only chatter : "I'd love to see that|..."
            say Scruter_Jo presentation=scr07.hnm : "Mantas change BIOXX into BIONIUM..."
            say Scruter_Jo presentation=scr06.hnm : "More BIOXX you give to Mantas, more BIONIUM you get|..."
            dictionary blank after "More"
            say Scruter_Jo presentation=text_only chatter : "Yes|!!! BIONIUM|... I can taste it already|..."
            say Scruter_Jo presentation=scr05.hnm : "To come back from CYBERSPACE|, you touch BLUE BOX|...."
            say Scruter_Jo presentation=scr07.hnm : "You understand|?"
            say Scruter_Jo presentation=text_only chatter : "We understand perfectly|, Mister SCRUTER JO... Right|, Commander?"
        }
        say Scruter_Jo presentation=scr21.hnm : "YOU go|, Commander|..."
        say Scruter_Jo presentation=scr22.hnm : "Ahh! Me feel better|..."
        when {
            require globals.vbio > 0
        } then {
            say Scruter_Jo presentation=scr03.hnm : "Good work|... You did succeed|..."
            say Scruter_Jo presentation=scr04.hnm : "You did get BIONIUM..."
            say Scruter_Jo presentation=text_only chatter : "YES|!!! Commander|, remind me to tell you you're a champ|..."
            say Scruter_Jo presentation=text_only chatter : "This BIONIUM is extraordinary|. My clock frequency's through the roof|..."
            say Scruter_Jo presentation=text_only chatter if_not_shown skip_next=1 : "I feel even smarter|... I can feel I'll be a great help to you|, Commander|..."
            globals.compris = 1
        }
        when {
            require globals.vbio == 0
        } then {
            say Scruter_Jo presentation=scr05.hnm : "Not good|, friend|... You fail|..."
            say Scruter_Jo presentation=text_only chatter : "Commander, you didn't understand the technique|..."
            say Scruter_Jo presentation=text_only chatter : "I need BIONIUM, Commander|. It makes me smarter|..."
            say Scruter_Jo presentation=scr05.hnm : "Ha! Ha! You need much much BIONIUM|. Ha! Ha!..."
            say Scruter_Jo presentation=text_only chatter : "Why don't you shut up|, wiseguy|!!!"
        }
        say Scruter_Jo presentation=scr08.hnm if_not_shown skip_next=1 : "Bye bye|, Commander|. Me return to CYBERSPACE..."
        end presentation Scruter_Jo
    }
    proc recept enabled {
        during contact
        require presentation == receiver
    } then {
        say receiver presentation=text_only : "zzzzzzzzzz shshshshs... crak|..."
        say receiver presentation=text_only chatter : "It won't work, Commander. We're too far away|..."
        say receiver presentation=text_only if_not_shown skip_next=1 : "Krouikk..."
        end presentation receiver
    }
    proc beau enabled {
        during contact
        require presentation == Beauregard
        require globals.maledict == 1
    } then {
        say Beauregard presentation=zhboa.hnm : "AAAAAHHH. Commander|, I'm cursed..."
        say Beauregard presentation=zhbob.hnm : "AAAAAAAAA|!!!"
        say Beauregard presentation=zhbod.hnm : "OOOOOOOO|!!!"
        say Beauregard presentation=zhbol.hnm : "The the CURSE|...."
        say Beauregard presentation=zhbok.hnm : "hhhhhhhhhhh"
        say Beauregard presentation=zhbol.hnm : "CURSE..."
        say Beauregard presentation=text_only chatter : "Gee|, Commander|. That doesn't sound like fun|...|!!!"
        say Beauregard presentation=zhbol.hnm : "aaaa..."
        say Beauregard presentation=text_only if_not_shown skip_next=1 : "..."
        end presentation Beauregard
    }
    proc beau_2 as "beau" enabled {
        during contact
        require presentation == Beauregard
        check Attrox is unknown
        require globals.maledict == 0
    } then {
        say Beauregard presentation=bor_b_tr.hnm : "Ahhhh... Commander|... I feel better now|..."
        say Beauregard presentation=bor_c_tr.hnm : "I saw the flames of hell, Commander. Not a pretty sight.."
        say Beauregard presentation=bor_d_tr.hnm : "Honk has explained our problem, Commander. Looks like the mummy of BETAKAM IV threw a spell on us..."
        say Beauregard presentation=bor_e_tr.hnm : "Commander|... I'd like to find the planet PATAGOS and meet king BETAKAM IV..."
        dictionary blank after "IV..."
        say Beauregard presentation=borb_atr.hnm : "It's amazing, Commander... We have his mummy aboard and yet we can meet him as a living being..."
        say Beauregard presentation=bor_e_tr.hnm : "That's a unique archeological experiment..."
        say Beauregard presentation=borb_atr.hnm : "According to the ancient texts from PATAGOS, Tumul translates as Attrox..."
        say Beauregard presentation=bor_b_tr.hnm : "So the thing to do is find the planet Attrox, Commander..."
        say Beauregard presentation=text_only chatter : "Commander, Mister Beauregard is so amazingly intelligent..."
        say Beauregard presentation=bor_b_tr.hnm if_not_shown skip_next=1 : "See you soon, Commander..."
        end presentation Beauregard
    }
    proc beaureg enabled {
        during contact
        require presentation == Beauregard
        require Attrox.known
        require globals.maledict == 0
    } then {
        say Beauregard presentation=bor_b_tr.hnm : "Ahhhh... Commander|... I feel better now|..."
        say Beauregard presentation=bor_c_tr.hnm : "I saw the flames of hell, Commander. Not a pretty sight.."
        say Beauregard presentation=bor_b_tr.hnm if_not_shown skip_next=1 : "See you soon, Commander..."
        end presentation Beauregard
    }
    proc fif enabled {
        during travel
        require arche.current_location == Ron
        require presentation == Fifi
    } then {
        say Fifi presentation=ompa.hnm : "Caa..."
        say Fifi presentation=ompb.hnm : "aake.."
        say Fifi presentation=ompb.hnm : "eat|..."
        when {
            require Fifi.encounter_count == 1
        } then {
            say Fifi presentation=ompa.hnm : "Me Fifi|... Hee Hee Hee|..."
            say Fifi presentation=text_only chatter : "Heh heh... That guy's funny, Commander... I love his name|..."
            say Fifi presentation=ompb.hnm : "Fifi like gift"
            say Fifi presentation=ompc.hnm : "OOO! eat"
            say Fifi presentation=ompa.hnm : "After eat|, Fifi sleep..."
            say Fifi presentation=ompc.hnm : "Hee hee hee|..."
        }
        say Fifi presentation=ompa.hnm : "Me go|. You bad vibrations|..."
        say Fifi presentation=ompc.hnm : "Me scared|..."
        say Fifi presentation=text_only chatter : "Commander, maybe we could use the Mind Scrambler..."
        say Fifi presentation=text_only resume_at=fif_dialogue_resume_1 : "USE MIND SCRAMBLER" choices "use" "refuse"
        when {
            require choice == "use"
        } then {
            choice = none
        }
        when {
            require choice == "refuse"
        } then {
            say Fifi presentation=text_only chatter : "You're calling the shots, Commander..."
            say Fifi presentation=ompa.hnm : "Bye bye|... Me go phone female Tromp"
            say Fifi presentation=ompc.hnm : "Trompette live on planet Magnu... Heee! Hee|! Hee! Me like female Tromp|..."
            say Fifi presentation=ompb.hnm if_not_shown skip_next=1 : "Magnu be at coordinates x453 y543..."
            Magnu.known = true
            say Fifi presentation=text_only if_not_shown skip_next=4 : "Bye bye..."
            fif.enabled = false
            fif1.enabled = true
            choice = none
            end presentation Fifi
        }
        fif_dialogue_resume_1:
        say Fifi presentation=ompf.hnm if_not_shown skip_next=1 : "Zorglu... Eta ouch..."
        request sequence "brouil.hnm"
        say Fifi presentation=ompd.hnm : "Haga...."
        say Fifi presentation=ompe.hnm : "HATA HATA..."
        say Fifi presentation=text_only : "HOGLO HOGLO..."
        say Fifi presentation=text_only chatter if_not_shown skip_next=1 : "You can interrogate him, Commander. He's ready..."
        Fifi.topic = "hello"
        say Fifi presentation=text_only if_not_shown skip_next=2 : "Bye bye, Commander..." choices "bye_bye"
        Fifi.topic = "rien"
        end presentation Fifi
    }
    proc fif1 disabled {
        during travel
        require arche.current_location == Ron
        require presentation == Fifi
    } then {
        say Fifi presentation=ompd.hnm : "GA... Me Fifi|... Hee Hee Hee..."
