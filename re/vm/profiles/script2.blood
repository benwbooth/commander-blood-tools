        say Izwalito presentation=text_only : "Izwal people of Corpo die of hunger|... CRY|... CRY|..."
        say Izwalito presentation=text_only : "You bring murffalo|, or you in trouble with BOSSANOVA|..."
        say Izwalito presentation=text_only : "IZWALITO CRY MUCH|..."
