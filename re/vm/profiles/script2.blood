        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Commander"
        }
        when {
            require globals.pre == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Predatorus|..."
            say Izwalito presentation=iswe.hnm : "Me not believe you be Predatorus|. Him chop Izwals in meaty chunks|..."
        }
        when {
            require globals.tar == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Tarzoom|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Tarzoom|... Tarzoom smell worse|..."
        }
        when {
            require globals.sup == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Hyper|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Hyper Man|... Alter ego not wear glasses|..."
        }
        say Izwalito presentation=text_only if_not_shown skip_next=2 : "stop"
        globals.A11 = 2
        end presentation Izwalito
    }
