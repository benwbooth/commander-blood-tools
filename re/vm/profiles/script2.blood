    proc Corpo6 enabled {
        during travel
        require Rondo.known
        require globals.G1 == 1
        require presentation == Izwalito
    } then {
        say Izwalito presentation=iswb.hnm : "Izwalito happy see you|, dear friend from sky and stars|..."
        say Izwalito presentation=iswb.hnm : "Me must go visit villages|..."
        say Izwalito presentation=iswc.hnm : "Me not can talk|..."
        say Izwalito presentation=iswc.hnm if_not_shown skip_next=2 : "Bye bye|, dear friend from sky|..."
        Izwalito.current_location = Trashlando
        end presentation Izwalito
    }
    global G1 = 0
    proc Corpo1 enabled {
        during travel
        require globals.A1 == 0
        require arche.current_location == Corpo
        require presentation == Izwalito
    } then {
        say Izwalito presentation=text_only chatter : "Olga reporting for \"instant translation\" duty|:"
        say Izwalito presentation=iswb.hnm : "Oooooh! You stranger|... You come from sky|... FEAR|... FEAR|..."
        say Izwalito presentation=iswf.hnm : "YOU NOT KILL ME|... ME NICE|. Me be IZWALITO|..."
        say Izwalito presentation=text_only chatter : "I don't think we can trust that creature|, Commander|. Better watch it carefully|..."
        say Izwalito presentation=text_only chatter : "It's a species of common space rat|..."
        say Izwalito presentation=iswb.hnm : "Izwalito be very hungry|... Izwalito want eat|..."
        say Izwalito presentation=text_only chatter : "It's just what I figured|, Commander|. He wants our food|..."
        say Izwalito presentation=iswb.hnm resume_at=Corpo1_dialogue_resume_1 : "You say your name to Izwalito|, stranger|?" choices "hyper_man" "predatorus" "commander_blood" "Mousy" "jules_verne" "Exterminator" "tarzoom"
        when {
            require choice == "commander_blood"
        } then {
            say Izwalito presentation=iswb.hnm if_not_shown skip_next=1 : "Me greet you Commander."
            globals.blo = 1
            choice = none
        }
        when {
            require choice == "hyper_man"
        } then {
            say Izwalito presentation=iswa1.hnm if_not_shown skip_next=1 : "Me greet you Hyper"
            globals.sup = 1
            choice = none
        }
        when {
            require choice == "predatorus"
        } then {
            say Izwalito presentation=iswa1.hnm if_not_shown skip_next=1 : "Me greet you Predatorus"
            globals.pre = 1
            choice = none
        }
        when {
            require choice == "Mousy"
        } then {
            say Izwalito presentation=iswa1.hnm if_not_shown skip_next=1 : "Me greet you friend Mousy"
            globals.mic = 1
            choice = none
        }
        when {
            require choice == "jules_verne"
        } then {
            say Izwalito presentation=iswa1.hnm if_not_shown skip_next=1 : "Me greet you friend Jules"
            globals.jul = 1
            choice = none
        }
        when {
            require choice == "Exterminator"
        } then {
            say Izwalito presentation=iswa1.hnm if_not_shown skip_next=1 : "Me greet you friend Exterminator"
            globals.ter = 1
            choice = none
        }
        when {
            require choice == "tarzoom"
        } then {
            say Izwalito presentation=iswa1.hnm if_not_shown skip_next=1 : "Me greet you friend Tarzoom"
            globals.tar = 1
            choice = none
        }
        Corpo1_dialogue_resume_1:
        say Izwalito presentation=text_only chatter : "HONK REPORTS IN|:|...|...|..."
        say Izwalito presentation=text_only chatter : "This Izwalito joker doesn't trust you|, Commander|..."
        say Izwalito presentation=text_only chatter if_not_shown skip_next=1 : "Try to humor him|. We'll soon find out the truth behind that innocent mask|... Heh|! Heh|!"
        Izwalito.topic = "talk"
        when {
            require globals.secret == 1
            require !Rondo.known
        } then {
            say Izwalito presentation=iswb.hnm : "You be very curious|, friend|..."
            say Izwalito presentation=iswc.hnm resume_at=Corpo1_dialogue_resume_2 : "You can keep secret|?" choices "yes" "no"
            when {
                require choice != "yes"
            } then {
                say Izwalito presentation=iswb.hnm if_not_shown skip_next=3 : "Me tell big secret|..."
                Izwalito.topic = "know"
                globals.secret = 0
                choice = none
            }
            when {
                require choice == "no"
            } then {
                say Izwalito presentation=text_only chatter : "Commander|!!! You're being manipulated by a rat|... You should've answered YES|..."
                say Izwalito presentation=iswd.hnm if_not_shown skip_next=1 : "You like make joke|..."
                choice = none
            }
        }
        Corpo1_dialogue_resume_2:
        say Izwalito presentation=text_only chatter if_not_shown skip_next=1 : "STOP"
        timer[2] = 80
        when {
            require timer[2] == 0
        } then {
            timer[2] = disabled
            ad.enabled = true
        }
        say Izwalito presentation=text_only if_not_shown skip_next=1 : "You bye bye|?" choices "bye_bye"
        globals.adieu = 1
        when {
            require Magnus.known
        } then {
            say Izwalito presentation=text_only chatter : "HONK REPORTING AT THIS TIME:"
            say Izwalito presentation=text_only chatter : "COMMANDER|, YOU'RE NOT GONNA BELIEVE THIS|... THE RAT GAVE US A PLANETARY POSITION|..."
        }
        when {
            require Rondo.known
        } then {
            say Izwalito presentation=text_only chatter : "COMPUTER ENTITY HONK|:"
            say Izwalito presentation=text_only chatter : "COMMANDER|, Ratface knows a lot more than he's telling|..."
            say Izwalito presentation=text_only chatter if_not_shown skip_next=1 : "You should get him to spill the beans|..."
            globals.trak2c = 1
        }
        when {
            require globals.adieu == 1
        } then {
            ad.enabled = true
            globals.adieu = globals._2D1
        }
    }
    global blo = 0
    global sup = 0
    global pre = 0
    global mic = 0
    global jul = 0
    global ter = 0
    global tar = 0
    global secret = 0
    global trak2c = 0
    proc ad disabled {
        during travel
    } then {
        when {
            require !Magnus.known
        } then {
            say Izwalito presentation=iswc.hnm : "If you have garbage, me give you coodinates of intergalactic dump, friend|..."
            say Izwalito presentation=iswe.hnm if_not_shown skip_next=1 : "Planet Magnus be in Magnalus x342 y543 system|... There be intergalactic garbage dump"
            mark Magnus as known
            say Izwalito presentation=text_only chatter : "Commander|, he gave us a planetary position|... Don't you just love these ratfaced folks|..."
            say Izwalito presentation=iswf.hnm if_not_shown skip_next=1 : "You promise not pollute, friend|..."
            globals.trak2b = 1
        }
        say Izwalito presentation=iswb.hnm : "Me must go|, friend|... Me have big date with female|..."
        say Izwalito presentation=iswc.hnm : "You come back in moment|! Me wait for you|, nice friend|..."
        say Izwalito presentation=iswe.hnm : "You leave|, quick|..."
        when {
            require globals.mic == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Mousy|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Mousy|. You not have giant ears|..."
        }
        when {
            require globals.ter == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Exterminator|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Exterminator|. Where be truck|?|..."
        }
        when {
            require globals.jul == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Jules|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Jules Verne|. You not be so old|..."
        }
        when {
            require globals.blo == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Commander|."
        }
        when {
            require globals.pre == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Predatorus|..."
            say Izwalito presentation=iswe.hnm : "Me not believe you be Predatorus|. You easy to see|..."
        }
        when {
            require globals.tar == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Tarzoom|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Tarzoom|... You not yodel|..."
        }
        when {
            require globals.sup == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Hyper|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Hyper Man|... Where be cape|?|..."
        }
        say Izwalito presentation=text_only if_not_shown skip_next=4 : "stop"
        globals.A1 = 1
        globals.trak2 = 1
        ad.enabled = false
        end presentation Izwalito
    }
    proc Corpo2 enabled {
        during travel
        require arche.current_location == Corpo
        require globals.A1 == 1
        require presentation == Izwalito
    } then {
        say Izwalito presentation=text_only chatter : "Olga on station for \"simul-tran\" services|:"
        say Izwalito presentation=iswe.hnm : "Yipee|! Me happy|... You come back|..."
        say Izwalito presentation=iswf.hnm : "Me like you|..."
        say Izwalito presentation=iswg.hnm : "Izwal people be very hungry|. We starve|. You help us|..."
        say Izwalito presentation=iswa.hnm : "You go planet MOSKITO|, buy frozen murffalo meat|..."
        say Izwalito presentation=iswe.hnm : "Me give you one CRED to buy meat|..."
        say Izwalito presentation=text_only resume_at=Corpo2_dialogue_resume_1 : "TELEPORT CRED TO ARK" choices "teleport" "refuse"
        when {
            require choice == "teleport"
        } then {
            say Izwalito presentation=text_only if_not_shown skip_next=2 : "CRED TELEPORTED TO ARK"
            transfer cred from Izwalito to aboard
            choice = none
        }
        when {
            require choice == "refuse"
        } then {
            say Izwalito presentation=text_only chatter : "Commander|, you should have accepted|..."
            say Izwalito presentation=iswe.hnm : "Me sad|. Me not like you|... Bye bye|..."
            say Izwalito presentation=iswb.hnm if_not_shown skip_next=2 : "Bye bye|..."
            choice = none
            end presentation Izwalito
        }
        Corpo2_dialogue_resume_1:
        say Izwalito presentation=iswb.hnm if_not_shown skip_next=1 : "Moskito be 124325 degrees in galactic cluster B12"
        mark Moskito as known
        say Izwalito presentation=text_only chatter : "COMMANDER|, YOU'RE NOT GONNA BELIEVE THIS|... THE RAT GAVE US A PLANETARY POSITION|..."
        say Izwalito presentation=iswa.hnm : "You take care of CRED|, friend|..."
        say Izwalito presentation=iswg.hnm : "Me look forward see you back|, friend from sky and stars|..."
        say Izwalito presentation=iswf.hnm : "Izwal people trust you|..."
        say Izwalito presentation=text_only chatter : "REPORT FROM HONK|, ONBOARD BIOCONSCIOUSNESS|:"
        say Izwalito presentation=text_only chatter : "Have you noticed that rat has a trunk|, Commander|? Believe me|, that's bad|..."
