        globals.adieu = 0
        say Bob_Morlock presentation=text_only chatter : "Yes sir, Cap'n Bob|. I'm locating the seringe even as I utter these words|..."
        say Bob_Morlock presentation=bobf.hnm : "Be careful|... Find a spot with some flesh on it|. The last time|, you stuck the needle straight into a bone|!!!"
        say Bob_Morlock presentation=text_only chatter : "Yes|! Yes|! Cap'n Bob|, I'll be careful|, I'll shoot another buttock, I'll choose the third one|..."
        say Bob_Morlock presentation=bobd.hnm if_not_shown skip_next=1 : "I'm listening|, Commander|..."
