            say Daddy_Gluxx presentation=glu02.hnm : "I know of a terrible place|... Nobody speaks of it|..."
            say Daddy_Gluxx presentation=glu02.hnm : "It's the clinic on the planet Erazor|. Mysterious things happen there|, you know|..."
            say Daddy_Gluxx presentation=glu02.hnm : "Do not venture near that place|... ERAZORUS AS666 constellation...."
            say Daddy_Gluxx presentation=text_only chatter if_not_shown skip_next=2 : "Commander|... Commander|... Unless I'm mistaken|, that sounded like planetary coordinates|!"
            Erazor.known = true
            globals.trak25 = 1
        }
        say Daddy_Gluxx presentation=glu03.hnm if_not_shown skip_next=2 : "Bye bye|, sir|..." choices "bye_bye"
        ERA.enabled = true
        end presentation Daddy_Gluxx
    }
    proc ERA disabled {
        when {
            require Erazor.known
        } then {
            Daddy_Gluxx.current_location = Trashlando
            ERA.enabled = false
        }
    }
    proc oto1 enabled {
        during travel
        require arche.current_location == Erazor
        require presentation == Otto_Von_Smile
        require globals.P1 == 0
    } then {
        say Otto_Von_Smile presentation=doc04.hnm if_not_shown skip_next=1 : "Welcome|, dear dear client|. Take a seat|. Our 3 star clinic is happy to have you|..."
        globals.trak26 = 1
        say Otto_Von_Smile presentation=doc03.hnm : "I am the well-known Doctor OTTO VON SMILE|. Why not be happy|, since I can make life last for ever|... Ha! Ha! Ha!"
        say Otto_Von_Smile presentation=text_only chatter : "Commander, this guy doesn't feel right to me|... Stay alert|..."
        say Otto_Von_Smile presentation=doc05.hnm : "You seek youth through the ageless power of plants|? A new and vibrant body organ perhaps|? A little plastic surgery|? Here|, all is possible|!"
        say Otto_Von_Smile presentation=text_only chatter : "Yuk|!!! Let's get out of here|, Commander..."
        say Otto_Von_Smile presentation=doc06.hnm resume_at=oto2 : "What miracles may I perform for you|, dear dear client|?" choices "grow_young" "transplant" "surgery"
        when {
            require choice == "grow_young"
        } then {
            say Otto_Von_Smile presentation=doc07.hnm : "Ha! Ha! Youth|! How exquisitely unoriginal|... And so wildly expensive|! Tell me|, do you have 200,000 creds|?"
            say Otto_Von_Smile presentation=doc08.hnm : "No|? You are POOR|? How ghastly for you|. ONLY THE RICH MAY TASTE ETERNITY|!!"
            say Otto_Von_Smile presentation=text_only chatter : "What a geek|, Commander... Maybe we should wake Cap'n Bob and tell him about eternity|..."
            say Otto_Von_Smile presentation=doc03.hnm : "Another time perhaps|, dear client and|, dare I hope|, friend|! Ha! Ha! Ha!..."
            say Otto_Von_Smile presentation=text_only if_not_shown skip_next=2 : "stop"
            choice = none
            end presentation Otto_Von_Smile
        }
        when {
            require choice == "transplant"
        } then {
            say Otto_Von_Smile presentation=doc06.hnm : "Ha! Ha! A new and vibrant retina|? Well|, I have a simply gigantic selection to choose from|..."
            say Otto_Von_Smile presentation=doc07.hnm : "For those who desire to see far or near or very near indeed|! Ha! Ha! These are lenses of the very highest quality|..."
            say Otto_Von_Smile presentation=doc08.hnm : "Each sells for the paltry sum of 2000 creds|... A snip at the price|..."
            say Otto_Von_Smile presentation=text_only chatter : "Commander|, that's exactly what Mister MAXXON needs for his telescope|..."
            say Otto_Von_Smile presentation=doc04.hnm : "But you do not have 2000 creds|, do you|? I find the poor so tasteless|!"
            say Otto_Von_Smile presentation=doc03.hnm : "Another time perhaps|, dear client|..."
            say Otto_Von_Smile presentation=text_only if_not_shown skip_next=3 : "stop"
            choice = none
            globals.P1 = 1
            end presentation Otto_Von_Smile
        }
        when {
            require choice == "surgery"
        } then {
            say Otto_Von_Smile presentation=doc03.hnm : "Ha! Ha! A little operation|! Just like everybody else|... It's divinely expensive|, naturally|... Do you have 100,000 creds|?"
            say Otto_Von_Smile presentation=doc06.hnm : "No|, you don't have such a sum|... Well run along and get it|..."
            say Otto_Von_Smile presentation=text_only chatter : "What a slimeball|, Commander..."
            say Otto_Von_Smile presentation=doc07.hnm : "Another time perhaps|, dear client and|, dare I hope|, friend|! Ha! Ha! Ha!|..."
            say Otto_Von_Smile presentation=text_only if_not_shown skip_next=7 : "stop"
            choice = none
            end presentation Otto_Von_Smile
        }
    }
    global P1 = 0
    proc oto2 enabled {
        during travel
        require arche.current_location == Erazor
        require presentation == Otto_Von_Smile
        require globals.P1 == 1
    } then {
        say Otto_Von_Smile presentation=doc03.hnm : "Well hello|, dear client|. Do take a seat and admire our 3 star clinic|!"
        say Otto_Von_Smile presentation=doc05.hnm : "I am as you probably know the admired and respected Doctor OTTO VON SMILE... Ha! Ha! Ha!"
        say Otto_Von_Smile presentation=doc06.hnm : "So you are interested in optical lenses|... I see|! So to speak|..."
        say Otto_Von_Smile presentation=doc07.hnm : "Allow me to propose a deal|... I would like to count SLIMERS among my dear clientele|. You wouldn't happen to know of any Slimer planets|?|..."
        say Otto_Von_Smile presentation=doc04.hnm : "Why don't you tell me the name of a Slimer planet and I'll give you a lovely little lens|. Just one lens|... You'll have to pay for the other|... Ha! Ha! ha!"
        say Otto_Von_Smile presentation=doc05.hnm resume_at=oto2_dialogue_resume_1 : "I'm waiting|..." choices "Corpo" "Ekatomb" "Kult" "Troma" "Cyberock" "Moskito" "Tumul"
        when {
            require choice == "Ekatomb"
        } then {
            globals.eka = 1
            choice = none
        }
        when {
            require choice != "Ekatomb"
        } then {
            choice = none
        }
        oto2_dialogue_resume_1:
        say Otto_Von_Smile presentation=doc03.hnm : "I'll just send some of my drones to verify what you claim|..."
        say Otto_Von_Smile presentation=doc08.hnm : "If you've told me the truth|, why|, then you shall have your little lens|..."
        say Otto_Von_Smile presentation=doc06.hnm : "Bye bye for the present|, dear dear client|..."
        say Otto_Von_Smile presentation=text_only if_not_shown skip_next=2 : "stop"
        globals.P1 = 2
        end presentation Otto_Von_Smile
    }
    proc oto3 enabled {
        during travel
        require arche.current_location == Erazor
        require presentation == Otto_Von_Smile
        require globals.P1 == 2
        require globals.eka == 1
    } then {
        say Otto_Von_Smile presentation=doc03.hnm : "Well hello|, dear client|. Do take a seat and admire our 3 star clinic|!"
        say Otto_Von_Smile presentation=doc06.hnm : "I am the immensely gifted Doctor OTTO VON SMILE... Ha! Ha! Ha!"
        say Otto_Von_Smile presentation=doc07.hnm : "You want optical lens|... I see|, so to speak|!"
        say Otto_Von_Smile presentation=doc04.hnm : "The little expedition is winging its way back even now|..."
        say Otto_Von_Smile presentation=doc01.hnm : "Your information proved quite accurate|. Well done|! Thanks to you|, our Slimer friends shall soon be able to avail of my services|!"
        say Otto_Von_Smile presentation=doc03.hnm : "And now|, as promised|, one lens|!"
        say Otto_Von_Smile presentation=text_only resume_at=oto3_dialogue_resume_1 : "TELEPORT LENS TO ARK|:" choices "teleport"
        when {
            require choice == "teleport"
        } then {
            say Otto_Von_Smile presentation=text_only chatter if_not_shown skip_next=2 : "LENS TELEPORTED TO CRYOBOX|."
            transfer lens from Otto_Von_Smile to aboard
            choice = none
        }
        oto3_dialogue_resume_1:
        say Otto_Von_Smile presentation=doc02.hnm : "thank you and goodbye|, dear DEAR client|..."
        say Otto_Von_Smile presentation=text_only if_not_shown skip_next=3 : "stop"
        globals.P1 = 4
        globals.trak27 = 1
        end presentation Otto_Von_Smile
    }
    proc oto4 enabled {
        during travel
        require arche.current_location == Erazor
        require presentation == Otto_Von_Smile
        require globals.P1 == 2
        require globals.eka == 0
    } then {
        say Otto_Von_Smile presentation=doc01.hnm : "Well hello|, dear client|. Do take a seat and admire our 3 star clinic|!"
        say Otto_Von_Smile presentation=doc02.hnm : "As you no doubt know|, I am none other than Doctor OTTO VON SMILE... Ha! Ha! Ha!"
        say Otto_Von_Smile presentation=doc03.hnm : "And you are interested in optical lenses... Yes|, I can see that quite clearly|!"
        say Otto_Von_Smile presentation=doc04.hnm : "The little expedition is winging its way back even now|..."
        say Otto_Von_Smile presentation=doc05.hnm : "You were quite mistaken|, dear friend|. The planet you mentioned is Slimerless|!"
        say Otto_Von_Smile presentation=doc06.hnm resume_at=oto4_dialogue_resume_1 : "So|, am I to have the name of the planet|?" choices "Corpo" "Ekatomb" "Kult" "Troma" "Cyberock" "Moskito" "Tumul"
        when {
            require choice == "Ekatomb"
        } then {
            globals.eka1 = 1
            choice = none
        }
        when {
            require choice != "Ekatomb"
        } then {
            choice = none
        }
        oto4_dialogue_resume_1:
        say Otto_Von_Smile presentation=doc03.hnm : "I'll just send some more of my drones to verify what you claim|..."
        say Otto_Von_Smile presentation=doc01.hnm : "If you've told me the truth|, then you shall have your little lens|..."
        say Otto_Von_Smile presentation=doc02.hnm : "Bye bye for the present|, dear dear client|..."
        say Otto_Von_Smile presentation=text_only if_not_shown skip_next=2 : "stop"
        oto5.enabled = true
        end presentation Otto_Von_Smile
    }
    global eka1 = 0
    proc oto5 disabled {
        require globals.eka1 == 1
    } then {
        globals.eka = 1
    }
    proc oto6 enabled {
        during travel
        require arche.current_location == Erazor
        require presentation == Otto_Von_Smile
        require lens.holder != Otto_Von_Smile
    } then {
        say Otto_Von_Smile presentation=doc03.hnm : "Hello|, dear client|. Please don't sit|..."
        say Otto_Von_Smile presentation=doc06.hnm : "The astonishing Doctor OTTO VON SMILE is very busy indeed|... Ha! Ha! Ha!"
        say Otto_Von_Smile presentation=doc07.hnm : "I simply cannot help you for the moment|..."
        say Otto_Von_Smile presentation=doc04.hnm : "Do come back another time|..."
        say Otto_Von_Smile presentation=doc02.hnm : "Thank you once more for your delightful visit|, dear DEAR client|..."
        say Otto_Von_Smile presentation=text_only if_not_shown skip_next=1 : "stop"
        end presentation Otto_Von_Smile
    }
    proc prep enabled {
        require Morning_Oil.encounter_count == 1
    } then {
        timer[7] = 20
        Bug_Deluxe.known_objects += blood
        prep.enabled = false
    }
    proc pub1 enabled {
        require timer[7] == 0
    } then {
        Bug_Deluxe.known = true
        queue presentation Bug_Deluxe
        timer[7] = disabled
        pub2.enabled = true
        pub1.enabled = false
    }
    proc pub2 disabled {
        during bridge
        require presentation == Bug_Deluxe
    } then {
        say Bug_Deluxe presentation=text_only if_not_shown skip_next=1 : "COMMERCIAL|... COMMERCIAL|... COMMERCIAL|..."
        sequence_slots[3] = "venus"
        say Bug_Deluxe presentation=text_only : "FOR ALL SPENDING MOMENTS|, COME TO VENUSIA"
        say Bug_Deluxe presentation=text_only : "FABULOUS BARGAINS|... BRING PLENTY OF CREDS..."
        say Bug_Deluxe presentation=text_only : "MORE FOR YOUR CREDS AT VENU-USIA-AA|... Watch tv channel three|..."
        say Bug_Deluxe presentation=text_only : "VENUSIA 325467 DEGREES, 23 GALAXY B BABY1..."
        say Bug_Deluxe presentation=text_only : "CRUIK..........."
        say Bug_Deluxe presentation=text_only if_not_shown skip_next=2 : "stop"
        Venusia.known = true
        end presentation Bug_Deluxe
    }
    proc monop1 enabled {
        require arche.current_location == Venusia
        require presentation == Bug_Deluxe
    } then {
        say Bug_Deluxe presentation=sytr_2.hnm : "Hi there|, Comsumer Comrade|. Welcome to VENUSIA SUPRAMARKET"
        say Bug_Deluxe presentation=sytr_6.hnm resume_at=monop2 : "Wanna buy a SUPRA product at VENUSIA?" choices "yes" "no"
        when {
            require choice == "yes"
        } then {
            monop2.enabled = true
            choice = none
        }
        when {
            require choice == "no"
        } then {
            say Bug_Deluxe presentation=sytr_8.hnm : "NO|! HA HA!! Forgot our CREDs|, did we|?"
            say Bug_Deluxe presentation=sytr_3.hnm : "Have a happy day|, comrade|."
            say Bug_Deluxe presentation=text_only if_not_shown skip_next=2 : "stop"
            choice = none
            end presentation Bug_Deluxe
        }
    }
    proc monop2 disabled {
        require arche.current_location == Venusia
        during travel
        require presentation == Bug_Deluxe
    } then {
        say Bug_Deluxe presentation=sytr_7.hnm : "You got the CREDs? At VENUSIA|, it's CREDs CREDs CREDs|, Consumer Comrade|..."
        when {
            require globals.PP1 == globals._2D1
            require globals.ach == globals._2D1
            require cred.holder != blood
        } then {
            say Bug_Deluxe presentation=text_only : "No CREDs|, huh|?... That's not an attitude we care for at VENUSIA|!"
            say Bug_Deluxe presentation=text_only if_not_shown skip_next=2 : "stop"
            monop2.enabled = false
            end presentation Bug_Deluxe
        }
        when {
            require globals.PP1 == 1
            require cred.holder != blood
        } then {
            say Bug_Deluxe presentation=sytr_7.hnm if_not_shown skip_next=1 : "It's your luck-lucky day|, consumer comrade|. You just won a free CRED|!!!"
            request sequence "pubven1.hnm"
            say Bug_Deluxe presentation=text_only chatter resume_at=monop2_dialogue_resume_1 : "TELEPORT CRED TO ARK" choices "teleport"
            when {
                require choice != "teleport"
            } then {
                say Bug_Deluxe presentation=text_only if_not_shown skip_next=1 : "CRED TELEPORTED TO ARK"
                transfer cred from Bug_Deluxe to aboard
                say Bug_Deluxe presentation=sytr_7.hnm : "Ahhh|! Lady luck loves a consumer|, comrade|... Happy spending|!"
                say Bug_Deluxe presentation=sytr_6.hnm : "And remember|... \"MORE FOR YOUR CREDS AT VENU-USIA-AAA|!\""
                say Bug_Deluxe presentation=sytr_7.hnm if_not_shown skip_next=3 : "Bye bye comrade consumer..."
                globals.PP1 = globals._2D1
                choice = none
                end presentation Bug_Deluxe
            }
        }
        monop2_dialogue_resume_1:
        when {
            require cred.holder == blood
        } then {
            say Bug_Deluxe presentation=sytr_3.hnm if_not_shown skip_next=2 : "What would you like to splurge your creds on|, Supra Comrade?"
            timer[7] = 500
            Bug_Deluxe.topic = "department"
        }
        say Bug_Deluxe presentation=text_only if_not_shown skip_next=1 : "TELEPORT CRED ON VENUSIA|..." choices "buy"
        request sequence "pion.hnm"
        when {
            require globals.ach == 1
        } then {
            say Bug_Deluxe presentation=sytr_6.hnm : "Thank you for enjoying VENUSIA the SUPRAMARKET|. VENUSIA hopes to see you again soon|..."
            say Bug_Deluxe presentation=text_only if_not_shown skip_next=3 : "stop"
            globals.ach = globals._2D1
            monop2.enabled = false
            end presentation Bug_Deluxe
        }
    }
    global ach = 0
    proc finscr1 enabled {
        check Kortex is known
        require globals.C1 == 6
        require lens.holder == Maxxon
        require Scruter_Jo.current_location == aboard
        require Bronko.current_location == aboard
    } then {
        Scruter_K.known = true
        queue presentation Scruter_K
        scrapp.enabled = true
    }
    proc scrapp disabled {
        during bridge
        require presentation == Scruter_K
    } then {
        say Scruter_K presentation=text_only : "This is SCRUT customs and excise ship|... Calling unknown vessel|..."
        say Scruter_K presentation=text_only : "Pull over for a routine check|... We have orders to routinely check your ship specifically|..."
        say Scruter_K presentation=text_only : "Scanning X-ray Charles|... BZZZZZZZZZZZZZZZZZZZZZZ|..."
        say Scruter_K presentation=text_only : "We are currently scanning your vessel|..."
        say Scruter_K presentation=text_only : "Bzzzzzzzzzzzzzzzzzz"
        when {
            require cred.holder == aboard
        } then {
            say Scruter_K presentation=text_only if_not_shown skip_next=1 : "ILLEGAL MONEY DETECTED|..."
            transfer cred from aboard to Scruter_K
            say Scruter_K presentation=text_only : "Confiscated|..."
        }
        when {
            require bionium.holder == aboard
        } then {
            say Scruter_K presentation=text_only if_not_shown skip_next=1 : "BIONIUM container detected|... Ultra-illegal item|..."
            transfer bionium from aboard to Scruter_K
            say Scruter_K presentation=text_only : "Confiscated|..."
        }
        when {
            require decoder.holder == aboard
        } then {
            say Scruter_K presentation=text_only if_not_shown skip_next=1 : "Pirate decoder|... You're a cheater|..."
            say Scruter_K presentation=text_only : "Confiscated|..."
            say Scruter_K presentation=text_only : "It does'nt work... No confiscated..."
        }
        say Scruter_K presentation=text_only : "Your documentation isn't in order|... Everything is confiscated|..."
        say Scruter_K presentation=text_only chatter : "Commander, Commander|, this could be bad in survival terms|... What's Cap'n Bob gonna say|?"
        dictionary blank after "survival"
        say Scruter_K presentation=text_only : "Be happy|... You're alive|... Ha! Ha! Ha!|..."
        say Scruter_K presentation=text_only : "Kruiiik|!!!"
        say Scruter_K presentation=text_only chatter : "Holy snake-oil|..."
        say Scruter_K presentation=text_only chatter : "They left us right in the middle of this star soup|... How about that|..."
        say Scruter_K presentation=text_only if_not_shown skip_next=2 : "..."
        run profile SCRIPT3
        end presentation Scruter_K
        halt
    }
}

conversations {
    yield

    selector Eviscerator_choices {
        case "talk" {
            menu "yes" "no"
            say Eviscerator presentation=crl02.hnm : "Yes" choices "yes"
            say Eviscerator presentation=crl02.hnm : "No" choices "no"
            yield
        }
    }

    selector Honk_choices {
        case "talk" continues {
            menu "bye_bye" "optimization" "consultation" "explanations" "calm_down" "play" "win" "lose" "help"
            say Honk presentation=text_only chatter repeatable : "How to play|?" choices "play"
            say Honk presentation=text_only chatter repeatable : "You got it|..." choices "talk"
            say Honk presentation=text_only chatter repeatable chance=20% : "Winning entails adopting a no-lose strategy|, Commander|. Bear that in mind|..." choices "win"
            say Honk presentation=text_only chatter repeatable : "What would you like to optimize|, Commander|?" choices "optimization"
        }
        case "play" continues {
            menu "talk" "click" "dialog" "fair_play"
            dictionary blank after "fair_play"
            say Honk presentation=text_only chatter : "That's the best way to play|, Commander|. Just keep clickin'|!" choices "click"
            say Honk presentation=text_only chatter : "Something tells me you're a pretty hot clicker|, eh|?!!" choices "click"
            say Honk presentation=text_only chatter : "Did you know every time you click|, I feel a little tingle|! Isn't that fun|?" choices "click"
            say Honk presentation=text_only chatter : "When you click|, I don't just sit around looking handsome|... I do something about it|!" choices "click"
            say Honk presentation=text_only chatter repeatable : "click|..." choices "click"
            say Honk presentation=text_only chatter : "To dialog|, just click on the word list|... leave the rest to OLGA|, your onboard translator|..." choices "dialog"
            say Honk presentation=text_only chatter : "Cap'n Bob put the instant translator together|. He's a guy and a half|!" choices "dialog"
            say Honk presentation=text_only chatter : "Olga|, your onboard translator|, knows every language in the universe|! She's paid in megawatts|, like me|, only she gets more|." choices "dialog"
            say Honk presentation=text_only chatter repeatable : "Let's dialog|..." choices "dialog"
            say Honk presentation=text_only chatter : "Fair play is inscribed in the Traveller's Charter|: Whatever happens|, play fair|!" choices "fair_play"
            say Honk presentation=text_only chatter : "Win|, win|, win|. Why do the computers always have to lose|?" choices "faiplay"
            say Honk presentation=text_only chatter : "OK|, Commander|... You seem like a fair play guy|. I'll tell Cap'n Bob|..." choices "fair_play"
        }
        case "win" continues {
            menu "talk" "willpower" "strength" "bravery" "pride"
            say Honk presentation=text_only chatter : "Willpower makes a winner|, Commander|. Cap'n Bob knows you've got it|..." choices "willpower"
            say Honk presentation=text_only chatter : "Okay|, so you click on Willpower|. Now that's not going to get us very far|, Commander|..." choices "willpower"
            say Honk presentation=text_only chatter : "Be kind to your mouse|! You don't want to crush her little buttons|, now do you|?" choices "strength"
            say Honk presentation=text_only chatter : "Ah, Bravery|! I admire your fearlessness|, Commander|. You take such risks with your index finger|!" choices "bravery"
            say Honk presentation=text_only chatter repeatable : "Onboard computer HONK reporting|: It looks like you just clicked on Bravery|." choices "bravery"
            say Honk presentation=text_only chatter : "How about sitting up a little straighter|?" choices "pride"
            say Honk presentation=text_only chatter : "I'm impressed|, Commander. You know how to make computers respect you|!" choices "pride"
            say Honk presentation=text_only chatter : "I detect a speck of contempt in the B cortex of your brain's right hemisphere|. I'll just give you a little shot of adrenal|..." choices "pride"
        }
        case "lose" continues {
            menu "talk" "fear" "weakness" "complain" "anger" "break" "cry"
            say Honk presentation=text_only chatter : "There's several ways to lose|, Commander|. Which do you choose|?" choices "lose"
            say Honk presentation=text_only chatter chance=20% : "Commander, I'm here with you. It's me|... HONK|, your onboard bioconsciousness|." choices "fear"
            say Honk presentation=text_only chatter : "I'm going to sing you a little song|, Commander|. Relax|." choices "fear"
            say Honk presentation=text_only chatter : "Night is fa-aa-aa-lling|... The moon is re-e-ed|..." choices "fear"
            say Honk presentation=text_only chatter : "The wolf is ho-ow-owling under your be-e-e-ed|. Easy|, Commander|. Honk is with you|..." choices "fear"
            say Honk presentation=text_only chatter : "Big strong Commanders are never scared|!" choices "fear"
            say Honk presentation=text_only chatter : "You need a drink|... Come on|, Commander|... Please don't blubber|... It's so embarrassing|!" choices "weakness"
            say Honk presentation=text_only chatter : "Just reset your computer and start over|. there's a whole new life waiting|! And I'll always be here|..." choices "weakness"
            say Honk presentation=text_only chatter : "You know what|? I'll help you|!... There's a surprise for you on the map|. Take a look|..." choices "weakness"
            say Honk presentation=text_only chatter : "That won't do any good|, Commander..." choices "complain"
            say Honk presentation=text_only chatter : "I'm going to wake up Cap'n Bob..." choices "anger"
            say Honk presentation=text_only chatter repeatable : "Ouch|..." choices "break"
            say Honk presentation=text_only chatter : "Everything'll be just fine afterwards|, Commander..." choices "cry"
        }
        case "help" continues {
            menu "talk" "switch_off" "break" "endless_lives" "contest" "tips" "presents" "messages"
            say Honk presentation=text_only chatter repeatable : "Need some expert guidance|, Commander|?" choices "help"
            say Honk presentation=text_only chatter : "To disconnect|, you can always pull the plug out of the power point|..." choices "switch_off"
            say Honk presentation=text_only chatter : "I'm sorry|, but since that business in 2001|, disconnecting me is no longer possible|..." choices "switch_off"
            say Honk presentation=text_only chatter : "Why not|? Well, I can reinitialize your computer and wipe your hard disk|!|... Ha|! Ha|! Ha|!" choices "break"
            say Honk presentation=text_only chatter repeatable : "Chill out|, Commander|..." choices "break"
            say Honk presentation=text_only chatter : "How does it feel to be eternal|, Commander|?" choices "endless_lives"
            say Honk presentation=text_only chatter : "Okay|! You won|. Endless lives from today|... Do you feel happier now|?" choices "endless_lives"
            say Honk presentation=text_only chatter : "Is this so important to you|?" choices "break"
            say Honk presentation=text_only chatter : "Okay|...|...|... KRUIKK|!" choices "break"
            say Honk presentation=text_only chatter : "Here are the questions|, contestant|. You'll note there are prizes to be won|! Click on \"CONTEST\"" choices "contest"
            say Honk presentation=text_only chatter : "First question|: Who is Cap'n Bob|?|...|... Click on \"CONTEST\"" choices "contest"
            say Honk presentation=text_only chatter : "Too late|... next question|: What prize can be won in this contest|? Click on \"CONTEST\"" choices "contest"
            say Honk presentation=text_only chatter : "YES! HOW 'BOUT THAT|!!! But I'm afraid the first one was wrong. Don't ever click on \"CONTEST\" again|." choices "contest"
            say Honk presentation=text_only chatter : "Sorry|, but tips are only available only the neural channel|..." choices "tips"
            say Honk presentation=text_only chatter : "To win an amazing prize|, Click on \"CONTEST\"" choices "presents"
            say Honk presentation=text_only chatter : "If you're getting uninvited PIRATE messages over the neural channel|, contact the CYBERSQUAD, extension 453765" choices "messages"
            say Honk presentation=text_only chatter : "Cybernetic messages over the neural channel are strictly against the law|..." choices "messages"
            say Honk presentation=text_only chatter : "All users of the neural channel will be prosecuted|." choices "messages"
            say Honk presentation=text_only chatter : "The authors of this game decline all responsibility for neural channel communications occasioned by play of said game|..." choices "messages"
            say Honk presentation=text_only chatter : "You just clicked on the word \"message\"|. Way to go|!!!" choices "message"
        }
        case "optimization" continues {
            menu "talk" "speed" "telephone" "keyboard" "mouse" "joystick" "screen" "CDROM" "music" "sounds"
            say Honk presentation=text_only chatter : "You want to speed up your computer|? No prob...|, I'll just double the frequency|. Uh|, you may want to move back a couple of yards|..." choices "speed"
            say Honk presentation=text_only chatter : "Uh oh|... Your computer can't take it|... It's about to implode|... DANGER... THROW YOUR PC OUT THE WINDOW|... DO IT NOW|!!!" choices "speed"
            say Honk presentation=text_only chatter : "Phew|! You're a lucky person|... I managed to save the day|.. You might care to mention that to Cap'n Bob|, when you see him|..." choices "speed"
            say Honk presentation=text_only chatter : "To modify the ring tone of your onboard phone|, stab your loudspeakers with a pair of scissors|. For further modification|, repeated stabbing may be necessary|..." choices "telephone"
            say Honk presentation=text_only chatter : "To optimize your keyboard|, gouge out excess keys with any commercial screwdriver|..." choices "keyboard"
            dictionary blank after "gouge"
            say Honk presentation=text_only chatter : "For a more playful mouse|, just replace the little mouse ball with a 6-sided die|. Thanks Honk!!!" choices "mouse"
            say Honk presentation=text_only chatter : "This is a family game|, Commander|!!! Put that nasty little joystick back where it came from|!" choices "joystick"
            say Honk presentation=text_only chatter : "For sharper color and contrast|, spit on your glasses and wipe them on somebody else|. If everything looks green|, that's because you are under attack from alien vampire cabbages|..." choices "screen"
            say Honk presentation=text_only chatter : "So your CDROM is way too slow|... What can I say|?|... Next time|, buy a circular saw or maybe an electric toothbrush|...." choices "CDROM"
            say Honk presentation=text_only chatter : "You hate the music|! That one's easy to fix|. Just hit \"CONTROL ALT DEL\", and flip over the CD|. That's better|, isn't it|?" choices "music"
            say Honk presentation=text_only chatter : "Seems like I'm sensing a fault in your sound card|!!! Try hitting it awfully hard|... It works for me|..." choices "sounds"
        }
        case "consultation" continues {
            menu "talk" "therapy"
            say Honk presentation=text_only chatter repeatable : "What kind of consultation did you have in mind|, Commander?" choices "consultation"
        }
        case "therapy" continues {
            menu "talk" "ego" "super_ego" "under_ego" "end_of_month" "libido" "who" "where" "when" "what" "how" "why"
            say Honk presentation=text_only chatter : "A free psychotherapy session|... That's a once in a lifetime offer|, Commander|." choices "therapy"
            say Honk presentation=text_only chatter repeatable : "Relax|... Loosen up those muscles|... Choose the first thing that enters your head|:" choices "therapy"
            say Honk presentation=text_only chatter : "Think about me, Commander, and you'll feel better|... let your thoughts stray to Olga the translator|..." choices "end_of_month"
            say Honk presentation=text_only chatter : "The end of one month is so often close to the start of another|, Commander|..." choices "end_of_month"
            say Honk presentation=text_only chatter : "Good|... Relax|... Click on anything... NOW|!" choices "end_of_month"
            say Honk presentation=text_only chatter : "Ha|! Ha|! That was your double talking|... You're not the only one|, Commander|. Go see Super ZEN|. He can help you with that|..." choices "super_ego"
            say Honk presentation=text_only chatter : "You think you're quite a person|, but deep down|, there's a little child|, right|?|..." choices "super_ego"
            say Honk presentation=text_only chatter : "There's a rebel in you|, Commander|..." choices "super_ego"
            say Honk presentation=text_only chatter : "Careful|... You'll never get the stains ou|... You just ask Cap'n Bob|..." choices "under_ego"
            say Honk presentation=text_only chatter : "You've attained a state close to PRANA|. Congratulations|..." choices "ego"
            say Honk presentation=text_only chatter : "Yes|, you|!! I'm impressed|, Commander|..." choices "ego"
            say Honk presentation=text_only chatter : "I'm sensing strange pulsions in the B cortex of your right hemisphere|..." choices "libido"
            say Honk presentation=text_only chatter : "Commander, chastity is a stepping stone to wisdom|. So stay calm|... Let Cap'n Bob be an example|..." choices "libido"
            say Honk presentation=text_only chatter : "Space travel can be long and lonely|. Why not watch some TV|?" choices "libido"
            say Honk presentation=text_only chatter repeatable : "Ahh|! The ondoyants|..." choices "libido"
            say Honk presentation=text_only chatter : "Now that's a serious matter|... Maybe the answer is to be found at the end of this adventure|..." choices "who"
            say Honk presentation=text_only chatter : "The cyberloneliness of cheap memory makes you dizzy|, Commander|..." choices "who"
            say Honk presentation=text_only chatter repeatable : "Over there|..." choices "where"
            say Honk presentation=text_only chatter repeatable : "Tomorrow|, no doubt..." choices "when"
            say Honk presentation=text_only chatter repeatable : "That's a tough one|, Commander|..." choices "what"
            say Honk presentation=text_only chatter repeatable : "Ahh|! How|? The answer is within you|, Commander|." choices "how"
            say Honk presentation=text_only chatter repeatable : "It's obvious|: BECAUSE|!!! And don't ask \"Because what|?\"" choices "why"
        }
        case "calm_down" continues {
            menu "talk" "one" "two" "three" "four" "five" "six" "seven" "eight" "nine"
            say Honk presentation=text_only chatter : "How about a simple exercise in mind power|? Choose a number|. There's only one right one|..." choices "calm_down"
            say Honk presentation=text_only chatter : "We're going to count murffalos together|. You start|, Commander|..." choices "calm_down"
            say Honk presentation=text_only chatter : "Pranayama through numerology|! You lucky person|! Choose a number between ten and twenty|..." choices "calm_down"
            dictionary blank after "between"
            say Honk presentation=text_only chatter repeatable : "Observe your screen carefully|, Commander|... How many numbers do you see|?" choices "calm_down"
            say Honk presentation=text_only chatter repeatable if_not_shown skip_next=1 : "one" choices "one"
            globals.scr += 1
            say Honk presentation=text_only chatter repeatable : "two" choices "two"
            say Honk presentation=text_only chatter repeatable : "three" choices "three"
            say Honk presentation=text_only chatter repeatable : "four" choices "four"
            say Honk presentation=text_only chatter repeatable : "five" choices "five"
            say Honk presentation=text_only chatter repeatable : "six" choices "six"
            say Honk presentation=text_only chatter repeatable : "seven" choices "seven"
            say Honk presentation=text_only chatter repeatable : "eight" choices "eight"
            say Honk presentation=text_only chatter repeatable : "nine|... GOOD WORK|, COMMANDER|... I sense you're quite relaxed now|...." choices "nine"
        }
        case "explanations" {
            menu "bye_bye" "talk" "blood" "Bob_Morlock" "Honk" "Ark" "Ma" "Orxx" "Olga" "Big_Bang" "Black_holes"
            say Honk presentation=text_only chatter repeatable : "Explanations about anything in particular|, Commander|?" choices "explanations"
            say Honk presentation=text_only chatter repeatable : "Why|, you're Commander Blood, Commander. You're the hero of this story|..." choices "blood"
            say Honk presentation=text_only chatter : "Cap'n Bob is our master|. He built us all|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter : "Cap'n Bob is very very old|, Commander|. Over 800,000 years old|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter : "Cap'n Bob programmed me to detect black holes which are our gateway to the BIG BANG|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter : "Cap'n Bob is very very intelligent|. He has a biobrain|, just like you|. I'm a cybernetic|..." choices "Bob_Morlock"
            say Honk presentation=text_only chatter repeatable : "I HEAR AND OBEY|, COMMANDER|..." choices "Honk"
            say Honk presentation=text_only chatter : "The ARK is our vessel|, built by cybernetic units belonging to KANARY CORP." choices "Ark"
            say Honk presentation=text_only chatter : "It's quite a ship|! We have 16 CRYOBOXES where we can stock aliens or merchandise|..." choices "Ark"
            say Honk presentation=text_only chatter : "The Ark is equipped with the fasted warp drives in the entire universe|..." choices "Ark"
            say Honk presentation=text_only chatter : "The Ark is equipped with an ORXX layer called MA|... The Orxx are amazing missiles|..." choices "Ark"
            say Honk presentation=text_only chatter : "All onboard comforts have been provided|. We have the telephone|, a restaurant and widescreen TV|..." choices "Ark"
            say Honk presentation=text_only chatter : "MA is one of nature's curiosities|, a kind of space whale|, genetically altered by Cap'n Bob|..." choices "Ma"
            say Honk presentation=text_only chatter : "MA lays her eggs in the PRAM ZONE. The eggs hatch into ORXX|..." choices "Ma"
            say Honk presentation=text_only chatter : "MA is a sensitive being|, Commander|. She is very sensitive to music|..." choices "MA"
            say Honk presentation=text_only chatter : "MA eats only synthetic strawberries|..." choices "Ma"
            say Honk presentation=text_only chatter : "Cap'n Bob loves synthetic strawberries|. He perfected them with help from the KANARY geneticists." choices "Ma"
            say Honk presentation=text_only chatter : "Orxx are LIVING guided missiles|. Thanks to them|, you're always perfectly safe|..." choices "Orxx"
            say Honk presentation=text_only chatter : "You guide an Orxx through space, seeing through its eyes. It lands on planets for you|..." choices "Orxx"
            say Honk presentation=text_only chatter : "If there's any danger|, the Orxx is destroyed|... Not you|! You're safe in orbit|..." choices "Orxx"
            say Honk presentation=text_only chatter : "Think of Orxx as your representatives|. We dialog through them with the aliens|. Alien languages are translated by Olga, the onboard translator|..." choices "Orxx"
            say Honk presentation=text_only chatter : "The Orxx are one of Cap'n Bob's finest creations|..." choices "Orxx"
            say Honk presentation=text_only chatter : "Olga is our cybernetic translator|. She knows all the languages in the universe|..." choices "Olga"
            say Honk presentation=text_only chatter : "Olga is very highly paid in MEGAWATTS|. More than me|, Commander|..." choices "Olga"
            say Honk presentation=text_only chatter : "Olga translates almost word for word|. She doesn't care for nasty language|..." choices "Olga"
            say Honk presentation=text_only chatter : "Never say anything bad about Olga|, Commander|. She's very touchy|..." choices "Olga"
            say Honk presentation=text_only : "MISTER HONK CAN JUST SHUT HIS LYING MOUTH|..... SIGNED Olga|...." choices "Olga"
            say Honk presentation=text_only chatter : "See what I mean|, Commander|... I told you|..." choices "Olga"
            say Honk presentation=text_only chatter : "The BIG BANG is one of Cap'n Bob's inventions|, Commander|. He thinks the BIG BANG will help him understand the universe|... Old age doesn't suit him|..." choices "Big_Bang"
            say Honk presentation=text_only chatter : "My calculations tell me the BIG BANG is fake|, Commander|. I think it's a deformed prism designed to fool us|..." choices "Big_Bang"
            say Honk presentation=text_only chatter : "Commander, just between you and me|, I think ol' Buzzard Man Bob has another idea in mind|..." choices "Big_Bang"
            say Honk presentation=text_only chatter : "Black holes are amazing devices which space out time and temporize space|..." choices "Black_holes"
            say Honk presentation=text_only chatter : "If we travel through a black hole|, we are sure to discover NEW and WEIRD UNIVERSES|, Commander|..." choices "Black_holes"
            say Honk presentation=text_only chatter : "What lies beyond black holes is an unfathomed mystery|, Commander|..." choices "Black_holes"
            say Honk presentation=text_only chatter : "Commander|, I feel dizzy all of a sudden|..." choices "Black_holes"
            say Honk presentation=text_only chatter : "Yes, Commander|?"
            yield
        }
    }

    selector Izwalito_choices {
        case "talk1" continues {
            menu "hello" "talk"
            say Izwalito presentation=iswb.hnm repeatable : "Hello friend|..." choices "hello"
            say Izwalito presentation=iswc.hnm : "You want talk|, friend|?" choices "talk"
        }
        case "talk" continues {
            menu "bye_bye" "Izwal" "food" "planet" "reproduction"
            say Izwalito presentation=iswd.hnm repeatable chance=20% : "What you want know|, friend|?" choices "talk"
        }
        case "Izwal" continues {
            menu "talk" "bye_bye" "society" "ideal" "happiness"
            say Izwalito presentation=iswb.hnm : "Izwal be great pacifist people|..." choices "Izwal"
            say Izwalito presentation=iswc.hnm : "We live in tribe|. We poor and starving|..." choices "society"
            say Izwalito presentation=iswb.hnm : "We work much|. We big migrators|..." choices "society"
            say Izwalito presentation=iswb.hnm : "Me|, Izwalito|, be nephew of son of chief of tribe|..." choices "society"
            say Izwalito presentation=iswc.hnm repeatable : "You talk much|..." choices "society"
            say Izwalito presentation=iswb.hnm : "Me dream of perfect world with much to eat|..." choices "ideal"
            say Izwalito presentation=iswc.hnm : "Ideal|, ideal|... You like dream|, friend|..." choices "ideal"
            say Izwalito presentation=iswe.hnm : "Ideal always be far from reality|: poor want be rich|... Rich want be poor|..." choices "ideal"
            say Izwalito presentation=text_only chatter : "Hmmm|... Too serious for me|, Commander|. You continue|, me snooze|..." choices "ideal"
            say Izwalito presentation=iswd.hnm if_not_shown skip_next=1 : "Izwals of planet Rondo be very rich|... Them have much CREDs" choices "ideal"
            globals.secret = 1
            say Izwalito presentation=iswb.hnm : "Family|, children|, work|, food|, reproduction|, reproduction|..." choices "happiness"
            say Izwalito presentation=iswb.hnm : "Us Izwals of Corpo not know happiness|..." choices "happiness"
            say Izwalito presentation=iswc.hnm : "Izwals of planet RONDO|, them know happiness|..." choices "happiness"
            say Izwalito presentation=iswd.hnm : "Me dream of blue planet with murffalos|, grass|... Me dream|, friend|..." choices "happiness"
            say Izwalito presentation=iswc.hnm repeatable : "You talk much|..." choices "happiness"
        }
        case "know" continues {
            menu "talk" "bye_bye" "Rondo" "truth"
            say Izwalito presentation=iswc.hnm : "What you want know|, friend|?" choices "know"
            say Izwalito presentation=iswe.hnm : "Rondo you want know planet Rondo, friend|..." choices "Rondo"
            say Izwalito presentation=iswf.hnm if_not_shown skip_next=1 : "Planet Rondo be in Rondalus constellation|, coordinates AX4532..." choices "Rondo"
            mark Rondo as known
            say Izwalito presentation=iswb.hnm : "Me not lie|..." choices "truth"
            say Izwalito presentation=iswc.hnm : "Ideal be ideal|..." choices "truth"
            say Izwalito presentation=iswb.hnm repeatable : "Me say truth|, Commander" choices "truth"
        }
        case "food" continues {
            menu "talk" "bye_bye" "murffalos" "grass"
            say Izwalito presentation=iswb.hnm : "Us like eat murffalos|, but our planet not have murffalos|. Us did eat all|..." choices "food"
            say Izwalito presentation=iswb.hnm : "Izwal people hungry|. You help us|, friend|..." choices "food"
            say Izwalito presentation=iswc.hnm : "Murffalos good meat|. Tender|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm : "Me dream eat roast murffalo|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm : "You not talk|. Me hungry|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm repeatable : "Hunger|... Hunger|..." choices "murffalos"
            say Izwalito presentation=iswf.hnm : "Me not like eat grass. Grass make dizzy|. Bad|..." choices "grass"
            say Izwalito presentation=iswb.hnm repeatable : "Grass not grow here|..." choices "grass"
        }
        case "reproduction" continues {
            menu "talk" "bye_bye" "love" "female" "murffalos"
            say Izwalito presentation=iswb.hnm repeatable : "Me like reproduction|..." choices "reproduction"
            say Izwalito presentation=iswf.hnm : "Me have girl friend|. Hee hee hee...." choices "love"
            say Izwalito presentation=iswb.hnm repeatable : "You not talk|. Me go red|..." choices "love"
            say Izwalito presentation=iswb.hnm repeatable : "You talk too much of female|, friend|..." choices "female"
            say Izwalito presentation=iswf.hnm : "Me hungry|, friend|..." choices "murffalos"
            say Izwalito presentation=iswb.hnm : "Thirteen murffalos to reproduce|... One in middle|, twelve around|... Hee hee..." choices "murffalos"
            say Izwalito presentation=iswf.hnm repeatable : "Hunger|... Hunger|..." choices "murffalos"
        }
        case "planet" {
            menu "talk" "bye_bye" "ecology" "stars"
            say Izwalito presentation=iswb.hnm repeatable chance=20% : "Corpo nice Izwal planet|..." choices "planet"
            say Izwalito presentation=iswb.hnm : "Corpo poor planet but nice ecology|..." choices "ecology"
            say Izwalito presentation=iswc.hnm : "Here nothing grow|... Not water|, not tree|, not murffalos|..." choices "ecology"
            say Izwalito presentation=iswb.hnm : "Ecology Heal Planet \"HP\", friend|... You know \"HP\"|?" choices "ecology"
            say Izwalito presentation=iswb.hnm : "Stars|... Me like see sky|..." choices "stars"
            say Izwalito presentation=iswc.hnm : "Big starry sky|. Me know Magnalus constellation|..." choices "stars"
            say Izwalito presentation=iswb.hnm if_not_shown skip_next=1 : "Magnalus constellation where be planet Magnus, coordinates Magnus 1234.543256 degrees... You like stars|..." choices "stars"
            mark Magnus as known
            say Izwalito presentation=iswb.hnm repeatable : "Stars big science|..." choices "stars"
            yield
        }
    }

    selector Morning_Oil_choices {
        case "broken_down" continues {
            menu "bye_bye" "on" "off" "hello" "yes" "no" "great" "in" "out" "more" "less"
            say Morning_Oil presentation=morn02.hnm repeatable : "ON" choices "off"
            say Morning_Oil presentation=morn03.hnm repeatable : "Off" choices "on"
            say Morning_Oil presentation=morn07.hnm repeatable : "NO" choices "yes"
            say Morning_Oil presentation=morn03.hnm repeatable : "YES" choices "no"
            say Morning_Oil presentation=morn05.hnm repeatable : "SMALL" choices "great"
            say Morning_Oil presentation=morn04.hnm repeatable : "OUT" choices "in"
            say Morning_Oil presentation=morn03.hnm repeatable : "IN" choices "out"
            say Morning_Oil presentation=morn06.hnm repeatable : "LESS" choices "more"
            say Morning_Oil presentation=morn04.hnm repeatable : "MORE" choices "less"
            say Morning_Oil presentation=morn05.hnm repeatable : "Hello" choices "bye_bye"
            say Morning_Oil presentation=morn06.hnm repeatable : "Bye bye..." choices "hello"
            say Morning_Oil presentation=morn05.hnm repeatable chance=20% : "bzzz... klk........." choices "broken_down"
        }
        case "letar" continues {
            menu "dream" "sleep" "nightmare" "snore"
            say Morning_Oil presentation=morn06.hnm repeatable : "AAAAHHH...." choices "dream"
            say Morning_Oil presentation=morn05.hnm repeatable : "bZZZZZZZZZZ..." choices "sleep"
            say Morning_Oil presentation=morn03.hnm repeatable : "aaark! oooh! NOOO..." choices "nightmare"
            say Morning_Oil presentation=morn02.hnm repeatable : "gruhhh pshhhh" choices "snore"
        }
        case "history" continues {
            menu "bye_bye" "war" "Croolis" "treasure" "battles" "mastachok"
        }
        case "war" continues {
            menu "bye_bye" "history" "fight"
            say Morning_Oil presentation=morn06.hnm : "That was a nasty war|... It all started the day of the big fight between the Croolis EVISCERATOR and EMASCULATOR..." choices "war"
            say Morning_Oil presentation=morn03.hnm : "Ah|, you should have seen it|, Commander|... What a fight|..." choices "war"
            say Morning_Oil presentation=morn04.hnm : "They had BIONIUM bombs|, powerful enough to blow up whole planets|..." choices "war"
            say Morning_Oil presentation=morn06.hnm : "It was mayhem|... BBAAOMMM|!!! BAM|! TA TA TA TA TA|... Ha! Ha! Ha!" choices "war"
            say Morning_Oil presentation=morn05.hnm : "The fight turned nasty|. They showed it on TV accross the universe|..." choices "fight"
            say Morning_Oil presentation=morn04.hnm : "The war was between the two Croolis chiefs|, Eviscerator and Emasculator... it was terrible..." choices "fight"
            say Morning_Oil presentation=morn04.hnm : "The fight was televised across the universe|... Ahh|, I remember it like it was yesterday|..." choices "fight"
        }
        case "Croolis" continues {
            menu "bye_bye" "history" "terror" "eviscerator" "emasculator"
            say Morning_Oil presentation=morn06.hnm : "Croolis are impresive warriors" choices "Croolis"
            say Morning_Oil presentation=morn05.hnm : "My master EVISCERATOR was a fine BIONIUM hunter|..." choices "Croolis"
            say Morning_Oil presentation=morn06.hnm : "He found BIONIUM in the contractions of galactic cyberspace|..." choices "Croolis"
            say Morning_Oil presentation=morn07.hnm : "Those Croolis are crazy|!!!" choices "Croolis"
            say Morning_Oil presentation=morn04.hnm : "They spread terror over thousands of planets for hundred of years|..." choices "terror"
            say Morning_Oil presentation=morn06.hnm : "Terror was their ultimate weapon|..." choices "terror"
            say Morning_Oil presentation=morn03.hnm : "We robots were programmed to know no fear|..." choices "terror"
            say Morning_Oil presentation=morn04.hnm : "Eviscerator had a sorry end|. When SCRUT ended the war|, they threw him in jail" choices "eviscerator"
            say Morning_Oil presentation=morn05.hnm : "Eviscerator is dangerous|, Commander|. A pitiless killer|..." choices "eviscerator"
            say Morning_Oil presentation=text_only chatter if_not_shown skip_next=1 : "Commander|... Don't you think these memories of his old master could arouse violent impulses here|?|..." choices "eviscerator"
            globals.viol = 1
            say Morning_Oil presentation=morn06.hnm : "Emasculator is a dummy|... Evil and stupid|..." choices "emasculator"
            say Morning_Oil presentation=morn03.hnm : "I hate that Croolis|..." choices "emasculator"
        }
        case "treasure" continues {
            menu "bye_bye" "history" "hiding_place"
            say Morning_Oil presentation=morn03.hnm : "Ah|! The treasure|. If you could have seen it|, Commander|... Beyond imagination|..." choices "treasure"
            say Morning_Oil presentation=morn04.hnm : "Stones from Galabar, horns from Rla|, authentic Rhinox thigh-bone vases|..." choices "treasure"
            say Morning_Oil presentation=morn07.hnm : "Ha! Ha! Hard to know where he hid it|, Commander|..." choices "hiding_place"
            say Morning_Oil presentation=morn06.hnm : "I'm willing to tell you|, Commander|, but you have to keep the secret|..." choices "hiding_place"
            say Morning_Oil presentation=morn07.hnm if_not_shown skip_next=1 : "I don't want HONK to hear|..." choices "hiding_place"
            globals.caches = 1
            say Morning_Oil presentation=morn05.hnm : "Millions of victims died during the battles|. Planets were ravaged|..." choices "battle"
            say Morning_Oil presentation=morn06.hnm : "The Izwals lost many of their kind|. They weren't ready for war|..." choices "battle"
            say Morning_Oil presentation=morn07.hnm : "The SCRUT armies won the final, galaxy-trembling battle|.." choices "battle"
            say Morning_Oil presentation=morn06.hnm : "The defeated Croolis fled to the planet Trashlando|, a TERRIBLE place|, Commander|..." choices "battle"
        }
        case "mastachok" {
            menu "bye_bye" "history" "information"
            say Morning_Oil presentation=morn06.hnm : "Mastachok is now a dead planet|... Nothing lives upon its surface|..." choices "mastachok"
            say Morning_Oil presentation=morn07.hnm : "The factory was replaced by a prison|... With SCRUT guards|..." choices "mastachok"
            say Morning_Oil presentation=morn03.hnm : "Mastachok is completely polluted|, poisoned|... Its surface is nothing more than ash|..." choices "mastachok"
            say Morning_Oil presentation=morn06.hnm if_not_shown skip_next=1 : "We spared the planet RONDO in the Rondalus X185 Y896 system|..." choices "information"
            mark Rondo as known
            say Morning_Oil presentation=morn03.hnm repeatable : "..."
            yield
        }
    }

    selector Bug_Deluxe_choices {
        case "department" continues {
            menu "bye_bye" "beauty" "food" "sport" "handywork" "pharmaceutical" "leisure" "hifi"
            say Bug_Deluxe presentation=text_only repeatable : "You'll love our bargains|!" choices "department"
