    selector Yoko_choices {
        case "hello" continues {
            menu "bye_bye" "talk" "say_nothing"
            say Yoko presentation=yok01.hnm : "What me do for you|?" choices "say_nothing"
            say Yoko presentation=yok06.hnm : "Me small|. Friends call me small Yoko|..." choices "say_nothing"
            say Yoko presentation=yok13.hnm : "You come from sky, by heaven|. You be extrarondestrial|."
            say Yoko presentation=yok01.hnm : "Stranger from sky|, me greet you|..."
            say Yoko presentation=yok13.hnm : "Me listen you|,stranger from sky|. Welcome|..."
        }
        case "talk" continues {
            menu "bye_bye" "race" "art" "politics" "reproduction" "science"
            say Yoko presentation=yok06.hnm : "What you want know|?" choices "talk"
        }
        case "race" continues {
            menu "bye_bye" "talk" "Izwal" "Slimers" "Croolis" "Tromp" "Migrax" "ondoyant" "Tubular_brain"
            say Yoko presentation=yok12.hnm : "Peoples of universe interest you|, friend|..." choices "race"
            say Yoko presentation=yok02.hnm : "You like talk of races in universe|..." choices "race"
            say Yoko presentation=yok15.hnm : "You like my nice trunk|?" choices "race"
            say Yoko presentation=yok03.hnm : "Out there|, far in universe|, much races|..." choices "race"
        }
        case "Izwal" continues {
            menu "bye_bye" "talk" "race" "peace" "Yoko" "Maxxon" "planet" "listen" "like"
            say Yoko presentation=yok11.hnm : "Izwals be great pacifist people|..." choices "peace"
            say Yoko presentation=yok17.hnm : "Me very frightened of war|..." choices "peace"
            say Yoko presentation=yok01.hnm : "Me small Izwal|..." choices "Yoko"
            say Yoko presentation=yok02.hnm : "You know my name|." choices "Yoko"
            say Yoko presentation=yok09.hnm : "Yoko nice name|. Me like my name|..." choices "Yoko"
            say Yoko presentation=yok11.hnm : "My father be Maxxon|. He be great astrophysicist|..." choices "Maxxon"
            say Yoko presentation=yok13.hnm : "My father know much things|. He be smart|..." choices "Maxxon"
            say Yoko presentation=yok13.hnm : "He be big and strong|..." choices "Maxxon"
            say Yoko presentation=yok03.hnm : "Izwals live planet RONDO|..." choices "planet"
            say Yoko presentation=yok01.hnm : "Me like house on planet Rondo..." choices "planet"
            say Yoko presentation=yok09.hnm : "You welcome on planet Rondo|." choices "planet"
            say Yoko presentation=yok13.hnm : "Planet Rondo nice nice nice|..." choices "planet"
            say Yoko presentation=yok07.hnm : "Izwals know listen|..." choices "listen"
            say Yoko presentation=yok11.hnm : "Me like talk to you|. Me listen|, friend|..." choices "listen"
            say Yoko presentation=yok01.hnm : "Me have big ears to listen good|..." choices "listen"
            say Yoko presentation=yok11.hnm : "Me like beautiful things|. Izwals be poets|..." choices "like"
            say Yoko presentation=yok06.hnm : "Izwals like eat good things|..." choices "like"
            say Yoko presentation=yok15.hnm : "Me be shy with females|..." choices "like"
            say Yoko presentation=yok01.hnm : "Izwals be great pacifist people|..." choices "Izwal"
            say Yoko presentation=yok01.hnm : "Yoko and Maxxon be Izwals|..." choices "Izwal"
            say Yoko presentation=yok15.hnm : "Izwals know listen|..." choices "Izwal"
            say Yoko presentation=yok15.hnm : "Izwals like play|..." choices "Izwal"
        }
        case "Croolis" continues {
            menu "bye_bye" "talk" "race" "war" "news" "brain" "fear"
            say Yoko presentation=yok10.hnm if_not_shown skip_next=1 : "War be big problem|. Life be good if no war|..." choices "war"
            globals.mastok = 1
            say Yoko presentation=yok17.hnm : "Croolis like big muscles|, weapons and nice females|..." choices "news"
            say Yoko presentation=yok11.hnm : "Croolis have small brain and big muscles|..." choices "brain"
            say Yoko presentation=yok10.hnm : "Croolis always be danger for balance of universe|..." choices "brain"
            say Yoko presentation=yok17.hnm : "Yes friend|, me afraid|. Croolis cruel, them think war only|..." choices "fear"
            say Yoko presentation=yok08.hnm : "Croolis brain big like head of pin|. laugh laugh|... cry|... laugh laugh|..." choices "Croolis"
            say Yoko presentation=yok06.hnm : "Croolis be bad|, stupid and violent|..." choices "Croolis"
        }
        case "Tromp" continues {
            menu "bye_bye" "talk" "race" "know" "trunk"
            say Yoko presentation=yok05.hnm : "Me not know Tromps|..." choices "know"
            say Yoko presentation=yok15.hnm : "Trumpet nice instrument|..." choices "trunk"
            say Yoko presentation=yok07.hnm : "Me not smoke Trump tails|. So bad for health|..." choices "Tromp"
        }
        case "Migrax" continues {
            menu "bye_bye" "talk" "race" "brain" "money"
            say Yoko presentation=yok10.hnm : "Migrax big stupid|." choices "brain"
            say Yoko presentation=yok12.hnm : "Migrax like too much money|." choices "money"
            say Yoko presentation=yok12.hnm : "Them like business|. Nothing free|..." choices "money"
            say Yoko presentation=yok13.hnm : "Migrators be cool|. Me like music|." choices "Migrax"
        }
        case "ondoyant" continues {
            menu "bye_bye" "talk" "race" "emotion" "news" "feeling"
            say Yoko presentation=yok07.hnm : "ondoyants be very strange|. Them intimidate me|..." choices "news"
            say Yoko presentation=yok08.hnm : "Father say ondoyants not exist|, ondoyants be legend|..." choices "news"
            say Yoko presentation=yok15.hnm : "Me have knees all weak|..." choices "emotion"
            say Yoko presentation=yok15.hnm : "ondoyants big emotion|..." choices "feeling"
            say Yoko presentation=yok08.hnm : "Ah, females be big problem|. me all alone|... cry cry|..." choices "ondoyant"
            say Yoko presentation=yok12.hnm : "Me want ondoyant with me|, friend|..." choices "ondoyant"
        }
        case "Tubular_brain" continues {
            menu "bye_bye" "talk" "news"
            say Yoko presentation=yok04.hnm repeatable : "Me not know those beings|..." choices "news"
            say Yoko presentation=yok13.hnm : "Tubular strange name|..." choices "Tubular_brain"
            say Yoko presentation=yok10.hnm repeatable : "Not know|..." choices "Tubular_brain"
        }
        case "Slimers" continues {
            menu "bye_bye" "talk" "information"
            say Yoko presentation=yok01.hnm repeatable : "Me know Slimers..." choices "Slimers"
            say Yoko presentation=yok10.hnm : "Slimers be strange people|. Big Yolk be big Slimer|. He be buried on planet Vista|..." choices "information"
            say Yoko presentation=yok11.hnm : "Me like Slimers|. Them be nice|..." choices "information"
            say Yoko presentation=yok12.hnm chance=20% : "Portrait of great YOLK be famous painting|. Painted with yellow blood of great YOLK|..." choices "information"
            say Yoko presentation=yok10.hnm chance=20% : "Me dream visit mausoleum of great YOLK on planet VISTA, but Vista be other end of universe|..." choices "information"
            say Yoko presentation=yok03.hnm chance=20% : "You talk much|, friend|..." choices "information"
            say Yoko presentation=yok06.hnm if_not_shown skip_next=1 : "Me be thirsty|..." choices "information"
            globals.secret = 1
        }
        case "art" continues {
            menu "bye_bye" "talk" "music" "painting" "reproduction" "book"
            say Yoko presentation=yok11.hnm : "Me like music|. You know group called Migrators|?" choices "music"
            say Yoko presentation=yok13.hnm : "MIGRATORS make big sound|. Not hear think|!" choices "music"
            say Yoko presentation=yok06.hnm : "Me already read books on art|..." choices "book"
            say Yoko presentation=yok11.hnm : "Me hear of Jeph d'Ulikan|, great artist|..." choices "painting"
            say Yoko presentation=yok06.hnm : "Portrait of Great Yolk be big painting..." choices "painting"
            say Yoko presentation=yok11.hnm : "Me not like reproductions|. Me prefer originals|..." choices "reproduction"
            dictionary blank after "originals"
            say Yoko presentation=yok11.hnm : "Me like color blue|..." choices "art"
        }
        case "politics" continues {
            menu "bye_bye" "talk" "peace" "war" "weapon"
            say Yoko presentation=yok11.hnm repeatable : "Us Izwals like Peace|..." choices "peace"
            say Yoko presentation=yok01.hnm : "Me hate war|, friend|..." choices "war"
            say Yoko presentation=yok06.hnm : "War be like death|. It frighten|..." choices "war"
            say Yoko presentation=yok06.hnm : "Croolis be expert in war|..." choices "war"
            say Yoko presentation=yok05.hnm repeatable : "Deadly weapons not allowed here|..." choices "weapon"
            say Yoko presentation=yok06.hnm : "Ah|, politics|... Me not understand|..." choices "politics"
            say Yoko presentation=yok04.hnm : "Politics always leads to war|. People not want same thing|..." choices "politics"
        }
        case "peace" continues {
            menu "bye_bye" "talk" "family"
            say Yoko presentation=yok06.hnm : "Izwals like peace of family|..." choices "family"
            say Yoko presentation=yok05.hnm : "War kill my family|, friend|..." choices "family"
            say Yoko presentation=yok06.hnm : "You friend|. me know you like peace|..." choices "peace"
            say Yoko presentation=yok11.hnm : "Me want base life on respect of others|. That be only law|..." choices "peace"
        }
        case "war" continues {
            menu "bye_bye" "talk" "peace" "slave" "power"
            say Yoko presentation=yok13.hnm : "Me not want be slaves|. POWER make slaves|..." choices "slave"
            say Yoko presentation=yok03.hnm : "POWER make people crazy|..." choices "power"
            say Yoko presentation=yok04.hnm repeatable : "Me not like POWER|..." choices "power"
            say Yoko presentation=yok08.hnm : "War kill my family|... CRY|... CRY|..." choices "war"
            say Yoko presentation=yok10.hnm : "War be very stupid|..." choices "war"
        }
        case "reproduction" continues {
            menu "bye_bye" "talk" "laugh" "idea" "female"
            say Yoko presentation=yok09.hnm : "Hee hee hee hee|..." choices "reproduction"
            say Yoko presentation=yok14.hnm : "Reproduction be big universal law|..." choices "reproduction"
            say Yoko presentation=yok06.hnm : "Me hope meet female Izwal one day|..." choices "idea"
            say Yoko presentation=yok05.hnm : "Me too small think reproduction|..." choices "idea"
            say Yoko presentation=yok09.hnm : "Murffalos have funny way to reproduce|, hee hee hee|!" choices "laugh"
            say Yoko presentation=yok08.hnm : "Hee|! Hee|! Hee|! Hee|! Hee|!" choices "laugh"
            say Yoko presentation=yok09.hnm : "Ha|! Ha|! Ha|! Ha|! Ha|!" choices "laugh"
            say Yoko presentation=yok06.hnm : "Ho|! Ho|! Ho|! Ho|!" choices "laugh"
            say Yoko presentation=yok09.hnm : "Females like reproduction|, hee hee hee|!!!" choices "female"
            say Yoko presentation=yok11.hnm : "Reproduction be wonderful thing|..." choices "female"
            say Yoko presentation=yok14.hnm : "You like reproduction|. You talk much about|..." choices "female"
        }
        case "science" {
            menu "bye_bye" "talk" "weapon"
            say Yoko presentation=yok06.hnm : "Me not like weapons|, friend|..." choices "weapon"
            say Yoko presentation=yok05.hnm : "Science must be for peace|, not war|..." choices "weapon"
            say Yoko presentation=yok07.hnm : "Me like observe stars with my father Maxxon|..." choices "weapon"
            say Yoko presentation=yok08.hnm repeatable : "Me not want talk of weapons|, friend|..." choices "weapons"
            say Yoko presentation=yok10.hnm : "Radioactivity bad evil|. Kill slow and sure|... EXTERMINIUM be radioactive|..." choices "science"
            say Yoko presentation=yok13.hnm : "Croolis know military science|..." choices "science"
            say Yoko presentation=yok11.hnm : "Sinox like science and technology..." choices "science"
            say Yoko presentation=yok04.hnm repeatable : "..."
            yield
        }
    }

    selector Bronko_choices {
        case "talk" continues {
            menu "bye_bye" "robot" "cred" "murffalos" "weapons"
        }
        case "robot" continues {
            menu "talk" "bye_bye" "robot" "intelligence" "energy" "technology" "retirement"
            say Bronko presentation=rgbtr3.hnm : "Me robot Bronko AX34 BUTCHER model|..." choices "robot"
            say Bronko presentation=rgbtr4.hnm : "Robots be strong|, friend|. Robot Bronko know chop meat with sharp tools|..." choices "robot"
            say Bronko presentation=rgbtr2.hnm : "Me good robot|, advanced|..." choices "robot"
            say Bronko presentation=rgbtr2.hnm : "Me big cybernetic intelligence|, much cheap memory|..." choices "intelligence"
            say Bronko presentation=rgbtr3.hnm : "Me know think|. Me much smart|..." choices "intelligence"
            say Bronko presentation=rgbtr4.hnm : "Me have big CDROM in head|... Ha! Ha! Ha! Ha!" choices "intelligence"
            say Bronko presentation=rgbtr3.hnm repeatable : "Bronko intelligent|..." choices "intelligence"
            say Bronko presentation=rgbtr5.hnm : "Me have big energy|: Bronko have new batteries|, friend|...." choices "energy"
            say Bronko presentation=rgbtr6.hnm : "Me eat metal biscuits with sump oil and mercury every morning|, friend|... High energy|..." choices "energy"
            say Bronko presentation=rgbtr2.hnm : "You look for batteries, friend|... Me buy batteries at VENUSIA SUPRAMARKET" choices "energy"
            say Bronko presentation=rgbtr5.hnm : "VENUSIA SUPRAMARKET sell cheap batteries|. You not see commercials on TV|, friend|?" choices "energy"
            say Bronko presentation=rgbtr2.hnm : "Bronko big technology|, friend|..." choices "technology"
            say Bronko presentation=rgbtr6.hnm : "See you soon|..." choices "bye_bye"
        }
        case "cred" continues {
            menu "talk" "bye_bye" "cred" "buy"
            say Bronko presentation=rgbtr2.hnm : "Me work much to earn CRED|, friend|..." choices "cred"
            say Bronko presentation=rgbtr3.hnm : "Creds be hard to earn|..." choices "cred"
            say Bronko presentation=rgbtr4.hnm : "You like Creds|, friend|?" choices "cred"
            say Bronko presentation=rgbtr5.hnm : "Me want buy big ship|. Go far for vacation|..." choices "buy"
            say Bronko presentation=rgbtr4.hnm : "Me want buy home on planet Troma|, and grow nuts|, bolts and maybe screws|..." choices "buy"
            say Bronko presentation=rgbtr3.hnm : "Me want breed cybernetic lawn-mowers|... Me dream|, friend|..." choices "buy"
            say Bronko presentation=rgbtr5.hnm : "To buy|, me must work much|..." choices "buy"
        }
        case "murffalos" continues {
            menu "talk" "bye_bye" "hunt"
            say Bronko presentation=rgbtr2.hnm : "Thirteen murffalos to reproduce|... One in middle|, rest around|. That be reproduction for Murffalos|..." choices "murffalos"
            say Bronko presentation=rgbtr3.hnm : "Me not like murffalos|... Not good|, too soft|... Me like blade of lawn-mower|..." choices "murffalos"
            say Bronko presentation=rgbtr4.hnm : "Me know chop murffalos..." choices "murffalos"
            say Bronko presentation=rgbtr5.hnm : "Me like hunt satellite game with laserpulper|... Zap zap in satellites|..." choices "hunt"
            say Bronko presentation=rgbtr4.hnm : "Hunting big sport|..." choices "hunt"
        }
        case "weapons" continues {
            menu "talk" "bye_bye" "planets" "war"
            say Bronko presentation=rgbtr5.hnm : "To find nice weapons|, pay much creds|, Commander|..." choices "weapons"
            say Bronko presentation=rgbtr3.hnm : "Me have weapons on end of arms|..." choices "weapons"
            say Bronko presentation=rgbtr3.hnm : "You big traveller|. You know planets|, friend|..." choices "planets"
            say Bronko presentation=rgbtr4.hnm : "Croolis war do much bad|... Bad war|, friend|..." choices "war"
        }
        case "retirement" {
            menu "talk" "bye_bye"
            say Bronko presentation=rgbtr2.hnm if_not_shown skip_next=1 : "Ah|, retirement|... Them send me planet Magnus|, with other worn-out robots|... CRY CRY|..." choices "retirement"
            globals.ekkk = 1
            yield
        }
    }

    selector Bob_Morlock_choices {
        case "talk" continues {
            menu "bye_bye" "black_hole" "Big_Bang" "Bob_Morlock" "Kanary" "mission" "Corpo" "Good_ol_Bob"
            say Bob_Morlock presentation=bobc.hnm chance=20% : "What do you need to know|, Commander?" choices "talk"
            say Bob_Morlock presentation=bobd.hnm if_not_shown skip_next=1 : "Goodbye|, Commander|..." choices "bye_bye"
            globals.adieu = 1
            say Bob_Morlock presentation=bobc.hnm : "Years of research finally led me to isolate time|, Commander" choices "black_hole"
            say Bob_Morlock presentation=bobb.hnm : "Certain black holes can be used to travel back in time|." choices "black_hole"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Honk is programmed to seek black holes" choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "To reach the BIG BANG, you'll have to travel through a number of black holes|..." choices "black_hole"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Black holes are marvellous machines of nature|, Commander|..." choices "black_hole"
            dictionary blank after "machines"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobd.hnm : "I have pursued truth all my life|, Commander|..." choices "Big_Bang"
            say Bob_Morlock presentation=bobc.hnm : "I know the truth is beyond the BIG BANG|, Commander|!" choices "Big_Bang"
            say Bob_Morlock presentation=bobb.hnm : "My memory is not what it was|..." choices "Big_Bang"
            say Bob_Morlock presentation=bobc.hnm : "Thanks to the KANARY scientists|, I am the oldest being in the UNIVERSE|." choices "Bob_Morlock"
            say Bob_Morlock presentation=bobb.hnm : "In my time|, I've been a crooner|, a magician|, many things|. I founded the biggest business in the universe|: KANARY|!" choices "Bob_Morlock"
            say Bob_Morlock presentation=bobc.hnm : "I've known many women|. Thousands of generations have admired me|. I am immortal|!" choices "Bob_Morlock"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Commander, you are going to relive my past|. I envy you|..." choices "Bob_Morlock"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "Ah|, Otto Von Smile|, Eviscerator|, Jeph d'Ulikan|, old Yolk|, Tina Burner|, and the others|..." choices "Bob_Morlock"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm repeatable if_not_shown skip_next=1 : "Ahh! Those were the days|, Commander..." choices "Bob_Morlock"
            offer topic "revelation"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "You want a few revelations|, Commander|?" choices "revelation"
            globals.reve = 1
            say Bob_Morlock presentation=bobc.hnm : "Your mission is to find and travel through the right black holes|, so we can travel back in time to the BIG BANG|." choices "mission"
            say Bob_Morlock presentation=bobb.hnm : "You will meet amazing and sometimes dangerous beings|. It will take courage|, Commander|!" choices "mission"
            say Bob_Morlock presentation=bobc.hnm : "You will pass through hideous wars and barriers that cannot be crossed|..." choices "mission"
            say Bob_Morlock presentation=bobb.hnm : "You will need to win strange creatures to your cause|..." choices "mission"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "You will be alone|, Commander|. Unless you decide to wake me|..." choices "mission"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm : "The planet Corpo is where I originally came from|. Where we came from|..." choices "Corpo"
            say Bob_Morlock presentation=bobd.hnm if_not_shown skip_next=1 : "Corpo is an extraordinary planet|, with unlimited resources|." choices "Corpo"
            Bob_Morlock.aggressiveness += 2
            say Bob_Morlock presentation=bobc.hnm : "The truth lies at the birth of our universe|, just before the BIG BANG|..." choices "truth"
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "Ah! Truth|!" choices "truth"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=text_only if_not_shown skip_next=1 : "I am getting pictures from the Ark|, Commander|. Everything is in order|..." choices "Good_ol_Bob"
            request sequence "aarche10.hnm"
            say Bob_Morlock presentation=bobb.hnm : "You flatter me|, Commander|..." choices "Good_ol_Bob"
            say Bob_Morlock presentation=bobc.hnm chance=20% if_not_shown skip_next=1 : "You embarrass me|, Commander|..." choices "Good_ol_Bob"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobb.hnm chance=20% : "Heh heh|..." choices "Good_ol_Bob"
        }
        case "Kanary" {
            menu "talk" "bye_bye" "cottage" "clones" "employees" "balance_sheets"
            say Bob_Morlock presentation=bobb.hnm : "The Cottage Research Department is my secret project|..." choices "cottage"
            say Bob_Morlock presentation=bobb.hnm : "The domain of vegetation is a marvel of nature|..." choices "cottage"
            say Bob_Morlock presentation=bobb.hnm : "The Cottage Research Department perfects genetic miracles|..." choices "cottage"
            say Bob_Morlock presentation=bobd.hnm : "The Kanary mows lawns themselves every Weekend|..." choices "cottage"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Kanary's artificial orchids produce centuries-old whisky|..." choices "cottage"
            Bob_Morlock.aggressiveness += 5
            say Bob_Morlock presentation=bobb.hnm : "Kanary has developed technology entirely devoted to synthetic cloning|..." choices "clones"
            say Bob_Morlock presentation=bobc.hnm : "Kanary's four million employees were all built by and for Kanary|..." choices "clones"
            say Bob_Morlock presentation=bobb.hnm : "I am the very last natural bio being and I control EVERYTHING|..." choices "clones"
            say Bob_Morlock presentation=bobb.hnm : "My employees wake me up for ten minutes once a year|, so I can blow out the candles on my birthday cake and sign the balance sheets" choices "clones"
            say Bob_Morlock presentation=bobb.hnm if_not_shown skip_next=1 : "I asked the Kanary scientists to create the perfect adventurer to take me to the BIG BANG|..." choices "clones"
            Bob_Morlock.aggressiveness += 3
            say Bob_Morlock presentation=bobd.hnm : "All Kanary employees were built by the CLONE CONSORTIUM department|. SO WERE YOU|, Commander|." choices "employees"
            say Bob_Morlock presentation=bobe.hnm : "You all work for me|: You Honk|, you Commander|, you Olga|... All of you|..." choices "employees"
            say Bob_Morlock presentation=bobf.hnm if_not_shown skip_next=1 : "Kanary builds the cheapest and most efficient employees in the universe|..." choices "employees"
            globals.emplo = 1
            say Bob_Morlock presentation=bobb.hnm chance=20% : "Kanary is the biggest business empire in the known universe" choices "Kanary"
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=1 : "Kanary invents|, builds|, consumes and controls the entire universe|." choices "Kanary"
            Bob_Morlock.aggressiveness += 1
            say Bob_Morlock presentation=bobd.hnm : "Kanary is so well managed that all its products have a negative building cost|..." choices "balance_sheets"
            say Bob_Morlock presentation=bobc.hnm : "A complete cottage costs 100990 Negabucks to make|..." choices "balance_sheets"
            say Bob_Morlock presentation=bobf.hnm : "Our profits are so enormous that nobody can pronounce the sum|." choices "balance_sheets"
            say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "Our only competitor is CRYO|. They control the Second World|." choices "balance_sheets"
            Bob_Morlock.aggressiveness += 2
            say Bob_Morlock presentation=bobh.hnm when aggressiveness == 10 : "I like you|, Commander|."
            say Bob_Morlock presentation=bobi.hnm when aggressiveness == 15 : "You are curious and smart|. That's how I like people to be|."
            say Bob_Morlock presentation=bobj.hnm when aggressiveness == 20 : "You talk too much|, Commander. You're wasting my time|..."
            say Bob_Morlock presentation=borb_ctr.hnm when aggressiveness == 25 : "I'll tell you something about yourself|, Commander|. You ask too many questions|..."
            yield
        }
    }

    selector Daddy_Gluxx_choices {
        case "talk" continues {
            menu "bye_bye" "Slim_Gelati" "family" "Slimers" "Great_Yolk"
            say Daddy_Gluxx presentation=glu02.hnm : "Bye bye|, friend|..." choices "bye_bye"
            say Daddy_Gluxx presentation=glu04.hnm : "Do you speak our language|, stranger|?" choices "talk"
        }
        case "Slim_Gelati" continues {
            menu "bye_bye" "talk" "treatment"
            say Daddy_Gluxx presentation=glu03.hnm : "Old Slim's not the guy he used to be|. He sold his jelly house|. He's throwing away his savings|..." choices "Slim_Gelati"
            say Daddy_Gluxx presentation=glu04.hnm : "He's obsessed with regaining his long lost youth|..."
            say Daddy_Gluxx presentation=glu02.hnm : "He goes for treatment to a secret place|. He made me promise never to reveal its whereabouts|..." choices "treatment"
            say Daddy_Gluxx presentation=glu03.hnm if_not_shown skip_next=1 : "I promised him I'd never tell|..." choices "treatment"
            globals.secret = 1
        }
        case "family" continues {
            menu "bye_bye" "talk" "children" "village"
            say Daddy_Gluxx presentation=glu00.hnm when last_8_choices count "family" >= 2 : "Ah! Family|! Look at these fine children|. Little Gooseberry and her sister Gelatine... Latex|! Behave yourself|!!!" choices "family"
            say Daddy_Gluxx presentation=glu03.hnm : "We SLIMERS take great joy in our families|..."
            say Daddy_Gluxx presentation=glu03.hnm : "Latex is the oldest|. Gooseberry and Gelatine are twins|. Rubber is the baby|..." choices "children"
            say Daddy_Gluxx presentation=glu05.hnm : "Our jelly village is wondrous|, friend|. Our houses are living beings|..." choices "village"
            say Daddy_Gluxx presentation=gluxfric.hnm : "This village is called JEWELTOWN|. It is quite unique in the universe|... We get a lot of tourists|..." choices "village"
        }
        case "Slimers" continues {
            menu "bye_bye" "talk" "origin"
            say Daddy_Gluxx presentation=glu02.hnm : "Slimers are a very old race|..." choices "Slimers"
            say Daddy_Gluxx presentation=glu01.hnm : "Our origins are lost in the mist of time|..." choices "origin"
            say Daddy_Gluxx presentation=glu03.hnm : "There used to be billions of us|, but the Croolis war almost exterminated us|..." choices "origin"
            say Daddy_Gluxx presentation=glu04.hnm : "We are opposed to the technology of evil|. Here there are no factories|. We made a pact with the vegetation and with the space jellyfish|..." choices "origin"
            say Daddy_Gluxx presentation=glu03.hnm : "There is no pollution here|. Everything is clean and pure|..." choices "origin"
        }
        case "Great_Yolk" {
            menu "bye_bye" "talk" "history"
            say Daddy_Gluxx presentation=glu01.hnm : "The Great YOLK|... An eminent SLIMER philosopher|... His thoughts are taught to all the children of the universe|..." choices "Great_Yolk"
            say Daddy_Gluxx presentation=glu02.hnm : "The Great YOLK said|: \"Cyberspace feeds off our dreams|...\"" choices "Great_Yolk"
            say Daddy_Gluxx presentation=glu03.hnm : "He also said|: \"The harmony of silence springs from thunder|...\"" choices "Great_Yolk"
            say Daddy_Gluxx presentation=glu04.hnm : "Our history is written within us for eternity|. We have no need to tell it or write it down|..." choices "history"
            say Daddy_Gluxx presentation=glu01.hnm repeatable : "..."
            yield
        }
    }

    selector Scruter_Mac_choices {
        case "talk" continues {
            menu "bye_bye" "Scruter_Mac" "SCRUT" "prison" "Mastachok" "presents"
            say Scruter_Mac presentation=scr07.hnm : "Bye bye stranger|... Me must stand guard|..." choices "bye_bye"
        }
        case "Scruter_Mac" continues {
            menu "talk" "bye_bye" "robot"
            say Scruter_Mac presentation=scr06.hnm : "Ah|, robot be hard job|... Me think always of vacation on islands of Sea of Tranquility|... SIGH|..." choices "robot"
            say Scruter_Mac presentation=scr05.hnm : "If you want be SCRUT agent|, you can|. Them put your brain inside SCRUT robot|..." choices "robot"
            say Scruter_Mac presentation=scr04.hnm : "After war|, them put Croolis brain in SCRUT robot|. Me did be Croolis|..." choices "robot"
        }
        case "SCRUT" continues {
            menu "talk" "bye_bye" "order" "chief" "war" "happy"
            say Scruter_Mac presentation=scr07.hnm : "SCRUT big army|... SCRUT control universe|..." choices "SCRUT"
            say Scruter_Mac presentation=scr06.hnm : "SUPER TRUMP be big chief of SCRUT|..." choices "SCRUT"
            say Scruter_Mac presentation=scr03.hnm : "Me have order to guard jail on Mastachok|..." choices "order"
            say Scruter_Mac presentation=scr04.hnm : "Order be order|, friend|..." choices "order"
            say Scruter_Mac presentation=scr06.hnm : "Order be not disorder|..." choices "order"
            say Scruter_Mac presentation=scr05.hnm : "You like order|..." choices "order"
