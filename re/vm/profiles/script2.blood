    proc boba3 enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.BO == 3
    } then {
        say Bob_Morlock presentation=bobe.hnm : "I'm thirsty|... HONK! You reject fridge component|! Give me a glass of recycled water|!!!"
        say Bob_Morlock presentation=text_only chatter : "Yes sir, Cap'n Bob|! Just locating a clean glass|, beaker|, mug|, cup or other drinking vessel|..."
        say Bob_Morlock presentation=bobf.hnm : "Be careful|... I said recycled water|, not liquid coolant like the last time|!!!"
