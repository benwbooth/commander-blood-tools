        say Izwalito presentation=text_only chatter : "STOP"
        when {
            require globals.mic == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Mousy|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Mousy|. You not have tail|..."
        }
