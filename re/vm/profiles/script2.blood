        say Izwalito presentation=iswf.hnm : "Izwal people look forward see you back|..."
        when {
            require globals.mic == 1
        } then {
            say Izwalito presentation=iswe.hnm : "See you soon|, friend Mousy|..."
            say Izwalito presentation=iswb.hnm : "Me not believe you be Mousy|. You not squeak|..."
        }
        when {
