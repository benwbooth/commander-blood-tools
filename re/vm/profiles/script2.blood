        }
        say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "I feel weak as that kitten I accidentally converted to anti-matter|, Commander|... Let me get some sleep|..." choices "bye_bye"
        globals.adieu = 1
        when {
            require globals.adieu == 1
        } then {
            say Bob_Morlock presentation=text_only chatter : "Ah, sleep|..."
            say Bob_Morlock presentation=text_only if_not_shown skip_next=4 : "stop"
            globals.adieu = 0
            globals.BO = 4
            timer[1] = disabled
            end presentation Bob_Morlock
        }
    }
    proc boba4 enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.BO == 4
    } then {
        when {
            require Bob_Morlock.encounter_count == 6
        } then {
            say Bob_Morlock presentation=bobe.hnm : "I'm hungry|... HONK! You no-good collection of second-hand wiring|! Where's the menu|!!!"
            say Bob_Morlock presentation=text_only chatter : "Coming right up|, Cap'n Bob|! Your dinner is heating up in the engine room|..."
            say Bob_Morlock presentation=bobf.hnm : "Be careful this time|... Hot food does not have to be curled up, black and smoking|!!!"
            say Bob_Morlock presentation=text_only chatter : "Not smoking... You got it|, Cap'n Bob|, sir|... Would you care to browse through the MENU|?"
            say Bob_Morlock presentation=bobg.hnm : "WHAT|?? GLOK AGAIN|!!! I'd like to see you curled up and smoking|..."
        }
        say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "What do you want to know Commander|..."
        timer[1] = 90
        when {
            require timer[1] == 0
        } then {
            say Bob_Morlock presentation=bobg.hnm : "I need to cryonize|..."
            say Bob_Morlock presentation=bobd.hnm : "AAAAAAAAAAAAhhhh|!!!"
            say Bob_Morlock presentation=text_only if_not_shown skip_next=2 : "stop"
            timer[1] = disabled
            end presentation Bob_Morlock
        }
        say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "I feel weak as that lamb I inadvertently dropped in my shark-pool one day|, Commander|... Let me sleep|..." choices "bye_bye"
        globals.adieu = 1
        when {
            require globals.adieu == 1
        } then {
            say Bob_Morlock presentation=text_only chatter : "Ah, sleep|..."
            say Bob_Morlock presentation=text_only if_not_shown skip_next=3 : "stop"
            globals.adieu = 0
            timer[1] = disabled
            end presentation Bob_Morlock
        }
    }
    proc augmen enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.emplo == 1
        require globals.emp == 0
    } then {
        say Bob_Morlock presentation=text_only chatter : "While you're awake, Cap'n Bob|, sir|... I have a request to make|..."
        say Bob_Morlock presentation=text_only chatter : "Olga and me would like a raise|. A few megawatts|..."
        say Bob_Morlock presentation=bobf.hnm : "WHAT|... SPEAK LOUDER|... I'M GETTING DEAFER AND DEAFER|..."
        say Bob_Morlock presentation=text_only chatter : "WE WANT MORE MEGAWATTS|!!!"
        say Bob_Morlock presentation=bobe.hnm : "I feel like that canary I mistook for an oven-ready turkey|, Commander|. Haaa|!!! My heart|...."
        say Bob_Morlock presentation=text_only chatter if_not_shown skip_next=2 : "Heart|!!|... He means his power generator|... Those guys|... Just mention a couple of lousy megawatts|!"
        globals.emp = 1
        augmen.enabled = false
    }
    global emplo = 0
    global emp = 0
    proc revel enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.reve == 1
        require globals.revelat == 0
    } then {
        say Bob_Morlock presentation=bobh.hnm : "You want to know an unbearable truth|, Commander|?"
        say Bob_Morlock presentation=bobg.hnm : "HONK! Switch off for ten seconds|!!!"
        say Bob_Morlock presentation=text_only chatter : "But|, Cap'n Bob|!!|..."
        say Bob_Morlock presentation=bobf.hnm : "YOU HEARD ME|... SWITCH YOURSELF OFF|!!!"
        say Bob_Morlock presentation=text_only chatter : "Yes sir|, Cap'n Bob|. If you say so|..."
        say Bob_Morlock presentation=text_only chatter : "KRUIIIIK|!!! AAAaaaaaaaaaaaaaaaaaaaaa|!!!"
        say Bob_Morlock presentation=bobf.hnm : "COMMANDER, YOU ARE ME|..."
        say Bob_Morlock presentation=bobg.hnm : "WE ARE THE SAME PERSON AT TWO DIFFERENT AGES|..."
        say Bob_Morlock presentation=bobe.hnm : "YOU ARE MUCH MORE THAN MY SON|..."
        say Bob_Morlock presentation=bobf.hnm : "We are the same person|... I am the first being to have created itself"
        say Bob_Morlock presentation=bobe.hnm : "And who|, thanks to space-time distortion|, can watch itself re-live|: YOU ARE BOB|, COMMANDER|..."
        say Bob_Morlock presentation=bobc.hnm : "I am what you will become hundreds of thousands of years from now|..."
        say Bob_Morlock presentation=bobg.hnm : "OK Honk|, you can switch on now|..."
        say Bob_Morlock presentation=text_only chatter : "KROIIIIkkk|!!! -&KRUIIIIkkk|!!! You guys should know I have a right to stay informed|. That's what being ONBOARD COMPUTER is all about|, right|?"
        say Bob_Morlock presentation=text_only chatter if_not_shown skip_next=1 : "Was Olga switched off too|???"
        globals.plus = 1
        say Bob_Morlock presentation=bobf.hnm if_not_shown skip_next=3 : "Stop snivelling and get to work|, you jumped up little fuse box|..."
        globals.revelat = 1
        globals.reve = 0
        revel.enabled = false
    }
    global reve = 0
    global revelat = 0
    proc caft enabled {
        during contact
        require globals.vol == 1
        require presentation == Bob_Morlock
    } then {
        say Bob_Morlock presentation=text_only chatter : "Cap'n Bob, I have to tell you the Commander has behaved very badly|..."
        say Bob_Morlock presentation=text_only chatter : "He stole money from a defenceless Izwal of planet Corpo and then he spent it|..."
        say Bob_Morlock presentation=text_only chatter : "I'm sorry to say it's true|..."
        say Bob_Morlock presentation=bobf.hnm : "Miserable machine|!!! WHO DO YOU THINK YOU ARE|? He did whatever the situation demanded|..."
        say Bob_Morlock presentation=bobe.hnm resume_at=time : "True|, Commander|?" choices "yes" "no"
        when {
            require choice == "yes"
        } then {
            say Bob_Morlock presentation=bobe.hnm : "Well|... If I remember|, there wasn't a lot of choices|..."
            say Bob_Morlock presentation=text_only chatter if_not_shown skip_next=1 : "Exactly|..."
            choice = none
        }
        when {
            require choice == "no"
        } then {
            say Bob_Morlock presentation=bobf.hnm : "You see|, you pathetic excuse for a machine|: YOU'RE A LIAR|!!! I knew it all along|..."
            say Bob_Morlock presentation=text_only chatter : "But Cap'n Bob|... I swear it's true|..."
            say Bob_Morlock presentation=bobc.hnm if_not_shown skip_next=2 : "SILENCE|!!!"
            globals.vol = 0
            choice = none
        }
    }
    global vol = 0
    proc time enabled {
    } then {
        timer[3] = 10
        timer[4] = 200
        Scruter_K.known_objects += blood
        time.enabled = false
    }
    proc radioscr enabled {
        require timer[3] == 0
    } then {
        queue presentation Scruter_K
        sort.enabled = true
        radioscr.enabled = false
    }
    proc sort disabled {
        during bridge
        require presentation == Scruter_K
    } then {
        debo:
        say Scruter_K presentation=text_only chance=20% if_not_shown skip_next=1 : ""
        globals.SS = 1
        say Scruter_K presentation=text_only chance=20% if_not_shown skip_next=1 : ""
        globals.SS = 2
        say Scruter_K presentation=text_only chance=20% if_not_shown skip_next=1 : ""
        globals.SS = 3
        say Scruter_K presentation=text_only chance=20% if_not_shown skip_next=1 : ""
        globals.SS = 4
        say Scruter_K presentation=text_only chance=20% if_not_shown skip_next=1 : ""
        globals.SS = 5
        when {
            require globals.SS == 0
        } then {
            jump debo
        }
        when {
            require globals.SS > 0
        } then {
            sort.enabled = false
            radio1.enabled = true
        }
    }
    export label "debo"
    global SS = 0
    proc radio1 disabled {
        during bridge
        require presentation == Scruter_K
    } then {
        when {
            require globals.SS == 1
        } then {
            say Scruter_K presentation=text_only : "MESSAGE RADIO:"
            say Scruter_K presentation=text_only : "Calling garbage scow|:"
            say Scruter_K presentation=text_only : "This is SCRUT robot \"HYDRAULIC JACK OF TITANIUM ALLOY\", squadron commander|..."
            say Scruter_K presentation=text_only : "You are in a forbidden zone|... THIS IS A WARNING|..."
            say Scruter_K presentation=text_only : "YOU ARE SCHEDULED FOR VAPORIZATION IN TWO MINUTES|, TEN SECONDS|..."
            say Scruter_K presentation=text_only : "MAKE THAT NINE SECONDS|..."
            say Scruter_K presentation=text_only : "EIGHT SECONDS|..."
            say Scruter_K presentation=text_only : "SEVEN|..."
            say Scruter_K presentation=text_only : "Get that garbage wagon out of here|! Scram|! Otherwise my hi-powered laser weapons will spell death|!!!..."
            say Scruter_K presentation=text_only chatter : "REPORT FROM THE ARK'S ONBOARD COMPUTER FACILITY|, HONK|:"
            say Scruter_K presentation=text_only chatter : "Commander|, He means it|... the whole zone's filled with guys like him|: RED ALERT"
        } else {
            when {
                require globals.SS == 2
            } then {
                say Scruter_K presentation=text_only : "MESSAGE RADIO:"
                say Scruter_K presentation=text_only : "LISTEN UP"
                say Scruter_K presentation=text_only : "This is SCRUT robot \"NONSTICK HEART\"|, area sub-director|, calling garbage can|..."
                say Scruter_K presentation=text_only : "THIS IS A WARNING|... YOU ARE IN A FORBIDDEN ZONE"
                say Scruter_K presentation=text_only : "PREPARE FOR PAINFUL OBLITERIZATION IN TEN SECONDS|..."
                say Scruter_K presentation=text_only : "NINE SECONDS|..."
                say Scruter_K presentation=text_only : "TWELVE SECONDS|..."
                say Scruter_K presentation=text_only : "UH|, SORRY ABOUT THAT|..."
                say Scruter_K presentation=text_only : "EIGHT|..."
                say Scruter_K presentation=text_only : "LEAVE NOW OR MEET ROSEBUD|? MY LASER-PULPER"
                say Scruter_K presentation=text_only chatter : "Honk reports in at this time|:"
                say Scruter_K presentation=text_only chatter : "I advise we comply fast|, Commander. He's liable to skip four and three|..."
            } else {
                when {
                    require globals.SS == 3
                } then {
                    say Scruter_K presentation=text_only : "MESSAGE RADIO:"
                    say Scruter_K presentation=text_only : "ATTENTION|..."
                    say Scruter_K presentation=text_only : "THIS IS SCRUT TROOPER \"TUNG STEN\"|, TO UNKNOWN SHIP-TYPE THING|..."
                    say Scruter_K presentation=text_only : "I HAVE THE FOLLOWING WARNING|: THIS SECTOR IS FORBIDDEN TO Y-O-U|!!!"
                    say Scruter_K presentation=text_only : "WE WILL MANGLE YOUR BODY ORGANS|, MELT DOWN YOUR MELTABLE PARTS|, AND ALSO VITRIFY YOU IF YOU DON'T GO AWAY"
                    say Scruter_K presentation=text_only : "THREE SECONDS|..."
                    say Scruter_K presentation=text_only : "TWO SECONDS|..."
                    say Scruter_K presentation=text_only chatter : "Honk reports|, in the nick of time|:"
                    say Scruter_K presentation=text_only chatter : "Red Alert|!"
                } else {
                    when {
                        require globals.SS == 4
                    } then {
                        say Scruter_K presentation=text_only : "MESSAGE RADIO:"
                        say Scruter_K presentation=text_only : "OKAY WHOEVER YOU ARE"
                        say Scruter_K presentation=text_only : "This is low-ranking SCRUT robot \"STAINLESS STEEL CASING\"|, CALLING FLYING JUNK HEAP|..."
                        say Scruter_K presentation=text_only : "MOVE OUT OF THIS FORBIDDEN SECTOR|... AND MAKE IT SNAPPY|, BUDDY BOY|!!!"
                        say Scruter_K presentation=text_only : "Otherwise you get STOMPED ON|..."
                        say Scruter_K presentation=text_only : "YOU HAVE TEN SECONDS BEFORE ANNIHILATION SETS IN|..."
                        say Scruter_K presentation=text_only : "NINE SECONDS|..."
                        say Scruter_K presentation=text_only : "TWELVE SECONDS|..."
                        say Scruter_K presentation=text_only : "OKAY OKAY|, WISE GUY|!"
                        say Scruter_K presentation=text_only : "YOU DO THE COUNTING|..."
                        say Scruter_K presentation=text_only : "CRUIIIIK!"
                        say Scruter_K presentation=text_only chatter : "Report from Honk|, onboard computing entity|:"
                        say Scruter_K presentation=text_only chatter : "It's true he's no shining beacon of brainpower|, Commander|. And yet I feel moved by his obvious sincerity|..."
                    } else {
                        when {
                            require globals.SS == 5
                        } then {
                            say Scruter_K presentation=text_only : "MESSAGE RADIO:"
                            say Scruter_K presentation=text_only : "LISTEN UP"
                            say Scruter_K presentation=text_only : "THIS IS SCRUT ROBOT \"TENSILE SHEET METAL\"|, AREA CHIEF|, TO UNKNOWN VESSEL|..."
                            say Scruter_K presentation=text_only : "THIS IS A PL7K stroke 38B WARNING|: YOU HAVE TWO MINUTES TO EVACUATE THE SECTOR"
                            say Scruter_K presentation=text_only : "FAILURE TO COMPLY WITH ABOVE PL7K stroke 38B WARNING WILL RESULT IN A 1010|..."
                            say Scruter_K presentation=text_only : "YOURS SINCERELY|,"
                            say Scruter_K presentation=text_only : "SIGNED|: SCRUTER \"TENSILE SHEET METAL\"|, AREA CHIEF WITH ADDED LASER POWER"
                            say Scruter_K presentation=text_only chatter : "Heeeere's Honky|!|..."
                            say Scruter_K presentation=text_only chatter : "That stuff about 1010|? That's their way of saying meet your maker|. There's a big bunch of them SCRUT ships around here|..."
                            jump fl1
                        }
                    }
                }
            }
        }
        fl1:
        say Scruter_K presentation=text_only chatter if_not_shown skip_next=1 : "Whaddaya say we just do like the robot says before the laser pulpers kick in|..."
        Scruter_K.known = false
        say Scruter_K presentation=text_only chatter if_not_shown skip_next=1 : "CLICK ON THE RED BUTTON ON THE MAP|, SELECT A PLANET AND PUSH THE CONTROL STICK|..."
        globals.A0 = 1
        say Scruter_K presentation=text_only if_not_shown skip_next=5 : "stop"
        radio1.enabled = false
        radioscr.enabled = false
        timer[8] = 10
        radio1.enabled = false
        end presentation Scruter_K
    }
    export label "fl1"
    global A0 = 0
    proc dring enabled {
        require Izwalito.encounter_count < 2
        require Scruter_Jo.encounter_count < 2
        require timer[8] == 0
    } then {
        queue presentation Scruter_K
        globals.T1 = 1
        dring.enabled = false
    }
    global T1 = 0
    proc encor enabled {
        require globals.T1 == 1
        during bridge
        require presentation == Scruter_K
    } then {
        say Scruter_K presentation=text_only : "MESSAGE RADIO:"
        say Scruter_K presentation=text_only : "This is SCRUT agent K|, district director|. Message to unknown vessel|..."
        when {
            require arche.current_location != Corpo
        } then {
            say Scruter_K presentation=text_only : "You deaf or something|?"
            say Scruter_K presentation=text_only : "Get out of here|... SWEAR|... INSULT|..."
            say Scruter_K presentation=text_only if_not_shown skip_next=1 : "FINAL WARNING"
            globals.kill = 1
        }
        when {
            require arche.current_location == Corpo
        } then {
            say Scruter_K presentation=text_only : "Next time|, you'll really get it|..."
            say Scruter_K presentation=text_only : "You won't have time to be sorry|..."
            say Scruter_K presentation=text_only : "Ha! Ha! Ha! Ha!|...|...|...|...|...|...|... Hurk|! Hurk|! Haurk|!"
            say Scruter_K presentation=text_only chatter : "REPORT FROM HONK:"
            say Scruter_K presentation=text_only chatter : "Commander|! Commander|! We really fooled those dummies|... Ha! Ha! Ha! Ha!"
            say Scruter_K presentation=text_only chatter : "Hm|! Sorry about that|..."
            when {
                require globals.A1 == 0
            } then {
                say Scruter_K presentation=text_only chatter : "Click on the planet Corpo|. The Orxx will be automatically ejected|..."
            }
        }
        say Scruter_K presentation=text_only if_not_shown skip_next=1 : "..."
        mark Scruter_K as unknown
        say Scruter_K presentation=text_only if_not_shown skip_next=5 : "stop"
        encor.enabled = false
        globals.T1 = globals._2D1
        destroy.enabled = true
        radiof.enabled = true
        end presentation Scruter_K
    }
    global kill = 0
    global A1 = 0
    global _2D1 as "-1" = 0
    proc destroy disabled {
        require globals.kill == 1
        require timer[4] == 0
    } then {
        radio1.enabled = false
        queue presentation Scruter_K
        last.enabled = true
        destroy.enabled = false
    }
    proc last disabled {
        during bridge
        require presentation == Scruter_K
    } then {
        say Scruter_K presentation=text_only : "MESSAGE RADIO:"
        say Scruter_K presentation=text_only : "SWEAR|... INSULT|... SWEAR|... ROARS|... INSULT|..."
        say Scruter_K presentation=text_only : "You're lucky we've been called to another sector|... INSULT|..."
        say Scruter_K presentation=text_only : "WE'LL MEET AGAIN|... YOU'LL SEE|..."
        say Scruter_K presentation=text_only : "HEAK|! HUURK|!!! FILTHY INSULT|..."
        say Scruter_K presentation=text_only if_not_shown skip_next=2 : "STOP"
        end presentation Scruter_K
        last.enabled = false
    }
    proc init enabled {
        require globals.A0 == 1
    } then {
        mark Corpo as known
        globals.Korpo_WW = globals.etat
        mark Pterra as known
        init.enabled = false
    }
    global Korpo_WW = 0
    global etat = 0
    proc radiof disabled {
        require arche.current_location == Corpo
    } then {
        radioscr.enabled = false
        radio1.enabled = false
        destroy.enabled = false
        mark Scruter_K as unknown
        radiof.enabled = false
    }
    proc rhom1 enabled {
        during bridge
        require globals.CO == 0
        require arche.current_location == Magnus
    } then {
        queue presentation Scruter_Mac
        rhom1b.enabled = true
        rhom1.enabled = false
    }
    global CO = 0
    proc rhom1b disabled {
        during bridge
        require presentation == Scruter_Mac
    } then {
        say Scruter_Mac presentation=text_only if_not_shown skip_next=1 : "MESSAGE RADIO:"
        Scruter_Mac.topic = "rien"
        say Scruter_Mac presentation=text_only : "Beep beep bop bop bop beeep Tiiiii TATATA scraaak|..."
        say Scruter_Mac presentation=text_only chatter : "HONK REPORTING IN|:"
        say Scruter_Mac presentation=text_only chatter : "Commander|, that weird message you just heard came from a distant point in the galaxy|. It's coded|..."
        say Scruter_Mac presentation=text_only chatter : "Excuse me while I figure out what vital information it contains|..."
        say Scruter_Mac presentation=text_only if_not_shown skip_next=5 : "stop"
        rhom2.enabled = true
        Scruter_Mac.encounter_count = 0
        globals.CO = 1
        rhom1b.enabled = false
        end presentation Scruter_Mac
    }
    proc rhom2 disabled {
        require globals.CO == 1
        during bridge
        require arche.current_location == Moskito
    } then {
        queue presentation Scruter_Mac
        rhom2b.enabled = true
        rhom2.enabled = false
    }
    proc rhom2b disabled {
        during bridge
        require presentation == Scruter_Mac
    } then {
        say Scruter_Mac presentation=text_only : "MESSAGE RADIO:"
        say Scruter_Mac presentation=text_only : "Beep beep bop bop bop beeep|... Tut Tut Ts Ts Tsk Craaak|..."
        say Scruter_Mac presentation=text_only : "KRUIKK|!"
        say Scruter_Mac presentation=text_only chatter : "HONK REPORTS|:"
        say Scruter_Mac presentation=text_only chatter : "Commander|, I decoded the first word|. It says CODED|. Funny|, wouldn't you say|?"
        say Scruter_Mac presentation=text_only chatter : "CODED|... Well how about that|!"
        say Scruter_Mac presentation=text_only if_not_shown skip_next=5 : "stop"
        rhom3.enabled = true
        Scruter_Mac.encounter_count = 0
        globals.CO = 2
        rhom2b.enabled = false
        end presentation Scruter_Mac
    }
    proc rhom3 disabled {
        during bridge
        require arche.current_location == Corpo
        require globals.CO == 2
    } then {
        queue presentation Scruter_Mac
        rhom3b.enabled = true
        rhom3.enabled = false
    }
    proc rhom3b enabled {
        during bridge
        require presentation == Scruter_Mac
    } then {
        say Scruter_Mac presentation=text_only : "MESSAGE RADIO:"
        say Scruter_Mac presentation=text_only : "Bee bee rla rla bop bop bop beeep|... Turlu ta ta ta tweeeeet|..."
        say Scruter_Mac presentation=text_only : "KRUIKK|!"
        say Scruter_Mac presentation=text_only chatter : "HONK SPEAKING|:"
        say Scruter_Mac presentation=text_only chatter : "Commander|, I decoded the second word|. It says MESSAGE|...|..."
        say Scruter_Mac presentation=text_only chatter : "Now|, that gives us|... CODED MESSAGE:\"EXXOS\"|... That proves I was right|, Commander|! The message is coded|!"
        say Scruter_Mac presentation=text_only chatter : "I don't mind believing in coincidences, Commander|, but that one's a biggie, right|?"
        say Scruter_Mac presentation=text_only chatter : "You'll remember to tell ol' Buzzard Man Bob I cracked the code|, won't you|, Commander|?"
        say Scruter_Mac presentation=text_only if_not_shown skip_next=4 : "stop"
        globals.CO = 3
        Scruter_Mac.encounter_count = 0
        rhom3b.enabled = false
        end presentation Scruter_Mac
    }
    proc timy enabled {
    } then {
        timer[12] = 1200
        timy.enabled = false
    }
    proc timx enabled {
    } then {
        when {
            require timer[12] == 0
        } then {
            globals.ti += 1
            timer[12] = 1200
        }
    }
    proc tim1 enabled {
        require globals.ti == 1
    } then {
        Ulikan.known = true
        queue presentation Ulikan
    }
    proc tim1B enabled {
        during bridge
        require presentation == Ulikan
        require globals.ti == 1
    } then {
        when {
            require annual_date == 1994-12-25
        } then {
            say Ulikan presentation=text_only : "MERRY CHRISTMAS|..."
            sequence_slots[2] = "christmas"
        }
        when {
            require annual_date == 1994-01-01
        } then {
            say Ulikan presentation=text_only : "HAPPY NEW YEAR|..."
            sequence_slots[2] = "year"
        }
        say Ulikan presentation=text_only : "Network|..."
        say Ulikan presentation=text_only : "modem activated"
        say Ulikan presentation=text_only : "Rate 12,000 baud|..."
        say Ulikan presentation=text_only : "Connect"
        say Ulikan presentation=text_only : ".5"
        say Ulikan presentation=text_only : ".4"
        say Ulikan presentation=text_only : ".3"
        say Ulikan presentation=text_only : ".2"
        say Ulikan presentation=text_only : ".1"
        say Ulikan presentation=text_only : ".0"
        say Ulikan presentation=text_only : "CONNECTION... COMMANDER BLOOD GAME"
        say Ulikan presentation=text_only : "Pirate message|: \"CYBERION JUNIOR\" calling. You're playing Commander Blood|... You got tips or codes|?"
        say Ulikan presentation=text_only : "Let's swap codes|..."
        say Ulikan presentation=text_only : "You found the robot Morning-Oil|... Teleport him|..."
        say Ulikan presentation=text_only : "Buy the batteries at VENUSIA|, the space supramarket|..."
        say Ulikan presentation=text_only : "This is costing me too much|..."
        when {
            require clock.hour < 8
            require clock.hour > 2
        } then {
            say Ulikan presentation=early_morning_signoff : "YOU SURE GET UP EARLY TO PLAY|... I GOTTA GO|... SEE YA|!"
        } else {
            when {
                require clock.hour < 12
                require clock.hour > 8
            } then {
                say Ulikan presentation=morning_signoff : "BEAUTIFUL MORNING|... SEE YA"
            } else {
                when {
                    require clock.hour > 21
                    require clock.hour < 2
                } then {
                    say Ulikan presentation=night_signoff : "NITE NITE|... DON'T STAY UP TOO LATE|. TOMORROW ALWAYS COMES|..."
                } else {
                    when {
                        require clock.hour > 18
                        require clock.hour < 21
                    } then {
                        say Ulikan presentation=evening_signoff : "HAVE FUN|... MY MOM SAYS SUPPER'S READY|..."
                    } else {
                        when {
                            require clock.hour > 12
                            require clock.hour < 18
                        } then {
