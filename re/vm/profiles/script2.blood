        say Bob_Morlock presentation=bobd.hnm : "I'm listening, Commander|..."
        timer[1] = 120
        when {
            require timer[1] == 0
        } then {
            say Bob_Morlock presentation=bobg.hnm : "I'm too hot|... I need to cryonize|..."
