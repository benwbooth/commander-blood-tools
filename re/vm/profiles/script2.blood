    proc boba1 enabled {
        during contact
        require presentation == Bob_Morlock
        require globals.BO == 0
    } then {
        say Bob_Morlock presentation=bobc.hnm : "HONK|! You worthless heap of wires|... Are you working|?"
        say Bob_Morlock presentation=text_only chatter : "Yes sir, Cap'n Bob sir|!|... Just getting the multiplexers toned up|..."
        say Bob_Morlock presentation=bobd.hnm if_not_shown skip_next=1 : "What do you want to know|, Commander|?"
        timer[1] = 50
        when {
            require timer[1] == 0
        } then {
            say Bob_Morlock presentation=bobg.hnm : "I feel like a dog I micro-waved by mistake one day|... I have to cryonize|..."
            say Bob_Morlock presentation=bobd.hnm : "Ahhhh|!!!"
            say Bob_Morlock presentation=text_only if_not_shown skip_next=3 : "stop"
            globals.BO = 2
            timer[1] = disabled
            end presentation Bob_Morlock
        }
        say Bob_Morlock presentation=bobg.hnm if_not_shown skip_next=1 : "I feel weak|, Commander|... Let me sleep|..." choices "bye_bye"
        globals.adieu = 1
        when {
            require globals.adieu == 1
        } then {
            say Bob_Morlock presentation=text_only chatter : "Ah, sleep|..."
            say Bob_Morlock presentation=text_only if_not_shown skip_next=4 : "stop"
            globals.adieu = 0
            globals.BO = 2
            timer[1] = disabled
            end presentation Bob_Morlock
        }
    }
