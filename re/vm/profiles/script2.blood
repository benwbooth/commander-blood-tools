logic {
    proc pter enabled {
        during travel
        require presentation == Scruter_Jo
        require arche.current_location == Pterra
    } then {
        say Scruter_Jo presentation=scr02.hnm : "ME SCRUTER JO: SCANNING STRANGER...XRAY....STOP"
        say Scruter_Jo presentation=scr02.hnm : "ZONE ULTRAFORBIDDEN YOU NOT STAY HERE|... YOU GO AWAY|..."
        say Scruter_Jo presentation=scr02.hnm if_not_shown skip_next=1 : "FIRST WARNING|..."
        sequence_slots[4] = "scrut"
        when {
            require Scruter_Jo.encounter_count > 1
        } then {
            say Scruter_Jo presentation=text_only chatter : "Oh no|! Him again|... Commander|, I don't feel happy about that SCRUT robot|..."
            say Scruter_Jo presentation=text_only chatter : "We'll need to be smart|, cunning|, intelligent and clever|..."
        }
        when {
            require Scruter_Jo.encounter_count == 2
        } then {
            say Scruter_Jo presentation=text_only chatter : "Watch out|, Commander|... Second try|... Don't blow it|..."
        }
        when {
            require Scruter_Jo.encounter_count == 3
        } then {
            say Scruter_Jo presentation=text_only chatter : "I think I found the code|, Commander... It's the number 9|..."
        }
        say Scruter_Jo presentation=scr02.hnm resume_at=pter_dialogue_resume_1 : "You give identity code|:" choices "robyx" "code" "ulikan" "69" "exxos" "electret" "666" "9"
        when {
            require choice == "exxos"
        } then {
            say Scruter_Jo presentation=scr03.hnm : "Yes|! Code be EXXOS. You be very Important Being|..."
            say Scruter_Jo presentation=text_only chatter : "Nice work|, Commmander|, I've got to hand it to you|... How did you figure it out|?"
            say Scruter_Jo presentation=text_only chatter : "Ol' Turkey Face Bob'll be proud of you when I tell him|..."
            say Scruter_Jo presentation=scr02.hnm : "You did give code|. You are the MASTER|..."
            choice = none
        }
        when {
            require choice != "exxos"
        } then {
            say Scruter_Jo presentation=scr04.hnm : "You unauthorized|. Me exterminate you now|..."
            say Scruter_Jo presentation=text_only chatter : "Uh oh Commander|. He's gonna zap the Orxx..."
            say Scruter_Jo presentation=scr05.hnm : "Bye bye|, unauthorized strangers|..."
            say Scruter_Jo presentation=text_only if_not_shown skip_next=3 : "BAAANG!!!"
            request sequence "explo3.hnm"
            end presentation Scruter_Jo
            choice = none
        }
        pter_dialogue_resume_1:
        say Scruter_Jo presentation=scr06.hnm : "GIVE ME YOUR ORDERS|, MASTER|. I am yours|..."
        say Scruter_Jo presentation=text_only chatter : "Commander|, We found the code for programming him|..."
        say Scruter_Jo presentation=text_only chatter resume_at=scrub : "Let's teleport him|, Commander|. I ought to take a good look at him|..." choices "teleport" "refuse"
        when {
            require choice == "teleport"
        } then {
            say Scruter_Jo presentation=text_only if_not_shown skip_next=3 : "TELEPORT SCRUTER JO TO CRYOBOX"
            Scruter_Jo.current_location = aboard
            end presentation Scruter_Jo
            choice = none
        }
        when {
            require choice == "refuse"
        } then {
            say Scruter_Jo presentation=text_only chatter if_not_shown skip_next=2 : "You're the commander|, Commander|..."
            choice = none
            end presentation Scruter_Jo
        }
    }
    proc scrub enabled {
        during contact
        require presentation == Scruter_Jo
    } then {
        say Scruter_Jo presentation=text_only chatter : "I've reprogrammed him|, Commander|... And I've discovered something weird|..."
        say Scruter_Jo presentation=text_only chatter : "These SCRUT robots use a psychic structure based on CYBERSPACE|..."
        say Scruter_Jo presentation=text_only chatter : "I've rigged a system so you can enter it|, Commander... That way you can get some BIONIUM..."
        say Scruter_Jo presentation=text_only chatter : "The energy source computers are wild about..."
        say Scruter_Jo presentation=text_only chatter if_not_shown skip_next=1 : "Ask SCRUTER JO a few questions|, Commander|. You'll understand|..."
        scrub.enabled = false
    }
    proc scrujo enabled {
        during contact
        require presentation == Scruter_Jo
    } then {
        say Scruter_Jo presentation=scr20.hnm : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
        when {
            require globals.compris == 0
        } then {
            say Scruter_Jo presentation=text_only : "Me explain to you how get BIONIUM..."
            dictionary blank after "explain"
            say Scruter_Jo presentation=text_only : "You find BIOXX|. Bioxx be small energy creatures|..."
            say Scruter_Jo presentation=scr02.hnm : "You touch BIOXX with hand|."
            say Scruter_Jo presentation=text_only chatter : "Sounds like a piece of cake to me|, Commander|!!"
            say Scruter_Jo presentation=scr03.hnm : "If you touch BIOXX, you CAPTURE BIOXX on tip of your finger|..."
            say Scruter_Jo presentation=text_only chatter : "Catch him on the tip of your finger|!!! Sounds easy as pie|, Commander|..."
            say Scruter_Jo presentation=scr04.hnm : "Then you can carry BIOXX to cybernetic MANTAS"
            say Scruter_Jo presentation=scr06.hnm : "You place BIOXX in belly of Manta..."
            say Scruter_Jo presentation=scr05.hnm : "BIOXX stay stuck to MANTAS..."
            say Scruter_Jo presentation=text_only chatter : "I'd love to see that|..."
            say Scruter_Jo presentation=scr07.hnm : "Mantas change BIOXX into BIONIUM..."
            say Scruter_Jo presentation=scr06.hnm : "More BIOXX you give to Mantas, more BIONIUM you get|..."
            say Scruter_Jo presentation=text_only chatter : "Yes|!!! BIONIUM|... I can taste it already|..."
            say Scruter_Jo presentation=scr05.hnm : "To come back from CYBERSPACE|, you touch BLUE BOX|...."
            say Scruter_Jo presentation=scr07.hnm : "You understand|?"
            say Scruter_Jo presentation=text_only chatter : "We understand perfectly|, Mister SCRUTER JO... Right|, Commander?"
        }
        say Scruter_Jo presentation=scr21.hnm : "YOU go|, Commander|..."
        say Scruter_Jo presentation=scr22.hnm : "Ahh! Me feel better|..."
        when {
            require globals.vbio > 0
        } then {
            say Scruter_Jo presentation=scr03.hnm : "Good work|... You did succeed|..."
            say Scruter_Jo presentation=scr04.hnm : "You did get BIONIUM..."
            say Scruter_Jo presentation=text_only chatter : "YES|!!! Commander|, remind me to tell you you're a champ|..."
            say Scruter_Jo presentation=text_only chatter : "This BIONIUM is extraordinary|. My clock frequency's through the roof|..."
            say Scruter_Jo presentation=text_only chatter if_not_shown skip_next=1 : "I feel even smarter|... I can feel I'll be a great help to you|, Commander|..."
            globals.compris = 1
        }
        when {
            require globals.vbio == 0
        } then {
            say Scruter_Jo presentation=scr05.hnm : "Not good|, friend|... You fail|..."
            say Scruter_Jo presentation=text_only chatter : "Commander, you didn't understand the technique|..."
            say Scruter_Jo presentation=text_only chatter : "I need BIONIUM, Commander|. It makes me smarter|..."
            say Scruter_Jo presentation=scr05.hnm : "Ha! Ha! You need much much BIONIUM|. Ha! Ha!..."
            say Scruter_Jo presentation=text_only chatter : "Why don't you shut up|, wiseguy|!!!"
        }
        say Scruter_Jo presentation=scr08.hnm if_not_shown skip_next=1 : "Bye bye|, Commander|. Me return to CYBERSPACE..."
        end presentation Scruter_Jo
    }
    global compris = 0
    global vbio = 0
    proc menbr enabled {
        during bridge
        require presentation == menu
        require Bronko.current_location == aboard
    } then {
        say menu presentation=text_only : "\"IMPROVED MENU\""
        say menu presentation=text_only : "Today CHEF BRONKO has laid on for you|:"
        say menu presentation=text_only : "Tasty MURFFALO soup Bronko-style|."
        say menu presentation=text_only : "MURFFALO kidneys Bronko-style|."
        say menu presentation=text_only : "MURFFALO hamburger with Bar-B-Q recycled-oil dip|."
        say menu presentation=text_only : "Smooth MURFFALO-chip ice cream|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "Chef Bronko says|... Burping's bad manners|!|..."
        say menu presentation=text_only if_not_shown skip_next=1 : "stop"
        end presentation menu
    }
    proc men1 enabled {
        during bridge
        require presentation == menu
        require Bronko.current_location != aboard
    } then {
        say menu presentation=text_only : "\"MENU\""
        say menu presentation=text_only : "Today's fare|:"
        say menu presentation=text_only : "PLASMA soup HONK-style|."
        say menu presentation=text_only : "WRIGGLER belly in slobber sauce|."
        say menu presentation=text_only : "Jellied URTIKAN with MURFFALO bone marrow|."
        say menu presentation=text_only : "GLOK eye pie|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "The chef says|... Don't eat with your mouth full|!|..."
        say menu presentation=text_only if_not_shown skip_next=2 : "Stop"
        men1.enabled = false
        end presentation menu
    }
    proc men2 enabled {
        during bridge
        require presentation == menu
        require Bronko.current_location != aboard
    } then {
        say menu presentation=text_only : "\"MENU\""
        say menu presentation=text_only : "Today's fare|:"
        say menu presentation=text_only : "PLASMA soup HONK-style|."
        say menu presentation=text_only : "WRIGGLER snout stew|."
        say menu presentation=text_only : "URTIKAN seeds in MURFFALO venom|."
        say menu presentation=text_only : "GLOK juice dessert|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "The chef says|... Don't talk with your mouth open|!|..."
        say menu presentation=text_only if_not_shown skip_next=2 : "stop"
        men2.enabled = false
        end presentation menu
    }
    proc men3 enabled {
        during bridge
        require Bronko.current_location != aboard
        require presentation == menu
    } then {
        say menu presentation=text_only : "\"MENU\""
        say menu presentation=text_only : "Today's fare|:"
        say menu presentation=text_only : "PLASMA soup HONK-style|."
        say menu presentation=text_only : "WRIGGLER feet in emulsive sauce|."
        say menu presentation=text_only : "URTIKAN leaves in MURFFALO sweat|."
        say menu presentation=text_only : "GLOK flake dessert|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "The chef says|... Somebody didn't finish his wrigglers yesterday|..."
        say menu presentation=text_only if_not_shown skip_next=2 : "stop"
        men3.enabled = false
        end presentation menu
    }
    proc men4 enabled {
        during bridge
        require presentation == menu
        require Bronko.current_location != aboard
    } then {
        say menu presentation=text_only : "\"MENU\""
        say menu presentation=text_only : "Today's fare|:"
        say menu presentation=text_only : "HONK-style PLASMA soup|."
        say menu presentation=text_only : "WRIGGLER brain|, stewed in its own juice|."
        say menu presentation=text_only : "URTIKAN trunk|, stuffed with MURFFALO liver|."
        say menu presentation=text_only : "GLOK dee-lite|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "The chef says|... Plenty more in the kitchen|!|..."
        say menu presentation=text_only if_not_shown skip_next=2 : "stop"
        men4.enabled = false
        end presentation menu
    }
    proc men5 enabled {
        during bridge
        require presentation == menu
        require Bronko.current_location != aboard
    } then {
        say menu presentation=text_only : "\"IMPROVED MENU\""
        say menu presentation=text_only : "Today's fare|:"
        say menu presentation=text_only : "Soup of PLASMA HONK-style|."
        say menu presentation=text_only : "WRIGGLER hearts in green blood coagulate|."
        say menu presentation=text_only : "URTIKAN roots|, deep fried in recycled oil|."
        say menu presentation=text_only : "Candied GLOK tongue|."
        say menu presentation=text_only : "Recycled water"
        say menu presentation=text_only : "The chef says|... You eat what you are|!|..."
        say menu presentation=text_only if_not_shown skip_next=3 : "stop"
        men5.enabled = false
        men6.enabled = true
        end presentation menu
    }
    proc men6 disabled {
    } then {
        men1.enabled = true
        men2.enabled = true
        men3.enabled = true
        men4.enabled = true
        men5.enabled = true
        men6.enabled = false
