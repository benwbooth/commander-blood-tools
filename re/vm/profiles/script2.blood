        corrp3_dialogue_resume_1:
        say Izwalito presentation=iswe.hnm : "This not be murffalo from MOSKITO, friend|. You make big mistake|..."
        say Izwalito presentation=iswd.hnm : "This murffalo be too expensive and very small|. Me ask big juicy murffalo from planet Moskito|..."
        say Izwalito presentation=iswe.hnm : "CRY CRY|...."
        say Izwalito presentation=iswd.hnm : "YOU SPEND CRED|... CRY CRY|..."
        say Izwalito presentation=text_only chatter : "COMMANDER, it's just what I thought|... This poor rat is smarter than you thought|. I suggest you make up for your error|..."
        say Izwalito presentation=iswc.hnm : "BYE BYE|... IZWALS UNHAPPY NOW|.... CRY DESPAIR|...."
        say Izwalito presentation=text_only if_not_shown skip_next=3 : "stop"
        globals.trak4 = 1
        globals.zob1 = 0
        end presentation Izwalito
    }
    proc corbis enabled {
