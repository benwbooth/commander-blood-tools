    proc Cryomorn2 enabled {
        during contact
        require Morning_Oil.current_location == aboard
        require globals.B1 == 2
        require batteries.holder == Morning_Oil
    } then {
        say Morning_Oil presentation=morn02.hnm : "Ahhh|... Morning Oil|, veteran of the Great Croolis War|, reporting for duty. I greet you and say thank you also..."
        say Morning_Oil presentation=morn03.hnm : "You gave me back my life|... Ah! I feel quite lubrified|, I must say|! Recharged batteries too, eh|?"
        say Morning_Oil presentation=morn04.hnm : "My gratitude knows no bounds|, noble ones|. And I just love your ship|. Not a model I'm familiar with|..."
        say Morning_Oil presentation=morn05.hnm : "Ahh|, if only you'd seen the SPIDER4000 I piloted|... Such invigorating combat|... BABOOOM... VRRRRRRR CHAKA CHAKA CHAKA|..."
        say Morning_Oil presentation=text_only chatter : "BIOCONSCIOUSNESS HONK REPORTS|:"
        say Morning_Oil presentation=text_only chatter : "Commander, this is one deranged robot we got here|. I hate him|..."
        say Morning_Oil presentation=morn06.hnm : "We fired at everything that moved|, naturally|... Luckily|, we managed to hide the treasure before the end|..."
        say Morning_Oil presentation=morn04.hnm : "And my revered master, the splendid Croolis EVISCERATOR was alas made prisoner|..."
        say Morning_Oil presentation=morn05.hnm : "He knows where the Croolis war treasure is hidden|..."
        say Morning_Oil presentation=text_only chatter : "HONK REPORTS|:"
        say Morning_Oil presentation=text_only chatter : "I think I'll just open him up and check that story|..."
        say Morning_Oil presentation=text_only chatter resume_at=Cryomorn2_dialogue_resume_1 : "He's bluffing|, Commander... I suppose you want me to switch him off now|?" choices "yes" "no"
        when {
            require choice == "no"
        } then {
            say Morning_Oil presentation=morn07.hnm : "NO|, YOU'RE OUT OF YOUR MIND|... I DON'T WANT THIS TO HAPPEN|... MOTHER|, HELP|!"
            say Morning_Oil presentation=text_only chatter : "HONK MAKES HIS REPORT|:"
            say Morning_Oil presentation=text_only chatter if_not_shown skip_next=1 : "Commander|, I think I'll switch him off anyway|... His program needs to be checked|..."
            choice = none
        }
        when {
            require choice == "yes"
        } then {
            say Morning_Oil presentation=morn07.hnm : "NO|, YOU'RE OUT OF YOUR MIND|... I DON'T WANT THIS TO HAPPEN|... MOTHER|, HELP|!"
            say Morning_Oil presentation=text_only chatter if_not_shown skip_next=1 : "HONK:Switch-off procedure activated|...."
            choice = none
        }
        Cryomorn2_dialogue_resume_1:
        say Morning_Oil presentation=text_only : "AAAAAAAAAAAAAAA..."
        say Morning_Oil presentation=text_only if_not_shown skip_next=3 : "stop"
        globals.trak15 = 1
        globals.B1 = 4
        end presentation Morning_Oil
    }
