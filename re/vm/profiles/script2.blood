    global eka = 0
    proc what enabled {
        during bridge
        require presentation == Honk
    } then {
        say Honk presentation=text_only chatter : "..."
        say Honk presentation=text_only chatter resume_at=what_dialogue_resume_1 : "What do you want Commander|?" choices "talk" "remember" "bye_bye"
        when {
            require choice == "remember"
        } then {
            miss.enabled = true
            choice = none
        }
        when {
            require choice == "talk"
        } then {
            Honk.topic = "explanations"
            choice = none
        }
        when {
            require choice == "bye_bye"
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=2 : "Service with a smile|! That's the story of my life|, Commander|..."
            choice = none
            end presentation Honk
        }
        what_dialogue_resume_1:
        when {
            require globals.scr > 5
        } then {
            say Honk presentation=text_only if_not_shown skip_next=1 : "CHEAT MODE..."
            Honk.topic = "rien"
            say Honk presentation=text_only chatter resume_at=what_dialogue_resume_2 : "Choose your script, Commander" choices "3" "4" "5"
            when {
                require choice == "3"
            } then {
                say Honk presentation=text_only if_not_shown skip_next=3 : "Script 3 selected..."
                run profile SCRIPT3
                choice = none
                end presentation Honk
            }
            when {
                require choice == "4"
            } then {
                say Honk presentation=text_only if_not_shown skip_next=3 : "Script 4 selected..."
                run profile SCRIPT4
                choice = none
                end presentation Honk
            }
            when {
                require choice == "5"
            } then {
                say Honk presentation=text_only if_not_shown skip_next=3 : "Script 5 selected..."
                run profile SCRIPT5
                choice = none
                end presentation Honk
            }
        }
        what_dialogue_resume_2:
        when {
            require choice == "bye_bye"
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Bye bye|, Commander..."
            end presentation Honk
        }
        when {
            require timer[15] == 0
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=2 : "Pardon me|,Commander|, but I have work to do|... I have to quadrify the multiplexers|... See you|!"
            timer[15] = disabled
            end presentation Honk
        }
        when {
            require Izwalito.encounter_count > 2
            require decoder.holder != aboard
            require cred.holder != blood
            require globals.ti == 1
        } then {
            say Honk presentation=text_only chatter if_not_shown skip_next=1 : "Commander, I just forged a CRED|! Take a look in the Cryobox|..."
            transfer cred from Izwalito to aboard
        }
    }
