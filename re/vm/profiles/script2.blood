    proc Corpo3 enabled {
        during travel
        require arche.current_location == Corpo
        require globals.A1 == 3
        require presentation == Izwalito
    } then {
        when {
            require murffalos.holder == blood
        } then {
            say Izwalito presentation=iswa1.hnm : "Friend|, you have murffalo meat|? We starve|..."
            say Izwalito presentation=iswc.hnm : "YOU HAVE MURFFALO|!!!|!!!"
            say Izwalito presentation=text_only chatter : "You've made one little rat very happy|, Commander|. Why not teleport him the meat|..."
            say Izwalito presentation=text_only resume_at=Corpo3_dialogue_resume_1 : "TELEPORT MURFFALO TO IZWALITO" choices "teleport" "refuse"
            when {
                require choice == "teleport"
            } then {
                say Izwalito presentation=text_only if_not_shown skip_next=2 : "MURFFALO TELEPORTED TO IZWALITO"
                transfer murffalos from aboard to Izwalito
                choice = none
            }
            when {
                require choice == "refuse"
            } then {
                say Izwalito presentation=text_only chatter : "Commander|, you're not being reasonable|..."
                say Izwalito presentation=iswf.hnm : "Me unhappy|... Me angry|..."
                say Izwalito presentation=iswe.hnm if_not_shown skip_next=2 : "Bye bye|..."
                choice = none
                end presentation Izwalito
            }
        }
        Corpo3_dialogue_resume_1:
        when {
            require murffalos.holder == Izwalito
        } then {
            say Izwalito presentation=iswb.hnm : "Oh, me happy now|. Izwal people say thanks|. Me give you big major gifts|..."
            say Izwalito presentation=iswe.hnm : "You can see TV with DECODER|. Me give you DECODER for IZWAL CHANNEL|..."
            say Izwalito presentation=text_only chatter : "A decoder|, Commander|! Now we can have some fun for a change|..."
            say Izwalito presentation=iswc.hnm if_not_shown skip_next=2 : "Thanks to DECODER|, you can see TV, friend..."
            sequence_slots[1] = "ppit"
            sequence_slots[5] = "present"
            say Izwalito presentation=text_only resume_at=Corpo3_dialogue_resume_2 : "TELEPORT DECODER TO ARK" choices "teleport"
            when {
                require choice == "teleport"
            } then {
                say Izwalito presentation=text_only if_not_shown skip_next=2 : "DECODER TELEPORTED TO ARK"
                transfer decoder from Izwalito to aboard
                choice = none
            }
            Corpo3_dialogue_resume_2:
            say Izwalito presentation=iswb.hnm : "You love decoder|, friend|..."
            say Izwalito presentation=iswb.hnm : "To reward you|, me give you one CRED|, friend|..."
            say Izwalito presentation=text_only chatter : "A cred|. Ratboy's handing over a free cred|!|... I knew it|... These guys are all millionaires|..."
            say Izwalito presentation=text_only resume_at=Corpo3_dialogue_resume_3 : "TELEPORT CRED TO ARK" choices "teleport"
            when {
                require choice == "teleport"
            } then {
                say Izwalito presentation=text_only if_not_shown skip_next=2 : "CRED TELEPORTED TO ARK"
                transfer cred from Izwalito to aboard
                choice = none
                say Izwalito presentation=iswb.hnm : "You love cred|, friend|..."
            }
        }
        Corpo3_dialogue_resume_3:
        say Izwalito presentation=iswb.hnm if_not_shown skip_next=1 : "You come back when want|, friend|..." choices "bye_bye"
        globals.adieu = 1
        when {
            require globals.adieu == 1
        } then {
            say Izwalito presentation=text_only : "Me go quick give murffalo to starving Izwals|..."
            say Izwalito presentation=text_only : "Bye bye|, friend|..."
            say Izwalito presentation=text_only if_not_shown skip_next=4 : "stop"
            globals.trak6 = 1
            globals.adieu = 0
            globals.A1 = 4
            end presentation Izwalito
        }
    }
    proc cor4bis enabled {
        during travel
        require murffalos.holder == Izwalito
        require !Rondo.known
        require arche.current_location == Corpo
        require presentation == Izwalito
    } then {
        say Izwalito presentation=iswb.hnm if_not_shown skip_next=1 : "Friend from sky and stars back on Corpo|..."
        globals.secret = 0
        say Izwalito presentation=iswc.hnm : "Me happy|, friend|..."
        say Izwalito presentation=iswd.hnm if_not_shown skip_next=1 : "You want what|?|..."
        Izwalito.topic = "talk"
        when {
            require globals.secret == 1
        } then {
            say Izwalito presentation=iswb.hnm : "You be very curious|, friend|..."
            say Izwalito presentation=iswc.hnm resume_at=cor4bis_dialogue_resume_1 : "You can keep secret|?" choices "yes" "no"
            when {
                require choice == "yes"
            } then {
                say Izwalito presentation=iswb.hnm if_not_shown skip_next=3 : "Me say you big secret|..."
                Izwalito.topic = "know"
                globals.secret = 0
                choice = none
            }
            when {
                require choice == "no"
            } then {
                say Izwalito presentation=text_only chatter : "Commander|!!! How can you be so lacking in perspicacity|? You were supposed to say YES|..."
                say Izwalito presentation=iswd.hnm if_not_shown skip_next=1 : "You like make joke|..."
                choice = none
            }
        }
        cor4bis_dialogue_resume_1:
        when {
            require !Rondo.known
            require Izwalito.encounter_count > 5
        } then {
            say Izwalito presentation=iswd.hnm : "You go see rich Izwals on planet Rondo, friend|... You say them hello from me|..."
            say Izwalito presentation=iswe.hnm if_not_shown skip_next=1 : "Rondo be in Rondalus system|, coordinates x345 y432|..."
            Rondo.known = true
            say Izwalito presentation=text_only chatter : "Commander|, Commander he just gave us a new planetary position would you believe|, Commander|..."
        }
        say Izwalito presentation=iswe.hnm if_not_shown skip_next=1 : "Bye bye|, come back|... You talk good|. Me like talk|...." choices "bye_bye"
        end presentation Izwalito
    }
    proc Corpo4 enabled {
        during travel
        require murffalos.holder == Izwalito
        require globals.G1 == 0
        require !Hita.known
        require Rondo.known
        require arche.current_location == Corpo
        require presentation == Izwalito
    } then {
        say Izwalito presentation=iswb.hnm if_not_shown skip_next=1 : "Izwalito happy see you|, friend from sky and stars|..."
        Corpo3.enabled = false
        say Izwalito presentation=iswb.hnm : "We receive big visit from His Sacredness HOM|... Hom be in next village|..."
        say Izwalito presentation=iswc.hnm : "Village be Hita..."
        say Izwalito presentation=iswc.hnm : "His Sacredness wants to see you|, friend|..."
        say Izwalito presentation=iswb.hnm resume_at=hom1 : "You agree go Hita?" choices "YES" "NO"
        when {
            require choice == "YES"
        } then {
            say Izwalito presentation=iswf.hnm : "You go north through desert to Hita|..."
            say Izwalito presentation=iswb.hnm : "See you soon|, friend|..."
            say Izwalito presentation=text_only if_not_shown skip_next=5 : "..."
            hom1.enabled = true
            Corpo4.enabled = false
            globals.A1 = 5
            navigate to Hita
            choice = none
        }
        when {
            require choice == "NO"
        } then {
            say Izwalito presentation=text_only chatter : "Maybe you should've agreed|, Commander|..."
            say Izwalito presentation=iswd.hnm : "Bye bye|, friend|. Me must go|..."
            say Izwalito presentation=text_only if_not_shown skip_next=2 : "stop"
            choice = none
            end presentation Izwalito
        }
    }
    proc hom1 disabled {
        during travel
        require Hom.current_location == Hita
        require globals.G1 == 0
        require presentation == Hom
    } then {
        Corpo4.enabled = false
        say Hom presentation=homm_03.hnm : "Welcome stranger|. You be big traveller|..."
        say Hom presentation=text_only chatter : "WOWEE|!! Commander, this guy's even uglier than ol' Buzzard Face Bob|... I gotta have a snapshot|... Ha|! Ha|! Ha|!"
        say Hom presentation=homm_03.hnm : "Me HOM|. Me big tube brain|. Me live on distant planet|..."
        say Hom presentation=homm_05.hnm : "Me invite you to my planet|, stranger|..."
        say Hom presentation=homm_10.hnm : "You did help Izwals|. Very good|... You must join MEMBERS GUILD"
        say Hom presentation=homm_11.hnm : "You go my planet|. I go back in few days|..."
        say Hom presentation=homm_04.hnm : "My planet be KORTEX|..."
        say Hom presentation=homm_10.hnm if_not_shown skip_next=1 : "Planet KORTEX be on ZXDT4534 in constellation of KORTESIUS|... YOU GO|, FRIEND|..."
        mark Kortex as known
        say Hom presentation=text_only if_not_shown skip_next=4 : "Bye bye|, good stranger|..."
        globals.trak7 = 1
        globals.G1 = 1
        Hom.current_location = Trashlando
        end presentation Hom
    }
    proc M0sk0 enabled {
        during travel
        require arche.current_location == Moskito
        require Bronko.encounter_count == 1
        require globals.F1 == 0
        require presentation == Bronko
    } then {
        say Bronko presentation=text_only if_not_shown skip_next=1 : "MURFFALO FACTORY"
        request sequence "moskit20.hnm"
        say Bronko presentation=text_only : "Me not have time to talk|, stranger|. Me have much work|. You come back later|..."
        say Bronko presentation=rgbtr7.hnm : "Me have fifty tons of murffalos to chop up|... You come back later|..."
        say Bronko presentation=rgbtr8.hnm : "Me not play|... Me work|... You understand|..."
        say Bronko presentation=text_only chatter : "This guy's no fun|, Commander... Let's forget him|..."
        say Bronko presentation=rgbtr6.hnm : "Bye bye|... Bronko very busy|, much lot work|... You come back|..."
        say Bronko presentation=text_only chatter : "I could be misreading this it, but I don't think he wants to talk, Commander..."
        when {
            require Venusia.known
            require cred.holder == blood
        } then {
            say Bronko presentation=text_only chatter : "Maybe we should go spend our fortune at the VENUSIA supramarket, Commander. There's bound to be great stuff to buy|..."
        }
        when {
            require !Venusia.known
            require cred.holder == blood
        } then {
            say Bronko presentation=text_only chatter : "Let's keep the CRED, Commander. There's bound to be zillions of great things to do with a CRED|..."
        }
        say Bronko presentation=rgbtr6.hnm : "Bye bye... Bronko real busy. Much work|... You come back later|..."
        say Bronko presentation=text_only if_not_shown skip_next=1 : "Bye bye"
        end presentation Bronko
    }
    global F1 = 0
    proc Mosk1 enabled {
        during travel
        require arche.current_location == Moskito
        require globals.A1 == 2
        require globals.F1 == 0
        require presentation == Bronko
        require Bronko.encounter_count > 1
    } then {
        say Bronko presentation=text_only if_not_shown skip_next=1 : "MURFFALO FACTORY"
        request sequence "moskit20.hnm"
        when {
            require Bronko.encounter_count == 2
        } then {
            say Bronko presentation=rgbtr2.hnm : "Me BRONKO|... Me great Butcher Chief on Moskito planet."
        }
        say Bronko presentation=rgbtr3.hnm : "Me greet you|, stranger|. You come get murffalo for Corpo|..."
        say Bronko presentation=rgbtr7.hnm : "Izwals of Corpo say me you come get murffalo"
        say Bronko presentation=rgbtr5.hnm : "You have CRED|? No credit here|..."
        when {
            require cred.holder == blood
        } then {
            say Bronko presentation=text_only chatter : "HONK REPORTS|:"
            say Bronko presentation=text_only chatter : "Refuse|!!! Commander|. Don't tell me we're gonna give this geek a cred to feed rat types|..."
            say Bronko presentation=text_only chatter resume_at=Mosk1_dialogue_resume_1 : "TELEPORT CRED TO BRONKO" choices "teleport" "refuse"
            when {
                require choice == "teleport"
            } then {
                say Bronko presentation=text_only if_not_shown skip_next=2 : "CRED TELEPORTED TO BRONKO"
                transfer cred from aboard to Bronko
                choice = none
            }
            when {
                require choice == "refuse"
            } then {
                say Bronko presentation=text_only chatter : "Good work|, Commander|..."
                say Bronko presentation=rgbtr3.hnm : "You waste my time|... Me not have time..."
                say Bronko presentation=rgbtr6.hnm if_not_shown skip_next=2 : "Bye bye|..."
                choice = none
                end presentation Bronko
            }
            Mosk1_dialogue_resume_1:
            say Bronko presentation=rgbtr6.hnm : "Thank you|, stranger|..."
        }
        say Bronko presentation=rgbtr6.hnm : "What lousy life|... Work always|..."
        say Bronko presentation=rgbtr5.hnm : "One day|, them send me to planet Magnus with other worn-out robots|... Lousy life|..."
        when {
            require cred.holder == Bronko
            require murffalos.holder == Bronko
        } then {
            say Bronko presentation=rgbtr5.hnm : "Me give you three tons frozen murffalo meat|, not more|..."
            say Bronko presentation=text_only chatter resume_at=Mosk1_dialogue_resume_2 : "TELEPORT MURFFALO TO ARK" choices "teleport"
            when {
                require choice == "teleport"
            } then {
                say Bronko presentation=text_only if_not_shown skip_next=2 : "MURFFALO TELEPORTING TO ARK"
                transfer murffalos from Bronko to aboard
                choice = none
            }
        }
        Mosk1_dialogue_resume_2:
        when {
            require cred.holder == Bronko
            require murffalos.holder == blood
        } then {
            say Bronko presentation=rgbtr4.hnm : "You be loaded|... See you soon|, stranger|. Come back when want|..."
            say Bronko presentation=rgbtr7.hnm : "Bronko like clients with CRED|... Ha! Ha! Ha!"
            say Bronko presentation=text_only chatter : "Say|, Commander|, do you notice that smell|? It's that murffalo meat|... What a stink|!"
            say Bronko presentation=text_only chatter : "Those ratboys must tie a knot in their trunks every time they eat|..."
            say Bronko presentation=rgbtr5.hnm : "Bye bye|, friend|..."
        }
        when {
            require cred.holder != blood
            require cred.holder != Bronko
        } then {
            say Bronko presentation=rgbtr4.hnm : "You not have creds|? No creds|, no murffalo meat|... Bye bye|, stranger|.."
            say Bronko presentation=text_only chatter : "I suggest we find a CRED someplace|, Commander|..."
            say Bronko presentation=text_only if_not_shown skip_next=1 : "stop"
            end presentation Bronko
        }
        say Bronko presentation=text_only if_not_shown skip_next=3 : "stop"
        globals.A1 = 3
        globals.F1 = 1
        end presentation Bronko
    }
    proc Mosk2 enabled {
        during travel
        require arche.current_location == Moskito
        require globals.F1 == 1
        require presentation == Bronko
    } then {
        say Bronko presentation=rgbtr6.hnm if_not_shown skip_next=1 : "Ahhh! A visitor|..."
        globals.adieu = 0
        when {
            require Bronko.encounter_count == 3
        } then {
            say Bronko presentation=rgbtr3.hnm if_not_shown skip_next=1 : "You again|, stranger|! What you want|? You come see your friend Bronko|..."
            Bronko.topic = "weapons"
            say Bronko presentation=text_only chatter : "Let's not waste too much time|, Commander|. The guy's an airhead|..."
        }
        when {
            require Bronko.encounter_count == 4
        } then {
            say Bronko presentation=rgbtr3.hnm : "You again... SCRUT not eliminated you|? Thousands SCRUT officers on your trail|..."
            say Bronko presentation=text_only chatter : "He's losing it... A bad case of SCRUT fixation|..."
            say Bronko presentation=rgbtr5.hnm if_not_shown skip_next=2 : "You contact me by radio|, if you need Bronko|..."
            Bronko.known = true
            Brorad.enabled = true
        }
        when {
            require Bronko.encounter_count > 4
        } then {
            say Bronko presentation=rgbtr2.hnm : "Me be alone here... Me hungry of adventure"
            say Bronko presentation=rgbtr6.hnm : "Me think much|. Me think be useful for you|. You take me with you|.."
            say Bronko presentation=text_only chatter : "You know how to cook|?"
            say Bronko presentation=rgbtr3.hnm : "Me know make tasty meals..."
            say Bronko presentation=text_only chatter : "Commander, maybe that's not such a bad idea|. He could handle the cooking|..."
            dictionary blank after "idea"
            say Bronko presentation=rgbtr7.hnm if_not_shown skip_next=2 : "You can teleport me in your ship|..."
            Bronko.known = false
            mark Bronko as portable
            say Bronko presentation=text_only resume_at=Mosk2_dialogue_resume_1 : "TELEPORT BRONKO TO ARK|?" choices "teleport" "refuse"
            when {
                require choice == "teleport"
            } then {
                say Bronko presentation=text_only chatter if_not_shown skip_next=4 : "BRONKO TELEPORTING TO ARK"
                bring Bronko aboard
                Emasculator.current_location = usine
                choice = none
                end presentation Bronko
            }
            when {
                require choice == "refuse"
            } then {
                say Bronko presentation=rgbtr3.hnm : "CRY CRY SWEAR|... Me unlucky|... Me all alone|... CRY CRY..."
                say Bronko presentation=text_only chatter : "Commander|... Get that guy... What a cry baby|... Ha! Ha! Ha!"
                say Bronko presentation=rgbtr4.hnm : "Me sad|... Me all alone|..."
                say Bronko presentation=text_only if_not_shown skip_next=2 : "..."
                choice = none
                end presentation Bronko
            }
        }
        Mosk2_dialogue_resume_1:
        say Bronko presentation=rgbtr6.hnm if_not_shown skip_next=1 : "Bye bye|, friend|. Bronko have much lot work|..." choices "bye_bye"
        globals.adieu = 1
        when {
            require globals.adieu == 1
        } then {
            say Bronko presentation=text_only if_not_shown skip_next=2 : "stop"
            globals.adieu = globals._2D1
            end presentation Bronko
        }
