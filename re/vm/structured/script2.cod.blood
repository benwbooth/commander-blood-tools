    say Maxxon voice=0xFF flags=0x22 display=0x80 loop=none control=none : "Okay. We'll come back when you've got it all set up|..."
    say Maxxon voice=0x09 flags=0x00 display=0x80 loop=none control=none : "Me much work. Bye bye, friend. See soon..."
    say Maxxon voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Bye bye..."
    end presentation Maxxon
}

