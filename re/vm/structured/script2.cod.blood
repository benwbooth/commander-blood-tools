    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, that's a droid... A robot from the last war..."
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's broken down. Keep him talking, while I run a few tests..."
