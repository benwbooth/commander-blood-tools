    say Maxxon voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You have information on lens for telescope?"
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I think he's gonna like this, Commander. Send him over his lens..."
