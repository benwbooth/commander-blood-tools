proc cach enabled until Cryomorn2 {
    during travel
    require state[0x12F8] == 0x0001
    require presentation == Morning_Oil
} then {
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What's that he's saying? I don't have clearance for that information!!!!!!!!!"
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That's outrageous!! We better wake up Cap'n Bob right now..."
    say Morning_Oil voice=0x03 flags=0x10 display=0x80 loop=Cryomorn2 control=none : "Switch him off, Commander|..." choices "disconnect" "refuse"
    when {
        require choice == "disconnect"
    } then {
