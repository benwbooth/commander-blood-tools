        say Otto_Von_Smile voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Youth! How exquisitely unoriginal... And so wildly expensive! Tell me|, do you have 200,000 creds?"
        say Otto_Von_Smile voice=0x07 flags=0x00 display=0x80 loop=none control=none : "No? You are POOR? How ghastly for you|. ONLY THE RICH MAY TASTE ETERNITY!!"
        say Otto_Von_Smile voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What a geek, Commander... Maybe we should wake Cap'n Bob and tell him about eternity..."
        say Otto_Von_Smile voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Another time perhaps, dear client and, dare I hope, friend! Ha! Ha! Ha!..."
        say Otto_Von_Smile voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
