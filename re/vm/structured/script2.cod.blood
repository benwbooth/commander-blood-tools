        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT robot \"HYDRAULIC JACK OF TITANIUM ALLOY\", squadron commander..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You are in a forbidden zone... THIS IS A WARNING..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOU ARE SCHEDULED FOR VAPORIZATION IN TWO MINUTES, TEN SECONDS..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MAKE THAT NINE SECONDS..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "EIGHT SECONDS..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "SEVEN..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Get that garbage wagon out of here! Scram! Otherwise my hi-powered laser weapons will spell death!!!..."
        say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "REPORT FROM THE ARK'S ONBOARD COMPUTER FACILITY, HONK|:"
        say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, He means it|... the whole zone's filled with guys like him: RED ALERT"
    } else {
        block_2904:
        when {
            require state[0x12C0] == 0x0002
        } then {
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "LISTEN UP"
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT robot \"NONSTICK HEART\", area sub-director, calling garbage can..."
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS A WARNING... YOU ARE IN A FORBIDDEN ZONE"
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PREPARE FOR PAINFUL OBLITERIZATION IN TEN SECONDS..."
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "NINE SECONDS..."
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "TWELVE SECONDS..."
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "UH, SORRY ABOUT THAT..."
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "EIGHT..."
            say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "LEAVE NOW OR MEET ROSEBUD? MY LASER-PULPER"
            say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Honk reports in at this time:"
            say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I advise we comply fast, Commander. He's liable to skip four and three..."
        } else {
            block_2A14:
            when {
                require state[0x12C0] == 0x0003
            } then {
                say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
                say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "ATTENTION..."
                say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS SCRUT TROOPER \"TUNG STEN\", TO UNKNOWN SHIP-TYPE THING..."
                say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I HAVE THE FOLLOWING WARNING: THIS SECTOR IS FORBIDDEN TO Y-O-U!!!"
                say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WE WILL MANGLE YOUR BODY ORGANS, MELT DOWN YOUR MELTABLE PARTS, AND ALSO VITRIFY YOU IF YOU DON'T GO AWAY"
                say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THREE SECONDS..."
                say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "TWO SECONDS..."
                say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Honk reports, in the nick of time:"
                say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Red Alert!"
            } else {
                block_2AF4:
                when {
                    require state[0x12C0] == 0x0004
                } then {
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "OKAY WHOEVER YOU ARE"
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is low-ranking SCRUT robot \"STAINLESS STEEL CASING\", CALLING FLYING JUNK HEAP..."
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MOVE OUT OF THIS FORBIDDEN SECTOR... AND MAKE IT SNAPPY, BUDDY BOY!!!"
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Otherwise you get STOMPED ON..."
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOU HAVE TEN SECONDS BEFORE ANNIHILATION SETS IN..."
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "NINE SECONDS..."
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "TWELVE SECONDS..."
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "OKAY OKAY, WISE GUY!"
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOU DO THE COUNTING..."
                    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "CRUIIIIK!"
                    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Report from Honk, onboard computing entity:"
                    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's true he's no shining beacon of brainpower, Commander|. And yet I feel moved by his obvious sincerity..."
                } else {
                    block_2C2C:
                    when {
                        require state[0x12C0] == 0x0005
                    } then {
                        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
                        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "LISTEN UP"
                        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS SCRUT ROBOT \"TENSILE SHEET METAL\", AREA CHIEF, TO UNKNOWN VESSEL..."
                        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS IS A PL7K stroke 38B WARNING: YOU HAVE TWO MINUTES TO EVACUATE THE SECTOR"
                        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "FAILURE TO COMPLY WITH ABOVE PL7K stroke 38B WARNING WILL RESULT IN A 1010..."
                        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOURS SINCERELY,"
                        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "SIGNED: SCRUTER \"TENSILE SHEET METAL\", AREA CHIEF WITH ADDED LASER POWER"
                        say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Heeeere's Honky!|..."
                        say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That stuff about 1010? That's their way of saying meet your maker. There's a big bunch of them SCRUT ships around here|..."
                        jump block_2D40
                    }
                }
            }
        }
    }
    block_2D40:
    say Scruter_K voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Whaddaya say we just do like the robot says before the laser pulpers kick in..."
    Scruter_K.in_play = false
    say Scruter_K voice=0xFF flags=0x28 display=0x80 loop=none control=none : "CLICK ON THE RED BUTTON ON THE MAP, SELECT A PLANET AND PUSH THE CONTROL STICK..."
    state[0x12C2] = 0x0001
    say Scruter_K voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "stop"
    radio1.enabled = false
    radioscr.enabled = false
    timer[8] = 10
    radio1.enabled = false
    end presentation Scruter_K
}

proc dring enabled until encor {
    require Izwalito.encounter_count < 0x0002
    require Scruter_Jo.encounter_count < 0x0002
    require timer[8] == 0
} then {
    queue presentation Scruter_K
    state[0x12C4] = 0x0001
    dring.enabled = false
}

proc encor enabled until destroy {
    require state[0x12C4] == 0x0001
    during bridge
    require presentation == Scruter_K
} then {
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MESSAGE RADIO:"
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT agent K, district director. Message to unknown vessel..."
    when {
        require arche.current_location != Corpo
    } then {
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You deaf or something?"
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Get out of here|... SWEAR... INSULT..."
