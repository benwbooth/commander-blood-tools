                } then {
                    say Ulikan voice=0x0E flags=0x00 display=0x80 loop=none control=none : "HAVE FUN... MY MOM SAYS SUPPER'S READY..."
                } else {
                    block_3C91:
                    when {
                        require clock.hour > 12
                        require clock.hour < 18
                    } then {
                        say Ulikan voice=0x0D flags=0x00 display=0x80 loop=none control=none : "THINK I'LL GO NOW... AFTERNOON'S A GOOD TIME TO CATCH UP ON SOME ZZZZZ'S..."
                    }
                }
            }
        }
    }
    block_3CC7:
    say Ulikan voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "..."
    Ulikan.in_play = false using alternate_encoding
    tim5.enabled = false
    end presentation Ulikan
}

