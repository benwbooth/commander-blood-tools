    }
    block_58F1:
    say Bronko voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Bye bye... Bronko real busy. Much work|... You come back later..."
    say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Bye bye"
    end presentation Bronko
}

proc Mosk1 enabled until Mosk2 {
    during travel
    require arche.current_location == Moskito
    require state[0x12C8] == 0x0002
    require state[0x12EA] == 0x0000
    require presentation == Bronko
    require Bronko.encounter_count > 0x0001
} then {
    say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "MURFFALO FACTORY"
    request sequence "moskit20.hnm"
    when {
        require Bronko.encounter_count == 0x0002
    } then {
        say Bronko voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Me BRONKO... Me great Butcher Chief on Moskito planet."
    }
    block_5989:
    say Bronko voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me greet you, stranger. You come get murffalo for Corpo..."
    say Bronko voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Izwals of Corpo say me you come get murffalo"
    say Bronko voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You have CRED? No credit here|..."
    when {
        require cred.holder == blood
    } then {
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTS:"
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Refuse!!! Commander|. Don't tell me we're gonna give this geek a cred to feed rat types..."
        say Bronko voice=0xFF flags=0x30 display=0x80 loop=block_5A9E control=none : "TELEPORT CRED TO BRONKO" choices "teleport" "refuse"
        when {
            require choice == "teleport"
        } then {
            say Bronko voice=0xFF flags=0x08 display=0x90 loop=none control=none : "CRED TELEPORTED TO BRONKO"
            transfer cred from aboard to Bronko
            choice = none
        }
        block_5A59:
        when {
            require choice == "refuse"
        } then {
            say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Good work, Commander|..."
            say Bronko voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You waste my time|... Me not have time..."
            say Bronko voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Bye bye|..."
            choice = none
            end presentation Bronko
        }
        block_5A9E:
        say Bronko voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Thank you, stranger..."
    }
    block_5AB0:
    say Bronko voice=0x05 flags=0x00 display=0x80 loop=none control=none : "What lousy life... Work always..."
    say Bronko voice=0x04 flags=0x00 display=0x80 loop=none control=none : "One day, them send me to planet Magnus with other worn-out robots... Lousy life..."
    when {
        require cred.holder == Bronko
        require murffalos.holder == Bronko
    } then {
        say Bronko voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me give you three tons frozen murffalo meat, not more..."
        say Bronko voice=0xFF flags=0x30 display=0x80 loop=block_5B53 control=none : "TELEPORT MURFFALO TO ARK" choices "teleport"
        when {
            require choice == "teleport"
        } then {
            say Bronko voice=0xFF flags=0x08 display=0x90 loop=none control=none : "MURFFALO TELEPORTING TO ARK"
            transfer murffalos from Bronko to aboard
            choice = none
        }
    }
    block_5B53:
    when {
        require cred.holder == Bronko
        require murffalos.holder == blood
    } then {
        say Bronko voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You be loaded... See you soon, stranger. Come back when want..."
        say Bronko voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Bronko like clients with CRED|... Ha! Ha! Ha!"
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Say, Commander|, do you notice that smell? It's that murffalo meat... What a stink!"
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Those ratboys must tie a knot in their trunks every time they eat..."
        say Bronko voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend|..."
    }
    block_5C05:
    when {
        require cred.holder != blood
        require cred.holder != Bronko
    } then {
        say Bronko voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You not have creds? No creds, no murffalo meat... Bye bye, stranger.."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I suggest we find a CRED someplace, Commander|..."
        say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
        end presentation Bronko
    }
    block_5C68:
    say Bronko voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x12C8] = 0x0003
    state[0x12EA] = 0x0001
    end presentation Bronko
}

proc Mosk2 enabled until Brorad {
    during travel
    require arche.current_location == Moskito
    require state[0x12EA] == 0x0001
