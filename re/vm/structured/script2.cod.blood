    when {
        require choice == "djerk"
    } then {
        say Scruter_Mac voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Djerk not be code|. Djerk be exciting dance step, friends..."
        choice = none
    }
    block_72C9:
    when {
        require choice == "locomoshun"
    } then {
        say Scruter_Mac voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Locomoshun not be code|. Be dance everybody be doing, friends..."
        choice = none
    }
    block_72F3:
    when {
        require choice == "twist"
    } then {
        say Scruter_Mac voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Twist not be code|. Twist be dance bad for back, friends..."
        choice = none
    }
    block_731F:
    when {
        require choice == "mashpotatoes"
    } then {
        say Scruter_Mac voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Mashpotatoes not be code. Be dance for potato, friends..."
        choice = none
    }
    block_7345:
    when {
        require choice == "madison"
    } then {
        say Scruter_Mac voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Madison not be code. Madison be exotic dance routine, friends..."
        choice = none
    }
    block_736D:
    say Scruter_Mac voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, you're hopeless at this.... We need to find that stupid code|..."
    say Scruter_Mac voice=0x0A flags=0x00 display=0x80 loop=none control=none : "You not found code|. You be spy. Me exterminate you now...."
    say Scruter_Mac voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's gonna zap the Orxx|..."
    say Scruter_Mac voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You should've listened to me|, Commander... I'll have to tell Cap'n Bob|... Sorry..."
    say Scruter_Mac voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Baaaoooommmm!!!!"
    request sequence "explo3.hnm"
    say Scruter_Mac voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    end presentation Scruter_Mac
}

proc mastachok1 enabled until scr2 {
