        choice = none
    }
    block_3F11:
    when {
        require choice == "Exterminator"
    } then {
        say Izwalito voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Me greet you friend Exterminator"
        state[0x12DE] = 0x0001
        choice = none
    }
    block_3F32:
    when {
        require choice == "tarzoom"
    } then {
        say Izwalito voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Me greet you friend Tarzoom"
        state[0x12E0] = 0x0001
        choice = none
    }
    block_3F53:
    say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTS IN:...|...|..."
    say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This Izwalito joker doesn't trust you, Commander|..."
    say Izwalito voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Try to humor him. We'll soon find out the truth behind that innocent mask... Heh! Heh!"
    Izwalito.topic = "talk"
    when {
        require state[0x12E2] == 0x0001
        require !Rondo.in_play
    } then {
        say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You be very curious, friend|..."
        say Izwalito voice=0x03 flags=0x10 display=0x80 loop=block_405E control=none : "You can keep secret?" choices "yes" "no"
        when {
            require choice != "yes"
        } then {
            say Izwalito voice=0x02 flags=0x08 display=0xA0 loop=none control=none : "Me tell big secret..."
            Izwalito.topic = "know"
            state[0x12E2] = 0x0000
            choice = none
        }
        block_4020:
        when {
            require choice == "no"
        } then {
            say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|!!! You're being manipulated by a rat... You should've answered YES..."
            say Izwalito voice=0x04 flags=0x08 display=0x80 loop=none control=none : "You like make joke..."
            choice = none
        }
    }
    block_405E:
    say Izwalito voice=0xFF flags=0x28 display=0x80 loop=none control=none : "STOP"
    timer[2] = 80
    when {
        require timer[2] == 0
    } then {
        timer[2] = disabled
        ad.enabled = true
    }
    block_407A:
    say Izwalito voice=0xFF flags=0x48 display=0x80 loop=none control=none : "You bye bye?" choices "bye_bye"
    state[0x1270] = 0x0001
    when {
        require Magnus.in_play
    } then {
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTING AT THIS TIME:"
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "COMMANDER|, YOU'RE NOT GONNA BELIEVE THIS... THE RAT GAVE US A PLANETARY POSITION..."
    }
    block_40D8:
    when {
        require Rondo.in_play
    } then {
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "COMPUTER ENTITY HONK|:"
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "COMMANDER|, Ratface knows a lot more than he's telling..."
        say Izwalito voice=0xFF flags=0x28 display=0x80 loop=none control=none : "You should get him to spill the beans..."
        state[0x12E4] = 0x0001
    }
    block_4130:
    when {
        require state[0x1270] == 0x0001
    } then {
        ad.enabled = true
        state[0x1270] = state[0x12CA]
    }
}

