                require clock.hour < 2
            } then {
                say Ulikan voice=0x0F flags=0x00 display=0x80 loop=none control=none : "NITE NITE... DON'T STAY UP TOO LATE. TOMORROW ALWAYS COMES..."
            } else {
                block_3575:
