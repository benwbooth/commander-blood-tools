proc augmen enabled until revel {
    during contact
    require presentation == Bob_Morlock
    require state[0x12B6] == 0x0001
    require state[0x12B8] == 0x0000
} then {
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "While you're awake, Cap'n Bob|, sir... I have a request to make..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Olga and me would like a raise. A few megawatts..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "WHAT... SPEAK LOUDER... I'M GETTING DEAFER AND DEAFER..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WE WANT MORE MEGAWATTS!!!"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I feel like that canary I mistook for an oven-ready turkey, Commander|. Haaa!!! My heart...."
    say Bob_Morlock voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Heart!!... He means his power generator... Those guys... Just mention a couple of lousy megawatts!"
    state[0x12B8] = 0x0001
    augmen.enabled = false
}

proc revel enabled until caft {
    during contact
    require presentation == Bob_Morlock
    require state[0x12BA] == 0x0001
    require state[0x12BC] == 0x0000
} then {
    say Bob_Morlock voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You want to know an unbearable truth, Commander|?"
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch off for ten seconds!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But, Cap'n Bob!!..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "YOU HEARD ME... SWITCH YOURSELF OFF!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir|, Cap'n Bob. If you say so..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaaaaaaaaaa!!!"
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME..."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME PERSON AT TWO DIFFERENT AGES..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MUCH MORE THAN MY SON..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We are the same person... I am the first being to have created itself"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And who, thanks to space-time distortion, can watch itself re-live: YOU ARE BOB, COMMANDER..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am what you will become hundreds of thousands of years from now..."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, you can switch on now..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! You guys should know I have a right to stay informed. That's what being ONBOARD COMPUTER is all about, right?"
    say Bob_Morlock voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Was Olga switched off too???"
    state[0x126E] = 0x0001
    say Bob_Morlock voice=0x05 flags=0x08 display=0xA0 loop=none control=none : "Stop snivelling and get to work, you jumped up little fuse box..."
    state[0x12BC] = 0x0001
    state[0x12BA] = 0x0000
    revel.enabled = false
}

proc caft enabled until time {
    during contact
    require state[0x12BE] == 0x0001
    require presentation == Bob_Morlock
} then {
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob, I have to tell you the Commander has behaved very badly..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He stole money from a defenceless Izwal of planet Corpo and then he spent it|..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'm sorry to say it's true..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Miserable machine!!! WHO DO YOU THINK YOU ARE? He did whatever the situation demanded..."
    say Bob_Morlock voice=0x04 flags=0x10 display=0x80 loop=time control=none : "True, Commander|?" choices "yes" "no"
    when {
        require choice == "yes"
    } then {
        say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Well... If I remember, there wasn't a lot of choices..."
        say Bob_Morlock voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Exactly..."
        choice = none
    }
    block_26CA:
    when {
        require choice == "no"
    } then {
        say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You see, you pathetic excuse for a machine: YOU'RE A LIAR!!! I knew it all along..."
        say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But Cap'n Bob|... I swear it's true..."
        say Bob_Morlock voice=0x02 flags=0x08 display=0x90 loop=none control=none : "SILENCE!!!"
        state[0x12BE] = 0x0000
        choice = none
    }
}

proc time enabled until radioscr {
} then {
