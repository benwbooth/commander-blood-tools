proc pter enabled until scrub {
    during travel
    require presentation == Scruter_Jo
    require arche.current_location == Pterra
} then {
    say Scruter_Jo voice=0x01 flags=0x00 display=0x80 loop=none control=none : "ME SCRUTER JO: SCANNING STRANGER...XRAY....STOP"
    say Scruter_Jo voice=0x01 flags=0x00 display=0x80 loop=none control=none : "ZONE ULTRAFORBIDDEN YOU NOT STAY HERE... YOU GO AWAY..."
    say Scruter_Jo voice=0x01 flags=0x08 display=0x80 loop=none control=none : "FIRST WARNING..."
    sequence_slots[4] = "scrut"
    when {
        require Scruter_Jo.encounter_count > 0x0001
    } then {
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh no! Him again|... Commander|, I don't feel happy about that SCRUT robot..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We'll need to be smart, cunning, intelligent and clever..."
    }
    block_00AC:
    when {
        require Scruter_Jo.encounter_count == 0x0002
    } then {
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Watch out, Commander|... Second try... Don't blow it|..."
    }
    block_00D7:
    when {
        require Scruter_Jo.encounter_count == 0x0003
    } then {
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I think I found the code, Commander... It's the number 9..."
    }
    block_0104:
    say Scruter_Jo voice=0x01 flags=0x10 display=0x80 loop=block_0227 control=none : "You give identity code:" choices "robyx" "code" "ulikan" "69" "exxos" "electret" "666" "9"
    when {
        require choice == "exxos"
    } then {
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Yes! Code be EXXOS. You be very Important Being..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Nice work, Commmander, I've got to hand it to you|... How did you figure it out?"
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ol' Turkey Face Bob'll be proud of you when I tell him..."
        say Scruter_Jo voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You did give code|. You are the MASTER..."
        choice = none
    }
    block_01BE:
    when {
        require choice != "exxos"
    } then {
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You unauthorized. Me exterminate you now..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Uh oh Commander|. He's gonna zap the Orxx..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Bye bye, unauthorized strangers..."
        say Scruter_Jo voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "BAAANG!!!"
        request sequence "explo3.hnm"
        end presentation Scruter_Jo
        choice = none
    }
    block_0227:
    say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "GIVE ME YOUR ORDERS, MASTER. I am yours..."
    say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, We found the code for programming him..."
    say Scruter_Jo voice=0xFF flags=0x30 display=0x80 loop=scrub control=none : "Let's teleport him|, Commander|. I ought to take a good look at him..." choices "teleport" "refuse"
    when {
        require choice == "teleport"
    } then {
        say Scruter_Jo voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORT SCRUTER JO TO CRYOBOX"
        Scruter_Jo.current_location = aboard
        end presentation Scruter_Jo
        choice = none
    }
    block_02B3:
    when {
        require choice == "refuse"
    } then {
        say Scruter_Jo voice=0xFF flags=0x28 display=0x90 loop=none control=none : "You're the commander, Commander|..."
        choice = none
        end presentation Scruter_Jo
    }
}

proc scrub enabled until scrujo {
    during contact
    require presentation == Scruter_Jo
} then {
    say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I've reprogrammed him|, Commander|... And I've discovered something weird..."
    say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "These SCRUT robots use a psychic structure based on CYBERSPACE|..."
    say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I've rigged a system so you can enter it|, Commander... That way you can get some BIONIUM..."
    say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "The energy source computers are wild about..."
    say Scruter_Jo voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Ask SCRUTER JO a few questions, Commander|. You'll understand..."
    scrub.enabled = false
}

proc scrujo enabled until menbr {
    during contact
    require presentation == Scruter_Jo
} then {
    say Scruter_Jo voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
    when {
        require state[0x126A] == 0x0000
    } then {
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain to you how get BIONIUM..."
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures..."
        say Scruter_Jo voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX with hand."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me|, Commander|!!"
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX, you CAPTURE BIOXX on tip of your finger..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Catch him on the tip of your finger!!! Sounds easy as pie, Commander|..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to cybernetic MANTAS"
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You place BIOXX in belly of Manta..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stay stuck to MANTAS..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'd love to see that..."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes!!! BIONIUM|... I can taste it already..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We understand perfectly, Mister SCRUTER JO... Right, Commander?"
    }
    block_0549:
    say Scruter_Jo voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say Scruter_Jo voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh! Me feel better..."
    when {
        require state[0x126C] > 0x0000
    } then {
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work|... You did succeed..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES|!!! Commander|, remind me to tell you you're a champ..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This BIONIUM is extraordinary. My clock frequency's through the roof..."
        say Scruter_Jo voice=0xFF flags=0x28 display=0x80 loop=none control=none : "I feel even smarter... I can feel I'll be a great help to you, Commander|..."
        state[0x126A] = 0x0001
    }
    block_0613:
    when {
        require state[0x126C] == 0x0000
    } then {
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, you didn't understand the technique..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need BIONIUM, Commander|. It makes me smarter..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! You need much much BIONIUM. Ha! Ha!..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you shut up|, wiseguy!!!"
    }
    block_069C:
    say Scruter_Jo voice=0x07 flags=0x08 display=0x80 loop=none control=none : "Bye bye, Commander|. Me return to CYBERSPACE..."
    end presentation Scruter_Jo
}

proc menbr enabled until men1 {
    during bridge
    require presentation == menu
    require Bronko.current_location == aboard
} then {
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"IMPROVED MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today CHEF BRONKO has laid on for you:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Tasty MURFFALO soup Bronko-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO kidneys Bronko-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO hamburger with Bar-B-Q recycled-oil dip."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Smooth MURFFALO-chip ice cream."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Chef Bronko says... Burping's bad manners!|..."
    say menu voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    end presentation menu
}

proc men1 enabled until men2 {
    during bridge
    require presentation == menu
    require Bronko.current_location != aboard
} then {
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PLASMA soup HONK-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER belly in slobber sauce."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Jellied URTIKAN with MURFFALO bone marrow."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK eye pie."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Don't eat with your mouth full!|..."
    say menu voice=0xFF flags=0x08 display=0x90 loop=none control=none : "Stop"
    men1.enabled = false
    end presentation menu
}

