    } then {
        say Bronko voice=0x02 flags=0x08 display=0x80 loop=none control=none : "You again, stranger! What you want? You come see your friend Bronko..."
        Bronko.topic = "weapons"
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Let's not waste too much time, Commander|. The guy's an airhead..."
    }
