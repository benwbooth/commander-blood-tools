    say Bug_Deluxe voice=0xFF flags=0x08 display=0x80 loop=none control=none : "COMMERCIAL... COMMERCIAL... COMMERCIAL..."
    sequence_slots[3] = "venus"
    say Bug_Deluxe voice=0xFF flags=0x00 display=0x80 loop=none control=none : "FOR ALL SPENDING MOMENTS, COME TO VENUSIA"
    say Bug_Deluxe voice=0xFF flags=0x00 display=0x80 loop=none control=none : "FABULOUS BARGAINS... BRING PLENTY OF CREDS..."
    say Bug_Deluxe voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MORE FOR YOUR CREDS AT VENU-USIA-AA... Watch tv channel three..."
    say Bug_Deluxe voice=0xFF flags=0x00 display=0x80 loop=none control=none : "VENUSIA 325467 DEGREES, 23 GALAXY B BABY1..."
    say Bug_Deluxe voice=0xFF flags=0x00 display=0x80 loop=none control=none : "CRUIK..........."
    say Bug_Deluxe voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    Venusia.in_play = true
    end presentation Bug_Deluxe
}

proc monop1 enabled until monop2 {
    require arche.current_location == Venusia
    require presentation == Bug_Deluxe
} then {
    say Bug_Deluxe voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Hi there, Comsumer Comrade. Welcome to VENUSIA SUPRAMARKET"
    say Bug_Deluxe voice=0x04 flags=0x10 display=0x80 loop=monop2 control=none : "Wanna buy a SUPRA product at VENUSIA?" choices "yes" "no"
    when {
        require choice == "yes"
    } then {
        monop2.enabled = true
        choice = none
    }
    block_943D:
    when {
        require choice == "no"
    } then {
        say Bug_Deluxe voice=0x06 flags=0x00 display=0x80 loop=none control=none : "NO! HA HA!! Forgot our CREDs, did we?"
        say Bug_Deluxe voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Have a happy day, comrade."
        say Bug_Deluxe voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
        choice = none
        end presentation Bug_Deluxe
    }
}

proc monop2 disabled until finscr1 {
    require arche.current_location == Venusia
    during travel
    require presentation == Bug_Deluxe
} then {
    say Bug_Deluxe voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You got the CREDs? At VENUSIA|, it's CREDs CREDs CREDs, Consumer Comrade..."
    when {
        require state[0x1272] == state[0x12CA]
        require state[0x1310] == state[0x12CA]
        require cred.holder != blood
    } then {
        say Bug_Deluxe voice=0xFF flags=0x00 display=0x80 loop=none control=none : "No CREDs, huh?... That's not an attitude we care for at VENUSIA!"
        say Bug_Deluxe voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
        monop2.enabled = false
        end presentation Bug_Deluxe
    }
    block_950B:
    when {
        require state[0x1272] == 0x0001
        require cred.holder != blood
    } then {
        say Bug_Deluxe voice=0x05 flags=0x08 display=0x80 loop=none control=none : "It's your luck-lucky day, consumer comrade. You just won a free CRED!!!"
        request sequence "pubven1.hnm"
        say Bug_Deluxe voice=0xFF flags=0x30 display=0x80 loop=block_95DE control=none : "TELEPORT CRED TO ARK" choices "teleport"
        when {
            require choice != "teleport"
        } then {
            say Bug_Deluxe voice=0xFF flags=0x08 display=0x80 loop=none control=none : "CRED TELEPORTED TO ARK"
            transfer cred from Bug_Deluxe to aboard
            say Bug_Deluxe voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Ahhh|! Lady luck loves a consumer, comrade... Happy spending!"
            say Bug_Deluxe voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And remember... \"MORE FOR YOUR CREDS AT VENU-USIA-AAA!\""
            say Bug_Deluxe voice=0x05 flags=0x08 display=0xA0 loop=none control=none : "Bye bye comrade consumer..."
            state[0x1272] = state[0x12CA]
            choice = none
            end presentation Bug_Deluxe
        }
    }
    block_95DE:
    when {
        require cred.holder == blood
    } then {
        say Bug_Deluxe voice=0x02 flags=0x08 display=0x90 loop=none control=none : "What would you like to splurge your creds on, Supra Comrade?"
        timer[7] = 500
        Bug_Deluxe.topic = "department"
    }
    block_9610:
    say Bug_Deluxe voice=0xFF flags=0x48 display=0x80 loop=none control=none : "TELEPORT CRED ON VENUSIA|..." choices "buy"
    request sequence "pion.hnm"
    when {
        require state[0x1310] == 0x0001
    } then {
        say Bug_Deluxe voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Thank you for enjoying VENUSIA the SUPRAMARKET. VENUSIA hopes to see you again soon..."
        say Bug_Deluxe voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
        state[0x1310] = state[0x12CA]
        monop2.enabled = false
        end presentation Bug_Deluxe
    }
}

proc finscr1 enabled until scrapp {
    require Kortex.in_play using alternate_encoding
    require state[0x12FC] == 0x0006
    require lens.holder == Maxxon
    require Scruter_Jo.current_location == aboard
    require Bronko.current_location == aboard
} then {
    Scruter_K.in_play = true
    queue presentation Scruter_K
    scrapp.enabled = true
}

proc scrapp disabled until block_9881 {
    during bridge
    require presentation == Scruter_K
} then {
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is SCRUT customs and excise ship... Calling unknown vessel..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Pull over for a routine check... We have orders to routinely check your ship specifically..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Scanning X-ray Charles... BZZZZZZZZZZZZZZZZZZZZZZ..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We are currently scanning your vessel..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Bzzzzzzzzzzzzzzzzzz"
    when {
        require cred.holder == aboard
    } then {
        say Scruter_K voice=0xFF flags=0x08 display=0x80 loop=none control=none : "ILLEGAL MONEY DETECTED..."
        transfer cred from aboard to Scruter_K
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Confiscated..."
    }
    block_975F:
    when {
        require bionium.holder == aboard
    } then {
        say Scruter_K voice=0xFF flags=0x08 display=0x80 loop=none control=none : "BIONIUM container detected... Ultra-illegal item..."
        transfer bionium from aboard to Scruter_K
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Confiscated..."
    }
    block_9791:
    when {
        require decoder.holder == aboard
    } then {
        say Scruter_K voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Pirate decoder... You're a cheater..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Confiscated..."
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "It does'nt work... No confiscated..."
    }
    block_97CE:
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Your documentation isn't in order... Everything is confiscated|..."
    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, Commander|, this could be bad in survival terms... What's Cap'n Bob gonna say?"
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Be happy... You're alive... Ha! Ha! Ha!|..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Kruiiik!!!"
    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy snake-oil..."
    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "They left us right in the middle of this star soup... How about that..."
    say Scruter_K voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
    run_profile 0x03
    end presentation Scruter_K
    block_9881:
    halt
}
