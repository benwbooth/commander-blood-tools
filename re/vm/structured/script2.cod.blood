proc what enabled until miss {
    during bridge
    require presentation == Honk
} then {
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "..."
    say Honk voice=0xFF flags=0x30 display=0x80 loop=block_121E control=none : "What do you want Commander|?" choices "talk" "remember" "bye_bye"
    when {
        require choice == "remember"
    } then {
        miss.enabled = true
        choice = none
    }
    block_11E2:
    when {
        require choice == "talk"
    } then {
        Honk.topic = "explanations"
        choice = none
    }
    block_11EF:
    when {
        require choice == "bye_bye"
    } then {
        say Honk voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Service with a smile! That's the story of my life, Commander|..."
        choice = none
        end presentation Honk
    }
    block_121E:
    when {
        require state[0x1276] > 0x0005
    } then {
        say Honk voice=0xFF flags=0x08 display=0x80 loop=none control=none : "CHEAT MODE..."
        Honk.topic = "rien"
        say Honk voice=0xFF flags=0x30 display=0x80 loop=block_12A5 control=none : "Choose your script, Commander" choices "3" "4" "5"
        when {
            require choice == "3"
        } then {
            say Honk voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Script 3 selected..."
            run_profile 0x03
            choice = none
            end presentation Honk
        }
        block_126F:
        when {
            require choice == "4"
        } then {
            say Honk voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Script 4 selected..."
            run_profile 0x04
            choice = none
            end presentation Honk
        }
        block_128A:
        when {
            require choice == "5"
        } then {
            say Honk voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Script 5 selected..."
            run_profile 0x05
            choice = none
            end presentation Honk
        }
    }
    block_12A5:
    when {
        require choice == "bye_bye"
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Bye bye, Commander..."
        end presentation Honk
    }
    block_12BF:
    when {
        require timer[15] == 0
    } then {
        say Honk voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Pardon me,Commander, but I have work to do... I have to quadrify the multiplexers... See you!"
        timer[15] = disabled
        end presentation Honk
    }
    block_12FE:
    when {
        require Izwalito.encounter_count > 0x0002
        require decoder.holder != aboard
        require cred.holder != blood
        require state[0x1278] == 0x0001
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander, I just forged a CRED! Take a look in the Cryobox|..."
        transfer cred from Izwalito to aboard
    }
}

