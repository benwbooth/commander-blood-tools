    } then {
        say Daddy_Gluxx voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I know of a terrible place... Nobody speaks of it|..."
        say Daddy_Gluxx voice=0x02 flags=0x00 display=0x80 loop=none control=none : "It's the clinic on the planet Erazor. Mysterious things happen there, you know..."
        say Daddy_Gluxx voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Do not venture near that place... ERAZORUS AS666 constellation...."
        say Daddy_Gluxx voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Commander|... Commander|... Unless I'm mistaken, that sounded like planetary coordinates!"
        Erazor.in_play = true
        state[0x12AC] = 0x0001
    }
    block_882A:
    when {
        require state[0x1270] == 0x0001
    } then {
        say Daddy_Gluxx voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Bye bye"
        state[0x12AA] = 0x0001
        state[0x130A] = 0x0001
        end presentation Daddy_Gluxx
    }
}

