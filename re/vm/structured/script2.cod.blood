proc emasc0 enabled until Magnus1 {
    during travel
    require presentation == Emasculator
    require arche.current_location == Moskito
    require state[0x12EE] == 0x0000
} then {
    say Emasculator voice=0x01 flags=0x00 display=0x80 loop=none control=none : "What you want, stranger? You want murffalo meat, me new seller..."
    say Emasculator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You have CRED to pay?"
    say Emasculator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "No cred, no murffalo meat..."
    say Emasculator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "So that's Bronko's replacement in the meat-selling business..."
    say Emasculator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You have CRED? No credit here|..."
    when {
        require cred.holder == blood
    } then {
        say Emasculator voice=0xFF flags=0x30 display=0x80 loop=block_6244 control=none : "TELEPORT CRED TO EMASCULATOR" choices "teleport" "refuse"
        when {
            require choice == "teleport"
        } then {
            say Emasculator voice=0xFF flags=0x08 display=0x90 loop=none control=none : "CRED TELEPORTED TO EMASCULATOR"
            transfer cred from aboard to Bronko
            state[0x1272] = 0x0001
            say Emasculator voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Thank you, stranger Ha! Ha! Ha!..."
            choice = none
        }
        block_61FF:
        when {
            require choice == "refuse"
        } then {
            say Emasculator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Good work, Commander|..."
            say Emasculator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You waste my time|... Me not have time..."
            say Emasculator voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Bye bye|..."
            choice = none
            end presentation Emasculator
        }
    }
    block_6244:
    when {
        require bionium.holder != blood
    } then {
        state[0x12F0] = 0x0001
    }
    block_6255:
    when {
        require state[0x12F0] == 0x0001
    } then {
        say Emasculator voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You be adventurer... Me know much things..."
        say Emasculator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me say you this... ME MUCH NEED BIONIUM|..."
        say Emasculator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You bring BIONIUM|, me pay much..."
        say Emasculator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander|, a client!"
        say Emasculator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me give you free container..."
        say Emasculator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What!!! A whole container... Opportunity knocks, Commander|..."
        say Emasculator voice=0xFF flags=0x10 display=0x80 loop=block_633B control=none : "TELEPORT BIONIUM CONTAINER TO ARK" choices "teleport"
        when {
            require choice == "teleport"
        } then {
            say Emasculator voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "CONTAINER TELEPORTED TO ARK"
            transfer bionium from Emasculator to aboard
            state[0x1290] = 0x0001
            state[0x12F0] = 0x0000
            choice = none
        }
    }
    block_633B:
    when {
        require state[0x126C] > 0x0000
        require bionium.holder == blood
        require Emasculator.encounter_count > 0x0001
    } then {
        say Emasculator voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Give me your BIONIUM stanger..."
        say Emasculator voice=0xFF flags=0x10 display=0x80 loop=block_63F2 control=none : "TELEPORT BIONIUM TO EMASCULATOR" choices "teleport" "refuse"
        when {
            require choice == "teleport"
        } then {
            say Emasculator voice=0xFF flags=0x08 display=0x90 loop=none control=none : "BIONIUM TELEPORTED TO EMASCULATOR"
            state[0x126C] = 0x0001
            request sequence "star2.hnm"
            say Emasculator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "GOOD GOOD... Me much work now... You waste my time|..."
            say Emasculator voice=0x04 flags=0x08 display=0x90 loop=none control=none : "Bye bye..."
            choice = none
            end presentation Emasculator
        }
        block_63D6:
        when {
            require choice == "refuse"
        } then {
            say Emasculator voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Ok Commander|, you're the boss..."
            choice = none
        }
    }
    block_63F2:
    say Emasculator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me much work|... You not waste my time|..."
    say Emasculator voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Bye bye stranger"
    end presentation Emasculator
}

