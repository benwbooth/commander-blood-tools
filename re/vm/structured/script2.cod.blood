        say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "AAAAAAAAAAAAAAAAAAA..."
        say Morning_Oil voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Good work, Commander|. You made a wise decision... Hee! Hee! Hee!"
        say Morning_Oil voice=0x05 flags=0x00 display=0x80 loop=none control=none : "But I don't know anything about that hiding-place, Commander|. I just wanted to annoy Honk|!!!"
        say Morning_Oil voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Let's switch him back on... He's gonna be real mad... Hee! Hee! Hee!"
        say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "So what did he tell you?|... A pack of lies, believe me... SWEAR, INSULT"
        say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Mister Honk ought to mind his language. Signed Olga."
        say Morning_Oil voice=0xFF flags=0x28 display=0xA0 loop=none control=none : "Olga! Why don't you shut up!!! I'm a very angry onboard computing facility, Commander|..."
        state[0x12F8] = 0x0000
        cach.enabled = false
        choice = none
    }
    block_6A49:
    when {
        require choice == "refuse"
    } then {
        say Morning_Oil voice=0x02 flags=0x08 display=0xA0 loop=none control=none : "Too bad. I won't tell you anything at all!!"
        state[0x12F8] = 0x0000
        cach.enabled = false
        choice = none
    }
}

proc Cryomorn2 enabled until letar {
    during contact
    require Morning_Oil.current_location == aboard
    require state[0x12F2] == 0x0002
    require batteries.holder == Morning_Oil
} then {
    say Morning_Oil voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ahhh... Morning Oil, veteran of the Great Croolis War, reporting for duty. I greet you and say thank you also..."
    say Morning_Oil voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You gave me back my life... Ah! I feel quite lubrified, I must say! Recharged batteries too, eh?"
    say Morning_Oil voice=0x03 flags=0x00 display=0x80 loop=none control=none : "My gratitude knows no bounds, noble ones. And I just love your ship. Not a model I'm familiar with..."
    say Morning_Oil voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ahh, if only you'd seen the SPIDER4000 I piloted... Such invigorating combat... BABOOOM... VRRRRRRR CHAKA CHAKA CHAKA..."
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIOCONSCIOUSNESS HONK REPORTS:"
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, this is one deranged robot we got here. I hate him..."
    say Morning_Oil voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We fired at everything that moved, naturally... Luckily, we managed to hide the treasure before the end..."
    say Morning_Oil voice=0x03 flags=0x00 display=0x80 loop=none control=none : "And my revered master, the splendid Croolis EVISCERATOR was alas made prisoner..."
    say Morning_Oil voice=0x04 flags=0x00 display=0x80 loop=none control=none : "He knows where the Croolis war treasure is hidden..."
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK REPORTS:"
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I think I'll just open him up and check that story..."
    say Morning_Oil voice=0xFF flags=0x30 display=0x80 loop=block_6D1B control=none : "He's bluffing, Commander... I suppose you want me to switch him off now?" choices "yes" "no"
    when {
        require choice == "no"
    } then {
        say Morning_Oil voice=0x06 flags=0x00 display=0x80 loop=none control=none : "NO, YOU'RE OUT OF YOUR MIND... I DON'T WANT THIS TO HAPPEN... MOTHER, HELP!"
        say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK MAKES HIS REPORT:"
        say Morning_Oil voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander|, I think I'll switch him off anyway... His program needs to be checked..."
        choice = none
    }
    block_6CD5:
    when {
        require choice == "yes"
    } then {
        say Morning_Oil voice=0x06 flags=0x00 display=0x80 loop=none control=none : "NO, YOU'RE OUT OF YOUR MIND... I DON'T WANT THIS TO HAPPEN... MOTHER, HELP!"
        say Morning_Oil voice=0xFF flags=0x28 display=0x80 loop=none control=none : "HONK:Switch-off procedure activated...."
        choice = none
    }
    block_6D1B:
    say Morning_Oil voice=0xFF flags=0x00 display=0x80 loop=none control=none : "AAAAAAAAAAAAAAA..."
    say Morning_Oil voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x129C] = 0x0001
    state[0x12F2] = 0x0004
    end presentation Morning_Oil
}

