        timer[1] = disabled
        end presentation Bob_Morlock
    }
    block_1D14:
    say Bob_Morlock voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I feel weak, Commander|... Let me sleep..." choices "bye_bye"
    state[0x1270] = 0x0001
    when {
