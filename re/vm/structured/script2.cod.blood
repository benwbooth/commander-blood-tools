    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "See, Commander|! It's what I thought... He's getting violent..."
    say Morning_Oil voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me violent?? He's the one who's making trouble. I'm perfectly calm..."
