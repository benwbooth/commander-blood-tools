    require presentation == Maxxon
    require state[0x1304] == 0x0000
} then {
    when {
        require Maxxon.encounter_count == 0x0001
    } then {
        say Maxxon voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Welcome stranger. Me not know you|. You come from far..."
        say Maxxon voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me Izwal Maxxon. Me be big astronomer. Me build big telescope for see stars."
        say Maxxon voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me like study sky|, stars, galaxies... But me have big problem, friend|..."
        say Maxxon voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Telescope not have good lens. Me seek lens for telescope..."
        say Maxxon voice=0x06 flags=0x00 display=0x80 loop=none control=none : "With nice lens, me can see stars, galaxies, black holes... Me big hobby, friend|..."
        say Maxxon voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You know?"
    }
    block_8179:
    when {
        require Maxxon.encounter_count > 0x0001
    } then {
        say Maxxon voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You're back... Friend... Welcome..."
    }
    block_819A:
    say Maxxon voice=0x09 flags=0x00 display=0x80 loop=none control=none : "If you get lens, me do big favor for you|..."
    say Maxxon voice=0x08 flags=0x00 display=0x80 loop=none control=none : "If you hear of LENS, you tell me|, Commander|..."
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander|, that telescope of his could help us find some black holes... Smart thinking, huh?"
    say Maxxon voice=0x08 flags=0x08 display=0x80 loop=none control=none : "See you soon, friend|... You go now... Me have much work|..."
    observatory.in_play = true using alternate_encoding
    say Maxxon voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "..."
    state[0x1270] = 0x0000
    state[0x12A8] = 0x0001
    end presentation Maxxon
}

proc max2 enabled until max2bis {
    during travel
    require presentation == Maxxon
    require lens.holder == blood
} then {
