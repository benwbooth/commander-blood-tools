        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We put the new batteries in Morning Oil, and he started working again|..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "So we teleported him aboard to study him..."
