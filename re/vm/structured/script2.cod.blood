    say Maxxon voice=0xFF flags=0x00 display=0x80 loop=none control=none : "THIS BE STRANGE JELLY LENS..."
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No, no, no, Mister Maxxon! Nobody uses glass lenses anymore!"
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you just try it|..."
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy snake oil, Commander|. Don't they have any progress around here?|... I mean, these Izwals are nice folks,"
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "but don't count on them for inventing the wheel..."
    say Maxxon voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Me try lens. You come back later. Me thank you anyway for effort..."
    say Maxxon voice=0x09 flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend. See soon..."
    state[0x1272] = 0x0001
    say Maxxon voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Bye bye"
    state[0x12B2] = 0x0001
    state[0x1306] = 0x0002
    end presentation Maxxon
}

proc max2ter enabled until pio {
    during travel
    require presentation == Maxxon
    require lens.holder == Maxxon
    require state[0x1306] == 0x0002
} then {
    say Maxxon voice=0x05 flags=0x00 display=0x80 loop=none control=none : "LENS BE RIGHT LENS, FRIEND!!!"
    say Maxxon voice=0xFF flags=0x02 display=0x80 loop=none control=none : "Very nice technology|..."
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You see, Mister Maxxon! Glass lenses went out with gunpowder and real food..."
    say Maxxon voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You have to try things out before you start moaning..."
