    say Scruter_K voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0001
    say Scruter_K voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0002
    say Scruter_K voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0003
    say Scruter_K voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0004
    say Scruter_K voice=0xFF flags=0x0A display=0x80 loop=none control=none : ""
    state[0x12C0] = 0x0005
    when {
        require state[0x12C0] == 0x0000
    } then {
        jump block_2763
    }
    block_27BC:
    when {
        require state[0x12C0] > 0x0000
    } then {
        sort.enabled = false
        radio1.enabled = true
    }
}

proc radio1 disabled until dring {
