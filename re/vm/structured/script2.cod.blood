        state[0x12C6] = 0x0001
    }
    block_2E6E:
    when {
        require arche.current_location == Corpo
    } then {
        say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Next time, you'll really get it|..."
