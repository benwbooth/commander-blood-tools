    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Give me a little time|... I have to change a couple of blown fuses..."
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "..."
    say Morning_Oil voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    state[0x129E] = 0x0001
    state[0x12F2] = 0x0006
    end presentation Morning_Oil
}

proc Cryomorn4 enabled until Cryomorn3 {
    during contact
    require state[0x12F2] == 0x0006
    require presentation == Morning_Oil
} then {
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander|, Morning Oil has something big, big, big to tell you|... Commander|..."
    say Morning_Oil voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Commander|, I know a way to make us a pile of CREDs: BIONIUM|..."
    say Morning_Oil voice=0x03 flags=0x00 display=0x80 loop=none control=none : "BIONIUM is an energy substance found in Cyberspace pockets..."
    say Morning_Oil voice=0x04 flags=0x00 display=0x80 loop=none control=none : "If we could get hold of a BIONIUM container, then all we'd have to do is enter Cyberspace to collect the stuff..."
    say Morning_Oil voice=0x05 flags=0x00 display=0x80 loop=none control=none : "BIONIUM sells for big money, Commander|. It's the power source for all robots..."
    say Morning_Oil voice=0xFF flags=0x28 display=0x80 loop=none control=none : "This could be a major breakthrough, Commander|. All we need is a BIONIUM container..."
    Morning_Oil.topic = "history"
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, I reckon ol'Morning Oil's operational,"
    say Morning_Oil voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'll tell him to repaint the ARK's hull. The old girl's getting rusty..."
