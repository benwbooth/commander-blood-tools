} then {
    say Daddy_Gluxx voice=0x01 flags=0x08 display=0x80 loop=none control=none : "Ho! A visitor from far away in the space-time continuum..."
    state[0x1270] = 0x0000
    say Daddy_Gluxx voice=0x02 flags=0x00 display=0x80 loop=none control=none : "See, my children, how fascinating he is of aspect..."
    say Daddy_Gluxx voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ooohh, such extraordinary beauty..."
    say Daddy_Gluxx voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Magnificence of Nature..."
    say Daddy_Gluxx voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! I'm Daddy GLUXX this is my family, noble stranger..."
    say Daddy_Gluxx voice=0x01 flags=0x00 display=0x80 loop=none control=none : "We're SLIMERS. This jelly village is where we live..."
    say Daddy_Gluxx voice=0x00 flags=0x00 display=0x80 loop=none control=none : "We have some cousins... old SLIM GELATI and his wife, they're trying to recapture their youth..."
    say Daddy_Gluxx voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Slim Gelati and his wife. They're retired now. They long for eternal youth!"
    say Daddy_Gluxx voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! The old always dream of being young. Ha! Ha! Ha!"
    say Daddy_Gluxx voice=0x02 flags=0x00 display=0x80 loop=none control=none : "But youth costs a fortune, you know... Poor old Slim... He sold everything he owned..."
    say Daddy_Gluxx voice=0x04 flags=0x08 display=0x80 loop=none control=none : "What do you seek, stranger?"
    Daddy_Gluxx.topic = "talk"
    say Daddy_Gluxx voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Bye bye, stranger. Come back again|..." choices "bye_bye"
    state[0x1270] = 0x0001
