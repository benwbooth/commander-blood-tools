    say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Oooooh! You stranger... You come from sky... FEAR... FEAR..."
    say Izwalito voice=0x06 flags=0x00 display=0x80 loop=none control=none : "YOU NOT KILL ME... ME NICE. Me be IZWALITO..."
    say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I don't think we can trust that creature, Commander|. Better watch it carefully..."
    say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's a species of common space rat..."
    say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Izwalito be very hungry... Izwalito want eat..."
    say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's just what I figured, Commander|. He wants our food..."
    say Izwalito voice=0x02 flags=0x10 display=0x80 loop=block_3F53 control=none : "You say your name to Izwalito, stranger?" choices "hyper_man" "predatorus" "commander_blood" "Mousy" "jules_verne" "Exterminator" "tarzoom"
    when {
        require choice == "commander_blood"
    } then {
        say Izwalito voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Me greet you Commander."
        state[0x12D4] = 0x0001
        choice = none
    }
    block_3E91:
    when {
        require choice == "hyper_man"
    } then {
        say Izwalito voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Me greet you Hyper"
        state[0x12D6] = 0x0001
        choice = none
    }
    block_3EB0:
    when {
        require choice == "predatorus"
    } then {
        say Izwalito voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Me greet you Predatorus"
        state[0x12D8] = 0x0001
        choice = none
    }
    block_3ECF:
    when {
        require choice == "Mousy"
    } then {
