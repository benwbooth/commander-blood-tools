proc Corpo3 enabled until cor4bis {
    during travel
    require arche.current_location == Corpo
    require state[0x12C8] == 0x0003
    require presentation == Izwalito
} then {
    when {
        require murffalos.holder == blood
    } then {
        say Izwalito voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Friend, you have murffalo meat? We starve..."
        say Izwalito voice=0x03 flags=0x00 display=0x80 loop=none control=none : "YOU HAVE MURFFALO!!!!!!"
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You've made one little rat very happy, Commander|. Why not teleport him the meat..."
        say Izwalito voice=0xFF flags=0x10 display=0x80 loop=block_50FE control=none : "TELEPORT MURFFALO TO IZWALITO" choices "teleport" "refuse"
        when {
            require choice == "teleport"
        } then {
            say Izwalito voice=0xFF flags=0x08 display=0x90 loop=none control=none : "MURFFALO TELEPORTED TO IZWALITO"
            transfer murffalos from aboard to Izwalito
            choice = none
        }
        block_50BB:
        when {
            require choice == "refuse"
        } then {
            say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, you're not being reasonable..."
            say Izwalito voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Me unhappy... Me angry..."
            say Izwalito voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Bye bye|..."
            choice = none
            end presentation Izwalito
        }
    }
    block_50FE:
    when {
        require murffalos.holder == Izwalito
    } then {
        say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Oh, me happy now. Izwal people say thanks. Me give you big major gifts..."
        say Izwalito voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You can see TV with DECODER. Me give you DECODER for IZWAL CHANNEL..."
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "A decoder, Commander|! Now we can have some fun for a change..."
        say Izwalito voice=0x03 flags=0x08 display=0x90 loop=none control=none : "Thanks to DECODER, you can see TV, friend..."
        sequence_slots[1] = "ppit"
        sequence_slots[5] = "present"
        say Izwalito voice=0xFF flags=0x10 display=0x80 loop=block_51DF control=none : "TELEPORT DECODER TO ARK" choices "teleport"
        when {
            require choice == "teleport"
        } then {
            say Izwalito voice=0xFF flags=0x08 display=0x90 loop=none control=none : "DECODER TELEPORTED TO ARK"
            transfer decoder from Izwalito to aboard
            choice = none
        }
        block_51DF:
        say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You love decoder, friend|..."
        say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "To reward you, me give you one CRED|, friend|..."
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "A cred. Ratboy's handing over a free cred!|... I knew it|... These guys are all millionaires..."
        say Izwalito voice=0xFF flags=0x10 display=0x80 loop=block_528E control=none : "TELEPORT CRED TO ARK" choices "teleport"
        when {
            require choice == "teleport"
        } then {
            say Izwalito voice=0xFF flags=0x08 display=0x90 loop=none control=none : "CRED TELEPORTED TO ARK"
            transfer cred from Izwalito to aboard
            choice = none
            say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You love cred, friend|..."
        }
    }
    block_528E:
    say Izwalito voice=0x02 flags=0x48 display=0x80 loop=none control=none : "You come back when want, friend|..." choices "bye_bye"
    state[0x1270] = 0x0001
    when {
        require state[0x1270] == 0x0001
    } then {
        say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me go quick give murffalo to starving Izwals..."
        say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend|..."
        say Izwalito voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
        state[0x1286] = 0x0001
        state[0x1270] = 0x0000
        state[0x12C8] = 0x0004
        end presentation Izwalito
    }
}

proc cor4bis enabled until Corpo4 {
    during travel
    require murffalos.holder == Izwalito
    require !Rondo.in_play
    require arche.current_location == Corpo
    require presentation == Izwalito
} then {
    say Izwalito voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Friend from sky and stars back on Corpo..."
    state[0x12E2] = 0x0000
    say Izwalito voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me happy, friend|..."
    say Izwalito voice=0x04 flags=0x08 display=0x80 loop=none control=none : "You want what?|..."
    Izwalito.topic = "talk"
    when {
        require state[0x12E2] == 0x0001
    } then {
        say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You be very curious, friend|..."
        say Izwalito voice=0x03 flags=0x10 display=0x80 loop=block_5418 control=none : "You can keep secret?" choices "yes" "no"
        when {
            require choice == "yes"
        } then {
            say Izwalito voice=0x02 flags=0x08 display=0xA0 loop=none control=none : "Me say you big secret..."
            Izwalito.topic = "know"
            state[0x12E2] = 0x0000
            choice = none
        }
        block_53D2:
        when {
            require choice == "no"
        } then {
            say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|!!! How can you be so lacking in perspicacity? You were supposed to say YES..."
            say Izwalito voice=0x04 flags=0x08 display=0x80 loop=none control=none : "You like make joke..."
            choice = none
        }
    }
    block_5418:
    when {
        require !Rondo.in_play
        require Izwalito.encounter_count > 0x0005
    } then {
        say Izwalito voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You go see rich Izwals on planet Rondo, friend|... You say them hello from me..."
        say Izwalito voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Rondo be in Rondalus system, coordinates x345 y432..."
        Rondo.in_play = true
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, Commander he just gave us a new planetary position would you believe, Commander|..."
    }
    block_549E:
    say Izwalito voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Bye bye, come back... You talk good. Me like talk...." choices "bye_bye"
    end presentation Izwalito
}

proc Corpo4 enabled until hom1 {
    during travel
    require murffalos.holder == Izwalito
    require state[0x12D2] == 0x0000
    require !Hita.in_play
    require Rondo.in_play
    require arche.current_location == Corpo
    require presentation == Izwalito
} then {
    say Izwalito voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Izwalito happy see you, friend from sky and stars..."
    Corpo3.enabled = false
    say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "We receive big visit from His Sacredness HOM... Hom be in next village..."
    say Izwalito voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Village be Hita..."
    say Izwalito voice=0x03 flags=0x00 display=0x80 loop=none control=none : "His Sacredness wants to see you, friend|..."
    say Izwalito voice=0x02 flags=0x10 display=0x80 loop=hom1 control=none : "You agree go Hita?" choices "YES" "NO"
    when {
        require choice == "YES"
    } then {
        say Izwalito voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You go north through desert to Hita|..."
        say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "See you soon, friend|..."
        say Izwalito voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "..."
        hom1.enabled = true
        Corpo4.enabled = false
        state[0x12C8] = 0x0005
        navigate to Hita
        choice = none
    }
    block_55CA:
    when {
        require choice == "NO"
    } then {
        say Izwalito voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Maybe you should've agreed, Commander|..."
        say Izwalito voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Bye bye, friend. Me must go..."
        say Izwalito voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
        choice = none
        end presentation Izwalito
    }
}

proc hom1 disabled until M0sk0 {
