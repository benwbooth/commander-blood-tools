        say Otto_Von_Smile voice=0x06 flags=0x00 display=0x80 loop=none control=none : "For those who desire to see far or near or very near indeed! Ha! Ha! These are lenses of the very highest quality..."
        say Otto_Von_Smile voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Each sells for the paltry sum of 2000 creds|... A snip at the price..."
        say Otto_Von_Smile voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, that's exactly what Mister MAXXON needs for his telescope..."
        say Otto_Von_Smile voice=0x03 flags=0x00 display=0x80 loop=none control=none : "But you do not have 2000 creds, do you? I find the poor so tasteless!"
        say Otto_Von_Smile voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Another time perhaps, dear client..."
        say Otto_Von_Smile voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
        choice = none
        state[0x130C] = 0x0001
        end presentation Otto_Von_Smile
    }
    block_8CB6:
    when {
        require choice == "surgery"
    } then {
        say Otto_Von_Smile voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! A little operation! Just like everybody else... It's divinely expensive, naturally... Do you have 100,000 creds?"
        say Otto_Von_Smile voice=0x05 flags=0x00 display=0x80 loop=none control=none : "No, you don't have such a sum... Well run along and get it|..."
        say Otto_Von_Smile voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What a slimeball, Commander..."
