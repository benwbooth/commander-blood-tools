    block_5D7F:
    when {
        require Bronko.encounter_count > 0x0004
    } then {
        say Bronko voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Me be alone here... Me hungry of adventure"
        say Bronko voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Me think much. Me think be useful for you|. You take me with you|.."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You know how to cook?"
        say Bronko voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me know make tasty meals..."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, maybe that's not such a bad idea. He could handle the cooking..."
        say Bronko voice=0x06 flags=0x08 display=0x90 loop=none control=none : "You can teleport me in your ship..."
        Bronko.in_play = false
        Bronko.presentable = true using alternate_encoding
        say Bronko voice=0xFF flags=0x10 display=0x80 loop=block_5EE9 control=none : "TELEPORT BRONKO TO ARK?" choices "teleport" "refuse"
        when {
            require choice == "teleport"
        } then {
            say Bronko voice=0xFF flags=0x28 display=0xB0 loop=none control=none : "BRONKO TELEPORTING TO ARK"
            bring Bronko aboard
            Emasculator.current_location = usine
            choice = none
            end presentation Bronko
        }
        block_5E7A:
        when {
            require choice == "refuse"
        } then {
            say Bronko voice=0x02 flags=0x00 display=0x80 loop=none control=none : "CRY CRY SWEAR... Me unlucky... Me all alone... CRY CRY..."
            say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... Get that guy... What a cry baby... Ha! Ha! Ha!"
            say Bronko voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me sad... Me all alone..."
            say Bronko voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
            choice = none
            end presentation Bronko
        }
    }
    block_5EE9:
    say Bronko voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Bye bye, friend. Bronko have much lot work|..." choices "bye_bye"
    state[0x1270] = 0x0001
    when {
        require state[0x1270] == 0x0001
    } then {
        say Bronko voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
        state[0x1270] = state[0x12CA]
        end presentation Bronko
    }
}

