// format: bloodscript-v4
// image: BAS

object Eviscerator = 0x01B2
object Hom = 0x01FA
object Yoko = 0x0242
object Honk = 0x08BA

field Hom.s13 = Hom + 0x003A // VAR kind 0x0002, selector(s) 13

yield

selector Eviscerator_choices {
    yield_b
    case "talk" -> selector_021C {
        menu "bye_bye" "peace" "war" "prison" "planet" "television" "politics" "reproduction" "science" "race" "consumerism"
        say Eviscerator voice=0x05 flags=0x40 display=0x80 loop=none control=none : "What you want|?" choices "talk"
        say Eviscerator voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Me not say bye bye|, INSULT... SWEAR..." choices "bye_bye"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me watch TV: good night viewers" choices "television"
        say Eviscerator voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Vortex of Fortune, me like. Light shine, vortex spin. Nice|..." choices "television"
        say Eviscerator voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Aaah Tina Burner, me cry cry. Me like songs to cry|..." choices "television"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Me like muscles" choices "politics"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Riot police nice politics" choices "politics"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "War nice politics" choices "politics"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Polly ticks! funny funny, ah ha ah yaeurghhh..." choices "politics"
        say Eviscerator voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Ooouuuh, you not talk reproduction|. Me go red..."
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Reproduction, hot babes! ahhhhaha ha ha ha aaaaahh, laugh laugh laugh swear..." choices "reproduction"
        say Eviscerator voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me not know science|. Complicated" choices "science"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Science be for sissy brains. Me stronger than science|. Me squash science" choices "science"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Science, science|. You obsessed! Me not like!" choices "science"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Trump tail smoke much" choices "consumerism"
        say Eviscerator voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Me like consume. Rata ta ta ta ta tata. That be consume. LAUGH SWEAR..." choices "consumerism"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "You be consumerism...." choices "consumerism"
        yield_b
        selector_021C:
    }
    case "planet" -> selector_03BC {
        menu "talk" "corpo" "magnus" "vista" "erazor" "trashlando" "tumul" "pterra" "Eden"
        say Eviscerator voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me know planets..." choices "planet"
        say Eviscerator voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me like destroy planets|, booomm! Swear laugh laugh|..." choices "planet"
        say Eviscerator voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Corpo big planet|. Much strangers. Me not like strangers. Make me mad..." choices "corpo"
        say Eviscerator voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me splat strangers... Ra ta ta ta ta... Laugh swear" choices "corpo"
        say Eviscerator voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Much creatures on Magnus. Migrax yuk!" choices "magnus"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Me hate SCRUT. Me not like talk about scruter. Me break things!" choices "vista"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Erazor everybody, Ha|! Ha|! Ha|! Ha|! Ha|! Swear... You laugh!" choices "erazor"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "You have cold... You want my finger in your nose? Laugh... Mean and moronic laughter..." choices "trashlando"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Tumul... You say Tumul|?" choices "tumul"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "You call me rat, not nice|. aaahhhggd.. Swear insult..." choices "pterra"
        say Eviscerator voice=0x06 flags=0x41 display=0x80 loop=none control=none : "Me have friends on planet Eden... Swear..." choices "Eden"
        yield_b
        selector_03BC:
    }
    case "race" -> selector_0626 {
        menu "bye_bye" "talk" "izwal" "croolis" "sinox" "tromp" "migrax" "buggol" "ondoyant"
        say Eviscerator voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Izwals small with trunks, yuk|..." choices "izwal"
        say Eviscerator voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Izwal, me spalt, me eat|. Yummy" choices "izwal"
        say Eviscerator voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me not want talk. Izwal not interesting" choices "izwal"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Me like Izwal boiled in liquid nitrogen soup. Slurp" choices "izwal"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Izwals small. No money|..." choices "izwal"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Izwals not like money|. Them be stupid|..." choices "izwal"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Izwals too small. Much bones..." choices "iwals"
        say Eviscerator voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Izwal boiled longtime not bad" choices "izwals"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Me like Izwal stuffed with mercury in liquid nitrogen sauce" choices "izwal"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Me big Croolis" choices "croolis"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Me like me|, kiss kiss kiss" choices "croolis"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Croolis Vareux stink, yuk|..." choices "croolis"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Me like splat Croolis Vareux" choices "croolis"
        say Eviscerator voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Croolis oh! Hee|! Ho! Hee|! Ho!" choices "croolis"
        say Eviscerator voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Sinox big worker, big brain, no muscle" choices "sinox"
        say Eviscerator voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Sinox smart..." choices "sinox"
        say Eviscerator voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me like smoke Trump tail" choices "tromp"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Trump tail smell good|. Nice for head before battle" choices "tromp"
        say Eviscerator voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Migrax good music for cry" choices "migrax"
        say Eviscerator voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Migrax like earn money" choices "migrax"
        say Eviscerator voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Buggol big democracy, yuk" choices "buggol"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Oooh! ondoyant make Croolis knees tremble" choices "ondoyant"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "ondoyants very nice|. Me like. Slurp..." choices "ondoyant"
        yield_b
        selector_0626:
    }
    case "peace" -> selector_07E5 {
        menu "bye_bye" "talk" "friend" "art"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "You talk. Me not understand|..." choices "peace"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "You talk strange language... SWEAR... INSULT... Me not understand" choices "peace"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Little bleeding pieces? LAUGH LAUGH SWEAR LAUGH..." choices "peace"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "You talk. Me not listen" choices "peace"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Smash to pieces... LAUGH LAUGH SWEAR LAUGH" choices "peace"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Piece of meat|... laugh laugh laugh swear cry laugh|..." choices "peace"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "You say something?" choices "peace"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "You bigmouth" choices "peace"
        say Eviscerator voice=0x08 flags=0x48 display=0x80 loop=none control=none : "Me want relieve me. Bye bye stranger|..." choices "peace"
        state[0x138C] = 0x0001
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Me not friend|. Me hate you|. Me hate all... SWEAR INSULT..." choices "friend"
        say Eviscerator voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Friend, yuk|. Ha|! Ha|! Ahhhh... You not laugh?" choices "friend"
        say Eviscerator voice=0x05 flags=0x41 display=0x80 loop=none control=none : "Friend! Ha! Ha! Ha|!!!" choices "friend"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me like art of war|. Nice nice|. Splat all time|..." choices "art"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Art, art. You be sissy... Art... SWEAR SWEAR" choices "art"
        yield_b
        selector_07E5:
    }
    case "war" -> selector_0A02 {
        menu "bye_bye" "talk" "battle" "enemy" "treasure"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Ah. War nice discipline... Splat, kill all... Me like..." choices "war"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Ahhh, big fun. Explode, burn, kill kill. Ahhhh..." choices "war"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Much noise, explosions, screams. Music to Croolis ear..." choices "war"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "You talk good|. Me like hear you|... SWEAR..." choices "war"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Ahhh, war nice discipline. Splat much enemy" choices "war"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "War nice party: break, shoot, kill, squash" choices "war"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Noise, explosion, pain, fear, kill all. Aaah, me like... INSULT" choices "war"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Me want splat you|. Laugh laugh swear. INSULT..." choices "war"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "You excite me. Mouth water now. Aaahrgghhhhh..." choices "war"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Me big warrior, friend|. Me big Croolis chief... You help me..." choices "battle"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Me like squash your head|... LAUGH LAUGH... INSULT... SWEAR..." choices "battle"
        say Eviscerator voice=0x09 flags=0x41 display=0x80 loop=none control=none : "Me destroy and splat enemy... Me like enemy, friend|..." choices "enemy"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "You talk treasure... treasure is in the mummy" choices "treasure"
        say Eviscerator voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Mummy alone know treasure exist..." choices "treasure"
        state[0x1372] = 0x0001
        say Eviscerator voice=0x09 flags=0x41 display=0x80 loop=none control=none : "Me want escape. You help me..." choices "prison"
        yield_b
        selector_0A02:
    }
    case "secrets" -> 0x0000 {
        menu "bye_bye" "talk" "secret"
        say Eviscerator voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me trust..." choices "secrets"
        say Eviscerator voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Treasure! You know treasure???" choices "secret"
        say Eviscerator voice=0x06 flags=0x48 display=0x80 loop=none control=none : "Me tell you where treasure be if you bring me SPLATCH" choices "secret"
        state[0x1374] = 0x0001
        yield
    }
}

selector Yoko_choices {
    yield_b
    case "hello" -> selector_0AFA {
        menu "bye_bye" "talk" "say_nothing"
        say Yoko voice=0x00 flags=0x40 display=0x80 loop=none control=none : "What me do for you?" choices "say_nothing"
        say Yoko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me small. Friends call me small Yoko|..." choices "say_nothing"
        say Yoko voice=0x0C flags=0x00 display=0x80 loop=none control=none : "You come from sky, by heaven. You be extrarondestrial."
        say Yoko voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Stranger from sky|, me greet you|..."
        say Yoko voice=0x0C flags=0x00 display=0x80 loop=none control=none : "Me listen you|, stranger from sky|. Welcome..."
        yield_b
        selector_0AFA:
    }
    case "talk" -> selector_0B26 {
        menu "bye_bye" "race" "art" "politics" "reproduction" "science" "consumerism"
        say Yoko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "What you want know?" choices "talk"
        yield_b
        selector_0B26:
    }
    case "race" -> selector_0BB4 {
        menu "bye_bye" "talk" "Izwal" "Slimers" "Croolis" "Sinox" "Tromp" "Migrax" "Buggol" "ondoyant" "Tubular_brain"
        say Yoko voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Peoples of universe interest you|, friend|..." choices "race"
        say Yoko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You like talk of races in universe|..." choices "race"
        say Yoko voice=0x0E flags=0x40 display=0x80 loop=none control=none : "You like my nice trunk?" choices "race"
        say Yoko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Out there, far in universe, much races|..." choices "race"
        yield_b
        selector_0BB4:
    }
    case "Izwal" -> selector_0DF4 {
        menu "bye_bye" "talk" "race" "peace" "Yoko" "Maxxon" "planet" "listen" "like"
        say Yoko voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Izwals be great pacifist people|..." choices "peace"
        say Yoko voice=0x10 flags=0x40 display=0x80 loop=none control=none : "Me very frightened of war|..." choices "peace"
        say Yoko voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Me small Izwal..." choices "Yoko"
        say Yoko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You know my name." choices "Yoko"
        say Yoko voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Yoko nice name. Me like my name..." choices "Yoko"
        say Yoko voice=0x0A flags=0x40 display=0x80 loop=none control=none : "My father be Maxxon|. He be great astrophysicist..." choices "Maxxon"
        say Yoko voice=0x0C flags=0x40 display=0x80 loop=none control=none : "My father know much things. He be smart..." choices "Maxxon"
        say Yoko voice=0x0C flags=0x40 display=0x80 loop=none control=none : "He be big and strong..." choices "Maxxon"
        say Yoko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Izwals live planet RONDO..." choices "planet"
        say Yoko voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Me like house on planet Rondo..." choices "planet"
        say Yoko voice=0x08 flags=0x40 display=0x80 loop=none control=none : "You welcome on planet Rondo|." choices "planet"
        say Yoko voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Planet Rondo nice nice nice|..." choices "planet"
        say Yoko voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Izwals know listen..." choices "listen"
        say Yoko voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Me like talk to you|. Me listen, friend|..." choices "listen"
        say Yoko voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Me have big ears to listen good|..." choices "listen"
        say Yoko voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Me like beautiful things. Izwals be poets..." choices "like"
        say Yoko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Izwals like eat good things|..." choices "like"
        say Yoko voice=0x0E flags=0x40 display=0x80 loop=none control=none : "Me be shy with females..." choices "like"
        say Yoko voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Izwals be great pacifist people|..." choices "Izwal"
        say Yoko voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Yoko and Maxxon be Izwals..." choices "Izwal"
        say Yoko voice=0x0E flags=0x40 display=0x80 loop=none control=none : "Izwals know listen..." choices "Izwal"
        say Yoko voice=0x0E flags=0x40 display=0x80 loop=none control=none : "Izwals like play..." choices "Izwal"
        yield_b
        selector_0DF4:
    }
    case "Croolis" -> selector_0EFD {
        menu "bye_bye" "talk" "race" "war" "news" "brain" "fear"
        say Yoko voice=0x09 flags=0x48 display=0x80 loop=none control=none : "War be big problem|. Life be good if no war|..." choices "war"
        state[0x138E] = 0x0001
        say Yoko voice=0x10 flags=0x40 display=0x80 loop=none control=none : "Croolis like big muscles, weapons and nice females..." choices "news"
        say Yoko voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Croolis have small brain and big muscles..." choices "brain"
        say Yoko voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Croolis always be danger for balance of universe|..." choices "brain"
        say Yoko voice=0x10 flags=0x40 display=0x80 loop=none control=none : "Yes friend, me afraid. Croolis cruel, them think war only..." choices "fear"
        say Yoko voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Croolis brain big like head of pin. laugh laugh|... cry|... laugh laugh|..." choices "Croolis"
        say Yoko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Croolis be bad, stupid and violent..." choices "Croolis"
        yield_b
        selector_0EFD:
    }
    case "Sinox" -> selector_0F85 {
        menu "bye_bye" "talk" "race" "like" "science" "news" "television"
        say Yoko voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Sinox like technology gadgets..." choices "like"
        say Yoko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Sinox like technology. Big brains..." choices "science"
        say Yoko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me not understand Sinox..." choices "news"
        say Yoko voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Me see Sinox programs on TV. Funny|... laugh laugh.. cry.. laugh." choices "television"
        yield_b
        selector_0F85:
    }
    case "Tromp" -> selector_0FE3 {
        menu "bye_bye" "talk" "race" "know" "trunk"
        say Yoko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me not know Trumps..." choices "know"
        say Yoko voice=0x0E flags=0x40 display=0x80 loop=none control=none : "Trumpet nice instrument..." choices "trunk"
        say Yoko voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me not smoke Trump tails. So bad for health..." choices "Tromp"
        yield_b
        selector_0FE3:
    }
    case "Migrax" -> selector_1057 {
        menu "bye_bye" "talk" "race" "brain" "money"
        say Yoko voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Migrax big stupid|." choices "brain"
        say Yoko voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Migrax like too much money|." choices "money"
        say Yoko voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Them like business. Nothing free..." choices "money"
        say Yoko voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Migrators be cool. Me like music." choices "Migrax"
        yield_b
        selector_1057:
    }
    case "Buggol" -> selector_110D {
        menu "bye_bye" "talk" "race" "election" "president" "news" "politics"
        say Yoko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Buggols be democrats. Good example." choices "politics"
        say Yoko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me hear much about Buggol democracy." choices "politics"
        say Yoko voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Buggol democracy big idea|. Permanent elections..." choices "election"
        say Yoko voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Buggol presidents last one hour or two..." choices "president"
        say Yoko voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Nobody can see Buggol. Planet forbidden to strangers." choices "news"
        say Yoko voice=0x10 flags=0x40 display=0x80 loop=none control=none : "Buggol be strange race..." choices "news"
        yield_b
        selector_110D:
    }
    case "ondoyant" -> selector_11CD {
        menu "bye_bye" "talk" "race" "emotion" "news" "feeling"
        say Yoko voice=0x06 flags=0x40 display=0x80 loop=none control=none : "ondoyants be very strange. Them intimidate me..." choices "news"
        say Yoko voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Father say ondoyants not exist, ondoyants be legend..." choices "news"
        say Yoko voice=0x0E flags=0x40 display=0x80 loop=none control=none : "Me have knees all weak|..." choices "emotion"
        say Yoko voice=0x0E flags=0x40 display=0x80 loop=none control=none : "ondoyants big emotion..." choices "feeling"
        say Yoko voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Ah, females be big problem|. Me all alone... Cry cry|..." choices "ondoyant"
        say Yoko voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Me want ondoyant with me|, friend|..." choices "ondoyant"
        yield_b
        selector_11CD:
    }
    case "Tubular_brain" -> selector_1219 {
        menu "bye_bye" "talk" "news"
        say Yoko voice=0x03 flags=0x41 display=0x80 loop=none control=none : "Me not know those beings..." choices "news"
        say Yoko voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Tubular strange name..." choices "Tubular_brain"
        say Yoko voice=0x09 flags=0x41 display=0x80 loop=none control=none : "Not know..." choices "Tubular_brain"
        yield_b
        selector_1219:
    }
    case "Slimers" -> selector_1302 {
