        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Pranayama through numerology! You lucky person! Choose a number between ten and twenty..." choices "calm_down"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Observe your screen carefully, Commander|... How many numbers do you see?" choices "calm_down"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "One" choices "one"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Two" choices "two"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Three" choices "three"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Four" choices "four"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Five" choices "five"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Six" choices "six"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Seven" choices "seven"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Eight" choices "eight"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Nine... GOOD WORK, COMMANDER|... I sense you're quite relaxed now|...." choices "nine"
        yield_b
        selector_293D:
    }
    case "explanations" -> 0x0000 {
        menu "bye_bye" "talk" "blood" "Bob_Morlock" "Honk" "Ark" "Ma" "Orxx" "Olga" "Big_Bang" "Black_holes"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Explanations about anything in particular, Commander|?" choices "explanations"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Why, you're Commander Blood, Commander. You're the hero of this story..." choices "blood"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob is our master|. He built us all..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob is very very old, Commander|. Over 800,000 years old..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob programmed me to detect black holes which are our gateway to the BIG BANG|..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob is very very intelligent. He has a biobrain, just like you|. I'm a cybernetic..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "I HEAR AND OBEY, COMMANDER|..." choices "Honk"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The ARK is our vessel, built by cybernetic units belonging to KANARY CORP." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "It's quite a ship! We have 16 CRYOBOXES where we can stock aliens or merchandise..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The Ark is equipped with the fastest warp drives in the entire universe|..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The Ark is equipped with an ORXX layer called MA... The Orrx are amazing missiles..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "All onboard comforts have been provided. We have the telephone, a restaurant and widescreen TV..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA is one of nature's curiosities, a kind of space whale, genetically altered by Cap'n Bob|..." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA lays her eggs in the PRAM ZONE. The eggs hatch into ORXX..." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA is a sensitive being, Commander|. She is very sensitive to music..." choices "MA"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA eats only synthetic strawberries..." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob loves synthetic strawberries. He perfected them with help from the KANARY geneticists." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Orxx are LIVING guided missiles. Thanks to them, you're always perfectly safe..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You guide an Orxx through space, seeing through its eyes. It lands on planets for you|..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "If there's any danger, the Orxx is destroyed... Not you! You're safe in orbit..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Think of Orxx as your representatives. We dialog through them with the aliens. Alien languages are translated by Olgo, the onboard translator..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The Orxx are one of Cap'n Bob's finest creations..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga is our cybernetic translator. She knows all the languages in the universe|..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga is very highly paid in MEGAWATTS. More than me|, Commander|..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga translates almost word for word. She doesn't care for nasty language..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Never say anything bad about Olga, Commander|. She's very touchy..." choices "Olga"
        say Honk voice=0xFF flags=0x40 display=0x80 loop=none control=none : "MISTER HONK CAN JUST SHUT HIS LYING MOUTH..... SIGNED Olga...." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "See what I mean, Commander|... I told you|..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The BIG BANG is one of Cap'n Bob's inventions, Commander|. He thinks the BIG BANG will help him understand the universe|... Old age doesn't suit him..." choices "Big_Bang"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "My calculations tell me the BIG BANG is fake, Commander|. I think it's a deformed prism designed to fool us..." choices "Big_Bang"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Commander, just between you and me|, I think ol' Buzzard Man Bob has another idea in mind..." choices "Big_Bang"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Black holes are amazing devices which space out time and temporise space..." choices "Black_holes"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "If we travel through a black hole, we are sure to discover NEW and WEIRD UNIVERSES, Commander|..." choices "Black_holes"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "What lies beyond black holes is an unfathomed mystery, Commander|..." choices "Black_holes"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Commander|, I feel dizzy all of a sudden..." choices "Black_holes"
        say Honk voice=0xFF flags=0x21 display=0x80 loop=none control=none : "Yes! Commander|..."
        yield
    }
}

