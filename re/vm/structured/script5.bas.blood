        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob put the instant translator together. He's a guy and a half!" choices "dialog"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga, your onboard translator, knows every language in the universe! She's paid in megawatts, like me|, only she gets more." choices "dialog"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Let's dialog..." choices "dialog"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Fair play is inscribed in the Traveller's Charter: Whatever happens, play fair!" choices "fair_play"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Win, win, win. Why do the computers always have to lose?" choices "faiplay"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "OK, Commander|... You seem like a fair play guy. I'll tell Cap'n Bob|..." choices "fair_play"
