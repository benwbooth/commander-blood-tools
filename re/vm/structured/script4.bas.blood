        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "Kanary invents, builds, consumes and controls everything in the universe" choices "kanary"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Kanary is so well managed that its products are built at negative cost" choices "reports"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "A complete cottage costs 100,990 Negabucks..." choices "reports"
        say Bob_Morlock voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Our turnover is so big that nobody can say the figure in a normal life span" choices "reports"
        say Bob_Morlock voice=0x06 flags=0x49 display=0x80 loop=none control=none : "Our only competitor is CRYO" choices "They"
