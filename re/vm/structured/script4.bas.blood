        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You flatter me, Commander|..." choices "good_"
        say Bob_Morlock voice=0x02 flags=0x4A display=0x80 loop=none control=none : "You're embarrassing me, Commander|..." choices "good_"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x43 display=0x80 loop=none control=none : "Heh heh|..." choices "good_"
        yield_b
        selector_157B:
