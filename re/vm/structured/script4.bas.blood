// format: bloodscript-v5
// image: BAS

object Bratakas = 0x004A
object Maziok = 0x00DA
object Super_Tromp = 0x01B2
object Bob_Morlock = 0x0242
object Hom = 0x03AA
object Morning_Oil = 0x0482
object Bronko = 0x0512
object Beauregard = 0x067A
object Fifi = 0x079A
object Honk = 0x0A6A

field Bob_Morlock.conversation_progress = Bob_Morlock + 0x0032 // VAR kind 0x0002, selector(s) 03
field Bob_Morlock.action = Bob_Morlock + 0x003A // VAR kind 0x0002, selector(s) 13
field Hom.action = Hom + 0x003A // VAR kind 0x0002, selector(s) 13
field Bronko.action = Bronko + 0x003A // VAR kind 0x0002, selector(s) 13

yield

selector Super_Tromp_choices {
    yield_b
    case "talk" -> 0x0000 {
        menu "bye_bye" "painting" "culture" "yolk"
        say Super_Tromp voice=0x00 flags=0x40 display=0x80 loop=none control=none : "The GREAT YOLK was a Slimer... An important thinker..." choices "yolk"
        say Super_Tromp voice=0x01 flags=0x40 display=0x80 loop=none control=none : "He died a long time ago and he's buried here on Vista..." choices "yolk"
        say Super_Tromp voice=0x02 flags=0x40 display=0x80 loop=none control=none : "This palace was specially built to house the remains of the GREAT YOLK..." choices "yolk"
        say Super_Tromp voice=0x03 flags=0x48 display=0x80 loop=none control=none : "The whole universe admires the GREAT YOLK..." choices "yolk"
        state[0x151E] = 0x0001
        say Super_Tromp voice=0xFF flags=0x40 display=0x80 loop=none control=none : "The portrait in this palace was painted with the GREAT YOLK's own yellow blood..." choices "painting"
        say Super_Tromp voice=0xFF flags=0x40 display=0x80 loop=none control=none : "The painting is beyond price... It is magical..." choices "painting"
        say Super_Tromp voice=0xFF flags=0x40 display=0x80 loop=none control=none : "It is said that he who possesses it is immortal..." choices "painting"
        say Super_Tromp voice=0xFF flags=0x40 display=0x80 loop=none control=none : "The GREAT YOLK said: \"One plus one equals three, thanks to the coefficient of reproduction\"..." choices "culture"
        say Super_Tromp voice=0xFF flags=0x40 display=0x80 loop=none control=none : "The GREAT YOLK said:\"Silence feeds on sound and fury\"." choices "culture"
        say Super_Tromp voice=0xFF flags=0x40 display=0x80 loop=none control=none : "The GREAT YOLK said: \"It takes thirteen murffalos to reproduce|, but one day it will take fourteen\"" choices "culture"
        yield
    }
}

selector Maziok_choices {
    yield_b
    case "talk" -> selector_0282 {
        menu "bye_bye" "medicine" "curse"
        say Maziok voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me know good medicine and good doctor... You be very sick|..." choices "medicine"
        say Maziok voice=0x03 flags=0x48 display=0x80 loop=none control=none : "You have nightmares and you not be lucky..." choices "medicine"
        presentation_register 0x2624
        say Maziok voice=0x04 flags=0x48 display=0x80 loop=none control=none : "You need sorceror medicine???" choices "medicine"
        presentation_register 0x2624
        say Maziok voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Curse come from land of dead... You did be bad to dead..." choices "curse"
        say Maziok voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Me scared..." choices "curse"
        say Maziok voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Yes, yes... Me know good sorceror, friend|..." choices "sorceror"
        presentation_register 0x2624
        say Maziok voice=0x03 flags=0x48 display=0x80 loop=none control=none : "Him live alone on desert planet|..." choices "sorceror"
        state[0x1512] = 0x0001
        yield_b
        selector_0282:
    }
    case "planet" -> 0x0000 {
        menu "bye_bye" "vista" "tromp" "ondoyant" "tourism"
        say Maziok voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The planet Vista is where I'm from... It suits me|..." choices "vista"
        say Maziok voice=0x02 flags=0x48 display=0x80 loop=none control=none : "There's a saying which goes: \"Hasta la Vista\"" choices "vista"
        presentation_register 0x0C64
        say Maziok voice=0x02 flags=0x40 display=0x80 loop=none control=none : "We Trumps are an ancient people|... We like peace|..." choices "tromp"
        say Maziok voice=0x02 flags=0x40 display=0x80 loop=none control=none : "We fear nothing as much as the Trump tail hunters..." choices "tromp"
        say Maziok voice=0x02 flags=0x00 display=0x80 loop=none control=none : "They come in big ships, with enormous weapons attached to their arms. They are vulgar and uncouth.."
        say Maziok voice=0x01 flags=0x48 display=0x80 loop=none control=none : "To think there are those who would smoke our tails..." choices "tromp"
        presentation_register 0x0C64
        say Maziok voice=0x02 flags=0x40 display=0x80 loop=none control=none : "There are even fools that believe in ondoyants..." choices "ondoyant"
        say Maziok voice=0x01 flags=0x48 display=0x80 loop=none control=none : "ondoyants live only in dreams..." choices "ondoyant"
        presentation_register 0x0C64
        yield
    }
}

selector Fifi_choices {
    yield_b
    case "hello" -> 0x0000 {
        menu "bye_bye" "planet" "information" "races"
        say Fifi voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Uhh... Me not remember planet|..." choices "planet"
        say Fifi voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Information... Me not understand information... Uhh!" choices "information"
        say Fifi voice=0x05 flags=0x40 display=0x80 loop=none control=none : "You be sure you know talk, friend?" choices "races"
        say Fifi voice=0x02 flags=0x01 display=0x80 loop=none control=none : "Uhh... Me sick|..."
        yield
    }
}

selector Bratakas_choices {
    yield_b
    case "talk" -> 0x0000 {
        menu "bye_bye" "Vistar" "planet" "race" "croolis"
        say Bratakas voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You want to talk, friend..." choices "talk"
        say Bratakas voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Vistar is the name of my planet|. I am alone here|..." choices "Vistar"
        say Bratakas voice=0x00 flags=0x48 display=0x80 loop=none control=none : "I find peace here|... Nobody to bother me|..." choices "Vistar"
        presentation_register 0x2725
        say Bratakas voice=0x01 flags=0x48 display=0x80 loop=none control=none : "It's calm here. No neighbors, no noise, no TV..." choices "Vistar"
        presentation_register 0x2725
        say Bratakas voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Ah|, It's true that the winter nights would be nicer with TV..." choices "leisure"
        presentation_register 0x2725
        say Bratakas voice=0x00 flags=0x48 display=0x80 loop=none control=none : "To watch TV, I'd need a good decoder..." choices "leisure"
        state[0x151C] = 0x0001
        say Bratakas voice=0x00 flags=0x40 display=0x80 loop=none control=none : "No shortage of planets|, that's for sure..." choices "planet"
        say Bratakas voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Planets! You're quite fascinated by them..." choices "planet"
        state[0x151A] = 0x0001
        say Bratakas voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Only Tromps here.. We seldom get strangers..." choices "race"
        say Bratakas voice=0x01 flags=0x48 display=0x80 loop=none control=none : "Big ships pass nearby from time to time|..." choices "race"
        presentation_register 0x2725
        say Bratakas voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Aren't you feeling well?" choices "croolis"
        say Bratakas voice=0x01 flags=0x40 display=0x80 loop=none control=none : "I'm sure you're insulting me...I don't like insults I don't understand|..." choices "croolis"
        say Bratakas voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Don't insult me, stranger|... I don't like it..." choices "croolis"
        yield
    }
}

selector Beauregard_choices {
    yield_b
    case "talk" -> 0x0000 {
        menu "bye_bye" "listen" "insist" "treat"
        say Beauregard voice=0x0C flags=0x41 display=0x80 loop=none control=none : "Aaaah... Eeeerrr..." choices "listen"
        say Beauregard voice=0x0D flags=0x40 display=0x80 loop=none control=none : "Aaaa..." choices "bye_bye"
        say Beauregard voice=0x0E flags=0x40 display=0x80 loop=none control=none : "I've been struck by the CURSE of BETAKAM IV|..." choices "insist"
        say Beauregard voice=0xFF flags=0x68 display=0x80 loop=none control=none : "That sounds like a bad thing to get struck by, Commander|..." choices "insist"
        presentation_register 0x2803
        say Beauregard voice=0x0F flags=0x48 display=0x80 loop=none control=none : "Gladis is the sun of the Tumul system. It exploded..." choices "gladis"
        presentation_register 0x2803
        say Beauregard voice=0xFF flags=0x68 display=0x80 loop=none control=none : "What do you mean, a sun?" choices "gladis"
        presentation_register 0x2803
        say Beauregard voice=0x10 flags=0x40 display=0x80 loop=none control=none : "Gladis killed every living thing|. It's miracle I survived... Aaarr.." choices "insist"
        say Beauregard voice=0x11 flags=0x40 display=0x80 loop=none control=none : "My body is completely fried... I must have a new body... Friend..." choices "treat"
        say Beauregard voice=0x12 flags=0x40 display=0x80 loop=none control=none : "My brain is intact but the rest is history... Ash... Aaaarrr..." choices "treat"
        say Beauregard voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Better not tire him out|, Commander|..." choices "treat"
        say Beauregard voice=0x13 flags=0x41 display=0x80 loop=none control=none : "I must have a new body..." choices "treat"
        say Beauregard voice=0x14 flags=0x01 display=0x80 loop=none control=none : "Aaaarrr"
        yield
    }
}

selector Honk_choices {
    yield_b
    case "talk" -> 0x0000 {
        menu "bye_bye" "help" "message"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "I hear and obey, Commander|..." choices "talk"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Hup! Commander|..." choices "bye_bye"
        yield
    }
}

selector Morning_Oil_choices {
    yield_b
    case "talk" -> selector_07FD {
        menu "hello" "say_nothing" "laugh" "bye_bye"
        say Morning_Oil voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Hi Commander" choices "hello"
        say Morning_Oil voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Such silence..." choices "say_nothing"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Ha ha ha ha ha ha..." choices "laugh"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Bye bye Commander" choices "bye_bye"
        yield_b
        selector_07FD:
    }
    case "history" -> selector_0811 {
        menu "bye_bye" "war" "croolis" "treasure" "battles" "mastachok"
        yield_b
        selector_0811:
    }
    case "war" -> selector_0951 {
        menu "bye_bye" "match"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "That was a real bad war|... It all started the day of the boxing match between EVISCERATOR and EMASCULATOR..." choices "war"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You should've seen it, Commander|... What a fight..." choices "war"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "They made BIONIUM bombs... Those things could blow away whole planets|..." choices "war"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "The whole galaxy seemed to be burning... BBOOOOMMM!!! BAM! RA TA TA TA TA... Ha! Ha! Ha!" choices "war"
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "The boxing match ended badly. They televised it throughout the universe|..." choices "match"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The war was between the two Croolis chiefs, Eviscerator and Emasculator... It was a bad one..." choices "match"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The match was televised throughout the universe|... Ahh, I can picture it now|..." choices "match"
        yield_b
        selector_0951:
    }
    case "croolis" -> selector_0AD8 {
        menu "bye_bye" "history" "terror" "eviscerator" "emasculator"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Croolis are exceptional warriors" choices "croolis"
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "My master, EVISCERATOR specialised in BIONIUM prospection..." choices "croolis"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "he found BIONIUN in the galactic cyberspace contraction..." choices "croolis"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Those Croolis are serious dingbats!!!" choices "croolis"
        say Morning_Oil voice=0x07 flags=0x40 display=0x80 loop=none control=none : "The planets lived in terror for countless years..." choices "terror"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Terror was the Croolis secret weapon..." choices "terror"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "We robots were programmed to feel no fear..." choices "terror"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Eviscerator finished up badly. When SCRUT put a stop to the war, they jailed him" choices "eviscerator"
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Eviscerator is dangerous, Commander|. He's a ruthless killer..." choices "eviscerator"
        say Morning_Oil voice=0xFF flags=0x68 display=0x80 loop=none control=none : "Commander|... I'm worried that memories of his old master might make him violent..." choices "eviscerator"
        state[0x1530] = 0x0001
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Emasculator is completely brainless... Mean and stupid|..." choices "emasculator"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "That's one Croolis I hate|..." choices "emasculator"
        yield_b
        selector_0AD8:
    }
    case "treasure" -> selector_0C43 {
        menu "bye_bye" "history" "hiding_place"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Ah|! The treasure. You should've seen it, Commander|... Incredible..." choices "treasure"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Stones from Galabar, horns from Rla, authentic Rhinox bone vases..." choices "treasure"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Ha! Ha! Hard to say where he hid it, Commander|..." choices "hiding_place"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "I don't mind giving you a few clues, but it's confidential information..." choices "hiding_place"
        say Morning_Oil voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I don't want HONK to hear..." choices "hiding_place"
        state[0x1532] = 0x0001
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Millions were wiped out in the battles. Planets were stripped to the bone..." choices "battle"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "The Izwals suffered heavy losses. They weren't ready|..." choices "battle"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "The SCRUT armies finally won after a gigantic battle that shook the galaxy to its knees.." choices "battle"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "The defeated Croolis ended up on Trashlando. That's a BAD place, Commander|..." choices "battle"
        yield_b
        selector_0C43:
    }
    case "mastachok" -> 0x0000 {
        menu "bye_bye" "history" "information"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Mastachok is a dead planet|... Nothing lives any more on its surface..." choices "mastachok"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "The factory was replaced by the jail... With permanent SCRUT guards..." choices "mastachok"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Mastachok is absolutely polluted... Nothing more than a cinder block..." choices "mastachok"
        yield
    }
}

selector Bronko_choices {
    yield_b
    case "talk" -> selector_0CD6 {
        menu "bye_bye" "robot" "cred" "murffalos" "weapons"
        yield_b
        selector_0CD6:
    }
    case "robot" -> selector_0E73 {
        menu "talk" "bye_bye" "robot" "intelligence" "energy" "technology" "retirement"
        say Bronko voice=0x05 flags=0x48 display=0x80 loop=none control=none : "See you soon|, friend|..." choices "bye_bye"
        end presentation Bronko
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me robot Bronko AX34 BUTCHER model..." choices "robot"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Robot be strong friend|. Robot Bronko know how chop meat with chopper..." choices "robot"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me big robot... Sophisticated..." choices "robot"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me big cybernetic intelligence|. Much cheap memory..." choices "intelligence"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me know think. Me smart..." choices "intelligence"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me big CDROM in head... Ha! Ha! Ha! Ha!" choices "intelligence"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Bronko intelligent..." choices "intelligence"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me much energy: Bronko have fresh batteries, friend|...." choices "energy"
        say Bronko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me munch high energy zinc flakes with mercury every day..." choices "energy"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You look for batteries, friend|... Me buy batteries at VENUSIA Supramarket" choices "energy"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "VENUSIA Supramarket sell cheap batteries. You not see commercial on TV, friend?" choices "energy"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Bronko big technology, friend|..." choices "technology"
        yield_b
        selector_0E73:
    }
    case "cred" -> selector_0F5F {
        menu "talk" "bye_bye" "cred" "buy"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me work to earn much CRED, friend|..." choices "cred"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Creds be hard to earn..." choices "cred"
        say Bronko voice=0x03 flags=0x41 display=0x80 loop=none control=none : "You like creds, friend|..." choices "cred"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me want buy big ship... Take vacation through universe|..." choices "buy"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me want buy home on planet Troma... Grow nuts, bolts, screws..." choices "buy"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me want breed cybernetic wheelbarrows, lawnmowers... Me dream, friend|..." choices "buy"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "To buy, me must earn creds..." choices "buy"
        yield_b
        selector_0F5F:
    }
    case "murffalos" -> selector_1017 {
        menu "talk" "bye_bye" "hunt"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Thirteen murffalos to reproduce... One in middle. twelve around. That be murffalo reproduction|..." choices "murffalos"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me not like murffalo... Not good, too tender... Me like lawnmower leg..." choices "murffalos"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me know chop murffalos..." choices "murffalos"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me like hunt satellite game with laser-pulper... Bang Bang at satellites..." choices "hunt"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Hunting be nice sport..." choices "hunt"
        yield_b
        selector_1017:
    }
    case "weapons" -> selector_10A7 {
        menu "talk" "bye_bye" "planets" "war"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "To buy good weapons, must pay much creds, Commander" choices "weapons"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me have weapons at end of arms..." choices "weapons"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You be big traveller. Know planets|, friend|..." choices "planets"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Croolis war do much damage... Bad war, friend|..." choices "war"
        yield_b
        selector_10A7:
    }
    case "retirement" -> 0x0000 {
        menu "talk" "bye_bye" "Magnus"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Ah retirement! Them send me to planet Magnus, with other old old robots... CRY CRY|..." choices "retirement"
        yield
    }
}

selector Bob_Morlock_choices {
    yield_b
    case "talk" -> selector_157B {
        menu "bye_bye" "black_hole" "Big_Bang" "Bob_Morlock" "kanary" "mission" "corpo" "good_"
        say Bob_Morlock voice=0x02 flags=0x42 display=0x80 loop=none control=none : "What do you want to know|, Commander?" choices "talk"
        say Bob_Morlock voice=0x03 flags=0x48 display=0x80 loop=none control=none : "Goodbye, Commander|..." choices "bye_bye"
        end presentation Bob_Morlock
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "After years of research, I was able to isolate time|, Commander" choices "black_hole"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Certain black holes can be used to travel back in time." choices "black_hole"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Honk has been programmed to identify appropriate black holes" choices "black_hole"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "To reach the BIG BANG, you must travel through a number of black holes..." choices "black_hole"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "Black holes are amazing natural devices, Commander|..." choices "black_hole"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "I have devoted my life to the pursuit of Truth, Commander|..." choices "Big_Bang"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "I know that truth lies beyond the BIG BANG, Commander!" choices "Big_Bang"
        say Bob_Morlock voice=0x01 flags=0x41 display=0x80 loop=none control=none : "My memory is not what it used to be..." choices "Big_Bang"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Thanks to the scientists of KANARY, I am the oldest being in the UNIVERSE" choices "Bob_Morlock"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "In my time|, I've been a crooner, a magician, an adventurer... I created KANARY, the biggest business empire in the universe|." choices "Bob_Morlock"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Women have found me irresistible. Thousands of generations have admired me. I am immortal!" choices "Bob_Morlock"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Commander|, you are going to relive my past. I envy you|..." choices "Bob_Morlock"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "Ah... Otto Von Smile, Eviscerator, Jeph d'Ulikan, Yolk|, old Tina Burner, and all the others..." choices "Bob_Morlock"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x49 display=0x80 loop=none control=none : "Ahh! Those were good times|, Commander|..." choices "Bob_Morlock"
        presentation_register 0x2ED5
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "You want revelations, Commander|?" choices "revelation"
        state[0x152C] = 0x0001
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Your mission is to find and travel through the right black holes, taking us back through time to the BIG BANG" choices "mission"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You'll meet fabulous beings, some of them very dangerous. You'll need all your talents, Commander" choices "mission"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You'll see terrible wars, cross impossible frontiers..." choices "mission"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You must rally strange beings to your cause..." choices "mission"
        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "You will be in sole command, unless you decide to wake me|..." choices "mission"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Corpo is my home planet" choices "It"
        say Bob_Morlock voice=0x03 flags=0x49 display=0x80 loop=none control=none : "Corpo is a rare and fabulous planet|... Its resources are unlimited." choices "corpo"
        Bob_Morlock.conversation_progress += 0x0002
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Truth is to be found at the creation of the universe, just before the BIG BANG..." choices "truth"
        say Bob_Morlock voice=0x01 flags=0x49 display=0x80 loop=none control=none : "Ah! Truth..." choices "truth"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0xFF flags=0x48 display=0x80 loop=none control=none : "I'm getting pictures from the Ark, Commander. All systems are nominal..." choices "good_"
