        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "Kanary's artificial orchids produce centuries old whiskey" choices "cottage"
        Bob_Morlock.conversation_progress += 0x0005
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Kanary has devoted itself to synthetic cloning" choices "clones"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Kanary's four million employees were built by and for Kanary" choices "clones"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "I am the last natural bio-being and I control everything..." choices "clones"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Every year, my employees wake me for ten minutes on my birthday... I blow out the candles on my cake and sign the company reports" choices "clones"
        say Bob_Morlock voice=0x01 flags=0x49 display=0x80 loop=none control=none : "I instructed Kanary's scientists to to create the perfect adventurer to take me to the BIG BANG..." choices "clones"
        Bob_Morlock.conversation_progress += 0x0003
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "All Kanary employees were built by the CLONE CONSORTIUM. Including YOU, Commander" choices "employees"
        say Bob_Morlock voice=0x04 flags=0x40 display=0x80 loop=none control=none : "You are all my employees: YOU Honk, YOU Commander|, YOU Olga... ALL OF YOU..." choices "employees"
        say Bob_Morlock voice=0x05 flags=0x49 display=0x80 loop=none control=none : "Kanary builds the cheapest and most efficient employees in the universe|..." choices "employees"
        state[0x1528] = 0x0001
