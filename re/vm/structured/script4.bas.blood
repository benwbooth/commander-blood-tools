        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The vegetable kingdom is a marvel of nature" choices "cottage"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The Cottage Research department develops miracles of nature" choices "cottage"
