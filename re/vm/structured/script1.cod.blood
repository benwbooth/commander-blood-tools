// format: bloodscript-v5
// image: COD

object blood = 0x0028
object Bob_Morlock = 0x004A
object Bronko = 0x031A
object Izwalito = 0x055A
object Honk = 0x082A
object menu = 0x0872

field Bob_Morlock.encounter_count = Bob_Morlock + 0x0036 // VAR kind 0x0002, selector(s) 08
field Bob_Morlock.action = Bob_Morlock + 0x003A // VAR kind 0x0002, selector(s) 13
field Bronko.current_location = Bronko + 0x0018 // VAR kind 0x0002, selector(s) 11
field Izwalito.action = Izwalito + 0x003A // VAR kind 0x0002, selector(s) 13
field Izwalito.topic = Izwalito + 0x0046 // VAR kind 0x0002, selector(s) 0F
field Honk.encounter_count = Honk + 0x0036 // VAR kind 0x0002, selector(s) 08
field Honk.action = Honk + 0x003A // VAR kind 0x0002, selector(s) 13
field menu.action = menu + 0x003A // VAR kind 0x0002, selector(s) 13

proc menbr {
    activation enabled until men1
    branch_presentation
    require presentation == menu
    require Bronko.current_location == aboard
    guard_pop
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"IMPROVED MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today CHEF BRONKO has laid on for you:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Tasty MURFFALO soup Bronko-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO kidneys Bronko-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "MURFFALO hamburger with Bar-B-Q recycled-oil dip."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Smooth MURFFALO-chip ice cream."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Chef Bronko says... Burping's bad manners!..."
    say menu voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    end presentation menu
}

proc men1 {
    activation enabled until men2
    branch_presentation
    require presentation == menu
    require Bronko.current_location != aboard
    guard_pop
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PLASMA soup HONK-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER belly in slobber sauce."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Jellied URTIKAN with MURFFALO bone marrow."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK eye pie."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Don't eat with your mouth full!..."
    say menu voice=0xFF flags=0x08 display=0x90 loop=none control=none : "Stop"
    men1.enabled = false
    end presentation menu
}

proc men2 {
    activation enabled until men3
    branch_presentation
    require presentation == menu
    require Bronko.current_location != aboard
    guard_pop
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PLASMA soup HONK-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER snout stew."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "URTIKAN seeds in MURFFALO venom."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK juice dessert."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Don't talk with your mouth open!..."
    say menu voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    men2.enabled = false
    end presentation menu
}

proc men3 {
    activation enabled until men4
    branch_presentation
    require Bronko.current_location != aboard
    require presentation == menu
    guard_pop
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "PLASMA soup HONK-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER feet in emulsive sauce."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "URTIKAN leaves in MURFFALO sweat."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK flake dessert."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Somebody didn't finish his wrigglers yesterday..."
    say menu voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    men3.enabled = false
    end presentation menu
}

proc men4 {
    activation enabled until men5
    branch_presentation
    require presentation == menu
    require Bronko.current_location != aboard
    guard_pop
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "HONK-style PLASMA soup."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER brain, stewed in its own juice."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "URTIKAN trunk, stuffed with MURFFALO liver."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GLOK dee-lite."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... Plenty more in the kitchen!..."
    say menu voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    men4.enabled = false
    end presentation menu
}

proc men5 {
    activation enabled until men6
    branch_presentation
    require presentation == menu
    require Bronko.current_location != aboard
    guard_pop
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "\"IMPROVED MENU\""
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Today's fare:"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Soup of PLASMA HONK-style."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WRIGGLER hearts in green blood coagulate."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "URTIKAN roots, deep fried in recycled oil."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Candied GLOK tongue."
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Recycled water"
    say menu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The chef says... You eat what you are!..."
    say menu voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
    men5.enabled = false
    men6.enabled = true
    end presentation menu
}

proc men6 {
    activation disabled until tima
    guard_pop
    men1.enabled = true
    men2.enabled = true
    men3.enabled = true
    men4.enabled = true
    men5.enabled = true
    men6.enabled = false
}

proc tima {
    activation enabled until ho
    guard_pop
    state_array_set 0x16 0x0005
    tima.enabled = false
}

proc ho {
    activation enabled until ho1
    state_array_test 0x16
    guard_pop
    queue presentation Izwalito
    ho.enabled = false
}

proc ho1 {
    activation enabled until hon
    branch_presentation
    require presentation == Izwalito
    guard_pop
    say Izwalito voice=0xFF flags=0x08 display=0x80 loop=none control=none : "You found the right button. So far so good..."
    Izwalito.topic = "rien"
    say Izwalito voice=0xFF flags=0x10 display=0x80 loop=block_04CE control=none : "Click quick, Cap'n Bob is waiting..." choices "explanations" "game"
    when block_04C6 {
        require choice == "game"
    } then {
        say Izwalito voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "GAME"
        run_profile 0x02
        choice = none
        end presentation Izwalito
    }
    block_04C6:
    when block_04CE {
        require choice == "explanations"
    } then {
        choice = none
    }
    block_04CE:
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You can modify the text speed by clicking on \"OPTION\""
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You can wake Cap'n Bob by clicking on \"CRYOBOX\""
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Or load a \"Saved Game\" by clicking on \"OPTION\""
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The OPTION \"LAST\" is the \"AUTOMATIC PERMANENT SAVE\". If you forget to save, click on \"LAST\"..."
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We would like to draw your ATTENTION to certain RISKS..."
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "If you experience UNUSUAL SENSATIONS, DIZZINESS or FACIAL DISTORTION..."
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Stay CALM..."
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "It may only be a CRISIS, a SPELL, a CURSE or, at worst, a SCRAMBLED BRAIN..."
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "In which case, write to: SUPER ZEN, end of corridor, CRAZYSTONE planet, BABY1 UNIVERSE..."
    say Izwalito voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Click quick on \"HONK\". He has important information for YOU..."
    say Izwalito voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    end presentation Izwalito
}

proc hon {
    activation enabled until BOB1
    branch_presentation
    require presentation == Honk
    guard_pop
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Welcome aboard the ARK, Commander. I'm HONK, your trusted computer..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'm here to help you a lot..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "If the phone rings, just hit the \"RED BUTTON\" in front of you..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob, our revered leader, is cryonized in the CRYOBOX..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Of course you can wake Cap'n Bob and question him... But like not too often, okay?..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob knows everything... That's why he's the boss..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Our ship is currently surrounded by things called stars..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Remember, deep space is no place for night clubs!..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "If you have questions, I have all the answers..."
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Click quick on \"CRYOBOX\" Cap'n Bob is waiting..."
    say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "End of report..."
    end presentation Honk
}

proc BOB1 {
    activation enabled until scr2
    branch_flag_274f
    require presentation == Bob_Morlock
    guard_pop
    say Bob_Morlock voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Good day COMMANDER. My name is BOB, BOB MORLOCK..."
    say Bob_Morlock voice=0x01 flags=0x00 display=0x80 loop=none control=none : "If the phone rings, press the \"RED BUTTON\" on the radio to answer..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "My ears are fragile, Commander..."
    say Bob_Morlock voice=0x02 flags=0x10 display=0x80 loop=block_083D control=none : "Do you want me to explain your mission to you, Commander?" choices "yes" "no"
    when block_0834 {
        require choice == "no"
    } then {
        say Bob_Morlock voice=0x06 flags=0x08 display=0x80 loop=none control=none : "I'm going to explain it all the same... It's important..."
        choice = none
    }
    block_0834:
    when block_083D {
        require choice != "no"
    } then {
        choice = none
    }
    block_083D:
    say Bob_Morlock voice=0x01 flags=0x00 display=0x80 loop=none control=none : "I'm more than 800,000 years old... I feel ancient, Commander..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Too ancient to go looking for adventure. That's where you come in: I DON'T WANT TO DIE STUPID. I WANT TO SEE THE BIG BANG..."
    say Bob_Morlock voice=0x01 flags=0x00 display=0x80 loop=none control=none : "This ship, specially built for you, is called the ARK. It's a true marvel of technology."
    say Bob_Morlock voice=0x03 flags=0x08 display=0xA0 loop=none control=none : "Just hit the \"SPACE\" bar if you've had enough..."
    request sequence "aarche10.hnm"
    say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : ""
    request sequence "aarche20.hnm"
    say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : ""
    request sequence "aarche30.hnm"
    say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : ""
    request sequence "aarche40.hnm"
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I want to understand the world and WHERE I COME FROM... WHY I EXIST..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You and me are going to travel through SPACE and TIME, through BLACK HOLES..."
    say Bob_Morlock voice=0x01 flags=0x00 display=0x80 loop=none control=none : "And quite a few BLACK HOLES later, we'll get to the BIG BANG..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "The tough part will be finding those BLACK HOLES, Commander..."
    say Bob_Morlock voice=0x01 flags=0x00 display=0x80 loop=none control=none : "That's because BLACK HOLES are UNDETECTABLE in the universe. We'll need to make contact with ALIEN BEINGS..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You can expect to see bloodchilling WARS and astonishing PHENOMENA..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "My age dictates I sleep through most of it in the CRYOBOX. WAKE ME ONLY IN AN EMERGENCY. My time is very precious..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I have provided you with an ONBOARD COMPUTER called HONK..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "YOU THERE, HONK?"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK: Yes sir, Cap'n Bob. Present, willing and able..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Why, you hunk 'o junk... YOU WERE ASLEEP!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK: No, Cap'n Bob. I was calculating our trajectory to the black hole! I swear it on my old mother's head!"
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Your mother!! I've a good mind to short-circuit every wire in your lazy carcass! Keep an eye on him, Commander..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "GET TO WORK, HONK!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "HONK: Sure thing, Cap'n Bob... I'm crunching numbers as I speak..."
    say Bob_Morlock voice=0x09 flags=0x00 display=0x80 loop=none control=none : "I can't see a thing... Feel so weak..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "IF YOU NEED ME, WAKE ME UP..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "See you later, Commander. Or do I mean earlier? I'm cryonizing... Aaaahhhh!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "The old turkey's out for the count..."
    say Bob_Morlock voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    run_profile 0x02
    end presentation Bob_Morlock
}

proc scr2 {
    activation enabled until block_0C0B
    require Honk.encounter_count == 0x0001
    require Bob_Morlock.encounter_count == 0x0001
    guard_pop
    run_profile 0x02
    block_0C0B:
    halt
}
