proc zen6 {
    activation enabled until beta1
    branch_gameflag
    require presentation == Super_Zen
    require painting.holder == Super_Zen
    require arche.current_location == Crazystone
    guard_pop
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, I think he's meditating..."
    when block_2577 {
        require hat.holder == aboard
    } then {
        say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Welcome friend|... How can I help you?"
        say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't we give him Eviscerator's hat|, Commander|... He might give us some information..."
        say Super_Zen voice=0xFF flags=0x10 display=0x80 loop=block_2577 control=none : "TELEPORT HAT TO SUPER ZEN" choices "teleport" "refuse"
        when block_255D {
            require choice == "teleport"
        } then {
            say Super_Zen voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING HAT TO SUPER ZEN"
            transfer hat from aboard to Super_Zen
            choice = none
        }
        block_255D:
        when block_2577 {
            require choice == "refuse"
        } then {
            say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's your decision, Commander..."
            choice = none
        }
    }
    block_2577:
    when block_270F {
        require hat.holder == Super_Zen
    } then {
        say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "OOOh... A hat|..."
        say Super_Zen voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Uuh! Bad vibrations... I sense fury and noisy..."
        say Super_Zen voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I sense pain, blood and tears..."
        say Super_Zen voice=0x03 flags=0x00 display=0x80 loop=none control=none : "I see... Ha|!!! A planet|... Big ships|..."
        say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "The planet is called..."
        say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's gonna say it, Commander|... I can feel it..."
        say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "The planet is called..."
        say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Okay... Cut the suspense!!!"
        say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "MASTA..."
        say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "MASTACHOK... I knew it, Commander|..."
        say Super_Zen voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Not Mastachok! MASTA. Coordinates x564 y098..."
        Masta.in_play = true
        say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!! Got it... MASTA... What kind of a name is that for a planet|..."
        say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Time to make tracks, Commander|..."
        say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You did good, Mister Zen. Thanks a zill..."
        say Super_Zen voice=0x04 flags=0x00 display=0x80 loop=none control=none : "So long, my friends... I must travel for some time now|..."
        say Super_Zen voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
        Super_Zen.current_location = Trashlando
        end presentation Super_Zen
    }
    block_270F:
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We'll come back later..."
    say Super_Zen voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    end presentation Super_Zen
}

proc beta1 {
    activation enabled until beta2
    branch_gameflag
    require arche.current_location == Attrox
    require presentation == Betakam
    guard_pop
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Welcome to the planet Attrox|, stranger|..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I am Betakam IV, king of the PATAGOS..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You see the sun up in the sky? It is named GLADIS..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Its heat warms the PATAGOS..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Super Zen spoke to me of you! Some story about a CURSE!!"
    say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, this is rich... We have that guy's mummy in the Ark!"
    say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I'd like to wake up Mister Beauregard. He's the only one who can explain some of this..."
    say Betakam voice=0xFF flags=0x30 display=0x80 loop=block_28E3 control=none : "Is that okay with you|, Commander|?" choices "accept" "refuse"
    when block_28A6 {
        require choice == "accept"
    } then {
        choice = none
    }
    block_28A6:
    when block_28E3 {
        require choice == "refuse"
    } then {
        say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You're the bossman, Commander..."
        say Betakam voice=0xFF flags=0x28 display=0x90 loop=none control=none : "But I have a feeling we're out of our depth here|..."
        choice = none
        end presentation Betakam
    }
    block_28E3:
    say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ok, Commander... Mister Beauregard, wakey wakey!"
    say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Yes... I'm here|..."
    request sequence "hboc.hnm"
    say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We're in the middle of a conversation with king Betakam|..."
    say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "You're here, Betakam??? I can hardly believe it... I spent years studying your civilization..."
    request sequence "hboc.hnm"
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Commander how about teleporting his mummy, perhaps it would please him..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "What are you doing? You're going to seriously traumatize the poor guy!"
    say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Betakam... We know your sun Gladis is going to explode and all your descendants will perish..."
    request sequence "hboc.hnm"
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "How amusing... You realize of course that nobody can predict the future!"
    say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Oh yes they can!!! Betakam, we know the future... That's where we come from..."
    request sequence "hboc.hnm"
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "From the future, eh? I suppose you forgot to bring proof..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Teleport him some technological gadget, Commander|..."
    say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I know|, Commander... The Mind Scrambler!"
    say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Excellent idea, Mister Honk!!!"
    request sequence "hboc.hnm"
    say Betakam voice=0xFF flags=0x10 display=0x80 loop=block_2B13 control=none : "TELEPORT MIND SCRAMBLER TO KING BETAKAM IV" choices "teleport" "refuse"
    when block_2AF1 {
        require choice == "teleport"
    } then {
        say Betakam voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING MIND SCRAMBLER"
        transfer scrambler from aboard to Betakam
        choice = none
    }
    block_2AF1:
    when block_2B13 {
        require choice == "refuse"
    } then {
        say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "If that's the way you want it, Commander..."
        choice = none
    }
    block_2B13:
    when block_2BF3 {
        require scrambler.holder == Betakam
    } then {
        say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "What an intriguing device... I'm beginning to believe you|..."
        say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Okay, Mister Betakam, what we can do is try to find a viable planet for you|..."
        say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "We're gonna teleport and transport you|..."
        request sequence "hboc.hnm"
        say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "All right..."
        say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Nice and easy, Commander|... This is all new to him..."
        say Betakam voice=0xFF flags=0x10 display=0x80 loop=block_2BF3 control=none : "TELEPORT BETAKAM IV TO CRYOBOX" choices "teleport"
        when block_2BF3 {
            require choice == "teleport"
        } then {
            say Betakam voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORTING BETAKAM IV TO ARK"
            Betakam.current_location = aboard
            choice = none
            end presentation Betakam
        }
    }
    block_2BF3:
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I don't know about you|, but I have some murffalo meat in the oven..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "See you soon..."
    end presentation Betakam
}

proc beta2 {
    activation enabled until beta3
    branch_flag_274f
    require presentation == Betakam
    guard_pop
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Did you find a planet?"
    when block_2CEE {
        require arche.current_location == Sat
    } then {
        say Betakam voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We're on a fine planet|... An abandoned Croolis base..."
        say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "All right... leave me on Sat... The murffalo intestines are favorable..."
        say Betakam voice=0xFF flags=0x10 display=0x80 loop=block_2CEE control=none : "TELEPORT BETAKAM TO SAT" choices "teleport"
        when block_2CEE {
            require choice == "teleport"
        } then {
            say Betakam voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORTING BETAKAM TO PLANET SAT"
            Betakam.current_location = Sat
            choice = none
            end presentation Betakam
        }
    }
    block_2CEE:
    when beta3 {
        require arche.current_location != Sat
    } then {
        say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "That planet doesn't have good vibrations|..."
        say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "The murffalo intestines are not favorable..."
        say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "I don't wish to go there|..."
        end presentation Betakam
    }
}

proc beta3 {
    activation enabled until st1
    branch_gameflag
    require presentation == Betakam
    require arche.current_location == Sat
    guard_pop
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "It's not bad... I'm enjoying it..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Makes a change..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "It's more up to date, you know?|... Stinks of oil..."
    say Betakam voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Well, I have to go read the murffalo intestines..."
    say Betakam voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Bye, friends..."
    end presentation Betakam
}

proc st1 {
    activation enabled until sin1
    branch_gameflag
    require presentation == Super_Tromp
    require arche.current_location == Vista
    guard_pop
    say Super_Tromp voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Welcome to the planet Vista, stranger|..."
    say Super_Tromp voice=0x01 flags=0x08 display=0x80 loop=none control=none : "How may I help you?"
    Super_Tromp.topic = "talk"
    say Super_Tromp voice=0x02 flags=0x48 display=0x80 loop=none control=none : "You're leaving? See you again, stranger|..." choices "bye_bye"
    end presentation Super_Tromp
    when sin1 {
        require state[0x151E] == 0x0001
    } then {
        say Super_Tromp voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You wish to visit the tomb of the Great Yolk?"
        say Super_Tromp voice=0x03 flags=0x08 display=0x80 loop=none control=none : "Enter with respect... This is a sacred place..."
        record_state 0xC1 orxx.action 0x0C7A 0
    }
}

proc sin1 {
    activation enabled until clay1
    branch_gameflag
    require arche.current_location == Vista
    require presentation == Sinox
    guard_pop
    say Sinox voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Shhh... Do not make noise, stranger|..."
    say Sinox voice=0x01 flags=0x00 display=0x80 loop=none control=none : "For ten centuries, the Great Yolk has rested in peace in this mausoleum..."
    say Sinox voice=0x02 flags=0x00 display=0x80 loop=none control=none : "The mausoleum was built by Jeph d'Ulikan, who defeated the Black Larsen Hordes in the year 453765..."
    say Sinox voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You may light a murffalo grease candle. It will bring you good fortune..."
    say Sinox voice=0xFF flags=0x10 display=0x80 loop=block_2F6C control=none : "LIGHT A CANDLE..." choices "accept" "refuse"
    when block_2F50 {
        require choice == "accept"
    } then {
        say Sinox voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Your candle will burn for three years..."
        choice = none
    }
    block_2F50:
    when block_2F6C {
        require choice == "refuse"
    } then {
        say Sinox voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You're wasting a fine opportunity..."
        choice = none
    }
    block_2F6C:
    say Sinox voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You cannot see the portrait of the Great Yolk|, painted with his own yellow blood..."
    say Sinox voice=0x00 flags=0x00 display=0x80 loop=none control=none : "It is currently being restored not far from here|..."
    say Sinox voice=0x07 flags=0x00 display=0x80 loop=none control=none : "The painting is magical... It gives its possessor Wisdom and Strength..."
    say Sinox voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Thousands of Tromps died to preserve the masterpiece..."
    say Sinox voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Legend says the painting's yellow blood becomes liquid every 100,000 years..."
    say Sinox voice=0x02 flags=0x00 display=0x80 loop=none control=none : "That date has not yet come, unfortunately... So we don't know if the story is true..."
    say Sinox voice=0x03 flags=0x00 display=0x80 loop=none control=none : "The visit is now over..."
    say Sinox voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Goodbye, space pilgrim... May the Great Yolk go with you|..."
    say Sinox voice=0x01 flags=0x08 display=0x90 loop=none control=none : "..."
    Sinox.current_location = Trashlando
    end presentation Sinox
}

proc clay1 {
    activation enabled until clay2
    branch_flag_274f
    require !Vista.in_play
    require presentation == Anna_Haf
    guard_pop
    say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Anna_Haf voice=0xFF flags=0x10 display=0x80 loop=clay2 control=none : "BROKEN ROBOT" choices "bye_bye"
    when clay2 {
        require choice == "bye_bye"
    } then {
        say Anna_Haf voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
        end presentation Anna_Haf
        choice = none
    }
}

proc clay2 {
    activation enabled until clay1bis
    branch_flag_274f
    require Vista.in_play
    require presentation == Anna_Haf
    guard_pop
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I've got him fixed, Commander|... His name's Sighs Ate Anna Haf..."
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "His multiplexors are shot to hell..."
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Hello Mister Haf. You may now address our onboard comander..."
    say Anna_Haf voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Hello, Commander... I am Robot Sighs Ate Anna Haf..."
    say Anna_Haf voice=0x01 flags=0x00 display=0x80 loop=none control=none : "I am descended from the noble Anna Haf family, naturally..."
    say Anna_Haf voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Alas, I fell upon hard times..."
    say Anna_Haf voice=0x03 flags=0x00 display=0x80 loop=none control=none : "So I was forced to work... Burglary, mostly..."
    say Anna_Haf voice=0x04 flags=0x00 display=0x80 loop=none control=none : "If you need any burglaries done, I'm your robot!"
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'd call that somewhat rich possibility-wise. Right, Commander|?"
    say Anna_Haf voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
    clay2.enabled = false
    end presentation Anna_Haf
}

proc clay1bis {
    activation enabled until clay3
    require Vista.in_play
    require Sinox.encounter_count > 0x0000
    guard_pop
    clay1.enabled = false
    clay3.enabled = true
    clay1bis.enabled = false
}

proc clay3 {
    activation disabled until clay4
    branch_flag_274f
    require presentation == Anna_Haf
    guard_pop
    when block_32DF {
        require arche.current_location == Vista
    } then {
        say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Howzabout having Haf here snatch the portrait from Vista, Commander|?"
        say Anna_Haf voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Honk filled me in on the problem|, Commander|. An easy job..."
        say Anna_Haf voice=0xFF flags=0x10 display=0x80 loop=block_32DF control=none : "TELEPORT HAF TO PLANET VISTA" choices "teleport" "refuse"
        when block_32A4 {
            require choice == "teleport"
        } then {
            say Anna_Haf voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "TELEPORTING HAF TO PLANET VISTA"
            Anna_Haf.current_location = tombeau
            clay3.enabled = false
            choice = none
            end presentation Anna_Haf
        }
        block_32A4:
        when block_32DF {
            require choice == "refuse"
        } then {
            say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Whatever you say, Commander|..."
            say Anna_Haf voice=0x02 flags=0x08 display=0x90 loop=none control=none : "Maybe you ought to think about it, Commander|..."
            choice = none
            end presentation Anna_Haf
        }
    }
    block_32DF:
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He could help us get our hands on that painting, Commander|..."
    say Anna_Haf voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Quite true, Commander|. Honk has brought me up to speed on the situation..."
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Think about it, Commander... We just have to approach Vista and say the word to Haf..."
    say Anna_Haf voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    end presentation Anna_Haf
}

proc clay4 {
    activation enabled until clay5
    branch_gameflag
    require arche.current_location == Vista
    require presentation == Anna_Haf
    guard_pop
    say Anna_Haf voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Don't stay here, Commander|. I'll look for the painting|... There are some cases to examine..."
    say Anna_Haf voice=0x01 flags=0x00 display=0x80 loop=none control=none : "See you later, Commander|..."
    say Anna_Haf voice=0x02 flags=0x08 display=0x90 loop=none control=none : "Bye bye|... Leave now and let me do my job..."
    Anna_Haf.in_play = true
    end presentation Anna_Haf
}

proc clay5 {
    activation enabled until clay6
    branch_presentation
    require presentation == Anna_Haf
    guard_pop
    when block_3460 {
        require arche.current_location != Vista
    } then {
        say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "KKKKK hello... KKKK RRR... KRUIK... KRUAK..."
        say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sighs Ate Anna Haf here. This is a lousy line, Commander..."
        say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We're too far away. We'll need to get closer to the planet Vista.."
        say Anna_Haf voice=0xFF flags=0x08 display=0x80 loop=none control=none : "KL KL KL KRUIKKKk..."
        end presentation Anna_Haf
    }
    block_3460:
    when clay6 {
        require arche.current_location == Vista
    } then {
        say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Is that you|, Commander|? You're coming in loud and clear..."
        say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I found the painting|. It's protected by a sophisticated security system..."
        say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I can take care of it, Commander|... I'll get back to you when I've finished..."
        say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Until then, just let me work in peace|..."
        say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "KRUIKK..."
        say Anna_Haf voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "..."
        Anna_Haf.in_play = false
        state_array_set 0x07 0x003C
        clay5.enabled = false
        end presentation Anna_Haf
    }
}

proc clay6 {
    activation enabled until clay7
    state_array_test 0x07
    guard_pop
    queue presentation Anna_Haf
    clay7.enabled = true
    clay6.enabled = false
}

proc clay7 {
    activation disabled until clay8
    branch_presentation
    require Anna_Haf.current_location == tombeau
    require presentation == Anna_Haf
    guard_pop
    say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Come in|, Commander|... I'VE GOT THE PORTRAIT OF THE GREAT YOLK!"
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!! Commander, he did it!"
    say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You better come get me|... I don't want to hang around here..."
    say Anna_Haf voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Hurry, Commander..."
    say Anna_Haf voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Kruikkk..."
    clay4.enabled = false
    Anna_Haf.in_play = false
    end presentation Anna_Haf
}

proc clay8 {
    activation enabled until clay9
    branch_gameflag
    require presentation == Anna_Haf
    guard_pop
    say Anna_Haf voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Come in|, Commander|... I'VE GOT THE PORTRAIT OF THE GREAT YOLK!"
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!! Commander, he did it!"
    say Anna_Haf voice=0xFF flags=0x10 display=0x80 loop=block_3637 control=none : "TELEPORT PAINTING TO ARK" choices "teleport"
    when block_3637 {
        require choice == "teleport"
    } then {
        say Anna_Haf voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING PAINTING TO ARK"
        transfer painting from Anna_Haf to aboard
        choice = none
    }
    block_3637:
    say Anna_Haf voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Teleport me, Commander|. Hurry..."
    say Anna_Haf voice=0xFF flags=0x10 display=0x80 loop=clay9 control=none : "Teleport him|, Commander..." choices "teleport"
    when clay9 {
        require choice == "teleport"
    } then {
        say Anna_Haf voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORT HAF TO ARK"
        Anna_Haf.current_location = aboard
        choice = none
        end presentation Anna_Haf
    }
}

proc clay9 {
    activation enabled until masta1
    branch_flag_274f
    require presentation == Anna_Haf
    guard_pop
    say Anna_Haf voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Hello, Commander... I'm sleeping real well..."
    say Anna_Haf voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Just call if you need me|..."
    say Anna_Haf voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Nite nite..."
    end presentation Anna_Haf
}

proc masta1 {
    activation enabled until masta2
    branch_gameflag
    require presentation == Rotator
    guard_pop
    say Rotator voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Halt! Who goes there? I am ROTATOR, second class Croolis ventriloquist..."
    say Rotator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Careful, stranger|. Don't try anything... My laser-pulper could do bad things to your body..."
    say Rotator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Rotator's laser-pulper is set to maximum pulp position..."
    say Rotator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, this could be tricky... I'm scared..."
    say Rotator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "My chief will want to see you|... Your toes will be toasted and your eardrums punctured in several places..."
    say Rotator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Your limbs will be reduced to paste texture. Your nose will be removed, your skin peeled off..."
    say Rotator voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You will be required to eat your teeth... repeatedly..."
    say Rotator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Co Co... Commander... Maybe this isn't such a good place to be..."
    say Rotator voice=0xFF flags=0x08 display=0x90 loop=none control=none : "The CHIEF is waiting..."
    record_state 0xC1 orxx.action 0x0BA8 0
    masta1.enabled = false
}

proc masta2 {
    activation enabled until masta6
    branch_gameflag
    require presentation == Outrageor
    guard_pop
    say Outrageor voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Enter, Commander|... Surprised that I call you Commander|???"
    say Outrageor voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Our radar has been tracking you for some time|..."
    say Outrageor voice=0x02 flags=0x00 display=0x80 loop=none control=none : "We know you visited the Tromps... I've sent a full report to General EVISCERATOR..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This is serious, Commander|. These folks are using this base to prepare for war!"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "THEY 'RE BUILDING MORNING OILS!!!"
    say Outrageor voice=0x03 flags=0x00 display=0x80 loop=none control=none : "We're going to eliminate you|... WE KNOW YOU POSSESS THE CROOLIS WAR TREASURE..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What? We don't have any such thing!"
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Excuse me, Commander|... But I'm having trouble getting to sleep|..."
    request sequence "hboc.hnm"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This isn't a good moment, Mister Beauregard|..."
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "I have something on my conscience... Something I have to confess to you|..."
    request sequence "hboc.hnm"
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "The treasure... Commander|... EVISCERATOR's treasure... You see, I found it, Commander..."
    request sequence "hboc.hnm"
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "It's... IN THE MUMMY..."
    request sequence "hboc.hnm"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh boy That wasn't the smartest thing you ever did, Mister Beauregard..."
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Well, I did intend telling you|..."
    request sequence "hboc.hnm"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Looks like we'd better hand over the mummy|, Commander|..."
    say Outrageor voice=0x05 flags=0x00 display=0x80 loop=none control=none : "If you've quite finished your nice little conversation... I'd like your attention..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's pretty persuasive, I find..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No problem We'll teleport you the treasure... It's safe inside a mummy..."
    say Outrageor voice=0x06 flags=0x00 display=0x80 loop=none control=none : "We know it's safe inside a mummy. We're the ones who hid it there!"
    say Outrageor voice=0xFF flags=0x10 display=0x80 loop=block_3AEE control=none : "TELEPORT MUMMY TO CROOLIS OUTRAGEOR" choices "teleport"
    when block_3AEE {
        require choice == "teleport"
    } then {
        say Outrageor voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING MUMMY TO OUTRAGEOR"
        transfer mummy from aboard to Outrageor
        choice = none
    }
    block_3AEE:
    say Outrageor voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha! Everything in its place, as I always say..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "LET MISTER MAXXON GO FREE..."
    say Outrageor voice=0x04 flags=0x00 display=0x80 loop=none control=none : "HA! HA! HA! I'll think about it... maybe|... Ha! Ha! Ha!"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We're dealing with an exceptionally witty Croolis here, Commander|..."
    say Outrageor voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Get out of here|... Don't let me see you again!"
    say Outrageor voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "Bye bye"
    state_array_set 0x0F 0x003C
    Outrageor.current_location = Trashlando
    Eviscerator.current_location = machine
    end presentation Outrageor
}

proc masta6 {
    activation enabled until masta3
    branch_gameflag
    require presentation == Rotator
    guard_pop
    say Rotator voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Halt! Who goes there? I am ROTATOR, second class Croolis ventriloquist..."
    say Rotator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Careful, stranger|. Don't try anything... My laser-pulper could do bad things to your body..."
    say Rotator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Rotator's laser-pulper is set to maximum pulp position..."
    say Rotator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, this could be tricky... I'm scared..."
    say Rotator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Your toes will be toasted and your eardrums punctured in several places..."
    say Rotator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Your limbs will be reduced to paste texture. Your nose will be removed, your skin peeled off..."
    say Rotator voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You will be required to eat your teeth... repeatedly..."
    say Rotator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Co Co... Commander... Maybe this isn't such a good place to be..."
    say Rotator voice=0x05 flags=0x08 display=0x90 loop=none control=none : "BAAAOOOM..."
    request sequence "explo3.hnm"
    end presentation Rotator
}

proc masta3 {
    activation enabled until masta4
    state_array_test 0x0F
    guard_pop
    queue presentation Eviscerator
    masta4.enabled = true
    masta3.enabled = false
}

proc masta4 {
    activation disabled until jer1
    branch_presentation
    require state[0x1520] == state[0x1522]
    guard_pop
    say Eviscerator voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Come in|, Commander!!! This is General EVISCERATOR|..."
    say Eviscerator voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I'm mad as mad can be, Commander|... Your mummy has laid a CURSE on us|..."
    say Eviscerator voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We're all sick... having nightmares... We see mummies all over the place... Even on TV..."
    say Eviscerator voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You win..."
    say Eviscerator voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We're letting MAXXON go..."
    say Eviscerator voice=0xFF flags=0x00 display=0x80 loop=none control=none : "He's a prisoner on a ship called the KUKARACHA. Coordinates x231 y654|..."
    say Eviscerator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander!!! Whaddaya say!!! We're getting MAXXON back!!"
    say Eviscerator voice=0xFF flags=0x00 display=0x80 loop=none control=none : "In return, you take the CURSE off of us|..."
    say Eviscerator voice=0xFF flags=0x00 display=0x80 loop=none control=none : "OK?... We're waiting..."
    say Eviscerator voice=0xFF flags=0x08 display=0x90 loop=none control=none : "KRUIIK"
    Kukaracha.in_play = true
    end presentation Eviscerator
}

proc jer1 {
    activation enabled until jer2
    require Kukaracha.in_play
    guard_pop
    queue presentation Jerry_Khan
    jer2.enabled = true
    jer1.enabled = false
}

proc jer2 {
    activation disabled until kuka1
    branch_presentation
    require presentation == Jerry_Khan
    guard_pop
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Come in Commander|... This is Inspector Jerry Khan..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Do you have any news?"
    say Jerry_Khan voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sure do, Inspector. We know where Maxxon is|... On a ship called Kukaracha..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Good work!!! Kukaracha... I'll send Yoko to pick up his father|..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "See you|..."
    say Jerry_Khan voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "KRUIIK"
    Yoko.current_location = Kukaracha
    Jerry_Khan.in_play = false
    jer2.enabled = false
    end presentation Jerry_Khan
}

proc kuka1 {
    activation enabled until yoo
    branch_gameflag
    require presentation == Yoko
    require arche.current_location == Kukaracha
    guard_pop
    say Yoko voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me happy see you|, Commander|..."
    say Yoko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Hurry, I want see father MAXXON..."
    request sequence "aready30.hnm"
    say Yoko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Behind that door..."
    request sequence "aready40.hnm"
    say Yoko voice=0xFF flags=0x30 display=0x80 loop=yoo control=none : "Teleport them, Commander, quick..." choices "teleport"
    when yoo {
        require choice == "teleport"
    } then {
        say Yoko voice=0xFF flags=0x08 display=0xC0 loop=none control=none : "TELEPORTING MAXXON AND YOKO TO ARK"
        Maxxon.current_location = aboard
        Yoko.current_location = aboard
        Kukaracha.in_play = false
        choice = none
        end presentation Yoko
    }
}

proc yoo {
    activation enabled until maxo
