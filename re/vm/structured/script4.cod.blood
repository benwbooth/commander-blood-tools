proc what {
    activation enabled until boba1
    branch_presentation
    require presentation == Honk
    guard_pop
    say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Bye bye|, Commander|..."
    end presentation Honk
}

proc boba1 {
    activation enabled until augmen
    branch_flag_274f
    require presentation == Bob_Morlock
    guard_pop
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "What do you want, Commander?"
    Bob_Morlock.topic = "talk"
    say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    state_array_set 0x01 0x001E
    when block_4E48 {
        state_array_test 0x01
    } then {
        say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I feel awful, Commander|..."
        say Bob_Morlock voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ahhhh!!!"
        say Bob_Morlock voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
        state_array_set 0x01 0xFFFF
        end presentation Bob_Morlock
    }
    block_4E48:
    say Bob_Morlock voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I feel weak|..." choices "bye_bye"
    state[0x1526] = 0x0001
    when augmen {
        require state[0x1526] == 0x0001
    } then {
        say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "..."
        say Bob_Morlock voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
        state[0x1526] = 0x0000
        state_array_set 0x01 0xFFFF
        end presentation Bob_Morlock
    }
}

proc augmen {
    activation enabled until revel
    branch_flag_274f
    require presentation == Bob_Morlock
    require state[0x1528] == 0x0001
    require state[0x152A] == 0x0000
    guard_pop
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "By the way, Cap'n Bob sir, I have a request to make..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Olga and me want a raise... Just a few more megawatts..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "WHAT... YOU'LL HAVE TO SPEAK LOUDER... I'M GETTING A BIT DEAF COMMANDER..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WE WANT A RAISE IN MEGAWATTS!!!"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I'm feeling a bit sick, Commander|. Aaah!!! It's my heart...."
    say Bob_Morlock voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Heart my foot... he means his power generator. They're all the same... You just have to say the word raise."
    state[0x152A] = 0x0001
}

proc revel {
    activation enabled until block_5157
    branch_flag_274f
    require presentation == Bob_Morlock
    require state[0x152C] == 0x0001
    require state[0x152E] == 0x0000
    guard_pop
    say Bob_Morlock voice=0x07 flags=0x00 display=0x80 loop=none control=none : "I'm going to tell you an unbearable truth, Commander:"
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch yourself off for ten seconds!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But Cap'n Bob... I..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I SAID SWITCH OFF, GOSH DARN IT!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir....."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaaaaaaaaaa!!!"
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME...."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MUCH MORE THAN A SON TO ME..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We're the same person... I am the first self-creating being!"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Thanks to space-time contortion, I can relive my youth: YOU ARE BOB, COMMANDER..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am what you'll be in several hundred thousand years..."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, you can switch on..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! -&Look, I'm supposed to know everything that goes on around here!... Don't tell me you switched off Olga???"
    say Bob_Morlock voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Cut the whining and get to work..."
    state[0x152E] = 0x0001
    state[0x152C] = 0x0000
    block_5157:
    halt
}
