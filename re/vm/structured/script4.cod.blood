    guard_push block_1199 // unstructured_guard=alternate_exit
    require choice == "ga"
    guard_pop
    say Maziok voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "ga ga ga ga ga..."
    tromp1.enabled = false
    choice = none
    jump block_136E
    block_1199:
    when block_11A2 {
        require choice != "ga"
    } then {
        choice = none
    }
    block_11A2:
    say Maziok voice=0x06 flags=0x00 display=0x80 loop=none control=none : "GA|..."
    say Maziok voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I don't think he has the power of speech... And get a load of that trunk..."
    say Maziok voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Looks like a Tromp-haired rat! Ha! Ha! Ha!Ha! Ha!"
    say Maziok voice=0x05 flags=0x00 display=0x80 loop=none control=none : "What makes you think MAZIOK can't speak?"
    say Maziok voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You have no respect for custom..."
    say Maziok voice=0x07 flags=0x00 display=0x80 loop=none control=none : "When someone says GA, you have to answer GA. That's the tradition..."
    say Maziok voice=0x04 flags=0x00 display=0x80 loop=none control=none : "For generations I have said GA when soemone has said GA to me|..."
    say Maziok voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You young people have no respect for anything..."
    say Maziok voice=0x03 flags=0x00 display=0x80 loop=none control=none : "When I was young, we always said GA..."
    say Maziok voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You're weird, stranger. You look like you have the evil eye..."
    say Maziok voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Leave me|... I have things to do..."
    say Maziok voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
    tromp1.enabled = false
    end presentation Maziok
}

