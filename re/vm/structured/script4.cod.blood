        say Hom voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You good, stranger|. You did give decoder to BRATAKAS... Me LIKE you|..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He didn't try his print stunt, Commander..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Probably didn't exist at this time|..."
        say Hom voice=0x04 flags=0x10 display=0x80 loop=block_1BCE control=none : "YOU CLICK HARD? FRIEND... ME CATCH PRINT..." choices "click"
        when block_1BCE
            concept_guard "click" 0
