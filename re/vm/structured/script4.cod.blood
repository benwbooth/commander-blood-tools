    }
}

proc zen4 {
    activation enabled until zen5
    branch_gameflag
    require presentation == Super_Zen
    require painting.holder == Super_Zen
    require arche.current_location == Crazystone
    guard_pop
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "NICE MOVE, Commander..."
    say Super_Zen voice=0x05 flags=0x00 display=0x80 loop=none control=none : "If you're ready, we'll begin the disenchantment ceremony.."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Look, Commander! He's concentrating... I think..."
    say Super_Zen voice=0x09 flags=0x00 display=0x80 loop=none control=none : "ATA ATA HOGLO HULU..."
    say Super_Zen voice=0x0A flags=0x00 display=0x80 loop=none control=none : "ATA ATA HOGLO HULU..."
    say Super_Zen voice=0xFF flags=0x08 display=0x80 loop=none control=none : "HAM TOT ZAGLO HOLO HULU..."
    request sequence "tourbi.hnm"
    say Super_Zen voice=0x08 flags=0x00 display=0x80 loop=none control=none : "ATA ATA HOGLO HULU..."
    say Super_Zen voice=0xFF flags=0x08 display=0x80 loop=none control=none : "ATA ATA HOGLO HULU..."
    request sequence "momi10.hnm"
    say Super_Zen voice=0xFF flags=0x08 display=0x80 loop=none control=none : "HER TOT ZAGLO HOLO HULU..."
    request sequence "star2.hnm"
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Hey|, Commander! The curse has been lifted!"
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'll bet Mister Beauregard is happy about it..."
    say Super_Zen voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Shhh... It's not finished..."
    say Super_Zen voice=0x07 flags=0x00 display=0x80 loop=none control=none : "The curse of Betakam IV is the sneakiest curse I know..."
    say Super_Zen voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Betakam would like to meet you|..."
    say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "He can't figure out how you were cursed by his mummy|, since he's still alive..."
    say Super_Zen voice=0x01 flags=0x08 display=0x80 loop=none control=none : "You'll find him on the planet Attrox, coordinates x342 y765..."
    Attrox.in_play = true
    character_slot 0x01 "present"
    character_slot 0x02 "present"
    character_slot 0x03 "present"
    character_slot 0x04 "present"
    character_slot 0x05 "present"
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander... This is just great!"
    say Super_Zen voice=0x00 flags=0x08 display=0xB0 loop=none control=none : "Bye bye|..."
    state[0x150C] = 0x0000
    zen4.enabled = false
    Super_Zen.current_location = Trashlando
    end presentation Super_Zen
}

proc zen5 {
    activation enabled until zen6
    require painting.holder == Super_Zen
    require hat.holder == aboard
    guard_pop
