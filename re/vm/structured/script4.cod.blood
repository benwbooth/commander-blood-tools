    guard_pop
    say Maziok voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ga|..."
    say Maziok voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Hey, you know what he reminds me of? A ball of Tromp hair. Heh heh..."
    say Maziok voice=0x03 flags=0x00 display=0x80 loop=none control=none : "GA..."
