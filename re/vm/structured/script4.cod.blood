    branch_presentation
    require presentation == Honk
    require state[0x1510] > 0x0002
    require Fifi.current_location == aboard
    guard_pop
    say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Fifi wants to go to planet Malus..."
    state[0x1510] -= 0x0003
    say Honk voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Service with a smile! That's the story of my life, Commander|..."
    help5.enabled = false
