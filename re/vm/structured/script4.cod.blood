proc init
    conditional_block 0x01 bronk2
    guard_pop
    character_slot 0x02 "maledict"
    character_slot 0x03 "maledict"
    character_slot 0x04 "maledict"
    character_slot 0x05 "maledict"
    character_slot 0x01 "maledict"
    character_slot 0x06 "present"
    shared_bit_state 0xAE Ron_s00 0x0002 0
    record_wildcard 0xAF Morning_Oil_s11 0x10A6 0
    record_wildcard 0xAF Outrageor_s11 0x0BA8 0
    record_wildcard 0xAF Rotator_s11 0x0B8A 0
    record_wildcard 0xAF Maziok_s11 0x0DA6 0
    record_wildcard 0xAF Otto_Von_Smile_s11 0x0B36 0
    record_wildcard 0xAF Super_Zen_s11 0x0E1E 0
    record_wildcard 0xAF Hom_s11 0x0C44 0
    record_wildcard 0xAF Yoko_s11 0x10A6 0
    record_wildcard 0xAF Jerry_Khan_s11 0x116E 0
    record_wildcard 0xAF Fifi_s11 0x0CCE 0
    record_wildcard 0xAF Scruter_Jo_s11 0xFFFF 0
    record_wildcard 0xAF Bronko_s11 0xFFFF 0
    record_wildcard 0xAF Beauregard_s11 0xFFFF 0
    record_wildcard 0xAF Anna_Haf_s11 0xFFFF 0
    record_wildcard 0xAF scrambler_s11 0x0028 0
    record_wildcard 0xAF mummy_s11 0x0028 0
    record_wildcard 0xAF dork_s11 0x0028 0
    record_wildcard 0xAF receiver_s11 0xFFFF 0
    record_wildcard 0xAF decoder_s11 0xFFFF 0
    shared_state 0xC0 0x150C 0xF5 0xC1 0x0001
    shared_state 0xC0 0x150E 0xF5 0xC1 0x0001
    shared_state 0xC0 0x1510 0xF5 0xC1 0x0003
    poke_byte 0x0001 0x00
end proc init

proc bronk2
    conditional_block 0x01 scrujo
    branch_flag_274f
    actor Bronko_s13 blood 0
    guard_pop
    say Bronko voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me busy do onboard cooking. Me make tasty meals for Cap'n Bob..."
    say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Let him do his job, Commander|. It's about time we had something edible to eat|..."
    say Bronko voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me not have time|, Commander|..."
    say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Bronko_s13
end proc bronk2

proc scrujo
    conditional_block 0x01 recept
    branch_flag_274f
    actor Scruter_Jo_s13 blood 0
    guard_pop
    say Scruter_Jo voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
    when block_0315
        shared_state 0xC0 0x150E 0xF5 0xC1 0x0000
    then
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain to you how get BIONIUM..."
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures|..."
        say Scruter_Jo voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX once with hand."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me, Commander!!"
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX twice, you CAPTURE BIOXX on tip of your finger..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Catch him on the tip of your finger!!! Sounds easy as pie, Commander|..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to cybernetic MANTAS"
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You place BIOXX in belly of Manta..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stay stuck to MANTAS..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'd love to see that..."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes!!! BIONIUM|... I can taste it already..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We understand perfectly, Mister SCRUTER JO... Right, Commander?"
    end when block_0315
    block_0315:
    say Scruter_Jo voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say Scruter_Jo voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh! Me feel better..."
    when block_03DF
        shared_state 0xC0 0x1510 0xF2 0xC1 0x0000
    then
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work... You did succeed..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!! Commander|, remind me to tell you you're a champ..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This BIONIUM is extraordinary. My clock frequency's through the roof..."
        say Scruter_Jo voice=0xFF flags=0x28 display=0x80 loop=none control=none : "I feel even smarter... I can feel I'll be a great help to you|, Commander|..."
        shared_state 0xC0 0x150E 0xF5 0xC1 0x0001
    end when block_03DF
    block_03DF:
    when block_0468
        shared_state 0xC0 0x1510 0xF5 0xC1 0x0000
    then
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, you didn't understand the technique..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need BIONIUM, Commander|. It makes me smarter..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! You need much much BIONIUM. Ha! Ha!..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you shut up, wiseguy!!!"
    end when block_0468
    block_0468:
    say Scruter_Jo voice=0x07 flags=0x08 display=0x80 loop=none control=none : "Bye bye|, Commander|. Me return to CYBERSPACE..."
    record_clear Scruter_Jo_s13
end proc scrujo

proc recept
    conditional_block 0x01 beau
    branch_flag_274f
    actor receiver_s13 blood 0
    guard_pop
    say receiver voice=0xFF flags=0x00 display=0x80 loop=none control=none : "zzzzzzzzzz shshshshs... crak..."
    say receiver voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It won't work, Commander. We're too far away..."
    say receiver voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Krouikk..."
    record_clear receiver_s13
end proc recept

proc beau
    conditional_block 0x01 beau_055C
    branch_flag_274f
    actor Beauregard_s13 blood 0
    shared_state 0xC0 0x150C 0xF5 0xC1 0x0001
    guard_pop
    say Beauregard voice=0x17 flags=0x00 display=0x80 loop=none control=none : "AAAAAHHH. Commander|, I'm cursed..."
    say Beauregard voice=0x18 flags=0x00 display=0x80 loop=none control=none : "AAAAAAAAA!!!"
    say Beauregard voice=0x19 flags=0x00 display=0x80 loop=none control=none : "OOOOOOOO!!!"
    say Beauregard voice=0x1E flags=0x00 display=0x80 loop=none control=none : "The the CURSE|...."
    say Beauregard voice=0x1D flags=0x00 display=0x80 loop=none control=none : "hhhhhhhhhhh"
    say Beauregard voice=0x1E flags=0x00 display=0x80 loop=none control=none : "CURSE..."
    say Beauregard voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Gee, Commander|. That doesn't sound like fun...!!!"
    say Beauregard voice=0x1E flags=0x00 display=0x80 loop=none control=none : "aaaa..."
    say Beauregard voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Beauregard_s13
end proc beau

proc beau_055C
    conditional_block 0x01 beaureg
    branch_flag_274f
    actor Beauregard_s13 blood 0
    shared_bit_state 0xB0 Attrox_s00 0x0002 1
    shared_state 0xC0 0x150C 0xF5 0xC1 0x0000
    guard_pop
    say Beauregard voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ahhhh... Commander|... I feel better now|..."
    say Beauregard voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I saw the flames of hell, Commander. Not a pretty sight.."
    say Beauregard voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Honk has explained our problem, Commander. Looks like the mummy of BETAKAM IV threw a spell on us..."
    say Beauregard voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Commander|... I'd like to find the planet PATAGOS and meet king BETAKAM IV..."
    say Beauregard voice=0x05 flags=0x00 display=0x80 loop=none control=none : "It's amazing, Commander... We have his mummy aboard and yet we can meet him as a living being..."
    say Beauregard voice=0x04 flags=0x00 display=0x80 loop=none control=none : "That's a unique archeological experiment..."
    say Beauregard voice=0x05 flags=0x00 display=0x80 loop=none control=none : "According to the ancient texts from PATAGOS, Tumul translates as Attrox..."
    say Beauregard voice=0x01 flags=0x00 display=0x80 loop=none control=none : "So the thing to do is find the planet Attrox, Commander..."
    say Beauregard voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, Mister Beauregard is so amazingly intelligent..."
    say Beauregard voice=0x01 flags=0x08 display=0x80 loop=none control=none : "See you soon, Commander..."
    record_clear Beauregard_s13
end proc beau_055C

proc beaureg
    conditional_block 0x01 fif
    branch_flag_274f
    actor Beauregard_s13 blood 0
    shared_bit_state 0xAE Attrox_s00 0x0002 0
    shared_state 0xC0 0x150C 0xF5 0xC1 0x0000
    guard_pop
    say Beauregard voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ahhhh... Commander|... I feel better now|..."
    say Beauregard voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I saw the flames of hell, Commander. Not a pretty sight.."
    say Beauregard voice=0x01 flags=0x08 display=0x80 loop=none control=none : "See you soon, Commander..."
    record_clear Beauregard_s13
end proc beaureg

proc fif
    conditional_block 0x01 fif1
    branch_gameflag
    record_wildcard 0xAF arche_s11 0x0CCE 0
    actor Fifi_s13 blood 0
    guard_pop
    say Fifi voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Caa..."
    say Fifi voice=0x01 flags=0x00 display=0x80 loop=none control=none : "aake.."
    say Fifi voice=0x01 flags=0x00 display=0x80 loop=none control=none : "eat|..."
    when block_07A8
        shared_state 0xBF Fifi_s08 0xF5 0xC1 0x0001
    then
        say Fifi voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Me Fifi... Hee Hee Hee|..."
        say Fifi voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Heh heh... That guy's funny, Commander... I love his name..."
        say Fifi voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Fifi like gift"
        say Fifi voice=0x02 flags=0x00 display=0x80 loop=none control=none : "OOO! eat"
        say Fifi voice=0x00 flags=0x00 display=0x80 loop=none control=none : "After eat|, Fifi sleep..."
        say Fifi voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Hee hee hee|..."
    end when block_07A8
    block_07A8:
    say Fifi voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Me go. You bad vibrations|..."
    say Fifi voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me scared..."
    say Fifi voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, maybe we could use the Mind Scrambler..."
    say Fifi voice=0xFF flags=0x10 display=0x80 loop=block_0888 control=none : "USE MIND SCRAMBLER" choices "use" "refuse"
    when block_0802
        concept_guard "use" 0
    then
        clear_alternate_concept
    end when block_0802
    block_0802:
    when block_0888
        concept_guard "refuse" 0
    then
        say Fifi voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You're calling the shots, Commander..."
        say Fifi voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Bye bye|... Me go phone female Tromp"
        say Fifi voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Trompette live on planet Magnu... Heee! Hee|! Hee! Me like female Tromp..."
        say Fifi voice=0x01 flags=0x08 display=0x80 loop=none control=none : "Magnu be at coordinates x453 y543..."
        shared_bit_state 0xAE Magnu_s00 0x0002 0
        say Fifi voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "Bye bye..."
        poke_byte 0x06FE 0x00
        poke_byte 0x08FB 0x01
        clear_alternate_concept
        record_clear Fifi_s13
    end when block_0888
    block_0888:
    say Fifi voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Zorglu... Eta ouch..."
    load_string "brouil.hnm"
    say Fifi voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Haga...."
    say Fifi voice=0x04 flags=0x00 display=0x80 loop=none control=none : "HATA HATA..."
    say Fifi voice=0xFF flags=0x00 display=0x80 loop=none control=none : "HOGLO HOGLO..."
    say Fifi voice=0xFF flags=0x28 display=0x80 loop=none control=none : "You can interrogate him, Commander. He's ready..."
    record_wildcard 0xBC Fifi_s0F 0x0006 0
    say Fifi voice=0xFF flags=0x48 display=0x90 loop=none control=none : "Bye bye, Commander..." choices "bye_bye"
    record_wildcard 0xBC Fifi_s0F 0x075A 0
    record_clear Fifi_s13
end proc fif

proc fif1
    conditional_block 0x00 fif2
    branch_gameflag
    record_wildcard 0xAF arche_s11 0x0CCE 0
    actor Fifi_s13 blood 0
    guard_pop
    say Fifi voice=0x03 flags=0x00 display=0x80 loop=none control=none : "GA... Me Fifi... Hee Hee Hee..."
    say Fifi voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Heh heh... That guy knocks me out, Commander..."
    say Fifi voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Fifi like cake"
    say Fifi voice=0x00 flags=0x00 display=0x80 loop=none control=none : "After eat, Fifi sleep..."
    say Fifi voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Hee hee hee hee|..."
