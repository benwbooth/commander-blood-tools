        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why not give him our D.O.R.K. diploma? The one we so brilliantly earned on Cyberock..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Maybe that'll remind him of something..."
        say Hom voice=0xFF flags=0x10 display=0x80 loop=block_1C84 control=none : "TELEPORT D.O.R.K. TO HOM" choices "teleport"
        when block_1C84
