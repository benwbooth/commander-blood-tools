    guard_pop
    say Yoko voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Thank you... Thank you|... Commander..."
    say Yoko voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me happy see you|, Commander|..."
    say Yoko voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You have save my father..."
    say Yoko voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Thank you..."
    say Yoko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Thank you..."
    end presentation Yoko
}

