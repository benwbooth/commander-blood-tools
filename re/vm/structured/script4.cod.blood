    say Hom voice=0x02 flags=0x08 display=0x80 loop=none control=none : "Bye bye|... Me sleep in star dust..."
    end presentation Hom
}

proc zen1 {
    activation enabled until zen2
    branch_gameflag
    require presentation == Super_Zen
    require painting.holder != blood
    require arche.current_location == Crazystone
    guard_pop
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Shhh, Commander|. Don't disturb him..."
    say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "I sense the magic of the PATAGOS... STRONG MAGIC..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's concentrating, Commander..."
    say Super_Zen voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Magic magic... It... It's the CURSE OF THE MUMMY OF BETAKAM IV OF THE PATAGOS!!!"
    say Super_Zen voice=0x02 flags=0x00 display=0x80 loop=none control=none : "IT'S IMPOSSIBLE... HE ISN'T DEAD YET... IT'S MAGIC..."
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, the poor guy doesn't know we brought the mummy from the future. Ha! Ha! Ha!"
    say Super_Zen voice=0x03 flags=0x00 display=0x80 loop=none control=none : "How can this be?"
    say Super_Zen voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Excuse me a moment... I'm going to TELEPATH to BETAKAM to get to the bottom of this mystery|..."
    say Super_Zen voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Be silent when I telepath..."
    say Super_Zen voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Calling BETAKAM IV on the neuronal channel... Come in!"
    say Super_Zen voice=0x02 flags=0x00 display=0x80 loop=none control=none : "It's me, Super ZEN... Something incredible's just happened..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, he's telling him the story telepathically..."
    say Super_Zen voice=0xFF flags=0x00 display=0x80 loop=none control=none : "..."
    say Super_Zen voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! He thought your story was very funny|..."
    say Super_Zen voice=0x04 flags=0x10 display=0x80 loop=block_20B2 control=none : "So... How much have you got?" choices "nothing" "ship" "hope"
    when block_20A9 {
        require choice == "nothing"
    } then {
        choice = none
    }
    block_20A9:
    when block_20B2 {
        require choice != "nothing"
    } then {
        choice = none
    }
    block_20B2:
    say Super_Zen voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I see..."
    say Super_Zen voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Look... I have a mission for you|..."
    say Super_Zen voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I want you to steal the portrait of the GREAT YOLK for me|... from the planet VISTA..."
    say Super_Zen voice=0x02 flags=0x08 display=0x80 loop=none control=none : "The planet VISTA is at coordinates x453 y654|..."
    Vista.in_play = true
    say Super_Zen voice=0xFF flags=0x20 display=0x80 loop=none control=none : "How about that! He wants us to steal the painting of the GREAT YOLK!"
    say Super_Zen voice=0x03 flags=0x00 display=0x80 loop=none control=none : "When you bring me the portrait, painted in the GREAT YOLK's own yellow blood, I'll remove your curse..."
    say Super_Zen voice=0x04 flags=0x00 display=0x80 loop=none control=none : "See you soon|, my friend|..."
    say Super_Zen voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "..."
    zen1.enabled = false
    Super_Zen.current_location = Trashlando
    end presentation Super_Zen
}

proc zen2 {
    activation enabled until zen3
    require painting.holder == blood
    guard_pop
    Super_Zen.current_location = Crazystone
    zen2.enabled = false
