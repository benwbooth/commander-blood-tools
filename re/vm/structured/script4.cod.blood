proc bra1 {
    activation enabled until braz
    branch_gameflag
    require arche.current_location == Vistar
    require Hom.current_location != aboard
    require Bratakas.current_location == Vistar
    require presentation == Bratakas
    guard_pop
    when block_1828 {
        require Bratakas.encounter_count == 0x0001
    } then {
        say Bratakas voice=0x00 flags=0x00 display=0x80 loop=none control=none : "You seem to fear nothing... Why have you come to my planet, stranger?"
        say Bratakas voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Have you any idea who you're talking to? I am none other than Bratakas, terror of the planet VISTAR..."
        say Bratakas voice=0x01 flags=0x00 display=0x80 loop=none control=none : "My name strikes fear in all Tromps throughout the galaxy..."
    }
    block_1828:
    say Bratakas voice=0x02 flags=0x08 display=0x80 loop=none control=none : "How can I help you|, stranger?"
    Bratakas.topic = "talk"
    when block_18A4 {
        require state[0x151A] == 0x0001
    } then {
        say Bratakas voice=0x00 flags=0x00 display=0x80 loop=none control=none : "I know a few planets. let me see... My memory's letting me down here|..."
        say Bratakas voice=0x01 flags=0x00 display=0x80 loop=none control=none : "The planet|... I can't seem to recall..."
        say Bratakas voice=0x02 flags=0x00 display=0x80 loop=none control=none : "It'll come to me|..."
    }
    block_18A4:
    when block_192B {
        require state[0x151C] == 0x0001
        require decoder.holder != Bratakas
    } then {
        say Bratakas voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, what say we give him our old decoder... He won't pick up very much, but it might make him happy|..."
        Bratakas.topic = "rien"
        say Bratakas voice=0xFF flags=0x10 display=0x80 loop=block_192B control=none : "TELEPORT OLD DECODER TO PLANET VISTAR" choices "teleport"
        when block_192B {
            require choice == "teleport"
        } then {
            say Bratakas voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORT DECODER TO BRATAKAS"
            transfer decoder from aboard to Bratakas
            choice = none
        }
    }
    block_192B:
    when block_1A43 {
        require decoder.holder == Bratakas
        require picture.holder != blood
    } then {
        say Bratakas voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Oh|, what a nice decoder... That's quite a gift, stranger|..."
        Bratakas.topic = "rien"
        say Bratakas voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I wonder what I can offer you in exchange... What would you say to a pretty picture?"
        say Bratakas voice=0x00 flags=0x00 display=0x80 loop=none control=none : "It represents the female of your dreams. What I see is a female Trump..."
        say Bratakas voice=0x01 flags=0x00 display=0x80 loop=none control=none : "They're called ondoyants... Dream creatures|..."
        say Bratakas voice=0x00 flags=0x00 display=0x80 loop=none control=none : "This is for you|, stranger|..."
        say Bratakas voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Don't look at it too often... And don't show it to anybody..."
        say Bratakas voice=0xFF flags=0x10 display=0x80 loop=block_1A43 control=none : "TELEPORT PICTURE TO CRYOBOX" choices "teleport"
        when block_1A43 {
            require choice == "teleport"
        } then {
            say Bratakas voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORT PICTURE TO CRYOBOX"
            transfer picture from Bratakas to aboard
            Bratakas.topic = "talk"
            choice = none
        }
    }
    block_1A43:
    when block_1A62 {
        require choice == "bye_bye"
        require state[0x151C] == 0x0000
    } then {
        say Bratakas voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Bye bye|..."
        end presentation Bratakas
    }
    block_1A62:
    when braz {
        require choice == "bye_bye"
        require state[0x151C] == 0x0001
    } then {
        say Bratakas voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Bye bye|... Leaving so soon?"
        say Bratakas voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Hold on... There's someone who'd like to see you before you leave..."
        say Bratakas voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
        record_state 0xC1 orxx.action 0x0C44 0
    }
}

proc braz {
    activation enabled until bra2
    require decoder.holder == Bratakas
    require picture.holder == blood
    require Hom.current_location == aboard
    guard_pop
    Bratakas.current_location = Trashlando
}

proc bra2 {
    activation enabled until HO
    branch_gameflag
    require arche.current_location == Vistar
    require presentation == Hom
    guard_pop
    say Hom voice=0x01 flags=0x08 display=0x80 loop=none control=none : "Welcome, stranger|. My name is Hom|..."
    Hom.topic = "hello"
    say Hom voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Make yourself comfortable..."
    when block_1BEF {
        require Hom.encounter_count == 0x0001
    } then {
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BUT COMMANDER|, IT'S HOM... HE ALREADY EXISTED AT THIS TIME..."
        say Hom voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You good, stranger|. You did give decoder to BRATAKAS... Me LIKE you|..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He didn't try his print stunt, Commander..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Probably didn't exist at this time|..."
        say Hom voice=0x04 flags=0x10 display=0x80 loop=block_1BCE control=none : "YOU CLICK HARD? FRIEND... ME CATCH PRINT..." choices "click"
        when block_1BCE {
            require choice == "click"
        } then {
            say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Forget I spoke, Commander|..."
            choice = none
        }
        block_1BCE:
        say Hom voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Ohh! Nice print..."
        request sequence "scandoig.hnm"
    }
    block_1BEF:
    when block_1C84 {
        require picture.holder == blood
        require decoder.holder == Bratakas
    } then {
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, I have an idea|..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why not give him our D.O.R.K. diploma? The one we so brilliantly earned on Cyberock..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Maybe that'll remind him of something..."
        say Hom voice=0xFF flags=0x10 display=0x80 loop=block_1C84 control=none : "TELEPORT D.O.R.K. TO HOM" choices "teleport"
        when block_1C84 {
            require choice == "teleport"
        } then {
            say Hom voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING D.O.R.K. TO HOM..."
            transfer dork from aboard to Hom
            choice = none
        }
    }
    block_1C84:
    when block_1E26 {
        require dork.holder == Hom
    } then {
        say Hom voice=0x01 flags=0x00 display=0x80 loop=none control=none : "But... This be D.O.R.K... You with \"GUILD OF MEMBERS\"..."
        say Hom voice=0x02 flags=0x00 display=0x80 loop=none control=none : "But date all wrong... This date be in future... Not yet happen..."
        say Hom voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You be mysterious, friend|..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You sure got him with that slick move, Commander..."
        say Hom voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me not understand|..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We're from the FUTURE, Mister Hom!!!"
        say Hom voice=0x05 flags=0x00 display=0x80 loop=none control=none : "From the future!!!"
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We have a big ship that travels through BLACK HOLES... We're looking for the BIG BANG..."
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Crazy, huh..."
        say Hom voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Big Bang... Black holes... Big ship... You be crazy okay..."
        say Hom voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Me like that... Big Bang... Black holes..."
        say Hom voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Me want come with you|... Me have big tubular brain|..."
        say Hom voice=0x09 flags=0x08 display=0x80 loop=none control=none : "Me have CDROM in head|... Me know universe|..."
        Hom.topic = "hello"
        say Hom voice=0xFF flags=0x10 display=0x80 loop=block_1E26 control=none : "TELEPORT HOM TO ARK" choices "teleport"
        when block_1E26 {
            require choice == "teleport"
        } then {
            say Hom voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORTING HOM TO CRYOBOX"
            Hom.current_location = aboard
            choice = none
            end presentation Hom
        }
    }
    block_1E26:
    say Hom voice=0x04 flags=0x08 display=0x80 loop=none control=none : "What you want know|, friend? Me be OMNISCIENT... ME KNOW EVERYTHING..."
    Hom.topic = "hello"
    when HO {
        require choice == "bye_bye"
    } then {
        end presentation Hom
    }
}

proc HO {
    activation enabled until zen1
    branch_flag_274f
