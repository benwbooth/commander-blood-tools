proc masta2
    conditional_block 0x01 masta6
    branch_gameflag
    actor Outrageor_s13 blood 0
    guard_pop
    say Outrageor voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Enter, Commander|... Surprised that I call you Commander|???"
    say Outrageor voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Our radar has been tracking you for some time|..."
    say Outrageor voice=0x02 flags=0x00 display=0x80 loop=none control=none : "We know you visited the Tromps... I've sent a full report to General EVISCERATOR..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This is serious, Commander|. These folks are using this base to prepare for war!"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "THEY 'RE BUILDING MORNING OILS!!!"
    say Outrageor voice=0x03 flags=0x00 display=0x80 loop=none control=none : "We're going to eliminate you|... WE KNOW YOU POSSESS THE CROOLIS WAR TREASURE..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What? We don't have any such thing!"
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Excuse me, Commander|... But I'm having trouble getting to sleep|..."
    load_string "hboc.hnm"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This isn't a good moment, Mister Beauregard|..."
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "I have something on my conscience... Something I have to confess to you|..."
    load_string "hboc.hnm"
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "The treasure... Commander|... EVISCERATOR's treasure... You see, I found it, Commander..."
    load_string "hboc.hnm"
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "It's... IN THE MUMMY..."
    load_string "hboc.hnm"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh boy That wasn't the smartest thing you ever did, Mister Beauregard..."
    say Outrageor voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Well, I did intend telling you|..."
    load_string "hboc.hnm"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Looks like we'd better hand over the mummy|, Commander|..."
    say Outrageor voice=0x05 flags=0x00 display=0x80 loop=none control=none : "If you've quite finished your nice little conversation... I'd like your attention..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's pretty persuasive, I find..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No problem We'll teleport you the treasure... It's safe inside a mummy..."
    say Outrageor voice=0x06 flags=0x00 display=0x80 loop=none control=none : "We know it's safe inside a mummy. We're the ones who hid it there!"
    say Outrageor voice=0xFF flags=0x10 display=0x80 loop=block_3AEE control=none : "TELEPORT MUMMY TO CROOLIS OUTRAGEOR" choices "teleport"
    when block_3AEE
        concept_guard "teleport" 0
    then
        say Outrageor voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING MUMMY TO OUTRAGEOR"
        record_triple blood_s13 0x11FE 0x016A 0
        clear_alternate_concept
    end when block_3AEE
    block_3AEE:
    say Outrageor voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha! Everything in its place, as I always say..."
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "LET MISTER MAXXON GO FREE..."
    say Outrageor voice=0x04 flags=0x00 display=0x80 loop=none control=none : "HA! HA! HA! I'll think about it... maybe|... Ha! Ha! Ha!"
    say Outrageor voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We're dealing with an exceptionally witty Croolis here, Commander|..."
    say Outrageor voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Get out of here|... Don't let me see you again!"
    say Outrageor voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "Bye bye"
    state_array_set 0x0F 0x003C
    record_wildcard 0xAF Outrageor_s11 0x10A6 0
    record_wildcard 0xAF Eviscerator_s11 0x0BA8 0
    record_clear Outrageor_s13
end proc masta2

