proc honk1 {
    activation enabled until help1
    branch_presentation
    require presentation == Honk
    guard_pop
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I exist only to obey, Commander"
    when block_4A2A {
        require state[0x1510] == 0x0000
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, we don't have any BIONIUM|... COMMANDER|, please..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need that energy..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You must enter Scruter Jo's CYBERSPACE|..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Wake up Scruter Jo, Commander|. He's sleeping in the Cryobox..."
    }
    block_4A2A:
    when block_4A8B {
        require state[0x1510] == 0x0001
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got one dose of BIONIUM left, Commander"
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You must enter Scruter Jo's CYBERSPACE|..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I don't feel too sure of myself, Commander... I really need that energy..."
    }
    block_4A8B:
    when block_4AC6 {
        require state[0x1510] == 0x0002
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got two doses of BIONIUM left, Commander"
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You must enter Scruter Jo's CYBERSPACE|..."
    }
    block_4AC6:
    when block_4AEB {
        require state[0x1510] == 0x0003
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got three doses of BIONIUM left, Commander"
    }
    block_4AEB:
    when block_4B10 {
        require state[0x1510] == 0x0004
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got four doses of BIONIUM left, Commander"
    }
    block_4B10:
    when block_4B35 {
        require state[0x1510] == 0x0005
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got five doses of BIONIUM left, Commander"
    }
    block_4B35:
    when block_4B5A {
        require state[0x1510] == 0x0006
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got six doses of BIONIUM left, Commander"
    }
    block_4B5A:
    when block_4B7F {
        require state[0x1510] == 0x0007
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got seven doses of BIONIUM left, Commander"
    }
    block_4B7F:
    when help1 {
        require state[0x1510] == 0x0008
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got eight doses of BIONIUM left, Commander"
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You're the best, Commander|..."
    }
}

proc help1 {
    activation enabled until help2
    branch_presentation
    require presentation == Honk
    require state[0x1510] > 0x0002
    require Anna_Haf.current_location == aboard
    require painting.holder != aboard
    require painting.holder != Super_Zen
    require Vista.in_play
    guard_pop
    say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Go near Vista, and talk to Anna Haf in the cryobox..."
    state[0x1510] -= 0x0003
    say Honk voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Service with a smile! That's the story of my life, Commander|..."
    help1.enabled = false
    end presentation Honk
}

proc help2 {
    activation enabled until help3
