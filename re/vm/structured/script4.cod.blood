    guard_pop
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Come in|, Commander|... This is Inspector JERRY KHAN on the SHARK..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We're through the black hole... An amazing experience, Commander|..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WE HAVE TRAVELLED SEVERAL HUNDRED THOUSAND YEARS BACK IN TIME..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "WE ARE COORDINATES X123 y432"
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "COME AND JOIN US..."
    say Jerry_Khan voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... It's funny but I don't feel so good|..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "GOOD LUCK..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "KRUIKKK..."
    say Jerry_Khan voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "..."
    Shark.in_play = true
    Jerry_Khan.in_play = false
    jerry3.enabled = false
    end presentation Jerry_Khan
}

proc shark {
    activation enabled until tamy
    branch_gameflag
    require arche.current_location == Shark
    require presentation == Jerry_Khan
    guard_pop
    say Jerry_Khan voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Welcome aboard the Shark, Commander..."
    say Jerry_Khan voice=0x05 flags=0x00 display=0x80 loop=none control=none : "What a crazy adventure... have you visited the sector?"
    say Jerry_Khan voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I identified the planet Ron. It's RONDO in fact... Yoko's planet|..."
    say Jerry_Khan voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Wow... That's weird..."
    say Jerry_Khan voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I identified the planet Vistar..."
    say Jerry_Khan voice=0x03 flags=0x08 display=0x80 loop=none control=none : "Vistar is at coordinates x564 y987..."
    Vistar.in_play = true
    say Jerry_Khan voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Thank you Inspector..."
    say Jerry_Khan voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I'm going to start my investigation, Commander|. We'll stay in radio contact..."
    say Jerry_Khan voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Eviscerator's hiding somewhere among those stars."
    say Jerry_Khan voice=0x04 flags=0x00 display=0x80 loop=none control=none : "He mustn't be allowed to make trouble..."
    say Jerry_Khan voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Well... I wish you good luck, Commander|..."
    say Jerry_Khan voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "..."
    Shark.in_play = false
    shark.enabled = false
    tamy.enabled = true
    end presentation Jerry_Khan
}

