proc fin2 {
    activation disabled until Od_dland
    branch_presentation
    require presentation == Jerry_Khan
    guard_pop
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Come in, Commander|... This is Inspector JERRY KHAN on the SHARK..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I have good news..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I just captured Doctor Otto Von Smile..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I found the GLUXX kids..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We're going home, Commander..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I've found the Oddland black hole..."
    say Jerry_Khan voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Oddland is at coordinates x465 Y342..."
    Oddland.in_play = true
    say Jerry_Khan voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Say, Commander|... We've had quite an adventure..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "I'll see you on the other side of the black hole, Commander|..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is Morning Oil: see you soon|, Commander|..."
    say Jerry_Khan voice=0xFF flags=0x00 display=0x80 loop=none control=none : "BYE BYE COMMANDER..."
    say Jerry_Khan voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
    Od_dland.enabled = true
    end presentation Jerry_Khan
}

proc Od_dland {
    activation disabled until jerry
    record_entry 0xC6 arche.action Oddland 0
    guard_pop
    run_profile 0x05
}

