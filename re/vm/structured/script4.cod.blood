field painting.holder = painting + 0x0014 // VAR kind 0x0400, selector(s) 11
field picture.holder = picture + 0x0014 // VAR kind 0x0400, selector(s) 11
field dork.holder = dork + 0x0014 // VAR kind 0x0400, selector(s) 11
