proc boba1 enabled until augmen {
    during contact
    require presentation == Bob_Morlock
} then {
    say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    timer[1] = 30
    when {
        require timer[1] == 0
    } then {
        say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I don't feel at all well, Commander|..."
        say Bob_Morlock voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Ahhhh!!!"
        say Bob_Morlock voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
        timer[1] = disabled
        end presentation Bob_Morlock
    }
    block_8514:
    say Bob_Morlock voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I feel so weak..." choices "bye_bye"
    state[0x1440] = 0x0001
    when {
        require state[0x1440] == 0x0001
    } then {
        say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "..."
        say Bob_Morlock voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "stop"
        state[0x1440] = 0x0000
        timer[1] = disabled
        end presentation Bob_Morlock
    }
}

proc augmen enabled until revel {
    during contact
    require presentation == Bob_Morlock
    require state[0x1442] == 0x0001
    require state[0x1444] == 0x0000
} then {
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "By the way, Cap'n Bob sir, there's something I wanted to talk to you about..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Ginette and I would like a raise... Even a few megawatts would be appreciated..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "WHAT? SPEAK LOUDER... I'M GETTING A LITTLE DEAF COMMANDER..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WE WANT A RAISE!!!"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I don't feel at all well, Commander|. Aaah!!! It's my heart...."
    say Bob_Morlock voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Heart... He means his generator... They're all the same, as soon as you mention a couple of lousy megawatts..."
    state[0x1444] = 0x0001
}

proc revel enabled until block_8839 {
    during contact
    require presentation == Bob_Morlock
    require state[0x1446] == 0x0001
    require state[0x1448] == 0x0000
} then {
    say Bob_Morlock voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You want to know an unbearable truth, Commander|?"
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch yourself off for ten seconds!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Bu... But Cap'n Bob... I..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "SWITCH OFF I SAID!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Okay sir....."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaaaaaaaaaa!!!"
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME...."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MUCH MORE THAN A SON TO ME..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We're the same person... I am the first being to create himself"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And who can study himself when he was younger, all thanks to space and time. YOU ARE BOB, COMMANDER..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am who you'll become in a few hundred thousand years..."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, We've finished..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! I ought to be aware of everything that goes on here. I AM the onboard computer, aren't I?... You didn't switch off Olga I hope"
    say Bob_Morlock voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Can it and get to work!!!..."
    state[0x1448] = 0x0001
    state[0x1446] = 0x0000
    block_8839:
    halt
}
