    say Hom voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You be great traveller..."
    when {
        require Hom.encounter_count == 0x0001
    } then {
        say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WOWEE!! Commander, he's even uglier than ol' Turkeyface Bob... Ha|! Ha|! Ha|!"
        say Hom voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me HOM. Me big tube brain|. Me delighted receive you|, Commander|..."
        say Hom voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me catch your print, friend|... Me read TRUTH in print..."
        say Hom voice=0x03 flags=0x10 display=0x80 loop=block_1C00 control=none : "You click hard, friend. Me catch your print on mouse button..." choices "click" "refuse"
        when {
            require choice == "click"
        } then {
            say Hom voice=0x03 flags=0x08 display=0x80 loop=none control=none : "You not click hard enough..."
            choice = none
        }
        block_1BB1:
        when {
            require choice == "refuse"
        } then {
            say Hom voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You refuse... Me not like that... Me suspect you..."
            say Hom voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Bye bye|... Me not like you refuse..."
            say Hom voice=0x02 flags=0x08 display=0x90 loop=none control=none : "..."
            choice = none
            end presentation Hom
        }
    }
    block_1C00:
    say Hom voice=0x03 flags=0x10 display=0x80 loop=block_1C61 control=none : "You click very very hard, friend. Me catch print on mouse..." choices "click"
    when {
        require choice == "click"
    } then {
        say Hom voice=0x03 flags=0x08 display=0x90 loop=none control=none : "Ahh|! Me catch print... Ohh, you nice print..."
        request sequence "scandoig.hnm"
        choice = none
    }
    block_1C61:
    say Hom voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Ooooouh! Me see you|, friend|... You have pretty box with picture of Hom inside..."
    request sequence "kort.hnm"
    say Hom voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Me read prints. You have little mouse in hand with long long tail..."
    say Hom voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Me see keyboard... And oh! CDROM double speed. Nice hard disk... You be lucky, friend|..."
    say Hom voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Welcome to my planet, stranger..."
    say Hom voice=0x09 flags=0x00 display=0x80 loop=none control=none : "You help my Izwal friends from planet Corpo. You be nice... You must join GUILD OF MEMBERS"
    say Hom voice=0x0A flags=0x00 display=0x80 loop=none control=none : "GUILD OF MEMBERS be big cybernetic organization..."
    say Hom voice=0x03 flags=0x00 display=0x80 loop=none control=none : "To be in GUILD OF MEMBERS you must be initiated..."
    say Hom voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You know universe. You must take exam..."
    say Hom voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You go to planet CYBEROCK where be cyber university..."
    say Hom voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You take cyber studies, friend|..."
    say Hom voice=0x02 flags=0x00 display=0x80 loop=none control=none : "And you take cyber exam to be D.O.R.K., Doctor of Rare Knowledge..."
    say Hom voice=0x05 flags=0x08 display=0x80 loop=none control=none : "Cyberock be in Cyberius system, coordinates X234 Y546..."
    Cyberock.in_play = true using alternate_encoding
    say Hom voice=0xFF flags=0x20 display=0x80 loop=none control=none : "And one more planet to visit! We're going places..."
    say Hom voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Me wait for you with D.O.R.K. Doctor of Rare Knowledge diploma..."
    say Hom voice=0xFF flags=0x08 display=0x90 loop=none control=none : "Bye bye, friend|..."
    state[0x13FE] = 0x0001
    end presentation Hom
}

