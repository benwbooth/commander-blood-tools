proc INIT2
    conditional_block 0x01 scrujo
    guard_pop
    shared_bit_state 0xAE Moskito_s00 0x0002 0
    shared_bit_state 0xAE Corpo_s00 0x0002 0
    record_wildcard 0xAF decoder_s11 0xFFFF 0
    shared_bit_state 0xAE Venusia_s00 0x0002 0
    shared_bit_state 0xAE Magnus_s00 0x0002 0
    shared_bit_state 0xAE Rondo_s00 0x0002 0
    shared_bit_state 0xAE Ekatomb_s00 0x0002 0
    shared_bit_state 0xAE Erazor_s00 0x0002 0
    shared_bit_state 0xAE Kortex_s00 0x0002 0
    shared_bit_state 0xAE Mastachok_s00 0x0002 0
    shared_bit_state 0xAE Bug_Deluxe_s00 0x0002 0
    shared_bit_state 0xAE Emasculator_s00 0x0001 0
    shared_bit_state 0xAE Migrator_s00 0x0001 0
    record_wildcard 0xAF Emasculator_s11 0x1022 0
    record_wildcard 0xAF Bob_Morlock_s11 0xFFFF 0
    record_wildcard 0xAF Bronko_s11 0xFFFF 0
    record_wildcard 0xAF Morning_Oil_s11 0x1096 0
    record_wildcard 0xAF Yoko_s11 0x0FE6 0
    record_wildcard 0xAF Jerry_Khan_s11 0x0FE6 0
    record_wildcard 0xAF Maxxon_s11 0x0FE6 0
    record_wildcard 0xAF Izwalito_s11 0x0FE6 0
    record_wildcard 0xAF Hom_s11 0x0BF0 0
    record_wildcard 0xAF Otto_Von_Smile_s11 0x0FE6 0
    shared_state 0xC0 0x13EC 0xF5 0xC1 0x0001
    shared_state 0xC0 0x13EE 0xF5 0xC1 0x0003
    character_slot 0x01 "microkid"
    character_slot 0x02 "ppit"
    character_slot 0x03 "hatetv"
    character_slot 0x04 "venus"
    character_slot 0x05 "scrut"
    character_slot 0x06 "match"
    record_wildcard 0xAF Anna_Haf_s11 0x0D04 0
    poke_byte 0x0001 0x00
end proc INIT2

proc scrujo
    conditional_block 0x01 clay1
    branch_flag_274f
    actor Scruter_Jo_s13 blood 0
    guard_pop
    say Scruter_Jo voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander you go get BIONIUM in CYBERSPACE of SCRUTER JO..."
    when block_0296
        shared_state 0xC0 0x13EC 0xF5 0xC1 0x0000
    then
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain to you how get BIONIUM..."
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures..."
        say Scruter_Jo voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX once with hand."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me, Commander!!"
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX twice, you CAPTURE BIOXX on tip of your finger..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Catch him on the tip of your finger!!! Sounds easy as pie, Commander|..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to cybernetic MANTAS"
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You place BIOXX in belly of Manta..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stay stuck to MANTAS..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'd love to see that..."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes!!! BIONIUM|... I can taste it already..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We understand perfectly, Mister SCRUTER JO... Right, Commander?"
    end when block_0296
    block_0296:
    say Scruter_Jo voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say Scruter_Jo voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh! Me feel better..."
    when block_0360
        shared_state 0xC0 0x13EE 0xF2 0xC1 0x0000
    then
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work... You did succeed..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES!!! Commander|, remind me to tell you you're a champ..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This BIONIUM is extraordinary. My clock frequency's through the roof..."
        say Scruter_Jo voice=0xFF flags=0x28 display=0x80 loop=none control=none : "I feel even smarter... I can feel I'll be a great help to you|, Commander|..."
        shared_state 0xC0 0x13EC 0xF5 0xC1 0x0001
    end when block_0360
    block_0360:
    when block_03E9
        shared_state 0xC0 0x13EE 0xF5 0xC1 0x0000
    then
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander, you didn't understand the technique..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need BIONIUM, Commander|. It makes me smarter..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! You need much much BIONIUM. Ha! Ha!..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Why don't you shut up, wiseguy!!!"
    end when block_03E9
    block_03E9:
    say Scruter_Jo voice=0x07 flags=0x08 display=0x80 loop=none control=none : "Bye bye, Commander|. Me return to CYBERSPACE..."
    record_clear Scruter_Jo_s13
end proc scrujo

proc clay1
    conditional_block 0x01 clay2
    branch_gameflag
    record_wildcard 0xAF arche_s11 0x0D04 0
    shared_state 0xBF Anna_Haf_s08 0xF5 0xC1 0x0001
    guard_pop
    say Anna_Haf voice=0x01 flags=0x00 display=0x80 loop=none control=none : "..."
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Another broken-down robot, Commander|... This planet's a gold mine..."
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Let's teleport it, Commander|. You never know when these things can come in handy..."
    say Anna_Haf voice=0xFF flags=0x10 display=0x80 loop=clay2 control=none : "TELEPORT ROBOT TO ARK..." choices "teleport"
    when clay2
        concept_guard "teleport" 0
    then
        say Anna_Haf voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORTING ROBOT TO CRYOBOX"
        record_wildcard 0xAF Anna_Haf_s11 0xFFFF 0
        clear_alternate_concept
        record_clear Anna_Haf_s13
    end when clay2
end proc clay1

proc clay2
    conditional_block 0x01 got
    branch_flag_274f
    actor Anna_Haf_s13 blood 0
    guard_pop
    say Anna_Haf voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, this is one tough repair job..."
    say Anna_Haf voice=0xFF flags=0x08 display=0x80 loop=none control=none : "stop"
    record_clear Anna_Haf_s13
end proc clay2

proc got
    conditional_block 0x01 corpo1
    record_wildcard 0xAF Eviscerator_s11 0x0B1E 1
    guard_pop
    record_wildcard 0xAF Izwalito_s11 0x0E36 0
end proc got

proc corpo1
    conditional_block 0x01 t10
    branch_gameflag
    shared_state 0xC0 0x13F0 0xF5 0xC1 0x0000
    record_wildcard 0xAF arche_s11 0x0E18 0
    actor Izwalito_s13 blood 0
    guard_pop
    say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Izwalito happy to see you back, friend|..."
    say Izwalito voice=0x00 flags=0x00 display=0x80 loop=none control=none : "You know bad news?"
    say Izwalito voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Father of Yoko, Maxxon, be kidnapped..."
    say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Kidnappers want big ransom, much CREDs..."
    say Izwalito voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Me scared, friend. Me very worried. Me hide..."
    say Izwalito voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You must help Yoko... friend Commander|..."
    say Izwalito voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me think kidnapper be Croolis escaped from Mastachok jail..."
    say Izwalito voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Me hide... FEAR... FEAR..."
    say Izwalito voice=0x05 flags=0x08 display=0xA0 loop=none control=none : "Bye bye|..."
    record_wildcard 0xAF Izwalito_s11 0x0FE6 0
    record_clear Izwalito_s13
end proc corpo1

proc t10
    conditional_block 0x01 krapp
    shared_state 0xBF Tina_Burner_s08 0xF5 0xC1 0x0001
    guard_pop
    state_array_set 0x0A 0x00C8
    poke_byte 0x05DC 0x00
end proc t10

proc krapp
    conditional_block 0x01 krapp1
    state_array_test 0x0A
    guard_pop
    record_link Kran_Dobu_s13 blood 0
    poke_byte 0x05F0 0x00
end proc krapp

proc krapp1
    conditional_block 0x01 kra
    branch_presentation
    actor Kran_Dobu_s13 blood 0
    guard_pop
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is Kran Dobu, Space Knight..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Radio message to Ark|... Ha! Ha! I bet my Kraner IV flies faster than your clunker..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha! Let's meet up at point X337 Y242..."
    say Kran_Dobu voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I have a fix on his ship, Commander|..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Got the guts to race me?... Ha! Ha! Ha!|... I'm waiting..."
    say Kran_Dobu voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I suggest we ignore him..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Chicken, huh?... Ha! Ha! Ha!"
    say Kran_Dobu voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "Bye bye"
    poke_byte 0x0600 0x00
    shared_bit_state 0xB0 Kraner_s00 0x0002 0
    record_clear Kran_Dobu_s13
end proc krapp1

proc kra
    conditional_block 0x01 kra1
    branch_gameflag
    actor Kran_Dobu_s13 blood 0
    guard_pop
    say Kran_Dobu voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ha! Ha! Ha!"
    say Kran_Dobu voice=0x02 flags=0x00 display=0x80 loop=none control=none : "What a heap of reject junk... You mean that thing actually flies? Ha! Ha! Ha!"
    say Kran_Dobu voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You're not afraid..."
    say Kran_Dobu voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Okay, no more kidding... Let's race... The first who gets to, uh... Let's see..."
    say Kran_Dobu voice=0x05 flags=0x00 display=0x80 loop=none control=none : "To planet Troma! Ha! Ha! Ha!"
    say Kran_Dobu voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You have the coordinates... Planet Troma is in the TROMUS constellation x432, Y654..."
    say Kran_Dobu voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, he's gonna get trashed... There's no way he can match our suction turbos..."
    say Kran_Dobu voice=0x00 flags=0x00 display=0x80 loop=none control=none : "If you win, I'll give you my bionic guitar|... If I win, you'll give me something..."
    say Kran_Dobu voice=0x07 flags=0x00 display=0x80 loop=none control=none : "On your marks, guy..."
