    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch yourself off for ten seconds!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Bu... But Cap'n Bob... I..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "SWITCH OFF I SAID!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Okay sir....."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaaaaaaaaaa!!!"
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME...."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MUCH MORE THAN A SON TO ME..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We're the same person... I am the first being to create himself"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And who can study himself when he was younger, all thanks to space and time. YOU ARE BOB, COMMANDER..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am who you'll become in a few hundred thousand years..."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, We've finished..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! I ought to be aware of everything that goes on here. I AM the onboard computer, aren't I?... You didn't switch off Olga I hope"
    say Bob_Morlock voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Can it and get to work!!!..."
    shared_state 0xC0 0x1448 0xF5 0xC1 0x0001
    shared_state 0xC0 0x1446 0xF5 0xC1 0x0000
    block_8839:
    halt
end proc revel
