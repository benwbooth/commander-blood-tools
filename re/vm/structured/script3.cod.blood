00008679: TEXT 016A 07 00 80 - - 006A 041C 0058 0376 0676 37D4 37DF 0011 01E1 ; TEXT line=0x016A voice=0x07 flags=0x00,0x80 "You want to know an unbearable truth, Commander ?"
00008693: TEXT 016A 06 00 80 - - 0A26 05AA 37E6 1F8C 0EB6 074E 37ED 37F1 0108 ; TEXT line=0x016A voice=0x06 flags=0x00,0x80 "HONK ! Switch yourself off for ten seconds !!!"
000086AD: TEXT 016A FF 20 80 - - 37F9 009B 2973 209F 0F2D 009B 01A3 009B ; TEXT line=0x016A voice=0xFF flags=0x20,0x80 "Bu ... But Cap'n Bob ... I ..."
000086C5: TEXT 016A 05 00 80 - - 37FC 3803 01A3 3807 0108 ; TEXT line=0x016A voice=0x05 flags=0x00,0x80 "SWITCH OFF I SAID !!!"
000086D7: TEXT 016A FF 20 80 - - 0577 374B 2C0C ; TEXT line=0x016A voice=0xFF flags=0x20,0x80 "Okay sir ....."
000086E5: TEXT 016A FF 20 80 - - 380C 0108 3815 0108 ; TEXT line=0x016A voice=0xFF flags=0x20,0x80 "KRUIIIIK !!! AAAaaaaaaaaaaaaaaaaaaaaa !!!"
000086F5: TEXT 016A 05 00 80 - - 382E 0208 3839 23BA 01D1 ; TEXT line=0x016A voice=0x05 flags=0x00,0x80 "COMMANDER, YOU ARE ME ...."
00008707: TEXT 016A 06 00 80 - - 23C4 3839 2A32 383D 3842 2FA4 3848 384C 3856 009B ; TEXT line=0x016A voice=0x06 flags=0x00,0x80 "WE ARE THE SAME BEING AT TWO DIFFERENT AGES ..."
00008723: TEXT 016A 04 00 80 - - 0208 3839 385B 3860 3865 09E9 386A 03A2 23BA 009B ; TEXT line=0x016A voice=0x04 flags=0x00,0x80 "YOU ARE MUCH MORE THAN A SON TO ME ..."
0000873F: TEXT 016A 05 00 80 - - 0E67 0104 37C1 386E 009B 01A3 0833 0104 058B 1C3E 0058 3875 387C ; TEXT line=0x016A voice=0x05 flags=0x00,0x80 "We're the same person ... I am the first being to create himself"
00008761: TEXT 016A 04 00 80 - - 0A68 0591 011D 29D4 387C 037B 05FD 06EC 3884 00D0 1733 388C 0058 11DE 083C 09F0 0079 0208 3839 3893 00D0 12CB 009B ; TEXT line=0x016A voice=0x04 flags=0x00,0x80 "And who can study himself when he was younger , all thanks to space and time . YOU ARE BOB , COMMANDER ..."
00008797: TEXT 016A 02 00 80 - - 01A3 0833 0591 062B 123F 002E 00C0 0CA5 3897 389F 1EAF 009B ; TEXT line=0x016A voice=0x02 flags=0x00,0x80 "I am who you'll become in a few hundred thousand years ..."
000087B7: TEXT 016A 06 00 80 - - 08E0 0A06 00D0 33CE 38A8 009B ; TEXT line=0x016A voice=0x06 flags=0x00,0x80 "OK Honk , We've finished ..."
000087CB: TEXT 016A FF 20 80 - - 38B1 0108 38BC 0108 01A3 0AE6 0058 0081 38C9 003C 07F0 0170 1383 00E6 07B7 0079 01A3 38CF 0104 2136 38D2 38DC 01A3 01E1 009B 006A 02C5 38E3 0EB6 38EA 01A3 07E1 ; TEXT line=0x016A voice=0xFF flags=0x20,0x80 "KROIIIIkkk !!! -&KRUIIIIkkk !!! I ought to be aware of everything that goes on here . I AM the onboard computer, aren't I ? ... You didn't switch off Olga I hope"
00008813: TEXT 016A 05 08 90 - - 38EF 01AB 083C 0022 0058 0222 0108 009B ; TEXT line=0x016A voice=0x05 flags=0x08,0x90 "Can it and get to work !!! ..."
