000085CB: TEXT 016A 05 00 80 - - 25C0 01E1 377F 3785 009B 36C9 378C 09E9 3794 379B 12CB 009B ; TEXT line=0x016A voice=0x05 flags=0x00,0x80 "WHAT ? SPEAK LOUDER ... I'M GETTING A LITTLE DEAF COMMANDER ..."
000085EB: TEXT 016A FF 20 80 - - 23C4 25C5 09E9 37A0 0108 ; TEXT line=0x016A voice=0xFF flags=0x20,0x80 "WE WANT A RAISE !!!"
000085FD: TEXT 016A 04 00 80 - - 01A3 0301 0211 04DE 1733 1482 00D0 0011 0079 37A6 0108 0671 04B2 1FAA 01D1 ; TEXT line=0x016A voice=0x04 flags=0x00,0x80 "I don't feel at all well , Commander . Aaah !!! It's my heart ...."
