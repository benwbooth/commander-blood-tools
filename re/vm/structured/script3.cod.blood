    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WE WANT A RAISE!!!"
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "I don't feel at all well, Commander|. Aaah!!! It's my heart...."
    say Bob_Morlock voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Heart... He means his generator... They're all the same, as soon as you mention a couple of lousy megawatts..."
    shared_state 0xC0 0x1444 0xF5 0xC1 0x0001
end proc augmen

proc revel
    conditional_block 0x01 block_8839
