// format: bloodscript-v3
// image: BAS

object blood = 0x0028
object Bob_Morlock = 0x016A
object Bug_Deluxe = 0x01B2
object Eviscerator = 0x028A
object Morning_Oil = 0x03AA
object Bronko = 0x043A
object Beauregard = 0x05A2
object Izwalito = 0x067A
object Amigo = 0x06C2
object Scruter_Mac = 0x0752
object Tina_Burner = 0x0872
object Super_Zen = 0x08BA
object Honk = 0x0992
object Rondo = 0x0C2C
object Magnus = 0x0D04

field blood_s13 = blood + 0x0008 // VAR kind 0x0001, selector(s) 13
field Bob_Morlock_s03 = Bob_Morlock + 0x0032 // VAR kind 0x0002, selector(s) 03
field Bug_Deluxe_s13 = Bug_Deluxe + 0x003A // VAR kind 0x0002, selector(s) 13
field Rondo_s00 = Rondo + 0x0002 // VAR kind 0x0008, selector(s) 00
field Magnus_s00 = Magnus + 0x0002 // VAR kind 0x0008, selector(s) 00

yield

selector Beauregard_choices
    yield_b
    case "ill" -> selector_0165
        menu "bye_bye" "listen" "insist" "treat"
        say Beauregard voice=0x0C flags=0x41 display=0x80 loop=none control=none : "Aaaah... Eeeerrr..." choices "listen"
        say Beauregard voice=0x0D flags=0x40 display=0x80 loop=none control=none : "Aaaa! Snakes alive..." choices "bye_bye"
        say Beauregard voice=0x0E flags=0x40 display=0x80 loop=none control=none : "I got baked by Gladis|..." choices "insist"
        say Beauregard voice=0xFF flags=0x68 display=0x80 loop=none control=none : "That's criminal! Commander, we have to find this Gladis and make sure she never bakes anyone again..." choices "insist"
        presentation_register 0x1D9A
        say Beauregard voice=0x0F flags=0x48 display=0x80 loop=none control=none : "Gladis is the Tumul system's sun. It blew up..." choices "gladis"
        presentation_register 0x1D9A
        say Beauregard voice=0x10 flags=0x48 display=0x80 loop=none control=none : "Gladis killed everything. It's a miracle I'm alive... Aaarr.." choices "insist"
        presentation_register 0x1D9A
        say Beauregard voice=0x11 flags=0x40 display=0x80 loop=none control=none : "My body's burned to a cinder... I need a new body bad... Friend..." choices "treat"
        say Beauregard voice=0x12 flags=0x40 display=0x80 loop=none control=none : "My brain's intact, but the rest got fried... Up in smoke... Aaaarrr..." choices "treat"
        say Beauregard voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Don't tire him out, Commander|..." choices "treat"
        say Beauregard voice=0x13 flags=0x41 display=0x80 loop=none control=none : "Gotta have a new body..." choices "treat"
        say Beauregard voice=0x14 flags=0x01 display=0x80 loop=none control=none : "Aaaarrr"
        yield_b
        selector_0165:
    case "talk1" -> 0x0000
        menu "patagos" "betakam" "treasure" "Gladis"
        say Beauregard voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The PATAGOS were an amazing people, Commander|... They worshiped the sun Gladis..." choices "patagos"
        say Beauregard voice=0x02 flags=0x40 display=0x80 loop=none control=none : "The frescoes you see are hundreds of thousands of years old..." choices "patagos"
        say Beauregard voice=0x03 flags=0x40 display=0x80 loop=none control=none : "\"PATAGOS\" means \"HOGLOHULU\" in the Patasel cubeniform language of the 15th dynasty... Fascinating, no?" choices "patagos"
        say Beauregard voice=0x04 flags=0x40 display=0x80 loop=none control=none : "I could do with some rest on Galabar... A couple of tekno clubs, and some exotic nightlife... What am I saying?" choices "patagos"
        say Beauregard voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Betakam was a cultivated and much loved king. His poetry was exquisite, Commander" choices "betakam"
        say Beauregard voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Poem by BETAKAM IV King of the PATAGOS of TUMUL: \"HATA\"" choices "betakam"
        shared_state 0xC0 0x141C 0xF5 0xC1 0x0001
        say Beauregard voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Gladis blew up, as suns do when they get old. Happily, we don't explode at death. Not usually anyway." choices "Gladis"
        say Beauregard voice=0x02 flags=0x40 display=0x80 loop=none control=none : "I owe you my life, Commander|. This is a great body..." choices "Gladis"
        say Beauregard voice=0x03 flags=0x48 display=0x80 loop=none control=none : "The Transe Dance, those Galabar tekno clubs... Covered in perfume... What am I saying?" choices "Gladis"
        shared_state 0xC0 0x141E 0xF5 0xC1 0x0001
        say Beauregard voice=0x01 flags=0x48 display=0x80 loop=none control=none : "How Gladis must have shone..." choices "Gladis"
        shared_state 0xC0 0x1420 0xF5 0xC1 0x0001
        say Beauregard voice=0x04 flags=0x49 display=0x80 loop=none control=none : "Yes Commander, this planet is a priceless cultural treasure..." choices "treasure"
        shared_state 0xC0 0x1420 0xF5 0xC1 0x0001
        yield
end selector Beauregard_choices

selector Honk_choices
    yield_b
    case "talk" -> 0x0000
        menu "bye_bye" "help" "message"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "You're the boss, Commander|..." choices "talk"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Commander|..." choices "bye_bye"
        yield
end selector Honk_choices

selector Izwalito_choices
    yield_b
    case "talk" -> selector_03C9
        menu "hello" "talk"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Hello friend|..." choices "hello"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Talk, friend?" choices "talk"
        yield_b
        selector_03C9:
    case "talk" -> selector_03F3
        menu "bye_bye" "izwal" "food" "planet" "reproduction"
        say Izwalito voice=0x04 flags=0x43 display=0x80 loop=none control=none : "What you want, friend?" choices "talk"
        yield_b
        selector_03F3:
    case "izwal" -> selector_05F6
        menu "talk" "bye_bye" "society" "ideal" "happiness"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Izwal great pacifist people" choices "izwal"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Us live in tribe, us poor hungry people" choices "society"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Us work much, us be migrators..." choices "society"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me, Izwalito, be nephew of son of chief of tribe..." choices "society"
        say Izwalito voice=0x03 flags=0x41 display=0x80 loop=none control=none : "You talk much..." choices "society"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me dream of perfect world with much to eat..." choices "ideal"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Ideal, ideal... You like dream, friend|..." choices "ideal"
        say Izwalito voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Ideal be always far from reality: poor want be rich, rich want be poor..." choices "ideal"
        say Izwalito voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Ouch... This is getting kind of heavy, Commander|. You guys go on without me. I'm gonna sleep..." choices "ideal"
        say Izwalito voice=0x04 flags=0x48 display=0x80 loop=none control=none : "Izwals of planet Rondo be very rich... They have much CREDs" choices "ideal"
        shared_state 0xC0 0x1416 0xF5 0xC1 0x0001
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Family, children, work, food, reproduction, reproduction..." choices "happiness"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Us Izwals of Corpo not know happiness..." choices "happiness"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Izwals of planet Rondo know happiness..." choices "happiness"
        say Izwalito voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me dream of blue planet with murffalos, greenery, birds... Me dream, friend|..." choices "happiness"
        say Izwalito voice=0x03 flags=0x41 display=0x80 loop=none control=none : "You talk much..." choices "happiness"
        yield_b
        selector_05F6:
    case "knowledge" -> selector_069F
        menu "talk" "bye_bye" "rondo" "truth"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "What you want know, friend?" choices "knowledge"
        say Izwalito voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Rondo, you want know planet Rondo, friend|..." choices "rondo"
        say Izwalito voice=0x06 flags=0x48 display=0x80 loop=none control=none : "Planet Rondo be in Rondalus constellation, coordinates AX4532..." choices "rondo"
        shared_bit_state 0xB0 Rondo_s00 0x0002 0
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me not lie..." choices "truth"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Ideal be ideal..." choices "truth"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Me tell truth|, Commander" choices "truth"
        yield_b
        selector_069F:
    case "food" -> selector_079F
        menu "talk" "bye_bye" "murffalos" "grass"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Us like eat murffalos, but our planet not have murffalos. Us did eat all..." choices "food"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Izwal people be hungry. You help us, friend|..." choices "food"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Murffalo nice meat, tender..." choices "murffalos"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me dream eat roast murffalo..." choices "murffalos"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You not talk. Me be hungry, friend|..." choices "murffalos"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Hungry... Hungry..." choices "murffalos"
        say Izwalito voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me not like eat grass. Grass make head turn. Bad..." choices "grass"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Grass not grow here..." choices "grass"
        yield_b
        selector_079F:
    case "reproduction" -> selector_0873
        menu "talk" "bye_bye" "love" "female" "murffalos"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Me like reproduction..." choices "reproduction"
        say Izwalito voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me have sweetheart, hee hee hee hee...." choices "love"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "You not talk, me blush..." choices "love"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "You talk too much female, friend|..." choices "female"
        say Izwalito voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me be hungry, friend|..." choices "murffalos"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Murffalos be thirteen to reproduce. One in middle, and twelve around... Hee Hee..." choices "muffalos"
        say Izwalito voice=0x06 flags=0x41 display=0x80 loop=none control=none : "Hungry... Hungry..." choices "murffalos"
        yield_b
        selector_0873:
    case "planet" -> 0x0000
        menu "talk" "bye_bye" "ecology" "stars"
        say Izwalito voice=0x02 flags=0x43 display=0x80 loop=none control=none : "Corpo nice Izwal planet..." choices "planet"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Corpo poor planet, but nice ecology" choices "ecology"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Here nothing grow. No water. No tree. No murffalos..." choices "ecology"
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Ecology Heal The Planet \"HTP\", friend|... You know \"HLP\"?" choices "ecology"
        say Izwalito voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Stars. me like look sky..." choices "stars"
        say Izwalito voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Big starry sky. Me know Magnalus constellation" choices "stars"
        say Izwalito voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Planet magnus be in Magnalus constellation. Magnus coordinates 1234,543256 degrees... You like stars?" choices "stars"
        shared_bit_state 0xB0 Magnus_s00 0x0002 0
        say Izwalito voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Stars be big science..." choices "stars"
        yield
end selector Izwalito_choices

selector Morning_Oil_choices
    yield_b
    case "talk" -> selector_09D5
        menu "hello" "say_nothing" "laugh" "bye_bye"
        say Morning_Oil voice=0x00 flags=0x40 display=0x80 loop=none control=none : "Hi Commander" choices "hello"
        say Morning_Oil voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Such silence..." choices "say_nothing"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Ha ha ha ha ha ha..." choices "laugh"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Bye bye Commander" choices "bye_bye"
        yield_b
        selector_09D5:
    case "history" -> selector_09E9
        menu "bye_bye" "war" "croolis" "treasure" "battles" "mastachok"
        yield_b
        selector_09E9:
    case "war" -> selector_0B27
        menu "bye_bye" "match"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "That was a terrible war... It all started with a boxing match between the Croolis EVISCERATOR and EMASCULATOR..." choices "war"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You should've seen it, Commander|... Boy, was that some fight..." choices "war"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "They made BIONIUM bombs. Those things could blow up entire planets..." choices "war"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Never seen mayhem like it... BBOOOOMMM!!! POW! TA TA TA TA TA... Ha|! Ha|! Ha|!" choices "war"
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "The boxing match got out of hand. It was televised throughout the universe..." choices "match"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The war was between the Croolis Eviscerator and Emasculator... What a bloodbath..." choices "match"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The match was televised throughout the universe... I can still see it..." choices "match"
        yield_b
        selector_0B27:
    case "croolis" -> selector_0CAA
        menu "bye_bye" "history" "terror" "eviscerator" "emasculator"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "The Croolis are unbelievably warlike" choices "croolis"
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "My master EVISCERATOR was a talented BIONIUM prospector..." choices "croolis"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "He found BIONIUN in galactic cyberspace contraction..." choices "croolis"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Those Croolis are seriously deranged!!!" choices "croolis"
        say Morning_Oil voice=0x07 flags=0x40 display=0x80 loop=none control=none : "We spread terror throughout the galaxy for centuries..." choices "terror"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Terror was the Croolis secret weapon..." choices "terror"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "We robots were programmed to be fearless..." choices "terror"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Eviscerator came to a bad end. When SCRUT stopped the war, they put him in jail" choices "eviscerator"
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Eviscerator is dangerous, Commander|... A ruthless killer..." choices "eviscerator"
        say Morning_Oil voice=0xFF flags=0x68 display=0x80 loop=none control=none : "Commander...I'm worried in case the memory of his ex-master awakens his violent instincts..." choices "eviscerator"
        shared_state 0xC0 0x144A 0xF5 0xC1 0x0001
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Emasculator's not too smart... Just mean..." choices "emasculator"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "That's a Croolis I hate..." choices "emasculator"
        yield_b
        selector_0CAA:
    case "treasure" -> selector_0E1B
        menu "bye_bye" "history" "hiding_place"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Ah|! The treasure. You should have seen it, Commander|... Beyond belief..." choices "treasure"
        say Morning_Oil voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The stones of Galabar, the horns of Rla, authentic Rhinox tibia vases..." choices "treasure"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Ha|! Ha|! Hard to know where he might've hidden it, Commander|..." choices "hiding_place"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "I can give you some information but it's strictly confidential..." choices "hiding_place"
        say Morning_Oil voice=0x06 flags=0x48 display=0x80 loop=none control=none : "I don't want Honk to hear..." choices "hiding_place"
        shared_state 0xC0 0x144C 0xF5 0xC1 0x0001
        say Morning_Oil voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Millions died in the battles. Planets were stripped to the bone..." choices "battle"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "The Izwals got hit bad. They weren't ready, see..." choices "battle"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "The SCRUT armies won a battle so huge it shook the entire galaxy.." choices "battle"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "The defeated Croolis were forced back to the planet Trashlando. That's an awful place, Commander|..." choices "battle"
        yield_b
        selector_0E1B:
    case "mastachok" -> 0x0000
        menu "bye_bye" "history" "information"
        say Morning_Oil voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Mastachok is a dead planet now... Its surface is completely lifeless..." choices "mastachok"
        say Morning_Oil voice=0x06 flags=0x40 display=0x80 loop=none control=none : "The factory was replaced by a prison... SCRUT guards are permanently posted there..." choices "mastachok"
        say Morning_Oil voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Mastachok is so polluted even the deadliest waste matter hates it..." choices "mastachok"
        yield
end selector Morning_Oil_choices

selector Bug_Deluxe_choices
    yield_b
    case "department" -> selector_0EC8
        menu "beauty" "food" "sport" "handywork" "pharmacy" "leisure" "hifi"
        say Bug_Deluxe voice=0xFF flags=0x41 display=0x80 loop=none control=none : "Check out our bargains" choices "department"
        yield_b
        selector_0EC8:
    case "beauty" -> selector_0EE4
        menu "department" "perfume" "tie" "jewel"
        say Bug_Deluxe voice=0xFF flags=0x01 display=0x80 loop=none control=none : "BEAUTY:"
        yield_b
        selector_0EE4:
    case "perfume" -> selector_0F06
        menu "beauty" "eden" "dune" "kroolence" "motoroil" "turbulence"
        say Bug_Deluxe voice=0xFF flags=0x01 display=0x80 loop=none control=none : "PERFUME DEPARTMENT:"
