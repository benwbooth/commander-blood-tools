    case "turbulence" -> selector_10F3
        menu "department" "buy" "perfume"
        say Bug_Deluxe voice=0xFF flags=0x41 display=0x80 loop=none control=none : "Turbulence, gravitational vertigo. Scent for the adventurous: 1 CRED" choices "turbulence"
        say Bug_Deluxe voice=0xFF flags=0x49 display=0xA0 loop=none control=none : "You pay 1 CRED." choices "buy"
        record_triple Bug_Deluxe_s13 0x119E 0x0028 0
        record_triple blood_s13 0x1186 0x01B2 0
