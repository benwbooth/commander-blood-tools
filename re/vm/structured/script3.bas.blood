    case "war" -> selector_3559
        menu "bye_bye" "talk" "battle" "enemy" "treasure"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Ah. War nice discipline... Splat, kill all... Me like..." choices "war"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Ahhh, big fun. Explode, burn, kill kill. Ahhhh..." choices "war"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Much noise, explosions, screams. Music to Croolis ear..." choices "war"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "You talk good. me like hear you... SWEAR..." choices "war"
        say Eviscerator voice=0x0C flags=0x40 display=0x80 loop=none control=none : "Ahhh, war nice discipline. Splat much enemy" choices "war"
        say Eviscerator voice=0x02 flags=0x40 display=0x80 loop=none control=none : "War nice party: break, shoot, kill, squash" choices "war"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Noise, explosion, pain, fear, kill all. Aaah, me like... INSULT" choices "war"
        say Eviscerator voice=0x0A flags=0x40 display=0x80 loop=none control=none : "Me want splat you. Laugh laugh swear. INSULT..." choices "war"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "You excite me. Mouth water now. Aaahrgghhhhh..." choices "war"
        say Eviscerator voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Me big warrior, friend. Me big Croolis chief... You help me..." choices "battle"
        say Eviscerator voice=0x0B flags=0x40 display=0x80 loop=none control=none : "Me like squash your head... LAUGH LAUGH... INSULT... SWEAR..." choices "battle"
        say Eviscerator voice=0x09 flags=0x41 display=0x80 loop=none control=none : "Me destroy and splat enemy... Me like enemy, friend|..." choices "enemy"
        say Eviscerator voice=0x08 flags=0x40 display=0x80 loop=none control=none : "You talk treasure. If you know treasure, you know Morning Oil" choices "treasure"
        say Eviscerator voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Morning Oil alone know treasure exist... You know that stupid machine?" choices "treasure"
        shared_state 0xC0 0x1416 0xF5 0xC1 0x0001
        yield_b
        selector_3559:
    case "secrets" -> 0x0000
        menu "bye_bye" "talk" "secret"
        say Eviscerator voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me trust..." choices "secrets"
        say Eviscerator voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Treasure! You know treasure???" choices "secret"
        say Eviscerator voice=0x06 flags=0x48 display=0x80 loop=none control=none : "Me tell you where treasure be if you bring me SPLATCH" choices "secret"
        shared_state 0xC0 0x1418 0xF5 0xC1 0x0001
