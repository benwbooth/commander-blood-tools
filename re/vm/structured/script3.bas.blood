selector Amigo_choices
    yield_b
    case "talk" -> selector_38A4
        menu "Eviscerator" "Tina_Burner" "Purple_Haze"
        say Amigo voice=0x01 flags=0x40 display=0x80 loop=none control=none : "My time is precious, stranger..." choices "talk"
        say Amigo voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Like I always say: heard nothing, seen nothing..." choices "talk"
        say Amigo voice=0x03 flags=0x41 display=0x80 loop=none control=none : "What do you want to know?" choices "talk"
        say Amigo voice=0x05 flags=0x41 display=0x80 loop=none control=none : "Ha!!! That old bag..." choices "Tina_Burner"
        say Amigo voice=0x05 flags=0x40 display=0x80 loop=none control=none : "At the PURPLE HAZE the client always pays.... Ha! Ha! Ha!" choices "Purple_Haze"
        say Amigo voice=0x06 flags=0x40 display=0x80 loop=none control=none : "The Purple Haze is the classiest club in the galaxy..." choices "Purple_Haze"
        yield_b
        selector_38A4:
    case "Eviscerator" -> selector_39EE
        menu "bye_bye" "talk" "prison" "Galabar" "meteorut"
        say Amigo voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Poor old Eviscerator has been a prisoner for ages on the planet MASTACHOK" choices "prison"
        say Amigo voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The prison on MASTACHOK is attack proof and escape proof. It's permanently guarded by SCRUT robots|..." choices "prison"
        say Amigo voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Life ain't easy, stranger..." choices "prison"
        say Amigo voice=0x03 flags=0x40 display=0x80 loop=none control=none : "BA LA GAR LA GA BAR... You can speak KRWITT! You're an educated guy, stranger..." choices "Galabar"
        say Amigo voice=0x05 flags=0x40 display=0x80 loop=none control=none : "I picked up a few words of KRWITT on GOLGOS, while I was doing my barman studies..." choices "Galabar"
        say Amigo voice=0x03 flags=0x40 display=0x80 loop=none control=none : "My first wife GALA spoke fluent KRWITT. Her father came from GLUXXTAN" choices "Galabar"
        say Amigo voice=0x04 flags=0x40 display=0x80 loop=none control=none : "GALA was very sensual. She got cut up by a migrax... Tough..." choices "Galabar"
        say Amigo voice=0x04 flags=0x40 display=0x80 loop=none control=none : "I'm obsessed with meteorut, stranger...." choices "meteorut"
        yield_b
        selector_39EE:
    case "meteorut" -> selector_3ACC
        menu "bye_bye" "talk" "acidium" "nitrium" "glycérium"
        say Amigo voice=0x05 flags=0x40 display=0x80 loop=none control=none : "When I start to itch right there... I know the fever's coming... I tried Aspirox, but it didn't help..." choices "meteorut"
        say Amigo voice=0x02 flags=0x40 display=0x80 loop=none control=none : "The only thing that works against meterorut is acidium, stranger..." choices "acidium"
        say Amigo voice=0x04 flags=0x40 display=0x80 loop=none control=none : "My first wife, GALA, could cure meteorut without acidium. She used white hot blades..." choices "acidium"
        say Amigo voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Nitrium is dangerous if you mix it with glycerium..." choices "nitrium"
        say Amigo voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Glycerium is real dangerous when you mix it with nitrium..." choices "glycerium"
        yield_b
        selector_3ACC:
    case "acidium" -> selector_3AFE
        menu "bye_bye" "talk" "pentium"
        say Amigo voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Pentium is a mixture of glycerium, nitrium and processed Trump liver" choices "pentium"
        yield_b
        selector_3AFE:
    case "pentium" -> 0x0000
        menu "bye_bye" "talk" "splatch"
        say Amigo voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Splatch is a mixture of pentium, acidium and processed murffalo liver" choices "splatch"
        say Amigo voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You want splatch? Why didn't you say so?" choices "splatch"
        say Amigo voice=0x01 flags=0x48 display=0x80 loop=none control=none : "I happen to have some..." choices "splatch"
        shared_state 0xC0 0x1416 0xF5 0xC1 0x0001
        yield
end selector Amigo_choices

