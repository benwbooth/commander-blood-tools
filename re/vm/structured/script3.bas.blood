selector Bronko_choices
    yield_b
    case "talk" -> selector_1F5D
        menu "bye_bye" "robot" "cred" "murffalos" "weapons"
        yield_b
        selector_1F5D:
    case "robot" -> selector_2101
        menu "talk" "bye_bye" "robot" "intelligence" "energy" "technology" "retirement"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me robot Bronko AX34 BUTCHER model..." choices "robot"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Robots be strong, friend. Robot Bronko know chop meat..." choices "robot"
        say Bronko voice=0x01 flags=0x41 display=0x80 loop=none control=none : "Me sophisticated robot..." choices "robot"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me big cybernetic intelligence. much cheap memory..." choices "intelligence"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me can think. Me be smart..." choices "intelligence"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me have big CDROM in head... Ha|! Ha|! Ha|! Ha|!" choices "intelligence"
