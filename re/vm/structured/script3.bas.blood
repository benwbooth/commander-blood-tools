selector Bob_Morlock_choices
    yield_b
    case "talk" -> selector_27FE
        menu "bye_bye" "black_hole" "big_bang" "Bob_Morlock" "kanary" "mission" "corpo" "good_ol_bob"
        say Bob_Morlock voice=0x02 flags=0x42 display=0x80 loop=none control=none : "What do you want to know, Commander|?" choices "talk"
        say Bob_Morlock voice=0x03 flags=0x48 display=0x80 loop=none control=none : "Goodbye, Commander|..." choices "bye_bye"
        shared_state 0xC0 0x1440 0xF5 0xC1 0x0001
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "After years of research, I managed to isolate time, Commander" choices "black_hole"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Certain black holes can be used to go back in time." choices "black_hole"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Honk is programmed to recognize the right black holes" choices "black_hole"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "To reach the BIG BANG, you'll need to travel through several black holes..." choices "black_hole"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "Black holes are marvellous natural machines, Commander|..." choices "black_hole"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "I have spent my life in pursuit of truth|, Commander|..." choices "big_bang"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "I know that truth lies beyond the BIG BANG|, Commander!" choices "big_bang"
        say Bob_Morlock voice=0x01 flags=0x41 display=0x80 loop=none control=none : "My memory is not what it was..." choices "big_bang"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Thanks to the KANARY scientists, I am the oldest being in the UNIVERSE" choices "Bob_Morlock"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "In my time, I've been a crooner, a magician, an adventurer. I also created the biggest company in the universe: KANARY" choices "Bob_Morlock"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Women have adored me. Thousands of generations have admired me. I am immortal" choices "Bob_Morlock"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Commander|, you will relive my past. I envy you..." choices "Bob_Morlock"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "Ah... Otto Von Smile, Eviscerator, Jeph d'Ulikan, old Yolk, Tina Burner|... And the others..." choices "Bob_Morlock"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x01 flags=0x49 display=0x80 loop=none control=none : "Ah|! Those were good days, Commander..." choices "Bob_Morlock"
        presentation_register 0x49C8
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "You want some revelations, Commander" choices "revelation"
        shared_state 0xC0 0x1446 0xF5 0xC1 0x0001
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Your mission is to find and travel through the right black holes, taking us back in time to the BIG BANG" choices "mission"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You will meet fabulous beings, many of them dangerous. You'll need to be careful, Commander" choices "mission"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You will see terrible wars and cross impossible frontiers..." choices "mission"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You will have to win strange beings to your cause..." choices "mission"
        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "You will be in sole commander, unless you decide to wake me..." choices "mission"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The planet Corpo is my world of origin. It is where we come from..." choices "corpo"
        say Bob_Morlock voice=0x03 flags=0x49 display=0x80 loop=none control=none : "Corpo is a fabulous planet with inexhaustible resources." choices "corpo"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0002
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Truth is to be found at the creation of the universe, just before the BIG BANG..." choices "truth"
        say Bob_Morlock voice=0x01 flags=0x49 display=0x80 loop=none control=none : "Ah... Truth!" choices "truth"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0xFF flags=0x48 display=0x80 loop=none control=none : "I'm getting pictures from the Ark, Commander. All systems are nominal..." choices "good_ol_Bob"
        load_string "aarche10.hnm"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You flatter me, Commander..." choices "good_ol_bob"
        say Bob_Morlock voice=0x02 flags=0x4A display=0x80 loop=none control=none : "You're embarrassing me, Commander..." choices "good_ol_bob"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x01 flags=0x43 display=0x80 loop=none control=none : "Heh heh|..." choices "good_ol_bob"
        yield_b
        selector_27FE:
    case "kanary" -> 0x0000
        menu "talk" "bye_bye" "cottage" "clones" "employees" "reports"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The Cottage Research department is my secret project" choices "cottage"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The domain of vegetation is a marvel of Nature" choices "cottage"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The Cottage Research department develops genetic marvels" choices "cottage"
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The Kanary lawns mow themselves every weekend..." choices "cottage"
        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "Kanary's artificial orchids provide whiskey that is over a hundred years in age" choices "cottage"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0005
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Kanary has developed technology entirely devoted to synthetic cloning" choices "clones"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Kanary's four million employees were all created by and for Kanary" choices "clones"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "I am the last bionatural being and I CONTROL EVERYTHING..." choices "clones"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "My employees wake me up for ten minutes each year to blow out the candles on my birthday cake and sign the company reports" choices "clones"
        say Bob_Morlock voice=0x01 flags=0x49 display=0x80 loop=none control=none : "I instructed the Kanary scientists to develop the perfect adventurer to take me to the BIG BANG..." choices "clones"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0003
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "All Kanary personnel was made by CLONE CONSORTIUM. So were you|, Commander" choices "employees"
        say Bob_Morlock voice=0x04 flags=0x40 display=0x80 loop=none control=none : "All of you work for me: YOU Honk, YOU Commander|, YOU Olga... ALL OF YOU..." choices "employees"
        say Bob_Morlock voice=0x05 flags=0x49 display=0x80 loop=none control=none : "Kanary builds the cheapest and best employees in the universe..." choices "employees"
        shared_state 0xC0 0x1442 0xF5 0xC1 0x0001
        say Bob_Morlock voice=0x01 flags=0x42 display=0x80 loop=none control=none : "Kanary is the biggest company in the known universe" choices "kanary"
        say Bob_Morlock voice=0x02 flags=0x49 display=0x80 loop=none control=none : "Kanary invents, builds, consumes and controls the universe" choices "kanary"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0001
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Kanary is so efficient that its products have a negative production cost" choices "reports"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "A cottage costs 100990 Negabucks..." choices "reports"
        say Bob_Morlock voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Our profits are so enormous that nobody can say the figure within a normal life span" choices "reports"
        say Bob_Morlock voice=0x06 flags=0x49 display=0x80 loop=none control=none : "Our only competitor is called CRYO. They control the Second World" choices "reports"
        shared_state 0xB4 Bob_Morlock_s03 0xF6 0xC1 0x0002
        yield
end selector Bob_Morlock_choices

