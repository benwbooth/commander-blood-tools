        say Tina_Burner voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Dance night away. Love all day...." choices "dance"
        say Tina_Burner voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Me like red rouge on lips..." choices "cosmetic"
