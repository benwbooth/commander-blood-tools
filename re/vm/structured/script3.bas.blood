        say Bug_Deluxe voice=0xFF flags=0x41 display=0x80 loop=none control=none : "TIE DEPARTMENT:" choices "tie"
        yield_b
        selector_1115:
    case "hide" -> selector_1178
        menu "department" "buy" "tie"
        say Bug_Deluxe voice=0xFF flags=0x41 display=0x80 loop=none control=none : "Murffalo hide tie with tentacule lining. The elegance of dead skin: 1 CRED" choices "hide"
        say Bug_Deluxe voice=0xFF flags=0x49 display=0xA0 loop=none control=none : "You pay 1 CRED." choices "buy"
