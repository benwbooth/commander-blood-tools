// format: bloodscript-v5
// image: BAS

object blood = 0x0028
object Bob_Morlock = 0x004A
object Bug_Deluxe = 0x0092
object Eviscerator = 0x016A
object Yoko = 0x01FA
object Morning_Oil = 0x028A
object Bronko = 0x031A
object Daddy_Gluxx = 0x043A
object Izwalito = 0x055A
object Scruter_Mac = 0x067A
object Honk = 0x0872
object Rondo = 0x0B2A
object Magnus = 0x0C02

field blood.s13 = blood + 0x0008 // VAR kind 0x0001, selector(s) 13
field Bob_Morlock.conversation_progress = Bob_Morlock + 0x0032 // VAR kind 0x0002, selector(s) 03
field Bug_Deluxe.s13 = Bug_Deluxe + 0x003A // VAR kind 0x0002, selector(s) 13
field Rondo.flags = Rondo + 0x0002 // VAR kind 0x0008, selector(s) 00
field Magnus.flags = Magnus + 0x0002 // VAR kind 0x0008, selector(s) 00

yield

selector Eviscerator_choices {
    yield_b
    case "talk" -> 0x0000 {
        menu "yes" "no"
        say Eviscerator voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Yes" choices "yes"
        say Eviscerator voice=0x01 flags=0x40 display=0x80 loop=none control=none : "No" choices "no"
        yield
    }
}

selector Honk_choices {
    yield_b
    case "talk" -> selector_00B3 {
        menu "bye_bye" "optimization" "consultation" "explanations" "calm_down" "play" "win" "lose" "help"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "How to play?" choices "play"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "You got it|..." choices "talk"
        say Honk voice=0xFF flags=0x63 display=0x80 loop=none control=none : "Winning entails adopting a no-lose strategy, Commander|. Bear that in mind..." choices "win"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "What would you like to optimize, Commander|?" choices "optimization"
        yield_b
        selector_00B3:
    }
    case "play" -> selector_02AD {
        menu "talk" "click" "dialog" "fair_play"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "That's the best way to play, Commander|. Just keep clickin'!" choices "click"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Something tells me you're a pretty hot clicker, eh?!!" choices "click"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Did you know every time you click, I feel a little tingle! Isn't that fun?" choices "click"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "When you click, I don't just sit around looking handsome... I do something about it!" choices "click"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "click..." choices "click"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To dialog, just click on the word list... leave the rest to OLGA, your onboard translator..." choices "dialog"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob put the instant translator together. He's a guy and a half!" choices "dialog"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga|, your onboard translator, knows every language in the universe! She's paid in megawatts, like me|, only she gets more." choices "dialog"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Let's dialog..." choices "dialog"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Fair play is inscribed in the Traveller's Charter: Whatever happens, play fair!" choices "fair_play"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Win, win, win. Why do the computers always have to lose?" choices "faiplay"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "OK, Commander|... You seem like a fair play guy. I'll tell Cap'n Bob|..." choices "fair_play"
        yield_b
        selector_02AD:
    }
    case "win" -> selector_0429 {
        menu "talk" "willpower" "strength" "bravery" "pride"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Willpower makes a winner, Commander|. Cap'n Bob knows you've got it|..." choices "willpower"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Okay, so you click on Willpower. Now that's not going to get us very far, Commander|..." choices "willpower"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Be kind to your mouse! You don't want to crush her little buttons, now do you?" choices "strength"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Ah, Bravery! I admire your fearlessness, Commander|. You take such risks with your index finger!" choices "bravery"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Onboard computer HONK reporting: It looks like you just clicked on Bravery." choices "bravery"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "How about sitting up a little straighter?" choices "pride"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm impressed, Commander. You know how to make computers respect you!" choices "pride"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I detect a speck of contempt in the B cortex of your brain's right hemisphere. I'll just give you a little shot of adrenal..." choices "pride"
        yield_b
        selector_0429:
    }
    case "lose" -> selector_0613 {
        menu "talk" "fear" "weakness" "complain" "anger" "break" "cry"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "There's several ways to lose, Commander|. Which do you choose?" choices "lose"
        say Honk voice=0xFF flags=0x62 display=0x80 loop=none control=none : "Commander, I'm here with you. It's me... HONK, your onboard bioconsciousness." choices "fear"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm going to sing you a little song, Commander|. Relax." choices "fear"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Night is fa-aa-aa-lling... The moon is re-e-ed..." choices "fear"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The wolf is ho-ow-owling under your be-e-e-ed. Easy, Commander|. Honk is with you|..." choices "fear"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Big strong Commanders are never scared!" choices "fear"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You need a drink... Come on, Commander|... Please don't blubber... It's so embarrassing!" choices "weakness"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Just reset your computer and start over. there's a whole new life waiting! And I'll always be here|..." choices "weakness"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You know what? I'll help you!... There's a surprise for you on the map. Take a look..." choices "weakness"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "That won't do any good, Commander..." choices "complain"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm going to wake up Cap'n Bob..." choices "anger"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Ouch..." choices "break"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Everything'll be just fine afterwards, Commander..." choices "cry"
        yield_b
        selector_0613:
    }
    case "help" -> selector_092D {
        menu "talk" "switch_off" "break" "endless_lives" "contest" "tips" "presents" "messages"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Need some expert guidance, Commander|?" choices "help"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To disconnect, you can always pull the plug out of the power point..." choices "switch_off"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm sorry, but since that business in 2001, disconnecting me is no longer possible..." choices "switch_off"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Why not? Well, I can reinitialize your computer and wipe your hard disk!|... Ha|! Ha|! Ha|!" choices "break"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Chill out, Commander|..." choices "break"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "How does it feel to be eternal, Commander|?" choices "endless_lives"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Okay! You won. Endless lives from today... Do you feel happier now?" choices "endless_lives"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Is this so important to you?" choices "break"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Okay...|...|... KRUIKK!" choices "break"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Here are the questions, contestant. You'll note there are prizes to be won! Click on \"CONTEST\"" choices "contest"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "First question: Who is Cap'n Bob?|...|... Click on \"CONTEST\"" choices "contest"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Too late... next question: What prize can be won in this contest? Click on \"CONTEST\"" choices "contest"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "YES! HOW 'BOUT THAT!!! But I'm afraid the first one was wrong. Don't ever click on \"CONTEST\" again." choices "contest"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Sorry, but tips are only available only the neural channel..." choices "tips"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To win an amazing prize, Click on \"CONTEST\"" choices "presents"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "If you're getting uninvited PIRATE messages over the neural channel, contact the CYBERSQUAD, extension 453765" choices "messages"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cybernetic messages over the neural channel are strictly against the law..." choices "messages"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "All users of the neural channel will be prosecuted." choices "messages"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The authors of this game decline all responsibility for neural channel communications occasioned by play of said game..." choices "messages"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You just clicked on the word \"message\". Way to go!!!" choices "message"
        yield_b
        selector_092D:
    }
    case "optimization" -> selector_0BF5 {
        menu "talk" "speed" "telephone" "keyboard" "mouse" "joystick" "screen" "CDROM" "music" "sounds"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You want to speed up your computer? No prob..., I'll just double the frequency. Uh, you may want to move back a couple of yards..." choices "speed"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Uh oh... Your computer can't take it|... It's about to implode... DANGER... THROW YOUR PC OUT THE WINDOW... DO IT NOW!!!" choices "speed"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Phew! You're a lucky person... I managed to save the day.. You might care to mention that to Cap'n Bob|, when you see him..." choices "speed"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To modify the ring tone of your onboard phone, stab your loudspeakers with a pair of scissors. For further modification, repeated stabbing may be necessary..." choices "telephone"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "To optimize your keyboard, gouge out excess keys with any commercial screwdriver..." choices "keyboard"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "For a more playful mouse, just replace the little mouse ball with a 6-sided die. Thanks Honk!!!" choices "mouse"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "This is a family game, Commander|!!! Put that nasty little joystick back where it came from!" choices "joystick"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "For sharper color and contrast, spit on your glasses and wipe them on somebody else. If everything looks green, that's because you are under attack from alien vampire cabbages..." choices "screen"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "So your CDROM is way too slow... What can I say?|... Next time, buy a circular saw or maybe an electric toothbrush...." choices "CDROM"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You hate the music! That one's easy to fix. Just hit \"CONTROL ALT DEL\", and flip over the CD. That's better, isn't it?" choices "music"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Seems like I'm sensing a fault in your sound card!!! Try hitting it awfully hard... It works for me..." choices "sounds"
        yield_b
        selector_0BF5:
    }
    case "consultation" -> selector_0C23 {
        menu "talk" "therapy"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "What kind of consultation did you have in mind, Commander?" choices "consultation"
        yield_b
        selector_0C23:
    }
    case "therapy" -> selector_0F87 {
        menu "talk" "ego" "super_ego" "under_ego" "end_of_month" "libido" "who" "where" "when" "what" "how" "why"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "A free psychotherapy session... That's a once in a lifetime offer, Commander|." choices "therapy"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Relax... Loosen up those muscles... Choose the first thing that enters your head:" choices "therapy"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Think about me, Commander, and you'll feel better... let your thoughts stray to Olga the translator..." choices "end_of_month"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The end of one month is so often close to the start of another, Commander|..." choices "end_of_month"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Good... Relax... Click on anything... NOW!" choices "end_of_month"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Ha|! Ha|! That was your double talking... You're not the only one, Commander|. Go see Super ZEN. He can help you with that..." choices "super_ego"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You think you're quite a person, but deep down, there's a little child, right?|..." choices "super_ego"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "There's a rebel in you, Commander|..." choices "super_ego"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Careful... You'll never get the stains ou... You just ask Cap'n Bob|..." choices "under_ego"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You've attained a state close to PRANA. Congratulations..." choices "ego"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Yes|, you!! I'm impressed, Commander|..." choices "ego"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "I'm sensing strange pulsions in the B cortex of your right hemisphere..." choices "libido"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Commander, chastity is a stepping stone to wisdom. So stay calm... Let Cap'n Bob be an example..." choices "libido"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Space travel can be long and lonely. Why not watch some TV?" choices "libido"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Ahh|! The ondoyants..." choices "libido"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Now that's a serious matter... Maybe the answer is to be found at the end of this adventure..." choices "who"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The cyberloneliness of cheap memory makes you dizzy, Commander|..." choices "who"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Over there..." choices "where"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Tomorrow, no doubt..." choices "when"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "That's a tough one, Commander|..." choices "what"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Ahh|! How? The answer is within you, Commander|." choices "how"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "It's obvious: BECAUSE!!! And don't ask \"Because what?\"" choices "why"
        yield_b
        selector_0F87:
    }
    case "calm_down" -> selector_10EC {
        menu "talk" "one" "two" "three" "four" "five" "six" "seven" "eight" "nine"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "How about a simple exercise in mind power? Choose a number. There's only one right one..." choices "calm_down"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "We're going to count murffalos together. You start, Commander|..." choices "calm_down"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Pranayama through numerology! You lucky person! Choose a number between ten and twenty..." choices "calm_down"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Observe your screen carefully, Commander|... How many numbers do you see?" choices "calm_down"
        say Honk voice=0xFF flags=0x69 display=0x80 loop=none control=none : "one" choices "one"
        state[0x1276] += 0x0001
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "two" choices "two"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "three" choices "three"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "four" choices "four"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "five" choices "five"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "six" choices "six"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "seven" choices "seven"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "eight" choices "eight"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "nine... GOOD WORK, COMMANDER... I sense you're quite relaxed now...." choices "nine"
        yield_b
        selector_10EC:
    }
    case "explanations" -> 0x0000 {
        menu "bye_bye" "talk" "blood" "Bob_Morlock" "Honk" "Ark" "Ma" "Orxx" "Olga" "Big_Bang" "Black_holes"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Explanations about anything in particular, Commander|?" choices "explanations"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "Why, you're Commander Blood, Commander. You're the hero of this story..." choices "blood"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob is our master. He built us all..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob is very very old, Commander|. Over 800,000 years old..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob programmed me to detect black holes which are our gateway to the BIG BANG..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob is very very intelligent. He has a biobrain, just like you|. I'm a cybernetic..." choices "Bob_Morlock"
        say Honk voice=0xFF flags=0x61 display=0x80 loop=none control=none : "I HEAR AND OBEY, COMMANDER..." choices "Honk"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The ARK is our vessel, built by cybernetic units belonging to KANARY CORP." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "It's quite a ship! We have 16 CRYOBOXES where we can stock aliens or merchandise..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The Ark is equipped with the fasted warp drives in the entire universe..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The Ark is equipped with an ORXX layer called MA... The Orxx are amazing missiles..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "All onboard comforts have been provided. We have the telephone, a restaurant and widescreen TV..." choices "Ark"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA is one of nature's curiosities, a kind of space whale, genetically altered by Cap'n Bob|..." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA lays her eggs in the PRAM ZONE. The eggs hatch into ORXX..." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA is a sensitive being, Commander|. She is very sensitive to music..." choices "MA"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "MA eats only synthetic strawberries..." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Cap'n Bob loves synthetic strawberries. He perfected them with help from the KANARY geneticists." choices "Ma"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Orxx are LIVING guided missiles. Thanks to them, you're always perfectly safe..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "You guide an Orxx through space, seeing through its eyes. It lands on planets for you|..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "If there's any danger, the Orxx is destroyed... Not you! You're safe in orbit..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Think of Orxx as your representatives. We dialog through them with the aliens. Alien languages are translated by Olga, the onboard translator..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The Orxx are one of Cap'n Bob's finest creations..." choices "Orxx"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga is our cybernetic translator. She knows all the languages in the universe..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga is very highly paid in MEGAWATTS. More than me|, Commander|..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Olga translates almost word for word. She doesn't care for nasty language..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Never say anything bad about Olga|, Commander|. She's very touchy..." choices "Olga"
        say Honk voice=0xFF flags=0x40 display=0x80 loop=none control=none : "MISTER HONK CAN JUST SHUT HIS LYING MOUTH..... SIGNED Olga|...." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "See what I mean|, Commander|... I told you|..." choices "Olga"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "The BIG BANG is one of Cap'n Bob's inventions, Commander|. He thinks the BIG BANG will help him understand the universe... Old age doesn't suit him..." choices "Big_Bang"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "My calculations tell me the BIG BANG is fake, Commander|. I think it's a deformed prism designed to fool us..." choices "Big_Bang"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Commander, just between you and me|, I think ol' Buzzard Man Bob has another idea in mind..." choices "Big_Bang"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Black holes are amazing devices which space out time and temporize space..." choices "Black_holes"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "If we travel through a black hole, we are sure to discover NEW and WEIRD UNIVERSES, Commander|..." choices "Black_holes"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "What lies beyond black holes is an unfathomed mystery, Commander|..." choices "Black_holes"
        say Honk voice=0xFF flags=0x60 display=0x80 loop=none control=none : "Commander|, I feel dizzy all of a sudden..." choices "Black_holes"
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes, Commander|?"
        yield
    }
}

selector Izwalito_choices {
    yield_b
    case "talk1" -> selector_1717 {
        menu "hello" "talk"
