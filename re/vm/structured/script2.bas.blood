selector Bronko_choices {
    yield_b
    case "talk" -> selector_404A {
        menu "bye_bye" "robot" "cred" "murffalos" "weapons"
        yield_b
        selector_404A:
    }
    case "robot" -> selector_41F6 {
        menu "talk" "bye_bye" "robot" "intelligence" "energy" "technology" "retirement"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me robot Bronko AX34 BUTCHER model..." choices "robot"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Robots be strong, friend. Robot Bronko know chop meat with sharp tools..." choices "robot"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me good robot, advanced..." choices "robot"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me big cybernetic intelligence, much cheap memory..." choices "intelligence"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me know think. Me much smart..." choices "intelligence"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me have big CDROM in head|... Ha! Ha! Ha! Ha!" choices "intelligence"
        say Bronko voice=0x02 flags=0x41 display=0x80 loop=none control=none : "Bronko intelligent..." choices "intelligence"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me have big energy: Bronko have new batteries|, friend|...." choices "energy"
        say Bronko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me eat metal biscuits with sump oil and mercury every morning, friend|... High energy|..." choices "energy"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You look for batteries, friend|... Me buy batteries at VENUSIA SUPRAMARKET" choices "energy"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "VENUSIA SUPRAMARKET sell cheap batteries. You not see commercials on TV|, friend?" choices "energy"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Bronko big technology, friend|..." choices "technology"
        say Bronko voice=0x05 flags=0x40 display=0x80 loop=none control=none : "See you soon..." choices "bye_bye"
        yield_b
        selector_41F6:
    }
    case "cred" -> selector_42E2 {
        menu "talk" "bye_bye" "cred" "buy"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Me work much to earn CRED|, friend|..." choices "cred"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Creds be hard to earn..." choices "cred"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "You like Creds, friend?" choices "cred"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me want buy big ship. Go far for vacation..." choices "buy"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me want buy home on planet Troma, and grow nuts, bolts and maybe screws..." choices "buy"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me want breed cybernetic lawn-mowers... Me dream, friend|..." choices "buy"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "To buy, me must work much..." choices "buy"
        yield_b
        selector_42E2:
    }
    case "murffalos" -> selector_439C {
        menu "talk" "bye_bye" "hunt"
        say Bronko voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Thirteen murffalos to reproduce... One in middle, rest around. That be reproduction for Murffalos..." choices "murffalos"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me not like murffalos|... Not good, too soft... Me like blade of lawn-mower..." choices "murffalos"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me know chop murffalos..." choices "murffalos"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me like hunt satellite game with laserpulper... Zap zap in satellites..." choices "hunt"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Hunting big sport..." choices "hunt"
        yield_b
        selector_439C:
    }
    case "weapons" -> selector_442C {
        menu "talk" "bye_bye" "planets" "war"
        say Bronko voice=0x04 flags=0x40 display=0x80 loop=none control=none : "To find nice weapons, pay much creds, Commander|..." choices "weapons"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me have weapons on end of arms..." choices "weapons"
        say Bronko voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You big traveller. You know planets, friend|..." choices "planets"
        say Bronko voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Croolis war do much bad... Bad war, friend|..." choices "war"
        yield_b
