        state[0x12EC] = 0x0001
        yield
    }
}

selector Bob_Morlock_choices {
    yield_b
    case "talk" -> selector_4919 {
        menu "bye_bye" "black_hole" "Big_Bang" "Bob_Morlock" "Kanary" "mission" "Corpo" "Good_ol_Bob"
        say Bob_Morlock voice=0x02 flags=0x42 display=0x80 loop=none control=none : "What do you need to know, Commander?" choices "talk"
        say Bob_Morlock voice=0x03 flags=0x48 display=0x80 loop=none control=none : "Goodbye, Commander|..." choices "bye_bye"
        state[0x1270] = 0x0001
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Years of research finally led me to isolate time, Commander" choices "black_hole"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Certain black holes can be used to travel back in time." choices "black_hole"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Honk is programmed to seek black holes" choices "black_hole"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "To reach the BIG BANG, you'll have to travel through a number of black holes..." choices "black_hole"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Black holes are marvellous machines of nature, Commander|..." choices "black_hole"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "I have pursued truth all my life, Commander|..." choices "Big_Bang"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "I know the truth is beyond the BIG BANG|, Commander|!" choices "Big_Bang"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "My memory is not what it was..." choices "Big_Bang"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Thanks to the KANARY scientists, I am the oldest being in the UNIVERSE." choices "Bob_Morlock"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "In my time, I've been a crooner, a magician, many things. I founded the biggest business in the universe: KANARY!" choices "Bob_Morlock"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "I've known many women. Thousands of generations have admired me. I am immortal!" choices "Bob_Morlock"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Commander, you are going to relive my past. I envy you|..." choices "Bob_Morlock"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "Ah|, Otto Von Smile, Eviscerator, Jeph d'Ulikan, old Yolk, Tina Burner, and the others..." choices "Bob_Morlock"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x49 display=0x80 loop=none control=none : "Ahh! Those were the days, Commander..." choices "Bob_Morlock"
        presentation_register 0x5A7A
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "You want a few revelations, Commander|?" choices "revelation"
        state[0x12BA] = 0x0001
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Your mission is to find and travel through the right black holes, so we can travel back in time to the BIG BANG." choices "mission"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You will meet amazing and sometimes dangerous beings. It will take courage, Commander|!" choices "mission"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "You will pass through hideous wars and barriers that cannot be crossed..." choices "mission"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You will need to win strange creatures to your cause..." choices "mission"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "You will be alone, Commander|. Unless you decide to wake me..." choices "mission"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The planet Corpo is where I originally came from. Where we came from..." choices "Corpo"
        say Bob_Morlock voice=0x03 flags=0x48 display=0x80 loop=none control=none : "Corpo is an extraordinary planet|, with unlimited resources." choices "Corpo"
        Bob_Morlock.conversation_progress += 0x0002
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "The truth lies at the birth of our universe, just before the BIG BANG..." choices "truth"
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "Ah! Truth!" choices "truth"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0xFF flags=0x48 display=0x80 loop=none control=none : "I am getting pictures from the Ark, Commander|. Everything is in order..." choices "Good_ol_Bob"
        load_string "aarche10.hnm"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "You flatter me|, Commander|..." choices "Good_ol_Bob"
        say Bob_Morlock voice=0x02 flags=0x4A display=0x80 loop=none control=none : "You embarrass me|, Commander|..." choices "Good_ol_Bob"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x01 flags=0x42 display=0x80 loop=none control=none : "Heh heh..." choices "Good_ol_Bob"
        yield_b
        selector_4919:
    }
    case "Kanary" -> 0x0000 {
        menu "talk" "bye_bye" "cottage" "clones" "employees" "balance_sheets"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The Cottage Research Department is my secret project..." choices "cottage"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The domain of vegetation is a marvel of nature..." choices "cottage"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The Cottage Research Department perfects genetic miracles..." choices "cottage"
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "The Kanary mows lawns themselves every Weekend..." choices "cottage"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Kanary's artificial orchids produce centuries-old whisky..." choices "cottage"
        Bob_Morlock.conversation_progress += 0x0005
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Kanary has developed technology entirely devoted to synthetic cloning..." choices "clones"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Kanary's four million employees were all built by and for Kanary..." choices "clones"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "I am the very last natural bio being and I control EVERYTHING..." choices "clones"
        say Bob_Morlock voice=0x01 flags=0x40 display=0x80 loop=none control=none : "My employees wake me up for ten minutes once a year, so I can blow out the candles on my birthday cake and sign the balance sheets" choices "clones"
        say Bob_Morlock voice=0x01 flags=0x48 display=0x80 loop=none control=none : "I asked the Kanary scientists to create the perfect adventurer to take me to the BIG BANG..." choices "clones"
        Bob_Morlock.conversation_progress += 0x0003
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "All Kanary employees were built by the CLONE CONSORTIUM department. SO WERE YOU, Commander|." choices "employees"
        say Bob_Morlock voice=0x04 flags=0x40 display=0x80 loop=none control=none : "You all work for me: You Honk, you Commander|, you Olga|... All of you|..." choices "employees"
        say Bob_Morlock voice=0x05 flags=0x48 display=0x80 loop=none control=none : "Kanary builds the cheapest and most efficient employees in the universe..." choices "employees"
        state[0x12B6] = 0x0001
        say Bob_Morlock voice=0x01 flags=0x42 display=0x80 loop=none control=none : "Kanary is the biggest business empire in the known universe" choices "Kanary"
        say Bob_Morlock voice=0x02 flags=0x48 display=0x80 loop=none control=none : "Kanary invents, builds, consumes and controls the entire universe." choices "Kanary"
        Bob_Morlock.conversation_progress += 0x0001
        say Bob_Morlock voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Kanary is so well managed that all its products have a negative building cost..." choices "balance_sheets"
        say Bob_Morlock voice=0x02 flags=0x40 display=0x80 loop=none control=none : "A complete cottage costs 100990 Negabucks to make..." choices "balance_sheets"
        say Bob_Morlock voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Our profits are so enormous that nobody can pronounce the sum." choices "balance_sheets"
        say Bob_Morlock voice=0x06 flags=0x48 display=0x80 loop=none control=none : "Our only competitor is CRYO. They control the Second World." choices "balance_sheets"
        Bob_Morlock.conversation_progress += 0x0002
        say Bob_Morlock voice=0x07 flags=0x04 display=0x85 loop=none control=0x000A : "I like you, Commander|."
        say Bob_Morlock voice=0x08 flags=0x04 display=0x85 loop=none control=0x000F : "You are curious and smart. That's how I like people to be."
        say Bob_Morlock voice=0x09 flags=0x04 display=0x85 loop=none control=0x0014 : "You talk too much, Commander. You're wasting my time|..."
        say Bob_Morlock voice=0x0F flags=0x04 display=0x85 loop=none control=0x0019 : "I'll tell you something about yourself, Commander|. You ask too many questions..."
        yield
    }
}

selector Daddy_Gluxx_choices {
    yield_b
    case "talk" -> selector_4CDF {
        menu "bye_bye" "Slim_Gelati" "family" "Slimers" "Great_Yolk"
        say Daddy_Gluxx voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Bye bye, friend|..." choices "bye_bye"
        say Daddy_Gluxx voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Do you speak our language, stranger?" choices "talk"
        yield_b
        selector_4CDF:
    }
    case "Slim_Gelati" -> selector_4D92 {
        menu "bye_bye" "talk" "treatment"
        say Daddy_Gluxx voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Old Slim's not the guy he used to be. He sold his jelly house. He's throwing away his savings..." choices "Slim_Gelati"
        say Daddy_Gluxx voice=0x04 flags=0x00 display=0x80 loop=none control=none : "He's obsessed with regaining his long lost youth..."
        say Daddy_Gluxx voice=0x02 flags=0x40 display=0x80 loop=none control=none : "He goes for treatment to a secret place. He made me promise never to reveal its whereabouts..." choices "treatment"
        say Daddy_Gluxx voice=0x03 flags=0x48 display=0x80 loop=none control=none : "I promised him I'd never tell..." choices "treatment"
        state[0x12E2] = 0x0001
        yield_b
        selector_4D92:
    }
    case "family" -> selector_4E7A {
        menu "bye_bye" "talk" "children" "village"
        say Daddy_Gluxx voice=0x00 flags=0x40 display=0x82 loop=none control=none : "Ah! Family! Look at these fine children. Little Gooseberry and her sister Gelatine... Latex! Behave yourself!!!" choices "family"
        say Daddy_Gluxx voice=0x03 flags=0x00 display=0x80 loop=none control=none : "We SLIMERS take great joy in our families..."
        say Daddy_Gluxx voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Latex is the oldest. Gooseberry and Gelatine are twins. Rubber is the baby..." choices "children"
        say Daddy_Gluxx voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Our jelly village is wondrous, friend. Our houses are living beings..." choices "village"
        say Daddy_Gluxx voice=0x06 flags=0x40 display=0x80 loop=none control=none : "This village is called JEWELTOWN. It is quite unique in the universe... We get a lot of tourists..." choices "village"
        yield_b
        selector_4E7A:
    }
    case "Slimers" -> selector_4F56 {
        menu "bye_bye" "talk" "origin"
        say Daddy_Gluxx voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Slimers are a very old race..." choices "Slimers"
        say Daddy_Gluxx voice=0x01 flags=0x40 display=0x80 loop=none control=none : "Our origins are lost in the mist of time|..." choices "origin"
        say Daddy_Gluxx voice=0x03 flags=0x40 display=0x80 loop=none control=none : "There used to be billions of us, but the Croolis war almost exterminated us..." choices "origin"
        say Daddy_Gluxx voice=0x04 flags=0x40 display=0x80 loop=none control=none : "We are opposed to the technology of evil. Here there are no factories. We made a pact with the vegetation and with the space jellyfish..." choices "origin"
        say Daddy_Gluxx voice=0x03 flags=0x40 display=0x80 loop=none control=none : "There is no pollution here. Everything is clean and pure..." choices "origin"
        yield_b
        selector_4F56:
    }
    case "Great_Yolk" -> 0x0000 {
        menu "bye_bye" "talk" "history"
        say Daddy_Gluxx voice=0x01 flags=0x40 display=0x80 loop=none control=none : "The Great YOLK... An eminent SLIMER philosopher... His thoughts are taught to all the children of the universe..." choices "Great_Yolk"
        say Daddy_Gluxx voice=0x02 flags=0x40 display=0x80 loop=none control=none : "The Great YOLK said: \"Cyberspace feeds off our dreams...\"" choices "Great_Yolk"
        say Daddy_Gluxx voice=0x03 flags=0x40 display=0x80 loop=none control=none : "He also said: \"The harmony of silence springs from thunder...\"" choices "Great_Yolk"
        say Daddy_Gluxx voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Our history is written within us for eternity. We have no need to tell it or write it down..." choices "history"
        say Daddy_Gluxx voice=0x01 flags=0x01 display=0x80 loop=none control=none : "..."
        yield
    }
}

selector Scruter_Mac_choices {
    yield_b
    case "talk" -> selector_5053 {
        menu "bye_bye" "Scruter_Mac" "SCRUT" "prison" "Mastachok" "presents"
        say Scruter_Mac voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Bye bye stranger... Me must stand guard..." choices "bye_bye"
        yield_b
        selector_5053:
    }
    case "Scruter_Mac" -> selector_50F3 {
        menu "talk" "bye_bye" "robot"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Ah|, robot be hard job... Me think always of vacation on islands of Sea of Tranquility... SIGH..." choices "robot"
        say Scruter_Mac voice=0x04 flags=0x40 display=0x80 loop=none control=none : "If you want be SCRUT agent, you can. Them put your brain inside SCRUT robot..." choices "robot"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "After war, them put Croolis brain in SCRUT robot. Me did be Croolis..." choices "robot"
        yield_b
        selector_50F3:
    }
    case "SCRUT" -> selector_524D {
        menu "talk" "bye_bye" "order" "chief" "war" "happy"
        say Scruter_Mac voice=0x06 flags=0x40 display=0x80 loop=none control=none : "SCRUT big army... SCRUT control universe..." choices "SCRUT"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "SUPER TRUMP be big chief of SCRUT..." choices "SCRUT"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me have order to guard jail on Mastachok..." choices "order"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Order be order, friend|..." choices "order"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Order be not disorder..." choices "order"
        say Scruter_Mac voice=0x04 flags=0x40 display=0x80 loop=none control=none : "You like order..." choices "order"
        say Scruter_Mac voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me not chief... Me not want be chief... Program chief too complicated..." choices "chief"
        say Scruter_Mac voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Chief give order and me obey, big difference..." choices "chief"
        say Scruter_Mac voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Chief have expensive memory..." choices "chief"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me be programmed for war, combat, battle... Me have biometal muscles..." choices "war"
        say Scruter_Mac voice=0x06 flags=0x40 display=0x80 loop=none control=none : "SCRUT robot enforce order in universe... Nice... Me like..." choices "war"
        yield_b
        selector_524D:
    }
    case "prison" -> selector_53E7 {
        menu "talk" "bye_bye" "eviscerator" "Croolis"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Prison of Mastachok solid... Big fortress... Tough..." choices "prison"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Prisoner not can escape from here|... Us control all..." choices "prison"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me not like prison. Me want go vacation, go dance in Tekno night club. Trance music..." choices "prison"
        say Scruter_Mac voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Eviscerator be big prisoner... He be big dangerous Croolis prisoner..." choices "eviscerator"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Eviscerator make big war crimes. He not know pity..." choices "eviscerator"
        say Scruter_Mac voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Me have order exterminate Eviscerator if he escape... Me have laserpulper..." choices "eviscerator"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Croolis be warlike race. Croolis be big warriors, but them have small brain...Pity..." choices "Croolis"
        say Scruter_Mac voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Croolis scientist did try expand brain with drug, but not work|... Pity..." choices "Croolis"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me have idea to expand Croolis brain... Two brains in one head|... That be smart idea..." choices "Croolis"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me have Croolis brain but not be chief..." choices "Croolis"
        yield_b
        selector_53E7:
    }
    case "Mastachok" -> selector_5547 {
        menu "talk" "bye_bye" "planet" "life"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Mastachok be planet ravaged by war... Here did be big battle..." choices "Mastachok"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me not like spend vacation here|... Not sun... Not sea... Not Night Club..." choices "Mastachok"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me dream, friend. Me put perfume on and go dance tekno with Croolas females..." choices "Mastachok"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me like planet Galabar. Much tekno Night Clubs on Galabar. Much young and pretty Croolas on vacation..." choices "planet"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Ahhh|! Dance tekno all night... Night last six months on Galabar... Nice..." choices "planet"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Tekno big music... Wake senses... Me wear perfume to attract females..." choices "planet"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Life be lousy... Me alone... CRY|... CRY|..." choices "life"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Here not be tekno Night Club... Life be very lousy..." choices "life"
        yield_b
        selector_5547:
    }
    case "presents" -> selector_5651 {
        menu "talk" "bye_bye" "friendship" "like"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me like presents... Presents... Presents... Me like..." choices "presents"
        say Scruter_Mac voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me like perfume for go dance tekno. Me pour whole bottle on head. Attract females..." choices "presents"
        say Scruter_Mac voice=0x08 flags=0x40 display=0x80 loop=none control=none : "Perfume nice present, friend. Me like. But me sad not have female..." choices "presents"
        say Scruter_Mac voice=0x02 flags=0x40 display=0x80 loop=none control=none : "Me like friendship... But me be alone.. You be kind to come see me..." choices "friendship"
        say Scruter_Mac voice=0x03 flags=0x40 display=0x80 loop=none control=none : "Me know you like SCRUT robot MAC... You like talk with me..." choices "friendship"
        say Scruter_Mac voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Friendship not exist in SCRUT army... Brothers in arms... Not friends..." choices "friendship"
        yield_b
        selector_5651:
    }
    case "like" -> selector_5713 {
        menu "bye_bye" "talk" "food" "beauty" "perfumes"
        say Scruter_Mac voice=0x09 flags=0x40 display=0x80 loop=none control=none : "Me always like same thing, go dance in Night Club on planet Galabar where night last six months..." choices "like"
        say Scruter_Mac voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me not eat, friend. Me run on BIONIUM|..." choices "food"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "Me like be handsome. Me like smell nice for dance tekno in Night Club on Galabar..." choices "beauty"
        say Scruter_Mac voice=0x00 flags=0x41 display=0x80 loop=none control=none : "ME LIKE PERFUME: \"MOTOROIL\" Be exhaust nozzle Romeo... ME LIKE, friend|..." choices "perfumes"
        yield_b
        selector_5713:
    }
    case "happy" -> selector_57E5 {
        menu "bye_bye" "talk" "beach" "party" "ballroom"
        say Scruter_Mac voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Me not happy... Mastachok not have Night Club..." choices "happy"
        say Scruter_Mac voice=0x06 flags=0x40 display=0x80 loop=none control=none : "Me like mercury beach on GALABAR..." choices "beach"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "AAAhhh!!! Yes!!! Dance tekno all night, wear nice perfume, in Night Club... Ahh beautiful Croolas..." choices "party"
        say Scruter_Mac voice=0x04 flags=0x40 display=0x80 loop=none control=none : "Tekno make nose bleed, ears also|... Nice... Nice..." choices "party"
        say Scruter_Mac voice=0x07 flags=0x40 display=0x80 loop=none control=none : "Me prefer tekno Night Club... Ballroom not be tekno..." choices "ballroom"
        say Scruter_Mac voice=0x03 flags=0x01 display=0x80 loop=none control=none : "..."
        yield_b
        selector_57E5:
    }
    case "boude" -> 0x0000 {
        menu "grmmph" "bye_bye"
        say Scruter_Mac voice=0x07 flags=0x40 display=0x80 loop=none control=none : "... Sulk..." choices "grmmph"
        say Scruter_Mac voice=0x05 flags=0x40 display=0x80 loop=none control=none : "... SILENT COMPLAINT....." choices "grmmph"
        say Scruter_Mac voice=0x08 flags=0x41 display=0x80 loop=none control=none : "..." choices "grmmph"
        halt
    }
}
