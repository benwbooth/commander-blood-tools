00000747: TEXT 004A 02 00 80 - - 049C 00E3 04A0 012F 00B2 03D1 03F1 00DC 04A4 03EE 02ED 02D6 01E3 04A8 00DC 00A3 0019 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "Did we get to the BIG BANG , yes or no ??? I'm listening , Commander ..."
00000771: TEXT 004A FF 20 80 - - 04B2 00DC 04B5 0458 00C1 045D 02C5 00DC 0461 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "Uh , there's been a mix up , sir ..."
0000078D: TEXT 004A FF 20 80 - - 0199 0229 04BD 00B2 04C2 04CA 04D6 02C5 03D1 03F1 0142 03D1 03D5 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "I think OLGA the onboard interpreter mixed up BIG BANG and BIG BAND ..."
000007B1: TEXT 004A 02 00 80 - - 04DC 04E1 046C 04E4 04E9 04ED 04F3 03D1 03F1 04F6 03D1 03D5 0019 04FA 0500 0503 0508 050B 0406 0510 0514 033F ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "WHAT DO YOU MEAN SHE MIXED UP BIG BANG AND BIG BAND ... TELL ME THIS IS JUST A BAD DREAM !!!"
000007E5: TEXT 004A FF 20 80 - - 051A 0422 00DC 0461 0019 031D 04D6 02C5 03F1 0142 0521 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "Afraid not , sir ... She mixed up BANG and BAND..."
00000803: TEXT 004A FF 20 80 - - 00AD 00B2 0529 052E 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "It's the only explanation ..."
00000815: TEXT 004A FF 20 80 - - 053A 04BD 0549 0553 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "BIO-TRANSLATOR OLGA REPORTING :"
00000825: TEXT 004A FF 20 80 - - 0555 055C 0508 0406 0561 0567 033F 0199 026D 045D 056C 02C5 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "MISTER HONK IS A DIRTY LIAR !!! I didn't mix anything up ..."
00000847: TEXT 004A 06 00 80 - - 04BD 0019 0575 057B 0019 057F 01F9 0582 00B2 0588 02C5 0591 0596 0019 059B 05A2 05A7 00C1 05AB 0019 ; TEXT line=0x004A voice=0x06 flags=0x00,0x80 "OLGA ... CHILL OUT ... We can clear the question up real easy ... We'll just run a test ..."
00000877: TEXT 004A 03 00 80 - - 04BD 00DC 0274 05B0 05B5 05BB 05BF 05C4 05CA 0019 ; TEXT line=0x004A voice=0x03 flags=0x00,0x80 "OLGA , say \"BIG BANG\" out loud three times ..."
00000893: TEXT 004A FF 20 80 - - 04BD 0549 0553 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "OLGA REPORTING :"
000008A1: TEXT 004A FF 20 80 - - 03D1 03F1 0019 03D1 03F1 0019 03D1 03F1 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "BIG BANG ... BIG BANG ... BIG BANG ..."
000008BB: TEXT 004A 02 00 80 - - 05D0 0019 05D5 0274 05B0 05D9 00BC 00C1 0408 0019 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "Okay ... Now say \"BIG BAND\" with a \"D\" ..."
000008D7: TEXT 004A FF 20 80 - - 04BD 0549 0553 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "OLGA REPORTING :"
000008E5: TEXT 004A FF 20 80 - - 03D1 03F1 0019 03D1 03F1 0019 03D1 03F1 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "BIG BANG ... BIG BANG ... BIG BANG ..."
000008FF: TEXT 004A FF 20 80 - - 05DF 01CF ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "Satisfied ?"
0000090B: TEXT 004A 03 00 80 - - 05E9 0019 0199 05EE 03D1 03D5 00DC 0422 03D1 03F1 0019 01BA 04D6 05F3 02C5 0019 05F8 05FD 0602 033F ; TEXT line=0x004A voice=0x03 flags=0x00,0x80 "Olga ... I said BIG BAND , not BIG BANG ... You mixed them up ... GOSH DARN IT !!!"
0000093B: TEXT 004A FF 20 80 - - 016F 0211 0199 0605 0257 01CF 02F7 0274 0199 026D 0019 031D 060A 02C5 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "What did I tell you ? Don't say I didn't ... She fouled up ..."
00000961: TEXT 004A FF 20 80 - - 031D 0611 0605 0408 0151 0617 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "She can't tell \"D\" from \"G\" ..."
00000977: TEXT 004A 05 00 80 - - 024D 024B 061B 0627 0019 00AD 0630 0634 0639 033F 063F 0645 0649 0019 ; TEXT line=0x004A voice=0x05 flags=0x00,0x80 "Honk ! Misbegotten junkheap ... It's all your fault !!! Check her multiplexers ..."
0000099B: TEXT 004A FF 20 80 - - 03F6 0656 00DC 0426 042C 0461 0019 01E3 004D 031A 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "Right away , Cap'n Bob sir ... I'm on it ..."
000009B9: TEXT 004A 02 00 80 - - 065B 033F 00A3 0019 065E 0010 012F 0605 0257 0665 0669 0199 066E 0673 0019 ; TEXT line=0x004A voice=0x02 flags=0x00,0x80 "Ah !!! Commander ... Remind me to tell you how much I hate machines ..."
000009DF: TEXT 004A FF 20 80 - - 067C 031A 024B 0426 0680 0199 0687 00B2 068D 0019 00AD 00C1 0694 069D 012F 00B2 06A3 0408 02E7 00B2 06AA 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "Got it ! Cap'n Bob... I found the glitch ... It's a MOSQUITO stuck to the letter \"D\" in the multiplexer ..."
00000A13: TEXT 004A FF 20 80 - - 0199 066E 06B6 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "I hate mosquitos ..."
00000A23: TEXT 004A FF 20 80 - - 06C0 06C8 04BD 0553 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "MESSAGE FROM OLGA :"
00000A33: TEXT 004A FF 20 80 - - 06CD 0503 06D0 06D6 06DA 04F3 06E2 06E7 0503 06ED 0469 06F2 06F8 0701 0019 ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "IF THIS PLACE WAS CLEANED UP MORE OFTEN THIS KIND OF THING WOULDN'T HAPPEN ..."
00000A59: TEXT 004A 07 00 80 - - 02B3 00D6 0019 0417 0708 0092 00C1 070C 033F 0417 0713 0718 0010 071E 033F ; TEXT line=0x004A voice=0x07 flags=0x00,0x80 "She's right ... This Ark is a pigsty !!! This mess makes me sick !!!"
00000A7F: TEXT 004A FF 20 80 - - 0723 0729 03CE 0010 024B 02CF 072E 004D 073B 0744 02C0 0749 033F ; TEXT line=0x004A voice=0xFF flags=0x20,0x80 "Dont' look at me ! Mister BEAUREGARD's on cleaning duty this week !!!"
00000AA1: TEXT 004A FF 08 80 - - 016F 033F 02F7 074E 0010 0753 02C0 024B 0758 075D 031A 024B 0762 0767 031A 00BC 02C0 076B 0772 0019 ; TEXT line=0x004A voice=0xFF flags=0x08,0x80 "What !!! Don't drag me into this ! That does it ! I've had it with this stupid ship ..."
