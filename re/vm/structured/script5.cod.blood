    say Migrator voice=0x06 flags=0x00 display=0x80 loop=none control=none : "What's going on? My Tina's in tears..."
    say Migrator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's not my fault... She didn't want to invite me to her wedding concert..."
