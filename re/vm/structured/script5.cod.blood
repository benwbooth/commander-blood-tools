proc bronk1 {
    activation enabled until emasc0
    branch_flag_274f
    require state[0x1378] == 0x0000
    actor Bronko.s13 blood 0
    guard_pop
    say Bronko voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Everything's okay, Commander|..."
    say Bronko voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Don't hesitate if you need me..."
    when block_268E {
        require Bigbang.in_play
    } then {
        say Bronko voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Teleport me to the BIG BANG, Commander|... I want to party! Gee, I love weddings..."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh! You're not going to leave me here alone, are you|, Mister Bronko? I'm a sucker for weddings too|..."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I'll feel so loneley if you go..."
        say Bronko voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Well|, I sure don't want to to make you unhappy, Mister Honk|... That'll make me unhappy..."
        say Bronko voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You're such an understanding being..."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh! And you|, Mister Bronko, you have so much to offer... Your cooking is out of this world..."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "IF YOU GO... I'M COMING WITH YOU..."
        say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "What's going on now? HONK! Your sentimentality makes me sick!!!"
        load_string "bobb.hnm"
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Boo! Hoo! Sniff... I'm unhappy... Mister Bronko wants to party at the BIG BANG|..."
        say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Honk! Can it... I think I'm going to switch you off!!!"
        load_string "bobb.hnm"
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "NO! No|! Please don't do that, Cap'n Bob|..."
        say Bronko voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Okay okay... I'll stay here... I don't really like to party anyhow..."
        say Bronko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh|, Mister Bronko... Such a lesson in bigheartedness... CRY... WEEP..."
        say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Commander|... Your computer's losing it... Something needs to be done!!!"
        load_string "bobb.hnm"
        say Bronko voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Well|, if you'll excuse me... I've got a murffalo in the oven..."
        record_clear Bronko.s13
    }
    block_268E:
    say Bronko voice=0x05 flags=0x20 display=0x80 loop=none control=none : "Oh Mister Bronko... You're looking well, I must say!!!."
    say Bronko voice=0x05 flags=0x00 display=0x80 loop=none control=none : "See you soon|, Commander|..."
    say Bronko voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Bronko.s13
}

