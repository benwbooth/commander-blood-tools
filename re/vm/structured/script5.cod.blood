    krapp.enabled = false
}

proc krapp1 {
    activation enabled until masta1
    branch_presentation
    actor Kran_Dobu.s13 blood 0
    guard_pop
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "This is Kran Dobu, Space Knight of the Stars..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Radio message to Ark... Ha|! Ha|! You okay?|..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Ha|! Ha|! I hear you're looking for the the Big Bang too|..."
    say Kran_Dobu voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I've pinpointed his ship, Commander|..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "That's where I'm headed, except I don't have the address... Ha|! Ha|!|..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "We'll meet up there|... Ha|! Ha|! Ha|!|..."
    say Kran_Dobu voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's talking about the Big Bang|..."
    say Kran_Dobu voice=0xFF flags=0x00 display=0x80 loop=none control=none : "See you|... Ha|! Ha|! Ha|!"
    say Kran_Dobu voice=0xFF flags=0x08 display=0x90 loop=none control=none : "Bye bye"
    krapp1.enabled = false
    record_clear Kran_Dobu.s13
}

proc masta1 {
    activation enabled until masta5
    branch_gameflag
    actor Scruter_Mac.s13 blood 0
    guard_pop
    say Scruter_Mac voice=0x12 flags=0x00 display=0x80 loop=none control=none : "YOU IN FORBIDDEN ZONE|... ME GIVE WARNING, STRANGER"
    say Scruter_Mac voice=0x11 flags=0x00 display=0x80 loop=none control=none : "Me not know you|."
    say Scruter_Mac voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It must be Scruter Mac's twin brother, Commander|... Took over his job..."
    say Scruter_Mac voice=0x10 flags=0x00 display=0x80 loop=none control=none : "You say code"
    say Scruter_Mac voice=0x01 flags=0x10 display=0x80 loop=block_1A77 control=none : "Hurry, stranger!" choices "croolas" "galabar" "code" "pterra" "exxos"
    when block_1A1C {
        concept_guard "code" 0
    } then {
        say Scruter_Mac voice=0x0C flags=0x00 display=0x80 loop=none control=none : "You say code..."
        say Scruter_Mac voice=0x0E flags=0x00 display=0x80 loop=none control=none : "You not stupid|... But me smarter than you|..."
        say Scruter_Mac voice=0x07 flags=0x08 display=0x80 loop=none control=none : "You want see prisoner..."
        clear_alternate_concept
    }
    block_1A1C:
    when block_1A77 {
        concept_guard "code" 1
    } then {
        say Scruter_Mac voice=0x09 flags=0x00 display=0x80 loop=none control=none : "You not say code... Me not like... Not like..."
        say Scruter_Mac voice=0x07 flags=0x00 display=0x80 loop=none control=none : "You meet my laser-pulper..."
        say Scruter_Mac voice=0x08 flags=0x08 display=0xA0 loop=none control=none : "BYE BYE FRIEND..."
        load_string "explo3.hnm"
        clear_alternate_concept
        record_clear Scruter_Mac.s13
    }
    block_1A77:
    say Scruter_Mac voice=0x05 flags=0x08 display=0x80 loop=none control=none : "You know code, me open door..."
    record_state 0xC1 orxx.s13 0x0A64 0
}

proc masta5 {
    activation enabled until masta6
    branch_gameflag
    require state[0x1370] == 0x0000
    actor Eviscerator.s13 blood 0
    require arche.current_location == Mastachok
    guard_pop
    say Eviscerator voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Me know you|... You give me mummy... and CURSE..."
    say Eviscerator voice=0x04 flags=0x00 display=0x80 loop=none control=none : "ME HATE YOU..."
    say Eviscerator voice=0x07 flags=0x08 display=0x80 loop=none control=none : "WHAT YOU WANT STRANGER?"
    Eviscerator.topic = "talk"
    when block_1B1F {
        require state[0x1372] == 0x0001
    } then {
        say Eviscerator voice=0x06 flags=0x08 display=0x90 loop=none control=none : "You like secrets... Me tell secrets"
        Eviscerator.topic = "secrets"
        state[0x1372] = 0x0000
    }
    block_1B1F:
    when block_1C11 {
        require state[0x1374] == 0x0001
    } then {
        say Eviscerator voice=0x0A flags=0x00 display=0x80 loop=none control=none : "SPLATCH be highly concentrated explosive. SPLATCH blow up jail... LAUGH... FOUL SWEAR"
        say Eviscerator voice=0x08 flags=0x00 display=0x80 loop=none control=none : "You bring me SPLATCH, friend|... And me give you|..."
        say Eviscerator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "He's gonna offer us the treasure again, Commander|... Ol' Turkey-face Bob'll love this|..."
        say Eviscerator voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You go see friends at \"Galaxian Bar\" on planet MASTAGLUK... Them help you|..."
        say Eviscerator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No... No|... That's enough, Commander|... This is not a never ending story..."
        say Eviscerator voice=0x09 flags=0x08 display=0xA0 loop=none control=none : "You understand? Bye bye|... ME WAIT YOU..."
        state[0x1374] = 0x0000
        state[0x1370] = 0x0001
        record_clear Eviscerator.s13
    }
    block_1C11:
    when block_1C40 {
        require state[0x1368] == 0x0000
    } then {
        say Eviscerator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, if I'd had some BIONIUM, I could have helped you|...."
    }
    block_1C40:
    when block_1C6A {
        require state[0x1368] > 0x0003
    } then {
        say Eviscerator voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander|, there's no percentage staying here..."
        state[0x1368] -= 0x0003
    }
    block_1C6A:
    say Eviscerator voice=0x06 flags=0x48 display=0x80 loop=none control=none : "Bye bye. You come back see me. Me like visits..." choices "bye_bye"
    record_clear Eviscerator.s13
}

proc masta6 {
    activation enabled until amig2
    branch_gameflag
    require state[0x1370] == 0x0001
    require orxx.current_location == prison
    actor Eviscerator.s13 blood 0
    guard_pop
    say Eviscerator voice=0x08 flags=0x00 display=0x80 loop=none control=none : "You have splatch???"
