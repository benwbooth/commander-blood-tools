proc bar3 {
    activation enabled until bar4
    branch_gameflag
    require arche.current_location == Bigbang
    require orxx.current_location == bar2
    actor Tina_Burner.s13 blood 0
    guard_pop
    say Tina_Burner voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ah!! There you are at last, Commander|... Everyone's waiting for you|..."
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy handstands!!!"
    say Tina_Burner voice=0x02 flags=0x00 display=0x80 loop=none control=none : "MIGRA's so worried... You do have the wedding band, Commander|?"
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yeah... We have your ring|, Miss Burner..."
    say Tina_Burner voice=0x04 flags=0x00 display=0x80 loop=none control=none : "WHAT!! That cybernetic sex fiend is here? No|!! I don't want him at my wedding..."
    say Tina_Burner voice=0x05 flags=0x00 display=0x80 loop=none control=none : "He's definitely not invited!!! I can't get married with him ogling me!!!"
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "WHAT??? The old bag insulted me... Are you gonna let her get away with that, Commander|?"
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Get lost, you old sow!|...|..."
    say Tina_Burner voice=0x08 flags=0x00 display=0x80 loop=none control=none : "SOW!! BOO HOO HOO... MIGRA... MIGRATOR... Come! I need you|... BOO HOO HOO..."
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "She's so gross, Commander|..."
    say Tina_Burner voice=0xFF flags=0x08 display=0x80 loop=none control=none : "What's all this racket? Can't a guy get any sleep around here?"
    load_string "bobb.hnm"
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "She started it, Cap'n Bob sir... Ask the Commander|..."
    say Tina_Burner voice=0x07 flags=0x00 display=0x80 loop=none control=none : "BOO HOO HOO"
    say Tina_Burner voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Just keep the noise down, okay?"
    load_string "bobb.hnm"
    say Tina_Burner voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YES sir... Right down..."
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Okay|... Let's go see MIGRATOR, Commander|..."
    say Tina_Burner voice=0x04 flags=0x08 display=0x80 loop=none control=none : "MIGRATOR... BOO... MIGRA HOO HOO HOO..."
    record_state 0xC1 orxx.s13 0x0FDC 0
}

