proc yok1 {
    activation enabled until max1
    branch_flag_274f
    actor Yoko.s13 blood 0
    guard_pop
    say Yoko voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Commander|... MAXXON and me would like to get back to our home on the planet RONDO..."
    say Yoko voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Can you drop us off there?|..."
    when block_1F75 {
        require arche.current_location == Rondo
    } then {
        say Yoko voice=0xFF flags=0x30 display=0x80 loop=block_1F75 control=none : "Why don't we teleport them, Commander|..." choices "teleport" "refuse"
        when block_1F56 {
            concept_guard "teleport" 0
        } then {
            say Yoko voice=0xFF flags=0x08 display=0xA0 loop=none control=none : "TELEPORT YOKO AND MAXXON ON RONDO"
            Yoko.current_location = Rondo
            Maxxon.current_location = observatory
            clear_alternate_concept
        }
        block_1F56:
        when block_1F75 {
            concept_guard "refuse" 0
        } then {
            say Yoko voice=0xFF flags=0x28 display=0x90 loop=none control=none : "Whatever you say, Commander|..."
            clear_alternate_concept
            record_clear Yoko.s13
        }
    }
    block_1F75:
    when block_1FAB {
        require arche.current_location != Rondo
        require state[0x1368] > 0x0003
    } then {
        say Yoko voice=0xFF flags=0x28 display=0x80 loop=none control=none : "We'll need to get closer to RONDO to teleport them|..."
        state[0x1368] -= 0x0003
    }
    block_1FAB:
    say Yoko voice=0x01 flags=0x08 display=0x80 loop=none control=none : "We're waiting, Commander|..."
    record_clear Yoko.s13
}

