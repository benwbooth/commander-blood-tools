    say Cyberquizz voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I'm going to be your U.R.O.U.T. examiner"
    say Cyberquizz voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Universal Revolutionary Omniscient Ubiquity Test"
    say Cyberquizz voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Stupid animal! At your age, I already had my U.R.O.U.T.F.O.R.T.H.E.C.O.U.N.T."
    say Cyberquizz voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Don't let him scare you, Commander. He's just jealous..."
    say Cyberquizz voice=0x04 flags=0x08 display=0x80 loop=none control=none : "Here are the questions. Are you ready?"
}

proc Bof_ok {
    activation enabled until perdu
    branch_gameflag
    actor Cyberquizz.s13 blood 0
    require state[0x1382] == 0x0005
    guard_pop
    say Cyberquizz voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Believe it or not... You have passed your U.R.O.U.T."
    say Cyberquizz voice=0xFF flags=0x28 display=0x80 loop=none control=none : "YESSS!!!! I KNEW YOU COULD DO IT COMMANDER..."
    load_string "cadeaux.hnm"
    say Cyberquizz voice=0x01 flags=0x00 display=0x80 loop=none control=none : "I present you with your magnificent diploma..."
    say Cyberquizz voice=0xFF flags=0x10 display=0x80 loop=block_2F6E control=none : "TELEPORT UROUT to Ark" choices "teleport"
    when block_2F6E {
        concept_guard "teleport" 0
    } then {
        say Cyberquizz voice=0xFF flags=0x08 display=0x90 loop=none control=none : "TELEPORTING DIPLOMA TO ARK"
        record_triple Cyberquizz.s13 0x10E4 0x0028 0
        clear_alternate_concept
    }
    block_2F6E:
    say Cyberquizz voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Never forget your happy student days. Be true to your school!"
    say Cyberquizz voice=0x02 flags=0x00 display=0x80 loop=none control=none : "See you soon, Commander..."
    say Cyberquizz voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    state[0x1382] = 0x0000
    state[0x1380] = 0x0000
    Cyberock.in_play = false
    record_clear Cyberquizz.s13
}

proc perdu {
    activation enabled until Q1
    branch_gameflag
    actor Cyberquizz.s13 blood 0
    require state[0x1380] == 0x0020
    require state[0x1382] < 0x000A
    guard_pop
    say Cyberquizz voice=0x0A flags=0x00 display=0x80 loop=none control=none : "You failed!"
    say Cyberquizz voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I knew this would happen... I feel pity for you|, Commander..."
    say Cyberquizz voice=0x09 flags=0x00 display=0x80 loop=none control=none : "May your liver turn into oxidized mercury sauce!! How could you do this??..."
    say Cyberquizz voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I didn't deserve this humiliation...."
    say Cyberquizz voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "stop"
    bonj1.enabled = true
    state[0x1380] = 0x0000
    state[0x1382] = 0x0000
    record_clear Cyberquizz.s13
}

