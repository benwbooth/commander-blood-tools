proc scrujo {
    activation enabled until bigb1
    branch_flag_274f
    actor Scruter_Jo.s13 blood 0
    guard_pop
    say Scruter_Jo voice=0x13 flags=0x00 display=0x80 loop=none control=none : "Commander|, you go search BIONIUM in SCRUTER JO's cyberspace..."
    when block_43A6 {
        require state[0x1366] == 0x0000
    } then {
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Me explain how you pick up BIONIUM.."
        say Scruter_Jo voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You find BIOXX. Bioxx be small energy creatures|..."
        say Scruter_Jo voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You touch BIOXX with hand once."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Sounds like a piece of cake to me|, Commander!!"
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "If you touch BIOXX twice, you CAPTURE BIOXX on tip of your finger..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You catch it on the tip of your finger!!! How about that..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Then you can carry BIOXX to Cybernetic MANTAS"
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You put BIOXX in belly of Manta..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "BIOXX stick to MANTAS..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That's something I wanna see..."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Mantas change BIOXX into BIONIUM..."
        say Scruter_Jo voice=0x05 flags=0x00 display=0x80 loop=none control=none : "More BIOXX you give to Mantas, more BIONIUM you get..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Lead me to those BIOXXes!!! BIONIUM|... Yummy..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "To come back from CYBERSPACE, you touch BLUE BOX...."
        say Scruter_Jo voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You understand?"
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We get the picture, Mister SCRUTER JO... Right, Commander|?"
    }
    block_43A6:
    say Scruter_Jo voice=0x14 flags=0x00 display=0x80 loop=none control=none : "YOU go, Commander|..."
    say Scruter_Jo voice=0x15 flags=0x00 display=0x80 loop=none control=none : "Ahh... Me feel better..."
    when block_4456 {
        require state[0x1368] > 0x0000
    } then {
        say Scruter_Jo voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Good work... You did be successful..."
        say Scruter_Jo voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You did get BIONIUM|..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "YES|!!! Commander|, did I ever tell you what a cool dude you are?"
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "The BIONIUM will make me smarter and I'll be able to help you better..."
        state[0x1366] = 0x0001
    }
    block_4456:
    when block_44F1 {
        require state[0x1368] == 0x0000
    } then {
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Not good, friend|... You fail..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You didn't understand the idea, huh, Commander|..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I have to have BIONIUM, Commander|. It makes me smarter..."
        say Scruter_Jo voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha|! Ha|! You need much bionium BIONIUM|... Ha|! Ha|!|..."
        say Scruter_Jo voice=0xFF flags=0x20 display=0x80 loop=none control=none : "That's enough out of you!!!"
    }
    block_44F1:
    say Scruter_Jo voice=0x07 flags=0x08 display=0x80 loop=none control=none : "Bye bye|, Commander|. Me go back to CYBERSPACE..."
    record_clear Scruter_Jo.s13
}

proc bigb1 {
    activation enabled until veuv
    branch_gameflag
    require Tina_Burner.current_location == Trashlando
    actor Migrator.s13 blood 0
    guard_pop
    say Migrator voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Me greet you|, friend|..."
    say Migrator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You have ring???..."
    say Migrator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Me soon marry TINA... YOU COME WEDDING. ME INVITE YOU. WE MAKE BIG CONCERT..."
    when block_4650 {
        require ring.holder == blood
    } then {
        say Migrator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Teleport him the ring|, Commander|. That'll make his day...."
        say Migrator voice=0xFF flags=0x10 display=0x80 loop=block_45D2 control=none : "RING TELEPORTED TO MIGRATOR" choices "TELEPORT"
        when block_45D2 {
            concept_guard "TELEPORT" 0
        } then {
            say Migrator voice=0xFF flags=0x08 display=0x90 loop=none control=none : "RING TELEPORTED TO MOSKITO AIRPORT ZONE|."
            record_triple blood.s13 0x12DC 0x043A 0
            clear_alternate_concept
        }
        block_45D2:
        say Migrator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "WOWWWW! Ring be nice nice|... Me like... Me thank you|, friend|...."
        say Migrator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Thank you|... Thank you|... YOU COME WEDDING... WE MAKE BIG CONCERT..."
        say Migrator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "BYE BYE FRIEND.... TINA SEND YOU BIG KISS..."
        say Migrator voice=0xFF flags=0x08 display=0x90 loop=none control=none : "..."
        state[0x1384] = 0x0001
        record_clear Migrator.s13
    }
    block_4650:
    say Migrator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You not have ring... Me worried friend|..."
    say Migrator voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You quick go get ring..."
    say Migrator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Me wait you|. Bye bye friend|..."
    say Migrator voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Migrator.s13
}

