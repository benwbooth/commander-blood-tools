proc revel {
    activation enabled until honk1
    branch_flag_274f
    actor Bob_Morlock.s13 blood 0
    require state[0x1386] == 0x0000
    guard_pop
    say Bob_Morlock voice=0x07 flags=0x00 display=0x80 loop=none control=none : "Would you care to know an unbearable truth, Commander|?"
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "HONK! Switch yourself off for ten seconds!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "But, Cap'n Bob|! I..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "SWITCH OFF I SAID!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir....."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KRUIIIIK!!! AAAaaaaaaaaaaaaahhhhh!!!"
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "COMMANDER, YOU ARE ME...."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "WE ARE THE SAME BEING AT TWO DIFFERENT AGES..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "YOU ARE MORE THAN MY SON..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "We are the same person... I am the first being to create itself..."
    say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "And, thanks to space-time contorsion, to watch itself relive: YOU ARE BOB, COMMANDER|..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "I am what you'll be in a few hundred thousand years..."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OK Honk, you can switch yourself back on..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "KROIIIIkkk!!! -&KRUIIIIkkk!!! -&I AM supposed to be aware of everything that goes on round here, being the onboard computer... Don't tell me you switched off Olga???"
    say Bob_Morlock voice=0x05 flags=0x08 display=0x90 loop=none control=none : "Can it and do some work!!"
    revel.enabled = false
    record_clear Bob_Morlock.s13
}

proc honk1 {
    activation enabled until block_51E2
    branch_presentation
    actor Honk.s13 blood 0
    guard_pop
    say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I exist only to obey, Commander"
    when block_4EAD {
        require state[0x1368] == 0x0000
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, we don't have any BIONIUM|... COMMANDER, please..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I need that energy..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You must enter Scruter Jo's CYBERSPACE|..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Wake up Scruter Jo, Commander|. He's sleeping in the Cryobox|..."
    }
    block_4EAD:
    when block_4F0E {
        require state[0x1368] == 0x0001
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got one dose of BIONIUM left, Commander"
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You must enter Scruter Jo's CYBERSPACE|..."
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I don't feel too sure of myself, Commander... I really need that energy..."
    }
    block_4F0E:
    when block_4F49 {
        require state[0x1368] == 0x0002
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got two doses of BIONIUM left, Commander"
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You must enter Scruter Jo's CYBERSPACE|..."
    }
    block_4F49:
    when block_4F6E {
        require state[0x1368] == 0x0003
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got three doses of BIONIUM left, Commander"
    }
    block_4F6E:
    when block_4F93 {
        require state[0x1368] == 0x0004
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got four doses of BIONIUM left, Commander"
    }
    block_4F93:
    when block_4FB8 {
        require state[0x1368] == 0x0005
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got five doses of BIONIUM left, Commander"
    }
    block_4FB8:
    when block_4FDD {
        require state[0x1368] == 0x0006
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got six doses of BIONIUM left, Commander"
    }
    block_4FDD:
    when block_5002 {
        require state[0x1368] == 0x0007
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got seven doses of BIONIUM left, Commander"
    }
    block_5002:
    when block_503B {
        require state[0x1368] == 0x0008
    } then {
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "We've got eight doses of BIONIUM left, Commander"
        say Honk voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You're the best, Commander|..."
    }
    block_503B:
    when block_5088 {
        require state[0x1368] > 0x0002
        require Hom.encounter_count < 0x0002
        require !Bigbang.in_play
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander|, I'm sure that HOM is a vital link in the chain that leads to the Big Bang..."
        state[0x1368] -= 0x0003
    }
    block_5088:
    when block_50C6 {
        require state[0x1368] > 0x0002
        require state[0x136A] == 0x0000
        require Migrator.encounter_count > 0x0000
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander|, Mister Bob want to see you in the Cryobox..."
        state[0x1368] -= 0x0003
    }
    block_50C6:
    when block_50FC {
        require state[0x1368] > 0x0002
        require Yoko.current_location == aboard
        require Yoko.encounter_count == 0x0000
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander, don't forget Yoko and Maxxon asleep CRYOBOX..."
        state[0x1368] -= 0x0003
    }
    block_50FC:
    when block_5146 {
        require state[0x1368] > 0x0002
        require Yoko.current_location == aboard
        require Yoko.encounter_count > 0x0000
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Approach the planet RONDO and talk to Yoko or Maxxon in the CRYOBOX in order to teleport them..."
        state[0x1368] -= 0x0003
    }
    block_5146:
    when block_5175 {
        require state[0x1368] > 0x0002
        require Bug_Deluxe.encounter_count == 0x0000
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Better go see Bug Deluxe on Venusia..."
        state[0x1368] -= 0x0003
    }
    block_5175:
    when block_51B6 {
        require state[0x1368] > 0x0002
        require ring.holder == ondoyant
        require state[0x1388] == state[0x138A]
        require Migrator.encounter_count > 0x0000
    } then {
        say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander... Maybe the ondoyant has a ring for us..."
        state[0x1368] -= 0x0003
    }
    block_51B6:
    say Honk voice=0xFF flags=0x28 display=0x80 loop=none control=none : "More information?"
    Honk.topic = "talk"
    say Honk voice=0xFF flags=0x68 display=0x80 loop=none control=none : "Bye bye|, Commander|..." choices "bye_bye"
    record_clear Honk.s13
    block_51E2:
    halt
}
