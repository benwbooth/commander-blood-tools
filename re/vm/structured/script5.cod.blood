proc veuv1 {
    activation disabled until menbr
    branch_presentation
    guard_pop
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Come in come in...THIS BE HANNA SCRUTA. My husband SCRUTER JO be fighter pilot..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "You blow up his fighter in combat... ME WIDOW NOW... CRY... CRY..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "ME NOT CAN PAY RENT... YOUR FAULT... INSURANCE NOT GIVE ANYTHING..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "ME WIDOW... CRY... CRY... DESPAIRING WAIL.... YOU KILL SCRUTER JO..."
    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|? They're giving out your phone number to widows now|..."
    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's not right|. They're trying to psych you out, Commander|... Don't answer|..."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "YOU MUST PAY... CRY... CRY... YOU DID KILL MY SCRUTER JO... CRY... CRY...."
    say Scruter_K voice=0xFF flags=0x00 display=0x80 loop=none control=none : "KRUIKKK..."
    say Scruter_K voice=0xFF flags=0x20 display=0x80 loop=none control=none : "She hung up... I don't like it, Commander|..."
    say Scruter_K voice=0xFF flags=0x08 display=0x90 loop=none control=none : "stop"
    veuv1.enabled = false
    record_clear Scruter_K.s13
}

