proc init5 {
    activation enabled until Beau
    guard_pop
    Moskito.in_play = true
    airport.in_play = true
    Corpo.in_play = true
    Venusia.in_play = true
    Magnus.in_play = true
    Rondo.in_play = true
    Eden.in_play = true
    Ekatomb.in_play = true
    Erazor.in_play = true
    Kortex.in_play = true
    Mastachok.in_play = true
    Pterra.in_play = true
    Kult.in_play = true
    Vulcan.in_play = true
    Troma.in_play = true
    Emasculator.active = true
    Migrator.active = true
    Emasculator.current_location = usine
    Bob_Morlock.current_location = aboard
    Bronko.current_location = aboard
    Anna_Haf.current_location = aboard
    Beauregard.current_location = aboard
    Migrator.current_location = Trashlando
    ondoyant.current_location = aboard
    Hom.current_location = aboard
    state[0x1362] = state[0x1364]
    Amigo.current_location = bar
    ondoyant.current_location = aboard
    receiver.current_location = aboard
    Yoko.current_location = aboard
    Maxxon.current_location = aboard
    Izwalito.current_location = Corpo
    Otto_Von_Smile.current_location = Trashlando
    state[0x1366] = 0x0001
    state[0x1368] = 0x0003
    character_slot 0x01 "match"
    character_slot 0x02 "ppit"
    character_slot 0x03 "hatetv"
    character_slot 0x04 "venus"
    character_slot 0x05 "scrut"
    character_slot 0x06 "present"
    init5.enabled = false
}

proc Beau {
    activation enabled until cla
    branch_flag_274f
    actor Beauregard.s13 blood 0
    guard_pop
    say Beauregard voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Let me sleep... Commander..."
    say Beauregard voice=0x00 flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Beauregard.s13
}

proc cla {
    activation enabled until recept
    branch_flag_274f
    actor Anna_Haf.s13 blood 0
    guard_pop
    say Anna_Haf voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Let me sleep... Commander..."
    say Anna_Haf voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Anna_Haf.s13
}

proc recept {
    activation enabled until morn
    branch_flag_274f
    actor receiver.s13 blood 0
    guard_pop
    say receiver voice=0xFF flags=0x00 display=0x80 loop=none control=none : "Shhhhhh... Shhhhh..."
    say receiver voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear receiver.s13
}

proc morn {
    activation disabled until mac
    branch_flag_274f
    actor Morning_Oil.s13 blood 0
    guard_pop
    say Morning_Oil voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Let me sleep... Commander..."
    say Morning_Oil voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Morning_Oil.s13
}

proc mac {
    activation enabled until mac2
    require arche.current_location == Kult
    guard_pop
    Scruter_Mac.current_location = Kult
}

proc mac2 {
    activation enabled until kult
    require arche.current_location == Mastachok
    guard_pop
    Scruter_Mac.current_location = Mastachok
}

proc kult {
    activation enabled until ondo1
    branch_gameflag
    require arche.current_location == Kult
    actor Scruter_Mac.s13 blood 0
    guard_pop
    say Scruter_Mac voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Turn around|... Move on... There are too many pilgrims|... The planet's inaccessible|..."
    load_string "1kkult20.hnm"
    say Scruter_Mac voice=0x01 flags=0x00 display=0x80 loop=none control=none : "The planet KULT is inaccessible. There are too many pilgrims..."
    when block_02FC {
        require Scruter_Mac.encounter_count < 0x0003
    } then {
        say Scruter_Mac voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Commander... Commander|... It's the planet TUMUL with a new name.."
        load_string "1kkult20.hnm"
        say Scruter_Mac voice=0xFF flags=0x08 display=0x80 loop=none control=none : "That's right, Commander... When we saved BETAKAM IV, king of the Patagos, we altered history..."
        load_string "hboc.hnm"
        say Scruter_Mac voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Pilgrims now flock to hear the VOICE that saved BETAKAM and his people from the catastrophe..."
        load_string "hboc.hnm"
        say Scruter_Mac voice=0xFF flags=0x20 display=0x80 loop=none control=none : "How about that... What a story..."
        say Scruter_Mac voice=0x00 flags=0x08 display=0x80 loop=none control=none : "Turn around|... Keep moving... There are too many pilgrims... The planet is inaccessible..."
        record_clear Scruter_Mac.s13
    }
    block_02FC:
    say Scruter_Mac voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear Scruter_Mac.s13
}

proc ondo1 {
    activation enabled until big1
    branch_flag_274f
    actor ondoyant.s13 blood 0
    guard_pop
    say ondoyant voice=0x11 flags=0x00 display=0x80 loop=none control=none : "..."
    say ondoyant voice=0x12 flags=0x00 display=0x80 loop=none control=none : "..."
    say ondoyant voice=0x00 flags=0x00 display=0x80 loop=none control=none : "I am yours to command, Commander|..."
    say ondoyant voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... My knees are weak|..."
    say ondoyant voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You want a little kiss?"
    say ondoyant voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy hen gizzards, Commander|... I'm starting to overheat..."
    say ondoyant voice=0x02 flags=0x00 display=0x80 loop=none control=none : "You can talk to me Commander|... Tell me about yourself..."
    say ondoyant voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Where did she learn to swim like that|?|... You think she'd agree to give me lessons, Commander|?"
    when block_051E {
        require Tina_Burner.encounter_count > 0x0000
        require state[0x136A] == 0x0001
    } then {
        say ondoyant voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Oh! Commander|, Honk told me you needed a ring..."
        say ondoyant voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|, I swear I didn't say a thing|..."
        say ondoyant voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Ha|! Ha|! Who's a little fibber?|... You ogle me as soon as the Commander's back is turned..."
        say ondoyant voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... She's making this up..."
        say ondoyant voice=0xFF flags=0x08 display=0x80 loop=none control=none : "Really, Mister Honk??? I'm a little disappointed in you|..."
        load_string "rgbtr9.hnm"
        say ondoyant voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No no, Mister Bronko... Don't believe a word she says..."
        say ondoyant voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Ha|! Ha|! Ha|! Ha..."
        say ondoyant voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Commander|... I have a ring... I want you to have it... It's yours..."
        ring.holder = aboard
        say ondoyant voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... She gave us the ring..."
    }
    block_051E:
    say ondoyant voice=0x14 flags=0x08 display=0x80 loop=none control=none : "..."
    record_clear ondoyant.s13
}

proc big1 {
    activation enabled until boba0
    branch_gameflag
    require arche.current_location == Bigbang
    actor Bug_Deluxe.s13 blood 0
    guard_pop
    say Bug_Deluxe voice=0x00 flags=0x00 display=0x80 loop=none control=none : "You here, Consumer Comrade?"
    say Bug_Deluxe voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander!!! It's Bug Deluxe, the sales assistant from VENUSIA... How about that..."
    say Bug_Deluxe voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Are you here for the wedding?|..."
    say Bug_Deluxe voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Wedding? What wedding???"
    say Bug_Deluxe voice=0x03 flags=0x00 display=0x80 loop=none control=none : "You mean to say you haven't heard|?"
    say Bug_Deluxe voice=0x04 flags=0x00 display=0x80 loop=none control=none : "MIGRATOR and TINA BURNER are getting married..."
    say Bug_Deluxe voice=0x05 flags=0x00 display=0x80 loop=none control=none : "They're giving a big show here at the BIG BAND CLUB..."
    say Bug_Deluxe voice=0xFF flags=0x20 display=0x80 loop=none control=none : "At the what??? Was that BIG BAND or BIG BANG???"
    say Bug_Deluxe voice=0x06 flags=0x00 display=0x80 loop=none control=none : "Right here at the BIG BAND CLUB! WITH A \"D\" AT THE END..."
    say Bug_Deluxe voice=0xFF flags=0x20 display=0x80 loop=none control=none : "This isn't right, Commander|... This is the BIG BAND, not the BIG BANG|..."
    say Bug_Deluxe voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Cap'n Bob isn't going to like this|..."
    say Bug_Deluxe voice=0xFF flags=0x08 display=0x80 loop=none control=none : "What's going on here??? What the blazes are we doing in a NIGHT CLUB???"
    load_string "boba2.hnm"
    say Bug_Deluxe voice=0xFF flags=0x20 display=0x80 loop=none control=none : "There's been a mix up, Cap'n Bob sir..."
    say Bug_Deluxe voice=0xFF flags=0x08 display=0x90 loop=none control=none : "ALL OF YOU, INTO THE CRYOBOX RIGHT AWAY..."
    load_string "bobb.hnm"
    state[0x136C] = 0x0001
    say Bug_Deluxe voice=0xFF flags=0x08 display=0xB0 loop=none control=none : "NOW..."
    load_string "bobb.hnm"
    Bug_Deluxe.current_location = Trashlando
    Tina_Burner.current_location = Bigbang
    record_clear Bug_Deluxe.s13
}

proc boba0 {
    activation enabled until boba1
    branch_flag_274f
    actor Bob_Morlock.s13 blood 0
    require state[0x136C] == 0x0001
    guard_pop
    say Bob_Morlock voice=0x01 flags=0x00 display=0x80 loop=none control=none : "What's the story??? What's this BIG BANG business???..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Did we get to the BIG BANG, yes or no??? I'm listening, Commander|..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Uh, there's been a mix up, sir..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I think OLGA the onboard interpreter mixed up BIG BANG and BIG BAND|..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "WHAT DO YOU MEAN SHE MIXED UP BIG BANG AND BIG BAND|... TELL ME THIS IS JUST A BAD DREAM!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Afraid not, sir... She mixed up BANG and BAND..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "It's the only explanation..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIO-TRANSLATOR OLGA REPORTING:"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "MISTER HONK IS A DIRTY LIAR!!! I didn't mix anything up..."
    say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "OLGA... CHILL OUT... We can clear the question up real easy|... We'll just run a test..."
    say Bob_Morlock voice=0x03 flags=0x00 display=0x80 loop=none control=none : "OLGA, say \"BIG BANG\" out loud three times..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "OLGA REPORTING:"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIG BANG|... BIG BANG|... BIG BANG|..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Okay|... Now say \"BIG BAND\" with a \"D\"..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "OLGA REPORTING:"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "BIG BANG|... BIG BANG|... BIG BANG|..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Satisfied?"
    say Bob_Morlock voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Olga... I said BIG BAND, not BIG BANG|... You mixed them up... GOSH DARN IT!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "What did I tell you? Don't say I didn't... She fouled up..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "She can't tell \"D\" from \"G\"..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Honk! Misbegotten junkheap... It's all your fault!!! Check her multiplexers..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Right away, Cap'n Bob sir... I'm on it..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ah!!! Commander|... Remind me to tell you how much I hate machines..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Got it! Cap'n Bob... I found the glitch... It's a MOSQUITO stuck to the letter \"D\" in the multiplexer..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I hate mosquitos..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "MESSAGE FROM OLGA:"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "IF THIS PLACE WAS CLEANED UP MORE OFTEN THIS KIND OF THING WOULDN'T HAPPEN..."
    say Bob_Morlock voice=0x07 flags=0x00 display=0x80 loop=none control=none : "She's right|... This Ark is a pigsty!!! This mess makes me sick!!!"
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Dont' look at me! Mister BEAUREGARD's on cleaning duty this week!!!"
    say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : "What!!! Don't drag me into this! That does it! I've had it with this stupid ship..."
    load_string "hboc.hnm"
    say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : "I want to go home..."
    load_string "hboc.hnm"
    say Bob_Morlock voice=0x03 flags=0x00 display=0x80 loop=none control=none : "That's enough|, Mister Beauregard... Return to your cryobox|..."
    say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I told you so... I told you|..."
    say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Commander, drop Mister BEAUREGARD off on the planet Tumul..."
    say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "AND GET BACK TO WORK!!!"
    say Bob_Morlock voice=0xFF flags=0x28 display=0xA0 loop=none control=none : "Yes sir, Cap'n Bob sir..."
    state[0x136A] = 0x0001
    boba0.enabled = false
    record_clear Bob_Morlock.s13
}

proc boba1 {
    activation enabled until big2
    branch_flag_274f
    actor Bob_Morlock.s13 blood 0
    guard_pop
    when block_0CA7 {
        require !Bigbang.in_play
    } then {
        say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Aaaah..."
        say Bob_Morlock voice=0x03 flags=0x00 display=0x80 loop=none control=none : "When will we get to the Big Bang? It's URGENT, Commander|..."
        say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "WE MUST FIND the Big Bang|... THAT'S YOUR MISSION, REMEMBER?"
        say Bob_Morlock voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Yes sir. All efforts are directed toward achieving the mission objective..."
        say Bob_Morlock voice=0xFF flags=0x00 display=0x80 loop=none control=none : "SILENCE HONK!!!"
        say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "I'm mad as mad can be, Commander!!! You're flitting around like some gosh darn butterfly..."
        say Bob_Morlock voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You're using my time and money to go after ondoyants!!!"
        say Bob_Morlock voice=0x05 flags=0x00 display=0x80 loop=none control=none : "That's what I call IN-TO-LE-RA-BLE!!!"
        say Bob_Morlock voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I hope I've made my feelings clear..."
        say Bob_Morlock voice=0x06 flags=0x08 display=0x80 loop=none control=none : "Now leave me..."
        record_clear Bob_Morlock.s13
    }
    block_0CA7:
    when big2 {
        require Bigbang.in_play
    } then {
        say Bob_Morlock voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Lets go to the Bigbang..."
        say Bob_Morlock voice=0xFF flags=0x08 display=0x80 loop=none control=none : "..."
        record_clear Bob_Morlock.s13
    }
}

proc big2 {
    activation enabled until bar1
    branch_gameflag
    require arche.current_location == Bigbang
    actor Tina_Burner.s13 blood 0
    guard_pop
    say Tina_Burner voice=0x00 flags=0x00 display=0x80 loop=none control=none : "Ohhh... It's you|, Commander|..."
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh no... Her again..."
    say Tina_Burner voice=0x04 flags=0x00 display=0x80 loop=none control=none : "AH! How delightful to see you again, sweeties... I so much wanted to invite you along..."
    say Tina_Burner voice=0x06 flags=0x00 display=0x80 loop=none control=none : "But I didn't know where to send the invitations..."
    say Tina_Burner voice=0x06 flags=0x00 display=0x80 loop=none control=none : "I'm getting married, you see... Hee|! Hee|! Hee|! To darling MIGRATOR... Hee|! Hee|! Hee|!"
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy homeostatics... Poor guy|..."
    say Tina_Burner voice=0x07 flags=0x00 display=0x80 loop=none control=none : "We're giving a concert here at the BIG BAND CLUB|... It's such a fashionable place, you know... Why, the whole galaxy'll be here!"
    say Tina_Burner voice=0x08 flags=0x00 display=0x80 loop=none control=none : "Our concert's going to be broadcast by all the TV stations in the universe!!"
    say Tina_Burner voice=0x09 flags=0x00 display=0x80 loop=none control=none : "I'm so famous, Commander|... Hee|! Hee|! Hee|!"
    say Tina_Burner voice=0xFF flags=0x20 display=0x80 loop=none control=none : "I can't help wishing we'd gone somewhere else... This place has an end of the world feel..."
    say Tina_Burner voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Darling Migra's at the bar, drinking a frozen Migrita..."
    say Tina_Burner voice=0x02 flags=0x00 display=0x80 loop=none control=none : "MIGRA OH MIGRA SWEETIE... GUESS WHO'S COME..."
    say Tina_Burner voice=0x01 flags=0x08 display=0xB0 loop=none control=none : "Go join him for a stiff one, Commander|..."
    big2.enabled = false
    Migrator.current_location = bar1
    Tina_Burner.current_location = Trashlando
    record_state 0xC1 orxx.s13 0x0FDC 0
}

proc bar1 {
    activation enabled until big3
    branch_gameflag
    require arche.current_location == Bigbang
    actor Migrator.s13 blood 0
    guard_pop
    say Migrator voice=0x01 flags=0x00 display=0x80 loop=none control=none : "You here, Commander! My good friend|... Did Burny tell you the news?"
    say Migrator voice=0x02 flags=0x00 display=0x80 loop=none control=none : "We're getting married... Ah!!! She's so sexy, and smart..."
    say Migrator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... Howzabout a strategic withdrawal here?|... Commander|?"
    say Migrator voice=0x05 flags=0x00 display=0x80 loop=none control=none : "And it's all thanks to you|... I'd like you to be my best man!"
    say Migrator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Oh NO|..."
    say Migrator voice=0x06 flags=0x00 display=0x80 loop=none control=none : "You'll give her the wedding band..."
    say Migrator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "THE WEDDING BAND|... How about a ring for her nose..."
    say Migrator voice=0x05 flags=0x00 display=0x80 loop=none control=none : "Hurry up, Commander|... We can't have the ceremony without a ring..."
    say Migrator voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Holy handouts... Where do we find a wedding band at this time of day or night?"
    say Migrator voice=0x02 flags=0x08 display=0xC0 loop=none control=none : "See you soon|, Commander|..."
    bar1.enabled = false
    Migrator.current_location = Trashlando
    Tina_Burner.current_location = bar2
    Yoko.current_location = Bigbang
    record_clear Migrator.s13
}

proc big3 {
    activation enabled until bar2
    branch_gameflag
    require arche.current_location == Bigbang
    actor Yoko.s13 blood 0
    guard_pop
    say Yoko voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Commander! Yoko happy to see you again..."
    say Yoko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Commander|... It's young Yoko|..."
    say Yoko voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Migrator and Tina wait for wedding ring..."
    guard_push block_10E3 // unstructured_guard=alternate_exit
    require ring.holder == blood
    guard_pop
    say Yoko voice=0x05 flags=0x00 display=0x80 loop=none control=none : "You have ring?"
    say Yoko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "No problem, Mister Yoko|... We have the wedding band right here..."
    say Yoko voice=0x06 flags=0x00 display=0x80 loop=none control=none : "YES|!!! Me happy..."
    say Yoko voice=0x07 flags=0x08 display=0xA0 loop=none control=none : "You go bar, Tina be impatient..."
    big3.enabled = false
    Fifi.current_location = bar1
    record_state 0xC1 orxx.s13 0x0FDC 0
    block_10E3:
    say Yoko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "You agreed to get a ring|, Commander|. You'll have to deliver..."
    say Yoko voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Whatever it takes..."
    say Yoko voice=0x04 flags=0x00 display=0x80 loop=none control=none : "You hurry, Commander|. Everybody wait..."
    say Yoko voice=0xFF flags=0x28 display=0x80 loop=none control=none : "Let's get to it, Commander|. I want to know how this thing turns out..."
    record_clear Yoko.s13
}

proc bar2 {
    activation enabled until bar3
    branch_gameflag
    require arche.current_location == Bigbang
    actor Fifi.s13 blood 0
    guard_pop
    say Fifi voice=0x01 flags=0x00 display=0x80 loop=none control=none : "Ga..."
    say Fifi voice=0x02 flags=0x00 display=0x80 loop=none control=none : "Ga|... Fifi eat|..."
    say Fifi voice=0xFF flags=0x20 display=0x80 loop=none control=none : "Fifi! What are you doing here?"
    say Fifi voice=0x03 flags=0x00 display=0x80 loop=none control=none : "Fifi come for party... Fifi like eat also..."
    say Fifi voice=0x04 flags=0x00 display=0x80 loop=none control=none : "Beautiful Tina look for you|, Commander|. She be at other bar..."
