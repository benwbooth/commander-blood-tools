{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "BloodScript",
    "scopeName": "source.bloodscript",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#headers"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#resourceNames"
        },
        {
            "include": "#properties"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.bloodscript",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.bloodscript",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.bloodscript"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.bloodscript"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.bloodscript",
                            "match": "\\\\(?:[\\\"nrt]|x[0-9A-Fa-f]{2})"
                        },
                        {
                            "name": "punctuation.separator.phrase.bloodscript",
                            "match": "\\|"
                        }
                    ]
                }
            ]
        },
        "headers": {
            "patterns": [
                {
                    "match": "^(bloodscript)(\\s+)([0-9]+)\\s*$",
                    "captures": {
                        "1": {
                            "name": "keyword.control.header.bloodscript"
                        },
                        "3": {
                            "name": "constant.numeric.version.bloodscript"
                        }
                    }
                },
                {
                    "match": "^(profile)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\s*$",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.profile.bloodscript"
                        },
                        "3": {
                            "name": "entity.name.namespace.profile.bloodscript"
                        }
                    }
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(proc)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.procedure.bloodscript"
                        },
                        "3": {
                            "name": "entity.name.function.bloodscript"
                        }
                    }
                },
                {
                    "match": "\\b(player|character|planet|ship|universe|location|black_hole|navigation_controller|item)(\\s+)(\")([^\"]+)(\")",
                    "captures": {
                        "1": {
                            "name": "storage.type.state-object.bloodscript"
                        },
                        "3": {
                            "name": "punctuation.definition.string.begin.bloodscript"
                        },
                        "4": {
                            "name": "entity.name.type.state-object.bloodscript"
                        },
                        "5": {
                            "name": "punctuation.definition.string.end.bloodscript"
                        }
                    }
                },
                {
                    "match": "\\b(object|field|global)(\\s+)([A-Za-z_][A-Za-z0-9_.]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.declaration.bloodscript"
                        },
                        "3": {
                            "name": "entity.name.variable.bloodscript"
                        }
                    }
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "name": "entity.name.label.bloodscript",
                    "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)"
                },
                {
                    "match": "\\b(export)(\\s+)(label)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.export.bloodscript"
                        },
                        "3": {
                            "name": "storage.type.label.bloodscript"
                        },
                        "5": {
                            "name": "entity.name.label.bloodscript"
                        }
                    }
                }
            ]
        },
        "resourceNames": {
            "patterns": [
                {
                    "name": "string.unquoted.resource.hnm.bloodscript",
                    "match": "\\b[A-Za-z0-9_]+\\.hnm\\b"
                },
                {
                    "name": "constant.language.profile.bloodscript",
                    "match": "\\bSCRIPT[1-5]\\b"
                }
            ]
        },
        "properties": {
            "patterns": [
                {
                    "name": "variable.other.member.bloodscript",
                    "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b"
                },
                {
                    "name": "variable.language.array.bloodscript",
                    "match": "\\b(?:timer|sequence_slots)\\b(?=\\[)"
                },
                {
                    "name": "variable.language.bloodscript",
                    "match": "\\b(?:choice|presentation|clock|annual_date|globals)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.bloodscript",
                    "match": "\\b(?:true|false)\\b"
                },
                {
                    "name": "constant.language.state.bloodscript",
                    "match": "\\b(?:none|nowhere|aboard|enabled|disabled|active|inactive|known|unknown|portable|not_portable|present|leader|at_war|acting|full|set|clear|text_only)\\b"
                },
                {
                    "name": "constant.language.race.bloodscript",
                    "match": "\\b(?:croolis_red|croolis_green|migrax|slimers|izwals|sinox|waves|tromps|kam|tubular_brain|quizzers|zen|scruters|robots|bob|gluxx)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.section.bloodscript",
                    "match": "\\b(?:concepts|state|logic|conversations)\\b"
                },
                {
                    "name": "keyword.control.flow.bloodscript",
                    "match": "\\b(?:when|then|else|selector|case|continues|activation|until|end|halt|yield|jump)\\b"
                },
                {
                    "name": "keyword.control.statement.bloodscript",
                    "match": "\\b(?:say|text|text_tokens|queue|transfer|navigate|bring|offer|request|run|during|check|mark|require|menu|choice|parent)\\b"
                },
                {
                    "name": "keyword.other.modifier.bloodscript",
                    "match": "\\b(?:as|from|to|presentation|topic|sequence|profile|bridge|travel|contact|in|not|is|choices|chatter|repeatable|if_not_shown|skip_next|resume_at|chance|dictionary|blank|after)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.date.bloodscript",
                    "match": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}\\b"
                },
                {
                    "name": "constant.numeric.hex.bloodscript",
                    "match": "\\b0[xX][0-9A-Fa-f]+\\b"
                },
                {
                    "name": "constant.numeric.percentage.bloodscript",
                    "match": "\\b[0-9]+%"
                },
                {
                    "name": "constant.numeric.decimal.bloodscript",
                    "match": "(?<![A-Za-z_])[-+]?[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.bloodscript",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.bloodscript",
                    "match": "\\+=|-=|="
                },
                {
                    "name": "keyword.operator.logical.bloodscript",
                    "match": "!"
                },
                {
                    "name": "keyword.operator.arithmetic.bloodscript",
                    "match": "\\+|-"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.section.block.bloodscript",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.section.brackets.bloodscript",
                    "match": "[\\[\\]()]"
                },
                {
                    "name": "punctuation.separator.bloodscript",
                    "match": "[:,.]"
                }
            ]
        }
    }
}
