    "31explonebul": [
      {"frame": 1, "text": "Terrifying news has just come in"},
      {"frame": 35, "text": "Nuclear power has killed again..."},
      {"frame": 70, "text": "The victims were charred, turned to glass..."},
      {"frame": 180, "text": "We don't know the details of what caused the disaster..."},
