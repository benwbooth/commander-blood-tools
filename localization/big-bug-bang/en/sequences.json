  "sequences": {
    "present": [
      {"frame": 1, "text": "CRYO interactive Entertainment 1995"},
      {"frame": 3, "text": ""},
      {"frame": 5, "text": "CRYO interactive Entertainment 1995"},
      {"frame": 7, "text": ""},
      {"frame": 10, "text": "CRYO interactive Entertainment 1995"},
      {"frame": 13, "text": ""},
      {"frame": 15, "text": "CRYO interactive Entertainment 1995"},
      {"frame": 17, "text": ""},
      {"frame": 20, "text": "CRYO interactive Entertainment 1995"},
      {"frame": 25, "text": "Commander BLOOD Version 2.0"},
      {"frame": 55, "text": "Hello!!!"},
      {"frame": 110, "text": "PETIT PITEUX here!"},
      {"frame": 140, "text": "Welcome to COMMANDER BLOOD's BIOGAME"},
      {"frame": 180, "text": "Remember old BOB? What a guy!!!"},
      {"frame": 210, "text": "And gorgeous TINA BURNER's wedding to AMIGO..."},
      {"frame": 250, "text": "And the MIGRATORS concert, the best band in the galaxy..."},
      {"frame": 285, "text": "Old BOB died from it... Dead, I tell you... Ha! Ha! Ha! Good old Bob..."},
      {"frame": 315, "text": "Commander Blood dumped him on a little planet called TERRA"},
      {"frame": 390, "text": "In a place called ROSWELL... Ha! Ha! Ha! Good old Bob..."},
      {"frame": 450, "text": "So Cryo hired a new writer for this new game..."},
      {"frame": 500, "text": "And you haven't heard the best part... Ha! Ha! Ha!"},
      {"frame": 540, "text": "YOU ARE THE WRITER..."},
      {"frame": 610, "text": "YES, YOU!!! HA! HA! HA!"},
      {"frame": 655, "text": "Meet the IZWALS again."},
      {"frame": 710, "text": "GO ON, KID... GO FOR IT!!!"},
      {"frame": 750, "text": "YEAH!!!"},
      {"frame": 775, "text": "Meet the vile CROOLIS again"},
      {"frame": 810, "text": "IN"},
      {"frame": 840, "text": ""}
    ],
    "1ppit": [
      {"frame": 10, "text": "Terrible news has just come in over our teleprinters"},
      {"frame": 70, "text": "Two planets are fighting a deadly war"},
      {"frame": 130, "text": "Stay home... stock up on food"},
      {"frame": 190, "text": "PETIT PITEUX is with you..."}
    ],
    "4exploplane": [
      {"frame": 10, "text": "SPECIAL BULLETIN"},
      {"frame": 20, "text": "HELLO!"},
      {"frame": 30, "text": "BACK TO OUR SPACE REPORTER ON CELSIUS"},
      {"frame": 60, "text": "THE HEAT IS ESPECIALLY OPPREEEESSIII..."},
      {"frame": 100, "text": "HELLO! HELLO!... ..."},
      {"frame": 160, "text": "VERY SAD NEWS: CELSIUS IS NO MORE"}
    ],
    "5exploplane": [
      {"frame": 20, "text": "Disaster!"},
      {"frame": 50, "text": "Commander BLOOD has given in to his basest instincts"},
      {"frame": 85, "text": "Yet it was such a beautiful planet... Mr. BOB's pride and joy!"},
      {"frame": 185, "text": "Well, all gone! Planet all gone! Blown up!"},
      {"frame": 200, "text": "What a shame!"}
    ],
    "7croolvent": [
      {"frame": 1, "text": "Our show, THE MYSTERY OBJECT!"},
      {"frame": 20, "text": "Today's mystery object"},
      {"frame": 50, "text": "is a very mysterious object"},
      {"frame": 80, "text": "that looks like a fan"},
      {"frame": 120, "text": "but isn't a fan"},
      {"frame": 160, "text": "Otherwise it wouldn't be a mystery"},
      {"frame": 190, "text": "It would be a fan!"},
      {"frame": 225, "text": "Is it a murfalo mincer?"},
      {"frame": 250, "text": "No! Wrong! It was a genetic multiplexer!"},
      {"frame": 270, "text": "See you soon for another MYSTERY OBJECT!"}
    ],
    "8incanthom": [
      {"frame": 1, "text": "Hello, pirate!"},
      {"frame": 35, "text": "Look at that Tubular!"},
      {"frame": 70, "text": "What a character, that Tubular!"},
      {"frame": 115, "text": "Watch out, he has great powers..."},
      {"frame": 150, "text": "Telepathy!"},
      {"frame": 180, "text": "But beware of chaos, Pirate!"},
      {"frame": 220, "text": "Chaos means..."},
      {"frame": 250, "text": "DEATH!..."},
      {"frame": 315, "text": "There! That's all! Gasping and pale..."}
    ],
    "9scrutbox": [
      {"frame": 1, "text": "Wow! Scrutinize that helmet, pirate!"},
      {"frame": 35, "text": "Are you going to fill our universe with SCRUTERS?!"},
      {"frame": 70, "text": "I'd gladly turn it into scrap metal!"},
      {"frame": 135, "text": "DEATH TO THE SCRUTERS!"},
      {"frame": 185, "text": "JOIN THEIR RANKS AND GIVE UP YOUR EYES"},
      {"frame": 215, "text": "Mind you, that Scruter helmet is great!"}
    ],
    "10hachoir": [
      {"frame": 1, "text": "Hello, pirate! I've got a scoop!"},
      {"frame": 35, "text": "You know the Murfalos..."},
      {"frame": 75, "text": "Well, they started out as CROOLIS!"},
      {"frame": 190, "text": "CROOLIS mutated through genetic multiplexing"},
      {"frame": 235, "text": "To make them a little smarter..."},
      {"frame": 280, "text": "A little less violent..."},
      {"frame": 330, "text": "A little kinder..."},
      {"frame": 370, "text": "A little less C..."},
      {"frame": 390, "text": "CROOLIS!"},
      {"frame": 410, "text": "It worked, didn't it? They don't atomize anyone!"}
    ],
    "11izwalexplo": [
      {"frame": 20, "text": "TELEPLATO!"},
      {"frame": 40, "text": "The IZWAL was born in the ZEN mind"},
      {"frame": 90, "text": "It ran through the neural corridors,"},
      {"frame": 130, "text": "passed through the bionium gate"},
      {"frame": 175, "text": "But what did it discover there?"},
      {"frame": 235, "text": "That the IZWAL is a prisoner in the cave"},
      {"frame": 320, "text": "It won't get out! No, it won't!"},
      {"frame": 410, "text": "How can we get it out of the cave?"},
      {"frame": 465, "text": "How can we break its chains?"},
      {"frame": 525, "text": "Through violence?"},
      {"frame": 560, "text": "Or through wisdom?"}
    ],
    "14legscrut": [
      {"frame": 1, "text": "JOIN THE SCRUTERS"},
      {"frame": 45, "text": "OR GET OUT OF HERE"},
      {"frame": 85, "text": "BECAUSE THE FUTURE BELONGS..."},
      {"frame": 270, "text": "TO THE SCRUTER LEGION!"},
      {"frame": 300, "text": "ENLIST AND RECEIVE THIS MAGNIFICENT SCRUT BADGE"}
    ],
    "15parfum": [
      {"frame": 1, "text": "Hello"},
      {"frame": 35, "text": "Have you heard the one about the legionnaire and the goat?"},
      {"frame": 70, "text": "Eh! Smells like a billy goat!"},
      {"frame": 125, "text": "Do you know it?"},
      {"frame": 175, "text": "Noooo???"},
      {"frame": 235, "text": "Well... There's this legionnaire..."},
      {"frame": 280, "text": "Riiiight..."},
      {"frame": 310, "text": "Uhhh... The goat says: Baaaaaa!!!"},
      {"frame": 355, "text": "... Well... That's iiiit..."}
    ],
    "16ondobar": [
      {"frame": 1, "text": "Yep! Time for a recipe!"},
      {"frame": 30, "text": "To make a good cocktail, shake it in every direction!"},
      {"frame": 80, "text": "Oh, by the way! A customer told me something nebulous..."},
      {"frame": 156, "text": "An Undulating One has apparently entered your life, Commander!?..."},
      {"frame": 313, "text": "Don't forget! Shake those cocktails well!"}
    ],
    "17vtromp": [
      {"frame": 20, "text": "Attention: today's program is about science"},
      {"frame": 40, "text": "How were the TROMPS born?"},
      {"frame": 80, "text": "We are inside a CROOLI's crounouille, magnified 15,000 times"},
      {"frame": 180, "text": "We can clearly see TROMPS swarming around"},
      {"frame": 260, "text": "These little hairy creatures have just one obsession..."},
      {"frame": 345, "text": "GET OUT OF THE CROOLI'S CROUNOUILLE!"},
      {"frame": 400, "text": "All together now! We must hurry... lalalala"},
      {"frame": 428, "text": "Out of those crounouilles! lalalala"},
      {"frame": 462, "text": "That was our science program..."}
    ],
    "19chapeau": [
      {"frame": 1, "text": "TELEPLATO!"},
      {"frame": 35, "text": "He was offered POWER!"},
      {"frame": 70, "text": "Deep inside the cave..."},
      {"frame": 175, "text": "Super Zen said..."},
      {"frame": 195, "text": "No No No"},
      {"frame": 215, "text": "No Thanks!"},
      {"frame": 220, "text": "While others were clamoring for"},
      {"frame": 280, "text": "THE CROWN! THE CROWN!"},
      {"frame": 310, "text": "Here it is..."},
      {"frame": 330, "text": "There it is!"},
      {"frame": 360, "text": "YEAH! THE CROWN!"},
      {"frame": 385, "text": "Say NO to power!"}
    ],
    "20larvarc": [
      {"frame": 1, "text": "Hello, pirate!"},
      {"frame": 35, "text": "Something totally wild happened!"},
      {"frame": 70, "text": "Something really far-out!"},
      {"frame": 135, "text": "See? That's the outside of the Ark..."},
      {"frame": 175, "text": "And there... A flash!..."},
      {"frame": 200, "text": "That was an explosion!"},
      {"frame": 270, "text": "And that weird thing on the back of the Ark..."},
      {"frame": 310, "text": "That really strange thing..."},
      {"frame": 350, "text": "And pretty disgusting..."},
      {"frame": 400, "text": "No doubt about it..."},
      {"frame": 450, "text": "Really disgusting!..."},
      {"frame": 500, "text": "What could it be?..."},
      {"frame": 550, "text": "Well, by the name of YOLK!"},
      {"frame": 610, "text": "It's a big, slimy larva..."},
      {"frame": 650, "text": "Why yes, it's you, Commander!"},
      {"frame": 702, "text": "That was Ark-crazy, wasn't it?..."}
    ],
    "21pubdecod": [
      {"frame": 1, "text": "Hello, friends! The future is today"},
      {"frame": 50, "text": "The VENUSIA supramarket..."},
      {"frame": 70, "text": "Wow!..."},
      {"frame": 80, "text": "Wawawa!..."},
      {"frame": 90, "text": "... is delighted to offer you..."},
      {"frame": 110, "text": "... as an exceptional promotional gift..."},
      {"frame": 150, "text": "The TV of the future! The DECODER..."},
      {"frame": 185, "text": "You'll simply have to take it on your travels!"}
    ],
    "24bionium": [
      {"frame": 1, "text": "A news flash has just come in"},
      {"frame": 35, "text": "Bionium has caused a mutation"},
      {"frame": 70, "text": "This substance has extraordinary mutagenic power"},
      {"frame": 130, "text": "A new race has just appeared in our world"},
      {"frame": 200, "text": "Remember, it's pirate time..."},
      {"frame": 240, "text": "See you soon on Petit Piteux's channel"}
    ],
    "25diplom": [
      {"frame": 20, "text": "Hello, squirt! Now you'll have to think!"},
      {"frame": 50, "text": "Astronomy... Harmony... Reflection..."},
      {"frame": 80, "text": "Must read PLATO... Lots of dialogues!"},
      {"frame": 117, "text": "Not like us... We're big idiots!"},
      {"frame": 150, "text": "Har! Har! We idiots have such a laugh!..."}
    ],
    "26explocomb": [
      {"frame": 1, "text": "Achtung, baby!"},
      {"frame": 35, "text": "We've spotted a hole in time"},
      {"frame": 72, "text": "You've got to dive in quickly"},
      {"frame": 86, "text": "You ace of spades"},
      {"frame": 95, "text": "No time"},
      {"frame": 100, "text": "To lose"},
      {"frame": 105, "text": "To win"},
      {"frame": 110, "text": "To avoid losing"},
      {"frame": 115, "text": "For glory"},
      {"frame": 120, "text": "For pleasure"},
      {"frame": 125, "text": "For fun"},
      {"frame": 130, "text": "What else for?"},
      {"frame": 150, "text": "To find"},
      {"frame": 160, "text": "My crooligionnaire"},
      {"frame": 170, "text": "The red Crooli"},
      {"frame": 175, "text": "Outrageor"},
      {"frame": 180, "text": "And steal"},
      {"frame": 200, "text": "His CROWN!"},
      {"frame": 225, "text": "But you must be"},
      {"frame": 230, "text": "quick"},
      {"frame": 235, "text": "Quick"},
      {"frame": 237, "text": "quick!"},
      {"frame": 240, "text": "Before it closes"},
      {"frame": 247, "text": "The gate of time!"}
    ],
    "27exploplane": [
      {"frame": 1, "text": "Careful..."},
      {"frame": 20, "text": "Commander!"},
      {"frame": 40, "text": "Don't think too hard..."},
      {"frame": 60, "text": "Or else..."},
      {"frame": 70, "text": "You'll..."},
      {"frame": 80, "text": "Blow..."},
      {"frame": 90, "text": "A FUSE!"},
      {"frame": 115, "text": "So be careful!"}
    ],
    "28bob": [
      {"frame": 1, "text": "Bad news, kid!"},
      {"frame": 35, "text": "BOB here! I've never seen such a terrible writer!"},
      {"frame": 70, "text": "Everyone's complaining! You're fired!"},
      {"frame": 125, "text": "HEAR THAT, SQUIRT? YOU'RE NOTHING BUT A LITTLE LOSER!"},
      {"frame": 155, "text": "Ouch, ouch, ouch! Bobby really bites!"},
      {"frame": 215, "text": "You have to admit, you're especially sluggish, kid..."}
